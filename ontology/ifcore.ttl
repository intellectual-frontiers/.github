ifcore:TSC-CC2-2 a skos:Concept ; skos:inScheme ifcore:TrustServicesCriteria ; skos:notation "CC2.2" ; skos:prefLabel "CC2.2"@en ; ifcore:hasAudience ifcore:Public .
ifcore:TSC-CC2-3 a skos:Concept ; skos:inScheme ifcore:TrustServicesCriteria ; skos:notation "CC2.3" ; skos:prefLabel "CC2.3"@en ; ifcore:hasAudience ifcore:Public .
ifcore:TSC-CC3-1 a skos:Concept ; skos:inScheme ifcore:TrustServicesCriteria ; skos:notation "CC3.1" ; skos:prefLabel "CC3.1"@en ; ifcore:hasAudience ifcore:Public .
ifcore:TSC-CC3-2 a skos:Concept ; skos:inScheme ifcore:TrustServicesCriteria ; skos:notation "CC3.2" ; skos:prefLabel "CC3.2"@en ; ifcore:hasAudience ifcore:Public .
ifcore:TSC-CC3-3 a skos:Concept ; skos:inScheme ifcore:TrustServicesCriteria ; skos:notation "CC3.3" ; skos:prefLabel "CC3.3"@en ; ifcore:hasAudience ifcore:Public .
ifcore:TSC-CC3-4 a skos:Concept ; skos:inScheme ifcore:TrustServicesCriteria ; skos:notation "CC3.4" ; skos:prefLabel "CC3.4"@en ; ifcore:hasAudience ifcore:Public .
ifcore:TSC-CC4-1 a skos:Concept ; skos:inScheme ifcore:TrustServicesCriteria ; skos:notation "CC4.1" ; skos:prefLabel "CC4.1"@en ; ifcore:hasAudience ifcore:Public .
ifcore:TSC-CC4-2 a skos:Concept ; skos:inScheme ifcore:TrustServicesCriteria ; skos:notation "CC4.2" ; skos:prefLabel "CC4.2"@en ; ifcore:hasAudience ifcore:Public .
ifcore:TSC-CC5-1 a skos:Concept ; skos:inScheme ifcore:TrustServicesCriteria ; skos:notation "CC5.1" ; skos:prefLabel "CC5.1"@en ; ifcore:hasAudience ifcore:Public .
ifcore:TSC-CC5-2 a skos:Concept ; skos:inScheme ifcore:TrustServicesCriteria ; skos:notation "CC5.2" ; skos:prefLabel "CC5.2"@en ; ifcore:hasAudience ifcore:Public .
ifcore:TSC-CC5-3 a skos:Concept ; skos:inScheme ifcore:TrustServicesCriteria ; skos:notation "CC5.3" ; skos:prefLabel "CC5.3"@en ; ifcore:hasAudience ifcore:Public .
ifcore:TSC-CC6-1 a skos:Concept ; skos:inScheme ifcore:TrustServicesCriteria ; skos:notation "CC6.1" ; skos:prefLabel "CC6.1"@en ; ifcore:hasAudience ifcore:Public .
ifcore:TSC-CC6-2 a skos:Concept ; skos:inScheme ifcore:TrustServicesCriteria ; skos:notation "CC6.2" ; skos:prefLabel "CC6.2"@en ; ifcore:hasAudience ifcore:Public .
