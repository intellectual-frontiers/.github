    ifcore:describes ifcore:QualityfolioTrademark ;
    ifcore:primarySource "https://tmsearch.uspto.gov/"^^xsd:anyURI ;
    ifcore:verificationCadence "P90D"^^xsd:duration ;
    ifcore:verificationMethod "manual"@en ;
    rdfs:comment "Registration being prepared. On first verification, record the application's serial number and status as the cached value, with resolvedAt."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:SurveilrTrademarkRecord a ifcore:ExternalRecordReference ;
    rdfs:label "USPTO record of the surveilr trademark"@en ;
    ifcore:describes ifcore:SurveilrTrademark ;
    ifcore:primarySource "https://tmsearch.uspto.gov/"^^xsd:anyURI ;
    ifcore:verificationCadence "P90D"^^xsd:duration ;
    ifcore:verificationMethod "manual"@en ;
    rdfs:comment "Registration being prepared. On first verification, record the application's serial number and status as the cached value, with resolvedAt."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:SpryTrademarkRecord a ifcore:ExternalRecordReference ;
    rdfs:label "USPTO record of the Spry trademark"@en ;
    ifcore:describes ifcore:SpryTrademark ;
    ifcore:primarySource "https://tmsearch.uspto.gov/"^^xsd:anyURI ;
    ifcore:verificationCadence "P90D"^^xsd:duration ;
    ifcore:verificationMethod "manual"@en ;
    rdfs:comment "Registration being prepared. On first verification, record the application's serial number and status as the cached value, with resolvedAt."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:ProgrammableMarkdownTrademarkRecord a ifcore:ExternalRecordReference ;
    rdfs:label "USPTO record of the Programmable Markdown trademark"@en ;
    ifcore:describes ifcore:ProgrammableMarkdownTrademark ;
    ifcore:primarySource "https://tmsearch.uspto.gov/"^^xsd:anyURI ;
    ifcore:verificationCadence "P90D"^^xsd:duration ;
    ifcore:verificationMethod "manual"@en ;
    rdfs:comment "Registration being prepared. On first verification, record the application's serial number and status as the cached value, with resolvedAt."@en ;
    ifcore:hasAudience ifcore:Public .

# ───────────────────────── Network (0012-network) ─────────────────────────

ifcore:SearchStage a owl:Class ; rdfs:label "Search stage"@en ;
    rdfs:comment "One step in the ordered sequence a hunt moves through (0012-network FR-003). Reuses ifcore:sequenceOrder, already declared for ifcore:MethodStage and ifcore:VentureLifecycleStage, rather than redeclaring it."@en .
ifcore:Thesis a ifcore:SearchStage ; rdfs:label "Thesis"@en ; ifcore:sequenceOrder 1 ;
    rdfs:comment "Someone writes down who would have to exist for a piece of work to succeed, and what would make that person unusual (0012 FR-001)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:Discovery a ifcore:SearchStage ; rdfs:label "Discovery"@en ; ifcore:sequenceOrder 2 ;
    rdfs:comment "Network looks outward at what is already public. The internet is the database; it is not copied into one."@en ; ifcore:hasAudience ifcore:Public .
ifcore:Surfaced a ifcore:SearchStage ; rdfs:label "Surfaced"@en ; ifcore:sequenceOrder 3 ;
    rdfs:comment "A small set of candidates comes back, each attached to the thesis it answers."@en ; ifcore:hasAudience ifcore:Public .
ifcore:Evidence a ifcore:SearchStage ; rdfs:label "Evidence"@en ; ifcore:sequenceOrder 4 ;
    rdfs:comment "Every candidate gets a packet: what was found, where it came from, and what is still unknown (0012 FR-007, FR-008)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:HumanJudgment a ifcore:SearchStage ; rdfs:label "Human judgment"@en ; ifcore:sequenceOrder 5 ;
    rdfs:comment "A person reads the packet and decides whether to reach out. No score decides this (0012 FR-004)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:Contact a ifcore:SearchStage ; rdfs:label "Contact"@en ; ifcore:sequenceOrder 6 ;
    rdfs:comment "One specific message about one specific thing, sent by a person who can act on the answer."@en ; ifcore:hasAudience ifcore:Public .
ifcore:Conversation a ifcore:SearchStage ; rdfs:label "Conversation"@en ; ifcore:sequenceOrder 7 ;
    rdfs:comment "What is learned in the conversation is written down — the part the internet doesn't have."@en ; ifcore:hasAudience ifcore:Public .
ifcore:Validation a ifcore:SearchStage ; rdfs:label "Validation"@en ; ifcore:sequenceOrder 8 ;
    rdfs:comment "The hypothesis about what this person is unusually good at either holds up or it does not."@en ; ifcore:hasAudience ifcore:Public .
ifcore:Match a ifcore:SearchStage ; rdfs:label "Match"@en ; ifcore:sequenceOrder 9 ;
    rdfs:comment "The person is connected to the hunt, venture, fund, or editorial project that needed them."@en ; ifcore:hasAudience ifcore:Public .
ifcore:SearchExperiment a ifcore:SearchStage ; rdfs:label "Experiment"@en ; ifcore:sequenceOrder 10 ;
    rdfs:comment "The match starts as a small, bounded piece of real work, not a title. Named ifcore:SearchExperiment, distinct from ifcore:Experiment (0011-studios' venture lifecycle stage), to avoid conflating the two sequences."@en ; ifcore:hasAudience ifcore:Public .
ifcore:Outcome a ifcore:SearchStage ; rdfs:label "Outcome"@en ; ifcore:sequenceOrder 11 ;
    rdfs:comment "The experiment produced something or it did not, and Network records which."@en ; ifcore:hasAudience ifcore:Public .
ifcore:Learning a ifcore:SearchStage ; rdfs:label "Learning"@en ; ifcore:sequenceOrder 12 ;
    rdfs:comment "The thesis is corrected with what actually happened; the next search starts from what this one got wrong (0012 FR-005)."@en ; ifcore:hasAudience ifcore:Public .

ifcore:Hunt a owl:Class ; rdfs:subClassOf ifcore:Fact, prov:Activity, schema:SearchAction ; rdfs:label "Hunt"@en ;
    rdfs:comment "A search with a written thesis (0012-network FR-001), bounded work that generates evidence packets via prov:wasGeneratedBy, the same reuse already established for research activities and ifcore:Note (0007-work-and-assets FR-002)."@en .
ifcore:searchesFor a owl:ObjectProperty ; rdfs:domain ifcore:Hunt ; rdfs:range ifcore:Unit ;
    rdfs:comment "The unit or opportunity a hunt searches for (0012 FR-002)."@en .

ifcore:EvidencePacket a owl:Class ; rdfs:subClassOf ifcore:Fact, prov:Entity ; skos:closeMatch prov:Bundle ; rdfs:label "Evidence packet"@en ;
    rdfs:comment "What a candidate becomes through cited signals, not a profile (0012-network FR-007, FR-008). Generated by a Hunt via prov:wasGeneratedBy; its subject candidate is named via schema:about (reused, range ifcore:Person); a claim's own source is carried by the existing Reference model (ifcore:ExternalRecordReference or ifcore:RestrictedDataReference per the signal's sensitivity), not a new citation property."@en .
ifcore:namedUnknown a owl:DatatypeProperty ; rdfs:domain ifcore:EvidencePacket ; rdfs:range xsd:string ;
    rdfs:comment "What is explicitly not yet known about a candidate, stated rather than dropped once the candidate looks promising (0012 FR-008)."@en .
ifcore:ConfidenceLevel a owl:Class ; rdfs:label "Confidence level"@en .
ifcore:Low a ifcore:ConfidenceLevel ; rdfs:label "Low"@en ; ifcore:hasAudience ifcore:Public .
ifcore:Medium a ifcore:ConfidenceLevel ; rdfs:label "Medium"@en ; ifcore:hasAudience ifcore:Public .
ifcore:High a ifcore:ConfidenceLevel ; rdfs:label "High"@en ; ifcore:hasAudience ifcore:Public .
ifcore:confidenceLevel a owl:ObjectProperty ; rdfs:domain [ a owl:Class ; owl:unionOf ( ifcore:EvidencePacket ifcore:Assertion ) ] ; rdfs:range ifcore:ConfidenceLevel ;
    rdfs:comment "How sure an evidence packet's reading, or an assertion, is (0012-network FR-007; 0047-digital-reflections FR-019)."@en .

ifcore:RelationshipMemory a owl:Class ; skos:altLabel "Interaction history"@en ; rdfs:label "Relationship memory"@en ;
    skos:definition "The compounding record of who did what and how it turned out, so the next search starts further along than the last one."@en ;
    rdfs:comment "Sensitive by default, the same posture as ifcore:TradeSecret (0007-work-and-assets FR-010): nothing learned in a private conversation appears on a public page without consent, and no individual relationship-memory record is public merely by existing (0012-network FR-015, FR-016, FR-017). An actual record's own ifcore:hasAudience states who it is visible to; none is asserted here."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:NetworkMeasure a owl:Class ; skos:closeMatch qb:MeasureProperty ; rdfs:label "Network measure"@en ;
    rdfs:comment "What Network is evaluated by, in place of activity counts like profiles created or page views (0012-network FR-018, FR-019)."@en .
ifcore:HuntWithThesis a ifcore:NetworkMeasure ; rdfs:label "A hunt with a recorded thesis"@en ; ifcore:hasAudience ifcore:Public .
ifcore:CandidateJudgedWorthContacting a ifcore:NetworkMeasure ; rdfs:label "A candidate a person judged worth contacting"@en ; ifcore:hasAudience ifcore:Public .
ifcore:ThesisRevisingConversation a ifcore:NetworkMeasure ; rdfs:label "A conversation that revised a thesis"@en ; ifcore:hasAudience ifcore:Public .
ifcore:ExperimentStarted a ifcore:NetworkMeasure ; rdfs:label "An experiment started"@en ; ifcore:hasAudience ifcore:Public .
ifcore:RecordedOutcome a ifcore:NetworkMeasure ; rdfs:label "A recorded outcome, including a failed one"@en ; ifcore:hasAudience ifcore:Public .

ifcore:measuredBy a owl:ObjectProperty ; rdfs:domain ifcore:Unit ; rdfs:range ifcore:NetworkMeasure .
ifcore:Network ifcore:measuredBy ifcore:HuntWithThesis, ifcore:CandidateJudgedWorthContacting,
    ifcore:ThesisRevisingConversation, ifcore:ExperimentStarted, ifcore:RecordedOutcome .

# ───────────────────────── Spec format (0020-spec-format) ─────────────────────────
# Both schemes reuse SKOS rather than declaring new classes (0019-controlled-vocabulary FR-001).

ifcore:SpecStatusScheme a skos:ConceptScheme ; rdfs:label "Spec status"@en ;
    rdfs:comment "Whether a spec is in force and what it takes to change it (0020-spec-format FR-009, FR-010)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:DraftSpec a skos:Concept ; skos:inScheme ifcore:SpecStatusScheme ; skos:prefLabel "Draft"@en ;
    skos:definition "In force, and open to amendment by anyone working in spec, ontology, then implementation order."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:AdoptedSpec a skos:Concept ; skos:inScheme ifcore:SpecStatusScheme ; skos:prefLabel "Adopted"@en ;
    skos:definition "In force, and amended only by the decision authority in effect or with its explicit approval; the amendment is recorded by its commit message, not a Decision individual (0008-decision-records FR-014)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:SupersededSpec a skos:Concept ; skos:inScheme ifcore:SpecStatusScheme ; skos:prefLabel "Superseded"@en ;
    skos:definition "No longer in force; the spec its status names governs instead."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:EnforcementMechanismScheme a skos:ConceptScheme ; rdfs:label "Enforcement mechanism"@en ;
    rdfs:comment "What catches a breach of a requirement, recorded once per requirement in a repository's enforcement register (0020-spec-format FR-011 – FR-014)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:CheckEnforcement a skos:Concept ; skos:inScheme ifcore:EnforcementMechanismScheme ; skos:prefLabel "check"@en ;
    skos:definition "A deterministic check fails when the requirement is broken."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:GateEnforcement a skos:Concept ; skos:inScheme ifcore:EnforcementMechanismScheme ; skos:prefLabel "gate"@en ;
    skos:definition "A command refuses to proceed when the requirement would be broken."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:ReviewEnforcement a skos:Concept ; skos:inScheme ifcore:EnforcementMechanismScheme ; skos:prefLabel "review"@en ;
    skos:definition "A recurring or triggered review, defined by a requirement, covers it."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:NoEnforcement a skos:Concept ; skos:inScheme ifcore:EnforcementMechanismScheme ; skos:prefLabel "none"@en ;
    skos:definition "Nothing catches a breach of the requirement."@en ;
    ifcore:hasAudience ifcore:Public .

# ───────────────────────── Works and presentations (0021-works-and-presentations) ─────────────────────────
# A work is the deliverable itself; a presentation is one form of it. Links reuse schema.org
# (schema:workExample, schema:exampleOfWork), PROV (prov:wasDerivedFrom, prov:wasAttributedTo), and
# Dublin Core (dcterms:format) rather than declaring new properties (0019-controlled-vocabulary FR-001).

ifcore:Presentation a owl:Class ; rdfs:subClassOf schema:CreativeWork ; rdfs:label "Presentation"@en ;
    skos:definition "One form of one work, made for an audience through a channel: a book edition, a set of web pages, a journal article, an audio or video episode, a talk, a course, or a skill or tool."@en ;
    skos:closeMatch <http://iflastandards.info/ns/lrm/lrmoo/F3_Manifestation> ;
    rdfs:comment "Specializes schema:CreativeWork (0019 FR-002); close to the IFLA LRM manifestation, but also covers live forms with no rendition, such as a talk (0021 FR-004). It names its work by schema:exampleOfWork, and the work lists it by schema:workExample (FR-005). One made from another presentation of the same work records prov:wasDerivedFrom (FR-006). Its presenter, a person, a partner, or the person who approved an AI-assisted conversion, is prov:wasAttributedTo (FR-008); the work's lifecycle owner is unchanged. Its form is dcterms:format, a concept in ifcore:PresentationFormScheme. Its ifcore:hasAudience is never broader than its work's (FR-007). Stage, owner, audience, claims, and rights stay on the work and are never restated here (FR-002). A rendition is a file generated from a presentation, not a presentation (FR-010). A company a venture's work led to is an organization related to the work by prov:wasDerivedFrom, never a presentation (FR-013)."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:PresentationFormScheme a skos:ConceptScheme ; rdfs:label "Presentation form"@en ;
    rdfs:comment "The forms a presentation takes, each reached through a channel; the value of a presentation's dcterms:format (0021-works-and-presentations FR-004, FR-012)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:BookEditionForm a skos:Concept ; skos:inScheme ifcore:PresentationFormScheme ; skos:prefLabel "Book edition"@en ;
    skos:definition "An edition of a printed or digital book."@en ; ifcore:hasAudience ifcore:Public .
ifcore:WebPagesForm a skos:Concept ; skos:inScheme ifcore:PresentationFormScheme ; skos:prefLabel "Web pages"@en ;
    skos:definition "One or more pages on a web property."@en ; ifcore:hasAudience ifcore:Public .
ifcore:ArticleForm a skos:Concept ; skos:inScheme ifcore:PresentationFormScheme ; skos:prefLabel "Article"@en ;
    skos:definition "An article in a periodical, such as a journal issue."@en ; ifcore:hasAudience ifcore:Public .
ifcore:EpisodeForm a skos:Concept ; skos:inScheme ifcore:PresentationFormScheme ; skos:prefLabel "Audio or video episode"@en ;
    skos:definition "A recorded episode, such as a podcast or a video."@en ; ifcore:hasAudience ifcore:Public .
ifcore:TalkForm a skos:Concept ; skos:inScheme ifcore:PresentationFormScheme ; skos:prefLabel "Talk"@en ;
    skos:definition "A keynote, talk, or panel given live, recorded or not."@en ; ifcore:hasAudience ifcore:Public .
ifcore:CourseForm a skos:Concept ; skos:inScheme ifcore:PresentationFormScheme ; skos:prefLabel "Course"@en ;
    skos:definition "A class, seminar, or course, delivered online or in person."@en ; ifcore:hasAudience ifcore:Public .
ifcore:PeriodicalIssueForm a skos:Concept ; skos:inScheme ifcore:PresentationFormScheme ; skos:prefLabel "Periodical issue"@en ;
    skos:definition "An issue of a periodical, such as a quarterly Journal issue, in an online or a print edition (0009-press FR-033)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:SkillOrToolForm a skos:Concept ; skos:inScheme ifcore:PresentationFormScheme ; skos:prefLabel "Skill or tool"@en ;
    skos:definition "A skill or MCP tool that carries a work's method to a reader's own AI (0009-press FR-016)."@en ; ifcore:hasAudience ifcore:Public .

# ───────────────────────── Tooling environment (0025-tooling-environment) ─────────────────────────
# Every tool installs itself: a host supplies only python3 and uv (0025 FR-014); Python packages come from hashed uv
# locks and every other program from a toolchain lock fetched into a per-user cache (0025 FR-013, FR-015). A reference
# environment is an optional convenience, never required (0025 FR-005, FR-025). The repository is reused as
# schema:SoftwareSourceCode (0019-controlled-vocabulary FR-002). Which entries a repository's toolchain lock holds is
# declared in that repository's orchestrator code, not restated here (0001-eidolon-architecture FR-019).

ifcore:ReferenceEnvironment a owl:Class ; rdfs:subClassOf schema:SoftwareSourceCode ; rdfs:label "Reference environment"@en ;
    rdfs:comment "An optional, prepared environment, a release of its repository on a Debian-family host, that a person MAY choose as a convenience. No tool, check, workflow or hint of an Eidolon repository requires it, and a tool runs on a host that has only python3 and uv (0025-tooling-environment FR-005, FR-014, FR-025)."@en .

ifcore:ToolchainEntry a owl:Class ; rdfs:subClassOf schema:SoftwareApplication ; rdfs:label "Toolchain entry"@en ;
    skos:definition "A program a command needs that has no Python wheel, pinned in a repository's toolchain lock with a version and, for each platform, an address and a SHA-256, fetched once into a per-user cache and verified before use (0025-tooling-environment FR-015, FR-016, FR-017)."@en ;
    rdfs:comment "Specializes schema:SoftwareApplication (0019 FR-002). The entries themselves are declared in each orchestrator's code (0041-command-line FR-066) and are not individuals here."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:WorkspacesHost a ifcore:ReferenceEnvironment ;
    dcterms:identifier "workspaces-host" ;
    schema:codeRepository <https://github.com/intellectual-frontiers/workspaces-host> ;
    ifcore:workspaceFlavor ifcore:DebianFamilyBareMetalFlavor ;
    rdfs:comment "Prepares a person's machine, clones and updates their repositories without touching their work, and checks health (0026-workspaces FR-008). Its orchestrator is ws-host. It is an optional convenience and the reference environment a person MAY choose (0025-tooling-environment FR-005); nothing depends on it."@en ;
    ifcore:hasAudience ifcore:Public .

# ───────────────────────── Workspaces (0026-workspaces) ─────────────────────────
# The flavor is the one way the optional workspace is run (0026 FR-001). What each repository lists is held in
# its own .workspaces-host/ws-host.env, never restated here (0001-eidolon-architecture FR-019).

ifcore:workspaceFlavor a owl:ObjectProperty ; rdfs:domain ifcore:ReferenceEnvironment ; rdfs:range skos:Concept ;
    rdfs:comment "A flavor the optional reference environment runs in, a concept in ifcore:WorkspaceFlavorScheme (0026-workspaces FR-001). No established property names the ways one environment is run; dcterms:hasFormat names derived resources, not runtimes (0019-controlled-vocabulary FR-004)."@en .

ifcore:WorkspaceFlavorScheme a skos:ConceptScheme ; rdfs:label "Workspace flavor"@en ;
    rdfs:comment "The ways the optional workspace runs; a new one is added here and in 0026-workspaces FR-001 under its own spec (FR-003)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:DebianFamilyBareMetalFlavor a skos:Concept ; skos:inScheme ifcore:WorkspaceFlavorScheme ; skos:prefLabel "Debian-family Linux"@en ;
    skos:definition "A Debian-family Linux distribution, Debian or Ubuntu, run on bare metal, under WSL on Windows, or inside a virtual machine or container (which is how macOS is supported), with VS Code as its graphical interface (0026-workspaces FR-001)."@en ; ifcore:hasAudience ifcore:Public .

# ───────────────────────── Orchestrators (0041-command-line, 0042-agora) ─────────────────────────
# A repository's orchestrator declares its commands in a registry in code (0041 FR-007); the public root's command set
# is also declared here, one individual per command, and `agora check commands` fails when the registry and these
# individuals disagree (0042 FR-004). The schemes reuse SKOS rather than declaring new classes (0019-controlled-vocabulary
# FR-001); a command is a schema:Action and its orchestrator a schema:SoftwareApplication (0019 FR-002).

ifcore:Orchestrator a owl:Class ; rdfs:subClassOf schema:SoftwareApplication ; rdfs:label "Orchestrator"@en ;
    skos:definition "The one launcher and registry of commands through which a repository's behavior runs, for people, CI and AI agents alike (0041-command-line FR-001, FR-007)."@en ;
    rdfs:comment "Specializes schema:SoftwareApplication (0019 FR-002). Each of its commands is an ifcore:Command naming it by ifcore:commandOf."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:Command a owl:Class ; rdfs:subClassOf schema:Action ; rdfs:label "Command"@en ;
    skos:definition "One command of an orchestrator: its words, the kind of resource it acts on, its verb, and its category (0041-command-line FR-008, FR-014)."@en ;
    rdfs:comment "Specializes schema:Action (0019 FR-002). Its words are dcterms:identifier, for example spec show. A command with no noun is one of the closed repository-wide set (0041 FR-010) and has no ifcore:commandNoun; a command whose second word is not in the verb scheme (the mcp control word, 0041 FR-011) or that is repository-wide has no ifcore:commandVerb, except check, which carries the verb check. Every command has exactly one category."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:commandOf a owl:ObjectProperty ; rdfs:subPropertyOf schema:isPartOf ; rdfs:domain ifcore:Command ; rdfs:range ifcore:Orchestrator ;
    rdfs:comment "The orchestrator a command belongs to (0042-agora FR-004)."@en .
ifcore:commandNoun a owl:ObjectProperty ; rdfs:domain ifcore:Command ; rdfs:range skos:Concept ;
    rdfs:comment "The kind of resource a command acts on, a concept in ifcore:ResourceKindScheme (0041-command-line FR-008). No established property names it (0019-controlled-vocabulary FR-004)."@en .
ifcore:commandVerb a owl:ObjectProperty ; rdfs:domain ifcore:Command ; rdfs:range skos:Concept ;
    rdfs:comment "A command's verb, a concept in ifcore:CommandVerbScheme (0041-command-line FR-008). No established property names it (0019-controlled-vocabulary FR-004)."@en .
ifcore:commandCategory a owl:ObjectProperty ; rdfs:domain ifcore:Command ; rdfs:range skos:Concept ;
    rdfs:comment "A command's one category, a concept in ifcore:CommandCategoryScheme, which decides what it may do and which surfaces expose it by default (0041-command-line FR-014, FR-022). No established property names it (0019-controlled-vocabulary FR-004)."@en .

ifcore:Agora a ifcore:Orchestrator ; rdfs:label "agora"@en ;
    dcterms:identifier "agora" ;
    skos:definition "The public root's orchestrator, named for the public square (0042-agora FR-001, FR-002)."@en ;
    rdfs:comment "Public only: it reads and depends on no other repository (0042 FR-003). Its commands are the ifcore:Command individuals below that name it by ifcore:commandOf."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:EditorExtension a owl:Class ; rdfs:subClassOf schema:SoftwareApplication ; rdfs:label "Editor extension"@en ;
    skos:definition "A program that runs inside an editor and operates orchestrators only through their command lines, holding no behavior of its own (0041-command-line FR-050)."@en ;
    rdfs:comment "Specializes schema:SoftwareApplication (0019 FR-002)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:drives a owl:ObjectProperty ; rdfs:domain ifcore:EditorExtension ; rdfs:range ifcore:Orchestrator ;
    rdfs:comment "An orchestrator whose commands an editor extension offers by running its command line (0043-console-protocol FR-003). The extension finds orchestrators by each repository's own declaration (0043-console-protocol FR-001), so a repository states its own individual here only where its own ontology holds it. No established property names it (0019-controlled-vocabulary FR-004)."@en .
ifcore:providesSurface a owl:ObjectProperty ; rdfs:domain ifcore:EditorExtension ; rdfs:range skos:Concept ;
    rdfs:comment "The command surface an extension is (0043-console-protocol FR-001), a concept in ifcore:CommandSurfaceScheme. No established property names it (0019-controlled-vocabulary FR-004)."@en .

ifcore:WorkspacesConsole a ifcore:EditorExtension ; rdfs:label "Workspaces Console"@en ;
    dcterms:identifier "workspaces-console" ;
    skos:definition "The one VS Code extension that is the secondary interface for every orchestrator: a tree of nouns, commands and resources, findings in the Problems panel, checks as tasks and tests, quick picks from typed arguments, a diff before any write, a modal confirmation for a decision, and each repository's MCP server registered (0043-console-protocol)."@en ;
    rdfs:comment "Public, held in the workspaces-host repository, which houses it and builds it. It drives the public root's orchestrator, and discovers any other by that repository's own declaration (0043-console-protocol FR-001). It collects no telemetry and opens no network connection."@en ;
    ifcore:providesSurface ifcore:EditorCommandSurface ;
    ifcore:drives ifcore:Agora ;
    ifcore:hasAudience ifcore:Public .


ifcore:CommandCategoryScheme a skos:ConceptScheme ; rdfs:label "Command category"@en ;
    rdfs:comment "The seven categories every command has exactly one of; a category decides what a command may do and which surfaces expose it by default (0041-command-line FR-014, FR-022)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:ReadCommandCategory a skos:Concept ; skos:inScheme ifcore:CommandCategoryScheme ; skos:prefLabel "read"@en ;
    skos:notation "read" ;
    skos:definition "Changes nothing: it returns a resource describing the repository."@en ; ifcore:hasAudience ifcore:Public .
ifcore:CheckCommandCategory a skos:Concept ; skos:inScheme ifcore:CommandCategoryScheme ; skos:prefLabel "check"@en ;
    skos:notation "check" ;
    skos:definition "Verifies something and changes nothing tracked."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RecordCommandCategory a skos:Concept ; skos:inScheme ifcore:CommandCategoryScheme ; skos:prefLabel "record"@en ;
    skos:notation "record" ;
    skos:definition "Appends a fact to the tracked record."@en ; ifcore:hasAudience ifcore:Public .
ifcore:BuildCommandCategory a skos:Concept ; skos:inScheme ifcore:CommandCategoryScheme ; skos:prefLabel "build"@en ;
    skos:notation "build" ;
    skos:definition "Writes derived output that is not itself the record."@en ; ifcore:hasAudience ifcore:Public .
ifcore:GenerateCommandCategory a skos:Concept ; skos:inScheme ifcore:CommandCategoryScheme ; skos:prefLabel "generate"@en ;
    skos:notation "generate" ;
    skos:definition "Rewrites tracked files wholly derived from a declared source, proven current by fresh."@en ; ifcore:hasAudience ifcore:Public .
ifcore:DecisionCommandCategory a skos:Concept ; skos:inScheme ifcore:CommandCategoryScheme ; skos:prefLabel "decision"@en ;
    skos:notation "decision" ;
    skos:definition "Changes what only the authority in effect decides; never callable over MCP (0041-command-line FR-023)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:SetupCommandCategory a skos:Concept ; skos:inScheme ifcore:CommandCategoryScheme ; skos:prefLabel "setup"@en ;
    skos:notation "setup" ;
    skos:definition "Changes the clone's own environment, such as a lock, a fetched toolchain entry or a running server."@en ; ifcore:hasAudience ifcore:Public .

ifcore:CommandVerbScheme a skos:ConceptScheme ; rdfs:label "Command verb"@en ;
    rdfs:comment "The fixed set of sixteen verbs an orchestrator's commands use, each one word; a verb is added only by amending 0041-command-line (FR-008, FR-009)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:ListCommandVerb a skos:Concept ; skos:inScheme ifcore:CommandVerbScheme ; skos:prefLabel "list"@en ;
    skos:notation "list" ;
    skos:definition "Many resources of a kind, with filters."@en ; ifcore:hasAudience ifcore:Public .
ifcore:ShowCommandVerb a skos:Concept ; skos:inScheme ifcore:CommandVerbScheme ; skos:prefLabel "show"@en ;
    skos:notation "show" ;
    skos:definition "One resource in full."@en ; ifcore:hasAudience ifcore:Public .
ifcore:StatusCommandVerb a skos:Concept ; skos:inScheme ifcore:CommandVerbScheme ; skos:prefLabel "status"@en ;
    skos:notation "status" ;
    skos:definition "The state of a resource over time."@en ; ifcore:hasAudience ifcore:Public .
ifcore:CheckCommandVerb a skos:Concept ; skos:inScheme ifcore:CommandVerbScheme ; skos:prefLabel "check"@en ;
    skos:notation "check" ;
    skos:definition "Verifies; the one verb that only the noun-less check command carries, because a check runs only through check (0041-command-line FR-010)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:BuildCommandVerb a skos:Concept ; skos:inScheme ifcore:CommandVerbScheme ; skos:prefLabel "build"@en ;
    skos:notation "build" ;
    skos:definition "Writes derived output that is not itself the record."@en ; ifcore:hasAudience ifcore:Public .
ifcore:GenerateCommandVerb a skos:Concept ; skos:inScheme ifcore:CommandVerbScheme ; skos:prefLabel "generate"@en ;
    skos:notation "generate" ;
    skos:definition "Writes tracked files wholly derived from a declared source."@en ; ifcore:hasAudience ifcore:Public .
ifcore:AddCommandVerb a skos:Concept ; skos:inScheme ifcore:CommandVerbScheme ; skos:prefLabel "add"@en ;
    skos:notation "add" ;
    skos:definition "Puts an item into a collection."@en ; ifcore:hasAudience ifcore:Public .
ifcore:SetCommandVerb a skos:Concept ; skos:inScheme ifcore:CommandVerbScheme ; skos:prefLabel "set"@en ;
    skos:notation "set" ;
    skos:definition "Changes one field of an existing resource."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RecordCommandVerb a skos:Concept ; skos:inScheme ifcore:CommandVerbScheme ; skos:prefLabel "record"@en ;
    skos:notation "record" ;
    skos:definition "Appends a fact to the tracked record."@en ; ifcore:hasAudience ifcore:Public .
ifcore:NewCommandVerb a skos:Concept ; skos:inScheme ifcore:CommandVerbScheme ; skos:prefLabel "new"@en ;
    skos:notation "new" ;
    skos:definition "Creates a resource."@en ; ifcore:hasAudience ifcore:Public .
ifcore:AdvanceCommandVerb a skos:Concept ; skos:inScheme ifcore:CommandVerbScheme ; skos:prefLabel "advance"@en ;
    skos:notation "advance" ;
    skos:definition "Moves a resource to its next state."@en ; ifcore:hasAudience ifcore:Public .
ifcore:EnsureCommandVerb a skos:Concept ; skos:inScheme ifcore:CommandVerbScheme ; skos:prefLabel "ensure"@en ;
    skos:notation "ensure" ;
    skos:definition "Makes a machine or a workspace match its description, doing only what is missing and safe to repeat."@en ; ifcore:hasAudience ifcore:Public .
ifcore:SyncCommandVerb a skos:Concept ; skos:inScheme ifcore:CommandVerbScheme ; skos:prefLabel "sync"@en ;
    skos:notation "sync" ;
    skos:definition "Brings a local copy of something shared up to date, by fast-forward alone."@en ; ifcore:hasAudience ifcore:Public .
ifcore:PublishCommandVerb a skos:Concept ; skos:inScheme ifcore:CommandVerbScheme ; skos:prefLabel "publish"@en ;
    skos:notation "publish" ;
    skos:definition "Sends something outside the clone."@en ; ifcore:hasAudience ifcore:Public .
ifcore:ServeCommandVerb a skos:Concept ; skos:inScheme ifcore:CommandVerbScheme ; skos:prefLabel "serve"@en ;
    skos:notation "serve" ;
    skos:definition "Runs until stopped."@en ; ifcore:hasAudience ifcore:Public .
ifcore:TestCommandVerb a skos:Concept ; skos:inScheme ifcore:CommandVerbScheme ; skos:prefLabel "test"@en ;
    skos:notation "test" ;
    skos:definition "Runs a resource's tests in a place its own check does not, writing nothing."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RemoveCommandVerb a skos:Concept ; skos:inScheme ifcore:CommandVerbScheme ; skos:prefLabel "remove"@en ;
    skos:notation "remove" ;
    skos:definition "Takes an item out of a collection, or an installed thing off a machine: the inverse of add."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RunCommandVerb a skos:Concept ; skos:inScheme ifcore:CommandVerbScheme ; skos:prefLabel "run"@en ;
    skos:notation "run" ;
    skos:definition "Runs a program of the resource, in the environment the resource defines, and passes its output and status through."@en ; ifcore:hasAudience ifcore:Public .

ifcore:CommandSurfaceScheme a skos:ConceptScheme ; rdfs:label "Command surface"@en ;
    rdfs:comment "The three surfaces an orchestrator's commands are exposed on; a category decides which by default (0041-command-line FR-011, FR-022). The terminal is the core; the editor is served by the Workspaces Console extension (0043-console-protocol), not by a command; and MCP is for agents. No web UI is a surface."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:TerminalCommandSurface a skos:Concept ; skos:inScheme ifcore:CommandSurfaceScheme ; skos:prefLabel "terminal"@en ;
    skos:notation "cli" ;
    skos:definition "The command line, the core interface; every command is callable here (0041-command-line FR-022)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:EditorCommandSurface a skos:Concept ; skos:inScheme ifcore:CommandSurfaceScheme ; skos:prefLabel "editor"@en ;
    skos:notation "editor" ;
    skos:definition "The secondary interface, the Workspaces Console VS Code extension, which renders resources and runs their actions by invoking the orchestrator and holds no behavior of its own (0041-command-line FR-050, 0043-console-protocol FR-003)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:McpCommandSurface a skos:Concept ; skos:inScheme ifcore:CommandSurfaceScheme ; skos:prefLabel "MCP"@en ;
    skos:notation "mcp" ;
    skos:definition "The MCP server, which never exposes a decision command (0041-command-line FR-023, FR-027)."@en ; ifcore:hasAudience ifcore:Public .

ifcore:ResourceKindScheme a skos:ConceptScheme ; rdfs:label "Resource kind"@en ;
    rdfs:comment "The kinds of resource an orchestrator's commands act on, which are its nouns (0041-command-line FR-008, FR-016). A repository-wide command's own resource has its command's name as its kind, and an error has the kind error; neither is a noun."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:CommandResourceKind a skos:Concept ; skos:inScheme ifcore:ResourceKindScheme ; skos:prefLabel "command"@en ;
    skos:notation "command" ;
    skos:definition "A command in the registry."@en ; ifcore:hasAudience ifcore:Public .
ifcore:McpResourceKind a skos:Concept ; skos:inScheme ifcore:ResourceKindScheme ; skos:prefLabel "mcp"@en ;
    skos:notation "mcp" ;
    skos:definition "The MCP server agora serves."@en ; ifcore:hasAudience ifcore:Public .
ifcore:ProposalResourceKind a skos:Concept ; skos:inScheme ifcore:ResourceKindScheme ; skos:prefLabel "proposal"@en ;
    skos:notation "proposal" ;
    skos:definition "A tracked, replayable change proposed for a person to decide (0041-command-line FR-039)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:SpecResourceKind a skos:Concept ; skos:inScheme ifcore:ResourceKindScheme ; skos:prefLabel "spec"@en ;
    skos:notation "spec" ;
    skos:definition "A spec, numbered or a design system's."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RequirementResourceKind a skos:Concept ; skos:inScheme ifcore:ResourceKindScheme ; skos:prefLabel "requirement"@en ;
    skos:notation "requirement" ;
    skos:definition "One requirement of a spec, with its enforcement and control rows."@en ; ifcore:hasAudience ifcore:Public .
ifcore:OntologyResourceKind a skos:Concept ; skos:inScheme ifcore:ResourceKindScheme ; skos:prefLabel "ontology"@en ;
    skos:notation "ontology" ;
    skos:definition "A term of the ontology: a class, property, individual, concept scheme or concept (0042-agora FR-037)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:ReflectionResourceKind a skos:Concept ; skos:inScheme ifcore:ResourceKindScheme ; skos:prefLabel "reflection"@en ;
    skos:notation "reflection" ;
    skos:definition "A digital reflection: an Eidolon, an Ergon or a Noema, and the subject it is a record of (0047-digital-reflections, 0048-noemas FR-032)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:DesignSystemResourceKind a skos:Concept ; skos:inScheme ifcore:ResourceKindScheme ; skos:prefLabel "design-system"@en ;
    skos:notation "design-system" ;
    skos:definition "A design system registered in the ontology."@en ; ifcore:hasAudience ifcore:Public .
ifcore:BrandResourceKind a skos:Concept ; skos:inScheme ifcore:ResourceKindScheme ; skos:prefLabel "brand"@en ;
    skos:notation "brand" ;
    skos:definition "A brand design system."@en ; ifcore:hasAudience ifcore:Public .
ifcore:ImageryResourceKind a skos:Concept ; skos:inScheme ifcore:ResourceKindScheme ; skos:prefLabel "imagery"@en ;
    skos:notation "imagery" ;
    skos:definition "A brand's imagery pool and its pieces."@en ; ifcore:hasAudience ifcore:Public .
ifcore:DecorationResourceKind a skos:Concept ; skos:inScheme ifcore:ResourceKindScheme ; skos:prefLabel "decoration"@en ;
    skos:notation "decoration" ;
    skos:definition "A brand's decoration kit."@en ; ifcore:hasAudience ifcore:Public .
ifcore:InkResourceKind a skos:Concept ; skos:inScheme ifcore:ResourceKindScheme ; skos:prefLabel "ink"@en ;
    skos:notation "ink" ;
    skos:definition "One ink of a brand's decoration kit."@en ; ifcore:hasAudience ifcore:Public .
ifcore:OpenedxResourceKind a skos:Concept ; skos:inScheme ifcore:ResourceKindScheme ; skos:prefLabel "openedx"@en ;
    skos:notation "openedx" ;
    skos:definition "A brand's Open edX package."@en ; ifcore:hasAudience ifcore:Public .
ifcore:LayoutResourceKind a skos:Concept ; skos:inScheme ifcore:ResourceKindScheme ; skos:prefLabel "layout"@en ;
    skos:notation "layout" ;
    skos:definition "A print layout of the print design system."@en ; ifcore:hasAudience ifcore:Public .
ifcore:SkillResourceKind a skos:Concept ; skos:inScheme ifcore:ResourceKindScheme ; skos:prefLabel "skill"@en ;
    skos:notation "skill" ;
    skos:definition "The skill file that tells an AI agent how to use the orchestrator, generated from its registry (0041-command-line FR-037, 0042-agora FR-028)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:DocsResourceKind a skos:Concept ; skos:inScheme ifcore:ResourceKindScheme ; skos:prefLabel "docs"@en ;
