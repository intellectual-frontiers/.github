@prefix ifcore:  <https://www.intellectualfrontiers.com/ontology/core#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix schema:  <https://schema.org/> .
@prefix org:     <http://www.w3.org/ns/org#> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix qb:      <http://purl.org/linked-data/cube#> .
@prefix ifweb:   <https://www.intellectualfrontiers.com/ontology/web#> .
@prefix bibo:    <http://purl.org/ontology/bibo/> .

# Intellectual Frontiers — core ontology (PUBLIC).
#
# Implements 0001-eidolon-architecture. Every class, property, and individual
# here traces to a requirement in that spec; nothing is asserted ahead of it
# (FR-037). A private ontology imports this and adds its own individuals; it
# must not redefine or remove anything declared here (FR-003).
#
# Every individual that carries asserted factual content (a label naming a
# real thing, a definition, a job, a question) declares ifcore:hasAudience
# explicitly, per FR-011 — never left implicit from being in a public
# repository. A class or property declaration (the vocabulary itself) is not
# a fact and does not carry one.

<https://www.intellectualfrontiers.com/ontology/core>
    a owl:Ontology ;
    owl:versionInfo "0.1.0" ;
    dcterms:title "Intellectual Frontiers core ontology"@en ;
    dcterms:source <https://github.com/intellectual-frontiers/.github/blob/main/spec-kit/specs/0001-eidolon-architecture/spec.md> ;
    rdfs:comment "The company, the Eidolon's own repositories, audiences, references, and governance, per 0001-eidolon-architecture."@en .

# ───────────────────────── Organization ─────────────────────────

ifcore:Organization a owl:Class ; rdfs:subClassOf org:Organization, schema:Organization ; rdfs:label "Organization"@en .
ifcore:Company a owl:Class ; skos:closeMatch schema:Corporation ; rdfs:subClassOf ifcore:Organization ; rdfs:label "Company"@en .
ifcore:Person a owl:Class ; rdfs:subClassOf schema:Person ; rdfs:label "Person"@en .

ifcore:legalName a owl:DatatypeProperty ; rdfs:subPropertyOf schema:legalName ; rdfs:domain ifcore:Person ; rdfs:range xsd:string ;
    rdfs:comment "A person's full legal name, as it would appear on a signed document."@en .
ifcore:displayName a owl:DatatypeProperty ; rdfs:subPropertyOf schema:name ; rdfs:domain ifcore:Person ; rdfs:range xsd:string ;
    rdfs:comment "The name a person is known by in ordinary prose and branding."@en .

ifcore:IntellectualFrontiersLLC a ifcore:Company ;
    rdfs:label "Intellectual Frontiers LLC"@en ;
    skos:altLabel "Intellectual Frontiers"@en ;
    schema:slogan "A think tank that builds useful things."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:ShahidNehalShah a ifcore:Person ;
    ifcore:legalName "Shahid Nehal Shah"@en ;
    ifcore:displayName "Shahid N. Shah"@en ;
    ifcore:hasAudience ifcore:Public .

# ───────────────────────── The Eidolon's own repositories (FR-001) ─────────────────────────

ifcore:EidolonComponent a owl:Class ; rdfs:label "Eidolon component"@en ;
    rdfs:comment "One of the Eidolon's three repositories: the public Eidolon, the private Eidolon where works are made, and one presentation channel for them (FR-001)."@en .

ifcore:PublicRoot a ifcore:EidolonComponent ; rdfs:label "Public root"@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:PrivateVault a ifcore:EidolonComponent ; rdfs:label "Private vault"@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:WebProperty a ifcore:EidolonComponent ; rdfs:label "Web property"@en ;
    rdfs:comment "A channel through which presentations of works reach an audience. It holds no work of its own (FR-001; 0021-works-and-presentations FR-011)."@en ;
    ifcore:hasAudience ifcore:Public .

# ───────────────────────── Design systems (0014-design-systems) ─────────────────────────

ifcore:DesignSystem a owl:Class ; rdfs:label "Design system"@en ;
    rdfs:comment "A named, self-contained, versionable set of public house rules for one kind of output, with their machine-readable form, assets and assurance harness, at design-systems/<slug>/, per 0014-design-systems FR-001, FR-010. Its kind is dcterms:type, a concept in ifcore:DesignSystemKindScheme (FR-018); each design system it derives from is prov:wasDerivedFrom (FR-020)."@en .

ifcore:designSystemStatus a owl:ObjectProperty ; rdfs:domain ifcore:DesignSystem ; rdfs:range ifcore:DesignSystemStatus ;
    rdfs:comment "The one record of whether a design system is active or draft (0014-design-systems FR-010, FR-011) — never its own README. A design system no longer used is removed, not given a status (FR-035)."@en .

ifcore:DesignSystemStatus a owl:Class ; rdfs:label "Design system status"@en .
ifcore:ActiveDesignSystem a ifcore:DesignSystemStatus ; rdfs:label "Active"@en ; ifcore:hasAudience ifcore:Public .
ifcore:DraftDesignSystem a ifcore:DesignSystemStatus ; rdfs:label "Draft"@en ; ifcore:hasAudience ifcore:Public .

ifcore:DesignSystemKindScheme a skos:ConceptScheme ; rdfs:label "Design system kind"@en ;
    rdfs:comment "What a design system governs (0014-design-systems FR-018). A concept is in this scheme only if 0014-design-systems has a kind profile for it (FR-019), and its skos:notation is the code that ends the slug of every design system of that kind (FR-003, FR-018); a broader concept groups kinds, has no code, and is never itself a design system's kind."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:VisualDesignSystemKind a skos:Concept ; skos:inScheme ifcore:DesignSystemKindScheme ; skos:prefLabel "visual"@en ;
    skos:definition "Kinds that govern how output looks."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:VerbalDesignSystemKind a skos:Concept ; skos:inScheme ifcore:DesignSystemKindScheme ; skos:prefLabel "verbal"@en ;
    skos:definition "Kinds that govern how output reads or sounds."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:BrandDesignSystemKind a skos:Concept ; skos:inScheme ifcore:DesignSystemKindScheme ; skos:prefLabel "brand"@en ;
    skos:notation "brand" ;
    skos:definition "The identity every other kind draws on: palette, typeface families, logo, imagery identity (0014-design-systems FR-028)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:WebDesignSystemKind a skos:Concept ; skos:inScheme ifcore:DesignSystemKindScheme ; skos:broader ifcore:VisualDesignSystemKind ; skos:prefLabel "web presentation"@en ;
    skos:notation "web" ;
    skos:definition "How a web page looks and the DOM shape its interactive chrome expects (0014-design-systems FR-029)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:PrintDesignSystemKind a skos:Concept ; skos:inScheme ifcore:DesignSystemKindScheme ; skos:broader ifcore:VisualDesignSystemKind ; skos:prefLabel "print"@en ;
    skos:notation "print" ;
    skos:definition "How a printed or ebook book, paper or cover is set (0014-design-systems FR-031)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:MerchandiseDesignSystemKind a skos:Concept ; skos:inScheme ifcore:DesignSystemKindScheme ; skos:broader ifcore:VisualDesignSystemKind ; skos:prefLabel "merchandise"@en ;
    skos:notation "merchandise" ;
    skos:altLabel "branded merchandise"@en , "promotional products"@en ;
    skos:definition "How the brand is applied to physical goods: decoration method, imprint location and size, ink and thread (0014-design-systems FR-045)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:FigureDesignSystemKind a skos:Concept ; skos:inScheme ifcore:DesignSystemKindScheme ; skos:broader ifcore:VisualDesignSystemKind ; skos:prefLabel "figure"@en ;
    skos:notation "figures" ;
    skos:definition "How a work's figures are drawn, in print or on the web (0014-design-systems FR-032)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:SlidesDesignSystemKind a skos:Concept ; skos:inScheme ifcore:DesignSystemKindScheme ; skos:broader ifcore:VisualDesignSystemKind ; skos:prefLabel "slides"@en ;
    skos:notation "slides" ;
    skos:altLabel "slide deck"@en , "presentation"@en ;
    skos:definition "How a talk, lecture, workshop or briefing is presented on a screen: canvas, layouts, type, tones and the limits a slide keeps to (0014-design-systems FR-049)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:MediaDesignSystemKind a skos:Concept ; skos:inScheme ifcore:DesignSystemKindScheme ; skos:broader ifcore:VisualDesignSystemKind ; skos:prefLabel "media"@en ;
    skos:notation "media" ;
    skos:altLabel "media packaging"@en ;
    skos:definition "The images that package a work for a platform: podcast and episode art, video thumbnails, title cards, lower thirds and social cards (0014-design-systems FR-050)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:EmailDesignSystemKind a skos:Concept ; skos:inScheme ifcore:DesignSystemKindScheme ; skos:broader ifcore:VisualDesignSystemKind ; skos:prefLabel "email"@en ;
    skos:notation "email" ;
    skos:definition "The messages the house sends by email: layout, type, color, logo, footer and plain-text alternative, within what mail clients render (0014-design-systems FR-051)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:WrittenVoiceDesignSystemKind a skos:Concept ; skos:inScheme ifcore:DesignSystemKindScheme ; skos:broader ifcore:VerbalDesignSystemKind ; skos:prefLabel "written voice"@en ;
    skos:notation "written-voice" ;
    skos:definition "How the house writes: voice, usage, punctuation, and presentation form (0014-design-systems FR-033)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:SpokenVoiceDesignSystemKind a skos:Concept ; skos:inScheme ifcore:DesignSystemKindScheme ; skos:broader ifcore:VerbalDesignSystemKind ; skos:prefLabel "spoken voice"@en ;
    skos:notation "spoken-voice" ;
    skos:definition "How the house voice changes when a work is heard rather than read; always derived from a written-voice design system (0014-design-systems FR-034)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:CourseDesignSystemKind a skos:Concept ; skos:inScheme ifcore:DesignSystemKindScheme ; skos:prefLabel "course"@en ;
    skos:notation "course" ;
    skos:altLabel "courseware"@en , "long-form education"@en ;
    skos:definition "How a long-form course is structured, paced, assessed and made accessible, and the delivery targets it is compiled to; it spans how a course looks and how it reads (0014-design-systems FR-052)."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:WebInteractionModelScheme a skos:ConceptScheme ; rdfs:label "Web interaction model"@en ;
    rdfs:comment "What a web design system's pages are for (0014-design-systems FR-041): a read-mostly content site or a read-write web application, and the kinds of each. A web design system names every one it serves, by dcterms:type."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:ContentSite a skos:Concept ; skos:inScheme ifcore:WebInteractionModelScheme ; skos:prefLabel "content site"@en ;
    skos:definition "A read-mostly site: people come to read, compare and decide."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:MarketingSite a skos:Concept ; skos:inScheme ifcore:WebInteractionModelScheme ; skos:broader ifcore:ContentSite ; skos:prefLabel "marketing site"@en ;
    skos:definition "Pages that present an offer and lead to one action: landing pages, product pages."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:EditorialSite a skos:Concept ; skos:inScheme ifcore:WebInteractionModelScheme ; skos:broader ifcore:ContentSite ; skos:prefLabel "editorial site"@en ;
    skos:definition "Long-form reading: articles, essays, issues of a publication."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:DocumentationSite a skos:Concept ; skos:inScheme ifcore:WebInteractionModelScheme ; skos:broader ifcore:ContentSite ; skos:prefLabel "documentation"@en ;
    skos:definition "Tutorials, how-to guides, reference and explanation, as the Diataxis framework divides them."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:WebApplication a skos:Concept ; skos:inScheme ifcore:WebInteractionModelScheme ; skos:prefLabel "web application"@en ;
    skos:definition "A read-write application: people come to create, change and act on records."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:ProductApplication a skos:Concept ; skos:inScheme ifcore:WebInteractionModelScheme ; skos:broader ifcore:WebApplication ; skos:prefLabel "product application"@en ;
    skos:definition "The application a product sells to its customers (software as a service)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:BackOffice a skos:Concept ; skos:inScheme ifcore:WebInteractionModelScheme ; skos:broader ifcore:WebApplication ; skos:prefLabel "back office"@en ;
    skos:definition "Internal tools for the people who operate a business."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:Dashboard a skos:Concept ; skos:inScheme ifcore:WebInteractionModelScheme ; skos:broader ifcore:WebApplication ; skos:prefLabel "dashboard"@en ;
    skos:definition "Monitoring and reporting at a glance: figures, status, trends."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:TransactionalService a skos:Concept ; skos:inScheme ifcore:WebInteractionModelScheme ; skos:broader ifcore:WebApplication ; skos:prefLabel "transactional service"@en ;
    skos:definition "A multi-step task completed once: sign-up, checkout, an application (GOV.UK names these transactional services)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:DesignExpressionScheme a skos:ConceptScheme ; rdfs:label "Design expression"@en ;
    rdfs:comment "How much a web design system's type and motion assert themselves (0014-design-systems FR-041), as IBM's Carbon design system names the two ends. A web design system is exactly one."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:ProductiveExpression a skos:Concept ; skos:inScheme ifcore:DesignExpressionScheme ; skos:prefLabel "productive"@en ;
    skos:definition "Calm, dense, efficient type and motion that keep attention on the task."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:ExpressiveExpression a skos:Concept ; skos:inScheme ifcore:DesignExpressionScheme ; skos:prefLabel "expressive"@en ;
    skos:definition "Larger type, more motion and imagery, for marketing and editorial moments."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:DesignDensityScheme a skos:ConceptScheme ; rdfs:label "Design density"@en ;
    rdfs:comment "How much a web design system fits in a space (0014-design-systems FR-041), as Material Design names the steps. A web design system names every density it supports."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:DefaultDensity a skos:Concept ; skos:inScheme ifcore:DesignDensityScheme ; skos:prefLabel "default"@en ;
    skos:definition "The standard spacing of controls and rows."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:ComfortableDensity a skos:Concept ; skos:inScheme ifcore:DesignDensityScheme ; skos:prefLabel "comfortable"@en ;
    skos:definition "Tighter than default, for screens people scan often."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:CompactDensity a skos:Concept ; skos:inScheme ifcore:DesignDensityScheme ; skos:prefLabel "compact"@en ;
    skos:definition "The tightest spacing, for data-dense tables and tools."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:PrintDocumentTypeScheme a skos:ConceptScheme ; rdfs:label "Print document type"@en ;
    rdfs:comment "What a print design system sets (0014-design-systems FR-042), as publishing names it. A print design system names every one it sets, by dcterms:type."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:BookInterior a skos:Concept ; skos:inScheme ifcore:PrintDocumentTypeScheme ; skos:prefLabel "book interior"@en ;
    skos:definition "The pages of a printed or ebook book between its covers."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:BookCover a skos:Concept ; skos:inScheme ifcore:PrintDocumentTypeScheme ; skos:prefLabel "book cover"@en ;
    skos:definition "The front cover, spine and back cover of a book."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:JournalArticle a skos:Concept ; skos:inScheme ifcore:PrintDocumentTypeScheme ; skos:prefLabel "journal article"@en ;
    skos:definition "A research paper set as a journal sets one."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:Report a skos:Concept ; skos:inScheme ifcore:PrintDocumentTypeScheme ; skos:prefLabel "report"@en ;
    skos:definition "A standalone document of findings, set for print or PDF."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:Poster a skos:Concept ; skos:inScheme ifcore:PrintDocumentTypeScheme ; skos:prefLabel "poster"@en ;
    skos:definition "A sign printed at large size and hung or mounted: an event, a book or a workshop."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:RollUpBanner a skos:Concept ; skos:inScheme ifcore:PrintDocumentTypeScheme ; skos:prefLabel "roll-up banner"@en ;
    skos:altLabel "pull-up banner"@en ;
    skos:definition "A tall printed banner on a retractable stand, for a booth or a stage."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:EventBadge a skos:Concept ; skos:inScheme ifcore:PrintDocumentTypeScheme ; skos:prefLabel "event badge"@en ;
    skos:altLabel "name badge"@en ;
    skos:definition "A small printed card naming its wearer at an event."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:drawsFiguresWith a owl:ObjectProperty ; rdfs:domain ifcore:DesignSystem ; rdfs:range ifcore:DesignSystem ;
    rdfs:label "draws figures with"@en ;
    rdfs:comment "The figure design system whose figures a web or print design system's pages carry, themed by the same brand (0014-design-systems FR-048)."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:FigureTypeScheme a skos:ConceptScheme ; rdfs:label "Figure type"@en ;
    rdfs:comment "What a figure design system's layouts draw (0014-design-systems FR-032), as diagramming names it."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:ProcessDiagram a skos:Concept ; skos:inScheme ifcore:FigureTypeScheme ; skos:prefLabel "process diagram"@en ;
    skos:definition "Steps in order, joined by arrows."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:ComparisonDiagram a skos:Concept ; skos:inScheme ifcore:FigureTypeScheme ; skos:prefLabel "comparison diagram"@en ;
    skos:definition "Two columns side by side: before and after, this or that."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:CycleDiagram a skos:Concept ; skos:inScheme ifcore:FigureTypeScheme ; skos:prefLabel "cycle diagram"@en ;
    skos:definition "Steps around a loop, each feeding the next."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:LayerDiagram a skos:Concept ; skos:inScheme ifcore:FigureTypeScheme ; skos:prefLabel "layer diagram"@en ;
    skos:definition "Layers stacked, each resting on the one below."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:RelationshipDiagram a skos:Concept ; skos:inScheme ifcore:FigureTypeScheme ; skos:prefLabel "relationship diagram"@en ;
    skos:definition "Many sources converging on one result."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:DecisionFlowchart a skos:Concept ; skos:inScheme ifcore:FigureTypeScheme ; skos:prefLabel "decision flowchart"@en ;
    skos:definition "A question that splits into paths."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:HierarchyDiagram a skos:Concept ; skos:inScheme ifcore:FigureTypeScheme ; skos:prefLabel "hierarchy diagram"@en ;
    skos:definition "A root over its children."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:BarChart a skos:Concept ; skos:inScheme ifcore:FigureTypeScheme ; skos:prefLabel "bar chart"@en ;
    skos:definition "Values compared as bars, one per category, each labelled with its value."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:LineChart a skos:Concept ; skos:inScheme ifcore:FigureTypeScheme ; skos:prefLabel "line chart"@en ;
    skos:definition "One or more series over an ordered axis, usually time, each named at its end."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:Timeline a skos:Concept ; skos:inScheme ifcore:FigureTypeScheme ; skos:prefLabel "timeline"@en ;
    skos:definition "Events in order, each with its date."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:DeckTypeScheme a skos:ConceptScheme ; rdfs:label "Deck type"@en ;
    skos:definition "The kinds of presentation a slides design system serves (0014-design-systems FR-049)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:TalkDeck a skos:Concept ; skos:inScheme ifcore:DeckTypeScheme ; skos:prefLabel "talk"@en ;
    skos:definition "A deck one speaker presents to an audience, as at a conference or a keynote."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:LectureDeck a skos:Concept ; skos:inScheme ifcore:DeckTypeScheme ; skos:prefLabel "lecture"@en ;
    skos:definition "A deck that teaches, as one session of a course."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:WorkshopDeck a skos:Concept ; skos:inScheme ifcore:DeckTypeScheme ; skos:prefLabel "workshop"@en ;
    skos:definition "A deck that runs a working session: exercises, prompts and timings."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:BriefingDeck a skos:Concept ; skos:inScheme ifcore:DeckTypeScheme ; skos:prefLabel "briefing"@en ;
    skos:definition "A deck that informs a decision: a board, investor or customer briefing."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:MediaAssetTypeScheme a skos:ConceptScheme ; rdfs:label "Media asset type"@en ;
    skos:definition "The images a media design system makes to package a work for a platform (0014-design-systems FR-050)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:PodcastCoverArt a skos:Concept ; skos:inScheme ifcore:MediaAssetTypeScheme ; skos:prefLabel "podcast cover art"@en ;
    skos:definition "The square image a podcast directory shows for a show."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:EpisodeArt a skos:Concept ; skos:inScheme ifcore:MediaAssetTypeScheme ; skos:prefLabel "episode art"@en ;
    skos:definition "The square image a podcast directory shows for one episode."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:VideoThumbnail a skos:Concept ; skos:inScheme ifcore:MediaAssetTypeScheme ; skos:prefLabel "video thumbnail"@en ;
    skos:definition "The 16:9 image a video platform shows before a video plays."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:TitleCard a skos:Concept ; skos:inScheme ifcore:MediaAssetTypeScheme ; skos:prefLabel "title card"@en ;
    skos:definition "The full-frame card that opens a video or one of its parts."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:LowerThird a skos:Concept ; skos:inScheme ifcore:MediaAssetTypeScheme ; skos:prefLabel "lower third"@en ;
    skos:definition "The transparent overlay naming who is on screen, in the lower third of the frame."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:SocialCard a skos:Concept ; skos:inScheme ifcore:MediaAssetTypeScheme ; skos:prefLabel "social card"@en ;
    skos:definition "An image announcing a work on a social platform: square, portrait or story."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:EmailTypeScheme a skos:ConceptScheme ; rdfs:label "Email type"@en ;
    skos:definition "The kinds of message an email design system sends (0014-design-systems FR-051)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:NewsletterEmail a skos:Concept ; skos:inScheme ifcore:EmailTypeScheme ; skos:prefLabel "newsletter"@en ;
    skos:definition "A periodical issue sent to subscribers."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:AnnouncementEmail a skos:Concept ; skos:inScheme ifcore:EmailTypeScheme ; skos:prefLabel "announcement"@en ;
    skos:definition "A one-off message announcing a work, an episode or an event to subscribers."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:InvitationEmail a skos:Concept ; skos:inScheme ifcore:EmailTypeScheme ; skos:prefLabel "invitation"@en ;
    skos:definition "A message inviting its reader to an event, a workshop or a course."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:NotificationEmail a skos:Concept ; skos:inScheme ifcore:EmailTypeScheme ; skos:prefLabel "notification"@en ;
    skos:definition "A message about something its reader did or asked for: a confirmation, a receipt, a reminder."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:CourseFormatScheme a skos:ConceptScheme ; rdfs:label "Course format"@en ;
    skos:definition "How a course paces its learners (0014-design-systems FR-052)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:SelfPacedCourse a skos:Concept ; skos:inScheme ifcore:CourseFormatScheme ; skos:prefLabel "self-paced"@en ;
    skos:definition "A course a learner takes at their own pace, with every unit open from the start."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:InstructorPacedCourse a skos:Concept ; skos:inScheme ifcore:CourseFormatScheme ; skos:prefLabel "instructor-paced"@en ;
    skos:altLabel "cohort"@en ;
    skos:definition "A course a cohort takes together, with units released and due by week."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:AssessmentItemTypeScheme a skos:ConceptScheme ; rdfs:label "Assessment item type"@en ;
    skos:definition "The kinds of item a course design system's assessments ask, each graded automatically (0014-design-systems FR-052)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:MultipleChoiceItem a skos:Concept ; skos:inScheme ifcore:AssessmentItemTypeScheme ; skos:prefLabel "multiple choice"@en ;
    skos:definition "An item with one correct choice among several."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:MultipleResponseItem a skos:Concept ; skos:inScheme ifcore:AssessmentItemTypeScheme ; skos:prefLabel "multiple response"@en ;
    skos:altLabel "checkbox"@en ;
    skos:definition "An item where the learner selects every correct choice among several."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:NumericResponseItem a skos:Concept ; skos:inScheme ifcore:AssessmentItemTypeScheme ; skos:prefLabel "numeric response"@en ;
    skos:definition "An item answered with a number, accepted within a stated tolerance."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:TextMatchItem a skos:Concept ; skos:inScheme ifcore:AssessmentItemTypeScheme ; skos:prefLabel "text match"@en ;
    skos:altLabel "text input"@en ;
    skos:definition "An item answered with a short text, accepted if it matches one of the stated answers."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:CourseDeliveryTargetScheme a skos:ConceptScheme ; rdfs:label "Course delivery target"@en ;
    skos:definition "The forms a course design system compiles a course to, each for a place courses are delivered (0014-design-systems FR-052)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:StaticWebEdition a skos:Concept ; skos:inScheme ifcore:CourseDeliveryTargetScheme ; skos:prefLabel "static web edition"@en ;
    skos:definition "A course as a static web site anyone can read, its practice graded in the browser."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:OpenEdxOlxExport a skos:Concept ; skos:inScheme ifcore:CourseDeliveryTargetScheme ; skos:prefLabel "Open edX OLX export"@en ;
    skos:altLabel "OLX"@en ;
    skos:definition "A course as an Open edX course export (Open Learning XML) that Studio imports."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:Cmi5Package a skos:Concept ; skos:inScheme ifcore:CourseDeliveryTargetScheme ; skos:prefLabel "cmi5 package"@en ;
    skos:definition "A course as a cmi5 course package an LMS imports, its pages reporting to the LMS by xAPI."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:DecorationMethodScheme a skos:ConceptScheme ; rdfs:label "Decoration method"@en ;
    rdfs:comment "How a merchandise design system puts artwork on goods (0014-design-systems FR-046), as the promotional products industry names it."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:ScreenPrinting a skos:Concept ; skos:inScheme ifcore:DecorationMethodScheme ; skos:prefLabel "screen printing"@en ;
    skos:definition "Spot-color ink pushed through a mesh stencil, one screen per color."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:Embroidery a skos:Concept ; skos:inScheme ifcore:DecorationMethodScheme ; skos:prefLabel "embroidery"@en ;
    skos:definition "Artwork stitched in thread."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:PadPrinting a skos:Concept ; skos:inScheme ifcore:DecorationMethodScheme ; skos:prefLabel "pad printing"@en ;
    skos:definition "Spot-color ink transferred by a silicone pad onto a small or curved surface."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:LaserEngraving a skos:Concept ; skos:inScheme ifcore:DecorationMethodScheme ; skos:prefLabel "laser engraving"@en ;
    skos:definition "Artwork burned or etched into the surface; the material is the only color."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:DirectToGarmentPrinting a skos:Concept ; skos:inScheme ifcore:DecorationMethodScheme ; skos:prefLabel "direct-to-garment printing"@en ;
    skos:definition "Full-color inkjet printing onto fabric."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:Debossing a skos:Concept ; skos:inScheme ifcore:DecorationMethodScheme ; skos:prefLabel "debossing"@en ;
    skos:definition "Artwork pressed into the material, with no ink."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:ProductCategoryScheme a skos:ConceptScheme ; rdfs:label "Product category"@en ;
    rdfs:comment "What goods a merchandise design system governs (0014-design-systems FR-046), as the promotional products industry names them."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:Apparel a skos:Concept ; skos:inScheme ifcore:ProductCategoryScheme ; skos:prefLabel "apparel"@en ;
    skos:definition "Shirts, polos and other garments."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:Headwear a skos:Concept ; skos:inScheme ifcore:ProductCategoryScheme ; skos:prefLabel "headwear"@en ;
    skos:definition "Caps and hats."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:Drinkware a skos:Concept ; skos:inScheme ifcore:ProductCategoryScheme ; skos:prefLabel "drinkware"@en ;
    skos:definition "Mugs, tumblers and bottles."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:WritingInstruments a skos:Concept ; skos:inScheme ifcore:ProductCategoryScheme ; skos:prefLabel "writing instruments"@en ;
    skos:definition "Pens and pencils."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:Bags a skos:Concept ; skos:inScheme ifcore:ProductCategoryScheme ; skos:prefLabel "bags"@en ;
    skos:definition "Totes and other bags."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:FrontiersBrand a ifcore:DesignSystem ;
    dcterms:identifier "frontiers-brand" ;
    rdfs:label "Frontiers Brand"@en ;
    ifcore:designSystemStatus ifcore:ActiveDesignSystem ;
    dcterms:type ifcore:BrandDesignSystemKind ;
    rdfs:comment "At design-systems/frontiers-brand/; its house rules are design-systems/frontiers-brand/spec.md. Intellectual Frontiers' own identity: palette, theme roles, unit colors, typefaces, logo, icon and imagery (0014-design-systems FR-028). It themes the Intellectual Frontiers web design systems (FR-038)."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:ExampleBrand a ifcore:DesignSystem ;
    dcterms:identifier "example-brand" ;
    rdfs:label "Example Brand"@en ;
    ifcore:designSystemStatus ifcore:DraftDesignSystem ;
    dcterms:type ifcore:BrandDesignSystemKind ;
    rdfs:comment "At design-systems/example-brand/; its house rules are design-systems/example-brand/spec.md. A test brand, deliberately not Intellectual Frontiers', that every web design system is run themed by, to prove it can be themed by any brand (0014-design-systems FR-039). Never used to publish."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:FrontiersPrint a ifcore:DesignSystem ;
    dcterms:identifier "frontiers-print" ;
    rdfs:label "Frontiers Print"@en ;
    ifcore:designSystemStatus ifcore:DraftDesignSystem ;
    dcterms:type ifcore:PrintDesignSystemKind , ifcore:BookInterior , ifcore:BookCover , ifcore:JournalArticle ;
    rdfs:comment "At design-systems/frontiers-print/; its house rules are design-systems/frontiers-print/spec.md. The book interior, book cover and journal article design, in LaTeX, themed by a brand's brand.tex (0014-design-systems FR-031, FR-038)."@en ;
    ifcore:drawsFiguresWith ifcore:FrontiersFigures ;
    ifcore:hasAudience ifcore:Public .

ifcore:FrontiersFigures a ifcore:DesignSystem ;
    dcterms:identifier "frontiers-figures" ;
    rdfs:label "Frontiers Figures"@en ;
    ifcore:designSystemStatus ifcore:DraftDesignSystem ;
    dcterms:type ifcore:FigureDesignSystemKind , ifcore:ProcessDiagram , ifcore:ComparisonDiagram , ifcore:CycleDiagram , ifcore:LayerDiagram , ifcore:RelationshipDiagram , ifcore:DecisionFlowchart , ifcore:HierarchyDiagram , ifcore:BarChart , ifcore:LineChart , ifcore:Timeline ;
    rdfs:comment "At design-systems/frontiers-figures/; its house rules are design-systems/frontiers-figures/spec.md. How every figure is drawn, in print, on the web and on slides: semantic SVG whose colors are figure roles, themed by a brand, in default, on-dark, grayscale and compact variants (0014-design-systems FR-032, FR-048)."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:FrontiersWrittenVoice a ifcore:DesignSystem ;
    dcterms:identifier "frontiers-written-voice" ;
    rdfs:label "Frontiers Written Voice"@en ;
    ifcore:designSystemStatus ifcore:DraftDesignSystem ;
    dcterms:type ifcore:WrittenVoiceDesignSystemKind ;
    rdfs:comment "At design-systems/frontiers-written-voice/; its house rules are design-systems/frontiers-written-voice/spec.md. How the house writes: voice, usage, punctuation and presentation form, with the Chicago Manual of Style as its style authority, and the patterns its mechanical sweep looks for (0014-design-systems FR-033)."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:FrontiersSpokenVoice a ifcore:DesignSystem ;
    dcterms:identifier "frontiers-spoken-voice" ;
    rdfs:label "Frontiers Spoken Voice"@en ;
    ifcore:designSystemStatus ifcore:DraftDesignSystem ;
    dcterms:type ifcore:SpokenVoiceDesignSystemKind ;
    prov:wasDerivedFrom ifcore:FrontiersWrittenVoice ;
    rdfs:comment "At design-systems/frontiers-spoken-voice/; its house rules are design-systems/frontiers-spoken-voice/spec.md. How the house voice changes for the ear: scripts written to be heard once, with the written voice's patterns and its own announcement and story-label patterns (0014-design-systems FR-034)."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:FrontiersSlides a ifcore:DesignSystem ;
    dcterms:identifier "frontiers-slides" ;
    rdfs:label "Frontiers Slides"@en ;
    ifcore:designSystemStatus ifcore:DraftDesignSystem ;
    dcterms:type ifcore:SlidesDesignSystemKind , ifcore:TalkDeck , ifcore:LectureDeck , ifcore:WorkshopDeck , ifcore:BriefingDeck ;
    rdfs:comment "At design-systems/frontiers-slides/; its house rules are design-systems/frontiers-slides/spec.md. Slide decks on a 1920x1080 canvas, built from Markdown by deck.py, themed by a brand, with figures from frontiers-figures and text checked against the house voice (0014-design-systems FR-049)."@en ;
    ifcore:drawsFiguresWith ifcore:FrontiersFigures ;
    ifcore:hasAudience ifcore:Public .

ifcore:FrontiersMedia a ifcore:DesignSystem ;
    dcterms:identifier "frontiers-media" ;
    rdfs:label "Frontiers Media"@en ;
    ifcore:designSystemStatus ifcore:DraftDesignSystem ;
    dcterms:type ifcore:MediaDesignSystemKind , ifcore:PodcastCoverArt , ifcore:EpisodeArt , ifcore:VideoThumbnail , ifcore:TitleCard , ifcore:LowerThird , ifcore:SocialCard ;
    rdfs:comment "At design-systems/frontiers-media/; its house rules are design-systems/frontiers-media/spec.md. Podcast and episode art, video thumbnails, title cards, lower thirds and social cards, laid out and rendered from a short job by media.py, themed by a brand with its imagery pool and lockup (0014-design-systems FR-050)."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:FrontiersEmail a ifcore:DesignSystem ;
    dcterms:identifier "frontiers-email" ;
    rdfs:label "Frontiers Email"@en ;
    ifcore:designSystemStatus ifcore:DraftDesignSystem ;
    dcterms:type ifcore:EmailDesignSystemKind , ifcore:NewsletterEmail , ifcore:AnnouncementEmail , ifcore:InvitationEmail , ifcore:NotificationEmail ;
    rdfs:comment "At design-systems/frontiers-email/; its house rules are design-systems/frontiers-email/spec.md. Email built from Markdown by mail.py: 600px, table layout, styles inline, colors resolved from a brand's theme roles with a dark tone, and a plain-text alternative (0014-design-systems FR-051)."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:FrontiersCourse a ifcore:DesignSystem ;
    dcterms:identifier "frontiers-course" ;
    rdfs:label "Frontiers Course"@en ;
    ifcore:designSystemStatus ifcore:DraftDesignSystem ;
    dcterms:type ifcore:CourseDesignSystemKind , ifcore:SelfPacedCourse , ifcore:InstructorPacedCourse , ifcore:MultipleChoiceItem , ifcore:MultipleResponseItem , ifcore:NumericResponseItem , ifcore:TextMatchItem , ifcore:StaticWebEdition , ifcore:OpenEdxOlxExport , ifcore:Cmi5Package ;
    rdfs:comment "At design-systems/frontiers-course/; its house rules are design-systems/frontiers-course/spec.md. A course written as a directory of AsciiDoc, read by course.py into a model schema/course.schema.json describes, checked for outcome alignment, pacing, assessment and accessibility, and compiled by build.py to a static web edition, an Open edX OLX export and a cmi5 package, themed by a brand (0014-design-systems FR-052)."@en ;
    ifcore:drawsFiguresWith ifcore:FrontiersFigures ;
    ifcore:hasAudience ifcore:Public .

ifcore:FrontiersSignagePrint a ifcore:DesignSystem ;
    dcterms:identifier "frontiers-signage-print" ;
    rdfs:label "Frontiers Signage Print"@en ;
    ifcore:designSystemStatus ifcore:DraftDesignSystem ;
    dcterms:type ifcore:PrintDesignSystemKind , ifcore:Poster , ifcore:RollUpBanner , ifcore:EventBadge ;
    rdfs:comment "At design-systems/frontiers-signage-print/; its house rules are design-systems/frontiers-signage-print/spec.md. Posters, a roll-up banner and event badges as vector PDF at trim size plus bleed, laid out by signage.py from a short job and themed by a brand (0014-design-systems FR-031)."@en ;
    ifcore:drawsFiguresWith ifcore:FrontiersFigures ;
    ifcore:hasAudience ifcore:Public .

ifcore:FrontiersMerchandise a ifcore:DesignSystem ;
    dcterms:identifier "frontiers-merchandise" ;
    rdfs:label "Frontiers Merchandise"@en ;
    ifcore:designSystemStatus ifcore:DraftDesignSystem ;
    dcterms:type ifcore:MerchandiseDesignSystemKind , ifcore:ScreenPrinting , ifcore:Embroidery , ifcore:PadPrinting , ifcore:LaserEngraving , ifcore:DirectToGarmentPrinting , ifcore:Debossing , ifcore:Apparel , ifcore:Headwear , ifcore:Drinkware , ifcore:WritingInstruments , ifcore:Bags ;
    rdfs:comment "At design-systems/frontiers-merchandise/; its house rules are design-systems/frontiers-merchandise/spec.md. How the brand goes on apparel, headwear, drinkware, writing instruments and bags, themed by a brand's decoration kit (0014-design-systems FR-045, FR-047)."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:FrontiersNatureWeb a ifcore:DesignSystem ;
    dcterms:identifier "frontiers-nature-web" ;
    rdfs:label "Frontiers Nature Web"@en ;
    ifcore:designSystemStatus ifcore:ActiveDesignSystem ;
    dcterms:type ifcore:WebDesignSystemKind , ifcore:EditorialSite , ifcore:MarketingSite , ifcore:ExpressiveExpression , ifcore:DefaultDensity ;
    rdfs:comment "At design-systems/frontiers-nature-web/; its house rules are design-systems/frontiers-nature-web/spec.md. Intellectual Frontiers' public, editorial web presentation."@en ;
    ifcore:drawsFiguresWith ifcore:FrontiersFigures ;
    ifcore:hasAudience ifcore:Public .

ifcore:FrontiersConsoleWeb a ifcore:DesignSystem ;
    dcterms:identifier "frontiers-console-web" ;
    rdfs:label "Frontiers Console Web"@en ;
    ifcore:designSystemStatus ifcore:DraftDesignSystem ;
    dcterms:type ifcore:WebDesignSystemKind , ifcore:DocumentationSite , ifcore:BackOffice , ifcore:Dashboard , ifcore:ProductiveExpression , ifcore:DefaultDensity ;
    rdfs:comment "At design-systems/frontiers-console-web/; its house rules are design-systems/frontiers-console-web/spec.md. Operator (admin) and documentation web surfaces: a sidebar, navbar, page and table-of-contents shell in three selectable layouts, documentation and administration components."@en ;
    ifcore:drawsFiguresWith ifcore:FrontiersFigures ;
    ifcore:hasAudience ifcore:Public .

# ───────────────────────── Facts and audiences (FR-011 – FR-015) ─────────────────────────

ifcore:Fact a owl:Class ; rdfs:label "Fact"@en ;
    rdfs:comment "Anything asserted in the Eidolon that carries factual content. Every fact MUST declare its audience explicitly (FR-011); a class or property declaration is vocabulary, not a fact, and does not need one."@en .

ifcore:AccessAudience a owl:Class ; rdfs:label "Access audience"@en ;
    rdfs:comment "A named permission to see a fact: who may see it. Not the group a work is written for, which is schema:Audience (see ifcore:Readership)."@en .
ifcore:Public a ifcore:AccessAudience ; rdfs:label "Public"@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:CompanyAffiliated a ifcore:AccessAudience ; rdfs:label "Anyone affiliated with the company"@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:Agreement a owl:Class ; skos:closeMatch odrl:Agreement ; rdfs:subClassOf ifcore:AccessAudience ; rdfs:label "A specific named agreement"@en .
ifcore:RoleOrGroup a owl:Class ; rdfs:subClassOf ifcore:AccessAudience ; rdfs:label "A specific named role or group"@en .

ifcore:hasAudience a owl:ObjectProperty ; rdfs:domain ifcore:Fact ; rdfs:range ifcore:AccessAudience ;
    rdfs:comment "Disjunctive: a viewer satisfying any one listed audience may see the fact."@en .

# ───────────────────────── References (FR-015, FR-022 – FR-027) ─────────────────────────

ifcore:Reference a owl:Class ; rdfs:subClassOf ifcore:Fact ; rdfs:label "Reference"@en ;
    rdfs:comment "A fact that points at a value held elsewhere rather than storing it."@en .
ifcore:describes a owl:ObjectProperty ; rdfs:subPropertyOf schema:about ; rdfs:domain ifcore:Reference ;
    rdfs:comment "The fact or subject this reference is about."@en .

ifcore:ExternalRecordReference a owl:Class ; rdfs:subClassOf ifcore:Reference ;
    rdfs:label "External record reference"@en ;
    rdfs:comment "Points at a fact Intellectual Frontiers does not author or control."@en .
ifcore:primarySource a owl:DatatypeProperty ; rdfs:subPropertyOf prov:hadPrimarySource ; rdfs:domain ifcore:ExternalRecordReference ; rdfs:range xsd:anyURI .
ifcore:cachedValue a owl:DatatypeProperty ; rdfs:domain ifcore:ExternalRecordReference ;
    rdfs:comment "Optional. If present, resolvedAt MUST also be present."@en .
ifcore:resolvedAt a owl:DatatypeProperty ; rdfs:domain ifcore:ExternalRecordReference ; rdfs:range xsd:date ;
    rdfs:comment "Required for any static or non-live rendering of cachedValue."@en .
ifcore:verificationCadence a owl:DatatypeProperty ; rdfs:domain ifcore:ExternalRecordReference ; rdfs:range xsd:duration ;
    rdfs:comment "How often this reference's cached value must be re-verified."@en .
ifcore:verificationMethod a owl:DatatypeProperty ; rdfs:domain ifcore:ExternalRecordReference ; rdfs:range xsd:string ;
    rdfs:comment "\"automated\" or \"manual\"."@en .

ifcore:RestrictedDataReference a owl:Class ; rdfs:subClassOf ifcore:Reference ;
    rdfs:label "Restricted data reference"@en ;
    rdfs:comment "Points at a sensitive fact Intellectual Frontiers authors but excludes from every Eidolon repository. Deliberately carries no property capable of holding the fact's actual value."@en .
ifcore:heldIn a owl:DatatypeProperty ; rdfs:domain ifcore:RestrictedDataReference ; rdfs:range xsd:string ;
    rdfs:comment "The external system that holds the real data."@en .
ifcore:accessInstructions a owl:DatatypeProperty ; rdfs:domain ifcore:RestrictedDataReference ; rdfs:range xsd:string ;
    rdfs:comment "How a properly authorized person obtains access. MUST NOT be, or contain, a credential."@en .

# ───────────────────────── Governance (FR-028 – FR-033) ─────────────────────────

ifcore:DecisionOutcome a owl:Class ; rdfs:label "Decision outcome"@en ;
    rdfs:comment "One of the five decision-checkpoint outcomes."@en .
ifcore:Continue a ifcore:DecisionOutcome ; rdfs:label "Continue"@en ; ifcore:hasAudience ifcore:Public .
ifcore:Change a ifcore:DecisionOutcome ; rdfs:label "Change"@en ; ifcore:hasAudience ifcore:Public .
ifcore:BackSomeoneElse a ifcore:DecisionOutcome ; rdfs:label "Back someone else"@en ; ifcore:hasAudience ifcore:Public .
ifcore:BuildIt a ifcore:DecisionOutcome ; rdfs:label "Build it"@en ; ifcore:hasAudience ifcore:Public .
ifcore:Stop a ifcore:DecisionOutcome ; rdfs:label "Stop"@en ; ifcore:hasAudience ifcore:Public .

ifcore:Decision a owl:Class ; rdfs:subClassOf ifcore:Fact, prov:Entity ; rdfs:label "Decision"@en ;
    rdfs:comment "One coherent recorded choice (0008-decision-records FR-003). Routine operational activity is not a Decision. MUST carry its own ifcore:hasAudience when recorded — not necessarily Public — and MUST carry decidedBy (0008 FR-002)."@en .
ifcore:hasOutcome a owl:ObjectProperty ; rdfs:domain ifcore:Decision ; rdfs:range ifcore:DecisionOutcome ;
    rdfs:comment "Required only for a decision resolving a Native Alpha thesis question (0001 FR-031, 0008 FR-004). Not a measure of whether the record is still current — see dcterms:isReplacedBy."@en .
ifcore:decidedAt a owl:DatatypeProperty ; rdfs:subPropertyOf prov:generatedAtTime ; rdfs:domain ifcore:Decision ; rdfs:range xsd:date ;
    rdfs:comment "A decision is checked against the authority in effect on this date, not the date of later review."@en .
ifcore:decidedBy a owl:ObjectProperty ; rdfs:subPropertyOf prov:wasAttributedTo ; rdfs:domain ifcore:Decision ; rdfs:range ifcore:Person ;
    rdfs:comment "Required on every Decision (0008-decision-records FR-002)."@en .
ifcore:consideredEvidence a owl:ObjectProperty ; rdfs:domain ifcore:Decision ; rdfs:range ifcore:Fact ;
    rdfs:comment "A tracked fact that informed the decision (0008 FR-005). Not prov:used: PROV-O declares Entity and Activity disjoint, Decision is a prov:Entity, and used's domain is Activity — reusing it directly on a Decision would conflict. Where no tracked fact exists, use dcterms:description for a plain-text rationale instead."@en .

ifcore:Alternative a owl:Class ; rdfs:label "Alternative"@en ;
    rdfs:comment "An option considered and rejected when making a decision (0008-decision-records FR-006)."@en .
ifcore:consideredAlternative a owl:ObjectProperty ; rdfs:domain ifcore:Decision ; rdfs:range ifcore:Alternative .
ifcore:rejectionReason a owl:DatatypeProperty ; rdfs:domain ifcore:Alternative ; rdfs:range xsd:string .

# dcterms:isReplacedBy (reused, not redeclared) states whether a Decision is still
# current, independent of its hasOutcome (0008 FR-008). A Decision's own
# prov:wasGeneratedBy MAY point at the activity that produced it, when that
# activity is tracked; nothing it caused afterward needs restating here — that
# fact's own prov:wasGeneratedBy points back at this Decision instead (0008 FR-007).

ifcore:defaultDecisionAuthority a owl:ObjectProperty ; rdfs:domain ifcore:Company ; rdfs:range ifcore:Person ;
    rdfs:comment "The person holding authority over every domain not explicitly delegated elsewhere."@en .
ifcore:IntellectualFrontiersLLC ifcore:defaultDecisionAuthority ifcore:ShahidNehalShah .

# ───────────────────────── Units (0003-intellectual-frontiers FR-001) ─────────────────────────

ifcore:Unit a owl:Class ; rdfs:subClassOf org:OrganizationalUnit ; rdfs:label "Unit"@en ;
    rdfs:comment "A part of the company with exactly one job and one question — the W3C Organization Ontology's org:OrganizationalUnit, specialized to that one constraint (0019-controlled-vocabulary FR-002). A unit is known, but never the subject of a public presentation: it appears there only as provenance, such as a byline or imprint (0021-works-and-presentations FR-014, FR-016, FR-017)."@en .
ifcore:job a owl:DatatypeProperty ; rdfs:domain ifcore:Unit ; rdfs:range xsd:string ;
    rdfs:comment "The one job a unit exists to do."@en .
ifcore:question a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "The one question a unit, or a method stage, exists to answer."@en .

ifcore:hasUnit a owl:ObjectProperty ; rdfs:subPropertyOf org:hasUnit ; rdfs:domain ifcore:Company ; rdfs:range ifcore:Unit .
ifcore:unitOf a owl:ObjectProperty ; rdfs:subPropertyOf org:unitOf ; owl:inverseOf ifcore:hasUnit .

ifcore:ResearchAndIp a ifcore:Unit ;
    rdfs:label "Intellectual Frontiers Research & IP"@en ;
    ifcore:job "Run the research and protect and commercialize what it produces"@en ;
    ifcore:question "What do we know, own, control, or have rights to that may create unusual advantage?"@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:Press a ifcore:Unit ;
    rdfs:label "Intellectual Frontiers Press"@en ;
    skos:hiddenLabel "IF Press"@en ;
    rdfs:comment "The formal name is also the official public name, used on every public surface; the unit declares no public alternate name (0003-intellectual-frontiers FR-013; 0009-press FR-038). IF Press is the internal short name, for specs, records and conversation inside the firm, and never stands in for the official name in public."@en ;
    ifcore:job "Understand markets and explain the truth clearly"@en ;
    ifcore:question "What do we understand that is worth making clearer, more useful, and more durable?"@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:Capital a ifcore:Unit ;
    rdfs:label "Intellectual Frontiers Capital"@en ;
    ifcore:job "Put money behind evidence with discipline"@en ;
    ifcore:question "What advantage is strong enough that scarce capital should be placed behind it?"@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:operates a owl:ObjectProperty ; rdfs:domain ifcore:Unit ; rdfs:range ifcore:Fund .
ifcore:Studios a ifcore:Unit ;
    rdfs:label "Intellectual Frontiers Studios"@en ;
    ifcore:job "Build the companies that should exist"@en ;
    ifcore:question "What venture should we create to exploit this advantage, and what is the cheapest credible path to proving whether it deserves to exist?"@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:Network a ifcore:Unit ;
    rdfs:label "Intellectual Frontiers Network"@en ;
    ifcore:job "Find and prove the people who can carry the work"@en ;
    ifcore:question "Who has unusual knowledge, capabilities, relationships, reputation, experience, or access relevant to an opportunity, and how do we find them when needed?"@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:IntellectualFrontiersLLC ifcore:hasUnit
    ifcore:ResearchAndIp, ifcore:Press, ifcore:Capital, ifcore:Studios, ifcore:Network .

# ───────────────────────── Native Alpha (0003-intellectual-frontiers FR-005, FR-006, FR-014 – FR-018; 0007-work-and-assets FR-015) ─────────────────────────

ifcore:NativeAlpha a owl:Class ; rdfs:label "Native Alpha"@en ;
    skos:definition "An unusual and disproportionate advantage native to a particular person, team, company, product, operating model, dataset, market position, or set of relationships, carried by its accumulated knowledge, assets, experience, trust, or working methods, and strong enough to change a real decision."@en ;
    skos:scopeNote "Evident Native Alpha already produces a result beyond a credible benchmark. Latent Native Alpha is carried by what the subject already has, but realized only by reorganizing or recombining it (its units, companies, products, or services). A latent claim stays a provisional thesis until it changes a decision, and an advantage that needs a capability the subject must acquire or build from scratch is not Native Alpha (0003-intellectual-frontiers FR-014 – FR-016). A core competency stated in general terms is where a search starts, not what it finds (FR-017)."@en ;
    skos:scopeNote "Discovering Native Alpha and presenting it are different work (0003-intellectual-frontiers FR-018). Research & IP and Studios discover it (0006-research-and-ip FR-020, 0011-studios FR-027). Press documents and presents what they or others have discovered, and never originates a claim (0009-press FR-003, FR-029, FR-030)."@en ;
    rdfs:comment "Originates as Shahid Nehal Shah's own authored research and thesis, independent of Intellectual Frontiers LLC, with its own creative works and a filed (not yet granted) trademark application — see ifcore:NativeAlphaTrademark and the works that carry schema:about this concept. 0003-intellectual-frontiers FR-005 and FR-006 are the company's own application of it, not a separate thing; no second individual is minted for that application because it names no artifact distinct from the concept itself, unlike ifcore:Eidolon below."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:NativeAlphaTrademark a ifcore:Trademark ;
    rdfs:label "Native Alpha (trademark application)"@en ;
    schema:about ifcore:NativeAlpha ;
    dcterms:creator ifcore:ShahidNehalShah ;
    dcterms:rightsHolder ifcore:IntellectualFrontiersLLC ;
    rdfs:comment "Filing confirmed by the founder; serial number, filing date, and current status not independently verified via USPTO TSDR as of this writing. The registry record, once attached as an ExternalRecordReference, is the sole canonical source for its status (0007-work-and-assets FR-012) — this individual MUST NOT carry a literal status until then."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:ChasingNativeAlpha a schema:CreativeWork ;
    rdfs:label "Chasing Native Alpha"@en ;
    rdfs:comment "The work itself: the idea and method of finding and funding Native Alpha, independent of any form it is presented in (0021-works-and-presentations FR-001). Its stage is the idea's own (FR-022); the book that presents it is ifcore:ChasingNativeAlphaBook, and the skills that carry its method are presentations of it too. Copyright protects a presentation's text, not the idea, so it is asserted on the book."@en ;
    schema:about ifcore:NativeAlpha ;
    dcterms:creator ifcore:ShahidNehalShah ;
    dcterms:rightsHolder ifcore:IntellectualFrontiersLLC ;
    schema:workExample ifcore:ChasingNativeAlphaBook ;
    ifcore:hasAudience ifcore:Public .

ifcore:ChasingNativeAlphaBook a ifcore:Presentation, schema:Book, ifcore:Copyright ;
    rdfs:label "Chasing Native Alpha (book)"@en ;
    rdfs:comment "The book presenting ifcore:ChasingNativeAlpha (0021-works-and-presentations FR-004, FR-005). Its existence, title, and copyright are public; its production stage and decisions are held with its work package in the vault, whose record specializes this one (prov:specializationOf)."@en ;
    schema:exampleOfWork ifcore:ChasingNativeAlpha ;
    dcterms:format ifcore:BookEditionForm ;
    schema:author ifcore:ShahidNehalShah ;
    dcterms:creator ifcore:ShahidNehalShah ;
    dcterms:rightsHolder ifcore:IntellectualFrontiersLLC ;
    schema:publisher ifcore:Press ;
    ifcore:hasAudience ifcore:Public .

ifcore:NativeAlphaArticle a schema:Article ;
    rdfs:label "Native Alpha (shahidshah.com)"@en ;
    schema:about ifcore:NativeAlpha ;
    schema:url "https://www.shahidshah.com/writing/native-alpha"^^xsd:anyURI ;
    schema:author ifcore:ShahidNehalShah ;
    dcterms:creator ifcore:ShahidNehalShah ;
    ifcore:hasAudience ifcore:Public .

ifcore:IntellectualFrontiersLLC schema:isBasedOn ifcore:NativeAlpha .

# ───────────────────────── Eidolon, the concept (0007-work-and-assets FR-015) ─────────────────────────

ifcore:Eidolon a owl:Class ; rdfs:subClassOf ifcore:DigitalReflection ; owl:disjointWith ifcore:Ergon, ifcore:Noema ;
    rdfs:label "Eidolon"@en ;
    skos:definition "A digital reflection of what exists: a living, AI-readable record of a real-world entity that exists independently of its digital representation, such as a person, an organization, a company, an institution, a facility or an identifiable physical asset, capturing its identity, relationships, state, history and evolving context. Not a replica, but enough grounded evidence for an AI to reason about the real thing accurately and flexibly (0047-digital-reflections FR-006)."@en ;
    skos:scopeNote "Represented subject: an independently identifiable real-world entity. Not the record, a page or row that describes it, a claim made about it, or the idea of what an Eidolon is (0047-digital-reflections FR-037)."@en ;
    rdfs:comment "Shahid Nehal Shah's own authored research and thesis, independent of Intellectual Frontiers LLC. Not the same individual as the three-repository system this company operates — that system is a distinct, identifiable artifact based on this concept, related to it by schema:isBasedOn below, exactly the structure FR-015 requires rather than conflating a general concept with a specific application of it. What is deliberately created (a product, a service, a system, a workflow) is reflected by an ifcore:Ergon, and what is conceived (a concept, a hypothesis, a theory) by an ifcore:Noema, not by an Eidolon (0047-digital-reflections FR-007, FR-027). This IRI names both the kind of record and the founder's idea of it; the idea is a Noema subject (0047 OQ-6)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:IntellectualFrontiersLLC schema:isBasedOn ifcore:Eidolon .

# ───────────────────────── Digital reflections: Eidolons and Ergons (0047-digital-reflections) ─────────────────────────

ifcore:DigitalReflection a owl:Class ; rdfs:subClassOf ifcore:Fact, prov:Entity ; rdfs:label "Digital reflection"@en ;
    skos:definition "A maintained, AI-readable record of exactly one subject, with identity, context, relationships, evidence, provenance, history and lifecycle. Not necessarily a digital twin: no simulation, synchronization or completeness is required (0047-digital-reflections FR-001, FR-003)."@en ;
    rdfs:comment "The record, never the subject: the subject has its own identifier, named by ifcore:reflects, and its own types, which decide the record's kind through the ifcore:ClassificationRule individuals below. Its audience is the record's (ifcore:hasAudience); who stewards the record is ifcore:ownerRole, which says nothing of who owns the subject (FR-004)."@en .

ifcore:Ergon a owl:Class ; rdfs:subClassOf ifcore:DigitalReflection ; owl:disjointWith ifcore:Eidolon, ifcore:Noema ;
    rdfs:label "Ergon"@en ;
    skos:definition "A digital reflection of what is created: a living, AI-readable record of a deliberately built, designed or assembled product, service, system, workflow or solution, capturing its purpose, design, capabilities, dependencies, operational state, evolution and intended outcomes (0047-digital-reflections FR-007)."@en ;
    skos:scopeNote "Represented subject: a deliberately created operational solution. Not its instances or executions, the document that specifies it, or the idea it implements, which is a Noema (0047-digital-reflections FR-009, FR-037)."@en ;
    rdfs:comment "Greek ἔργον, a work, a thing made to do a job. The company's own concept, the counterpart of ifcore:Eidolon. An instance, deployment or execution of an Ergon is not itself an Ergon (FR-009)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:reflects a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain ifcore:DigitalReflection ;
    rdfs:comment "The one subject a reflection is a record of, by its stable identifier, never by name (0047-digital-reflections FR-002)."@en .
ifcore:purpose a owl:DatatypeProperty ; rdfs:domain ifcore:Ergon ; rdfs:range xsd:string ;
    rdfs:comment "What an Ergon was made to accomplish, stated by whoever is the authority on its design (0047-digital-reflections FR-008). Whom it is for is schema:audience; the outcome it promises is related by ifcore:Intends."@en .

# Classification: what a subject is, decided by its type, never by its record or its name (FR-010 – FR-013).

ifcore:ReflectionKindScheme a skos:ConceptScheme ; rdfs:label "Reflection kind"@en ;
    rdfs:comment "The kind a subject reflects as, resolved from its ifcore:ClassificationRule individuals (0047-digital-reflections FR-011, FR-012). Five, a closed set: the three kinds of reflection, a subject of none of them, and one no rule decides. An undetermined subject is never defaulted to a kind. A further kind of reflection is a new concept here, a new class under ifcore:DigitalReflection and its rules (0048-noemas FR-037)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:EidolonKind a skos:Concept ; skos:inScheme ifcore:ReflectionKindScheme ; skos:prefLabel "Eidolon"@en ; skos:notation "eidolon" ;
    skos:definition "The subject exists independently of its representation and is an individual in the world: a person, an organization, a place, an identifiable unit."@en ; ifcore:reflectionClass ifcore:Eidolon ; ifcore:hasAudience ifcore:Public .
ifcore:ErgonKind a skos:Concept ; skos:inScheme ifcore:ReflectionKindScheme ; skos:prefLabel "Ergon"@en ; skos:notation "ergon" ;
    skos:definition "The subject was deliberately built, designed or assembled to accomplish a purpose: a product model, a service, a system, a workflow, a solution."@en ; ifcore:reflectionClass ifcore:Ergon ; ifcore:hasAudience ifcore:Public .
ifcore:OtherKind a skos:Concept ; skos:inScheme ifcore:ReflectionKindScheme ; skos:prefLabel "Other"@en ; skos:notation "other" ;
    skos:definition "The subject is none of the three kinds of reflection: an event, a legal right or other instrument, a claim, a document, an outcome. It keeps the types the ontology gives it and no reflection is made of it (0047-digital-reflections FR-027)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:NoemaKind a skos:Concept ; skos:inScheme ifcore:ReflectionKindScheme ; skos:prefLabel "Noema"@en ; skos:notation "noema" ;
    skos:definition "The subject is an abstract intellectual construct, conceived or understood: a concept, a hypothesis, a theory, a principle, a framework, a methodology, a research question or finding or agenda (0048-noemas FR-001)."@en ; ifcore:reflectionClass ifcore:Noema ; ifcore:hasAudience ifcore:Public .
ifcore:UndeterminedKind a skos:Concept ; skos:inScheme ifcore:ReflectionKindScheme ; skos:prefLabel "Undetermined"@en ; skos:notation "undetermined" ;
    skos:definition "No rule decides the subject, or the rules for its types disagree. A person decides; no reflection is made until then (0047-digital-reflections FR-012)."@en ; ifcore:hasAudience ifcore:Public .

ifcore:reflectionClass a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain skos:Concept ; rdfs:range owl:Class ;
    rdfs:comment "The class of reflection records a kind of ifcore:ReflectionKindScheme names. A kind that is not a kind of reflection (other, undetermined) names none. A further kind of reflection is a subclass of ifcore:DigitalReflection, a concept here that names it, and its rules (0048-noemas FR-037)."@en .

ifcore:ClassificationRule a owl:Class ; rdfs:subClassOf ifcore:Fact ; rdfs:label "Classification rule"@en ;
    rdfs:comment "One subject class and the one kind it reflects as. At most one rule names a class (0047-digital-reflections FR-011). The criteria are identity, purpose, abstraction level and lifecycle, never whether a thing is physical, digital, human-made or natural (FR-010); its rdfs:comment states which criterion decides."@en .
ifcore:subjectClass a owl:ObjectProperty ; rdfs:domain ifcore:ClassificationRule ; rdfs:range rdfs:Class ;
    rdfs:comment "The class of subjects the rule classifies; a subclass is decided by the most specific rule that matches it (0047 FR-012)."@en .
ifcore:reflectedAs a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain ifcore:ClassificationRule ; rdfs:range skos:Concept ;
    rdfs:comment "The kind, a concept of ifcore:ReflectionKindScheme."@en .

# Subject classes the rules need and no established vocabulary names (each specializes an established class, per 0019 FR-002).
ifcore:Workflow a owl:Class ; rdfs:subClassOf prov:Plan ; rdfs:label "Workflow"@en ;
    rdfs:comment "A deliberately designed operating method. Each run of it is a prov:Activity related by ifcore:Executes, not another workflow (0047-digital-reflections FR-009)."@en .
ifcore:Outcome a owl:Class ; rdfs:subClassOf prov:Entity ; rdfs:label "Outcome"@en ;
    rdfs:comment "A result an Ergon intends or produces (0047-digital-reflections FR-008). Not an Ergon and not an Eidolon."@en .
ifcore:Capability a owl:Class ; rdfs:subClassOf skos:Concept ; rdfs:label "Capability"@en ;
    rdfs:comment "An abstract ability an Ergon implements. The ability is not the Ergon that has it (0047-digital-reflections FR-027)."@en .
ifcore:Invention a owl:Class ; rdfs:subClassOf skos:Concept ; rdfs:label "Invention"@en ;
    rdfs:comment "The idea a patent describes, a Noema. Distinct from the patent document and the right in it, which are of kind other, and from any product that practices it, which is an Ergon (0047-digital-reflections FR-028)."@en .

# The initial rules (FR-013). A class with no rule is undetermined; the ones marked so below are decided to be, with the reason.
ifcore:RulePerson a ifcore:ClassificationRule ; ifcore:subjectClass ifcore:Person ; ifcore:reflectedAs ifcore:EidolonKind ;
    rdfs:comment "Identity: an individual that exists apart from its record."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RuleSchemaPerson a ifcore:ClassificationRule ; ifcore:subjectClass schema:Person ; ifcore:reflectedAs ifcore:EidolonKind ;
    rdfs:comment "Identity: as ifcore:Person."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RuleOrganization a ifcore:ClassificationRule ; ifcore:subjectClass ifcore:Organization ; ifcore:reflectedAs ifcore:EidolonKind ;
    rdfs:comment "Identity: an organization has an identity in the world apart from its record."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RuleCompany a ifcore:ClassificationRule ; ifcore:subjectClass ifcore:Company ; ifcore:reflectedAs ifcore:EidolonKind ;
    rdfs:comment "Identity: a legal entity is an Eidolon although people formed it; formation does not make it an Ergon (0047 FR-014)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RuleSchemaOrganization a ifcore:ClassificationRule ; ifcore:subjectClass schema:Organization ; ifcore:reflectedAs ifcore:EidolonKind ;
    rdfs:comment "Identity: as ifcore:Organization."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RuleGovernmentOrganization a ifcore:ClassificationRule ; ifcore:subjectClass schema:GovernmentOrganization ; ifcore:reflectedAs ifcore:EidolonKind ;
    rdfs:comment "Identity: a government agency."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RuleMedicalOrganization a ifcore:ClassificationRule ; ifcore:subjectClass schema:MedicalOrganization ; ifcore:reflectedAs ifcore:EidolonKind ;
    rdfs:comment "Identity: a hospital organization or other care provider as an organization."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RuleHospital a ifcore:ClassificationRule ; ifcore:subjectClass schema:Hospital ; ifcore:reflectedAs ifcore:UndeterminedKind ;
    rdfs:comment "Abstraction: schema:Hospital is both an organization and a building. Both are Eidolons, but they are two subjects (0047 FR-015); a person types each, so the one type decides neither."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RulePlace a ifcore:ClassificationRule ; ifcore:subjectClass schema:Place ; ifcore:reflectedAs ifcore:EidolonKind ;
    rdfs:comment "Identity: a place or physical facility is an individual in the world."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RuleCivicStructure a ifcore:ClassificationRule ; ifcore:subjectClass schema:CivicStructure ; ifcore:reflectedAs ifcore:EidolonKind ;
    rdfs:comment "Identity: a physical building such as a hospital building."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RuleRealProperty a ifcore:ClassificationRule ; ifcore:subjectClass ifcore:RealProperty ; ifcore:reflectedAs ifcore:EidolonKind ;
    rdfs:comment "Identity: a particular parcel or building is an individual in the world."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RuleEquipment a ifcore:ClassificationRule ; ifcore:subjectClass ifcore:Equipment ; ifcore:reflectedAs ifcore:EidolonKind ;
    rdfs:comment "Abstraction: an item of equipment is an identifiable unit. The model it was made from is a separate Ergon (0047 FR-015)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RuleIndividualProduct a ifcore:ClassificationRule ; ifcore:subjectClass schema:IndividualProduct ; ifcore:reflectedAs ifcore:EidolonKind ;
    rdfs:comment "Abstraction: a single identifiable unit, such as a medical device with a serial number. Its model and software are Ergons (0047 FR-015)."@en ; ifcore:hasAudience ifcore:Public .

ifcore:RuleProductModel a ifcore:ClassificationRule ; ifcore:subjectClass schema:ProductModel ; ifcore:reflectedAs ifcore:ErgonKind ;
    rdfs:comment "Purpose and abstraction: a design of units, made to do a job; each unit is an Eidolon related by ifcore:Instantiates."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RuleSoftwareApplication a ifcore:ClassificationRule ; ifcore:subjectClass schema:SoftwareApplication ; ifcore:reflectedAs ifcore:ErgonKind ;
    rdfs:comment "Purpose: software built to accomplish a purpose."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RuleWebApplication a ifcore:ClassificationRule ; ifcore:subjectClass schema:WebApplication ; ifcore:reflectedAs ifcore:ErgonKind ;
    rdfs:comment "Purpose: a software-as-a-service product."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RuleMobileApplication a ifcore:ClassificationRule ; ifcore:subjectClass schema:MobileApplication ; ifcore:reflectedAs ifcore:ErgonKind ;
    rdfs:comment "Purpose: as schema:SoftwareApplication."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RuleService a ifcore:ClassificationRule ; ifcore:subjectClass schema:Service ; ifcore:reflectedAs ifcore:ErgonKind ;
    rdfs:comment "Purpose: a commercial service offering, or an engineered care delivery program, is deliberately designed to do a job. A vendor service (ifcore:VendorService) is the vendor's Ergon."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RuleWorkflow a ifcore:ClassificationRule ; ifcore:subjectClass ifcore:Workflow ; ifcore:reflectedAs ifcore:ErgonKind ;
    rdfs:comment "Purpose and abstraction: a designed operating method. Its executions are events (0047 FR-009)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RuleAIWorkforce a ifcore:ClassificationRule ; ifcore:subjectClass ifcore:AIWorkforce ; ifcore:reflectedAs ifcore:ErgonKind ;
    rdfs:comment "Purpose: an AI Workforce solution, or an AI agent designed for a business purpose, as a design and operating contract. Its runtime instances, identities and activity are separate subjects (0047 FR-015, OQ-2)."@en ; ifcore:hasAudience ifcore:Public .

ifcore:RuleRight a ifcore:ClassificationRule ; ifcore:subjectClass ifcore:Right ; ifcore:reflectedAs ifcore:OtherKind ;
    rdfs:comment "Abstraction: a legal right is neither a person, a thing made nor an idea; it is a claim recognized by law (0047 FR-027)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RuleIntellectualProperty a ifcore:ClassificationRule ; ifcore:subjectClass ifcore:IntellectualProperty ; ifcore:reflectedAs ifcore:OtherKind ;
    rdfs:comment "Abstraction: intellectual property as a right. A product that embodies it is a separate Ergon (0047 FR-028)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RuleNote a ifcore:ClassificationRule ; ifcore:subjectClass ifcore:Note ; ifcore:reflectedAs ifcore:NoemaKind ;
    rdfs:comment "Abstraction: a research note or paper sets out a finding, a design pattern or an operating theory, which is an idea, not an entity or a made thing. The note is its document; its record reflects the idea (0048-noemas FR-003)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RuleResearchPillar a ifcore:ClassificationRule ; ifcore:subjectClass ifcore:ResearchPillar ; ifcore:reflectedAs ifcore:NoemaKind ;
    rdfs:comment "Abstraction: a standing line of inquiry, a research agenda."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RuleClaim a ifcore:ClassificationRule ; ifcore:subjectClass schema:Claim ; ifcore:reflectedAs ifcore:OtherKind ;
    rdfs:comment "Abstraction: a claim is a statement that something is the case, such as a proposition a Noema states or a claim of a patent. It is not the idea that states it, and it has no reflection (0048-noemas FR-008)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RuleConcept a ifcore:ClassificationRule ; ifcore:subjectClass skos:Concept ; ifcore:reflectedAs ifcore:NoemaKind ;
    rdfs:comment "Abstraction: a defined idea, a named framework, a capability or an invention. A concept of a controlled vocabulary is a defined term and is reflected the same way if it is ever reflected."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RuleIntellectualConstruct a ifcore:ClassificationRule ; ifcore:subjectClass ifcore:IntellectualConstruct ; ifcore:reflectedAs ifcore:NoemaKind ;
    rdfs:comment "Abstraction: any abstract intellectual construct, by its subtype (dcterms:type of ifcore:NoemaTypeScheme)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RuleActivity a ifcore:ClassificationRule ; ifcore:subjectClass prov:Activity ; ifcore:reflectedAs ifcore:OtherKind ;
    rdfs:comment "Lifecycle: an event or an execution happens once and is over; it is not a thing that is maintained (0047 FR-009)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RuleOutcome a ifcore:ClassificationRule ; ifcore:subjectClass ifcore:Outcome ; ifcore:reflectedAs ifcore:OtherKind ;
    rdfs:comment "Abstraction: a result, intended or realized, is measured and not conceived (0047 OQ-4)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RuleDigitalAsset a ifcore:ClassificationRule ; ifcore:subjectClass ifcore:DigitalAsset ; ifcore:reflectedAs ifcore:UndeterminedKind ;
    rdfs:comment "Abstraction: an asset category that holds a software product (an Ergon), a web property, or a dataset. The category decides nothing; type the subject as what it is."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RuleUnit a ifcore:ClassificationRule ; ifcore:subjectClass ifcore:Unit ; ifcore:reflectedAs ifcore:UndeterminedKind ;
    rdfs:comment "Identity and purpose conflict: a unit is a part of an organization (an Eidolon), designed to have exactly one job (an Ergon). A person decides; see the register of open questions."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RuleInformationSystem a ifcore:ClassificationRule ; ifcore:subjectClass ifcore:InformationSystem ; ifcore:reflectedAs ifcore:UndeterminedKind ;
    rdfs:comment "Abstraction: an inventory entry may be a design (a product used) or a deployment (this installation). A person types each entry as what it is."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RuleSoftwareAgent a ifcore:ClassificationRule ; ifcore:subjectClass prov:SoftwareAgent ; ifcore:reflectedAs ifcore:UndeterminedKind ;
    rdfs:comment "Identity and lifecycle: a running instance of an AI agent (0047 OQ-2)."@en ; ifcore:hasAudience ifcore:Public .

# ───────────────────────── Platforms (0049-platforms) ─────────────────────────

ifcore:Platform a owl:Class ; rdfs:subClassOf schema:SoftwareApplication ; owl:disjointWith ifcore:Suite ; rdfs:label "Platform"@en ;
    skos:definition "A made system that provides the nine capabilities of the platform kernel, each realized by a named module, so that other parties can build and sell on it through published interfaces without reaching into it, and so that any module can be replaced by another that passes the same contract tests (0049-platforms FR-001 to FR-003)."@en ;
    skos:scopeNote "Represented subject: a platform as a built system. Not a product that lacks a capability of the kernel, a group of products sold together (a suite), a brand, or a deployment of it (0047-digital-reflections FR-009). The word is earned by the kernel, never claimed."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:Suite a owl:Class ; rdfs:subClassOf schema:SoftwareApplication ; owl:disjointWith ifcore:Platform ; rdfs:label "Suite"@en ;
    skos:definition "Two or more products offered together under one name, each usable on its own, that need not share a store, a ledger, a catalog or an extension contract. A suite shares at most a name, a purchase, a sign-in and agreed exchanges of data. It claims nothing about the platform kernel (0049-platforms FR-038)."@en ;
    skos:scopeNote "Represented subject: a group of products offered together. Not a platform, which has the whole kernel, and not a brand or a portfolio that names no offer. The word is used only for a subject typed ifcore:Suite (0049-platforms FR-040)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:RuleSuite a ifcore:ClassificationRule ; ifcore:subjectClass ifcore:Suite ; ifcore:reflectedAs ifcore:ErgonKind ;
    rdfs:comment "Purpose: a suite is a deliberately assembled offer of products."@en ; ifcore:hasAudience ifcore:Public .
ifcore:PlatformModule a owl:Class ; rdfs:subClassOf schema:SoftwareApplication ; rdfs:label "Platform module"@en ;
    skos:definition "A named, coded component of one platform that realizes one or more kernel capabilities or is a platform service, sits in exactly one layer or is orthogonal to the layers, and is reached only through its published interface (0049-platforms FR-007 to FR-013)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:RulePlatform a ifcore:ClassificationRule ; ifcore:subjectClass ifcore:Platform ; ifcore:reflectedAs ifcore:ErgonKind ;
    rdfs:comment "Purpose: a platform is a deliberately built system; it is never an Eidolon."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RulePlatformModule a ifcore:ClassificationRule ; ifcore:subjectClass ifcore:PlatformModule ; ifcore:reflectedAs ifcore:ErgonKind ;
    rdfs:comment "Purpose: a module is a deliberately built component of a platform."@en ; ifcore:hasAudience ifcore:Public .

ifcore:platformLayer a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain ifcore:PlatformModule ; rdfs:range skos:Concept ;
    rdfs:comment "The one concept of ifcore:PlatformLayerScheme a module sits in, or the orthogonal concept (0049-platforms FR-007)."@en .
ifcore:moduleCode a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain ifcore:PlatformModule ; rdfs:range xsd:string ;
    rdfs:comment "The three-letter code of a module: the first letter of the platform's name and the first letters of the two words that follow it in the module's name, in capitals. Unique within its platform. A short human name for conversation and tables, never part of an artifact name (0049-platforms FR-012, FR-013)."@en .
ifcore:artifactName a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain ifcore:PlatformModule ; rdfs:range xsd:string ;
    rdfs:comment "The name every artifact of a module carries: the platform's name and the module's full descriptive name in lowercase words joined by hyphens, never the code (0049-platforms FR-013)."@en .
ifcore:codeStatus a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain ifcore:PlatformModule ; rdfs:range xsd:string ;
    rdfs:comment "confirmed when a person has confirmed the module's code, proposed until then (0049-platforms FR-012)."@en .
ifcore:layerOrder a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain skos:Concept ; rdfs:range xsd:integer ;
    rdfs:comment "The position of a layer: 0 is the lowest. A module may depend only on its own layer or the one directly below (0049-platforms FR-008)."@en .

ifcore:PlatformCapabilityScheme a skos:ConceptScheme ; rdfs:label "Platform capability"@en ;
    rdfs:comment "The platform kernel: the nine capabilities every platform provides (0049-platforms FR-002). A closed set. A module states the capability it realizes by an implements relationship to one of these concepts. A ninth capability, or the removal of one, is an amendment to 0049-platforms and a change here, never a local choice."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:GovernedStoreCapability a skos:Concept ; skos:inScheme ifcore:PlatformCapabilityScheme ; skos:prefLabel "Governed store"@en ; skos:altLabel "Governed data store"@en ; skos:notation "governed-store" ;
    skos:definition "One store holds all the governed data the platform keeps, in three zones: what was received exactly as it arrived (append-only, with its source, time of arrival and content digest), what was modelled into the ontology (each datum linked to the received artifact it came from), and what was derived from both (always rebuildable, never the only place a fact lives). Every read and write goes through governed interfaces. No other module keeps a store of its own for that data; one that needs a derived store makes it a derived zone of this one. Because there is one store, consent or audience, audit, deletion and export are enforced once."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:OntologyModelCapability a skos:Concept ; skos:inScheme ifcore:PlatformCapabilityScheme ; skos:prefLabel "Ontology model"@en ; skos:altLabel "Semantic data model"@en ; skos:notation "ontology-model" ;
    skos:definition "The data model of the platform is its ontology, and the storage structures, validation rules and interfaces are generated from it. An extension, a domain package or a customer adds concepts, properties, value sets and constraints as an ontology package without changing the core. A change that alters the stored meaning of a concept creates a new version of the concept, and existing data stays readable under the version it was written under. Each concept declares its sensitivity class and its validation rules."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:IntegrationSeamCapability a skos:Concept ; skos:inScheme ifcore:PlatformCapabilityScheme ; skos:prefLabel "Integration seam"@en ; skos:altLabel "Integration layer"@en ; skos:notation "integration-seam" ;
    skos:definition "Every connection to a system outside the platform passes through one module of connectors. A connector extracts data and, where the source allows and the customer enables it, pushes approved data back. Everything extracted lands in the received zone of the governed store first and becomes modelled data only through a declared, reviewable mapping. The module records the authority for each extraction (an agreement, a person's written direction, or a contract), protects the source system from load, holds credentials least-privilege in the customer's secret store, reaches systems behind a firewall without opening inbound ports, keeps a delivery status and a visible failure queue, and has fixtures and a conformance suite for each connector in the assurance environment."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:ProgrammaticInterfaceCapability a skos:Concept ; skos:inScheme ifcore:PlatformCapabilityScheme ; skos:prefLabel "Programmatic interface"@en ; skos:altLabel "Application programming interface (API)"@en ; skos:notation "programmatic-interface" ;
    skos:definition "Every function of the platform is available through a published API, and the platform's own clients use the same one. The interface is one contract, made of the catalog of operations and the ontology, from which four flavors are generated and never hand-written: a resource API (REST, described by OpenAPI), a graph API (GraphQL, from the ontology), a virtual SQL layer (a read-only SQL schema, with a view for each concept and relationship, over the same operations or the governed store's read path), and a Model Context Protocol server (each operation a tool, each concept a resource, each workflow a prompt). All four apply the same access decisions, and a conformance suite proves that they return the same result and the same refusal. A domain standard (a data exchange, message or transaction standard) is an interface profile, one more flavor of the same contract, listed by the platform that needs it; the kernel requires none."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:AssuranceEnvironmentCapability a skos:Concept ; skos:inScheme ifcore:PlatformCapabilityScheme ; skos:prefLabel "Assurance environment"@en ; skos:altLabel "Automated test environment"@en ; skos:notation "assurance-environment" ;
    skos:definition "A sophisticated sandbox, separate from production in its accounts, keys, secrets and addresses, where the platform is tested, verified and shown to be fit. It holds only realistic synthetic data, generated and repeatable from a seed, or a customer's data that has been anonymized or de-identified under a recorded agreement, and it is technically unable to receive the regulated production data the platform declares. It provides sandbox tenants and service doubles for every external system, derives tests from the specs, the ontology and the scenario library, evaluates every AI function, lets external reviewers and a customer's users perform acceptance tests with invited, audited access, records sign-offs, can be deployed inside a customer's or partner's own environment, and issues the assurance report that must exist before a release. It is orthogonal to the layers: no module depends on it at runtime. Test management is a tool used inside it."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:CommitmentLedgerCapability a skos:Concept ; skos:inScheme ifcore:PlatformCapabilityScheme ; skos:prefLabel "Commitment ledger"@en ; skos:altLabel "Append-only ledger"@en ; skos:notation "commitment-ledger" ;
    skos:definition "Institutions keep the record of what they did. Nobody keeps the record of what was promised. The ledger keeps it. A commitment is a promise by a party (an organization, a person, a role, an agent) to another party, to do a thing by a time. A loop is a chain of commitments around one purpose that is not finished until it closes. Every open loop has one named owner at every moment, and ownership passes only by an explicit handoff. A loop closes only on evidence of the kind its loop type defines, never on an assertion. A party that does not use the platform is asked to close by the channels it already uses (a message, a form, a file), and the loop is closed by what comes back. A loop that has not moved for the time its type sets escalates, first to the owner, then to the person it serves, then to a named authority. The ledger also measures, for each party and loop type, loops opened, closed, failed and lapsed, and the time to close. A loop type is data (its parties, its evidence of closure, its stall times, its escalation and its measures), so a new type needs no software change. The ledger holds the promise and the evidence of its closure, not the content the evidence points to."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:AuthoritativeCatalogCapability a skos:Concept ; skos:inScheme ifcore:PlatformCapabilityScheme ; skos:prefLabel "Authoritative catalog"@en ; skos:altLabel "Data catalog; system of record"@en ; skos:notation "authoritative-catalog" ;
    skos:definition "A user of the platform never has to define a rule, a requirement or a measure that a public or standards body has already published. The catalog turns each published source into ontology records, each with its citation (source, section, version, date retrieved), its effective and end dates and its verification state (verified against the primary text, partly verified, not verified). A record that drives a decision, a payment or a finding is verified by two people. The catalog detects a change in a source and brings it in as a proposed new version, never as an edit. A thing is evaluated against the version in effect on its date. A user selects what applies to it, and the platform configures the work from the selection. Non-public content enters only as a package from its publisher through the extension contract."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:ExtensionContractCapability a skos:Concept ; skos:inScheme ifcore:PlatformCapabilityScheme ; skos:prefLabel "Extension contract"@en ; skos:altLabel "Plug-in interface"@en ; skos:notation "extension-contract" ;
    skos:definition "The platform is a small, complete core plus extensions that anyone may write, publish and install. The core holds only what every extension needs and cannot be safely provided by one. A fixed, versioned set of contribution points is the only way an extension adds to the platform. An extension carries a manifest (identity, publisher, version, interface versions, contribution points, permissions, data it reads and writes, services it calls, safety class). It runs in a sandbox with a credential scoped to it, receives only the permissions the manifest requests and the customer approves, and every read and write it makes is audited. First-party extensions use only the interfaces a third party can use. A registry keeps signed, immutable, versioned releases, and a solution is a manifest that bundles extensions, ontology packages, catalog content and configuration."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:GovernedAccessCapability a skos:Concept ; skos:inScheme ifcore:PlatformCapabilityScheme ; skos:prefLabel "Governed access"@en ; skos:altLabel "Access control"@en ; skos:notation "governed-access" ;
    skos:definition "Identity and tenancy, the audience or consent that decides who may see each fact, the audit of every access, and the rule that a person, an extension or an agent acts only within the intersection of its own permissions and the authority of the party it acts for. An agent never has more authority than the person it acts for, and every agent action is attributed to both. Customer data is separated between tenants, including from the operator's."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:InterfaceFlavorScheme a skos:ConceptScheme ; rdfs:label "Interface flavor"@en ;
    rdfs:comment "The four flavors of the platform's one interface contract (0049-platforms FR-044 to FR-050). A domain interface profile is another flavor of the same contract and is named by the platform that needs it (FR-051)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:ResourceApiFlavor a skos:Concept ; skos:inScheme ifcore:InterfaceFlavorScheme ; skos:prefLabel "Resource API"@en ; skos:notation "resource-api" ;
    skos:definition "An HTTP API in the style called REST, described by an OpenAPI document, with a resource for each concept and an endpoint for each operation."@en ; ifcore:hasAudience ifcore:Public .
ifcore:GraphApiFlavor a skos:Concept ; skos:inScheme ifcore:InterfaceFlavorScheme ; skos:prefLabel "Graph API"@en ; skos:notation "graph-api" ;
    skos:definition "A GraphQL schema generated from the ontology, in which a client names the concepts and relationships it wants and receives them in one request."@en ; ifcore:hasAudience ifcore:Public .
ifcore:VirtualSqlFlavor a skos:Concept ; skos:inScheme ifcore:InterfaceFlavorScheme ; skos:prefLabel "Virtual SQL layer"@en ; skos:notation "virtual-sql" ;
    skos:definition "A read-only SQL schema generated from the ontology, with a view for each concept and each relationship and the lineage columns of the governed store, served over a SQL connection. A change is never made by a SQL statement."@en ; ifcore:hasAudience ifcore:Public .
ifcore:McpServerFlavor a skos:Concept ; skos:inScheme ifcore:InterfaceFlavorScheme ; skos:prefLabel "Model Context Protocol server"@en ; skos:notation "mcp" ;
    skos:definition "A Model Context Protocol server generated from the contract: each operation a tool, each concept a resource, each workflow a prompt, usable over the network and on a local connection, acting for a person within that person's authority."@en ; ifcore:hasAudience ifcore:Public .
ifcore:offersInterface a owl:ObjectProperty ; rdfs:domain ifcore:PlatformModule ; rdfs:range skos:Concept ;
    rdfs:comment "A flavor of ifcore:InterfaceFlavorScheme that the module realizing the programmatic interface offers (0049-platforms FR-050)."@en .

# ───────────────────────── Participation (0050-participation) ─────────────────────────
# An invitation is a schema:InviteAction (the sender is its agent and the recipient its participant), so no class is declared for it.

ifcore:EntryDoorScheme a skos:ConceptScheme ; rdfs:label "Entry door"@en ;
    rdfs:comment "The places where a journey starts (0050-participation FR-004). A platform adds a concept for a door of its own."@en ; ifcore:hasAudience ifcore:Public .
ifcore:PublicPageDoor a skos:Concept ; skos:inScheme ifcore:EntryDoorScheme ; skos:prefLabel "Public page"@en ; skos:notation "public-page" ;
    skos:definition "A page generated from the platform's catalog that answers one question and ends in an action that starts a journey."@en ; ifcore:hasAudience ifcore:Public .
ifcore:AdvertisementDoor a skos:Concept ; skos:inScheme ifcore:EntryDoorScheme ; skos:prefLabel "Advertisement"@en ; skos:notation "advertisement" ;
    skos:definition "A paid message that promises one task and leads to a neutral page."@en ; ifcore:hasAudience ifcore:Public .
ifcore:ContentDoor a skos:Concept ; skos:inScheme ifcore:EntryDoorScheme ; skos:prefLabel "Content"@en ; skos:notation "content" ;
    skos:definition "A piece of content by a member of the field that links to a task a reader can finish."@en ; ifcore:hasAudience ifcore:Public .
ifcore:InvitationDoor a skos:Concept ; skos:inScheme ifcore:EntryDoorScheme ; skos:prefLabel "Invitation"@en ; skos:notation "invitation" ;
    skos:definition "A task that a known participant sends to a party, carrying a preview of the finished work."@en ; ifcore:hasAudience ifcore:Public .
ifcore:ListingDoor a skos:Concept ; skos:inScheme ifcore:EntryDoorScheme ; skos:prefLabel "Listing"@en ; skos:notation "listing" ;
    skos:definition "An entry in the platform's marketplace or directory that starts a journey."@en ; ifcore:hasAudience ifcore:Public .
ifcore:AgentMessageDoor a skos:Concept ; skos:inScheme ifcore:EntryDoorScheme ; skos:prefLabel "Agent message"@en ; skos:notation "agent-message" ;
    skos:definition "A message from a party's agent that starts or continues a journey for that party."@en ; ifcore:hasAudience ifcore:Public .

ifcore:VerificationLevelScheme a skos:ConceptScheme ; rdfs:label "Verification level"@en ;
    rdfs:comment "How far a party's standing has been checked (0050-participation FR-012). The sources of each level are the platform's own."@en ; ifcore:hasAudience ifcore:Public .
ifcore:UnverifiedLevel a skos:Concept ; skos:inScheme ifcore:VerificationLevelScheme ; skos:prefLabel "Unverified"@en ; skos:notation "unverified" ;
    skos:definition "Nothing about the party's standing has been checked. The party may finish a guest task and nothing more."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RegisteredLevel a skos:Concept ; skos:inScheme ifcore:VerificationLevelScheme ; skos:prefLabel "Registered"@en ; skos:notation "registered" ;
    skos:definition "The party matches an entry in a public register and controls the addresses it gave. This shows that it is registered, not that it is in good standing."@en ; ifcore:hasAudience ifcore:Public .
ifcore:VerifiedLevel a skos:Concept ; skos:inScheme ifcore:VerificationLevelScheme ; skos:prefLabel "Verified"@en ; skos:notation "verified" ;
    skos:definition "Registered, and confirmed by at least one more independent source that the platform names, with no match on a list of parties that are barred."@en ; ifcore:hasAudience ifcore:Public .

ifcore:offersDoor a owl:ObjectProperty ; rdfs:domain ifcore:PlatformModule ; rdfs:range skos:Concept ;
    rdfs:comment "A door of ifcore:EntryDoorScheme that the participation module of a platform offers (0050-participation FR-001)."@en .
ifcore:verifiesAgainst a owl:ObjectProperty ; rdfs:domain ifcore:PlatformModule ; rdfs:range ifcore:ExternalRecordReference ;
    rdfs:comment "A source that the participation module of a platform checks a party against, held as an external record reference (0050-participation FR-001, FR-013, FR-014)."@en .

ifcore:PlatformLayerScheme a skos:ConceptScheme ; rdfs:label "Platform layer"@en ;
    rdfs:comment "The five layers of a platform and the orthogonal position (0049-platforms FR-007). A module sits in exactly one."@en ; ifcore:hasAudience ifcore:Public .
ifcore:FoundationLayer a skos:Concept ; skos:inScheme ifcore:PlatformLayerScheme ; skos:prefLabel "Foundation"@en ; skos:notation "foundation" ; ifcore:layerOrder 0 ;
    skos:definition "The hosts, runtimes and channels the platform runs on, reached through adapters, so that no other layer names one."@en ; ifcore:hasAudience ifcore:Public .
ifcore:DataLayer a skos:Concept ; skos:inScheme ifcore:PlatformLayerScheme ; skos:prefLabel "Data"@en ; skos:notation "data" ; ifcore:layerOrder 1 ;
    skos:definition "The governed store, the only place the platform's governed data lives."@en ; ifcore:hasAudience ifcore:Public .
ifcore:PlatformServicesLayer a skos:Concept ; skos:inScheme ifcore:PlatformLayerScheme ; skos:prefLabel "Platform services"@en ; skos:notation "platform-services" ; ifcore:layerOrder 2 ;
    skos:definition "The capabilities every solution can call on the same terms: the commitment ledger, the catalog, governed access, the extension runtime and registry."@en ; ifcore:hasAudience ifcore:Public .
ifcore:ExtensionsLayer a skos:Concept ; skos:inScheme ifcore:PlatformLayerScheme ; skos:prefLabel "Extensions and products"@en ; skos:notation "extensions-and-products" ; ifcore:layerOrder 3 ;
    skos:definition "The units that others install and sell, built on the platform services."@en ; ifcore:hasAudience ifcore:Public .
ifcore:SolutionsLayer a skos:Concept ; skos:inScheme ifcore:PlatformLayerScheme ; skos:prefLabel "Solutions and services"@en ; skos:notation "solutions-and-services" ; ifcore:layerOrder 4 ;
    skos:definition "The named offers built from extensions, ontology packages, catalog content and configuration."@en ; ifcore:hasAudience ifcore:Public .
ifcore:OrthogonalLayer a skos:Concept ; skos:inScheme ifcore:PlatformLayerScheme ; skos:prefLabel "Orthogonal"@en ; skos:notation "orthogonal" ;
    skos:definition "A module that cuts across the layers through their published interfaces only: the integration seam and the assurance environment. It has no layer order."@en ; ifcore:hasAudience ifcore:Public .

ifcore:OfferKindScheme a skos:ConceptScheme ; rdfs:label "Offer kind"@en ;
    rdfs:comment "What can be built on or offered through a platform (0049-platforms FR-004). Exactly one applies to each offer."@en ; ifcore:hasAudience ifcore:Public .
ifcore:PlatformServiceOffer a skos:Concept ; skos:inScheme ifcore:OfferKindScheme ; skos:prefLabel "Platform service"@en ; skos:notation "platform-service" ;
    skos:definition "A capability that two or more solutions need, offered to all of them on the same terms through interfaces a third party can also use."@en ; ifcore:hasAudience ifcore:Public .
ifcore:SolutionOffer a skos:Concept ; skos:inScheme ifcore:OfferKindScheme ; skos:prefLabel "Solution"@en ; skos:notation "solution" ;
    skos:definition "A complete offer for one kind of user, made of a manifest that bundles extensions, ontology packages, catalog content, configuration and branding."@en ; ifcore:hasAudience ifcore:Public .
ifcore:ProductOffer a skos:Concept ; skos:inScheme ifcore:OfferKindScheme ; skos:prefLabel "Product"@en ; skos:notation "product" ;
    skos:definition "A unit that a party installs, licenses or buys, built on the platform, such as an extension or a connector."@en ; ifcore:hasAudience ifcore:Public .
ifcore:ServiceOffer a skos:Concept ; skos:inScheme ifcore:OfferKindScheme ; skos:prefLabel "Service"@en ; skos:notation "service" ;
    skos:definition "Work done by people or agents with the platform for a customer, such as implementation, review or managed operation."@en ; ifcore:hasAudience ifcore:Public .

# Relationships (FR-016 – FR-021).

ifcore:ReflectionRelationship a owl:Class ; rdfs:subClassOf ifcore:Assertion ; rdfs:label "Reflection relationship"@en ;
    rdfs:comment "A typed, directional statement between two subjects, by identifier, with its source, its validity in time and how settled it is (0047-digital-reflections FR-016, FR-019). Stated between subjects, not between records, so that a record's change of kind leaves it untouched (FR-021)."@en .
ifcore:relationType a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain ifcore:ReflectionRelationship ; rdfs:range skos:Concept ;
    rdfs:comment "One concept of ifcore:ReflectionRelationScheme."@en .
ifcore:relationFrom a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:subPropertyOf rdf:subject ; rdfs:domain ifcore:ReflectionRelationship ;
    rdfs:comment "The subject the relationship starts from."@en .
ifcore:relationTo a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:subPropertyOf rdf:object ; rdfs:domain ifcore:ReflectionRelationship ;
    rdfs:comment "The subject the relationship points to."@en .
ifcore:concerning a owl:ObjectProperty ; rdfs:domain ifcore:ReflectionRelationship ;
    rdfs:comment "What an assignment or a license is of, when the relationship is between two parties about a third thing."@en .

ifcore:RelationFamilyScheme a skos:ConceptScheme ; rdfs:label "Relationship family"@en ;
    rdfs:comment "The ten kinds of connection a reflection relationship can be. A relationship of one family is never inferred from another's (0047-digital-reflections FR-018)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:OrganizationalFamily a skos:Concept ; skos:inScheme ifcore:RelationFamilyScheme ; skos:prefLabel "Organizational"@en ; skos:notation "organizational" ;
    skos:definition "Who is part of, or works for, an organization."@en ; ifcore:hasAudience ifcore:Public .
ifcore:LegalRightFamily a skos:Concept ; skos:inScheme ifcore:RelationFamilyScheme ; skos:prefLabel "Legal right"@en ; skos:notation "legal-right" ;
    skos:definition "Ownership, inventorship, assignment and licensing: what the law recognizes, each separately."@en ; ifcore:hasAudience ifcore:Public .
ifcore:OperationalFamily a skos:Concept ; skos:inScheme ifcore:RelationFamilyScheme ; skos:prefLabel "Operational"@en ; skos:notation "operational" ;
    skos:definition "Who builds, runs, deploys and uses something, and what an execution ran."@en ; ifcore:hasAudience ifcore:Public .
ifcore:CommercialFamily a skos:Concept ; skos:inScheme ifcore:RelationFamilyScheme ; skos:prefLabel "Commercial"@en ; skos:notation "commercial" ;
    skos:definition "What is offered, bought and served."@en ; ifcore:hasAudience ifcore:Public .
ifcore:TechnicalFamily a skos:Concept ; skos:inScheme ifcore:RelationFamilyScheme ; skos:prefLabel "Technical"@en ; skos:notation "technical" ;
    skos:definition "What one made thing depends on, integrates with and implements."@en ; ifcore:hasAudience ifcore:Public .
ifcore:OutcomeFamily a skos:Concept ; skos:inScheme ifcore:RelationFamilyScheme ; skos:prefLabel "Outcome"@en ; skos:notation "outcome" ;
    skos:definition "What a made thing promises and what it has produced."@en ; ifcore:hasAudience ifcore:Public .
ifcore:LineageFamily a skos:Concept ; skos:inScheme ifcore:RelationFamilyScheme ; skos:prefLabel "Lineage"@en ; skos:notation "lineage" ;
    skos:definition "What a thing was made from or is an instance of."@en ; ifcore:hasAudience ifcore:Public .

ifcore:relationFamily a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain skos:Concept ; rdfs:range skos:Concept ;
    rdfs:comment "The one family of ifcore:RelationFamilyScheme a relationship type belongs to."@en .
ifcore:fromKind a owl:ObjectProperty ; rdfs:domain skos:Concept ; rdfs:range skos:Concept ;
    rdfs:comment "A kind of ifcore:ReflectionKindScheme the relationship type's starting subject may have; any one listed is allowed."@en .
ifcore:toKind a owl:ObjectProperty ; rdfs:domain skos:Concept ; rdfs:range skos:Concept ;
    rdfs:comment "A kind the relationship type's target subject may have; any one listed is allowed."@en .

ifcore:ReflectionRelationScheme a skos:ConceptScheme ; rdfs:label "Reflection relationship type"@en ;
    rdfs:comment "The types a ReflectionRelationship takes (0047-digital-reflections FR-017). Flat: no type is narrower than another, and legal ownership, inventorship, assignment, licensing, operation, development and use are never inferred from each other (FR-018). Concepts, so a new type is added without a new property."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:WorksFor a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "worksFor"@en ; skos:notation "worksFor" ;
    skos:definition "A person is employed by, or works for, an organization."@en ; skos:closeMatch schema:worksFor ;
    ifcore:relationFamily ifcore:OrganizationalFamily ; ifcore:fromKind ifcore:EidolonKind ; ifcore:toKind ifcore:EidolonKind ; ifcore:hasAudience ifcore:Public .
ifcore:Owns a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "owns"@en ; skos:notation "owns" ;
    skos:definition "Legal ownership of a thing or a right. It says nothing of who invented, built, runs or uses it."@en ; skos:closeMatch schema:owns ;
    ifcore:relationFamily ifcore:LegalRightFamily ; ifcore:fromKind ifcore:EidolonKind ; ifcore:toKind ifcore:EidolonKind, ifcore:ErgonKind, ifcore:OtherKind ; ifcore:hasAudience ifcore:Public .
ifcore:InventorOf a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "inventorOf"@en ; skos:notation "inventorOf" ;
    skos:definition "A person conceived an invention. It says nothing of who owns it, to whom it was assigned, or who may license it."@en ;
    ifcore:relationFamily ifcore:LegalRightFamily ; ifcore:fromKind ifcore:EidolonKind ; ifcore:toKind ifcore:NoemaKind, ifcore:OtherKind ; ifcore:hasAudience ifcore:Public .
ifcore:AssignsTo a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "assignsTo"@en ; skos:notation "assignsTo" ;
    skos:definition "A party transferred a right (named by ifcore:concerning) to another. A transfer, not an invention and not a license."@en ;
    ifcore:relationFamily ifcore:LegalRightFamily ; ifcore:fromKind ifcore:EidolonKind ; ifcore:toKind ifcore:EidolonKind ; ifcore:hasAudience ifcore:Public .
ifcore:LicensesTo a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "licensesTo"@en ; skos:notation "licensesTo" ;
    skos:definition "A party permits another to use a right (named by ifcore:concerning) without transferring it."@en ;
    ifcore:relationFamily ifcore:LegalRightFamily ; ifcore:fromKind ifcore:EidolonKind ; ifcore:toKind ifcore:EidolonKind ; ifcore:hasAudience ifcore:Public .
ifcore:Develops a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "develops"@en ; skos:notation "develops" ;
    skos:definition "An organization or a person builds and changes a made thing. It does not imply that they own, operate or sell it."@en ;
    ifcore:relationFamily ifcore:OperationalFamily ; ifcore:fromKind ifcore:EidolonKind ; ifcore:toKind ifcore:ErgonKind ; ifcore:hasAudience ifcore:Public .
ifcore:Operates a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "operates"@en ; skos:notation "operates" ;
    skos:definition "An organization or a person runs a made thing, or an identifiable unit of one, and is responsible for it running. It does not imply ownership or development."@en ;
    ifcore:relationFamily ifcore:OperationalFamily ; ifcore:fromKind ifcore:EidolonKind ; ifcore:toKind ifcore:EidolonKind, ifcore:ErgonKind ; ifcore:hasAudience ifcore:Public .
ifcore:Deploys a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "deploys"@en ; skos:notation "deploys" ;
    skos:definition "An organization put a made thing into service in its own setting. Distinct from buying it and from using it."@en ;
    ifcore:relationFamily ifcore:OperationalFamily ; ifcore:fromKind ifcore:EidolonKind ; ifcore:toKind ifcore:ErgonKind ; ifcore:hasAudience ifcore:Public .
ifcore:Uses a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "uses"@en ; skos:notation "uses" ;
    skos:definition "A person, an organization or a made thing (a workflow) makes use of a made thing or of an identifiable unit. It does not imply ownership, a purchase or a license."@en ;
    ifcore:relationFamily ifcore:OperationalFamily ; ifcore:fromKind ifcore:EidolonKind, ifcore:ErgonKind ; ifcore:toKind ifcore:EidolonKind, ifcore:ErgonKind ; ifcore:hasAudience ifcore:Public .
ifcore:Executes a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "executes"@en ; skos:notation "executes" ;
    skos:definition "An event is one run of a designed method. The run is an event, not an Ergon."@en ;
    ifcore:relationFamily ifcore:OperationalFamily ; ifcore:fromKind ifcore:OtherKind ; ifcore:toKind ifcore:ErgonKind ; ifcore:hasAudience ifcore:Public .
ifcore:Offers a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "offers"@en ; skos:notation "offers" ;
    skos:definition "An organization makes a product or a service available to others. It does not imply ownership or development."@en ; skos:relatedMatch schema:makesOffer ;
    ifcore:relationFamily ifcore:CommercialFamily ; ifcore:fromKind ifcore:EidolonKind ; ifcore:toKind ifcore:ErgonKind ; ifcore:hasAudience ifcore:Public .
ifcore:Purchases a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "purchases"@en ; skos:notation "purchases" ;
    skos:definition "A customer bought a product or a service. It does not imply the customer deployed or uses it."@en ;
    ifcore:relationFamily ifcore:CommercialFamily ; ifcore:fromKind ifcore:EidolonKind ; ifcore:toKind ifcore:ErgonKind ; ifcore:hasAudience ifcore:Public .
ifcore:Serves a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "serves"@en ; skos:notation "serves" ;
    skos:definition "A made thing is meant to benefit, or delivers to, a party."@en ;
    ifcore:relationFamily ifcore:CommercialFamily ; ifcore:fromKind ifcore:ErgonKind ; ifcore:toKind ifcore:EidolonKind ; ifcore:hasAudience ifcore:Public .
ifcore:DependsOn a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "dependsOn"@en ; skos:notation "dependsOn" ;
    skos:definition "A made thing cannot work, or an idea cannot hold, without another."@en ; skos:closeMatch dcterms:requires ;
    ifcore:relationFamily ifcore:TechnicalFamily ; ifcore:fromKind ifcore:ErgonKind, ifcore:NoemaKind ; ifcore:toKind ifcore:ErgonKind, ifcore:NoemaKind ; ifcore:hasAudience ifcore:Public .
ifcore:IntegratesWith a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "integratesWith"@en ; skos:notation "integratesWith" ;
    skos:definition "Two made things exchange data or calls. Neither need depend on the other."@en ;
    ifcore:relationFamily ifcore:TechnicalFamily ; ifcore:fromKind ifcore:ErgonKind ; ifcore:toKind ifcore:ErgonKind ; ifcore:hasAudience ifcore:Public .
ifcore:Implements a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "implements"@en ; skos:notation "implements" ;
    skos:definition "A made thing realizes an idea or an abstract capability in its design."@en ;
    ifcore:relationFamily ifcore:TechnicalFamily ; ifcore:fromKind ifcore:ErgonKind ; ifcore:toKind ifcore:NoemaKind, ifcore:OtherKind ; ifcore:hasAudience ifcore:Public .
ifcore:PartOf a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "partOf"@en ; skos:notation "partOf" ;
    skos:definition "A made thing is a component of a larger made thing and has no existence as a unit of its own outside it: a module of a platform. The whole is named by the relationship's target. Distinct from dependsOn: a part may depend on nothing else, and a dependency is not a part (0049-platforms FR-007)."@en ;
    ifcore:relationFamily ifcore:TechnicalFamily ; ifcore:fromKind ifcore:ErgonKind ; ifcore:toKind ifcore:ErgonKind ; ifcore:hasAudience ifcore:Public .
ifcore:BuiltOn a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "builtOn"@en ; skos:notation "builtOn" ;
    skos:definition "A solution, product, service, extension or platform service is made on a platform and reaches it only through the platform's published interfaces. A made thing that merely calls another one's interface without being offered through it is integratesWith, not builtOn (0049-platforms FR-006)."@en ;
    ifcore:relationFamily ifcore:TechnicalFamily ; ifcore:fromKind ifcore:ErgonKind ; ifcore:toKind ifcore:ErgonKind ; ifcore:hasAudience ifcore:Public .
ifcore:CarriesOut a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "carriesOut"@en ; skos:notation "carriesOut" ;
    skos:definition "A product is the working implementation of the design of a platform module: the module states what is needed and keeps its plain name, and the product is what exists and keeps its brand (0049-platforms FR-014). Distinct from implements, which joins a made thing to an idea or a capability."@en ;
    ifcore:relationFamily ifcore:TechnicalFamily ; ifcore:fromKind ifcore:ErgonKind ; ifcore:toKind ifcore:ErgonKind ; ifcore:hasAudience ifcore:Public .
ifcore:Intends a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "intends"@en ; skos:notation "intends" ;
    skos:definition "A made thing is meant to produce an outcome. A promise, not a result."@en ;
    ifcore:relationFamily ifcore:OutcomeFamily ; ifcore:fromKind ifcore:ErgonKind ; ifcore:toKind ifcore:OtherKind ; ifcore:hasAudience ifcore:Public .
ifcore:Produces a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "produces"@en ; skos:notation "produces" ;
    skos:definition "A made thing has produced an outcome. A result, supported by an assertion labelled evidence (0047 FR-008)."@en ;
    ifcore:relationFamily ifcore:OutcomeFamily ; ifcore:fromKind ifcore:ErgonKind ; ifcore:toKind ifcore:OtherKind ; ifcore:hasAudience ifcore:Public .
ifcore:Instantiates a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "instantiates"@en ; skos:notation "instantiates" ;
    skos:definition "An identifiable unit is made to a model, design or contract."@en ;
    ifcore:relationFamily ifcore:LineageFamily ; ifcore:fromKind ifcore:EidolonKind ; ifcore:toKind ifcore:ErgonKind ; ifcore:hasAudience ifcore:Public .
ifcore:EvolvesFrom a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "evolvesFrom"@en ; skos:notation "evolvesFrom" ;
    skos:definition "A made thing, or an idea, is a later version of, or was derived from, another."@en ; skos:closeMatch prov:wasDerivedFrom ;
    ifcore:relationFamily ifcore:LineageFamily ; ifcore:fromKind ifcore:ErgonKind, ifcore:NoemaKind ; ifcore:toKind ifcore:ErgonKind, ifcore:NoemaKind ; ifcore:hasAudience ifcore:Public .

# Assertions (FR-022 – FR-026): the label, source and verification of what a reflection holds about its subject.

ifcore:Assertion a owl:Class ; rdfs:subClassOf ifcore:Fact, prov:Entity ; rdfs:label "Assertion"@en ;
    rdfs:comment "One statement about a subject (schema:about), labelled by ifcore:claimLabel, sourced by dcterms:source, attributed by prov:wasAttributedTo, held with ifcore:confidenceLevel where it is not certain. Verified only when ifcore:verifiedBy names a person (0047-digital-reflections FR-022 to FR-025)."@en .
ifcore:verifiedBy a owl:ObjectProperty ; rdfs:domain ifcore:Assertion ; rdfs:range ifcore:Person ;
    rdfs:comment "The person who checked the assertion against its source. Never an AI agent (0047 FR-024)."@en .
ifcore:verifiedOn a owl:DatatypeProperty ; rdfs:domain ifcore:Assertion ; rdfs:range xsd:date ;
    rdfs:comment "When the person checked it. Required with ifcore:verifiedBy."@en .

# ───────────────────────── Noemas: reflections of what is conceived (0048-noemas) ─────────────────────────

ifcore:Noema a owl:Class ; rdfs:subClassOf ifcore:DigitalReflection ; owl:disjointWith ifcore:Eidolon, ifcore:Ergon ;
    rdfs:label "Noema"@en ;
    skos:definition "A digital reflection of what is conceived: a living, AI-readable representation of an abstract concept, hypothesis, theory, research question, methodology, principle or other intellectual construct, capturing its meaning, assumptions, evidence, relationships, evolution and practical implications (0048-noemas FR-001)."@en ;
    skos:scopeNote "Represented subject: an abstract intellectual construct. Not an independently existing entity, not a deliberately built operational solution, not the document or database row that holds the record, and not a claim, which a Noema states (0047-digital-reflections FR-037; 0048-noemas FR-003, FR-008)."@en ;
    rdfs:comment "Greek νόημα, what is thought, a conception. The company's own concept, the third counterpart of ifcore:Eidolon and ifcore:Ergon. It shares every mechanism of ifcore:DigitalReflection (identity, assertions, relationships, review, audience) and adds only what an idea needs: a subtype, an epistemic state assessed over time, and evidence for and against it (0048-noemas FR-002)."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:IntellectualConstruct a owl:Class ; rdfs:label "Intellectual construct"@en ;
    skos:definition "An abstract idea that is conceived or understood rather than found in the world or built: the class of subjects a Noema reflects when no more specific class names them (0048-noemas FR-005)."@en ;
    rdfs:comment "Its kind is the subtype carried by dcterms:type, a concept of ifcore:NoemaTypeScheme, so a new subtype is a new concept and not a new class. Several subtypes may apply at once."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:NoemaTypeScheme a skos:ConceptScheme ; rdfs:label "Noema subtype"@en ;
    rdfs:comment "What sort of idea a Noema's subject is (0048-noemas FR-005). Open: a subtype is added as a concept, and a subject may carry several (a framework that contains hypotheses and a methodology). The subject carries it as dcterms:type."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:ConceptType a skos:Concept ; skos:inScheme ifcore:NoemaTypeScheme ; skos:prefLabel "Concept"@en ; skos:notation "concept" ;
    skos:definition "A defined idea or abstraction."@en ; ifcore:hasAudience ifcore:Public .
ifcore:HypothesisType a skos:Concept ; skos:inScheme ifcore:NoemaTypeScheme ; skos:prefLabel "Hypothesis"@en ; skos:notation "hypothesis" ;
    skos:definition "A proposition that can be evaluated or tested."@en ; ifcore:hasAudience ifcore:Public .
ifcore:TheoryType a skos:Concept ; skos:inScheme ifcore:NoemaTypeScheme ; skos:prefLabel "Theory"@en ; skos:notation "theory" ;
    skos:definition "An explanatory structure connecting propositions."@en ; skos:relatedMatch ifcore:OperatingTheory ; ifcore:hasAudience ifcore:Public .
ifcore:PrincipleType a skos:Concept ; skos:inScheme ifcore:NoemaTypeScheme ; skos:prefLabel "Principle"@en ; skos:notation "principle" ;
    skos:definition "A general rule or guiding assertion."@en ; ifcore:hasAudience ifcore:Public .
ifcore:FrameworkType a skos:Concept ; skos:inScheme ifcore:NoemaTypeScheme ; skos:prefLabel "Framework"@en ; skos:notation "framework" ;
    skos:definition "An organized conceptual model. It may contain hypotheses, principles and methodologies, each its own Noema, related by dcterms:hasPart."@en ; ifcore:hasAudience ifcore:Public .
ifcore:MethodologyType a skos:Concept ; skos:inScheme ifcore:NoemaTypeScheme ; skos:prefLabel "Methodology"@en ; skos:notation "methodology" ;
    skos:definition "A systematic approach to inquiry or work. The abstract approach is the Noema; a deployed workflow that carries it out is an Ergon, related by operationalizes (0048-noemas FR-007)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:ResearchQuestionType a skos:Concept ; skos:inScheme ifcore:NoemaTypeScheme ; skos:prefLabel "Research question"@en ; skos:notation "research-question" ;
    skos:definition "A question requiring investigation."@en ; ifcore:hasAudience ifcore:Public .
ifcore:ResearchFindingType a skos:Concept ; skos:inScheme ifcore:NoemaTypeScheme ; skos:prefLabel "Research finding"@en ; skos:notation "research-finding" ;
    skos:definition "A conclusion supported by identifiable evidence."@en ; ifcore:hasAudience ifcore:Public .
ifcore:ResearchAgendaType a skos:Concept ; skos:inScheme ifcore:NoemaTypeScheme ; skos:prefLabel "Research agenda"@en ; skos:notation "research-agenda" ;
    skos:definition "An organized program of investigation."@en ; ifcore:hasAudience ifcore:Public .
ifcore:TaxonomyType a skos:Concept ; skos:inScheme ifcore:NoemaTypeScheme ; skos:prefLabel "Taxonomy"@en ; skos:notation "taxonomy" ;
    skos:definition "A classification structure."@en ; ifcore:hasAudience ifcore:Public .
ifcore:OntologyType a skos:Concept ; skos:inScheme ifcore:NoemaTypeScheme ; skos:prefLabel "Ontology"@en ; skos:notation "ontology" ;
    skos:definition "A formal description of concepts and relationships."@en ; ifcore:hasAudience ifcore:Public .
ifcore:DesignPatternType a skos:Concept ; skos:inScheme ifcore:NoemaTypeScheme ; skos:prefLabel "Design pattern"@en ; skos:notation "design-pattern" ;
    skos:definition "A reusable abstract solution to a recurring problem."@en ; skos:closeMatch ifcore:DesignPattern ; ifcore:hasAudience ifcore:Public .
ifcore:BusinessModelType a skos:Concept ; skos:inScheme ifcore:NoemaTypeScheme ; skos:prefLabel "Business model"@en ; skos:notation "business-model" ;
    skos:definition "An abstract explanation of how value is created, delivered and captured."@en ; ifcore:hasAudience ifcore:Public .

# Epistemic state: how well an idea stands, kept apart from its publication, editorial, approval or operational lifecycle (0048 FR-011 – FR-015).

ifcore:EpistemicStateScheme a skos:ConceptScheme ; rdfs:label "Epistemic state"@en ;
    rdfs:comment "How well a Noema's idea stands in the evidence (0048-noemas FR-011). Not a publication, editorial, approval or operational state (ifcore:WorkLifecycleStage and the like): a published theory may be contested, and a falsified hypothesis stays in the record. There is no state for proven; supported is not proven (FR-014)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:ProposedState a skos:Concept ; skos:inScheme ifcore:EpistemicStateScheme ; skos:prefLabel "Proposed"@en ; skos:notation "proposed" ;
    skos:definition "Put forward and not yet investigated. A Noema with no accepted assessment is proposed."@en ; ifcore:hasAudience ifcore:Public .
ifcore:UnderInvestigationState a skos:Concept ; skos:inScheme ifcore:EpistemicStateScheme ; skos:prefLabel "Under investigation"@en ; skos:notation "under-investigation" ;
    skos:definition "Evidence is being gathered and assumptions challenged."@en ; ifcore:hasAudience ifcore:Public .
ifcore:SupportedState a skos:Concept ; skos:inScheme ifcore:EpistemicStateScheme ; skos:prefLabel "Supported"@en ; skos:notation "supported" ;
    skos:definition "The weight of the identified evidence favors it. Not proven, and it may still be challenged."@en ; ifcore:hasAudience ifcore:Public .
ifcore:ContestedState a skos:Concept ; skos:inScheme ifcore:EpistemicStateScheme ; skos:prefLabel "Contested"@en ; skos:notation "contested" ;
    skos:definition "Credible evidence or argument for and against it stand together."@en ; ifcore:hasAudience ifcore:Public .
ifcore:FalsifiedState a skos:Concept ; skos:inScheme ifcore:EpistemicStateScheme ; skos:prefLabel "Falsified"@en ; skos:notation "falsified" ;
    skos:definition "Evidence refutes it. The Noema stays, with its evidence and history, as a research asset."@en ; ifcore:hasAudience ifcore:Public .
ifcore:SupersededState a skos:Concept ; skos:inScheme ifcore:EpistemicStateScheme ; skos:prefLabel "Superseded"@en ; skos:notation "superseded" ;
    skos:definition "Replaced by a Noema that supersedes it. It stays, and may remain historically important."@en ; ifcore:hasAudience ifcore:Public .

ifcore:EpistemicAssessment a owl:Class ; rdfs:subClassOf ifcore:Assertion ; rdfs:label "Epistemic assessment"@en ;
    rdfs:comment "An assertion about a Noema's subject (schema:about) giving its epistemic state as of schema:validFrom, on a stated basis (dcterms:source). It is a judgment: an AI's is a candidate, and only a reviewed or accepted one changes the Noema's current state (0048-noemas FR-012, FR-015)."@en .
ifcore:assessedState a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain ifcore:EpistemicAssessment ; rdfs:range skos:Concept ;
    rdfs:comment "A concept of ifcore:EpistemicStateScheme."@en .

# Review: candidate, reviewed, accepted, kept apart from verification (0047-digital-reflections FR-038).

ifcore:ReviewStateScheme a skos:ConceptScheme ; rdfs:label "Review state"@en ;
    rdfs:comment "Whether a person has accepted a statement or a record into what the Eidolon holds (0047-digital-reflections FR-038). None stated is a candidate. Distinct from verification, which checks a statement against its source."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:CandidateState a skos:Concept ; skos:inScheme ifcore:ReviewStateScheme ; skos:prefLabel "Candidate"@en ; skos:notation "candidate" ;
    skos:definition "Proposed by a person or an AI agent and not yet reviewed. Its content is not relied on as knowledge."@en ; ifcore:hasAudience ifcore:Public .
ifcore:ReviewedState a skos:Concept ; skos:inScheme ifcore:ReviewStateScheme ; skos:prefLabel "Reviewed"@en ; skos:notation "reviewed" ;
    skos:definition "A person has read it and kept it for use, without yet accepting it."@en ; ifcore:hasAudience ifcore:Public .
ifcore:AcceptedState a skos:Concept ; skos:inScheme ifcore:ReviewStateScheme ; skos:prefLabel "Accepted"@en ; skos:notation "accepted" ;
    skos:definition "A person accepted it into what the Eidolon holds."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RejectedState a skos:Concept ; skos:inScheme ifcore:ReviewStateScheme ; skos:prefLabel "Rejected"@en ; skos:notation "rejected" ;
    skos:definition "A person declined it. It stays, so it is not proposed again."@en ; ifcore:hasAudience ifcore:Public .
ifcore:reviewState a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain [ a owl:Class ; owl:unionOf ( ifcore:Assertion ifcore:DigitalReflection ) ] ; rdfs:range skos:Concept ;
    rdfs:comment "A concept of ifcore:ReviewStateScheme; absent means candidate (0047-digital-reflections FR-038)."@en .
ifcore:reviewedBy a owl:ObjectProperty ; rdfs:domain [ a owl:Class ; owl:unionOf ( ifcore:Assertion ifcore:DigitalReflection ) ] ; rdfs:range ifcore:Person ;
    rdfs:comment "The person who reviewed it. Never an AI agent."@en .
ifcore:reviewedOn a owl:DatatypeProperty ; rdfs:domain [ a owl:Class ; owl:unionOf ( ifcore:Assertion ifcore:DigitalReflection ) ] ; rdfs:range xsd:date ;
    rdfs:comment "When the person reviewed it. Required with ifcore:reviewedBy."@en .

# Aspects: what an assertion about an idea is (0048 FR-017, FR-018, FR-026, FR-027).

ifcore:AspectScheme a skos:ConceptScheme ; rdfs:label "Assertion aspect"@en ;
    rdfs:comment "What an assertion about a Noema's subject is, beyond its label: the epistemic parts of an idea and the optional commercial parts (0048-noemas FR-017, FR-026). Each is an ifcore:Assertion with ifcore:aspect, so it has a label, a source, a review state and a verifier like any other."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:EpistemicAspect a skos:Concept ; skos:inScheme ifcore:AspectScheme ; skos:topConceptOf ifcore:AspectScheme ; skos:prefLabel "Epistemic aspect"@en ; skos:notation "epistemic" ;
    skos:definition "The group of aspects that say what an idea assumes, predicts, can be refuted by, and where it is limited."@en ; ifcore:hasAudience ifcore:Public .
ifcore:CommercialAspect a skos:Concept ; skos:inScheme ifcore:AspectScheme ; skos:topConceptOf ifcore:AspectScheme ; skos:prefLabel "Commercial aspect"@en ; skos:notation "commercial" ;
    skos:definition "The group of aspects that say where an idea might become useful to a buyer. Optional: an idea needs none to exist."@en ; ifcore:hasAudience ifcore:Public .
ifcore:AssumptionAspect a skos:Concept ; skos:inScheme ifcore:AspectScheme ; skos:broader ifcore:EpistemicAspect ; skos:prefLabel "Assumption"@en ; skos:notation "assumption" ;
    skos:definition "Something the idea depends on being true."@en ; ifcore:hasAudience ifcore:Public .
ifcore:PredictionAspect a skos:Concept ; skos:inScheme ifcore:AspectScheme ; skos:broader ifcore:EpistemicAspect ; skos:prefLabel "Testable prediction"@en ; skos:notation "prediction" ;
    skos:definition "What would be observed if the idea is right."@en ; ifcore:hasAudience ifcore:Public .
ifcore:FalsificationCriterionAspect a skos:Concept ; skos:inScheme ifcore:AspectScheme ; skos:broader ifcore:EpistemicAspect ; skos:prefLabel "Falsification criterion"@en ; skos:notation "falsification-criterion" ;
    skos:definition "What observation would refute or weaken the idea."@en ; ifcore:hasAudience ifcore:Public .
ifcore:ExperimentalDesignAspect a skos:Concept ; skos:inScheme ifcore:AspectScheme ; skos:broader ifcore:EpistemicAspect ; skos:prefLabel "Experimental design"@en ; skos:notation "experimental-design" ;
    skos:definition "How the idea could be tested."@en ; ifcore:hasAudience ifcore:Public .
ifcore:LimitationAspect a skos:Concept ; skos:inScheme ifcore:AspectScheme ; skos:broader ifcore:EpistemicAspect ; skos:prefLabel "Known limitation"@en ; skos:notation "limitation" ;
    skos:definition "Where the idea is known not to hold or not to reach."@en ; ifcore:hasAudience ifcore:Public .
ifcore:OpenQuestionAspect a skos:Concept ; skos:inScheme ifcore:AspectScheme ; skos:broader ifcore:EpistemicAspect ; skos:prefLabel "Open question"@en ; skos:notation "open-question" ;
    skos:definition "Something about the idea that is not yet known."@en ; ifcore:hasAudience ifcore:Public .
ifcore:CounterargumentAspect a skos:Concept ; skos:inScheme ifcore:AspectScheme ; skos:broader ifcore:EpistemicAspect ; skos:prefLabel "Counterargument"@en ; skos:notation "counterargument" ;
    skos:definition "An argument against the idea, with or without new evidence."@en ; ifcore:hasAudience ifcore:Public .
ifcore:ConsequenceAspect a skos:Concept ; skos:inScheme ifcore:AspectScheme ; skos:broader ifcore:EpistemicAspect ; skos:prefLabel "Practical consequence"@en ; skos:notation "consequence" ;
    skos:definition "What follows in practice if the idea is correct."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RevisionAspect a skos:Concept ; skos:inScheme ifcore:AspectScheme ; skos:broader ifcore:EpistemicAspect ; skos:prefLabel "Revision"@en ; skos:notation "revision" ;
    skos:definition "A change to an earlier assertion, derived from it. The earlier one stays."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RetractionAspect a skos:Concept ; skos:inScheme ifcore:AspectScheme ; skos:broader ifcore:EpistemicAspect ; skos:prefLabel "Retraction"@en ; skos:notation "retraction" ;
    skos:definition "A withdrawal of an earlier assertion, derived from it. The earlier one stays."@en ; ifcore:hasAudience ifcore:Public .
ifcore:ProblemAddressedAspect a skos:Concept ; skos:inScheme ifcore:AspectScheme ; skos:broader ifcore:CommercialAspect ; skos:prefLabel "Problem addressed"@en ; skos:notation "problem-addressed" ;
    skos:definition "The real-world problem the idea bears on."@en ; ifcore:hasAudience ifcore:Public .
ifcore:IntendedBeneficiaryAspect a skos:Concept ; skos:inScheme ifcore:AspectScheme ; skos:broader ifcore:CommercialAspect ; skos:prefLabel "Intended beneficiary"@en ; skos:notation "intended-beneficiary" ;
    skos:definition "Whom the idea is meant to help."@en ; ifcore:hasAudience ifcore:Public .
ifcore:PotentialBuyerAspect a skos:Concept ; skos:inScheme ifcore:AspectScheme ; skos:broader ifcore:CommercialAspect ; skos:prefLabel "Potential buyer"@en ; skos:notation "potential-buyer" ;
    skos:definition "Who might pay for something built from the idea."@en ; ifcore:hasAudience ifcore:Public .
ifcore:ExistingWorkflowAspect a skos:Concept ; skos:inScheme ifcore:AspectScheme ; skos:broader ifcore:CommercialAspect ; skos:prefLabel "Relevant existing workflow"@en ; skos:notation "existing-workflow" ;
    skos:definition "The current way of working the idea would change."@en ; ifcore:hasAudience ifcore:Public .
ifcore:ProductWedgeAspect a skos:Concept ; skos:inScheme ifcore:AspectScheme ; skos:broader ifcore:CommercialAspect ; skos:prefLabel "Candidate product wedge"@en ; skos:notation "product-wedge" ;
    skos:definition "A narrow first product or service the idea could enter through."@en ; ifcore:hasAudience ifcore:Public .
ifcore:CommercialHypothesisAspect a skos:Concept ; skos:inScheme ifcore:AspectScheme ; skos:broader ifcore:CommercialAspect ; skos:prefLabel "Commercial hypothesis"@en ; skos:notation "commercial-hypothesis" ;
    skos:definition "A guess about demand or value that has not been shown. It is never demand evidence."@en ; ifcore:hasAudience ifcore:Public .
ifcore:DemandEvidenceAspect a skos:Concept ; skos:inScheme ifcore:AspectScheme ; skos:broader ifcore:CommercialAspect ; skos:prefLabel "Demand evidence"@en ; skos:notation "demand-evidence" ;
    skos:definition "Evidence from identifiable Eidolons (ifcore:demonstratedBy) that someone wants what the idea could yield. Novelty, citations, patentability and technical elegance are not demand evidence (0048-noemas FR-027)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:CompetingApproachAspect a skos:Concept ; skos:inScheme ifcore:AspectScheme ; skos:broader ifcore:CommercialAspect ; skos:prefLabel "Competing approach"@en ; skos:notation "competing-approach" ;
    skos:definition "Another way of getting the same result."@en ; ifcore:hasAudience ifcore:Public .
ifcore:AdoptionObstacleAspect a skos:Concept ; skos:inScheme ifcore:AspectScheme ; skos:broader ifcore:CommercialAspect ; skos:prefLabel "Adoption obstacle"@en ; skos:notation "adoption-obstacle" ;
    skos:definition "What stands between the idea and its use."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RightsConsiderationAspect a skos:Concept ; skos:inScheme ifcore:AspectScheme ; skos:broader ifcore:CommercialAspect ; skos:prefLabel "Rights and licensing consideration"@en ; skos:notation "rights-consideration" ;
    skos:definition "A question about rights in or around the idea. A statement here is an assertion with its own source, not a right (0048-noemas FR-030)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:NativeAlphaSourceAspect a skos:Concept ; skos:inScheme ifcore:AspectScheme ; skos:broader ifcore:CommercialAspect ; skos:prefLabel "Potential source of Native Alpha"@en ; skos:notation "native-alpha-source" ;
    skos:definition "Why the idea might yield a durable technical, economic, workflow, distribution or strategic advantage."@en ; ifcore:hasAudience ifcore:Public .
ifcore:aspect a owl:ObjectProperty ; rdfs:domain ifcore:Assertion ; rdfs:range skos:Concept ;
    rdfs:comment "A concept of ifcore:AspectScheme: what this assertion is about the idea (0048-noemas FR-017)."@en .
ifcore:demonstratedBy a owl:ObjectProperty ; rdfs:domain ifcore:Assertion ;
    rdfs:comment "The identifiable Eidolons a demand-evidence assertion comes from, by subject identifier (0048-noemas FR-027)."@en .

# Relationship families and types that connect Noemas (0048 FR-021 – FR-024).

ifcore:ConceptualFamily a skos:Concept ; skos:inScheme ifcore:RelationFamilyScheme ; skos:prefLabel "Conceptual"@en ; skos:notation "conceptual" ;
    skos:definition "How one idea builds on, refines, generalizes, specializes or replaces another."@en ; ifcore:hasAudience ifcore:Public .
ifcore:EpistemicFamily a skos:Concept ; skos:inScheme ifcore:RelationFamilyScheme ; skos:prefLabel "Epistemic"@en ; skos:notation "epistemic" ;
    skos:definition "What bears on whether an idea is right: evidence, tests, explanations, challenges, the claims it states and the documents that describe it."@en ; ifcore:hasAudience ifcore:Public .
ifcore:EngagementFamily a skos:Concept ; skos:inScheme ifcore:RelationFamilyScheme ; skos:prefLabel "Engagement"@en ; skos:notation "engagement" ;
    skos:definition "Who proposes, researches or adopts an idea. Engagement is not ownership of it or of any right in it."@en ; ifcore:hasAudience ifcore:Public .

ifcore:BuildsOn a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "buildsOn"@en ; skos:notation "buildsOn" ;
    skos:definition "An idea takes another as its foundation."@en ;
    ifcore:relationFamily ifcore:ConceptualFamily ; ifcore:fromKind ifcore:NoemaKind ; ifcore:toKind ifcore:NoemaKind ; ifcore:hasAudience ifcore:Public .
ifcore:Refines a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "refines"@en ; skos:notation "refines" ;
    skos:definition "An idea sharpens another without replacing it."@en ;
    ifcore:relationFamily ifcore:ConceptualFamily ; ifcore:fromKind ifcore:NoemaKind ; ifcore:toKind ifcore:NoemaKind ; ifcore:hasAudience ifcore:Public .
ifcore:Generalizes a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "generalizes"@en ; skos:notation "generalizes" ;
    skos:definition "An idea covers more cases than another it includes."@en ;
    ifcore:relationFamily ifcore:ConceptualFamily ; ifcore:fromKind ifcore:NoemaKind ; ifcore:toKind ifcore:NoemaKind ; ifcore:hasAudience ifcore:Public .
ifcore:Specializes a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "specializes"@en ; skos:notation "specializes" ;
    skos:definition "An idea covers a narrower set of cases than another that includes it."@en ;
    ifcore:relationFamily ifcore:ConceptualFamily ; ifcore:fromKind ifcore:NoemaKind ; ifcore:toKind ifcore:NoemaKind ; ifcore:hasAudience ifcore:Public .
ifcore:Supersedes a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "supersedes"@en ; skos:notation "supersedes" ;
    skos:definition "An idea replaces another. The replaced idea is assessed Superseded and stays (0048-noemas FR-015)."@en ;
    ifcore:relationFamily ifcore:ConceptualFamily ; ifcore:fromKind ifcore:NoemaKind ; ifcore:toKind ifcore:NoemaKind ; ifcore:hasAudience ifcore:Public .
ifcore:Supports a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "supports"@en ; skos:notation "supports" ;
    skos:definition "An idea, or an observation or experiment, is evidence for an idea. Not a proof, and it coexists with evidence against (0048-noemas FR-016)."@en ;
    ifcore:relationFamily ifcore:EpistemicFamily ; ifcore:fromKind ifcore:NoemaKind, ifcore:OtherKind ; ifcore:toKind ifcore:NoemaKind ; ifcore:hasAudience ifcore:Public .
ifcore:Contradicts a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "contradicts"@en ; skos:notation "contradicts" ;
    skos:definition "An idea, or an observation or experiment, is evidence against an idea. It does not by itself falsify it."@en ;
    ifcore:relationFamily ifcore:EpistemicFamily ; ifcore:fromKind ifcore:NoemaKind, ifcore:OtherKind ; ifcore:toKind ifcore:NoemaKind ; ifcore:hasAudience ifcore:Public .
ifcore:Challenges a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "challenges"@en ; skos:notation "challenges" ;
    skos:definition "An idea or a person puts an idea to question, by argument or by test."@en ;
    ifcore:relationFamily ifcore:EpistemicFamily ; ifcore:fromKind ifcore:NoemaKind, ifcore:EidolonKind ; ifcore:toKind ifcore:NoemaKind ; ifcore:hasAudience ifcore:Public .
ifcore:Tests a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "tests"@en ; skos:notation "tests" ;
    skos:definition "An idea (an experimental design), a made thing or an experiment puts an idea to a test."@en ;
    ifcore:relationFamily ifcore:EpistemicFamily ; ifcore:fromKind ifcore:NoemaKind, ifcore:ErgonKind, ifcore:OtherKind ; ifcore:toKind ifcore:NoemaKind ; ifcore:hasAudience ifcore:Public .
ifcore:Explains a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "explains"@en ; skos:notation "explains" ;
    skos:definition "An idea accounts for another idea or for an observation."@en ;
    ifcore:relationFamily ifcore:EpistemicFamily ; ifcore:fromKind ifcore:NoemaKind ; ifcore:toKind ifcore:NoemaKind, ifcore:OtherKind ; ifcore:hasAudience ifcore:Public .
ifcore:MotivatedBy a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "motivatedBy"@en ; skos:notation "motivatedBy" ;
    skos:definition "An idea was prompted by an observation, a problem or another idea."@en ;
    ifcore:relationFamily ifcore:EpistemicFamily ; ifcore:fromKind ifcore:NoemaKind ; ifcore:toKind ifcore:NoemaKind, ifcore:OtherKind ; ifcore:hasAudience ifcore:Public .
ifcore:States a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "states"@en ; skos:notation "states" ;
    skos:definition "An idea puts forward a claim. Stating a claim does not assert that it is true (0048-noemas FR-008)."@en ;
    ifcore:relationFamily ifcore:EpistemicFamily ; ifcore:fromKind ifcore:NoemaKind ; ifcore:toKind ifcore:OtherKind ; ifcore:hasAudience ifcore:Public .
ifcore:Describes a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "describes"@en ; skos:notation "describes" ;
    skos:definition "A document or an instrument (a paper, a patent application, a patent) sets out an idea. It is not the idea, and it says nothing of who owns it (0048-noemas FR-029)."@en ;
    ifcore:relationFamily ifcore:EpistemicFamily ; ifcore:fromKind ifcore:OtherKind ; ifcore:toKind ifcore:NoemaKind ; ifcore:hasAudience ifcore:Public .
ifcore:InformsDesignOf a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "informsDesignOf"@en ; skos:notation "informsDesignOf" ;
    skos:definition "An idea shaped how a made thing was designed. The made thing need not carry it out."@en ;
    ifcore:relationFamily ifcore:LineageFamily ; ifcore:fromKind ifcore:NoemaKind ; ifcore:toKind ifcore:ErgonKind ; ifcore:hasAudience ifcore:Public .
ifcore:Operationalizes a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "operationalizes"@en ; skos:notation "operationalizes" ;
    skos:definition "A made thing puts an idea to work in operation, as a deployed workflow does a methodology. Distinct from implements, which is the design realizing the idea."@en ;
    ifcore:relationFamily ifcore:TechnicalFamily ; ifcore:fromKind ifcore:ErgonKind ; ifcore:toKind ifcore:NoemaKind ; ifcore:hasAudience ifcore:Public .
ifcore:GeneratesEvidenceFor a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "generatesEvidenceFor"@en ; skos:notation "generatesEvidenceFor" ;
    skos:definition "A made thing in operation produces results that bear on an idea, for or against."@en ;
    ifcore:relationFamily ifcore:EpistemicFamily ; ifcore:fromKind ifcore:ErgonKind ; ifcore:toKind ifcore:NoemaKind ; ifcore:hasAudience ifcore:Public .
ifcore:ProvidesEvidenceFor a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "providesEvidenceFor"@en ; skos:notation "providesEvidenceFor" ;
    skos:definition "An organization, a person or a physical asset is where evidence bearing on an idea comes from."@en ;
    ifcore:relationFamily ifcore:EpistemicFamily ; ifcore:fromKind ifcore:EidolonKind ; ifcore:toKind ifcore:NoemaKind ; ifcore:hasAudience ifcore:Public .
ifcore:Proposes a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "proposes"@en ; skos:notation "proposes" ;
    skos:definition "A person or an organization put an idea forward. It says nothing of who conceived it, owns it or may license it."@en ;
    ifcore:relationFamily ifcore:EngagementFamily ; ifcore:fromKind ifcore:EidolonKind ; ifcore:toKind ifcore:NoemaKind ; ifcore:hasAudience ifcore:Public .
ifcore:Researches a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "researches"@en ; skos:notation "researches" ;
    skos:definition "A person or an organization investigates an idea."@en ;
    ifcore:relationFamily ifcore:EngagementFamily ; ifcore:fromKind ifcore:EidolonKind ; ifcore:toKind ifcore:NoemaKind ; ifcore:hasAudience ifcore:Public .
ifcore:Adopts a skos:Concept ; skos:inScheme ifcore:ReflectionRelationScheme ; skos:prefLabel "adopts"@en ; skos:notation "adopts" ;
    skos:definition "A person or an organization takes an idea up as its own working view. It is not ownership and not a license."@en ;
    ifcore:relationFamily ifcore:EngagementFamily ; ifcore:fromKind ifcore:EidolonKind ; ifcore:toKind ifcore:NoemaKind ; ifcore:hasAudience ifcore:Public .

# The Decisions that justify the new terms (0019-controlled-vocabulary FR-004).

ifcore:EidolonErgonSeparation a ifcore:Decision ;
    rdfs:label "Eidolons reflect what exists and Ergons reflect what is created"@en ;
    dcterms:subject ifcore:DigitalReflection, ifcore:Eidolon, ifcore:Ergon, ifcore:reflects, ifcore:purpose, ifcore:ClassificationRule ;
    ifcore:decidedBy ifcore:ShahidNehalShah ;
    ifcore:decidedAt "2026-10-08"^^xsd:date ;
    dcterms:description "A reflection of a company and a reflection of the software it sells answer different questions: the company's is about identity, relationships, state and what changed; the software's is about purpose, design, dependencies, outcomes and the evidence it works. Under one type the two collide, so a product's record would carry a legal identity and a person's would carry a roadmap, and a reader could not tell which questions a record can answer. Two kinds under one shared parent keep what both need (identity, sources, history, audience) in one place and let the kinds differ where they should. No established vocabulary names the pair: schema.org has Thing, Product, Service and Organization but no parent that is a maintained record of a subject, and a digital twin (ISO 23247) requires fidelity and synchronization that neither kind requires. The kind is decided by the subject's type through classification rules, not by the record, so that a wrong kind is found by a check and moved by a person, with no change to identifiers or relationships."@en ;
    ifcore:consideredAlternative ifcore:EidolonErgonAltOneType, ifcore:EidolonErgonAltTwoWorlds, ifcore:EidolonAltDigitalTwin ;
    ifcore:hasAudience ifcore:Public .
ifcore:EidolonErgonAltOneType a ifcore:Alternative ; rdfs:label "Keep one type, Eidolon, for every subject, with a subject-kind property"@en ;
    ifcore:rejectionReason "A property can be left empty or set wrongly with nothing to say which questions the record answers, and every consumer must branch on it. Two disjoint classes make the difference queryable and checkable."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:EidolonErgonAltTwoWorlds a ifcore:Alternative ; rdfs:label "Two unrelated top-level types with no shared parent"@en ;
    ifcore:rejectionReason "Identity, sources, audience, history and stewardship are the same for both, and a reader that needs every reflection would have to know both. A shared parent states the common model once."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:EidolonAltDigitalTwin a ifcore:Alternative ; rdfs:label "Call an Eidolon a 'digital twin'"@en ;
    ifcore:rejectionReason "ISO 23247 (manufacturing) defines a digital twin of an observable manufacturing element (personnel, equipment, materials, processes, facilities, products) that monitors the element with continuously updated data and can control it; only the abstract was read, as the text is paid. An Eidolon reflects any existing subject, including a person, a company or a relationship, carries an audience and a source on every fact, records state and what changed, and does not control its subject. The term 'digital twin of an organization' is also in use outside ISO 23247; that use was not checked."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:ReflectionRelationsAsConcepts a ifcore:Decision ;
    rdfs:label "Relationship types are concepts of a flat scheme, and a relationship is a record between two subjects"@en ;
    dcterms:subject ifcore:ReflectionRelationship, ifcore:ReflectionRelationScheme, ifcore:Assertion ;
    ifcore:decidedBy ifcore:ShahidNehalShah ;
    ifcore:decidedAt "2026-10-08"^^xsd:date ;
    dcterms:description "A relationship needs a source, a validity in time and a degree of certainty, which a plain triple cannot carry, so it is a record. Its type is a concept of a scheme, with a family and the kinds its ends may have, so that adding a type adds a concept and not a property, and a check can test the ends. The scheme is flat on purpose: ownership, inventorship, assignment, licensing, operation, development and use are different facts, and a hierarchy between them is an invitation to infer one from another. The ends are subjects, not records, so that moving a record from one kind to the other changes no relationship. Where schema.org, Dublin Core or PROV has the relationship, the concept points to it with skos:closeMatch and is not a replacement for it."@en ;
    ifcore:consideredAlternative ifcore:ReflectionRelationsAltProperties ;
    ifcore:hasAudience ifcore:Public .
ifcore:ReflectionRelationsAltProperties a ifcore:Alternative ; rdfs:label "One object property per relationship type, with sub-properties"@en ;
    ifcore:rejectionReason "A property carries no provenance or validity without reification, a sub-property hierarchy lets a reasoner infer one right from another, and each type is a new property for 0019 FR-004 to justify."@en ;
    ifcore:hasAudience ifcore:Public .


ifcore:NoemaThirdKind a ifcore:Decision ;
    rdfs:label "Abstract intellectual constructs are a third kind of reflection, the Noema"@en ;
    dcterms:subject ifcore:Noema, ifcore:IntellectualConstruct, ifcore:NoemaKind ;
    ifcore:decidedBy ifcore:ShahidNehalShah ;
    ifcore:decidedAt "2026-10-08"^^xsd:date ;
    dcterms:description "A hypothesis, a theory or a methodology is neither something that exists in the world nor something built to operate, yet research is where unusual insight starts and Native Alpha is traced. Left as kind other they had no record, no epistemic state and no place in the graph that connects customers to products, so the thing the company most needs to track was the thing the model could not hold. A third kind keeps the shared mechanisms of identity, evidence, review and audience in one place and adds only what an idea needs. Greek νόημα (what is thought) completes the set with εἴδωλον (an image of what is) and ἔργον (what is made). No established vocabulary names a maintained record of an idea: SKOS has the concept as a term and PROV has the entity as a thing with provenance, neither carrying a state of belief, evidence for and against, or a history of revision."@en ;
    ifcore:consideredAlternative ifcore:NoemaAltOther, ifcore:NoemaAltErgon, ifcore:NoemaAltIdea, ifcore:NoemaAltBorrowedWord ;
    ifcore:hasAudience ifcore:Public .
ifcore:NoemaAltOther a ifcore:Alternative ; rdfs:label "Leave abstract subjects as kind other with no reflection"@en ;
    ifcore:rejectionReason "About fifteen hundred typed subjects of the vault and the public root are named concepts, notes and agendas. Leaving them without a record leaves research the one part of the company that cannot be queried, assessed or connected to a product or a buyer."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:NoemaAltErgon a ifcore:Alternative ; rdfs:label "Treat an idea as an Ergon because it is made by thinking"@en ;
    ifcore:rejectionReason "An Ergon answers what it does, whom it serves and whether it works. An idea is not operated, is not bought, and can be false; a product that is false is broken, and a hypothesis that is false is a result."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:NoemaAltIdea a ifcore:Alternative ; rdfs:label "Name the third kind Idea, Concept or Knowledge"@en ;
    ifcore:rejectionReason "Concept is one subtype of the kind, Idea is too loose to be a type, and Knowledge claims what the kind deliberately does not: a Noema may be false. A name in the same Greek family as the other two reads as a set."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:NoemaAltBorrowedWord a ifcore:Alternative ; rdfs:label "Treat 'Noema' and 'Ergon' as original coinages"@en ;
    ifcore:rejectionReason "'Noema' is an established word in philosophy (Husserl's term for what a thought is directed at) and 'ergon' is classical Greek for 'work'; neither is invented. They are borrowed and given one exact meaning here. 0019 FR-011 says a borrowed word is not original for that reason, so the exception rests on the kinds being the company's own classification (0047-digital-reflections, 0048-noemas) and not on the words. This origin was stated from general knowledge and was not searched in this audit."@en ;
    ifcore:hasAudience ifcore:Public .

# ───────────────────────── Access audience (0019 FR-004, FR-010) ─────────────────────────
ifcore:AccessAudienceName a ifcore:Decision ;
    rdfs:label "The class of permissions to see a fact is named Access audience, not Audience"@en ;
    dcterms:subject ifcore:AccessAudience, ifcore:RoleOrGroup ;
    ifcore:decidedBy ifcore:ShahidNehalShah ;
    ifcore:decidedAt "2026-10-09"^^xsd:date ;
    dcterms:description "schema.org Audience is the intended audience of an item, the group it was created for; it is descriptive and grants nothing. The class that holds public, company affiliation, a named agreement and a named role or group answers a different question: who may see a fact. Two classes both called Audience made the ontology explain the difference in its own comments (see ifcore:Readership). The class is renamed to the access meaning; the property ifcore:hasAudience keeps its name, because it is a different term from schema:audience and the vault declares it on every fact, and prose may still say 'audience' for the access meaning. No standard term replaces the class: ODRL expresses who may do what with a Permission whose assignee is a Party, and does not define a class of named audiences. OAuth and JSON Web Token use 'audience' for the intended recipient of a token, which is close to this meaning but is not defined as a class of permissions (stated from general knowledge; not searched in this audit)."@en ;
    ifcore:consideredAlternative ifcore:AccessAudienceAltKeep, ifcore:AccessAudienceAltOdrl, ifcore:AccessAudienceAltRenameAll ;
    ifcore:hasAudience ifcore:Public .
ifcore:AccessAudienceAltKeep a ifcore:Alternative ; rdfs:label "Keep the name Audience and explain the difference in comments"@en ;
    ifcore:rejectionReason "The same word means two different things in one ontology, and a reader or a tool that loads schema.org meets both. The class is declared in the company's namespace, so it can be renamed at the cost of nine references."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:AccessAudienceAltOdrl a ifcore:Alternative ; rdfs:label "Replace the class with ODRL (Permission, Party, Constraint)"@en ;
    ifcore:rejectionReason "ODRL states rules about what a party may do with an asset. Here each fact names the set of viewers who may see it, and a viewer who satisfies any one listed audience may see the fact. ODRL has no named class of such sets. It stays a possible later mapping: skos:broadMatch odrl:Permission is already stated for ifcore:Grant."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:AccessAudienceAltRenameAll a ifcore:Alternative ; rdfs:label "Rename the property ifcore:hasAudience as well"@en ;
    ifcore:rejectionReason "The property is a different term from schema:audience, so it does not clash. It appears in about 5,100 places in 459 files of the two repositories, in every fact, in the vault's rules and in its checks, so a rename costs far more than it removes."@en ;
    ifcore:hasAudience ifcore:Public .

# ───────────────────────── Vocabulary audit of 2026-10-09: accepted ties and kept terms (spec 0019) ─────────────────────────
ifcore:ClarifiedAndMappedTermsAccepted a ifcore:Decision ;
    rdfs:label "Every change that clarifies a term or ties it to an existing standard is accepted"@en ;
    dcterms:subject ifcore:Person, ifcore:Organization, ifcore:Company, ifcore:Right, ifcore:License, ifcore:Agreement,
        ifcore:Grant, ifcore:Hunt, ifcore:NetworkMeasure, ifcore:EvidencePacket, ifcore:RelationshipMemory,
        ifcore:PlatformCapabilityScheme, ifcore:legalName, ifcore:displayName, ifcore:doi, ifcore:decidedBy,
        ifcore:decidedAt, ifcore:validFrom, ifcore:validUntil, ifcore:primarySource, ifcore:describes,
        ifcore:grantedTo, ifcore:unitOf, ifcore:hasUnit, ifcore:sourceFile, ifcore:relationFrom,
        ifcore:relationTo, ifcore:seriesNumber, ifcore:builtBy, ifweb:Page, ifweb:UnitPage,
        ifweb:ResearchPillarPage, ifweb:ResearchNotePage, ifweb:PatentFamilyPage, ifweb:TrademarkPage,
        ifweb:DefensiveDisclosurePage, ifweb:FundPage, ifweb:BookPage, ifweb:WorkPage, ifweb:WorkEditionPage,
        ifweb:JournalArticlePage, ifweb:PortfolioIndexPage, ifweb:PromotionPost, ifweb:Application ;
    ifcore:decidedBy ifcore:ShahidNehalShah ;
    ifcore:decidedAt "2026-10-09"^^xsd:date ;
    dcterms:description "The founder accepted all changes proposed by the first vocabulary audit where a term is further clarified and tied to an existing standard: the ties of classes and properties to schema.org, PROV-O, the W3C Organization Ontology, Dublin Core, ODRL and the Data Cube vocabulary, the rename of ifcore:Audience (its own Decision), the elaboration of product-led growth by IPLG (its own Decision), and the established names added as alternative labels to the platform capabilities and to relationship memory. The repository is new and has no outside users, so the cost of a rename or a clarification is nil and the history of the old names is not kept. The ties are checked by the vocabulary scan and are not restated here."@en ;
    ifcore:consideredAlternative ifcore:ClarifiedAltEachTerm, ifcore:ClarifiedAltKeepAndComment ;
    ifcore:hasAudience ifcore:Public .

ifcore:ClarifiedAltEachTerm a ifcore:Alternative ; rdfs:label "Decide each term in a separate Decision"@en ;
    ifcore:rejectionReason "Each term would need its own record that adds no information beyond the tie itself. The tie is the evidence, and the scan lists it."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:ClarifiedAltKeepAndComment a ifcore:Alternative ; rdfs:label "Leave each term unchanged and explain the difference in a comment"@en ;
    ifcore:rejectionReason "A comment is not a tie and the scan cannot read it, so the next audit would flag the same term again. The rule of spec 0019 asks for a tie or a Decision."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:ResearchFrameworkTermsKept a ifcore:Decision ;
    rdfs:label "The evidence ladder, the claim labels, Elenchus, AI Workforce, Labor as Code and Consequential Software are the company's own framework terms"@en ;
    dcterms:subject ifcore:EvidenceLadderStage, ifcore:ClaimLabel, ifcore:Elenchus, ifcore:AIWorkforce, ifcore:LaborAsCode,
        ifcore:ConsequentialSoftware ;
    ifcore:decidedBy ifcore:ShahidNehalShah ;
    ifcore:decidedAt "2026-10-09"^^xsd:date ;
    dcterms:description "Each term names a framework of the company's own research, and an established term was considered for each and found to name a different thing. The evidence ladder ranks a publication's reception (silence, argument, adoption of terminology, willingness to pay), and the claim labels name a claim's role (observation, hypothesis, evidence, inference, recommendation, unknown); the Oxford CEBM levels rank study designs and GRADE rates certainty in an effect estimate. Elenchus is the pattern in which a claim stands only if the evidence survives an attempt to refute it; continuous controls monitoring is one way to carry it out, by automated repeated tests of controls. AI Workforce names a set of five parts (a SpecKit, a harness, agents, skills and MCPs) and a bar a service must meet; Labor as Code names a skill that keeps a person's knowledge, judgment and taste in durable form; the plain words (agentic workflow, skill) name a part and not the framework. Consequential Software names software whose cost of a wrong decision falls on people other than the one who decides; FIPS 199 rates the harm of a security failure to an organization. Elenchus is also a borrowed Greek word; that is not a reason for the exception (spec 0019 FR-011), the reason is the difference in meaning. The labels of the AI Workforce, Labor as Code and Consequential Software judgments come from reading their definitions; no source was found that defines them. Judged by an AI audit pass on the founder's instruction to make best judgements, and accepted by the founder's instruction of the same date; the weekly vocabulary audit re-checks a sample of the terms named here (spec 0019 FR-007)."@en ;
    ifcore:consideredAlternative ifcore:ResearchAltOxfordGrade, ifcore:ResearchAltCcm, ifcore:ResearchAltAgentic, ifcore:ResearchAltFips199 ;
    ifcore:hasAudience ifcore:Public .

ifcore:ResearchAltOxfordGrade a ifcore:Alternative ; rdfs:label "Use the Oxford CEBM levels or GRADE for the evidence ladder and the claim labels"@en ;
    ifcore:rejectionReason "They rank study designs and the certainty of an effect estimate. Neither ranks how a publication was received, and neither names the role a claim plays in a text."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:ResearchAltCcm a ifcore:Alternative ; rdfs:label "Call Elenchus continuous controls monitoring"@en ;
    ifcore:rejectionReason "Continuous controls monitoring is automated, repeated testing of whether controls operate. Elenchus is the wider pattern of trying to refute a claim, and compliance testing is one use of it. The established name is kept as a related term in the definition."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:ResearchAltAgentic a ifcore:Alternative ; rdfs:label "Use agentic workflow or skill for AI Workforce and Labor as Code"@en ;
    ifcore:rejectionReason "The plain words name one part. AI Workforce names five parts and a bar to meet, and Labor as Code names a skill that carries a person's judgment and taste in durable form."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:ResearchAltFips199 a ifcore:Alternative ; rdfs:label "Use FIPS 199 potential impact for Consequential Software"@en ;
    ifcore:rejectionReason "FIPS 199 rates the harm of losing confidentiality, integrity or availability to an organization or a person. Consequential Software concerns a decision to build, buy or adopt software whose cost falls on other people."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:AIOperatingLevelTermsKept a ifcore:Decision ;
    rdfs:label "AI First and AI Augmented stay as practitioner terms for how much of a service an AI does"@en ;
    dcterms:subject ifcore:AIFirst, ifcore:AIAugmented ;
    ifcore:decidedBy ifcore:ShahidNehalShah ;
    ifcore:decidedAt "2026-10-09"^^xsd:date ;
    dcterms:description "AI-first, AI-augmented, AI-assisted and AI-native are words practitioners use, but no standard defines them and the sources place the lines between them in different places (vendor sources only were found). The ontology needs three levels with a test for each, so it keeps AI First and AI Augmented as practitioner terms, each defined here by its own test, and types a shared service by those tests and not by branding (spec 0011 FR-011). If a standard appears, the terms are tied to it. Judged by an AI audit pass on the founder's instruction to make best judgements, and accepted by the founder's instruction of the same date; the weekly vocabulary audit re-checks a sample of the terms named here (spec 0019 FR-007)."@en ;
    ifcore:consideredAlternative ifcore:AILevelsAltNumbered, ifcore:AILevelsAltAssistedNative ;
    ifcore:hasAudience ifcore:Public .

ifcore:AILevelsAltNumbered a ifcore:Alternative ; rdfs:label "Adopt a vendor's numbered maturity model"@en ;
    ifcore:rejectionReason "The vendor models disagree on the number of levels and where each begins, and each is the vendor's own."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:AILevelsAltAssistedNative a ifcore:Alternative ; rdfs:label "Use only AI-assisted and AI-native"@en ;
    ifcore:rejectionReason "Two levels cannot state the case where an AI leads production but developers stay in the daily loop (AI First) and the case where humans do most of the work with AI helping (AI Augmented)."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:PublishedStandardSchemesKept a ifcore:Decision ;
    rdfs:label "The Trust Services Criteria, the CMMC Level 1 practices and the risk treatment options reproduce published standards"@en ;
    dcterms:subject ifcore:TrustServicesCriteria, ifcore:CMMCLevel1, ifcore:RiskTreatmentScheme ;
    ifcore:decidedBy ifcore:ShahidNehalShah ;
    ifcore:decidedAt "2026-10-09"^^xsd:date ;
    dcterms:description "These schemes list the identifiers or option names of published standards: the AICPA Trust Services Criteria (TSP Section 100, 2017, with the 2022 points of focus), the CMMC Level 1 practices (named by their FAR 52.204-21 paragraph in the DoD CIO Level 1 assessment guide) and risk responses (NIST SP 800-39 names accept, avoid, mitigate, share and transfer; the scheme lists accept, avoid, mitigate and transfer, so the difference is to be checked when the scheme is next changed). The terms are the standards' own, so no new term is invented. No stable address for the criteria or the practices in a published vocabulary was found, so no tie is stated. Judged by an AI audit pass on the founder's instruction to make best judgements, and accepted by the founder's instruction of the same date; the weekly vocabulary audit re-checks a sample of the terms named here (spec 0019 FR-007)."@en ;
    ifcore:consideredAlternative ifcore:StandardSchemesAltMint, ifcore:PlainWordAltNearestStandard ;
    ifcore:hasAudience ifcore:Public .

ifcore:StandardSchemesAltMint a ifcore:Alternative ; rdfs:label "Mint an address for each criterion and tie it to the standard's text"@en ;
    ifcore:rejectionReason "A tie needs an address the standard's owner publishes. None was found, and an address minted here would be one more invented term."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:PlainWordClassesKept a ifcore:Decision ;
    rdfs:label "Classes named in ordinary words of their field, with no established class to tie them to are kept"@en ;
    dcterms:subject ifcore:Alternative, ifcore:Asset, ifcore:Capability, ifcore:CapitalSource, ifcore:ClaimKind,
        ifcore:CommercializationSubstage, ifcore:ConfidenceLevel, ifcore:ControlTest, ifcore:CutKind,
        ifcore:Decision, ifcore:DecisionOutcome, ifcore:DeliveryRecord, ifcore:DesignPartnerRequirement,
        ifcore:DesignSystem, ifcore:DesignSystemStatus, ifcore:DigitalAsset, ifcore:Disposition,
        ifcore:EidolonComponent, ifcore:Equipment, ifcore:ExternalRecordReference, ifcore:Fact,
        ifcore:FinancialAsset, ifcore:FounderWritingType, ifcore:FundMode, ifcore:Goodwill,
        ifcore:IndependenceTest, ifcore:IntangibleAsset, ifcore:IntellectualProperty, ifcore:Invention,
        ifcore:LandscapeReview, ifcore:MethodStage, ifcore:NamedTool, ifcore:Note, ifcore:NoteType,
        ifcore:Outcome, ifcore:OwnershipMode, ifcore:PortfolioCategory, ifcore:PressLevel, ifcore:PromotionBrief,
        ifcore:RealProperty, ifcore:Reference, ifcore:ResearchArea, ifcore:ResearchPillar,
        ifcore:RestrictedDataReference, ifcore:SearchStage, ifcore:SharedService, ifcore:SubstantialWork,
        ifcore:TangibleAsset, ifcore:VentureEvidenceKind, ifcore:VentureLifecycleStage, ifcore:VoicePrinciple,
        ifcore:WorkDomain, ifcore:WorkKind, ifcore:WorkLifecycleStage, ifweb:ApplicationHost,
        ifweb:PublishingDestination ;
    ifcore:decidedBy ifcore:ShahidNehalShah ;
    ifcore:decidedAt "2026-10-09"^^xsd:date ;
    dcterms:description "These classes are ordinary words of the field they model, or names specific to the structure of the company, its works or its tools. No established term in a published vocabulary that works in their place was found, and where one was found it is tied instead (see ClarifiedAndMappedTermsAccepted). Each term was read against PROV-O, schema.org, DCMI Terms, the W3C Organization Ontology, ODRL, SKOS and the Data Cube vocabulary from knowledge of those vocabularies, and every equivalent found is tied in the ontology; the terms were not searched on the web one by one. Judged by an AI audit pass on the founder's instruction to make best judgements, and accepted by the founder's instruction of the same date; the weekly vocabulary audit re-checks a sample of the terms named here (spec 0019 FR-007). Their names are kept because the plain word is the established word; for example Disposition, Right, Fund, Trade secret, Patent family, Equipment and Goodwill are terms of law and accounting, and the asset classes cite ISO 55000, whose 2014 edition is withdrawn and replaced by the 2024 edition (https://www.iso.org/standard/83053.html); the citation is to be moved to the current edition."@en ;
    ifcore:consideredAlternative ifcore:PlainWordAltNearestStandard, ifcore:PlainWordAltRename ;
    ifcore:hasAudience ifcore:Public .

ifcore:PlainWordPropertiesKept a ifcore:Decision ;
    rdfs:label "Properties named in ordinary words of their field, with no established property to tie them to are kept"@en ;
    dcterms:subject ifcore:accessInstructions, ifcore:artifactName, ifcore:briefOf, ifcore:cachedValue, ifcore:cadence,
        ifcore:centralThesis, ifcore:checksum, ifcore:claimKind, ifcore:claimLabel, ifcore:codeStatus,
        ifcore:commandCategory, ifcore:commandNoun, ifcore:commandVerb, ifcore:concerning, ifcore:confidenceLevel,
        ifcore:consequenceDomain, ifcore:consideredAlternative, ifcore:consideredEvidence,
        ifcore:continuationInPartOf, ifcore:continuationOf, ifcore:covers, ifcore:cutKind,
        ifcore:defaultDecisionAuthority, ifcore:definedIn, ifcore:deliveredOn, ifcore:deliveredTo,
        ifcore:designSystemStatus, ifcore:divisionalOf, ifcore:domainStanding, ifcore:drawsFiguresWith,
        ifcore:drives, ifcore:fixture, ifcore:fromKind, ifcore:grantsAudience, ifcore:hasAudience,
        ifcore:hasDisposition, ifcore:hasMode, ifcore:hasOutcome, ifcore:heldIn, ifcore:imprintOf,
        ifcore:imprintThesis, ifcore:inWorkDomain, ifcore:job, ifcore:layerOrder, ifcore:licenses,
        ifcore:lifecycleOwner, ifcore:measuredBy, ifcore:moduleCode, ifcore:namedUnknown, ifcore:notProofOf,
        ifcore:noteType, ifcore:noticeWithin, ifcore:offersDoor, ifcore:offersInterface, ifcore:operates,
        ifcore:operatesSharedService, ifcore:operationalStatus, ifcore:platformLayer, ifcore:portfolioCategory,
        ifcore:portfolioCompany, ifcore:probe, ifcore:probeKind, ifcore:providesSurface,
        ifcore:qualifyingCondition, ifcore:question, ifcore:readerOutcome, ifcore:readerSide,
        ifcore:recoveryPointObjective, ifcore:recoveryTimeObjective, ifcore:reflectedAs, ifcore:reflectionClass,
        ifcore:rejectionReason, ifcore:relationFamily, ifcore:relationType, ifcore:resolvedAt,
        ifcore:retentionPeriod, ifcore:searchesFor, ifcore:sequenceOrder, ifcore:shows, ifcore:sourceCommit,
        ifcore:sourceLocation, ifcore:subjectClass, ifcore:suppliesDataFor, ifcore:testsControl, ifcore:thesis,
        ifcore:toKind, ifcore:verificationCadence, ifcore:verificationMethod, ifcore:verifiedBy,
        ifcore:verifiedOn, ifcore:verifiesAgainst, ifcore:workLifecycleStage, ifcore:workspaceFlavor, ifweb:applicationOf,
        ifweb:configurationFile, ifweb:contentKind, ifweb:deploymentRecordFile, ifweb:destinationOf,
        ifweb:featuresWork, ifweb:hostOf, ifweb:hostedBy, ifweb:inventoryEntry, ifweb:publishingCommand,
        ifweb:publishingStrategy ;
    ifcore:decidedBy ifcore:ShahidNehalShah ;
    ifcore:decidedAt "2026-10-09"^^xsd:date ;
    dcterms:description "These properties are ordinary words of the field they model, or names specific to the structure of the company, its works or its tools. No established term in a published vocabulary that works in their place was found, and where one was found it is tied instead (see ClarifiedAndMappedTermsAccepted). Each term was read against PROV-O, schema.org, DCMI Terms, the W3C Organization Ontology, ODRL, SKOS and the Data Cube vocabulary from knowledge of those vocabularies, and every equivalent found is tied in the ontology; the terms were not searched on the web one by one. Judged by an AI audit pass on the founder's instruction to make best judgements, and accepted by the founder's instruction of the same date; the weekly vocabulary audit re-checks a sample of the terms named here (spec 0019 FR-007). Terms such as recovery time objective, recovery point objective, retention period, continuation and divisional (of a patent application), checksum and cadence are the established words of continuity planning, records management, patent law and software delivery."@en ;
    ifcore:consideredAlternative ifcore:PlainWordAltNearestStandard, ifcore:PlainWordAltRename ;
    ifcore:hasAudience ifcore:Public .

ifcore:PlainWordSchemesKept a ifcore:Decision ;
    rdfs:label "Concept schemes whose values are ordinary words of their field are kept"@en ;
    dcterms:subject ifcore:AssessmentItemTypeScheme, ifcore:CommandCategoryScheme, ifcore:CommandSurfaceScheme,
        ifcore:CommandVerbScheme, ifcore:ConsequenceDomainScheme, ifcore:ControlBaselineRuleScheme,
        ifcore:ControlDispositionScheme, ifcore:ControlTestProbeKindScheme, ifcore:CourseDeliveryTargetScheme,
        ifcore:CourseFormatScheme, ifcore:DataClassScheme, ifcore:DeckTypeScheme, ifcore:DecorationMethodScheme,
        ifcore:DesignDensityScheme, ifcore:DesignExpressionScheme, ifcore:DesignSystemKindScheme,
        ifcore:DomainCriticalityScheme, ifcore:DomainRoleScheme, ifcore:DomainSecurityControlScheme,
        ifcore:DomainStandingScheme, ifcore:EmailTypeScheme, ifcore:EnforcementMechanismScheme,
        ifcore:EntryDoorScheme, ifcore:FigureTypeScheme, ifcore:IncidentSeverityScheme, ifcore:InterfaceFlavorScheme,
        ifcore:MediaAssetTypeScheme, ifcore:OfferKindScheme, ifcore:PlatformLayerScheme,
        ifcore:PresentationFormScheme, ifcore:PrintDocumentTypeScheme, ifcore:ProductCategoryScheme,
        ifcore:ReaderSideScheme, ifcore:ReflectionKindScheme, ifcore:RegistrationKindScheme,
        ifcore:RelationFamilyScheme, ifcore:ResourceKindScheme, ifcore:RiskRatingScheme, ifcore:SpecStatusScheme,
        ifcore:VendorCriticalityScheme, ifcore:VerdictOutcomeScheme, ifcore:VerificationLevelScheme, ifcore:WebInteractionModelScheme,
        ifcore:WorkspaceFlavorScheme, ifweb:PublishingStrategyScheme ;
    ifcore:decidedBy ifcore:ShahidNehalShah ;
    ifcore:decidedAt "2026-10-09"^^xsd:date ;
    dcterms:description "These concept schemes and their concepts are ordinary words of the field they model, or names specific to the structure of the company, its works or its tools. No established term in a published vocabulary that works in their place was found, and where one was found it is tied instead (see ClarifiedAndMappedTermsAccepted). Each term was read against PROV-O, schema.org, DCMI Terms, the W3C Organization Ontology, ODRL, SKOS and the Data Cube vocabulary from knowledge of those vocabularies, and every equivalent found is tied in the ontology; the terms were not searched on the web one by one. Judged by an AI audit pass on the founder's instruction to make best judgements, and accepted by the founder's instruction of the same date; the weekly vocabulary audit re-checks a sample of the terms named here (spec 0019 FR-007). The concepts of these schemes inherit this Decision. Some schemes name tools of the repository itself (the command verbs, categories, surfaces and resource kinds, the check mechanisms) and have no published vocabulary; the platform capabilities carry the established terms as alternative labels."@en ;
    ifcore:consideredAlternative ifcore:PlainWordAltNearestStandard, ifcore:PlainWordAltRename ;
    ifcore:hasAudience ifcore:Public .

ifcore:PlainWordAltNearestStandard a ifcore:Alternative ; rdfs:label "Tie each term to the nearest standard class or property"@en ;
    ifcore:rejectionReason "A tie says the two terms mean the same. For these terms the nearest standard term means something else, and a false tie would hide the difference from the next audit."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:PlainWordAltRename a ifcore:Alternative ; rdfs:label "Rename each term to a different phrase"@en ;
    ifcore:rejectionReason "The plain word is the established word of the field. A different phrase would be the invented term that spec 0019 forbids."@en ;
    ifcore:hasAudience ifcore:Public .

# ───────────────────────── 1. Native Alpha and Acquired Alpha (0019 FR-004, FR-005, FR-011) ─────────────────────────
ifcore:NativeAlphaIsTheCompanysOwnTerm a ifcore:Decision ;
    rdfs:label "Native Alpha and Acquired Alpha are the company's own terms, not restated standard terms"@en ;
    dcterms:subject ifcore:NativeAlpha, ifcore:AcquiredAlpha ;
    ifcore:decidedBy ifcore:ShahidNehalShah ;
    ifcore:decidedAt "2026-10-09"^^xsd:date ;
    dcterms:description "Native Alpha originates as the founder's own authored research and thesis, independent of the company, with its own creative works and a filed trademark application (see the comment on ifcore:NativeAlpha). It is not a restatement of an established term: it requires an advantage native to a subject, carried by what the subject already has, and strong enough to change a real decision, and it separates the advantage that is native from the one the subject would have to acquire. Acquired Alpha is its counterpart for a buyer, and it counts only when the seller's evidence cost the seller something real and the buyer can check it without the seller's word. The word 'alpha' is borrowed from finance, where it means return above a benchmark; the company uses the borrowed word for an advantage above a credible benchmark, and the definitions say so. "@en ;
    ifcore:consideredAlternative ifcore:NativeAlphaAltCompetitiveAdvantage, ifcore:NativeAlphaAltCoreCompetency, ifcore:NativeAlphaAltFinanceAlpha ;
    ifcore:hasAudience ifcore:Public .
ifcore:NativeAlphaAltCompetitiveAdvantage a ifcore:Alternative ; rdfs:label "Use 'competitive advantage' (or 'sustainable competitive advantage')"@en ;
    ifcore:rejectionReason "'Competitive advantage' names any advantage over rivals. It does not say whether the advantage is native to the subject or must be acquired, and it carries no test that the advantage changes a real decision. Those two distinctions are what the definitions of Native Alpha and Acquired Alpha add."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:NativeAlphaAltCoreCompetency a ifcore:Alternative ; rdfs:label "Use 'core competency'"@en ;
    ifcore:rejectionReason "The scope note of Native Alpha rejects it as the unit of the claim: a core competency stated in general terms is where a search starts, not what it finds (0003-intellectual-frontiers FR-017)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:NativeAlphaAltFinanceAlpha a ifcore:Alternative ; rdfs:label "Use 'alpha' alone, in its finance meaning (return above a benchmark)"@en ;
    ifcore:rejectionReason "In finance, alpha is measured against a market benchmark. Native Alpha is claimed for a person, team, product, dataset or set of relationships and is traced to its source, and an unusual and disproportionate advantage is required. 'Native' is what separates it from the advantage that must be acquired."@en ;
    ifcore:hasAudience ifcore:Public .

# ───────────────────────── 2. IPLG (0019 FR-004, FR-010) ─────────────────────────
ifcore:IPLGBuildsOnProductLedGrowth a ifcore:Decision ;
    rdfs:label "IPLG is a subset and an elaboration of product-led growth, not a replacement"@en ;
    dcterms:subject ifcore:IPLG, ifcore:ProductLedGrowth ;
    ifcore:decidedBy ifcore:ShahidNehalShah ;
    ifcore:decidedAt "2026-10-09"^^xsd:date ;
    dcterms:description "Product-led growth is an established go-to-market term: the product itself drives acquisition, activation and retention. IPLG is not the same thing and does not replace it. An intellectual product (made by a person or by an AI) is atypical for product-led growth, so IPLG elaborates the established idea for that case. The word 'intellectual' is what the term adds, and it is the part that is the company's own. The ontology therefore declares ifcore:ProductLedGrowth for the established term and states ifcore:IPLG as its subclass, with the full name first and the acronym as an alternative label. Source for the established term: vendor and analyst pages only; no standard defines it, and its originator was not verified (see the audit report)."@en ;
    ifcore:consideredAlternative ifcore:IPLGAltPlainPLG, ifcore:IPLGAltFreeTrial ;
    ifcore:hasAudience ifcore:Public .
ifcore:IPLGAltPlainPLG a ifcore:Alternative ; rdfs:label "Use 'product-led growth' with no new term"@en ;
    ifcore:rejectionReason "The established term is understood for software products. An intellectual product, made by a person or by an AI, is atypical for it. It is kept as the parent, and IPLG is its subset and elaboration, not a replacement."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:IPLGAltFreeTrial a ifcore:Alternative ; rdfs:label "Use 'freemium' or 'free trial'"@en ;
    ifcore:rejectionReason "Those name a pricing offer. IPLG names the visitor's first useful action, which can occur with no account and no price."@en ;
    ifcore:hasAudience ifcore:Public .


ifcore:ClaimsAreNotNoemas a ifcore:Decision ;
    rdfs:label "A claim is a statement a Noema states, and a claim has no reflection of its own"@en ;
    dcterms:subject ifcore:States, ifcore:RuleClaim ;
    ifcore:decidedBy ifcore:ShahidNehalShah ;
    ifcore:decidedAt "2026-10-08"^^xsd:date ;
    dcterms:description "A Noema is the construct under study, with its meaning, assumptions, evidence and history. A claim is one sentence that says something is the case, and the same claim can be stated by several constructs and be a part of a legal instrument as a patent claim. Treating each claim as a Noema would give every sentence its own state and history and would put a patent claim, a legal text, in the same kind as the idea the patent describes. A Noema states claims, evidence bears on the Noema (and on a claim by naming it), and the record's own statements about the Noema are assertions, a third thing. The claim stays a schema:Claim of kind other."@en ;
    ifcore:consideredAlternative ifcore:ClaimsAltEachANoema ;
    ifcore:hasAudience ifcore:Public .
ifcore:ClaimsAltEachANoema a ifcore:Alternative ; rdfs:label "Make each proposition a Noema of its own"@en ;
    ifcore:rejectionReason "It multiplies records, separates a hypothesis from its wording, and cannot tell a patent claim from a research claim."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:EpistemicStateIsAssessed a ifcore:Decision ;
    rdfs:label "Epistemic state is a dated, reviewed assessment and not a field or a score"@en ;
    dcterms:subject ifcore:EpistemicAssessment, ifcore:EpistemicStateScheme, ifcore:assessedState, ifcore:ReviewStateScheme, ifcore:reviewState, ifcore:reviewedBy, ifcore:reviewedOn ;
    ifcore:decidedBy ifcore:ShahidNehalShah ;
    ifcore:decidedAt "2026-10-08"^^xsd:date ;
    dcterms:description "Whether an idea is supported, contested or falsified changes with the evidence and is a judgment someone makes. Held as a field on the record it would overwrite what was believed before and could not say who judged or why; held as one confidence number it would hide the evidence. So it is an assertion about the idea, dated, with its basis, and the current state is the latest accepted one. Review is kept apart from verification: verifying checks a statement against its source, and a hypothesis can never be verified, but a person can accept it as a hypothesis worth keeping. That is the line between what an AI proposes and what the company holds, and it is the same line for every assertion and record, so it lives at the shared layer. Epistemic state is also kept apart from publication, editorial and operational lifecycle, which describe the work and not the idea."@en ;
    ifcore:consideredAlternative ifcore:EpistemicAltField ;
    ifcore:hasAudience ifcore:Public .
ifcore:EpistemicAltField a ifcore:Alternative ; rdfs:label "A status field on the Noema record, or one confidence score"@en ;
    ifcore:rejectionReason "A field overwrites history, names no judge and no basis, and invites reuse of a publication stage. A score hides which evidence it summarizes."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:NoemaSubtypesAreConcepts a ifcore:Decision ;
    rdfs:label "Noema subtypes and the parts of an idea are concepts of open schemes"@en ;
    dcterms:subject ifcore:NoemaTypeScheme, ifcore:AspectScheme, ifcore:aspect, ifcore:demonstratedBy ;
    ifcore:decidedBy ifcore:ShahidNehalShah ;
    ifcore:decidedAt "2026-10-08"^^xsd:date ;
    dcterms:description "A framework contains hypotheses and a methodology, and one idea can be a theory and a framework at once, so a subtype that is a class would force a single answer and a new subtype would be a schema change. A concept of a scheme, carried by dcterms:type, follows the pattern the ontology already uses for kinds of design system and criticality of vendor, allows overlap, and is added without touching the model. The assumptions, predictions, falsification criteria, limits and commercial parts of an idea are likewise assertions with an aspect, so each inherits a label, a source and a review state. Demand evidence names the Eidolons it comes from, because novelty and citations are not demand."@en ;
    ifcore:hasAudience ifcore:Public .
# ───────────────────────── The method (0003-intellectual-frontiers FR-007, FR-008) ─────────────────────────

ifcore:MethodStage a owl:Class ; rdfs:label "Method stage"@en ;
    rdfs:comment "One step in the ordered sequence an opportunity moves through before it is treated as proven."@en .
ifcore:sequenceOrder a owl:DatatypeProperty ; rdfs:domain ifcore:MethodStage ; rdfs:range xsd:integer .

ifcore:Grant a owl:Class ; skos:broadMatch odrl:Permission ; rdfs:subClassOf ifcore:Fact ; rdfs:label "Grant"@en ;
    rdfs:comment "An explicit, time-bounded link between an identified agent and a specific audience (0005-authentication FR-003). Actual Grant individuals are rarely Public; they are expected to live in the private vault, declaring whatever audience is appropriate to their own sensitivity."@en .
ifcore:grantedTo a owl:ObjectProperty ; rdfs:subPropertyOf odrl:assignee ; rdfs:domain ifcore:Grant ; rdfs:range ifcore:Person .
ifcore:grantsAudience a owl:ObjectProperty ; rdfs:domain ifcore:Grant ; rdfs:range ifcore:AccessAudience .
ifcore:validFrom a owl:DatatypeProperty ; rdfs:subPropertyOf schema:validFrom ; rdfs:domain ifcore:Grant ; rdfs:range xsd:date ;
    rdfs:comment "Required. A grant with no start date is not valid (0005 FR-003)."@en .
ifcore:validUntil a owl:DatatypeProperty ; rdfs:subPropertyOf schema:validThrough ; rdfs:domain ifcore:Grant ; rdfs:range xsd:date ;
    rdfs:comment "Optional. Absent means open-ended; present means the grant stops counting after this date (0005 FR-004)."@en .

# ───────────────────────── Work and assets (0007-work-and-assets) ─────────────────────────

ifcore:Asset a owl:Class ; rdfs:label "Asset"@en ;
    rdfs:comment "An item, thing, or entity that has potential or actual value to the organization (ISO 55000's definition)."@en .
ifcore:TangibleAsset a owl:Class ; rdfs:subClassOf ifcore:Asset ; rdfs:label "Tangible asset"@en .
ifcore:IntangibleAsset a owl:Class ; rdfs:subClassOf ifcore:Asset ; rdfs:label "Intangible asset"@en .
ifcore:FinancialAsset a owl:Class ; rdfs:subClassOf ifcore:Asset ; rdfs:label "Financial asset"@en ;
    rdfs:comment "Investments, securities, and similar holdings. Left unpopulated; Capital's own future spec establishes what belongs here."@en .

ifcore:RealProperty a owl:Class ; rdfs:subClassOf ifcore:TangibleAsset ; rdfs:label "Real property"@en .
ifcore:Equipment a owl:Class ; rdfs:subClassOf ifcore:TangibleAsset ; rdfs:label "Equipment"@en .

ifcore:IntellectualProperty a owl:Class ; rdfs:subClassOf ifcore:IntangibleAsset ; rdfs:label "Intellectual property"@en .
ifcore:DigitalAsset a owl:Class ; rdfs:subClassOf ifcore:IntangibleAsset ; rdfs:label "Digital asset"@en ;
    rdfs:comment "A distinct, separately-valuable digital property — a web property, a distinct software product, a distinct dataset. Not created for an individual page or file within a larger property (0007 FR-007). The domain names it is deployed at are ifcore:DomainName individuals, not this asset (0022-domain-names FR-001); its dcterms:created is when the company began the property, not when a domain was registered (0022 FR-007)."@en .
ifcore:Goodwill a owl:Class ; rdfs:subClassOf ifcore:IntangibleAsset ; rdfs:label "Goodwill"@en .

# ───────────────────────── Substantial works (0007-work-and-assets FR-017 – FR-021) ─────────────────────────

ifcore:SubstantialWork a owl:Class ; rdfs:label "Substantial work"@en ;
    rdfs:comment "A work whose multi-stage production and distribution lifecycle is actually tracked — a peer-reviewed paper, a book, a not-yet-filed patent, or production-bound software are the standing examples, not an exhaustive list (FR-017). Multi-typed onto whatever the work already is (a Note, a schema:Book, a piece of software) rather than replacing that typing. A work or a presentation may be one: each that is produced through stages carries its own (0021-works-and-presentations FR-022). A package's individual is the work, unless a separate record of the work exists, in which case it is a presentation of that work (FR-019); a form-specific type such as schema:Book is carried until its presentations are populated as ifcore:Presentation individuals."@en .

ifcore:lifecycleOwner a owl:ObjectProperty ; rdfs:domain ifcore:SubstantialWork ; rdfs:range ifcore:Unit ;
    rdfs:comment "The one unit accountable for a Substantial Work's progress (FR-021). Defaults to Research & IP while disposition is unsure, Press otherwise; any unit may claim it explicitly, overriding the default."@en .
ifcore:WorkKind a owl:Class ; rdfs:label "Work kind"@en ;
    rdfs:comment "A family of works that share a source format and a set of rules; names the <kind> segment of a work package's path (0015-work-packages FR-004, FR-005). An individual MUST be declared before any work package of that kind exists. It names the work's primary presentation form, not the work itself (0021-works-and-presentations FR-019)."@en .
ifcore:BookKind a ifcore:WorkKind ; rdfs:label "Book"@en ; dcterms:identifier "book" ;
    rdfs:comment "A book: AsciiDoc manuscript, jacket data, figures, and a book bible (0016-press-production FR-004)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:BookSeriesKind a ifcore:WorkKind ; rdfs:label "Book series"@en ; dcterms:identifier "book-series" ;
    rdfs:comment "A serial series: a series bible and volume map, no manuscript; each volume is its own book work (0016-press-production FR-008)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:SkillKind a ifcore:WorkKind ; rdfs:label "Skill"@en ; dcterms:identifier "skill" ;
    rdfs:comment "A skill carrying a book's or record's method for a reader's own AI (0016-press-production FR-040)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:WebsiteKind a ifcore:WorkKind ; rdfs:label "Website"@en ; dcterms:identifier "website" ;
    rdfs:comment "The written public-facing content of a web property; text lives as content documents (0016-press-production FR-042). The editorial record of a channel's own copy, not a work, until that copy is represented as presentations of works and of the firm (0021-works-and-presentations FR-011, FR-021)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:SpokenKind a ifcore:WorkKind ; rdfs:label "Spoken work"@en ; dcterms:identifier "spoken" ;
    rdfs:comment "A spoken-first work whose source is an AsciiDoc script (0017-spoken-and-research-works FR-001, FR-004)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:ResearchKind a ifcore:WorkKind ; rdfs:label "Research record"@en ; dcterms:identifier "research" ;
    rdfs:comment "An area, pillar, note, paper, publication, disclosure, trademark record, or patent draft (0017-spoken-and-research-works FR-017)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:CourseKind a ifcore:WorkKind ; rdfs:label "Course"@en ; dcterms:identifier "course" ;
    rdfs:comment "A subject taught at length, over weeks, with outcomes, lessons and assessments; its source is AsciiDoc in frontiers-course's form (0027-course-works FR-001, FR-002)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:ElenchusKind a ifcore:WorkKind ; rdfs:label "Elenchus"@en ; dcterms:identifier "elenchus" ;
    rdfs:comment "A monthly trial in which every control in every compliance boundary's baseline is charged with not operating and tried by a probe that tries to refute the charge; its source is AsciiDoc findings and its Verdict is generated (0045-elenchus-works FR-001, FR-024)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:workLifecycleStage a owl:ObjectProperty ; rdfs:domain ifcore:SubstantialWork ; rdfs:range ifcore:WorkLifecycleStage ;
    rdfs:comment "The stage a Substantial Work currently occupies."@en .

ifcore:WorkLifecycleStage a owl:Class ; rdfs:label "Work lifecycle stage"@en ;
    rdfs:comment "One stage in a Substantial Work's ordered progress (FR-018). Reuses ifcore:sequenceOrder, already declared for ifcore:MethodStage and its siblings, rather than redeclaring it."@en .
ifcore:Intake a ifcore:WorkLifecycleStage ; rdfs:label "Intake"@en ; ifcore:sequenceOrder 1 ; ifcore:hasAudience ifcore:Public .
ifcore:Research a ifcore:WorkLifecycleStage ; rdfs:label "Research"@en ; ifcore:sequenceOrder 2 ;
    rdfs:comment "A stage a Substantial Work occupies — distinct from ifcore:ResearchAndIp (the unit) and ifcore:ResearchArea/ResearchPillar (the research chain's own structure), which this individual does not replace or alias."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:Review a ifcore:WorkLifecycleStage ; rdfs:label "Review"@en ; ifcore:sequenceOrder 3 ; ifcore:hasAudience ifcore:Public .
ifcore:Prep a ifcore:WorkLifecycleStage ; rdfs:label "Prep"@en ; ifcore:sequenceOrder 4 ; ifcore:hasAudience ifcore:Public .
ifcore:Deploy a ifcore:WorkLifecycleStage ; rdfs:label "Deploy"@en ; ifcore:sequenceOrder 5 ;
    rdfs:comment "For a patent, this is the filing moment — the point past which the registry becomes the canonical authority for status, per FR-020 and FR-012."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:Distribute a ifcore:WorkLifecycleStage ; rdfs:label "Distribute"@en ; ifcore:sequenceOrder 6 ; ifcore:hasAudience ifcore:Public .
ifcore:Commercialize a ifcore:WorkLifecycleStage ; rdfs:label "Commercialize"@en ; ifcore:sequenceOrder 7 ;
    rdfs:comment "Decomposes into its own substages (ifcore:CommercializationSubstage) rather than resolving as a single gate, per FR-019."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:CommercializationSubstage a owl:Class ; rdfs:label "Commercialization substage"@en ;
    rdfs:comment "One concurrent decision inside the Commercialize stage (FR-019). Unlike a top-level ifcore:WorkLifecycleStage, these are not strictly sequential gates — pricing and licensing commonly proceed together, and revenue operations is ongoing rather than a one-time step."@en .
ifcore:Pricing a ifcore:CommercializationSubstage ; rdfs:label "Pricing"@en ; dcterms:isPartOf ifcore:Commercialize ; ifcore:sequenceOrder 1 ; ifcore:hasAudience ifcore:Public .
ifcore:Licensing a ifcore:CommercializationSubstage ; rdfs:label "Licensing"@en ; dcterms:isPartOf ifcore:Commercialize ; ifcore:sequenceOrder 2 ;
    rdfs:comment "Where a specific ifcore:License individual (0006-research-and-ip) is negotiated — this substage is the activity, License is its resulting record."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:GoToMarket a ifcore:CommercializationSubstage ; rdfs:label "Go-to-market"@en ; dcterms:isPartOf ifcore:Commercialize ; ifcore:sequenceOrder 3 ; ifcore:hasAudience ifcore:Public .
ifcore:RevenueOperations a ifcore:CommercializationSubstage ; rdfs:label "Revenue operations"@en ; dcterms:isPartOf ifcore:Commercialize ; ifcore:sequenceOrder 4 ;
    rdfs:comment "Ongoing once reached, not a one-time gate — renewals, collections, and revenue recognition continue for as long as the work is commercialized."@en ;
    ifcore:hasAudience ifcore:Public .

# Existing individuals retyped as Substantial Work, now that the class exists.
# Declared here rather than editing each individual's own declaration, to
# keep this addition's diff self-contained.
ifcore:ChasingNativeAlpha a ifcore:SubstantialWork ;
    ifcore:workLifecycleStage ifcore:Commercialize ;
    ifcore:lifecycleOwner ifcore:Press .
ifcore:DemandEngineering a ifcore:SubstantialWork, schema:SoftwareApplication ;
    ifcore:workLifecycleStage ifcore:Commercialize ;
    ifcore:lifecycleOwner ifcore:Studios .
ifcore:RevenueEngineering a ifcore:SubstantialWork, schema:SoftwareApplication ;
    ifcore:workLifecycleStage ifcore:Commercialize ;
    ifcore:lifecycleOwner ifcore:Studios .
ifcore:CompanionExecutableSourceCodeRepositories a ifcore:SubstantialWork, schema:SoftwareSourceCode ;
    ifcore:workLifecycleStage ifcore:Intake ;
    ifcore:lifecycleOwner ifcore:Studios ;
    rdfs:comment "At the ideation stage per its own operationalStatus — squarely Intake, not yet Research, since the shared service itself has not begun being built."@en .

# ───────────────────────── Research & IP (0006-research-and-ip) ─────────────────────────

ifcore:ResearchArea a owl:Class ; rdfs:subClassOf ifcore:Fact ; rdfs:label "Research area"@en ;
    rdfs:comment "Groups related work; the top of the research chain (0006 FR-001)."@en .
ifcore:ResearchPillar a owl:Class ; rdfs:subClassOf ifcore:Fact ; rdfs:label "Research pillar"@en ;
    rdfs:comment "A standing line of inquiry under a research area, carrying its own question (0006 FR-002). Related to its area by dcterms:isPartOf, not a custom property. An individual pillar MAY additionally be typed prov:Plan where that fits (0007-work-and-assets FR-001); a bounded piece of work under it is a prov:Activity, related to the pillar the same way, by dcterms:isPartOf."@en .

ifcore:AiNativeSystemsArea a ifcore:ResearchArea ;
    rdfs:label "AI-Native Systems for the Firm"@en ;
    rdfs:comment "The firm's own operating model and public presence as research subjects in their own right, not only as business infrastructure."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:EidolonPillar a ifcore:ResearchPillar, prov:Plan ;
    rdfs:label "Eidolons"@en ;
    dcterms:isPartOf ifcore:AiNativeSystemsArea ;
    schema:about ifcore:Eidolon ;
    ifcore:question "How much of a company, person, or system can an AI reason about accurately from a grounded digital representation, and what does that representation need to contain?"@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:IplgPillar a ifcore:ResearchPillar, prov:Plan ;
    rdfs:label "Intellectual Product-Led Growth"@en ;
    dcterms:isPartOf ifcore:AiNativeSystemsArea ;
    schema:about ifcore:IPLG ;
    ifcore:question "How does a knowledge-heavy organization turn its research, frameworks, and expertise into something a visitor can use directly, before any commercial ask?"@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:NoteType a owl:Class ; rdfs:label "Note type"@en .
ifcore:DesignPattern a ifcore:NoteType ; rdfs:label "Design pattern"@en ; ifcore:hasAudience ifcore:Public .
ifcore:OperatingTheory a ifcore:NoteType ; rdfs:label "Operating theory"@en ; ifcore:hasAudience ifcore:Public .
ifcore:Note a owl:Class ; rdfs:subClassOf ifcore:Fact, prov:Entity ; rdfs:label "Note or paper"@en ;
    rdfs:comment "Where a finding is recorded (0006 FR-003), and the entity a research activity generates via prov:wasGeneratedBy (0007-work-and-assets FR-002). A peer-reviewed paper additionally carries a DOI (FR-004)."@en .
ifcore:LandscapeReview a owl:Class ; rdfs:subClassOf ifcore:Note ; rdfs:label "Landscape review"@en ;
    rdfs:comment "A research record that shows how an organization is likely to fare against others on a complex task, by letting the reader place their own numbers against a peer spread (0017-spoken-and-research-works FR-017). A kind of note, so a check can find it by type."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:noteType a owl:ObjectProperty ; rdfs:domain ifcore:Note ; rdfs:range ifcore:NoteType .
ifcore:doi a owl:DatatypeProperty ; rdfs:subPropertyOf schema:identifier ; skos:closeMatch bibo:doi ; rdfs:domain ifcore:Note ; rdfs:range xsd:string .

ifcore:Disposition a owl:Class ; rdfs:label "Disposition"@en ;
    rdfs:comment "The explicit outcome a protectable finding receives (0006 FR-005)."@en .
ifcore:DispositionPatent a ifcore:Disposition ; rdfs:label "Patent"@en ; ifcore:hasAudience ifcore:Public .
ifcore:DispositionDefensiveDisclosure a ifcore:Disposition ; rdfs:label "Defensive disclosure"@en ; ifcore:hasAudience ifcore:Public .
ifcore:DispositionTradeSecret a ifcore:Disposition ; rdfs:label "Trade secret"@en ; ifcore:hasAudience ifcore:Public .
ifcore:DispositionNoAction a ifcore:Disposition ; rdfs:label "No action"@en ; ifcore:hasAudience ifcore:Public .
ifcore:hasDisposition a owl:ObjectProperty ; rdfs:domain ifcore:Note ; rdfs:range ifcore:Disposition .

ifcore:Right a owl:Class ; skos:closeMatch dcterms:RightsStatement ; rdfs:subClassOf ifcore:IntellectualProperty, prov:Entity ; rdfs:label "Right"@en ;
    rdfs:comment "A kind of protection a finding's disposition can produce; a kind of intellectual property (0007-work-and-assets FR-007) and a thing with provenance (0007 FR-002)."@en .
ifcore:PatentFamily a owl:Class ; rdfs:subClassOf ifcore:Right, ifcore:Fact ; rdfs:label "Patent family"@en .
ifcore:DefensiveDisclosure a owl:Class ; rdfs:subClassOf ifcore:Right, ifcore:Fact ; rdfs:label "Defensive disclosure"@en .
ifcore:Trademark a owl:Class ; rdfs:subClassOf ifcore:Right, ifcore:Fact ; rdfs:label "Trademark"@en .
ifcore:TradeSecret a owl:Class ; rdfs:subClassOf ifcore:Right, ifcore:Fact ; rdfs:label "Trade secret"@en ;
    rdfs:comment "Its substantive content is sensitive by default (0007 FR-010) — see ifcore:RestrictedDataReference."@en .
ifcore:Copyright a owl:Class ; rdfs:subClassOf ifcore:Right, ifcore:Fact ; rdfs:label "Copyright"@en ;
    rdfs:comment "A copyrightable expression significant enough to track (0007-work-and-assets FR-013) — distinct from any trademark protecting a name used in connection with it."@en .
ifcore:License a owl:Class ; skos:closeMatch dcterms:LicenseDocument ; rdfs:subClassOf ifcore:Fact ; rdfs:label "License"@en ;
    rdfs:comment "What a counterparty can take on a right this unit holds."@en .
ifcore:licenses a owl:ObjectProperty ; rdfs:domain ifcore:License ; rdfs:range ifcore:Right .

# dcterms:creator and dcterms:rightsHolder (reused, not redeclared) carry a Right's
# attribution: creator MAY be a specific named person; rightsHolder defaults to
# Intellectual Frontiers LLC absent a stated agreement otherwise (0007 FR-014).

ifcore:continuationOf a owl:ObjectProperty ; rdfs:domain ifcore:PatentFamily ; rdfs:range ifcore:PatentFamily ;
    rdfs:comment "Shares the parent's specification and priority date; new claims (0007-work-and-assets FR-011)."@en .
ifcore:divisionalOf a owl:ObjectProperty ; rdfs:domain ifcore:PatentFamily ; rdfs:range ifcore:PatentFamily ;
    rdfs:comment "Claims split out from a parent application that covered more than one invention (0007 FR-011)."@en .
ifcore:continuationInPartOf a owl:ObjectProperty ; rdfs:domain ifcore:PatentFamily ; rdfs:range ifcore:PatentFamily ;
    rdfs:comment "Adds new matter to a parent application; partial priority (0007 FR-011)."@en .

ifcore:WorkDomain a owl:Class ; rdfs:label "Work domain"@en ;
    rdfs:comment "A grouping of the patent portfolio by subject matter."@en .
ifcore:MarketplacesAndPayments a ifcore:WorkDomain ; rdfs:label "Marketplaces and payments"@en ;
    rdfs:comment "Computer-controlled marketplace networks, digital payments, and related continuations."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:EvidenceAndDecisions a ifcore:WorkDomain ; rdfs:label "Evidence and decisions"@en ;
    rdfs:comment "Traceable metric queues, task scheduling, service-delivery evidence, initiative tracking, document review, case response, decision lifecycles, and risk systems."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:HealthcareDelivery a ifcore:WorkDomain ; rdfs:label "Healthcare delivery"@en ;
    rdfs:comment "Medical-device control, patient navigation, longitudinal profiles, team-based tele-diagnostics, smart referrals, and digital-native trials."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:TrustedDataAndAuthorization a ifcore:WorkDomain ; rdfs:label "Trusted data and authorization"@en ;
    rdfs:comment "Self-controlled digital authorization, device-driven blockchain integrity, blockchain natural-language processing, and multi-source data integration."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:LearningAndContent a ifcore:WorkDomain ; rdfs:label "Learning and content"@en ;
    rdfs:comment "Precision education and training, rating aggregation, and rewardable content delivery."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:inWorkDomain a owl:ObjectProperty ; rdfs:domain ifcore:PatentFamily ; rdfs:range ifcore:WorkDomain .

ifcore:USPatent10643208 a ifcore:PatentFamily ;
    rdfs:label "Digital payment system (US10643208B2)"@en ;
    dcterms:creator ifcore:ShahidNehalShah ;
    dcterms:rightsHolder ifcore:IntellectualFrontiersLLC ;
    ifcore:inWorkDomain ifcore:MarketplacesAndPayments ;
    rdfs:comment "Covers pre-consent capture, data-valuation logic, and a payment engine offsetting a service charge against computed data value, over banking or blockchain rails. Originally assigned to Netspective Communications LLC, reassigned to Intellectual Frontiers LLC in 2023 — consistent with the company-wide 2023 Netspective patent acquisition already in context/company.md."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:USPatent10643208StatusReference a ifcore:ExternalRecordReference ;
    ifcore:describes ifcore:USPatent10643208 ;
    ifcore:primarySource "https://patents.google.com/patent/US10643208B2"^^xsd:anyURI ;
    ifcore:cachedValue "Granted May 5, 2020; filed February 24, 2019."@en ;
    ifcore:resolvedAt "2026-10-02"^^xsd:date ;
    ifcore:verificationCadence "P1Y"^^xsd:duration ;
    ifcore:verificationMethod "manual"@en ;
    rdfs:comment "Expiration date deliberately not cached: sources disagree on the related continuation's expiration (see USPatent11568401StatusReference) and neither figure for either patent has been checked directly against USPTO Patent Center."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:USPatent11568401 a ifcore:PatentFamily ;
    rdfs:label "Digital payment system (US11568401B2)"@en ;
    ifcore:continuationOf ifcore:USPatent10643208 ;
    dcterms:creator ifcore:ShahidNehalShah ;
    dcterms:rightsHolder ifcore:IntellectualFrontiersLLC ;
    ifcore:inWorkDomain ifcore:MarketplacesAndPayments ;
    rdfs:comment "Continuation of US10643208B2: adds a cloud-based central controller, a dedicated buyer subsystem, third-party payer integration, and ETL processing for standardizing health data from diverse sources."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:USPatent11568401StatusReference a ifcore:ExternalRecordReference ;
    ifcore:describes ifcore:USPatent11568401 ;
    ifcore:primarySource "https://patents.google.com/patent/US11568401B2"^^xsd:anyURI ;
    ifcore:cachedValue "Granted January 31, 2023; filed March 30, 2020; priority date February 24, 2019."@en ;
    ifcore:resolvedAt "2026-10-02"^^xsd:date ;
    ifcore:verificationCadence "P1Y"^^xsd:duration ;
    ifcore:verificationMethod "manual"@en ;
    rdfs:comment "Expiration date deliberately not cached: the source site states November 2040, an independent search states March 16, 2040 — these disagree and neither has been checked directly against USPTO Patent Center. Resolve via an authoritative lookup before asserting either, per 0007-work-and-assets FR-012."@en ;
    ifcore:hasAudience ifcore:Public .

# ───────────────────────── Capital (0010-capital) ─────────────────────────

ifcore:Fund a owl:Class ; rdfs:subClassOf ifcore:Organization ; rdfs:label "Fund"@en ;
    rdfs:comment "A distinct investment vehicle with its own thesis and qualifying condition. An Organization, not an Asset itself — it holds assets, it is not one (0010-capital)."@en .
ifcore:thesis a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "The thesis a fund, or any other individual that has one, runs on."@en .
ifcore:qualifyingCondition a owl:DatatypeProperty ; rdfs:domain ifcore:Fund ; rdfs:range xsd:string ;
    rdfs:comment "A binary condition a company must meet to be funded under this vehicle, not a factor weighed against others (0010 FR-013)."@en .

ifcore:FundMode a owl:Class ; rdfs:label "Fund mode"@en .
ifcore:InvestMode a ifcore:FundMode ; rdfs:label "Invest"@en ; ifcore:hasAudience ifcore:Public .
ifcore:TakeSelectiveControlMode a ifcore:FundMode ; rdfs:label "Take selective control"@en ; ifcore:hasAudience ifcore:Public .
ifcore:BuildMode a ifcore:FundMode ; rdfs:label "Build"@en ; ifcore:hasAudience ifcore:Public .
ifcore:hasMode a owl:ObjectProperty ; rdfs:domain ifcore:Fund ; rdfs:range ifcore:FundMode .

ifcore:OwnershipMode a owl:Class ; rdfs:label "Ownership mode"@en ;
    rdfs:comment "Chosen on the merits for a given company, not a fixed exit schedule (0010 FR-016)."@en .
ifcore:CreateMode a ifcore:OwnershipMode ; rdfs:label "Create"@en ; ifcore:hasAudience ifcore:Public .
ifcore:AcquireAndGrowMode a ifcore:OwnershipMode ; rdfs:label "Acquire and grow"@en ; ifcore:hasAudience ifcore:Public .
ifcore:OwnLongTermMode a ifcore:OwnershipMode ; rdfs:label "Own for the long term"@en ; ifcore:hasAudience ifcore:Public .
ifcore:SellOrSpinOutMode a ifcore:OwnershipMode ; rdfs:label "Sell or spin out"@en ; ifcore:hasAudience ifcore:Public .

ifcore:CareDeliveryFundI a ifcore:Fund ;
    rdfs:label "Care Delivery Fund I"@en ;
    ifcore:thesis "Holds a portfolio of ventures and shared services built to stand alone, to prove that these reimagined pieces work together. Carrying a company further than that is Fund II's job, not Fund I's."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:CareDeliveryFundII a ifcore:Fund ;
    rdfs:label "Care Delivery Fund II"@en ;
    rdfs:comment "In formation. Its build-mode clock is 90 to 180 days: design partners approached in the first 60, the first clinical workflow live by 120, first revenue in sight by 180, with a clinician CEO paired in rather than recruited afterward."@en ;
    ifcore:thesis "Backs clinician-led care-delivery companies that own their reimagined care model, not vendors selling a tool into someone else's model."@en ;
    ifcore:qualifyingCondition "Contributes to a better end-to-end patient and caregiver experience."@en ;
    ifcore:hasMode ifcore:InvestMode, ifcore:TakeSelectiveControlMode, ifcore:BuildMode ;
    ifcore:hasAudience ifcore:Public .

ifcore:Capital ifcore:operates ifcore:CareDeliveryFundI, ifcore:CareDeliveryFundII .

ifcore:CapitalSource a owl:Class ; rdfs:label "Capital source"@en ;
    rdfs:comment "Where a dollar Capital deploys traces back to (0010 FR-012)."@en .
ifcore:BalanceSheet a ifcore:CapitalSource ; rdfs:label "The firm's own balance sheet"@en ; ifcore:hasAudience ifcore:Public .
ifcore:NetworkSourcedCapital a ifcore:CapitalSource ; rdfs:label "An LP or investor brought in through IF Network"@en ; ifcore:hasAudience ifcore:Public .

ifcore:SinbadCapital a ifcore:Organization ;
    rdfs:label "Sinbad Capital"@en ;
    rdfs:comment "An independent early fund and operating partner. Intellectual Frontiers Capital has no allocation or LP authority over it (0010-capital FR-010)."@en ;
    ifcore:hasAudience ifcore:Public .

# ───────────────────────── Press (0009-press) ─────────────────────────

ifcore:ClaimKind a owl:Class ; rdfs:label "Claim kind"@en ;
    rdfs:comment "The epistemic status a published claim carries (0009-press FR-001)."@en .
ifcore:ObservableFact a ifcore:ClaimKind ; rdfs:label "Observable fact"@en ; ifcore:hasAudience ifcore:Public .
ifcore:Opinion a ifcore:ClaimKind ; rdfs:label "Opinion"@en ; ifcore:hasAudience ifcore:Public .
ifcore:Framework a ifcore:ClaimKind ; rdfs:label "Framework"@en ; ifcore:hasAudience ifcore:Public .
ifcore:Illustration a ifcore:ClaimKind ; rdfs:label "Illustration"@en ; ifcore:hasAudience ifcore:Public .
ifcore:claimKind a owl:ObjectProperty ; rdfs:range ifcore:ClaimKind ;
    rdfs:comment "What kind of claim a published fact or creative work is making."@en .

ifcore:ClaimLabel a owl:Class ; rdfs:label "Claim label"@en ;
    rdfs:comment "How settled one research claim is: one of six, a closed set (0017-spoken-and-research-works FR-021). Distinct from ifcore:ClaimKind, which says what sort of claim any Press output makes (0009-press FR-001); a section may carry one of each."@en .
ifcore:ObservationLabel a ifcore:ClaimLabel ; rdfs:label "observation"@en ; ifcore:hasAudience ifcore:Public .
ifcore:HypothesisLabel a ifcore:ClaimLabel ; rdfs:label "hypothesis"@en ; ifcore:hasAudience ifcore:Public .
ifcore:EvidenceLabel a ifcore:ClaimLabel ; rdfs:label "evidence"@en ; ifcore:hasAudience ifcore:Public .
ifcore:InferenceLabel a ifcore:ClaimLabel ; rdfs:label "inference"@en ; ifcore:hasAudience ifcore:Public .
ifcore:RecommendationLabel a ifcore:ClaimLabel ; rdfs:label "recommendation"@en ; ifcore:hasAudience ifcore:Public .
ifcore:UnknownLabel a ifcore:ClaimLabel ; rdfs:label "unknown"@en ; ifcore:hasAudience ifcore:Public .
ifcore:claimLabel a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:range ifcore:ClaimLabel ;
    rdfs:comment "The one label a research claim carries (0017-spoken-and-research-works FR-021); functional, so a claim carries at most one."@en .

ifcore:VoicePrinciple a owl:Class ; rdfs:label "Voice principle"@en .
ifcore:EvidenceLed a ifcore:VoicePrinciple ; rdfs:label "Evidence-led"@en ; ifcore:hasAudience ifcore:Public .
ifcore:Practical a ifcore:VoicePrinciple ; rdfs:label "Practical"@en ; ifcore:hasAudience ifcore:Public .
ifcore:Skeptical a ifcore:VoicePrinciple ; rdfs:label "Skeptical"@en ; ifcore:hasAudience ifcore:Public .
ifcore:Plain a ifcore:VoicePrinciple ; rdfs:label "Plain"@en ; ifcore:hasAudience ifcore:Public .

ifcore:EvidenceLadderStage a owl:Class ; rdfs:label "Evidence ladder stage"@en ;
    rdfs:comment "A publication's reception, read as evidence about its thesis, in ascending order of strength (0009-press FR-014)."@en .
ifcore:Silence a ifcore:EvidenceLadderStage ; rdfs:label "Silence"@en ; ifcore:sequenceOrder 1 ; ifcore:hasAudience ifcore:Public .
ifcore:Argument a ifcore:EvidenceLadderStage ; rdfs:label "Argument"@en ; ifcore:sequenceOrder 2 ; ifcore:hasAudience ifcore:Public .
ifcore:AdoptionOfTerminology a ifcore:EvidenceLadderStage ; rdfs:label "Adoption of terminology"@en ; ifcore:sequenceOrder 3 ; ifcore:hasAudience ifcore:Public .
ifcore:WillingnessToPay a ifcore:EvidenceLadderStage ; rdfs:label "Willingness to pay"@en ; ifcore:sequenceOrder 4 ; ifcore:hasAudience ifcore:Public .

ifcore:PressLevel a owl:Class ; rdfs:label "Press level"@en ;
    rdfs:comment "One of five scopes a piece can be written at (0009-press FR-007)."@en .
ifcore:covers a owl:DatatypeProperty ; rdfs:domain ifcore:PressLevel ; rdfs:range xsd:string .
ifcore:TheFirmLevel a ifcore:PressLevel ; rdfs:label "Intellectual Frontiers"@en ;
    ifcore:covers "Why the firm exists, how Native Alpha governs decisions, and what the record supports."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:BusinessUnitLevel a ifcore:PressLevel ; rdfs:label "Business units"@en ;
    ifcore:covers "What each unit does, and where their boundaries remain."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:StudiosCompanyLevel a ifcore:PressLevel ; rdfs:label "Studios companies"@en ;
    ifcore:covers "Market thesis, customer evidence, category language, Native Alpha, and a company-owned voice."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:CapitalCompanyLevel a ifcore:PressLevel ; rdfs:label "IF Capital companies"@en ;
    ifcore:covers "Optional help with research, launches, education, and direct channels without editorial control."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:NetworkLevel a ifcore:PressLevel ; rdfs:label "IF Network"@en ;
    ifcore:covers "What the search found and what the evidence supports, written so a hiring decision can rest on it."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:FounderWritingType a owl:Class ; rdfs:label "Founder writing type"@en .
ifcore:ContrarianBrief a ifcore:FounderWritingType ; rdfs:label "Contrarian Brief"@en ; ifcore:hasAudience ifcore:Public .
ifcore:DesignPatternWriting a ifcore:FounderWritingType ; rdfs:label "Design Pattern"@en ; ifcore:hasAudience ifcore:Public .
ifcore:WorkingTheory a ifcore:FounderWritingType ; rdfs:label "Working Theory"@en ; ifcore:hasAudience ifcore:Public .
ifcore:PractitionerJournalist a ifcore:FounderWritingType ; rdfs:label "Practitioner Journalist"@en ; ifcore:hasAudience ifcore:Public .

ifcore:AIWorkforce a owl:Class ; rdfs:label "AI Workforce"@en ;
    skos:definition "A SpecKit that states intent, a harness that carries it out, agents that hold a role, skills that do one job, and MCPs that connect them to a reader's own tools and data — what a Fieldbook teaches a reader to build (0009-press FR-016, FR-018)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:LaborAsCode a owl:Class ; rdfs:label "Labor as Code"@en ;
    skos:definition "A skill that carries a person's knowledge, judgment, taste, and skill in durable, inspectable, versioned form — what a reader's own work, once named and made durable, is ready to become (0009-press FR-018)."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:ChasingNativeAlphaBook schema:publisher ifcore:Press .

# ───────────────────────── The imprint and its list (0009-press FR-038 – FR-046) ─────────────────────────

ifcore:Imprint a owl:Class ; rdfs:subClassOf schema:Brand ; rdfs:label "Imprint"@en ;
    rdfs:comment "The name under which a unit publishes its books, with one readership, a slogan, and a thesis (0009-press FR-038). Its schema:name is its official name, the only one a public surface uses; skos:hiddenLabel holds an internal short name."@en .
ifcore:imprintOf a owl:ObjectProperty ; rdfs:domain ifcore:Imprint ; rdfs:range ifcore:Unit .
ifcore:imprintThesis a owl:ObjectProperty ; rdfs:domain ifcore:Imprint ; rdfs:range schema:Claim ;
    rdfs:comment "The argument the imprint's list is built on, a claim labeled by kind (0009-press FR-039)."@en .
ifcore:Readership a owl:Class ; rdfs:subClassOf schema:Audience ; rdfs:label "Readership"@en ;
    rdfs:comment "The readers an imprint publishes for, related to it by schema:audience. Distinct from ifcore:AccessAudience, which says who may see a fact, not whom a work is written for."@en .

ifcore:IFPress a ifcore:Imprint ;
    rdfs:label "Intellectual Frontiers Press"@en ;
    schema:name "Intellectual Frontiers Press"@en ;
    skos:hiddenLabel "IF Press"@en ;
    ifcore:imprintOf ifcore:Press ;
    schema:slogan "For builders and buyers of consequential software."@en ;
    schema:audience ifcore:BuildersAndBuyersOfConsequentialSoftware ;
    ifcore:imprintThesis ifcore:IFPressThesis ;
    ifcore:hasAudience ifcore:Public .
ifcore:BuildersAndBuyersOfConsequentialSoftware a ifcore:Readership ;
    rdfs:label "Builders and buyers of consequential software"@en ;
    schema:audienceType "The people who decide what consequential software to build and the people who decide what consequential software to buy or adopt."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:IFPressThesis a schema:Claim ;
    rdfs:label "Intellectual Frontiers Press thesis"@en ;
    schema:text "AI has made building software cheaper. It has not made it cheaper to know what is worth building, or to judge which of many offerings deserves a purchase whose consequences fall on other people. Builders find what to build in their Native Alpha; buyers seek Acquired Alpha, and count it only when the seller's proof cost the seller something. Intellectual Frontiers Press publishes for the people who carry those two decisions."@en ;
    ifcore:claimKind ifcore:Framework ;
    prov:wasDerivedFrom ifcore:ChasingNativeAlpha ;
    ifcore:hasAudience ifcore:Public .

ifcore:ConsequentialSoftware a owl:Class ; rdfs:label "Consequential Software"@en ;
    skos:definition "Software, or a product or service that software runs, where a wrong decision to build, buy, or adopt it is costly or slow to reverse and its cost falls on people other than the one who decides: patients, warfighters, citizens, students, customers, or staff (0009-press FR-018)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:AcquiredAlpha a owl:Class ; rdfs:label "Acquired Alpha"@en ;
    skos:definition "An advantage a buyer gains by buying, adopting, or hiring what another party has built, strong enough to change a real decision. It counts only when the seller's evidence for it cost the seller something real (money, time, access, data, reputation, or a changed decision) and the buyer can check that evidence without relying on the seller's word (0003-intellectual-frontiers FR-006; 0009-press FR-018, FR-043)."@en ;
    skos:scopeNote "The buyer's counterpart to ifcore:NativeAlpha. Native Alpha is carried by what the subject already has; an advantage that needs a capability the subject must acquire is not Native Alpha (0003-intellectual-frontiers FR-015), and when a buyer gains it by buying, adopting, or hiring what another party has built, it is Acquired Alpha. It means buying products, services, and capabilities, not buying a company. A demonstration, an analyst placement, a badge, or expressed interest is not evidence of Acquired Alpha."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:ReaderSideScheme a skos:ConceptScheme ; rdfs:label "Reader side"@en ;
    rdfs:comment "Whom a book serves in a decision to build, buy, or adopt consequential software (0009-press FR-040, FR-042). A book is exactly one."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:BuilderSide a skos:Concept ; skos:inScheme ifcore:ReaderSideScheme ; skos:prefLabel "builders"@en ;
    skos:definition "Readers who decide what to build and build it: founders, engineers, product and technology leaders, manufacturers."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:BuyerSide a skos:Concept ; skos:inScheme ifcore:ReaderSideScheme ; skos:prefLabel "buyers"@en ;
    skos:definition "Readers who decide what to buy, adopt, fund, or hire, and live with it: executives, boards, investors, procurement, clinical and program owners."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:BuilderAndBuyerSide a skos:Concept ; skos:inScheme ifcore:ReaderSideScheme ; skos:prefLabel "builders and buyers"@en ;
    skos:definition "A book written for both sides of one decision, stating what each will ask of the other."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:readerSide a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain schema:CreativeWork ; rdfs:range skos:Concept ;
    rdfs:comment "The one reader side a book serves, a concept of ifcore:ReaderSideScheme (0009-press FR-040)."@en .

ifcore:DomainStandingScheme a skos:ConceptScheme ; rdfs:label "Domain standing"@en ;
    rdfs:comment "Whether the imprint has committed to a consequence domain or is testing it (0009-press FR-041). Changed only by a recorded Decision."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:CoreDomain a skos:Concept ; skos:inScheme ifcore:DomainStandingScheme ; skos:prefLabel "core"@en ;
    skos:definition "A domain the imprint has committed to publishing in."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:ExploratoryDomain a skos:Concept ; skos:inScheme ifcore:DomainStandingScheme ; skos:prefLabel "exploratory"@en ;
    skos:definition "A domain the imprint is testing; each book in it is an experiment whose reception is read as evidence about entering the domain."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:domainStanding a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:range skos:Concept ;
    rdfs:comment "A consequence domain's standing, a concept of ifcore:DomainStandingScheme (0009-press FR-041)."@en .

ifcore:ConsequenceDomainScheme a skos:ConceptScheme ; rdfs:label "Consequence domain"@en ;
    rdfs:comment "A field in which decisions to build, buy, or adopt software carry consequences for people other than the reader (0009-press FR-040, FR-041, FR-046)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:HealthcareDomain a skos:Concept ; skos:inScheme ifcore:ConsequenceDomainScheme ; skos:prefLabel "healthcare and medical technology"@en ;
    ifcore:domainStanding ifcore:CoreDomain ;
    skos:definition "Care delivery, payment, and the devices and systems clinicians and patients depend on."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:DefenseDomain a skos:Concept ; skos:inScheme ifcore:ConsequenceDomainScheme ; skos:prefLabel "defense and national security"@en ;
    ifcore:domainStanding ifcore:CoreDomain ;
    skos:definition "Systems warfighters and the programs that field them depend on."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:PublicSectorDomain a skos:Concept ; skos:inScheme ifcore:ConsequenceDomainScheme ; skos:prefLabel "government and public buyers"@en ;
    ifcore:domainStanding ifcore:CoreDomain ;
    skos:definition "Public agencies as buyers, and the firms that sell to them."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:EnterpriseSoftwareDomain a skos:Concept ; skos:inScheme ifcore:ConsequenceDomainScheme ; skos:prefLabel "enterprise and AI-native software"@en ;
    ifcore:domainStanding ifcore:CoreDomain ;
    skos:definition "Business software and AI-native systems, and the technology leadership that decides what to build, buy, and hire."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:AutomotiveRetailDomain a skos:Concept ; skos:inScheme ifcore:ConsequenceDomainScheme ; skos:prefLabel "automotive retail and service"@en ;
    ifcore:domainStanding ifcore:ExploratoryDomain ;
    skos:definition "Dealership operations and the systems that run them."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:ResearchFundingDomain a skos:Concept ; skos:inScheme ifcore:ConsequenceDomainScheme ; skos:prefLabel "research funding and review"@en ;
    ifcore:domainStanding ifcore:ExploratoryDomain ;
    skos:definition "Research programs, the funders who choose among them, and the review that decides."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:EducationDomain a skos:Concept ; skos:inScheme ifcore:ConsequenceDomainScheme ; skos:prefLabel "schools and education"@en ;
    ifcore:domainStanding ifcore:ExploratoryDomain ;
    skos:definition "Schools, the systems they run on, and the people who build and choose them."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:PublishingDomain a skos:Concept ; skos:inScheme ifcore:ConsequenceDomainScheme ; skos:prefLabel "publishing"@en ;
    ifcore:domainStanding ifcore:ExploratoryDomain ;
    skos:definition "Books and the editorial systems that make them."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:consequenceDomain a owl:ObjectProperty ; rdfs:domain schema:CreativeWork ; rdfs:range skos:Concept ;
    rdfs:comment "The consequence domain a book addresses, a concept of ifcore:ConsequenceDomainScheme (0009-press FR-040)."@en .

ifcore:ChasingNativeAlphaBook ifcore:readerSide ifcore:BuilderAndBuyerSide ;
    ifcore:consequenceDomain ifcore:EnterpriseSoftwareDomain .

