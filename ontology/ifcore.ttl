# ───────────────────────── Domain names (0022-domain-names) ─────────────────────────
# A domain name is an asset apart from the property deployed at it (FR-001). Its name, role, rights-holder,
# and what it serves are the company's own facts; its registration facts are the registry's, held in one
# ExternalRecordReference per domain whose primary source is the registry's RDAP record (FR-010, FR-011).
# Properties reuse Dublin Core (dcterms:identifier, dcterms:type, dcterms:relation, dcterms:rightsHolder)
# rather than declaring new ones (0019-controlled-vocabulary FR-001). Only Public domains are asserted here;
# the vault holds the rest of the catalog (FR-008, FR-009). DNS records are never asserted (FR-015).

ifcore:DomainName a owl:Class ; rdfs:subClassOf ifcore:IntangibleAsset, ifcore:Fact ; rdfs:label "Domain name"@en ;
    skos:definition "A registrable domain name the company holds through a registrar: the label directly beneath a public suffix, never a subdomain (0022-domain-names FR-001, FR-002)."@en ;
    skos:closeMatch <http://www.wikidata.org/entity/Q32635> ;
    rdfs:comment "Specializes ifcore:IntangibleAsset (0019 FR-002): ASC 805 and IFRS 3 both list Internet domain names among marketing-related intangible assets. Distinct from any ifcore:DigitalAsset deployed at it (FR-001). Its dcterms:identifier is the lowercase A-label name (FR-003); its dcterms:rightsHolder defaults to Intellectual Frontiers LLC (FR-004); its dcterms:type is exactly one concept in ifcore:DomainRoleScheme (FR-005), plus ifcore:CrownJewelDomain when it is one (FR-021); what it serves is dcterms:relation (FR-006). Registrar, dates, status, nameservers, and DNSSEC are never literals here: they sit on the ExternalRecordReference that ifcore:describes it (FR-010)."@en .

ifcore:DomainRoleScheme a skos:ConceptScheme ; rdfs:label "Domain role"@en ;
    rdfs:comment "Why the company holds a domain name; the value of a DomainName's dcterms:type (0022-domain-names FR-005). Only primary, redirect, and mail domains may be Public (FR-009)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:PrimaryDomainRole a skos:Concept ; skos:inScheme ifcore:DomainRoleScheme ; skos:prefLabel "Primary"@en ;
    skos:definition "The address of the thing it serves."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RedirectDomainRole a skos:Concept ; skos:inScheme ifcore:DomainRoleScheme ; skos:prefLabel "Redirect"@en ;
    skos:definition "Forwards to another domain the company holds."@en ; ifcore:hasAudience ifcore:Public .
ifcore:MailDomainRole a skos:Concept ; skos:inScheme ifcore:DomainRoleScheme ; skos:prefLabel "Mail"@en ;
    skos:definition "Carries email and serves nothing else."@en ; ifcore:hasAudience ifcore:Public .
ifcore:DefensiveDomainRole a skos:Concept ; skos:inScheme ifcore:DomainRoleScheme ; skos:prefLabel "Defensive"@en ;
    skos:definition "Held to protect a name, a brand, a misspelling, or another top-level domain; serves nothing."@en ; ifcore:hasAudience ifcore:Public .
ifcore:ReservedDomainRole a skos:Concept ; skos:inScheme ifcore:DomainRoleScheme ; skos:prefLabel "Reserved"@en ;
    skos:definition "Held for a work, venture, or presentation not yet announced."@en ; ifcore:hasAudience ifcore:Public .
ifcore:ParkedDomainRole a skos:Concept ; skos:inScheme ifcore:DomainRoleScheme ; skos:prefLabel "Parked"@en ;
    skos:definition "Held with no current use."@en ; ifcore:hasAudience ifcore:Public .

ifcore:DomainSecurityControlScheme a skos:ConceptScheme ; rdfs:label "Domain security control"@en ;
    rdfs:comment "The controls every domain name is checked against (0023-domain-security FR-001; 0024-persistent-addresses FR-004). An exception is a Decision naming a DomainName and one of these by schema:about, lapsing on its dcterms:valid date (FR-002). Each concept's skos:notation is the code a check or report uses. Which controls apply to a domain follows from its role and its published records, as 0023 states; no property here restates that."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:TransferLockControl a skos:Concept ; skos:inScheme ifcore:DomainSecurityControlScheme ; skos:prefLabel "Transfer lock"@en ;
    skos:notation "transfer-lock" ; skos:definition "The registrar transfer lock is on (FR-004)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:AutoRenewControl a skos:Concept ; skos:inScheme ifcore:DomainSecurityControlScheme ; skos:prefLabel "Automatic renewal"@en ;
    skos:notation "auto-renew" ; skos:definition "Automatic renewal is on (FR-005)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:DNSSECControl a skos:Concept ; skos:inScheme ifcore:DomainSecurityControlScheme ; skos:prefLabel "DNSSEC"@en ;
    skos:notation "dnssec" ; skos:definition "The zone is signed and its delegation signer record is published at the registry (FR-006)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RegistrantPrivacyControl a skos:Concept ; skos:inScheme ifcore:DomainSecurityControlScheme ; skos:prefLabel "Registrant privacy"@en ;
    skos:notation "registrant-privacy" ; skos:definition "The registry record discloses no registrant personal contact details (FR-007)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:DelegationControl a skos:Concept ; skos:inScheme ifcore:DomainSecurityControlScheme ; skos:prefLabel "Delegation"@en ;
    skos:notation "delegation" ; skos:definition "The domain is delegated only to its DNS-as-code provider's nameservers (FR-008)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:NoMailControl a skos:Concept ; skos:inScheme ifcore:DomainSecurityControlScheme ; skos:prefLabel "No-mail posture"@en ;
    skos:notation "no-mail" ; skos:definition "A null MX, a fail-all sender policy, and a reject DMARC policy, for a domain that neither sends nor receives email (FR-009)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:SendingAuthenticationControl a skos:Concept ; skos:inScheme ifcore:DomainSecurityControlScheme ; skos:prefLabel "Sending authentication"@en ;
    skos:notation "sending-authentication" ; skos:definition "SPF, DKIM, and a DMARC policy of quarantine or reject with company-held reporting, for a domain that sends email (FR-010)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:ReceivingTransportControl a skos:Concept ; skos:inScheme ifcore:DomainSecurityControlScheme ; skos:prefLabel "Receiving transport security"@en ;
    skos:notation "receiving-transport" ; skos:definition "MTA-STS in enforce mode and a TLS-RPT address, for a domain that receives email (FR-011)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:CAAControl a skos:Concept ; skos:inScheme ifcore:DomainSecurityControlScheme ; skos:prefLabel "Certificate authority authorization"@en ;
    skos:notation "caa" ; skos:definition "CAA records naming only the company's certificate authorities, or permitting none for a domain with no web content (FR-012)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:HTTPSControl a skos:Concept ; skos:inScheme ifcore:DomainSecurityControlScheme ; skos:prefLabel "HTTPS and HSTS"@en ;
    skos:notation "https" ; skos:definition "A valid certificate, HTTP redirected to HTTPS, and HSTS of at least one year, for a primary or redirect domain (FR-013)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:NoDanglingRecordsControl a skos:Concept ; skos:inScheme ifcore:DomainSecurityControlScheme ; skos:prefLabel "No dangling records"@en ;
    skos:notation "no-dangling-records" ; skos:definition "No record points at a host, service, or address the company no longer controls (FR-014)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:AccountMFAControl a skos:Concept ; skos:inScheme ifcore:DomainSecurityControlScheme ; skos:prefLabel "Account access"@en ;
    skos:notation "account-mfa" ; skos:definition "Multi-factor sign-in, scoped expiring tokens, and access reviewed every ninety days, for each registrar and DNS provider account (FR-015)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:AccountRecoveryControl a skos:Concept ; skos:inScheme ifcore:DomainSecurityControlScheme ; skos:prefLabel "Account recovery"@en ;
    skos:notation "account-recovery" ; skos:definition "Account recovery does not depend solely on a domain in the same account (FR-016)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:SecurityTxtControl a skos:Concept ; skos:inScheme ifcore:DomainSecurityControlScheme ; skos:prefLabel "security.txt"@en ;
    skos:notation "security-txt" ; skos:definition "A security.txt with a contact and an unexpired date, on a primary domain (0023 FR-022)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:CertificateTransparencyControl a skos:Concept ; skos:inScheme ifcore:DomainSecurityControlScheme ; skos:prefLabel "Certificate transparency"@en ;
    skos:notation "certificate-transparency" ; skos:definition "No certificate in the public logs from an authority the domain's CAA does not permit, or for a hostname nobody serves (0023 FR-023)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:LookalikesControl a skos:Concept ; skos:inScheme ifcore:DomainSecurityControlScheme ; skos:prefLabel "Look-alike domains"@en ;
    skos:notation "lookalikes" ; skos:definition "No look-alike of a Public primary domain registered by anyone else; reported, never acted on (0023 FR-024)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:CrownJewelRenewalControl a skos:Concept ; skos:inScheme ifcore:DomainSecurityControlScheme ; skos:prefLabel "Crown jewel renewal"@en ;
    skos:notation "crown-jewel-renewal" ; skos:definition "A crown jewel domain registered at least two years ahead (0023 FR-025)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:CrownJewelAccessControl a skos:Concept ; skos:inScheme ifcore:DomainSecurityControlScheme ; skos:prefLabel "Crown jewel access"@en ;
    skos:notation "crown-jewel-access" ; skos:definition "At least two people can administer the accounts holding a crown jewel domain (0023 FR-026)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:PublishedAddressesControl a skos:Concept ; skos:inScheme ifcore:DomainSecurityControlScheme ; skos:prefLabel "Published addresses"@en ;
    skos:notation "published-addresses" ; skos:definition "Every published address on the domain answers, or redirects permanently (0024-persistent-addresses FR-002)."@en ; ifcore:hasAudience ifcore:Public .
ifcore:NamespaceResolvesControl a skos:Concept ; skos:inScheme ifcore:DomainSecurityControlScheme ; skos:prefLabel "Namespace not served"@en ;
    skos:notation "namespace" ; skos:definition "Every ontology namespace address, public or private, answers not found: a namespace is an identifier, and the ontology is read in the Workspaces Console (0024 FR-005, FR-006)."@en ; ifcore:hasAudience ifcore:Public .

ifcore:DomainCriticalityScheme a skos:ConceptScheme ; rdfs:label "Domain criticality"@en ;
    rdfs:comment "How much breaks if a domain is lost (0022-domain-names FR-021). A crown jewel carries this concept as a second dcterms:type beside its role; every other domain is standard and carries none. Anything that needs a domain to work names it by dcterms:requires (FR-024), reused from Dublin Core rather than declared here (0019-controlled-vocabulary FR-001)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:CrownJewelDomain a skos:Concept ; skos:inScheme ifcore:DomainCriticalityScheme ; skos:prefLabel "Crown jewel"@en ;
    skos:definition "A domain whose loss would break the company's identity or its vocabulary: one hosting an ontology namespace or the company's own primary web property, or one the decision authority marks (0022 FR-021; 0024-persistent-addresses FR-008). Generic top-level domains only (0022 FR-022); registered two years ahead and administered by at least two people (0023-domain-security FR-025, FR-026)."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:CloudflareAccountAccess a ifcore:RestrictedDataReference ;
    rdfs:label "Cloudflare account"@en ;
    ifcore:describes ifcore:IntellectualFrontiersLLC ;
    ifcore:heldIn "Cloudflare, the company's primary registrar and DNS provider."@en ;
    ifcore:accessInstructions "Access, including any read-only API token, is granted by the decision authority in effect (0001-eidolon-architecture FR-029). No credential is held in any Eidolon repository (0022-domain-names FR-014)."@en ;
    rdfs:comment "Other registrar accounts, and how reconciliation reaches them, are 0022-domain-names OQ-2."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:IntellectualFrontiersComDomain a ifcore:DomainName ;
    rdfs:label "intellectualfrontiers.com"@en ;
    dcterms:identifier "intellectualfrontiers.com" ;
    dcterms:type ifcore:PrimaryDomainRole, ifcore:CrownJewelDomain ;
    dcterms:relation ifcore:WebProperty ;
    dcterms:rightsHolder ifcore:IntellectualFrontiersLLC ;
    ifcore:hasAudience ifcore:Public .
ifcore:IntellectualFrontiersComDomainRegistration a ifcore:ExternalRecordReference ;
    ifcore:describes ifcore:IntellectualFrontiersComDomain ;
    ifcore:primarySource "https://rdap.verisign.com/com/v1/domain/intellectualfrontiers.com"^^xsd:anyURI ;
    ifcore:cachedValue "Registrar Cloudflare, Inc.; registered 2023-09-06; expires 2027-09-06; status client transfer prohibited; nameservers cameron.ns.cloudflare.com, lorna.ns.cloudflare.com; delegation not signed."@en ;
