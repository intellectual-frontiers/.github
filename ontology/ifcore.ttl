    dcterms:license "MIT"@en ;
    schema:url "https://sprymd.org"^^xsd:anyURI ;
    rdfs:comment "Markdown as a programmable medium: every fenced code block of a Markdown document runs, so that a runbook, a data pipeline or a piece of compliance evidence is one document. In operation, per its public site on 2026-10-04. The license is the one its site states; it grants use of the code and does not grant the mark, which the company holds (ifcore:SpryTrademark). Which entity holds the copyright in its code is not yet confirmed."@en ;
    ifcore:hasAudience ifcore:Public .

# ───────────────────────── The Opsfolio platform (0049-platforms) ─────────────────────────
# Opsfolio is a platform: a person classified it so. Its modules below are designed, not all built; each realization is a recommendation
# a person reviews, and every module code is proposed until a person confirms it (0049-platforms FR-012). The family products keep their
# brand names and are related to the module they carry out by carriesOut (FR-014). Qualityfolio is the test management tool of every platform;
# the assurance environment uses it for software tests, and control tests of a customer's controls do not run in the assurance environment.

ifcore:OpsfolioPlatformErgon a ifcore:Ergon ; ifcore:reflects ifcore:Opsfolio ;
    ifcore:purpose "Lets a company hold its intent as code, collect evidence from its own operation, and see the difference between the two, with the evidence staying where the customer keeps it."@en ;
    ifcore:ownerRole ifcore:DecisionAuthorityRole ;
    rdfs:comment "Classified as a platform by a person. The eleven modules are designed and each realization is stated for a person to review. The third-party test (0049-platforms FR-003) depends on an extension contract that is not yet specified; the replacement and single-store tests are met by design only."@en ;
    ifcore:reviewState ifcore:AcceptedState ; ifcore:reviewedBy ifcore:ShahidNehalShah ; ifcore:reviewedOn "2026-10-09"^^xsd:date ;
    ifcore:hasAudience ifcore:Public .

ifcore:OpsfolioEvidenceStore a ifcore:PlatformModule ; rdfs:label "Opsfolio Evidence Store"@en ;
    ifcore:moduleCode "OES" ; ifcore:codeStatus "confirmed" ; ifcore:artifactName "opsfolio-evidence-store" ;
    ifcore:platformLayer ifcore:DataLayer ; ifcore:hasAudience ifcore:Public .
ifcore:OpsfolioEvidenceStoreErgon a ifcore:Ergon ; ifcore:reflects ifcore:OpsfolioEvidenceStore ;
    ifcore:purpose "Is the one store of the evidence and the records that the platform keeps, with what was received, what was modelled and what was derived."@en ; ifcore:ownerRole ifcore:DecisionAuthorityRole ; ifcore:hasAudience ifcore:Public .

ifcore:OpsfolioOntologyModel a ifcore:PlatformModule ; rdfs:label "Opsfolio Ontology Model"@en ;
    ifcore:moduleCode "OOM" ; ifcore:codeStatus "confirmed" ; ifcore:artifactName "opsfolio-ontology-model" ;
    ifcore:platformLayer ifcore:DataLayer ; ifcore:hasAudience ifcore:Public .
ifcore:OpsfolioOntologyModelErgon a ifcore:Ergon ; ifcore:reflects ifcore:OpsfolioOntologyModel ;
    ifcore:purpose "Holds the controls, evidence, assets, boundaries and findings as ontology concepts, from which storage and validation are generated. A boundary says what is in scope and which controls apply to it."@en ; ifcore:ownerRole ifcore:DecisionAuthorityRole ; ifcore:hasAudience ifcore:Public .

ifcore:OpsfolioIntegrationEngine a ifcore:PlatformModule ; rdfs:label "Opsfolio Integration Engine"@en ;
    ifcore:moduleCode "OIE" ; ifcore:codeStatus "confirmed" ; ifcore:artifactName "opsfolio-integration-engine" ;
    ifcore:platformLayer ifcore:OrthogonalLayer ; ifcore:hasAudience ifcore:Public .
ifcore:OpsfolioIntegrationEngineErgon a ifcore:Ergon ; ifcore:reflects ifcore:OpsfolioIntegrationEngine ;
    ifcore:purpose "Collects evidence from files, command output, mail, issue trackers and other systems of the customer, into the Evidence Store only."@en ; ifcore:ownerRole ifcore:DecisionAuthorityRole ; ifcore:hasAudience ifcore:Public .

ifcore:OpsfolioAssuranceEnvironment a ifcore:PlatformModule ; rdfs:label "Opsfolio Assurance Environment"@en ;
