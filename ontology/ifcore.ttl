ifcore:OpsfolioApiGateway a ifcore:PlatformModule ; rdfs:label "Opsfolio API Gateway"@en ;
    ifcore:moduleCode "OAG" ; ifcore:codeStatus "confirmed" ; ifcore:artifactName "opsfolio-api-gateway" ;
    ifcore:platformLayer ifcore:OrthogonalLayer ;
    ifcore:offersInterface ifcore:ResourceApiFlavor, ifcore:GraphApiFlavor, ifcore:VirtualSqlFlavor, ifcore:McpServerFlavor ;
    ifcore:hasAudience ifcore:Public .
ifcore:OpsfolioApiGatewayErgon a ifcore:Ergon ; ifcore:reflects ifcore:OpsfolioApiGateway ;
    ifcore:purpose "Offers every function of the platform as a resource API, a graph API, a read-only SQL layer and a Model Context Protocol server, on the customer's own machine or in a hosted instance, with the same access decisions in all four."@en ;
    ifcore:ownerRole ifcore:DecisionAuthorityRole ; ifcore:hasAudience ifcore:Public .

ifcore:OpsfolioAssetInventory a ifcore:PlatformModule ; rdfs:label "Opsfolio Asset Inventory"@en ;
