# ───────────────────────── Renditions and delivery (0015-work-packages FR-013 – FR-018) ─────────────────────────

ifcore:DeliveryRecord a owl:Class ; rdfs:subClassOf ifcore:Reference ; rdfs:label "Delivery record"@en ;
    rdfs:comment "Records where a delivered binary rendition lives, from which source commit, with its checksum, carrying its own audience (0015 FR-017). The work it renders is named by ifcore:describes. Its audience MUST NOT be broader than its work's. The rendition itself is never tracked in Git (0015 FR-014)."@en .
ifcore:deliveredTo a owl:DatatypeProperty ; rdfs:domain ifcore:DeliveryRecord ; rdfs:range xsd:anyURI ;
    rdfs:comment "Where the rendition lives. MUST NOT hold, or embed, a credential, a password, an access secret, or a signed or expiring address (0015 FR-017)."@en .
ifcore:sourceCommit a owl:DatatypeProperty ; rdfs:domain ifcore:DeliveryRecord ; rdfs:range xsd:string ;
    rdfs:comment "The full commit hash of the source the rendition was built from (0015 FR-015)."@en .
ifcore:deliveredOn a owl:DatatypeProperty ; rdfs:domain ifcore:DeliveryRecord ; rdfs:range xsd:date .
ifcore:checksum a owl:DatatypeProperty ; rdfs:domain ifcore:DeliveryRecord ; rdfs:range xsd:string ;
    rdfs:comment "The SHA-256 of the delivered file, as lowercase hexadecimal."@en .

ifcore:CutKind a owl:Class ; rdfs:label "Cut kind"@en ;
    rdfs:comment "Whether a delivered rendition is a review cut or a final cut (0016-press-production FR-025)."@en .
ifcore:ReviewCut a ifcore:CutKind ; rdfs:label "Review cut"@en ; ifcore:hasAudience ifcore:Public .
ifcore:FinalCut a ifcore:CutKind ; rdfs:label "Final cut"@en ; ifcore:hasAudience ifcore:Public .
ifcore:cutKind a owl:ObjectProperty ; rdfs:domain ifcore:DeliveryRecord ; rdfs:range ifcore:CutKind ;
    rdfs:comment "Present when the rendition is a review or final cut. Edition and printing are not restated here: the manuscript at sourceCommit is their one source (0016 FR-024)."@en .

# ───────────────────────── Book formats and series (0016-press-production FR-008, FR-049; 0017 FR-011) ─────────────────────────

ifcore:Fieldbook a owl:Class ; rdfs:subClassOf schema:Book ; rdfs:label "Fieldbook"@en ;
    rdfs:comment "A book that teaches a person to do a kind of work better (0016 FR-049)."@en .
ifcore:Rolebook a owl:Class ; rdfs:subClassOf schema:Book ; rdfs:label "Rolebook"@en ;
    rdfs:comment "A short book for a profession or job function whose job has changed structurally; it answers five questions and is not padded to a length range (0016 FR-049)."@en .
ifcore:PocketGuide a owl:Class ; rdfs:subClassOf schema:Book ; rdfs:label "Pocket Guide"@en ;
    rdfs:comment "A short, opinionated, practical book that develops one important idea far enough for a named reader to understand and apply it in a single sitting; produced exactly as any book is (0016 FR-051 – FR-054)."@en .
[] a owl:AllDisjointClasses ; owl:members ( ifcore:Fieldbook ifcore:Rolebook ifcore:PocketGuide ) .

ifcore:IFPressPocketGuides a schema:BookSeries ; rdfs:label "IF Press Pocket Guides"@en ;
    schema:name "IF Press Pocket Guides"@en ;
    schema:publisher ifcore:IFPress ;
    schema:slogan "Big ideas. Small books. Useful immediately."@en ;
    rdfs:comment "The series of Pocket Guides. Its volumes are independent works, not meant to be read in order, so it is not a serial series and has no package (0016 FR-051)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:seriesNumber a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:subPropertyOf schema:position ; rdfs:domain ifcore:PocketGuide ; rdfs:range xsd:positiveInteger ;
    rdfs:comment "A Pocket Guide's position in IF Press Pocket Guides, a whole number from 1, shown as three digits (0016 FR-054)."@en .
ifcore:centralThesis a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain ifcore:PocketGuide ; rdfs:range rdf:langString ;
    rdfs:comment "The one claim a Pocket Guide develops, as the book states it (0016 FR-054)."@en .
ifcore:readerOutcome a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain ifcore:PocketGuide ; rdfs:range rdf:langString ;
    rdfs:comment "What the reader can do or decide differently after reading a Pocket Guide (0016 FR-054)."@en .

ifcore:SerialSeries a owl:Class ; rdfs:subClassOf schema:BookSeries, ifcore:SubstantialWork ; rdfs:label "Serial series"@en ;
    rdfs:comment "A set of books meant to be read together in order, kept coherent by one series bible; each volume is its own book work related to it by schema:isPartOf (0016 FR-008 – FR-011)."@en .
ifcore:Anthology a owl:Class ; rdfs:subClassOf ifcore:SerialSeries ; rdfs:label "Anthology"@en ;
    rdfs:comment "A serial series made from another work's released items, one chapter per item, one volume per calendar year; a chapter is related to the item it adapts by schema:isBasedOn (0017 FR-011, FR-012)."@en .

# ───────────────────────── Named tools, provenance, and promotion (0016-press-production FR-041, FR-046) ─────────────────────────

ifcore:NamedTool a owl:Class ; rdfs:subClassOf skos:Concept ; rdfs:label "Named tool"@en ;
    rdfs:comment "A named tool, test, or framework a work teaches and expects a reader to reuse (0016 FR-041). Every individual carries explicit provenance (ifcore:sourceFile, ifcore:sourceLocation) and an audience."@en .
ifcore:definedIn a owl:ObjectProperty ; rdfs:domain skos:Concept ; rdfs:range schema:CreativeWork ;
    rdfs:comment "The work, chapter, or section that gives a concept its definition."@en .
ifcore:sourceFile a owl:DatatypeProperty ; rdfs:subPropertyOf dcterms:source ; rdfs:range xsd:string ;
    rdfs:comment "Provenance: the repository-relative path an extracted individual was taken from (0016 FR-041)."@en .
ifcore:sourceLocation a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "Provenance: the exact heading, identifier, or line within ifcore:sourceFile an extracted individual was taken from, specific enough for a person to find the passage."@en .

ifcore:PromotionBrief a owl:Class ; rdfs:subClassOf ifcore:Fact, prov:Entity ; rdfs:label "Promotion brief"@en ;
    rdfs:comment "A work's supporting record of its reader, promise, claims kept, keywords, surfaces, comparables, and decisions owed. Never the work itself (0016 FR-046)."@en .
ifcore:briefOf a owl:ObjectProperty ; rdfs:domain ifcore:PromotionBrief ; rdfs:range ifcore:SubstantialWork .

# ───────────────────────── The Journal (0009-press FR-020 – FR-023) ─────────────────────────

ifcore:JournalOfIntellectualFrontiers a schema:Periodical ;
    rdfs:label "Journal of Intellectual Frontiers"@en ;
    schema:publisher ifcore:Press ;
    dcterms:rightsHolder ifcore:IntellectualFrontiersLLC ;
    schema:alternateName "JINFRO"@en ;
    dcterms:accrualPeriodicity <http://purl.org/cld/freq/quarterly> ;
    rdfs:comment "A standing, AI-native publication in the long-term mold of a business-and-management journal, distinct from any one-off book (0009-press FR-020), and the firm's one journal (FR-031). It reports outcomes, what the firm's works found, made, or proved, not company or unit news (FR-032); it is not a presentation of one work but the vehicle for many, each issue a presentation in online and print editions (FR-033). Quarterly, online and in print. Its short form is JINFRO, not 'JIF', which is Clarivate's trademarked abbreviation for Journal Impact Factor; JINFRO's own clearance is a separate decision. In ideation: its lifecycle stage is Intake."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:JournalOfIntellectualFrontiers a ifcore:SubstantialWork ;
    ifcore:workLifecycleStage ifcore:Intake ;
    ifcore:lifecycleOwner ifcore:Press .

ifcore:EidolonJournalArticle a schema:Article ;
    rdfs:label "Eidolons: A Working Digital Reflection"@en ;
    schema:isPartOf ifcore:JournalOfIntellectualFrontiers ;
    schema:about ifcore:Eidolon ;
    prov:wasDerivedFrom ifcore:EidolonPillar ;
    schema:author ifcore:ShahidNehalShah ;
    dcterms:creator ifcore:ShahidNehalShah ;
    dcterms:rightsHolder ifcore:IntellectualFrontiersLLC ;
    ifcore:claimKind ifcore:Framework ;
    rdfs:comment "Native-origin work, per 0007-work-and-assets FR-016: Intellectual Frontiers is this piece's primary publisher, so its full text is a content document in this repository's content root, not merely referenced — unlike ifcore:NativeAlphaArticle, whose primary text lives on shahidshah.com."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:IplgJournalArticle a schema:Article ;
    rdfs:label "Intellectual Product-Led Growth"@en ;
    schema:isPartOf ifcore:JournalOfIntellectualFrontiers ;
    schema:about ifcore:IPLG ;
    prov:wasDerivedFrom ifcore:IplgPillar ;
    schema:author ifcore:ShahidNehalShah ;
    dcterms:creator ifcore:ShahidNehalShah ;
    dcterms:rightsHolder ifcore:IntellectualFrontiersLLC ;
    ifcore:claimKind ifcore:Framework ;
    rdfs:comment "Native-origin work, per 0007-work-and-assets FR-016: its full text is a content document in this repository's content root. Draws on the firm's own prior IPLG strategy work, already partly implemented across the public site's executable-content pattern."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:Find a ifcore:MethodStage ; rdfs:label "Find"@en ; ifcore:sequenceOrder 1 ;
    ifcore:question "What is unusually true here?"@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:Prove a ifcore:MethodStage ; rdfs:label "Prove"@en ; ifcore:sequenceOrder 2 ;
    ifcore:question "What small hard thing earns a scarce commitment?"@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:Decide a ifcore:MethodStage ; rdfs:label "Decide"@en ; ifcore:sequenceOrder 3 ;
    ifcore:question "What will we do now?"@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:Compound a ifcore:MethodStage ; rdfs:label "Compound"@en ; ifcore:sequenceOrder 4 ;
    ifcore:question "How does use make the advantage stronger?"@en ;
    ifcore:hasAudience ifcore:Public .

# ───────────────────────── Studios (0011-studios) ─────────────────────────

ifcore:VentureLifecycleStage a owl:Class ; rdfs:label "Venture lifecycle stage"@en ;
    rdfs:comment "One stage in the ordered path a venture moves through on the way to being proven or stopped (0011-studios FR-003, FR-004). Reuses ifcore:sequenceOrder and ifcore:question, already declared for ifcore:MethodStage, rather than redeclaring either."@en .
ifcore:Observe a ifcore:VentureLifecycleStage ; rdfs:label "Observe"@en ; ifcore:sequenceOrder 1 ;
    ifcore:question "What real asymmetry already exists, or is carried by what the subject already has and would show only if it were reorganized (0003 FR-014)?"@en ; ifcore:hasAudience ifcore:Public .
ifcore:Frame a ifcore:VentureLifecycleStage ; rdfs:label "Frame"@en ; ifcore:sequenceOrder 2 ;
    ifcore:question "What is the Native Alpha thesis, stated in plain language, and is it evident or latent (0011 FR-002)?"@en ; ifcore:hasAudience ifcore:Public .
ifcore:Validate a ifcore:VentureLifecycleStage ; rdfs:label "Validate"@en ; ifcore:sequenceOrder 3 ;
    ifcore:question "Does a real buyer and workflow actually exist?"@en ; ifcore:hasAudience ifcore:Public .
ifcore:Experiment a ifcore:VentureLifecycleStage ; rdfs:label "Experiment"@en ; ifcore:sequenceOrder 4 ;
    ifcore:question "What is the smallest credible test, and what are its continue and stop conditions, written before the result is seen (0011 FR-004)?"@en ; ifcore:hasAudience ifcore:Public .
ifcore:PaidProof a ifcore:VentureLifecycleStage ; rdfs:label "Paid proof"@en ; ifcore:sequenceOrder 5 ;
    ifcore:question "Will someone pay for this against a real budget line?"@en ; ifcore:hasAudience ifcore:Public .
ifcore:Repeat a ifcore:VentureLifecycleStage ; rdfs:label "Repeat"@en ; ifcore:sequenceOrder 6 ;
    ifcore:question "Do the delivery and economics hold up more than once?"@en ; ifcore:hasAudience ifcore:Public .
ifcore:Independence a ifcore:VentureLifecycleStage ; rdfs:label "Independence"@en ; ifcore:sequenceOrder 7 ;
    ifcore:question "Could a qualified replacement continue this company tomorrow (0011 FR-008)?"@en ; ifcore:hasAudience ifcore:Public .

ifcore:DesignPartnerRequirement a owl:Class ; rdfs:label "Design partner requirement"@en ;
    rdfs:comment "A contact missing even one of these is not yet a design partner (0011-studios FR-006)."@en .
ifcore:WorkflowAccess a ifcore:DesignPartnerRequirement ; rdfs:label "Workflow access"@en ;
    rdfs:comment "People can observe the real work."@en ; ifcore:hasAudience ifcore:Public .
ifcore:ExecutiveSponsor a ifcore:DesignPartnerRequirement ; rdfs:label "Executive sponsor"@en ;
    rdfs:comment "Someone can authorize change."@en ; ifcore:hasAudience ifcore:Public .
ifcore:CustomerContribution a ifcore:DesignPartnerRequirement ; rdfs:label "Customer contribution"@en ;
    rdfs:comment "A real operating partner contributes something scarce."@en ; ifcore:hasAudience ifcore:Public .
ifcore:RealDataOrImplementation a ifcore:DesignPartnerRequirement ; rdfs:label "Real data or implementation"@en ;
    rdfs:comment "The environment is real, not a demo."@en ; ifcore:hasAudience ifcore:Public .
ifcore:CommercialPath a ifcore:DesignPartnerRequirement ; rdfs:label "Commercial path"@en ;
    rdfs:comment "There is a credible route to a commercial yes."@en ; ifcore:hasAudience ifcore:Public .

ifcore:VentureEvidenceKind a owl:Class ; rdfs:label "Venture evidence kind"@en ;
    rdfs:comment "Evidence MUST NOT be treated as proof of anything beyond what its own kind states it shows (0011-studios FR-007)."@en .
ifcore:shows a owl:DatatypeProperty ; rdfs:domain ifcore:VentureEvidenceKind ; rdfs:range xsd:string ;
    rdfs:comment "What this evidence kind actually demonstrates."@en .
ifcore:notProofOf a owl:DatatypeProperty ; rdfs:domain ifcore:VentureEvidenceKind ; rdfs:range xsd:string ;
    rdfs:comment "What this evidence kind is not yet proof of, named explicitly so it is not assumed."@en .
ifcore:WorkflowAccessEvidence a ifcore:VentureEvidenceKind ; rdfs:label "Workflow access"@en ;
    ifcore:shows "We can see the real task, handoffs, constraints, and exceptions."@en ;
    ifcore:notProofOf "A right to reuse confidential know-how or data."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:ExecutiveSponsorEvidence a ifcore:VentureEvidenceKind ; rdfs:label "Executive sponsor"@en ;
    ifcore:shows "Someone can authorize staff time, security review, and change."@en ;
    ifcore:notProofOf "A buyer or budget by itself."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:DataCommitmentEvidence a ifcore:VentureEvidenceKind ; rdfs:label "Data commitment"@en ;
    ifcore:shows "We can test with representative data under defined rules."@en ;
    ifcore:notProofOf "Ownership or permission to train unrelated models."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:PaidProofEvidence a ifcore:VentureEvidenceKind ; rdfs:label "Paid proof"@en ;
    ifcore:shows "The customer assigns money to a bounded result."@en ;
    ifcore:notProofOf "Repeatable revenue or product-market fit."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:ReferenceBehaviorEvidence a ifcore:VentureEvidenceKind ; rdfs:label "Reference behavior"@en ;
    ifcore:shows "The customer will stake reputation on the result."@en ;
    ifcore:notProofOf "Renewal, margin, or scalable delivery."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:IndependenceTest a owl:Class ; rdfs:label "Independence test"@en ;
    skos:definition "Could a qualified founder, board, investor, or replacement provider continue this company tomorrow using company-controlled records, rights, systems, and relationships? A single binary judgment, never a scored checklist (0011-studios FR-008)."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:PortfolioCategory a owl:Class ; rdfs:label "Portfolio category"@en ;
    rdfs:comment "Every portfolio entry is classified as exactly one of these, each with its own obligations (0011-studios FR-014 – FR-016)."@en .
ifcore:VentureCategory a ifcore:PortfolioCategory ; rdfs:label "Venture"@en ;
    rdfs:comment "Chartered as a company: its own entity, its own operator, a licensed rights position, and a written closure condition before the first hire (0011 FR-014)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:SoftwareCategory a ifcore:PortfolioCategory ; rdfs:label "Software"@en ;
    rdfs:comment "Code as a work, not a company: records its license and current status rather than implying one; no entity or operator requirement (0011 FR-015)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:SharedServiceCategory a ifcore:PortfolioCategory ; rdfs:label "Shared service"@en ;
    rdfs:comment "Built to stand alone, usable by every venture in the portfolio; see ifcore:SharedService for the class actual shared services are typed as."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:OperatingCompanyCategory a ifcore:PortfolioCategory ; rdfs:label "Operating company"@en ;
    rdfs:comment "An established firm Studios draws on for delivery, regulated engineering, or revenue operations — not a chartered venture."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:AIFirst a owl:Class ; rdfs:label "AI First"@en ;
    skos:definition "A shared service where an AI harness leads production but developers still remain in the daily production loop."@en ;
    rdfs:comment "0011-studios FR-011: a shared service not meeting ifcore:AIWorkforce's bar is called this or ifcore:AIAugmented instead, regardless of branding or trademark."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:AIAugmented a owl:Class ; rdfs:label "AI Augmented"@en ;
    skos:definition "A shared service where humans still do most of the production work, with AI assisting it."@en ;
    rdfs:comment "0011-studios FR-011: a shared service not meeting ifcore:AIWorkforce's bar is called this or ifcore:AIFirst instead, regardless of branding or trademark."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:SharedService a owl:Class ; rdfs:label "Shared service"@en ;
    rdfs:comment "A repeated, undifferentiated capability run once across the portfolio rather than rebuilt inside each company (0011-studios FR-009). Named for the outcome it owns, and typed ifcore:AIWorkforce, ifcore:AIFirst, or ifcore:AIAugmented on its merits (FR-011) — never by branding alone."@en .
ifcore:operationalStatus a owl:DatatypeProperty ; rdfs:domain ifcore:SharedService ; rdfs:range xsd:string ;
    rdfs:comment "A shared service not yet running MUST state that here rather than being presented as operating (0011-studios FR-013)."@en .

ifcore:DemandEngineering a ifcore:SharedService, ifcore:AIWorkforce ;
    rdfs:label "Demand Engineering"@en ;
    rdfs:comment "Runs when there is no proven audience yet; its outcome is a named audience, a claim that survives contact with them, and a first step they will actually take. Claimed as an AI Workforce product (0011-studios FR-011); a trademark filing has not been independently verified via USPTO TSDR as of this writing, so no ifcore:Trademark individual is asserted for it yet (0007-work-and-assets FR-012)."@en ;
    ifcore:operationalStatus "operating"@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:RevenueEngineering a ifcore:SharedService, ifcore:AIWorkforce ;
    rdfs:label "Revenue Engineering"@en ;
    rdfs:comment "Runs after Demand Engineering, as a closed loop from market definition through the human sales handoff and back into learning. Claimed as an AI Workforce product (0011-studios FR-011); a trademark filing has not been independently verified via USPTO TSDR as of this writing, so no ifcore:Trademark individual is asserted for it yet (0007-work-and-assets FR-012). The handoff from Demand Engineering to this service is a defined gate, per 0011 FR-010."@en ;
    ifcore:operationalStatus "operating"@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:CompanionExecutableSourceCodeRepositories a ifcore:SharedService ;
    rdfs:label "Companion Executable Source Code Repositories"@en ;
    rdfs:comment "Pairs a published paper with a containerized code, data, and documentation repository that keeps updating — a complement to peer review, not a replacement for it. Not yet typed ifcore:AIWorkforce, ifcore:AIFirst, or ifcore:AIAugmented: at the ideation stage, not a running service (0011-studios FR-013), so no AI-maturity tier is asserted."@en ;
    ifcore:operationalStatus "ideation"@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:Studios ifcore:operatesSharedService ifcore:DemandEngineering, ifcore:RevenueEngineering,
    ifcore:CompanionExecutableSourceCodeRepositories .
ifcore:operatesSharedService a owl:ObjectProperty ; rdfs:domain ifcore:Unit ; rdfs:range ifcore:SharedService .

ifcore:ProductLedGrowth a owl:Class ; rdfs:label "Product-led growth"@en ;
    skos:definition "The established go-to-market approach in which the product itself drives acquisition, activation, retention and expansion. This class stands for that established term; it has no stable address in a published vocabulary yet, and a tie to one replaces this class when it is found."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:IPLG a owl:Class ; rdfs:subClassOf ifcore:ProductLedGrowth ; rdfs:label "Intellectual product-led growth"@en ; skos:altLabel "IPLG"@en ;
    skos:definition "Product-led growth applied to an intellectual product: a product whose value is knowledge, judgment or method made by a person or by an AI, such as a paper, a tool, a skill or a book's executable content. It is a subset and an elaboration of product-led growth, not a replacement for it. What sets it apart is the word 'intellectual', that is, the kind of product and who or what made it. The company's practice is to let a visitor complete one useful action with such a product before any commercial ask."@en ;
    rdfs:comment "Shared between 0006-research-and-ip (FR-012, FR-013), 0009-press (FR-016, FR-017 — a Fieldbook's executable content is IPLG applied to a book; promotion and diffusion of an intellectual product is Press's own territory), and 0011-studios (FR-020); no unit redefines it, per 0003-intellectual-frontiers FR-002."@en ;
    ifcore:hasAudience ifcore:Public .

# ───────────────────────── Studios portfolio (0011-studios FR-014 – FR-016; 0010-capital) ─────────────────────────

ifcore:portfolioCategory a owl:ObjectProperty ; rdfs:range ifcore:PortfolioCategory ;
    rdfs:comment "Which of 0011-studios' portfolio categories (venture, software, shared service, operating company) this organization, or this product of the portfolio, is classified as."@en .
ifcore:builtBy a owl:ObjectProperty ; rdfs:subPropertyOf dcterms:creator ; rdfs:range ifcore:Unit ;
    rdfs:comment "The unit that built this organization, or this product, as a venture, a shared service or a product of the portfolio, per 0011-studios FR-022: entity formation follows at least one experiment's evidence, it does not substitute for it."@en .
ifcore:portfolioCompany a owl:ObjectProperty ; rdfs:domain ifcore:Fund ; rdfs:range ifcore:Organization ;
    rdfs:comment "A company or shared service this fund holds. A fund's portfolio roster is point-in-time business data, not operating doctrine (0010-capital, Out of scope) — the same reasoning already applied to patent counts."@en .

ifcore:OurHakeem a ifcore:Organization ;
    rdfs:label "OurHakeem"@en ;
    ifcore:portfolioCategory ifcore:VentureCategory ;
    ifcore:builtBy ifcore:Studios ;
    rdfs:comment "Verified practitioner consults delivered online, with an operating stack behind the booking screen: intake, a longitudinal care record, agents that carry routine work, a clinician copilot, and the compliance apparatus a regulated consult requires."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:Payshent a ifcore:Organization ;
    rdfs:label "Payshent"@en ;
    ifcore:portfolioCategory ifcore:VentureCategory ;
    ifcore:builtBy ifcore:Studios ;
    rdfs:comment "An HSA card that pays patients a data dividend for consented, de-identified health data, built on HIPAA Expert Determination de-identification, transparent revocable consent, and IRB oversight for research partnerships."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:MedigyOpportunityAtlas a ifcore:Organization ;
    rdfs:label "Medigy Opportunity Atlas"@en ;
    ifcore:portfolioCategory ifcore:SharedServiceCategory ;
    ifcore:builtBy ifcore:Studios ;
    rdfs:comment "Finds reimbursed demand in healthcare and states it as a claims-defined cohort, geography, CMS signal, reimbursement codes, and revenue at stake — a shared service to every other Fund I venture and the intelligence spine of Fund II."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:MedigyDemandIntelligence a ifcore:Organization ;
    rdfs:label "Medigy Demand Intelligence"@en ;
    ifcore:portfolioCategory ifcore:SharedServiceCategory ;
    ifcore:builtBy ifcore:Studios ;
    rdfs:comment "A governed evaluation platform for hospitals and health systems: structured vendor evaluation by vetted evidence against internal need, in place of an unranked procurement queue."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:PatientTeamCom a ifcore:Organization ;
    rdfs:label "PatientTeam.com"@en ;
    ifcore:portfolioCategory ifcore:SharedServiceCategory ;
    ifcore:builtBy ifcore:Studios ;
    rdfs:comment "An execution layer turning the Microsoft 365 or Google Workspace a provider already pays for into a working digital front door, serving the portfolio as a shared front-door capability."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:Neuvist a ifcore:Organization ;
    rdfs:label "Neuvist"@en ;
    ifcore:portfolioCategory ifcore:SharedServiceCategory ;
    ifcore:builtBy ifcore:Studios ;
    rdfs:comment "A healthcare growth and care-access capability: AI-driven demand intelligence, orchestration, and routing that fills real provider capacity, serving the portfolio as a shared demand-and-access engine."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:Symvion a ifcore:Organization ;
    rdfs:label "Symvion"@en ;
    ifcore:portfolioCategory ifcore:SharedServiceCategory ;
    ifcore:builtBy ifcore:Studios ;
    rdfs:comment "A continuous clinical research infrastructure platform reading signals across consented health transaction data for earlier detection and continuous research; Payshent is its funding and consent layer."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:suppliesDataFor a owl:ObjectProperty ; rdfs:domain ifcore:Organization ; rdfs:range ifcore:Organization ;
    rdfs:comment "One portfolio organization provides data or infrastructure another's own product or research depends on — reused for any future case like it, not specific to this pair."@en .
ifcore:Payshent ifcore:suppliesDataFor ifcore:Symvion .

ifcore:RevenueAccelerationLLC a ifcore:Organization ;
    rdfs:label "Revenue Acceleration LLC"@en ;
    ifcore:portfolioCategory ifcore:VentureCategory ;
    ifcore:builtBy ifcore:Studios ;
    rdfs:comment "Revenue operations for post-acute care: durable medical equipment, home health, home infusion, home respiratory, and hospice."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:AmbientBiomarkersReferenceLab a ifcore:Organization ;
    rdfs:label "Ambient Biomarkers Reference Lab"@en ;
    ifcore:portfolioCategory ifcore:VentureCategory ;
    ifcore:builtBy ifcore:Studios ;
    rdfs:comment "A reference lab for biomarkers captured passively from ordinary sensors (voice, gait, respiration, facial expression, wearable and metabolic signals), standardized into panels and governed by an integrated review board and clinician network."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:ContinuousCareOS a ifcore:Organization ;
    rdfs:label "Continuous Care OS"@en ;
    ifcore:portfolioCategory ifcore:VentureCategory ;
    ifcore:builtBy ifcore:Studios ;
    rdfs:comment "An operating system for supervising an accountable digital care operation: a clinical leader reviews decisions, evidence, and billing as a queue of work with owners and dates."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:CareDeliveryFundI ifcore:portfolioCompany
    ifcore:OurHakeem, ifcore:Payshent, ifcore:MedigyOpportunityAtlas, ifcore:MedigyDemandIntelligence,
    ifcore:PatientTeamCom, ifcore:Neuvist, ifcore:Symvion, ifcore:RevenueAccelerationLLC,
    ifcore:AmbientBiomarkersReferenceLab, ifcore:ContinuousCareOS .

ifcore:HIRS a ifcore:Organization ;
    rdfs:label "HIRS"@en ;
    ifcore:portfolioCategory ifcore:VentureCategory ;
    ifcore:builtBy ifcore:Studios ;
    schema:url "https://www.hirshealth.com"^^xsd:anyURI ;
    rdfs:comment "A chronic care management and obesity management company operating in the Kingdom of Saudi Arabia, incubated by Studios. Its own site (Hirs Health Solutions, Riyadh) states its mission as to 'innovate using science and state of the art technologies to help people be better informed, make better health decisions, and maintain healthier lives,' through an AI-driven wellness-profile, digital-health, and predictive-health-modeling platform (hirshealth.com, fetched 2026-10-02, not otherwise re-verified). Not yet linked to any specific Capital fund."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:Handova a ifcore:Organization ;
    rdfs:label "Handova"@en ;
    ifcore:portfolioCategory ifcore:VentureCategory ;
    ifcore:builtBy ifcore:Studios ;
    rdfs:comment "A code name for a company Studios is incubating; not yet a confirmed final name. Fuller detail — its own Eidolon content — is pending from the founder and has not been supplied as of this writing."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:NyNikaTMcFadden a ifcore:Person ;
    ifcore:legalName "Ny'Nika T. McFadden"@en ;
    rdfs:comment "Dr. Ny'Nika T. McFadden, co-founder of ifcore:Handova; Texas State University."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:Handova schema:founder ifcore:NyNikaTMcFadden, ifcore:ShahidNehalShah .

ifcore:UnblockHealth a ifcore:Organization ;
    rdfs:label "Unblock Health"@en ;
    ifcore:portfolioCategory ifcore:VentureCategory ;
    ifcore:builtBy ifcore:Studios ;
    schema:url "https://www.unblock.health/"^^xsd:anyURI ;
    rdfs:comment "A FHIR-native digital platform replacing the manual, fragmented patient medical-record-access and record-correction request workflow with a centralized, trackable one, serving patient advocates and hospital Health Information Management (HIM) professionals; offers Individual Access Services (IAS). Co-founded at HIT Expo 2018 in New Orleans (unblock.health, fetched 2026-10-02, not otherwise re-verified)."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:GraceCordovano a ifcore:Person ;
    ifcore:legalName "Grace Cordovano"@en ;
    rdfs:comment "Grace Cordovano, PhD, BCPA (Board Certified Patient Advocate); co-founder of ifcore:UnblockHealth alongside ifcore:ShahidNehalShah, and separately runs her own independent practice, Enlightening Results. Over 20 years of patient-advocacy experience, oncology-space specialization; contributor to the U.S. Core Data for Interoperability Taskforce and the HITAC Interoperability Standards Work Group (public LinkedIn and press sources, not independently verified beyond that)."@en ;
    schema:sameAs <https://www.linkedin.com/in/gcordovano/> ;
    ifcore:hasAudience ifcore:Public .

ifcore:UnblockHealth schema:founder ifcore:GraceCordovano, ifcore:ShahidNehalShah .

# ───────────────────────── Operational Truth and its family (0045-elenchus-works; 0011-studios FR-015) ─────────────────────────
# Operational Truth is the company's productized implementation of the Elenchus pattern. Opsfolio is the portfolio's name
# and the compliance system of record in it; surveilr gathers the evidence, Fleetfolio holds the asset and boundary
# inventory and tests exposure, Qualityfolio manages the tests, and Spry runs executable Markdown. Each is an Intellectual
# Frontiers Studios product and each name is a trademark the company holds. Intellectual Frontiers LLC is the rights-holder
# of every one (0005-holding-and-family-office FR-001); the company that builds and operates them is a vault fact.

ifcore:OperationalTruth a schema:SoftwareApplication ;
    dcterms:type ifcore:SolutionOffer ;
    rdfs:label "Operational Truth"@en ;
    ifcore:portfolioCategory ifcore:SoftwareCategory ;
    ifcore:builtBy ifcore:Studios ;
    dcterms:rightsHolder ifcore:IntellectualFrontiersLLC ;
    rdfs:comment "The company's productized implementation of the Elenchus methodology: a solution (0049-platforms FR-004) built on the Opsfolio platform, which holds intent as code, compares it continuously with evidence collected from the operation itself, and reports the difference as a truth gap or as unmanaged risk. It operationalizes the Elenchus methodology (0048-noemas FR-007) and is carried out by the Opsfolio family. Written Operational Truth® where it names this solution and operational truth, in lowercase, where it names the general idea (0045-elenchus-works FR-040). Its license and current status are not yet recorded (0011-studios FR-015)."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:Opsfolio a ifcore:Platform ;
    rdfs:label "Opsfolio"@en ;
    ifcore:portfolioCategory ifcore:SoftwareCategory ;
    ifcore:builtBy ifcore:Studios ;
    dcterms:rightsHolder ifcore:IntellectualFrontiersLLC ;
    dcterms:relation ifcore:OperationalTruth ;
    schema:url "https://opsfolio.com"^^xsd:anyURI ;
    rdfs:comment "The portfolio name of the Operational Truth family, and the compliance system of record in it. In operation, per its public site on 2026-10-04. Its license is not yet recorded (0011-studios FR-015)."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:Surveilr a schema:SoftwareApplication ;
    rdfs:label "surveilr"@en ;
    ifcore:portfolioCategory ifcore:SoftwareCategory ;
    ifcore:builtBy ifcore:Studios ;
    dcterms:rightsHolder ifcore:IntellectualFrontiersLLC ;
    dcterms:isPartOf ifcore:Opsfolio ;
    schema:url "https://surveilr.com"^^xsd:anyURI ;
    rdfs:comment "The Resource Surveillance & Integration Engine for Operational Truth: it ingests files, command output, mail and issue trackers into a local-first SQLite database, the RSSD, that SQL can query. In operation, per its public site on 2026-10-04. Its license is not yet recorded (0011-studios FR-015); whether its records are tamper-evident is 0045-elenchus-works OQ-7."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:Fleetfolio a schema:SoftwareApplication ;
    rdfs:label "Fleetfolio"@en ;
    ifcore:portfolioCategory ifcore:SoftwareCategory ;
    ifcore:builtBy ifcore:Studios ;
    dcterms:rightsHolder ifcore:IntellectualFrontiersLLC ;
    dcterms:isPartOf ifcore:Opsfolio ;
    schema:url "https://fleetfolio.dev"^^xsd:anyURI ;
    rdfs:comment "Evidence-based asset and boundary management, endpoint detection and penetration-test orchestration, built on surveilr: it reconciles the assets that are expected with the assets observed. In operation, per its public site on 2026-10-04. Its license is not yet recorded (0011-studios FR-015)."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:Qualityfolio a schema:SoftwareApplication ;
    rdfs:label "Qualityfolio"@en ;
    ifcore:portfolioCategory ifcore:SoftwareCategory ;
    ifcore:builtBy ifcore:Studios ;
    dcterms:rightsHolder ifcore:IntellectualFrontiersLLC ;
    dcterms:isPartOf ifcore:Opsfolio ;
    schema:url "https://qualityfolio.dev"^^xsd:anyURI ;
    rdfs:comment "The test management layer of surveilr: tests are written as Markdown with YAML front matter in Git, run from the command line or a pipeline, and their results are kept as evidence that expected tests are compared with. In operation, per its public site on 2026-10-04. Its license is not yet recorded (0011-studios FR-015)."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:Spry a schema:SoftwareApplication ;
