ifcore:OpsfolioCommitmentLedgerErgon a ifcore:Ergon ; ifcore:reflects ifcore:OpsfolioCommitmentLedger ;
    ifcore:purpose "Records each promise a control owner, an engineer or a vendor makes, such as the remedy of an exception, who owns it now and what evidence closes it."@en ; ifcore:ownerRole ifcore:DecisionAuthorityRole ; ifcore:hasAudience ifcore:Public .

ifcore:OpsfolioControlCatalog a ifcore:PlatformModule ; rdfs:label "Opsfolio Control Catalog"@en ;
