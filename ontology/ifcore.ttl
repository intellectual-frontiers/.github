    ifcore:platformLayer ifcore:OrthogonalLayer ; ifcore:hasAudience ifcore:Public .
ifcore:OpsfolioAssuranceEnvironmentErgon a ifcore:Ergon ; ifcore:reflects ifcore:OpsfolioAssuranceEnvironment ;
    ifcore:purpose "Tests and shows the platform fit in a sandbox with realistic synthetic data or de-identified customer data, separate from production."@en ; ifcore:ownerRole ifcore:DecisionAuthorityRole ; ifcore:hasAudience ifcore:Public .

ifcore:OpsfolioCommitmentLedger a ifcore:PlatformModule ; rdfs:label "Opsfolio Commitment Ledger"@en ;
