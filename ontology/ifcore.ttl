ifcore:TSC-CC6-5 a skos:Concept ; skos:inScheme ifcore:TrustServicesCriteria ; skos:notation "CC6.5" ; skos:prefLabel "CC6.5"@en ; ifcore:hasAudience ifcore:Public .
