@prefix ifcore:  <https://www.intellectualfrontiers.com/ontology/core#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix schema:  <https://schema.org/> .
@prefix org:     <http://www.w3.org/ns/org#> .

# Intellectual Frontiers — core ontology (PUBLIC).
#
# Implements 0001-eidolon-architecture. Every class, property, and individual
# here traces to a requirement in that spec; nothing is asserted ahead of it
# (FR-037). A private ontology imports this and adds its own individuals; it
# must not redefine or remove anything declared here (FR-003).
#
# Every individual that carries asserted factual content (a label naming a
# real thing, a definition, a job, a question) declares ifcore:hasAudience
# explicitly, per FR-011 — never left implicit from being in a public
# repository. A class or property declaration (the vocabulary itself) is not
# a fact and does not carry one.

<https://www.intellectualfrontiers.com/ontology/core>
    a owl:Ontology ;
    owl:versionInfo "0.1.0" ;
    dcterms:title "Intellectual Frontiers core ontology"@en ;
    dcterms:source <https://github.com/intellectual-frontiers/.github/blob/main/spec-kit/specs/0001-eidolon-architecture/spec.md> ;
    rdfs:comment "The company, the Eidolon's own repositories, audiences, references, and governance, per 0001-eidolon-architecture."@en .

# ───────────────────────── Organization ─────────────────────────

ifcore:Organization a owl:Class ; rdfs:label "Organization"@en .
ifcore:Company a owl:Class ; rdfs:subClassOf ifcore:Organization ; rdfs:label "Company"@en .
ifcore:Person a owl:Class ; rdfs:label "Person"@en .

ifcore:legalName a owl:DatatypeProperty ; rdfs:domain ifcore:Person ; rdfs:range xsd:string ;
    rdfs:comment "A person's full legal name, as it would appear on a signed document."@en .
ifcore:displayName a owl:DatatypeProperty ; rdfs:domain ifcore:Person ; rdfs:range xsd:string ;
    rdfs:comment "The name a person is known by in ordinary prose and branding."@en .

ifcore:IntellectualFrontiersLLC a ifcore:Company ;
    rdfs:label "Intellectual Frontiers LLC"@en ;
    schema:slogan "A think tank that builds useful things."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:ShahidNehalShah a ifcore:Person ;
    ifcore:legalName "Shahid Nehal Shah"@en ;
    ifcore:displayName "Shahid N. Shah"@en ;
    ifcore:hasAudience ifcore:Public .

# ───────────────────────── The Eidolon's own repositories (FR-001) ─────────────────────────

ifcore:EidolonComponent a owl:Class ; rdfs:label "Eidolon component"@en ;
    rdfs:comment "One of the Eidolon's three repositories: the public Eidolon, the private Eidolon where works are made, and one presentation channel for them (FR-001)."@en .

ifcore:PublicRoot a ifcore:EidolonComponent ; rdfs:label "Public root"@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:PrivateVault a ifcore:EidolonComponent ; rdfs:label "Private vault"@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:WebProperty a ifcore:EidolonComponent ; rdfs:label "Web property"@en ;
    rdfs:comment "A channel through which presentations of works reach an audience. It holds no work of its own (FR-001; 0021-works-and-presentations FR-011)."@en ;
    ifcore:hasAudience ifcore:Public .

# ───────────────────────── Design systems (0014-design-systems) ─────────────────────────

ifcore:DesignSystem a owl:Class ; rdfs:label "Design system"@en ;
    rdfs:comment "A named, self-contained, versionable set of public house rules for one kind of output, with their machine-readable form, assets and assurance harness, at design-systems/<slug>/, per 0014-design-systems FR-001, FR-010. Its kind is dcterms:type, a concept in ifcore:DesignSystemKindScheme (FR-018); each design system it derives from is prov:wasDerivedFrom (FR-020)."@en .

ifcore:designSystemStatus a owl:ObjectProperty ; rdfs:domain ifcore:DesignSystem ; rdfs:range ifcore:DesignSystemStatus ;
    rdfs:comment "The one record of whether a design system is active or draft (0014-design-systems FR-010, FR-011) — never its own README. A design system no longer used is removed, not given a status (FR-035)."@en .

ifcore:DesignSystemStatus a owl:Class ; rdfs:label "Design system status"@en .
ifcore:ActiveDesignSystem a ifcore:DesignSystemStatus ; rdfs:label "Active"@en ; ifcore:hasAudience ifcore:Public .
ifcore:DraftDesignSystem a ifcore:DesignSystemStatus ; rdfs:label "Draft"@en ; ifcore:hasAudience ifcore:Public .

ifcore:DesignSystemKindScheme a skos:ConceptScheme ; rdfs:label "Design system kind"@en ;
    rdfs:comment "What a design system governs (0014-design-systems FR-018). A concept is in this scheme only if 0014-design-systems has a kind profile for it (FR-019), and its skos:notation is the code that ends the slug of every design system of that kind (FR-003, FR-018); a broader concept groups kinds, has no code, and is never itself a design system's kind."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:VisualDesignSystemKind a skos:Concept ; skos:inScheme ifcore:DesignSystemKindScheme ; skos:prefLabel "visual"@en ;
    skos:definition "Kinds that govern how output looks."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:VerbalDesignSystemKind a skos:Concept ; skos:inScheme ifcore:DesignSystemKindScheme ; skos:prefLabel "verbal"@en ;
    skos:definition "Kinds that govern how output reads or sounds."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:BrandDesignSystemKind a skos:Concept ; skos:inScheme ifcore:DesignSystemKindScheme ; skos:prefLabel "brand"@en ;
    skos:notation "brand" ;
    skos:definition "The identity every other kind draws on: palette, typeface families, logo, imagery identity (0014-design-systems FR-028)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:WebDesignSystemKind a skos:Concept ; skos:inScheme ifcore:DesignSystemKindScheme ; skos:broader ifcore:VisualDesignSystemKind ; skos:prefLabel "web presentation"@en ;
    skos:notation "web" ;
    skos:definition "How a web page looks and the DOM shape its interactive chrome expects (0014-design-systems FR-029)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:PrintDesignSystemKind a skos:Concept ; skos:inScheme ifcore:DesignSystemKindScheme ; skos:broader ifcore:VisualDesignSystemKind ; skos:prefLabel "print"@en ;
    skos:notation "print" ;
    skos:definition "How a printed or ebook book, paper or cover is set (0014-design-systems FR-031)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:MerchandiseDesignSystemKind a skos:Concept ; skos:inScheme ifcore:DesignSystemKindScheme ; skos:broader ifcore:VisualDesignSystemKind ; skos:prefLabel "merchandise"@en ;
    skos:notation "merchandise" ;
    skos:altLabel "branded merchandise"@en , "promotional products"@en ;
    skos:definition "How the brand is applied to physical goods: decoration method, imprint location and size, ink and thread (0014-design-systems FR-045)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:FigureDesignSystemKind a skos:Concept ; skos:inScheme ifcore:DesignSystemKindScheme ; skos:broader ifcore:VisualDesignSystemKind ; skos:prefLabel "figure"@en ;
    skos:notation "figures" ;
    skos:definition "How a work's figures are drawn, in print or on the web (0014-design-systems FR-032)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:WrittenVoiceDesignSystemKind a skos:Concept ; skos:inScheme ifcore:DesignSystemKindScheme ; skos:broader ifcore:VerbalDesignSystemKind ; skos:prefLabel "written voice"@en ;
    skos:notation "written-voice" ;
    skos:definition "How the house writes: voice, usage, punctuation, and presentation form (0014-design-systems FR-033)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:SpokenVoiceDesignSystemKind a skos:Concept ; skos:inScheme ifcore:DesignSystemKindScheme ; skos:broader ifcore:VerbalDesignSystemKind ; skos:prefLabel "spoken voice"@en ;
    skos:notation "spoken-voice" ;
    skos:definition "How the house voice changes when a work is heard rather than read; always derived from a written-voice design system (0014-design-systems FR-034)."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:WebInteractionModelScheme a skos:ConceptScheme ; rdfs:label "Web interaction model"@en ;
    rdfs:comment "What a web design system's pages are for (0014-design-systems FR-041): a read-mostly content site or a read-write web application, and the kinds of each. A web design system names every one it serves, by dcterms:type."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:ContentSite a skos:Concept ; skos:inScheme ifcore:WebInteractionModelScheme ; skos:prefLabel "content site"@en ;
    skos:definition "A read-mostly site: people come to read, compare and decide."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:MarketingSite a skos:Concept ; skos:inScheme ifcore:WebInteractionModelScheme ; skos:broader ifcore:ContentSite ; skos:prefLabel "marketing site"@en ;
    skos:definition "Pages that present an offer and lead to one action: landing pages, product pages."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:EditorialSite a skos:Concept ; skos:inScheme ifcore:WebInteractionModelScheme ; skos:broader ifcore:ContentSite ; skos:prefLabel "editorial site"@en ;
    skos:definition "Long-form reading: articles, essays, issues of a publication."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:DocumentationSite a skos:Concept ; skos:inScheme ifcore:WebInteractionModelScheme ; skos:broader ifcore:ContentSite ; skos:prefLabel "documentation"@en ;
    skos:definition "Tutorials, how-to guides, reference and explanation, as the Diataxis framework divides them."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:WebApplication a skos:Concept ; skos:inScheme ifcore:WebInteractionModelScheme ; skos:prefLabel "web application"@en ;
    skos:definition "A read-write application: people come to create, change and act on records."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:ProductApplication a skos:Concept ; skos:inScheme ifcore:WebInteractionModelScheme ; skos:broader ifcore:WebApplication ; skos:prefLabel "product application"@en ;
    skos:definition "The application a product sells to its customers (software as a service)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:BackOffice a skos:Concept ; skos:inScheme ifcore:WebInteractionModelScheme ; skos:broader ifcore:WebApplication ; skos:prefLabel "back office"@en ;
    skos:definition "Internal tools for the people who operate a business."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:Dashboard a skos:Concept ; skos:inScheme ifcore:WebInteractionModelScheme ; skos:broader ifcore:WebApplication ; skos:prefLabel "dashboard"@en ;
    skos:definition "Monitoring and reporting at a glance: figures, status, trends."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:TransactionalService a skos:Concept ; skos:inScheme ifcore:WebInteractionModelScheme ; skos:broader ifcore:WebApplication ; skos:prefLabel "transactional service"@en ;
    skos:definition "A multi-step task completed once: sign-up, checkout, an application (GOV.UK names these transactional services)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:DesignExpressionScheme a skos:ConceptScheme ; rdfs:label "Design expression"@en ;
    rdfs:comment "How much a web design system's type and motion assert themselves (0014-design-systems FR-041), as IBM's Carbon design system names the two ends. A web design system is exactly one."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:ProductiveExpression a skos:Concept ; skos:inScheme ifcore:DesignExpressionScheme ; skos:prefLabel "productive"@en ;
    skos:definition "Calm, dense, efficient type and motion that keep attention on the task."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:ExpressiveExpression a skos:Concept ; skos:inScheme ifcore:DesignExpressionScheme ; skos:prefLabel "expressive"@en ;
    skos:definition "Larger type, more motion and imagery, for marketing and editorial moments."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:DesignDensityScheme a skos:ConceptScheme ; rdfs:label "Design density"@en ;
    rdfs:comment "How much a web design system fits in a space (0014-design-systems FR-041), as Material Design names the steps. A web design system names every density it supports."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:DefaultDensity a skos:Concept ; skos:inScheme ifcore:DesignDensityScheme ; skos:prefLabel "default"@en ;
    skos:definition "The standard spacing of controls and rows."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:ComfortableDensity a skos:Concept ; skos:inScheme ifcore:DesignDensityScheme ; skos:prefLabel "comfortable"@en ;
    skos:definition "Tighter than default, for screens people scan often."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:CompactDensity a skos:Concept ; skos:inScheme ifcore:DesignDensityScheme ; skos:prefLabel "compact"@en ;
    skos:definition "The tightest spacing, for data-dense tables and tools."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:PrintDocumentTypeScheme a skos:ConceptScheme ; rdfs:label "Print document type"@en ;
    rdfs:comment "What a print design system sets (0014-design-systems FR-042), as publishing names it. A print design system names every one it sets, by dcterms:type."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:BookInterior a skos:Concept ; skos:inScheme ifcore:PrintDocumentTypeScheme ; skos:prefLabel "book interior"@en ;
    skos:definition "The pages of a printed or ebook book between its covers."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:BookCover a skos:Concept ; skos:inScheme ifcore:PrintDocumentTypeScheme ; skos:prefLabel "book cover"@en ;
    skos:definition "The front cover, spine and back cover of a book."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:JournalArticle a skos:Concept ; skos:inScheme ifcore:PrintDocumentTypeScheme ; skos:prefLabel "journal article"@en ;
    skos:definition "A research paper set as a journal sets one."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:Report a skos:Concept ; skos:inScheme ifcore:PrintDocumentTypeScheme ; skos:prefLabel "report"@en ;
    skos:definition "A standalone document of findings, set for print or PDF."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:DecorationMethodScheme a skos:ConceptScheme ; rdfs:label "Decoration method"@en ;
    rdfs:comment "How a merchandise design system puts artwork on goods (0014-design-systems FR-046), as the promotional products industry names it."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:ScreenPrinting a skos:Concept ; skos:inScheme ifcore:DecorationMethodScheme ; skos:prefLabel "screen printing"@en ;
    skos:definition "Spot-color ink pushed through a mesh stencil, one screen per color."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:Embroidery a skos:Concept ; skos:inScheme ifcore:DecorationMethodScheme ; skos:prefLabel "embroidery"@en ;
    skos:definition "Artwork stitched in thread."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:PadPrinting a skos:Concept ; skos:inScheme ifcore:DecorationMethodScheme ; skos:prefLabel "pad printing"@en ;
    skos:definition "Spot-color ink transferred by a silicone pad onto a small or curved surface."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:LaserEngraving a skos:Concept ; skos:inScheme ifcore:DecorationMethodScheme ; skos:prefLabel "laser engraving"@en ;
    skos:definition "Artwork burned or etched into the surface; the material is the only color."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:DirectToGarmentPrinting a skos:Concept ; skos:inScheme ifcore:DecorationMethodScheme ; skos:prefLabel "direct-to-garment printing"@en ;
    skos:definition "Full-color inkjet printing onto fabric."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:Debossing a skos:Concept ; skos:inScheme ifcore:DecorationMethodScheme ; skos:prefLabel "debossing"@en ;
    skos:definition "Artwork pressed into the material, with no ink."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:ProductCategoryScheme a skos:ConceptScheme ; rdfs:label "Product category"@en ;
    rdfs:comment "What goods a merchandise design system governs (0014-design-systems FR-046), as the promotional products industry names them."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:Apparel a skos:Concept ; skos:inScheme ifcore:ProductCategoryScheme ; skos:prefLabel "apparel"@en ;
    skos:definition "Shirts, polos and other garments."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:Headwear a skos:Concept ; skos:inScheme ifcore:ProductCategoryScheme ; skos:prefLabel "headwear"@en ;
    skos:definition "Caps and hats."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:Drinkware a skos:Concept ; skos:inScheme ifcore:ProductCategoryScheme ; skos:prefLabel "drinkware"@en ;
    skos:definition "Mugs, tumblers and bottles."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:WritingInstruments a skos:Concept ; skos:inScheme ifcore:ProductCategoryScheme ; skos:prefLabel "writing instruments"@en ;
    skos:definition "Pens and pencils."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:Bags a skos:Concept ; skos:inScheme ifcore:ProductCategoryScheme ; skos:prefLabel "bags"@en ;
    skos:definition "Totes and other bags."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:FrontiersBrand a ifcore:DesignSystem ;
    dcterms:identifier "frontiers-brand" ;
    rdfs:label "Frontiers Brand"@en ;
    ifcore:designSystemStatus ifcore:ActiveDesignSystem ;
    dcterms:type ifcore:BrandDesignSystemKind ;
    rdfs:comment "At design-systems/frontiers-brand/; its house rules are design-systems/frontiers-brand/spec.md. Intellectual Frontiers' own identity: palette, theme roles, unit colors, typefaces, logo, icon and imagery (0014-design-systems FR-028). It themes the Intellectual Frontiers web design systems (FR-038)."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:ExampleBrand a ifcore:DesignSystem ;
    dcterms:identifier "example-brand" ;
    rdfs:label "Example Brand"@en ;
    ifcore:designSystemStatus ifcore:DraftDesignSystem ;
    dcterms:type ifcore:BrandDesignSystemKind ;
    rdfs:comment "At design-systems/example-brand/; its house rules are design-systems/example-brand/spec.md. A test brand, deliberately not Intellectual Frontiers', that every web design system is run themed by, to prove it can be themed by any brand (0014-design-systems FR-039). Never used to publish."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:FrontiersPrint a ifcore:DesignSystem ;
    dcterms:identifier "frontiers-print" ;
    rdfs:label "Frontiers Print"@en ;
    ifcore:designSystemStatus ifcore:DraftDesignSystem ;
    dcterms:type ifcore:PrintDesignSystemKind , ifcore:BookInterior , ifcore:BookCover , ifcore:JournalArticle ;
    rdfs:comment "At design-systems/frontiers-print/; its house rules are design-systems/frontiers-print/spec.md. The book interior, book cover and journal article design, in LaTeX, themed by a brand's brand.tex (0014-design-systems FR-031, FR-038)."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:FrontiersMerchandise a ifcore:DesignSystem ;
    dcterms:identifier "frontiers-merchandise" ;
    rdfs:label "Frontiers Merchandise"@en ;
    ifcore:designSystemStatus ifcore:DraftDesignSystem ;
    dcterms:type ifcore:MerchandiseDesignSystemKind , ifcore:ScreenPrinting , ifcore:Embroidery , ifcore:PadPrinting , ifcore:LaserEngraving , ifcore:DirectToGarmentPrinting , ifcore:Debossing , ifcore:Apparel , ifcore:Headwear , ifcore:Drinkware , ifcore:WritingInstruments , ifcore:Bags ;
    rdfs:comment "At design-systems/frontiers-merchandise/; its house rules are design-systems/frontiers-merchandise/spec.md. How the brand goes on apparel, headwear, drinkware, writing instruments and bags, themed by a brand's decoration kit (0014-design-systems FR-045, FR-047)."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:FrontiersNatureWeb a ifcore:DesignSystem ;
    dcterms:identifier "frontiers-nature-web" ;
    rdfs:label "Frontiers Nature Web"@en ;
    ifcore:designSystemStatus ifcore:ActiveDesignSystem ;
    dcterms:type ifcore:WebDesignSystemKind , ifcore:EditorialSite , ifcore:MarketingSite , ifcore:ExpressiveExpression , ifcore:DefaultDensity ;
    rdfs:comment "At design-systems/frontiers-nature-web/; its house rules are design-systems/frontiers-nature-web/spec.md. Intellectual Frontiers' public, editorial web presentation."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:FrontiersConsoleWeb a ifcore:DesignSystem ;
    dcterms:identifier "frontiers-console-web" ;
    rdfs:label "Frontiers Console Web"@en ;
    ifcore:designSystemStatus ifcore:DraftDesignSystem ;
    dcterms:type ifcore:WebDesignSystemKind , ifcore:DocumentationSite , ifcore:BackOffice , ifcore:Dashboard , ifcore:ProductiveExpression , ifcore:DefaultDensity ;
    rdfs:comment "At design-systems/frontiers-console-web/; its house rules are design-systems/frontiers-console-web/spec.md. Operator (admin) and documentation web surfaces: a sidebar, navbar, page and table-of-contents shell in three selectable layouts, documentation and administration components."@en ;
    ifcore:hasAudience ifcore:Public .

# ───────────────────────── Facts and audiences (FR-011 – FR-015) ─────────────────────────

ifcore:Fact a owl:Class ; rdfs:label "Fact"@en ;
    rdfs:comment "Anything asserted in the Eidolon that carries factual content. Every fact MUST declare its audience explicitly (FR-011); a class or property declaration is vocabulary, not a fact, and does not need one."@en .

ifcore:Audience a owl:Class ; rdfs:label "Audience"@en ;
    rdfs:comment "A named permission to see a fact."@en .
ifcore:Public a ifcore:Audience ; rdfs:label "Public"@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:CompanyAffiliated a ifcore:Audience ; rdfs:label "Anyone affiliated with the company"@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:Agreement a owl:Class ; rdfs:subClassOf ifcore:Audience ; rdfs:label "A specific named agreement"@en .
ifcore:RoleOrGroup a owl:Class ; rdfs:subClassOf ifcore:Audience ; rdfs:label "A specific named role or group"@en .

ifcore:hasAudience a owl:ObjectProperty ; rdfs:domain ifcore:Fact ; rdfs:range ifcore:Audience ;
    rdfs:comment "Disjunctive: a viewer satisfying any one listed audience may see the fact."@en .

# ───────────────────────── References (FR-015, FR-022 – FR-027) ─────────────────────────

ifcore:Reference a owl:Class ; rdfs:subClassOf ifcore:Fact ; rdfs:label "Reference"@en ;
    rdfs:comment "A fact that points at a value held elsewhere rather than storing it."@en .
ifcore:describes a owl:ObjectProperty ; rdfs:domain ifcore:Reference ;
    rdfs:comment "The fact or subject this reference is about."@en .

ifcore:ExternalRecordReference a owl:Class ; rdfs:subClassOf ifcore:Reference ;
    rdfs:label "External record reference"@en ;
    rdfs:comment "Points at a fact Intellectual Frontiers does not author or control."@en .
ifcore:primarySource a owl:DatatypeProperty ; rdfs:domain ifcore:ExternalRecordReference ; rdfs:range xsd:anyURI .
ifcore:cachedValue a owl:DatatypeProperty ; rdfs:domain ifcore:ExternalRecordReference ;
    rdfs:comment "Optional. If present, resolvedAt MUST also be present."@en .
ifcore:resolvedAt a owl:DatatypeProperty ; rdfs:domain ifcore:ExternalRecordReference ; rdfs:range xsd:date ;
    rdfs:comment "Required for any static or non-live rendering of cachedValue."@en .
ifcore:verificationCadence a owl:DatatypeProperty ; rdfs:domain ifcore:ExternalRecordReference ; rdfs:range xsd:duration ;
    rdfs:comment "How often this reference's cached value must be re-verified."@en .
ifcore:verificationMethod a owl:DatatypeProperty ; rdfs:domain ifcore:ExternalRecordReference ; rdfs:range xsd:string ;
    rdfs:comment "\"automated\" or \"manual\"."@en .

ifcore:RestrictedDataReference a owl:Class ; rdfs:subClassOf ifcore:Reference ;
    rdfs:label "Restricted data reference"@en ;
    rdfs:comment "Points at a sensitive fact Intellectual Frontiers authors but excludes from every Eidolon repository. Deliberately carries no property capable of holding the fact's actual value."@en .
ifcore:heldIn a owl:DatatypeProperty ; rdfs:domain ifcore:RestrictedDataReference ; rdfs:range xsd:string ;
    rdfs:comment "The external system that holds the real data."@en .
ifcore:accessInstructions a owl:DatatypeProperty ; rdfs:domain ifcore:RestrictedDataReference ; rdfs:range xsd:string ;
    rdfs:comment "How a properly authorized person obtains access. MUST NOT be, or contain, a credential."@en .

# ───────────────────────── Governance (FR-028 – FR-033) ─────────────────────────

ifcore:DecisionOutcome a owl:Class ; rdfs:label "Decision outcome"@en ;
    rdfs:comment "One of the five decision-checkpoint outcomes."@en .
ifcore:Continue a ifcore:DecisionOutcome ; rdfs:label "Continue"@en ; ifcore:hasAudience ifcore:Public .
ifcore:Change a ifcore:DecisionOutcome ; rdfs:label "Change"@en ; ifcore:hasAudience ifcore:Public .
ifcore:BackSomeoneElse a ifcore:DecisionOutcome ; rdfs:label "Back someone else"@en ; ifcore:hasAudience ifcore:Public .
ifcore:BuildIt a ifcore:DecisionOutcome ; rdfs:label "Build it"@en ; ifcore:hasAudience ifcore:Public .
ifcore:Stop a ifcore:DecisionOutcome ; rdfs:label "Stop"@en ; ifcore:hasAudience ifcore:Public .

ifcore:Decision a owl:Class ; rdfs:subClassOf ifcore:Fact, prov:Entity ; rdfs:label "Decision"@en ;
    rdfs:comment "One coherent recorded choice (0008-decision-records FR-003). Routine operational activity is not a Decision. MUST carry its own ifcore:hasAudience when recorded — not necessarily Public — and MUST carry decidedBy (0008 FR-002)."@en .
ifcore:hasOutcome a owl:ObjectProperty ; rdfs:domain ifcore:Decision ; rdfs:range ifcore:DecisionOutcome ;
    rdfs:comment "Required only for a decision resolving a Native Alpha thesis question (0001 FR-031, 0008 FR-004). Not a measure of whether the record is still current — see dcterms:isReplacedBy."@en .
ifcore:decidedAt a owl:DatatypeProperty ; rdfs:domain ifcore:Decision ; rdfs:range xsd:date ;
    rdfs:comment "A decision is checked against the authority in effect on this date, not the date of later review."@en .
ifcore:decidedBy a owl:ObjectProperty ; rdfs:domain ifcore:Decision ; rdfs:range ifcore:Person ;
    rdfs:comment "Required on every Decision (0008-decision-records FR-002)."@en .
ifcore:consideredEvidence a owl:ObjectProperty ; rdfs:domain ifcore:Decision ; rdfs:range ifcore:Fact ;
    rdfs:comment "A tracked fact that informed the decision (0008 FR-005). Not prov:used: PROV-O declares Entity and Activity disjoint, Decision is a prov:Entity, and used's domain is Activity — reusing it directly on a Decision would conflict. Where no tracked fact exists, use dcterms:description for a plain-text rationale instead."@en .

ifcore:Alternative a owl:Class ; rdfs:label "Alternative"@en ;
    rdfs:comment "An option considered and rejected when making a decision (0008-decision-records FR-006)."@en .
ifcore:consideredAlternative a owl:ObjectProperty ; rdfs:domain ifcore:Decision ; rdfs:range ifcore:Alternative .
ifcore:rejectionReason a owl:DatatypeProperty ; rdfs:domain ifcore:Alternative ; rdfs:range xsd:string .

# dcterms:isReplacedBy (reused, not redeclared) states whether a Decision is still
# current, independent of its hasOutcome (0008 FR-008). A Decision's own
# prov:wasGeneratedBy MAY point at the activity that produced it, when that
# activity is tracked; nothing it caused afterward needs restating here — that
# fact's own prov:wasGeneratedBy points back at this Decision instead (0008 FR-007).

ifcore:defaultDecisionAuthority a owl:ObjectProperty ; rdfs:domain ifcore:Company ; rdfs:range ifcore:Person ;
    rdfs:comment "The person holding authority over every domain not explicitly delegated elsewhere."@en .
ifcore:IntellectualFrontiersLLC ifcore:defaultDecisionAuthority ifcore:ShahidNehalShah .

# ───────────────────────── Units (0003-intellectual-frontiers FR-001) ─────────────────────────

ifcore:Unit a owl:Class ; rdfs:subClassOf org:OrganizationalUnit ; rdfs:label "Unit"@en ;
    rdfs:comment "A part of the company with exactly one job and one question — the W3C Organization Ontology's org:OrganizationalUnit, specialized to that one constraint (0019-controlled-vocabulary FR-002). A unit is known, but never the subject of a public presentation: it appears there only as provenance, such as a byline or imprint (0021-works-and-presentations FR-014, FR-016, FR-017)."@en .
ifcore:job a owl:DatatypeProperty ; rdfs:domain ifcore:Unit ; rdfs:range xsd:string ;
    rdfs:comment "The one job a unit exists to do."@en .
ifcore:question a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "The one question a unit, or a method stage, exists to answer."@en .

ifcore:hasUnit a owl:ObjectProperty ; rdfs:domain ifcore:Company ; rdfs:range ifcore:Unit .
ifcore:unitOf a owl:ObjectProperty ; owl:inverseOf ifcore:hasUnit .

ifcore:ResearchAndIp a ifcore:Unit ;
    rdfs:label "Intellectual Frontiers Research & IP"@en ;
    ifcore:job "Run the research and protect and commercialize what it produces"@en ;
    ifcore:question "What do we know, own, control, or have rights to that may create unusual advantage?"@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:Press a ifcore:Unit ;
    rdfs:label "Intellectual Frontiers Press"@en ;
    schema:alternateName "Intellectual Frontiers Publications"@en, "IF Publications"@en ;
    rdfs:comment "The formal name governs specs and the ontology. The alternate name is for public-facing contexts (a website, a byline) where 'Press' risks being read as a press-and-media destination rather than the unit that creates books, spoken works, and research reports (0003-intellectual-frontiers FR-013)."@en ;
    ifcore:job "Understand markets and explain the truth clearly"@en ;
    ifcore:question "What do we understand that is worth making clearer, more useful, and more durable?"@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:Capital a ifcore:Unit ;
    rdfs:label "Intellectual Frontiers Capital"@en ;
    ifcore:job "Put money behind evidence with discipline"@en ;
    ifcore:question "What advantage is strong enough that scarce capital should be placed behind it?"@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:operates a owl:ObjectProperty ; rdfs:domain ifcore:Unit ; rdfs:range ifcore:Fund .
ifcore:Studios a ifcore:Unit ;
    rdfs:label "Intellectual Frontiers Studios"@en ;
    ifcore:job "Build the companies that should exist"@en ;
    ifcore:question "What venture should we create to exploit this advantage, and what is the cheapest credible path to proving whether it deserves to exist?"@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:Network a ifcore:Unit ;
    rdfs:label "Intellectual Frontiers Network"@en ;
    ifcore:job "Find and prove the people who can carry the work"@en ;
    ifcore:question "Who has unusual knowledge, capabilities, relationships, reputation, experience, or access relevant to an opportunity, and how do we find them when needed?"@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:IntellectualFrontiersLLC ifcore:hasUnit
    ifcore:ResearchAndIp, ifcore:Press, ifcore:Capital, ifcore:Studios, ifcore:Network .

# ───────────────────────── Native Alpha (0003-intellectual-frontiers FR-005, FR-006, FR-014 – FR-018; 0007-work-and-assets FR-015) ─────────────────────────

ifcore:NativeAlpha a owl:Class ; rdfs:label "Native Alpha"@en ;
    skos:definition "An unusual and disproportionate advantage native to a particular person, team, company, product, operating model, dataset, market position, or set of relationships, carried by its accumulated knowledge, assets, experience, trust, or working methods, and strong enough to change a real decision."@en ;
    skos:scopeNote "Evident Native Alpha already produces a result beyond a credible benchmark. Latent Native Alpha is carried by what the subject already has, but realized only by reorganizing or recombining it (its units, companies, products, or services). A latent claim stays a provisional thesis until it changes a decision, and an advantage that needs a capability the subject must acquire or build from scratch is not Native Alpha (0003-intellectual-frontiers FR-014 – FR-016). A core competency stated in general terms is where a search starts, not what it finds (FR-017)."@en ;
    skos:scopeNote "Discovering Native Alpha and presenting it are different work (0003-intellectual-frontiers FR-018). Research & IP and Studios discover it (0006-research-and-ip FR-020, 0011-studios FR-027). Press documents and presents what they or others have discovered, and never originates a claim (0009-press FR-003, FR-029, FR-030)."@en ;
    rdfs:comment "Originates as Shahid Nehal Shah's own authored research and thesis, independent of Intellectual Frontiers LLC, with its own creative works and a filed (not yet granted) trademark application — see ifcore:NativeAlphaTrademark and the works that carry schema:about this concept. 0003-intellectual-frontiers FR-005 and FR-006 are the company's own application of it, not a separate thing; no second individual is minted for that application because it names no artifact distinct from the concept itself, unlike ifcore:Eidolon below."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:NativeAlphaTrademark a ifcore:Trademark ;
    rdfs:label "Native Alpha (trademark application)"@en ;
    schema:about ifcore:NativeAlpha ;
    dcterms:creator ifcore:ShahidNehalShah ;
    dcterms:rightsHolder ifcore:IntellectualFrontiersLLC ;
    rdfs:comment "Filing confirmed by the founder; serial number, filing date, and current status not independently verified via USPTO TSDR as of this writing. The registry record, once attached as an ExternalRecordReference, is the sole canonical source for its status (0007-work-and-assets FR-012) — this individual MUST NOT carry a literal status until then."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:ChasingNativeAlpha a schema:CreativeWork ;
    rdfs:label "Chasing Native Alpha"@en ;
    rdfs:comment "The work itself: the idea and method of finding and funding Native Alpha, independent of any form it is presented in (0021-works-and-presentations FR-001). Its stage is the idea's own (FR-022); the book that presents it is ifcore:ChasingNativeAlphaBook, and the skills that carry its method are presentations of it too. Copyright protects a presentation's text, not the idea, so it is asserted on the book."@en ;
    schema:about ifcore:NativeAlpha ;
    dcterms:creator ifcore:ShahidNehalShah ;
    dcterms:rightsHolder ifcore:IntellectualFrontiersLLC ;
    schema:workExample ifcore:ChasingNativeAlphaBook ;
    ifcore:hasAudience ifcore:Public .

ifcore:ChasingNativeAlphaBook a ifcore:Presentation, schema:Book, ifcore:Copyright ;
    rdfs:label "Chasing Native Alpha (book)"@en ;
    rdfs:comment "The book presenting ifcore:ChasingNativeAlpha (0021-works-and-presentations FR-004, FR-005). Its existence, title, and copyright are public; its production stage and decisions are held with its work package in the vault, whose record specializes this one (prov:specializationOf)."@en ;
    schema:exampleOfWork ifcore:ChasingNativeAlpha ;
    dcterms:format ifcore:BookEditionForm ;
    schema:author ifcore:ShahidNehalShah ;
    dcterms:creator ifcore:ShahidNehalShah ;
    dcterms:rightsHolder ifcore:IntellectualFrontiersLLC ;
    schema:publisher ifcore:Press ;
    ifcore:hasAudience ifcore:Public .

ifcore:NativeAlphaArticle a schema:Article ;
    rdfs:label "Native Alpha (shahidshah.com)"@en ;
    schema:about ifcore:NativeAlpha ;
    schema:url "https://www.shahidshah.com/writing/native-alpha"^^xsd:anyURI ;
    schema:author ifcore:ShahidNehalShah ;
    dcterms:creator ifcore:ShahidNehalShah ;
    ifcore:hasAudience ifcore:Public .

ifcore:IntellectualFrontiersLLC schema:isBasedOn ifcore:NativeAlpha .

# ───────────────────────── Eidolon, the concept (0007-work-and-assets FR-015) ─────────────────────────

ifcore:Eidolon a owl:Class ; rdfs:label "Eidolon"@en ;
    skos:definition "A working digital reflection of a person, company, customer, product, or system: not a replica, but enough grounded evidence for an AI to reason about the real thing accurately and flexibly."@en ;
    rdfs:comment "Shahid Nehal Shah's own authored research and thesis, independent of Intellectual Frontiers LLC. Not the same individual as the three-repository system this company operates — that system is a distinct, identifiable artifact based on this concept, related to it by schema:isBasedOn below, exactly the structure FR-015 requires rather than conflating a general concept with a specific application of it."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:IntellectualFrontiersLLC schema:isBasedOn ifcore:Eidolon .

# ───────────────────────── The method (0003-intellectual-frontiers FR-007, FR-008) ─────────────────────────

ifcore:MethodStage a owl:Class ; rdfs:label "Method stage"@en ;
    rdfs:comment "One step in the ordered sequence an opportunity moves through before it is treated as proven."@en .
ifcore:sequenceOrder a owl:DatatypeProperty ; rdfs:domain ifcore:MethodStage ; rdfs:range xsd:integer .

ifcore:Grant a owl:Class ; rdfs:subClassOf ifcore:Fact ; rdfs:label "Grant"@en ;
    rdfs:comment "An explicit, time-bounded link between an identified agent and a specific audience (0005-authentication FR-003). Actual Grant individuals are rarely Public; they are expected to live in the private vault, declaring whatever audience is appropriate to their own sensitivity."@en .
ifcore:grantedTo a owl:ObjectProperty ; rdfs:domain ifcore:Grant ; rdfs:range ifcore:Person .
ifcore:grantsAudience a owl:ObjectProperty ; rdfs:domain ifcore:Grant ; rdfs:range ifcore:Audience .
ifcore:validFrom a owl:DatatypeProperty ; rdfs:domain ifcore:Grant ; rdfs:range xsd:date ;
    rdfs:comment "Required. A grant with no start date is not valid (0005 FR-003)."@en .
ifcore:validUntil a owl:DatatypeProperty ; rdfs:domain ifcore:Grant ; rdfs:range xsd:date ;
    rdfs:comment "Optional. Absent means open-ended; present means the grant stops counting after this date (0005 FR-004)."@en .

# ───────────────────────── Work and assets (0007-work-and-assets) ─────────────────────────

ifcore:Asset a owl:Class ; rdfs:label "Asset"@en ;
    rdfs:comment "An item, thing, or entity that has potential or actual value to the organization (ISO 55000's definition)."@en .
ifcore:TangibleAsset a owl:Class ; rdfs:subClassOf ifcore:Asset ; rdfs:label "Tangible asset"@en .
ifcore:IntangibleAsset a owl:Class ; rdfs:subClassOf ifcore:Asset ; rdfs:label "Intangible asset"@en .
ifcore:FinancialAsset a owl:Class ; rdfs:subClassOf ifcore:Asset ; rdfs:label "Financial asset"@en ;
    rdfs:comment "Investments, securities, and similar holdings. Left unpopulated; Capital's own future spec establishes what belongs here."@en .

ifcore:RealProperty a owl:Class ; rdfs:subClassOf ifcore:TangibleAsset ; rdfs:label "Real property"@en .
ifcore:Equipment a owl:Class ; rdfs:subClassOf ifcore:TangibleAsset ; rdfs:label "Equipment"@en .

ifcore:IntellectualProperty a owl:Class ; rdfs:subClassOf ifcore:IntangibleAsset ; rdfs:label "Intellectual property"@en .
ifcore:DigitalAsset a owl:Class ; rdfs:subClassOf ifcore:IntangibleAsset ; rdfs:label "Digital asset"@en ;
    rdfs:comment "A distinct, separately-valuable digital property — a web property, a distinct software product, a distinct dataset. Not created for an individual page or file within a larger property (0007 FR-007). The domain names it is deployed at are ifcore:DomainName individuals, not this asset (0022-domain-names FR-001); its dcterms:created is when the company began the property, not when a domain was registered (0022 FR-007)."@en .
ifcore:Goodwill a owl:Class ; rdfs:subClassOf ifcore:IntangibleAsset ; rdfs:label "Goodwill"@en .

# ───────────────────────── Substantial works (0007-work-and-assets FR-017 – FR-021) ─────────────────────────

ifcore:SubstantialWork a owl:Class ; rdfs:label "Substantial work"@en ;
    rdfs:comment "A work whose multi-stage production and distribution lifecycle is actually tracked — a peer-reviewed paper, a book, a not-yet-filed patent, or production-bound software are the standing examples, not an exhaustive list (FR-017). Multi-typed onto whatever the work already is (a Note, a schema:Book, a piece of software) rather than replacing that typing. A work or a presentation may be one: each that is produced through stages carries its own (0021-works-and-presentations FR-022). A package's individual is the work, unless a separate record of the work exists, in which case it is a presentation of that work (FR-019); a form-specific type such as schema:Book is carried until its presentations are populated as ifcore:Presentation individuals."@en .

ifcore:lifecycleOwner a owl:ObjectProperty ; rdfs:domain ifcore:SubstantialWork ; rdfs:range ifcore:Unit ;
    rdfs:comment "The one unit accountable for a Substantial Work's progress (FR-021). Defaults to Research & IP while disposition is unsure, Press otherwise; any unit may claim it explicitly, overriding the default."@en .
ifcore:WorkKind a owl:Class ; rdfs:label "Work kind"@en ;
    rdfs:comment "A family of works that share a source format and a set of rules; names the <kind> segment of a work package's path (0015-work-packages FR-004, FR-005). An individual MUST be declared before any work package of that kind exists. It names the work's primary presentation form, not the work itself (0021-works-and-presentations FR-019)."@en .
ifcore:BookKind a ifcore:WorkKind ; rdfs:label "Book"@en ; dcterms:identifier "book" ;
    rdfs:comment "A book: AsciiDoc manuscript, jacket data, figures, and a book bible (0016-press-production FR-004)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:BookSeriesKind a ifcore:WorkKind ; rdfs:label "Book series"@en ; dcterms:identifier "book-series" ;
    rdfs:comment "A serial series: a series bible and volume map, no manuscript; each volume is its own book work (0016-press-production FR-008)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:SkillKind a ifcore:WorkKind ; rdfs:label "Skill"@en ; dcterms:identifier "skill" ;
    rdfs:comment "A skill carrying a book's or record's method for a reader's own AI (0016-press-production FR-040)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:WebsiteKind a ifcore:WorkKind ; rdfs:label "Website"@en ; dcterms:identifier "website" ;
    rdfs:comment "The written public-facing content of a web property; text lives as content documents (0016-press-production FR-042). The editorial record of a channel's own copy, not a work, until that copy is represented as presentations of works and of the firm (0021-works-and-presentations FR-011, FR-021)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:SpokenKind a ifcore:WorkKind ; rdfs:label "Spoken work"@en ; dcterms:identifier "spoken" ;
    rdfs:comment "A spoken-first work whose source is an AsciiDoc script (0017-spoken-and-research-works FR-001, FR-004)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:ResearchKind a ifcore:WorkKind ; rdfs:label "Research record"@en ; dcterms:identifier "research" ;
    rdfs:comment "An area, pillar, note, paper, publication, disclosure, trademark record, or patent draft (0017-spoken-and-research-works FR-017)."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:workLifecycleStage a owl:ObjectProperty ; rdfs:domain ifcore:SubstantialWork ; rdfs:range ifcore:WorkLifecycleStage ;
    rdfs:comment "The stage a Substantial Work currently occupies."@en .

ifcore:WorkLifecycleStage a owl:Class ; rdfs:label "Work lifecycle stage"@en ;
    rdfs:comment "One stage in a Substantial Work's ordered progress (FR-018). Reuses ifcore:sequenceOrder, already declared for ifcore:MethodStage and its siblings, rather than redeclaring it."@en .
ifcore:Intake a ifcore:WorkLifecycleStage ; rdfs:label "Intake"@en ; ifcore:sequenceOrder 1 ; ifcore:hasAudience ifcore:Public .
ifcore:Research a ifcore:WorkLifecycleStage ; rdfs:label "Research"@en ; ifcore:sequenceOrder 2 ;
    rdfs:comment "A stage a Substantial Work occupies — distinct from ifcore:ResearchAndIp (the unit) and ifcore:ResearchArea/ResearchPillar (the research chain's own structure), which this individual does not replace or alias."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:Review a ifcore:WorkLifecycleStage ; rdfs:label "Review"@en ; ifcore:sequenceOrder 3 ; ifcore:hasAudience ifcore:Public .
ifcore:Prep a ifcore:WorkLifecycleStage ; rdfs:label "Prep"@en ; ifcore:sequenceOrder 4 ; ifcore:hasAudience ifcore:Public .
ifcore:Deploy a ifcore:WorkLifecycleStage ; rdfs:label "Deploy"@en ; ifcore:sequenceOrder 5 ;
    rdfs:comment "For a patent, this is the filing moment — the point past which the registry becomes the canonical authority for status, per FR-020 and FR-012."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:Distribute a ifcore:WorkLifecycleStage ; rdfs:label "Distribute"@en ; ifcore:sequenceOrder 6 ; ifcore:hasAudience ifcore:Public .
ifcore:Commercialize a ifcore:WorkLifecycleStage ; rdfs:label "Commercialize"@en ; ifcore:sequenceOrder 7 ;
    rdfs:comment "Decomposes into its own substages (ifcore:CommercializationSubstage) rather than resolving as a single gate, per FR-019."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:CommercializationSubstage a owl:Class ; rdfs:label "Commercialization substage"@en ;
    rdfs:comment "One concurrent decision inside the Commercialize stage (FR-019). Unlike a top-level ifcore:WorkLifecycleStage, these are not strictly sequential gates — pricing and licensing commonly proceed together, and revenue operations is ongoing rather than a one-time step."@en .
ifcore:Pricing a ifcore:CommercializationSubstage ; rdfs:label "Pricing"@en ; dcterms:isPartOf ifcore:Commercialize ; ifcore:sequenceOrder 1 ; ifcore:hasAudience ifcore:Public .
ifcore:Licensing a ifcore:CommercializationSubstage ; rdfs:label "Licensing"@en ; dcterms:isPartOf ifcore:Commercialize ; ifcore:sequenceOrder 2 ;
    rdfs:comment "Where a specific ifcore:License individual (0006-research-and-ip) is negotiated — this substage is the activity, License is its resulting record."@en ;
    ifcore:hasAudience ifcore:Public .
ifcore:GoToMarket a ifcore:CommercializationSubstage ; rdfs:label "Go-to-market"@en ; dcterms:isPartOf ifcore:Commercialize ; ifcore:sequenceOrder 3 ; ifcore:hasAudience ifcore:Public .
ifcore:RevenueOperations a ifcore:CommercializationSubstage ; rdfs:label "Revenue operations"@en ; dcterms:isPartOf ifcore:Commercialize ; ifcore:sequenceOrder 4 ;
    rdfs:comment "Ongoing once reached, not a one-time gate — renewals, collections, and revenue recognition continue for as long as the work is commercialized."@en ;
    ifcore:hasAudience ifcore:Public .

# Existing individuals retyped as Substantial Work, now that the class exists.
# Declared here rather than editing each individual's own declaration, to
# keep this addition's diff self-contained.
ifcore:ChasingNativeAlpha a ifcore:SubstantialWork ;
    ifcore:workLifecycleStage ifcore:Commercialize ;
    ifcore:lifecycleOwner ifcore:Press .
ifcore:DemandEngineering a ifcore:SubstantialWork, schema:SoftwareApplication ;
    ifcore:workLifecycleStage ifcore:Commercialize ;
    ifcore:lifecycleOwner ifcore:Studios .
ifcore:RevenueEngineering a ifcore:SubstantialWork, schema:SoftwareApplication ;
    ifcore:workLifecycleStage ifcore:Commercialize ;
    ifcore:lifecycleOwner ifcore:Studios .
ifcore:CompanionExecutableSourceCodeRepositories a ifcore:SubstantialWork, schema:SoftwareSourceCode ;
    ifcore:workLifecycleStage ifcore:Intake ;
    ifcore:lifecycleOwner ifcore:Studios ;
    rdfs:comment "At the ideation stage per its own operationalStatus — squarely Intake, not yet Research, since the shared service itself has not begun being built."@en .

# ───────────────────────── Research & IP (0006-research-and-ip) ─────────────────────────

ifcore:ResearchArea a owl:Class ; rdfs:subClassOf ifcore:Fact ; rdfs:label "Research area"@en ;
    rdfs:comment "Groups related work; the top of the research chain (0006 FR-001)."@en .
ifcore:ResearchPillar a owl:Class ; rdfs:subClassOf ifcore:Fact ; rdfs:label "Research pillar"@en ;
    rdfs:comment "A standing line of inquiry under a research area, carrying its own question (0006 FR-002). Related to its area by dcterms:isPartOf, not a custom property. An individual pillar MAY additionally be typed prov:Plan where that fits (0007-work-and-assets FR-001); a bounded piece of work under it is a prov:Activity, related to the pillar the same way, by dcterms:isPartOf."@en .

ifcore:AiNativeSystemsArea a ifcore:ResearchArea ;
    rdfs:label "AI-Native Systems for the Firm"@en ;
    rdfs:comment "The firm's own operating model and public presence as research subjects in their own right, not only as business infrastructure."@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:EidolonPillar a ifcore:ResearchPillar, prov:Plan ;
    rdfs:label "Eidolons"@en ;
    dcterms:isPartOf ifcore:AiNativeSystemsArea ;
    schema:about ifcore:Eidolon ;
    ifcore:question "How much of a company, person, or system can an AI reason about accurately from a grounded digital representation, and what does that representation need to contain?"@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:IplgPillar a ifcore:ResearchPillar, prov:Plan ;
    rdfs:label "Intellectual Product-Led Growth"@en ;
    dcterms:isPartOf ifcore:AiNativeSystemsArea ;
    schema:about ifcore:IPLG ;
    ifcore:question "How does a knowledge-heavy organization turn its research, frameworks, and expertise into something a visitor can use directly, before any commercial ask?"@en ;
    ifcore:hasAudience ifcore:Public .

ifcore:NoteType a owl:Class ; rdfs:label "Note type"@en .
ifcore:DesignPattern a ifcore:NoteType ; rdfs:label "Design pattern"@en ; ifcore:hasAudience ifcore:Public .
ifcore:OperatingTheory a ifcore:NoteType ; rdfs:label "Operating theory"@en ; ifcore:hasAudience ifcore:Public .
ifcore:Note a owl:Class ; rdfs:subClassOf ifcore:Fact, prov:Entity ; rdfs:label "Note or paper"@en ;
    rdfs:comment "Where a finding is recorded (0006 FR-003), and the entity a research activity generates via prov:wasGeneratedBy (0007-work-and-assets FR-002). A peer-reviewed paper additionally carries a DOI (FR-004)."@en .
ifcore:noteType a owl:ObjectProperty ; rdfs:domain ifcore:Note ; rdfs:range ifcore:NoteType .
ifcore:doi a owl:DatatypeProperty ; rdfs:domain ifcore:Note ; rdfs:range xsd:string .

ifcore:Disposition a owl:Class ; rdfs:label "Disposition"@en ;
    rdfs:comment "The explicit outcome a protectable finding receives (0006 FR-005)."@en .
ifcore:DispositionPatent a ifcore:Disposition ; rdfs:label "Patent"@en ; ifcore:hasAudience ifcore:Public .
ifcore:DispositionDefensiveDisclosure a ifcore:Disposition ; rdfs:label "Defensive disclosure"@en ; ifcore:hasAudience ifcore:Public .
ifcore:DispositionTradeSecret a ifcore:Disposition ; rdfs:label "Trade secret"@en ; ifcore:hasAudience ifcore:Public .
ifcore:DispositionNoAction a ifcore:Disposition ; rdfs:label "No action"@en ; ifcore:hasAudience ifcore:Public .
ifcore:hasDisposition a owl:ObjectProperty ; rdfs:domain ifcore:Note ; rdfs:range ifcore:Disposition .

ifcore:Right a owl:Class ; rdfs:subClassOf ifcore:IntellectualProperty, prov:Entity ; rdfs:label "Right"@en ;
    rdfs:comment "A kind of protection a finding's disposition can produce; a kind of intellectual property (0007-work-and-assets FR-007) and a thing with provenance (0007 FR-002)."@en .
ifcore:PatentFamily a owl:Class ; rdfs:subClassOf ifcore:Right, ifcore:Fact ; rdfs:label "Patent family"@en .
ifcore:DefensiveDisclosure a owl:Class ; rdfs:subClassOf ifcore:Right, ifcore:Fact ; rdfs:label "Defensive disclosure"@en .
ifcore:Trademark a owl:Class ; rdfs:subClassOf ifcore:Right, ifcore:Fact ; rdfs:label "Trademark"@en .
ifcore:TradeSecret a owl:Class ; rdfs:subClassOf ifcore:Right, ifcore:Fact ; rdfs:label "Trade secret"@en ;
    rdfs:comment "Its substantive content is sensitive by default (0007 FR-010) — see ifcore:RestrictedDataReference."@en .
ifcore:Copyright a owl:Class ; rdfs:subClassOf ifcore:Right, ifcore:Fact ; rdfs:label "Copyright"@en ;
    rdfs:comment "A copyrightable expression significant enough to track (0007-work-and-assets FR-013) — distinct from any trademark protecting a name used in connection with it."@en .
ifcore:License a owl:Class ; rdfs:subClassOf ifcore:Fact ; rdfs:label "License"@en ;
    rdfs:comment "What a counterparty can take on a right this unit holds."@en .
ifcore:licenses a owl:ObjectProperty ; rdfs:domain ifcore:License ; rdfs:range ifcore:Right .

# dcterms:creator and dcterms:rightsHolder (reused, not redeclared) carry a Right's
# attribution: creator MAY be a specific named person; rightsHolder defaults to
# Intellectual Frontiers LLC absent a stated agreement otherwise (0007 FR-014).

ifcore:continuationOf a owl:ObjectProperty ; rdfs:domain ifcore:PatentFamily ; rdfs:range ifcore:PatentFamily ;
    rdfs:comment "Shares the parent's specification and priority date; new claims (0007-work-and-assets FR-011)."@en .
ifcore:divisionalOf a owl:ObjectProperty ; rdfs:domain ifcore:PatentFamily ; rdfs:range ifcore:PatentFamily ;
    rdfs:comment "Claims split out from a parent application that covered more than one invention (0007 FR-011)."@en .
ifcore:continuationInPartOf a owl:ObjectProperty ; rdfs:domain ifcore:PatentFamily ; rdfs:range ifcore:PatentFamily ;
    rdfs:comment "Adds new matter to a parent application; partial priority (0007 FR-011)."@en .

ifcore:WorkDomain a owl:Class ; rdfs:label "Work domain"@en ;
