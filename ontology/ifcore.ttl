@prefix ifcore:  <https://www.intellectualfrontiers.com/ontology/core#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Intellectual Frontiers — core ontology (PUBLIC).
#
# Implements 0001-eidolon-architecture. Every class, property, and individual
# here traces to a requirement in that spec; nothing is asserted ahead of it
# (FR-037). A private ontology imports this and adds its own individuals; it
# must not redefine or remove anything declared here (FR-003).
#
# Every individual that carries asserted factual content (a label naming a
# real thing, a definition, a job, a question) declares ifcore:hasAudience
# explicitly, per FR-011 — never left implicit from being in a public
# repository. A class or property declaration (the vocabulary itself) is not
# a fact and does not carry one.

<https://www.intellectualfrontiers.com/ontology/core>
    a owl:Ontology ;
    owl:versionInfo "0.1.0" ;
    dcterms:title "Intellectual Frontiers core ontology"@en ;
    dcterms:source <https://github.com/intellectual-frontiers/.github/blob/main/spec-kit/specs/0001-eidolon-architecture/spec.md> ;
    rdfs:comment "The company, the Eidolon's own repositories, audiences, references, and governance, per 0001-eidolon-architecture."@en .

# ───────────────────────── Organization ─────────────────────────

ifcore:Organization a owl:Class ; rdfs:label "Organization"@en .
ifcore:Company a owl:Class ; rdfs:subClassOf ifcore:Organization ; rdfs:label "Company"@en .
ifcore:Person a owl:Class ; rdfs:label "Person"@en .

ifcore:legalName a owl:DatatypeProperty ; rdfs:domain ifcore:Person ; rdfs:range xsd:string ;
    rdfs:comment "A person's full legal name, as it would appear on a signed document."@en .
ifcore:displayName a owl:DatatypeProperty ; rdfs:domain ifcore:Person ; rdfs:range xsd:string ;
    rdfs:comment "The name a person is known by in ordinary prose and branding."@en .

ifcore:IntellectualFrontiersLLC a ifcore:Company ;
    rdfs:label "Intellectual Frontiers LLC"@en ;
    ifcore:hasAudience ifcore:Everyone .

ifcore:ShahidNehalShah a ifcore:Person ;
    ifcore:legalName "Shahid Nehal Shah"@en ;
    ifcore:displayName "Shahid N. Shah"@en ;
    ifcore:hasAudience ifcore:Everyone .

# ───────────────────────── The Eidolon's own repositories (FR-001) ─────────────────────────

ifcore:EidolonComponent a owl:Class ; rdfs:label "Eidolon component"@en ;
    rdfs:comment "One of the Eidolon's three repositories."@en .

ifcore:PublicRoot a ifcore:EidolonComponent ; rdfs:label "Public root"@en ;
    ifcore:hasAudience ifcore:Everyone .
ifcore:PrivateVault a ifcore:EidolonComponent ; rdfs:label "Private vault"@en ;
    ifcore:hasAudience ifcore:Everyone .
ifcore:WebProperty a ifcore:EidolonComponent ; rdfs:label "Web property"@en ;
    ifcore:hasAudience ifcore:Everyone .

# ───────────────────────── Facts and audiences (FR-011 – FR-015) ─────────────────────────

ifcore:Fact a owl:Class ; rdfs:label "Fact"@en ;
    rdfs:comment "Anything asserted in the Eidolon that carries factual content. Every fact MUST declare its audience explicitly (FR-011); a class or property declaration is vocabulary, not a fact, and does not need one."@en .

ifcore:Audience a owl:Class ; rdfs:label "Audience"@en ;
    rdfs:comment "A named permission to see a fact."@en .
ifcore:Everyone a ifcore:Audience ; rdfs:label "Everyone"@en ;
    ifcore:hasAudience ifcore:Everyone .
ifcore:CompanyAffiliated a ifcore:Audience ; rdfs:label "Anyone affiliated with the company"@en ;
    ifcore:hasAudience ifcore:Everyone .
ifcore:Agreement a owl:Class ; rdfs:subClassOf ifcore:Audience ; rdfs:label "A specific named agreement"@en .
ifcore:RoleOrGroup a owl:Class ; rdfs:subClassOf ifcore:Audience ; rdfs:label "A specific named role or group"@en .

ifcore:hasAudience a owl:ObjectProperty ; rdfs:domain ifcore:Fact ; rdfs:range ifcore:Audience ;
    rdfs:comment "Disjunctive: a viewer satisfying any one listed audience may see the fact."@en .

# ───────────────────────── References (FR-015, FR-022 – FR-027) ─────────────────────────

ifcore:Reference a owl:Class ; rdfs:subClassOf ifcore:Fact ; rdfs:label "Reference"@en ;
    rdfs:comment "A fact that points at a value held elsewhere rather than storing it."@en .
ifcore:describes a owl:ObjectProperty ; rdfs:domain ifcore:Reference ;
    rdfs:comment "The fact or subject this reference is about."@en .

ifcore:ExternalRecordReference a owl:Class ; rdfs:subClassOf ifcore:Reference ;
    rdfs:label "External record reference"@en ;
    rdfs:comment "Points at a fact Intellectual Frontiers does not author or control."@en .
ifcore:primarySource a owl:DatatypeProperty ; rdfs:domain ifcore:ExternalRecordReference ; rdfs:range xsd:anyURI .
ifcore:cachedValue a owl:DatatypeProperty ; rdfs:domain ifcore:ExternalRecordReference ;
    rdfs:comment "Optional. If present, resolvedAt MUST also be present."@en .
ifcore:resolvedAt a owl:DatatypeProperty ; rdfs:domain ifcore:ExternalRecordReference ; rdfs:range xsd:date ;
    rdfs:comment "Required for any static or non-live rendering of cachedValue."@en .
ifcore:verificationCadence a owl:DatatypeProperty ; rdfs:domain ifcore:ExternalRecordReference ; rdfs:range xsd:duration ;
    rdfs:comment "How often this reference's cached value must be re-verified."@en .
ifcore:verificationMethod a owl:DatatypeProperty ; rdfs:domain ifcore:ExternalRecordReference ; rdfs:range xsd:string ;
    rdfs:comment "\"automated\" or \"manual\"."@en .

ifcore:RestrictedDataReference a owl:Class ; rdfs:subClassOf ifcore:Reference ;
    rdfs:label "Restricted data reference"@en ;
    rdfs:comment "Points at a sensitive fact Intellectual Frontiers authors but excludes from every Eidolon repository. Deliberately carries no property capable of holding the fact's actual value."@en .
ifcore:heldIn a owl:DatatypeProperty ; rdfs:domain ifcore:RestrictedDataReference ; rdfs:range xsd:string ;
    rdfs:comment "The external system that holds the real data."@en .
ifcore:accessInstructions a owl:DatatypeProperty ; rdfs:domain ifcore:RestrictedDataReference ; rdfs:range xsd:string ;
    rdfs:comment "How a properly authorized person obtains access. MUST NOT be, or contain, a credential."@en .

# ───────────────────────── Governance (FR-028 – FR-033) ─────────────────────────

ifcore:DecisionOutcome a owl:Class ; rdfs:label "Decision outcome"@en ;
    rdfs:comment "One of the five decision-checkpoint outcomes."@en .
ifcore:Continue a ifcore:DecisionOutcome ; rdfs:label "Continue"@en ; ifcore:hasAudience ifcore:Everyone .
ifcore:Change a ifcore:DecisionOutcome ; rdfs:label "Change"@en ; ifcore:hasAudience ifcore:Everyone .
ifcore:BackSomeoneElse a ifcore:DecisionOutcome ; rdfs:label "Back someone else"@en ; ifcore:hasAudience ifcore:Everyone .
ifcore:BuildIt a ifcore:DecisionOutcome ; rdfs:label "Build it"@en ; ifcore:hasAudience ifcore:Everyone .
ifcore:Stop a ifcore:DecisionOutcome ; rdfs:label "Stop"@en ; ifcore:hasAudience ifcore:Everyone .

ifcore:Decision a owl:Class ; rdfs:label "Decision"@en ;
    rdfs:comment "A recorded decision at the decision checkpoint. Routine operational activity is not a Decision. An actual Decision individual is itself a Fact and MUST carry its own ifcore:hasAudience when recorded — it is not necessarily Everyone."@en .
ifcore:hasOutcome a owl:ObjectProperty ; rdfs:domain ifcore:Decision ; rdfs:range ifcore:DecisionOutcome .
ifcore:decidedAt a owl:DatatypeProperty ; rdfs:domain ifcore:Decision ; rdfs:range xsd:date ;
    rdfs:comment "A decision is checked against the authority in effect on this date, not the date of later review."@en .
ifcore:decidedBy a owl:ObjectProperty ; rdfs:domain ifcore:Decision ; rdfs:range ifcore:Person .

ifcore:defaultDecisionAuthority a owl:ObjectProperty ; rdfs:domain ifcore:Company ; rdfs:range ifcore:Person ;
    rdfs:comment "The person holding authority over every domain not explicitly delegated elsewhere."@en .
ifcore:IntellectualFrontiersLLC ifcore:defaultDecisionAuthority ifcore:ShahidNehalShah .

# ───────────────────────── Units (0003-intellectual-frontiers FR-001) ─────────────────────────

ifcore:Unit a owl:Class ; rdfs:label "Unit"@en ;
    rdfs:comment "A part of the company with exactly one job and one question."@en .
ifcore:job a owl:DatatypeProperty ; rdfs:domain ifcore:Unit ; rdfs:range xsd:string ;
    rdfs:comment "The one job a unit exists to do."@en .
ifcore:question a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "The one question a unit, or a method stage, exists to answer."@en .

ifcore:hasUnit a owl:ObjectProperty ; rdfs:domain ifcore:Company ; rdfs:range ifcore:Unit .
ifcore:unitOf a owl:ObjectProperty ; owl:inverseOf ifcore:hasUnit .

ifcore:ResearchAndIp a ifcore:Unit ;
    rdfs:label "Intellectual Frontiers Research & IP"@en ;
    ifcore:job "Run the research and protect and commercialize what it produces"@en ;
    ifcore:question "What do we know, own, control, or have rights to that may create unusual advantage?"@en ;
    ifcore:hasAudience ifcore:Everyone .
ifcore:Press a ifcore:Unit ;
    rdfs:label "Intellectual Frontiers Press"@en ;
    ifcore:job "Understand markets and explain the truth clearly"@en ;
    ifcore:question "What do we understand that is worth making clearer, more useful, and more durable?"@en ;
    ifcore:hasAudience ifcore:Everyone .
ifcore:Capital a ifcore:Unit ;
    rdfs:label "Intellectual Frontiers Capital"@en ;
    ifcore:job "Put money behind evidence with discipline"@en ;
    ifcore:question "What advantage is strong enough that scarce capital should be placed behind it?"@en ;
    ifcore:hasAudience ifcore:Everyone .
ifcore:Studios a ifcore:Unit ;
    rdfs:label "Intellectual Frontiers Studios"@en ;
    ifcore:job "Build the companies that should exist"@en ;
    ifcore:question "What venture should we create to exploit this advantage, and what is the cheapest credible path to proving whether it deserves to exist?"@en ;
    ifcore:hasAudience ifcore:Everyone .
ifcore:Network a ifcore:Unit ;
    rdfs:label "Intellectual Frontiers Network"@en ;
    ifcore:job "Find and prove the people who can carry the work"@en ;
    ifcore:question "Who has unusual knowledge, capabilities, relationships, reputation, experience, or access relevant to an opportunity, and how do we find them when needed?"@en ;
    ifcore:hasAudience ifcore:Everyone .

ifcore:IntellectualFrontiersLLC ifcore:hasUnit
    ifcore:ResearchAndIp, ifcore:Press, ifcore:Capital, ifcore:Studios, ifcore:Network .

# ───────────────────────── Native Alpha (0003-intellectual-frontiers FR-005, FR-006) ─────────────────────────

ifcore:NativeAlpha a owl:Class ; rdfs:label "Native Alpha"@en ;
    skos:definition "An unusual and disproportionate advantage that already exists and is strong enough to change a real decision."@en ;
    ifcore:hasAudience ifcore:Everyone .

# ───────────────────────── The method (0003-intellectual-frontiers FR-007, FR-008) ─────────────────────────

ifcore:MethodStage a owl:Class ; rdfs:label "Method stage"@en ;
    rdfs:comment "One step in the ordered sequence an opportunity moves through before it is treated as proven."@en .
ifcore:sequenceOrder a owl:DatatypeProperty ; rdfs:domain ifcore:MethodStage ; rdfs:range xsd:integer .

ifcore:Grant a owl:Class ; rdfs:subClassOf ifcore:Fact ; rdfs:label "Grant"@en ;
    rdfs:comment "An explicit, time-bounded link between an identified agent and a specific audience (0005-authentication FR-003). Actual Grant individuals are rarely Public; they are expected to live in the private vault, declaring whatever audience is appropriate to their own sensitivity."@en .
ifcore:grantedTo a owl:ObjectProperty ; rdfs:domain ifcore:Grant ; rdfs:range ifcore:Person .
ifcore:grantsAudience a owl:ObjectProperty ; rdfs:domain ifcore:Grant ; rdfs:range ifcore:Audience .
ifcore:validFrom a owl:DatatypeProperty ; rdfs:domain ifcore:Grant ; rdfs:range xsd:date ;
    rdfs:comment "Required. A grant with no start date is not valid (0005 FR-003)."@en .
ifcore:validUntil a owl:DatatypeProperty ; rdfs:domain ifcore:Grant ; rdfs:range xsd:date ;
    rdfs:comment "Optional. Absent means open-ended; present means the grant stops counting after this date (0005 FR-004)."@en .

# ───────────────────────── Research & IP (0006-research-and-ip) ─────────────────────────

ifcore:ResearchArea a owl:Class ; rdfs:subClassOf ifcore:Fact ; rdfs:label "Research area"@en ;
    rdfs:comment "Groups related work; the top of the research chain (0006 FR-001)."@en .
ifcore:ResearchPillar a owl:Class ; rdfs:subClassOf ifcore:Fact ; rdfs:label "Research pillar"@en ;
    rdfs:comment "A standing line of inquiry under a research area, carrying its own question (0006 FR-002)."@en .
ifcore:partOfArea a owl:ObjectProperty ; rdfs:domain ifcore:ResearchPillar ; rdfs:range ifcore:ResearchArea .

ifcore:NoteType a owl:Class ; rdfs:label "Note type"@en .
ifcore:DesignPattern a ifcore:NoteType ; rdfs:label "Design pattern"@en ; ifcore:hasAudience ifcore:Everyone .
ifcore:OperatingTheory a ifcore:NoteType ; rdfs:label "Operating theory"@en ; ifcore:hasAudience ifcore:Everyone .
ifcore:Note a owl:Class ; rdfs:subClassOf ifcore:Fact ; rdfs:label "Note or paper"@en ;
    rdfs:comment "Where a finding is recorded (0006 FR-003). A peer-reviewed paper additionally carries a DOI (FR-004)."@en .
ifcore:noteType a owl:ObjectProperty ; rdfs:domain ifcore:Note ; rdfs:range ifcore:NoteType .
ifcore:doi a owl:DatatypeProperty ; rdfs:domain ifcore:Note ; rdfs:range xsd:string .

ifcore:Disposition a owl:Class ; rdfs:label "Disposition"@en ;
    rdfs:comment "The explicit outcome a protectable finding receives (0006 FR-005)."@en .
ifcore:DispositionPatent a ifcore:Disposition ; rdfs:label "Patent"@en ; ifcore:hasAudience ifcore:Everyone .
ifcore:DispositionDefensiveDisclosure a ifcore:Disposition ; rdfs:label "Defensive disclosure"@en ; ifcore:hasAudience ifcore:Everyone .
ifcore:DispositionTradeSecret a ifcore:Disposition ; rdfs:label "Trade secret"@en ; ifcore:hasAudience ifcore:Everyone .
ifcore:DispositionNoAction a ifcore:Disposition ; rdfs:label "No action"@en ; ifcore:hasAudience ifcore:Everyone .
ifcore:hasDisposition a owl:ObjectProperty ; rdfs:domain ifcore:Note ; rdfs:range ifcore:Disposition .

ifcore:Right a owl:Class ; rdfs:label "Right"@en ;
    rdfs:comment "A kind of protection a finding's disposition can produce."@en .
ifcore:PatentFamily a owl:Class ; rdfs:subClassOf ifcore:Right, ifcore:Fact ; rdfs:label "Patent family"@en .
ifcore:DefensiveDisclosure a owl:Class ; rdfs:subClassOf ifcore:Right, ifcore:Fact ; rdfs:label "Defensive disclosure"@en .
ifcore:Trademark a owl:Class ; rdfs:subClassOf ifcore:Right, ifcore:Fact ; rdfs:label "Trademark"@en .
ifcore:TradeSecret a owl:Class ; rdfs:subClassOf ifcore:Right, ifcore:Fact ; rdfs:label "Trade secret"@en .
ifcore:License a owl:Class ; rdfs:subClassOf ifcore:Fact ; rdfs:label "License"@en ;
    rdfs:comment "What a counterparty can take on a right this unit holds."@en .
ifcore:licenses a owl:ObjectProperty ; rdfs:domain ifcore:License ; rdfs:range ifcore:Right .

ifcore:WorkGroup a owl:Class ; rdfs:label "Work group"@en ;
    rdfs:comment "A grouping of the patent portfolio by subject matter."@en .
ifcore:MarketplacesAndPayments a ifcore:WorkGroup ; rdfs:label "Marketplaces and payments"@en ;
    rdfs:comment "Computer-controlled marketplace networks, digital payments, and related continuations."@en ;
    ifcore:hasAudience ifcore:Everyone .
ifcore:EvidenceAndDecisions a ifcore:WorkGroup ; rdfs:label "Evidence and decisions"@en ;
    rdfs:comment "Traceable metric queues, task scheduling, service-delivery evidence, initiative tracking, document review, case response, decision lifecycles, and risk systems."@en ;
    ifcore:hasAudience ifcore:Everyone .
ifcore:HealthcareDelivery a ifcore:WorkGroup ; rdfs:label "Healthcare delivery"@en ;
    rdfs:comment "Medical-device control, patient navigation, longitudinal profiles, team-based tele-diagnostics, smart referrals, and digital-native trials."@en ;
    ifcore:hasAudience ifcore:Everyone .
ifcore:TrustedDataAndAuthorization a ifcore:WorkGroup ; rdfs:label "Trusted data and authorization"@en ;
    rdfs:comment "Self-controlled digital authorization, device-driven blockchain integrity, blockchain natural-language processing, and multi-source data integration."@en ;
    ifcore:hasAudience ifcore:Everyone .
ifcore:LearningAndContent a ifcore:WorkGroup ; rdfs:label "Learning and content"@en ;
    rdfs:comment "Precision education and training, rating aggregation, and rewardable content delivery."@en ;
    ifcore:hasAudience ifcore:Everyone .
ifcore:inWorkGroup a owl:ObjectProperty ; rdfs:domain ifcore:PatentFamily ; rdfs:range ifcore:WorkGroup .

ifcore:Find a ifcore:MethodStage ; rdfs:label "Find"@en ; ifcore:sequenceOrder 1 ;
    ifcore:question "What is unusually true here?"@en ;
    ifcore:hasAudience ifcore:Everyone .
ifcore:Prove a ifcore:MethodStage ; rdfs:label "Prove"@en ; ifcore:sequenceOrder 2 ;
    ifcore:question "What small hard thing earns a scarce commitment?"@en ;
    ifcore:hasAudience ifcore:Everyone .
ifcore:Decide a ifcore:MethodStage ; rdfs:label "Decide"@en ; ifcore:sequenceOrder 3 ;
    ifcore:question "What will we do now?"@en ;
    ifcore:hasAudience ifcore:Everyone .
ifcore:Compound a ifcore:MethodStage ; rdfs:label "Compound"@en ; ifcore:sequenceOrder 4 ;
    ifcore:question "How does use make the advantage stronger?"@en ;
    ifcore:hasAudience ifcore:Everyone .
