@prefix ifweb:   <https://www.intellectualfrontiers.com/ontology/web#> .
@prefix ifcore:  <https://www.intellectualfrontiers.com/ontology/core#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix schema:  <https://schema.org/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

# Intellectual Frontiers — web content ontology (PUBLIC).
#
# Implements 0002-content-format. Every content kind here is both an OWL
# class and a SHACL NodeShape, marked with ifweb:contentKind when it is a
# document-level shape a content document's own JSON-LD block may declare
# as its @type (0002 FR-005). Per the working order in
# 0001-eidolon-architecture FR-037, a shape is added here only once a spec
# establishes the business concept it represents — Page is the one
# exception, since it names no business concept beyond the content-document
# contract 0002 already establishes for every document.

<https://www.intellectualfrontiers.com/ontology/web>
    a owl:Ontology ;
    owl:versionInfo "0.1.0" ;
    owl:imports <https://www.intellectualfrontiers.com/ontology/core> ;
    dcterms:title "Intellectual Frontiers web content ontology"@en ;
    dcterms:source <https://github.com/intellectual-frontiers/.github/blob/main/spec-kit/specs/0002-content-format/spec.md> ;
    rdfs:comment "Content shapes for web properties, per 0002-content-format."@en .

ifweb:contentKind a owl:DatatypeProperty ;
    rdfs:comment "Marks a document-level shape: the value a content document's own JSON-LD @type may declare (0002 FR-005, FR-007)."@en .

ifweb:Page a owl:Class, sh:NodeShape ; rdfs:subClassOf schema:WebPage ;
    rdfs:subClassOf ifcore:Fact ;
    rdfs:label "Page"@en ;
    rdfs:comment "The minimal content kind: a content document with no properties beyond the ones every document already carries (0002 FR-004, FR-008) and, where it is generated from a work package's source, its provenance (0002 FR-017)."@en ;
    ifweb:contentKind "Page" ;
    sh:property [ sh:path prov:wasDerivedFrom ; sh:maxCount 1 ] .

# ───────────────────────── Not shipping the organization (0021-works-and-presentations FR-014, FR-018) ─────────────────────────

ifweb:PublicSubjectShape a sh:NodeShape ;
    rdfs:label "Public subject"@en ;
    rdfs:comment "Every content document, of every kind: one that declares the Public audience has no ifcore:Unit as its principal subject (schema:about or schema:mainEntity). A unit may still appear in its body or as provenance, such as a byline (0021-works-and-presentations FR-014, FR-016, FR-018; 0013-web-content-kinds FR-001). An ifweb:PromotionPost is the one exception (0021 FR-023)."@en ;
    sh:targetClass ifweb:Page ;
    sh:message "A public content document's principal subject (schema:about or schema:mainEntity) is never a unit; lead with a work, its result, or the reader's problem (0021-works-and-presentations FR-014)" ;
    sh:or (
        [ sh:not [ sh:path ifcore:hasAudience ; sh:hasValue ifcore:Public ] ]
        [ sh:class ifweb:PromotionPost ]
        [ sh:and (
            [ sh:path schema:about ; sh:not [ sh:class ifcore:Unit ] ]
            [ sh:path schema:mainEntity ; sh:not [ sh:class ifcore:Unit ] ]
        ) ]
    ) .

# ───────────────────────── Content kinds backed by one existing individual (0013-web-content-kinds) ─────────────────────────

ifweb:UnitPage a owl:Class, sh:NodeShape ; rdfs:subClassOf schema:WebPage ;
    rdfs:subClassOf ifweb:Page ;
    rdfs:label "Unit page"@en ;
    rdfs:comment "Renders one ifcore:Unit individual; asserts no new fact about it (0013 FR-001). Never Public: ifweb:PublicSubjectShape fails a public page whose subject is a unit (0021-works-and-presentations FR-014)."@en ;
    ifweb:contentKind "UnitPage" ;
    sh:targetClass ifweb:UnitPage ;
    sh:property [ sh:path schema:about ; sh:class ifcore:Unit ; sh:minCount 1 ; sh:maxCount 1 ] .

ifweb:ResearchPillarPage a owl:Class, sh:NodeShape ; rdfs:subClassOf schema:WebPage ;
    rdfs:subClassOf ifweb:Page ;
    rdfs:label "Research pillar page"@en ;
    rdfs:comment "Renders one ifcore:ResearchPillar individual (0013 FR-002)."@en ;
    ifweb:contentKind "ResearchPillarPage" ;
    sh:targetClass ifweb:ResearchPillarPage ;
    sh:property [ sh:path schema:about ; sh:class ifcore:ResearchPillar ; sh:minCount 1 ; sh:maxCount 1 ] .

ifweb:ResearchNotePage a owl:Class, sh:NodeShape ; rdfs:subClassOf schema:WebPage ;
    rdfs:subClassOf ifweb:Page ;
    rdfs:label "Research note page"@en ;
    rdfs:comment "Renders one ifcore:Note individual (0013 FR-003)."@en ;
    ifweb:contentKind "ResearchNotePage" ;
    sh:targetClass ifweb:ResearchNotePage ;
    sh:property [ sh:path schema:about ; sh:class ifcore:Note ; sh:minCount 1 ; sh:maxCount 1 ] .

ifweb:PatentFamilyPage a owl:Class, sh:NodeShape ; rdfs:subClassOf schema:WebPage ;
    rdfs:subClassOf ifweb:Page ;
    rdfs:label "Patent family page"@en ;
    rdfs:comment "Renders one ifcore:PatentFamily individual. Any status or filing-data value it displays must be a resolved ExternalRecordReference, never a hand-typed literal (0013 FR-004, 0006-research-and-ip FR-008)."@en ;
    ifweb:contentKind "PatentFamilyPage" ;
    sh:targetClass ifweb:PatentFamilyPage ;
    sh:property [ sh:path schema:about ; sh:class ifcore:PatentFamily ; sh:minCount 1 ; sh:maxCount 1 ] .

ifweb:PatentSummaryPage a owl:Class, sh:NodeShape ; rdfs:subClassOf schema:WebPage ;
    rdfs:subClassOf ifweb:Page ;
    rdfs:label "Patent summary page"@en ;
    rdfs:comment "A supporting asset that explains the core idea of exactly one ifcore:Patent in plain language, for a reader who decides whether the patent belongs on a shortlist. It explains the patent and never replaces the patent's own page (0013 FR-014, 0051-patent-portfolio FR-007)."@en ;
    ifweb:contentKind "PatentSummaryPage" ;
    sh:targetClass ifweb:PatentSummaryPage ;
    sh:property [ sh:path schema:about ; sh:class ifcore:Patent ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path schema:datePublished ; sh:datatype xsd:date ; sh:maxCount 1 ] .

ifweb:UseCasePage a owl:Class, sh:NodeShape ; rdfs:subClassOf schema:WebPage ;
    rdfs:subClassOf ifweb:Page ;
    rdfs:label "Use case page"@en ;
    rdfs:comment "A supporting asset that shows a practical or commercial application of one ifcore:Patent or one ifcore:PatentFamily (0013 FR-015, 0051-patent-portfolio FR-004)."@en ;
    ifweb:contentKind "UseCasePage" ;
    sh:targetClass ifweb:UseCasePage ;
    sh:property [ sh:path schema:about ; sh:minCount 1 ; sh:maxCount 1 ; sh:or ( [ sh:class ifcore:Patent ] [ sh:class ifcore:PatentFamily ] ) ] ;
    sh:property [ sh:path schema:datePublished ; sh:datatype xsd:date ; sh:maxCount 1 ] .

ifweb:MarketPotentialPage a owl:Class, sh:NodeShape ; rdfs:subClassOf schema:WebPage ;
    rdfs:subClassOf ifweb:Page ;
    rdfs:label "Market potential page"@en ;
    rdfs:comment "A supporting asset that sets out the market a patent or a patent family serves and the value it can create there (0013 FR-015, 0051-patent-portfolio FR-004)."@en ;
    ifweb:contentKind "MarketPotentialPage" ;
    sh:targetClass ifweb:MarketPotentialPage ;
    sh:property [ sh:path schema:about ; sh:minCount 1 ; sh:maxCount 1 ; sh:or ( [ sh:class ifcore:Patent ] [ sh:class ifcore:PatentFamily ] ) ] ;
    sh:property [ sh:path schema:datePublished ; sh:datatype xsd:date ; sh:maxCount 1 ] .

ifweb:PatentLandscapePage a owl:Class, sh:NodeShape ; rdfs:subClassOf schema:WebPage ;
    rdfs:subClassOf ifweb:Page ;
    rdfs:label "Patent landscape page"@en ;
    rdfs:comment "A supporting asset that gives the technology and patent landscape around one ifcore:Patent or one ifcore:PatentFamily (0013 FR-015, 0051-patent-portfolio FR-004)."@en ;
    ifweb:contentKind "PatentLandscapePage" ;
    sh:targetClass ifweb:PatentLandscapePage ;
    sh:property [ sh:path schema:about ; sh:minCount 1 ; sh:maxCount 1 ; sh:or ( [ sh:class ifcore:Patent ] [ sh:class ifcore:PatentFamily ] ) ] ;
    sh:property [ sh:path schema:datePublished ; sh:datatype xsd:date ; sh:maxCount 1 ] .

ifweb:PodcastEpisodePage a owl:Class, sh:NodeShape ; rdfs:subClassOf schema:WebPage ;
    rdfs:subClassOf ifweb:Page ;
    rdfs:label "Podcast episode page"@en ;
    rdfs:comment "A supporting asset that explains one ifcore:Patent or one ifcore:PatentFamily in a spoken episode. Its audio, when it is in rendition storage, is named by schema:associatedMedia (0013 FR-015, FR-016, 0051-patent-portfolio FR-020)."@en ;
    ifweb:contentKind "PodcastEpisodePage" ;
    sh:targetClass ifweb:PodcastEpisodePage ;
    sh:property [ sh:path schema:about ; sh:minCount 1 ; sh:maxCount 1 ; sh:or ( [ sh:class ifcore:Patent ] [ sh:class ifcore:PatentFamily ] ) ] ;
    sh:property [ sh:path schema:datePublished ; sh:datatype xsd:date ; sh:maxCount 1 ] ;
    sh:property [ sh:path schema:associatedMedia ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] .

ifweb:ArchivedPostPage a owl:Class, sh:NodeShape ; rdfs:subClassOf schema:WebPage ;
    rdfs:subClassOf ifweb:Page ;
    rdfs:label "Archived post page"@en ;
    rdfs:comment "A blog post of the previous website, kept as it was published, with its date; it states no fact the ontology holds and is not the firm's current position (0013 FR-018, 0044-public-website FR-076)."@en ;
    ifweb:contentKind "ArchivedPostPage" ;
    sh:targetClass ifweb:ArchivedPostPage ;
    sh:property [ sh:path schema:datePublished ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path schema:about ; sh:maxCount 0 ] .

ifweb:TrademarkPage a owl:Class, sh:NodeShape ; rdfs:subClassOf schema:WebPage ;
    rdfs:subClassOf ifweb:Page ;
    rdfs:label "Trademark page"@en ;
    rdfs:comment "Renders one ifcore:Trademark individual, under the same ExternalRecordReference discipline as ifweb:PatentFamilyPage (0013 FR-005)."@en ;
    ifweb:contentKind "TrademarkPage" ;
    sh:targetClass ifweb:TrademarkPage ;
    sh:property [ sh:path schema:about ; sh:class ifcore:Trademark ; sh:minCount 1 ; sh:maxCount 1 ] .

ifweb:DefensiveDisclosurePage a owl:Class, sh:NodeShape ; rdfs:subClassOf schema:WebPage ;
    rdfs:subClassOf ifweb:Page ;
    rdfs:label "Defensive disclosure page"@en ;
    rdfs:comment "Renders one ifcore:DefensiveDisclosure individual (0013 FR-006)."@en ;
    ifweb:contentKind "DefensiveDisclosurePage" ;
    sh:targetClass ifweb:DefensiveDisclosurePage ;
    sh:property [ sh:path schema:about ; sh:class ifcore:DefensiveDisclosure ; sh:minCount 1 ; sh:maxCount 1 ] .

ifweb:FundPage a owl:Class, sh:NodeShape ; rdfs:subClassOf schema:WebPage ;
    rdfs:subClassOf ifweb:Page ;
    rdfs:label "Fund page"@en ;
    rdfs:comment "Renders one ifcore:Fund individual (0013 FR-007)."@en ;
    ifweb:contentKind "FundPage" ;
    sh:targetClass ifweb:FundPage ;
    sh:property [ sh:path schema:about ; sh:class ifcore:Fund ; sh:minCount 1 ; sh:maxCount 1 ] .

ifweb:BookPage a owl:Class, sh:NodeShape ; rdfs:subClassOf schema:WebPage ;
    rdfs:subClassOf ifweb:Page ;
    rdfs:label "Book page"@en ;
    rdfs:comment "Renders one individual that is both a schema:Book and an ifcore:Copyright, per 0007-work-and-assets FR-013 (0013 FR-008)."@en ;
    ifweb:contentKind "BookPage" ;
    sh:targetClass ifweb:BookPage ;
    sh:property [ sh:path schema:about ; sh:class schema:Book ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path schema:about ; sh:class ifcore:Copyright ; sh:minCount 1 ; sh:maxCount 1 ] .

ifweb:WorkPage a owl:Class, sh:NodeShape ; rdfs:subClassOf schema:WebPage ;
    rdfs:subClassOf ifweb:Page ;
    rdfs:label "Work page"@en ;
    rdfs:comment "Renders facts that already exist about one ifcore:SubstantialWork and asserts none; a book's own page remains ifweb:BookPage (0013 FR-012)."@en ;
    ifweb:contentKind "WorkPage" ;
    sh:targetClass ifweb:WorkPage ;
    sh:property [ sh:path schema:about ; sh:class ifcore:SubstantialWork ; sh:minCount 1 ; sh:maxCount 1 ] .

ifweb:WorkEditionPage a owl:Class, sh:NodeShape ; rdfs:subClassOf schema:WebPage ;
    rdfs:subClassOf ifweb:Page ;
    rdfs:label "Work edition page"@en ;
    rdfs:comment "A generated content document rendering a part of a Substantial Work's source — a chapter, appendix, companion page, or show-notes page — naming that same work by both schema:isPartOf and prov:wasDerivedFrom (0013 FR-013; 0002-content-format FR-017)."@en ;
    ifweb:contentKind "WorkEditionPage" ;
    sh:targetClass ifweb:WorkEditionPage ;
    sh:property [ sh:path schema:isPartOf ; sh:class ifcore:SubstantialWork ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path prov:wasDerivedFrom ; sh:class ifcore:SubstantialWork ; sh:minCount 1 ; sh:maxCount 1 ] .

ifweb:JournalArticlePage a owl:Class, sh:NodeShape ; rdfs:subClassOf schema:WebPage ;
    rdfs:subClassOf ifweb:Page ;
    rdfs:label "Journal article page"@en ;
    rdfs:comment "The one content kind that may carry text Intellectual Frontiers itself originates rather than only render an existing fact, per 0007-work-and-assets FR-016 (0013 FR-009)."@en ;
    ifweb:contentKind "JournalArticlePage" ;
    sh:targetClass ifweb:JournalArticlePage ;
    sh:property [ sh:path schema:isPartOf ; sh:class schema:Periodical ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path schema:about ; sh:minCount 1 ; sh:maxCount 1 ] .

ifweb:JournalIssuePage a owl:Class, sh:NodeShape ; rdfs:subClassOf schema:WebPage ;
    rdfs:subClassOf ifweb:Page ;
    rdfs:label "Journal issue page"@en ;
    rdfs:comment "Renders one issue of the Journal: a schema:PublicationIssue that is a presentation gathering articles already declared, each naming the work it presents (0009-press FR-033; 0013 FR-017). It asserts no fact about an article."@en ;
    ifweb:contentKind "JournalIssuePage" ;
    sh:targetClass ifweb:JournalIssuePage ;
    sh:property [ sh:path schema:about ; sh:class schema:PublicationIssue ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path schema:isPartOf ; sh:class schema:Periodical ; sh:minCount 1 ; sh:maxCount 1 ] .

# ───────────────────────── The portfolio index (0013 FR-010 – FR-011) ─────────────────────────

ifweb:featuresWork a owl:ObjectProperty ;
    rdfs:domain ifweb:PortfolioIndexPage ;
    rdfs:comment "Lists an individual already declared elsewhere in the ontology; asserts no new fact about it (0013 FR-009)."@en .

ifweb:PortfolioIndexPage a owl:Class, sh:NodeShape ; rdfs:subClassOf schema:CollectionPage ;
    rdfs:subClassOf ifweb:Page ;
    rdfs:label "Portfolio index page"@en ;
    rdfs:comment "A view over existing individuals, never a new fact type (0013 FR-009). A work kind with no existing ontology class MUST NOT be listed here until its own governing spec establishes it (FR-010)."@en ;
    ifweb:contentKind "PortfolioIndexPage" ;
    sh:targetClass ifweb:PortfolioIndexPage ;
    sh:property [
        sh:path ifweb:featuresWork ;
        sh:minCount 0 ;
        sh:or (
            [ sh:class ifcore:PatentFamily ]
            [ sh:class ifcore:Trademark ]
            [ sh:class ifcore:DefensiveDisclosure ]
            [ sh:class ifcore:Fund ]
            [ sh:class schema:Book ]
            [ sh:class ifcore:ResearchPillar ]
            [ sh:class ifcore:VentureCategory ]
            [ sh:class ifcore:SoftwareCategory ]
            [ sh:class ifcore:SharedServiceCategory ]
        )
    ] .

ifweb:PromotionPost a owl:Class, sh:NodeShape ; rdfs:subClassOf schema:Article ;
    rdfs:subClassOf ifweb:Page ;
    rdfs:label "Promotion post"@en ;
    rdfs:comment "Company or unit news, a launch note, or an article written for search or answer engines (0021-works-and-presentations FR-023, FR-024; 0009-press FR-037). Its subject may be the firm or a unit; it names, by dcterms:references, at least one work, presentation, or Journal issue it promotes, which remains the authoritative record (0016-press-production FR-045, FR-047)."@en ;
    ifweb:contentKind "PromotionPost" ;
    sh:targetClass ifweb:PromotionPost ;
    sh:property [ sh:path schema:about ; sh:maxCount 1 ] ;
    sh:property [ sh:path dcterms:references ; sh:minCount 1 ;
        sh:or ( [ sh:class ifcore:SubstantialWork ] [ sh:class ifcore:Presentation ] [ sh:class schema:Periodical ] [ sh:class schema:PublicationIssue ] [ sh:class schema:Article ] ) ] .

# ───────────────────────── Publishing destinations (0044-public-website FR-016 – FR-023) ─────────────────────────

ifweb:PublishingDestination a owl:Class, sh:NodeShape ;
    rdfs:subClassOf ifcore:Fact ;
    rdfs:label "Publishing destination"@en ;
    rdfs:comment "A host a web property's generated files are published to through one publishing command (0044-public-website FR-018). It names the vendor service that hosts it, its publishing strategy, the file holding its configuration and the file holding its deployment record (FR-021); the credentials it needs are read from the environment and named nowhere (FR-022). Pointing a domain at it is a Decision, not a property of it (FR-019)."@en ;
    sh:targetClass ifweb:PublishingDestination ;
    sh:property [ sh:path ifweb:destinationOf ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:message "A publishing destination names the web property it publishes (0044 FR-018)." ] ;
    sh:property [ sh:path ifweb:hostedBy ; sh:class ifcore:VendorService ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:message "A publishing destination names the vendor service that hosts it (0044 FR-018)." ] ;
    sh:property [ sh:path ifweb:publishingStrategy ; sh:class skos:Concept ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:message "A publishing destination names its publishing strategy (0044 FR-018, FR-019)." ] ;
    sh:property [ sh:path ifweb:publishingCommand ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path ifweb:configurationFile ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:message "A publishing destination names the file holding its configuration (0044 FR-018)." ] ;
    sh:property [ sh:path ifweb:deploymentRecordFile ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:message "A publishing destination names the file holding its deployment record (0044 FR-018, FR-021)." ] .

ifweb:destinationOf a owl:ObjectProperty ; rdfs:domain ifweb:PublishingDestination ;
    rdfs:comment "The web property whose generated files this destination serves (0044 FR-018)."@en .
ifweb:hostedBy a owl:ObjectProperty ; rdfs:domain [ a owl:Class ; owl:unionOf ( ifweb:PublishingDestination ifweb:ApplicationHost ) ] ; rdfs:range ifcore:VendorService ;
    rdfs:comment "The vendor service, in the vendor register, that hosts the destination (0044 FR-018; 0037-vendor-management-policy)."@en .
ifweb:publishingStrategy a owl:ObjectProperty ; rdfs:domain [ a owl:Class ; owl:unionOf ( ifweb:PublishingDestination ifweb:ApplicationHost ) ] ; rdfs:range skos:Concept ;
    rdfs:comment "How a publish reaches the destination's readers, a concept in ifweb:PublishingStrategyScheme (0044 FR-019)."@en .
ifweb:publishingCommand a owl:DatatypeProperty ; rdfs:domain [ a owl:Class ; owl:unionOf ( ifweb:PublishingDestination ifweb:ApplicationHost ) ] ; rdfs:range xsd:string ;
    rdfs:comment "The one command that publishes to the destination, as a person types it (0044 FR-018)."@en .
ifweb:configurationFile a owl:DatatypeProperty ; rdfs:domain [ a owl:Class ; owl:unionOf ( ifweb:PublishingDestination ifweb:ApplicationHost ) ] ; rdfs:range xsd:string ;
    rdfs:comment "The repository path of the file holding the destination's configuration: no credential is ever in it (0044 FR-018, FR-022)."@en .
ifweb:deploymentRecordFile a owl:DatatypeProperty ; rdfs:domain [ a owl:Class ; owl:unionOf ( ifweb:PublishingDestination ifweb:ApplicationHost ) ] ; rdfs:range xsd:string ;
    rdfs:comment "The repository path of the file every publish to the destination appends a record to (0044 FR-021)."@en .

ifweb:PublishingStrategyScheme a skos:ConceptScheme ; rdfs:label "Publishing strategy"@en ;
    ifcore:hasAudience ifcore:Public .
ifweb:PreviewThenPromote a skos:Concept ; skos:inScheme ifweb:PublishingStrategyScheme ; skos:prefLabel "Preview, then promote"@en ;
    skos:definition "Every publish makes a preview at the destination's own preview address; only a publish that names who decides and why is promoted to the destination's production, and pointing a domain at the destination is a separate Decision (0044 FR-019)."@en ;
    ifcore:hasAudience ifcore:Public .


# ───────────────────────── The application and its hosts (0044-public-website FR-024 – FR-030; 0046-distribution-platform) ─────────────────────────

ifweb:Application a owl:Class, sh:NodeShape ; rdfs:subClassOf schema:WebApplication ;
    rdfs:subClassOf schema:SoftwareApplication, ifcore:Fact ;
    rdfs:label "Application"@en ;
    skos:definition "The program that serves a web property beyond its generated pages: what only identified readers may reach, and the delivery of renditions (0044-public-website FR-024)."@en ;
    rdfs:comment "Specializes schema:SoftwareApplication (0019 FR-002). It names the web property it serves. It ships as one container image that any host able to run one can run (0046-distribution-platform FR-009, FR-010); where it runs is an ifweb:ApplicationHost, and it is in the system inventory (ifcore:InformationSystem) once a host runs it (0046 FR-012)."@en ;
    sh:targetClass ifweb:Application ;
    sh:property [ sh:path ifweb:applicationOf ; sh:class ifcore:EidolonComponent ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:message "An application names the web property it serves (0044 FR-024)." ] .

ifweb:ApplicationHost a owl:Class, sh:NodeShape ;
    rdfs:subClassOf ifcore:Fact ;
    rdfs:label "Application host"@en ;
    rdfs:comment "A host that runs an application's container image (0044-public-website FR-029; 0046-distribution-platform FR-012). It is described here before it is used. It names the application it runs, its entry in the system inventory, its publishing strategy, the one command that deploys to it, the file holding its configuration and the file every deploy appends a record to; a vendor service hosts it unless the company runs it. The credentials a deploy needs are read from the environment and named nowhere (0044 FR-022)."@en ;
    sh:targetClass ifweb:ApplicationHost ;
    sh:property [ sh:path ifweb:hostOf ; sh:class ifweb:Application ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:message "An application host names the application it runs (0044 FR-029)." ] ;
    sh:property [ sh:path ifweb:inventoryEntry ; sh:class ifcore:InformationSystem ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:message "An application host names its entry in the system inventory (0046 FR-012; 0033 FR-001)." ] ;
    sh:property [ sh:path ifweb:hostedBy ; sh:class ifcore:VendorService ; sh:maxCount 1 ;
                  sh:message "An application host's vendor service, when a vendor hosts it, is in the vendor register (0037-vendor-management-policy FR-001)." ] ;
    sh:property [ sh:path ifweb:publishingStrategy ; sh:class skos:Concept ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:message "An application host names its publishing strategy (0044 FR-029, FR-019)." ] ;
    sh:property [ sh:path ifweb:publishingCommand ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:message "An application host names the one command that deploys to it (0044 FR-029)." ] ;
    sh:property [ sh:path ifweb:configurationFile ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:message "An application host names the file holding its configuration (0044 FR-029, FR-018)." ] ;
    sh:property [ sh:path ifweb:deploymentRecordFile ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:message "An application host names the file holding its deployment record (0044 FR-029, FR-021)." ] .

ifweb:applicationOf a owl:ObjectProperty ; rdfs:domain ifweb:Application ; rdfs:range ifcore:EidolonComponent ;
    rdfs:comment "The web property whose pages this application serves beyond (0044 FR-024)."@en .
ifweb:hostOf a owl:ObjectProperty ; rdfs:domain ifweb:ApplicationHost ; rdfs:range ifweb:Application ;
    rdfs:comment "The application this host runs (0044 FR-029)."@en .
ifweb:inventoryEntry a owl:ObjectProperty ; rdfs:domain ifweb:ApplicationHost ; rdfs:range ifcore:InformationSystem ;
    rdfs:comment "The host's entry in the system inventory, which carries its data class, owner role, provider and recovery objectives (0046 FR-012; 0033-systems-and-data-policy FR-001)."@en .
