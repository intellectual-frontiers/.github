ex:R15 a ifcore:ReflectionRelationship ; ifcore:relationType ifcore:Implements ; ifcore:relationFrom ex:ExtensionRegistry ; ifcore:relationTo ifcore:ExtensionContractCapability ;
    ifcore:claimLabel ifcore:UnknownLabel ; ifcore:hasAudience ifcore:Public .
ex:R16 a ifcore:ReflectionRelationship ; ifcore:relationType ifcore:DependsOn ; ifcore:relationFrom ex:ExtensionRegistry ; ifcore:relationTo ex:DataStore ;
    ifcore:claimLabel ifcore:UnknownLabel ; ifcore:hasAudience ifcore:Public .
ex:R17 a ifcore:ReflectionRelationship ; ifcore:relationType ifcore:PartOf ; ifcore:relationFrom ex:AccessService ; ifcore:relationTo ex:ExamplePlatform ;
