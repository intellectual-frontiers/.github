ex:IntakeSolution a schema:Service ; rdfs:label "Example Intake"@en ; dcterms:identifier "example-intake" ; dcterms:type ifcore:SolutionOffer ; ifcore:hasAudience ifcore:Public .
ex:IntakeSolutionErgon a ifcore:Ergon ; ifcore:reflects ex:IntakeSolution ;
    ifcore:purpose "Collect and route requests for a customer, using only the interfaces a third party can also use."@en ;
    ifcore:ownerRole ifcore:DecisionAuthorityRole ; ifcore:hasAudience ifcore:Public .
ex:R24 a ifcore:ReflectionRelationship ; ifcore:relationType ifcore:BuiltOn ; ifcore:relationFrom ex:IntakeSolution ; ifcore:relationTo ex:ExamplePlatform ;
    ifcore:claimLabel ifcore:UnknownLabel ; ifcore:hasAudience ifcore:Public .
