ex:R19 a ifcore:ReflectionRelationship ; ifcore:relationType ifcore:DependsOn ; ifcore:relationFrom ex:AccessService ; ifcore:relationTo ex:DataStore ;
    ifcore:claimLabel ifcore:UnknownLabel ; ifcore:hasAudience ifcore:Public .
ex:R20 a ifcore:ReflectionRelationship ; ifcore:relationType ifcore:PartOf ; ifcore:relationFrom ex:IntegrationEngine ; ifcore:relationTo ex:ExamplePlatform ;
