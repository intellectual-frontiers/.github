  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/id/mizan/term-ifws-Action">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#OntologyTerm"/>
    <rdfs:label xml:lang="en">ifws:Action</rdfs:label>
    <mz:basis rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Specializes"/>
    <mz:definedBy>0023-if-workspaces FR-023</mz:definedBy>
