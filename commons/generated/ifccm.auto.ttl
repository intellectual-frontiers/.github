ifccm:AuthorityFunction a owl:Class ;
    rdfs:label "Authority function"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "binds, authorizes, verifies or plans: the four functions of authority that are kept apart."@en .

ifccm:Authorizes a ifccm:AuthorityFunction ;
    rdfs:label "authorizes"@en ;
    skos:definition "A departure, a waiver, an exception, a baseline or a release, with the role that approved it."@en ;
    ifccm:instrument "Decision" .

ifccm:Baseline a owl:Class ;
    rdfs:label "Baseline"@en ;
    rdfs:subClassOf prov:Collection ;
    skos:definition "The configuration items at one revision, established by a Decision."@en .

ifccm:Binds a ifccm:AuthorityFunction ;
    rdfs:label "binds"@en ;
    skos:definition "What must be."@en ;
    ifccm:instrument "specification" .

ifccm:Capability a owl:Class ;
    rdfs:label "Capability"@en ;
    skos:definition "The unit of change: one ability of a harness that can be named, specified, built, proved and released. Never a feature, an epic or a product."@en .

ifccm:CapabilityRequest a ifccm:ChangeRequestKind ;
    rdfs:label "capability request"@en ;
    skos:definition "A request to add or change a capability."@en .

ifccm:Change a owl:Class ;
    rdfs:label "Change"@en ;
    rdfs:subClassOf prov:Activity ;
    skos:definition "The work done under one or more change requests: its commits and the pull or merge request that carries them."@en .

ifccm:ChangeRequest a owl:Class ;
    rdfs:label "Change request"@en ;
    rdfs:subClassOf oslc_cm:ChangeRequest ;
    skos:definition "An issue on a Git host that plans a capability or reports a problem; it plans and traces and authorizes nothing."@en .

ifccm:ChangeRequestKind a owl:Class ;
    rdfs:label "Change request kind"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "capability request or problem."@en .

ifccm:ChangeRequestState a owl:Class ;
    rdfs:label "Change request state"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "open or closed, as the Git host keeps it."@en .

ifccm:Closed a ifccm:ChangeRequestState ;
    rdfs:label "closed"@en ;
    skos:definition "The change request is finished: the commit that Closes it has been made."@en .

ifccm:Closes a ifccm:IssueReferenceKind ;
    rdfs:label "Closes"@en ;
    skos:definition "The commit finishes the change request, and is the only one that closes it."@en .

ifccm:ConfigurationItem a owl:Class ;
    rdfs:label "Configuration item"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "Anything a change may alter that is under control: a specification, an ontology file, a source file, a test, a generated file, a pin."@en .

ifccm:DeviceQuality a ifccm:RegulatedDomain ;
    rdfs:label "device quality"@en ;
    skos:definition "The quality management system of a medical-device manufacturer: 21 CFR Part 820, which incorporates ISO 13485:2016 by reference."@en ;
    ifccm:regulatedBy mzid:authority-21-cfr-820 .

ifccm:DeviceSoftware a ifccm:RegulatedDomain ;
    rdfs:label "device software"@en ;
    skos:definition "The software life cycle of a medical device: IEC 62304."@en .

ifccm:ElectronicRecords a ifccm:RegulatedDomain ;
    rdfs:label "electronic records"@en ;
    skos:definition "Electronic records and electronic signatures: 21 CFR Part 11."@en ;
    ifccm:regulatedBy mzid:authority-21-cfr-11 .

ifccm:EnforcementPhase a owl:Class ;
    rdfs:label "Enforcement phase"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "warn before a harness declares production, gate from the day it does."@en .

ifccm:FederalSecurity a ifccm:RegulatedDomain ;
    rdfs:label "federal security"@en ;
    skos:definition "The security controls of NIST SP 800-53 and the FedRAMP baselines."@en .

ifccm:Gate a ifccm:EnforcementPhase ;
    rdfs:label "gate"@en ;
    skos:definition "A finding fails whatever the baseline holds."@en .

ifccm:HarnessDeclaration a owl:Class ;
    rdfs:label "Harness declaration"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "A harness's statement of the regulated domains it claims and the day it declares production; the one source of the phase of enforcement."@en .

ifccm:IssueReferenceKind a owl:Class ;
    rdfs:label "Issue reference kind"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Refs or Closes: how a commit names a change request."@en .

ifccm:Open a ifccm:ChangeRequestState ;
    rdfs:label "open"@en ;
    skos:definition "The change request is not finished: a commit may name it with Refs."@en .

ifccm:Plans a ifccm:AuthorityFunction ;
    rdfs:label "plans and traces"@en ;
    skos:definition "What is to be done, and where it can be followed; it authorizes nothing."@en ;
    ifccm:instrument "issue" .

ifccm:Problem a ifccm:ChangeRequestKind ;
    rdfs:label "problem"@en ;
    skos:definition "A report that something departs from what is specified or required, opened by a person or by the system from a nonconformance."@en .

ifccm:Refs a ifccm:IssueReferenceKind ;
    rdfs:label "Refs"@en ;
    skos:definition "The commit is work toward the change request, which stays open."@en .

ifccm:RegulatedDomain a owl:Class ;
    rdfs:label "Regulated domain"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A domain of regulation a harness may claim: federal security, device quality, electronic records, device software, trust services."@en .

ifccm:StageCode a ifccm:TraceStage ;
    rdfs:label "code"@en ;
    skos:definition "A source file that cites the requirement."@en ;
    ifccm:anchor "// Spec: NNNN-slug FR-nnn" ;
    ifccm:stageNumber 4 .

ifccm:StageIssue a ifccm:TraceStage ;
    rdfs:label "change request"@en ;
    skos:definition "The issue that plans the change."@en ;
    ifccm:anchor "Refs #N, Closes #N" ;
    ifccm:stageNumber 1 .

ifccm:StageRequirement a ifccm:TraceStage ;
    rdfs:label "requirement"@en ;
    skos:definition "A numbered requirement of a specification that the change adds or changes."@en ;
    ifccm:anchor "Done when: NNNN-slug FR-nnn" ;
    ifccm:stageNumber 2 .

ifccm:StageRun a ifccm:TraceStage ;
    rdfs:label "quality run"@en ;
    skos:definition "A run of the quality system whose record shows the test passed at a revision."@en ;
    ifccm:anchor "the evidence file of the run" ;
    ifccm:stageNumber 6 .

ifccm:StageTerm a ifccm:TraceStage ;
    rdfs:label "ontology term"@en ;
    skos:definition "The term of the ontology that defines what the requirement names."@en ;
    ifccm:anchor "mz:definedBy" ;
    ifccm:stageNumber 3 .

ifccm:StageTest a ifccm:TraceStage ;
    rdfs:label "test"@en ;
    skos:definition "A test that proves the requirement."@en ;
    ifccm:anchor "proves([...])" ;
    ifccm:stageNumber 5 .

ifccm:TraceStage a owl:Class ;
    rdfs:label "Trace stage"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "One link of the chain from a change request to a quality run."@en .

ifccm:TrustServices a ifccm:RegulatedDomain ;
    rdfs:label "trust services"@en ;
    skos:definition "The security, availability and confidentiality of a service, assessed against SOC 2's Trust Services Criteria or ISO/IEC 27001."@en .

ifccm:Verifies a ifccm:AuthorityFunction ;
    rdfs:label "verifies"@en ;
    skos:definition "Whether what is, is what must be."@en ;
    ifccm:instrument "check" .

ifccm:Warn a ifccm:EnforcementPhase ;
    rdfs:label "warn"@en ;
    skos:definition "A finding is a warning held by a baseline that only shrinks."@en .

ifccm:anchor a owl:DatatypeProperty ;
    rdfs:domain ifccm:TraceStage ;
    rdfs:label "anchor"@en ;
    rdfs:range xsd:string ;
    skos:definition "The annotation that already links the stage, so that no new one is needed."@en .

ifccm:approvedBy a owl:DatatypeProperty ;
    rdfs:domain ifccm:Change ;
    rdfs:label "approved by"@en ;
    rdfs:range xsd:string ;
    skos:definition "The role that approved the change; never the role that authored it where the harness is regulated."@en .

ifccm:area a owl:DatatypeProperty ;
    rdfs:domain ifccm:Capability ;
    rdfs:label "area"@en ;
    rdfs:range xsd:string ;
    skos:definition "The area of the harness (a rung or a subject) whose parent change request the capability is a child of."@en .

ifccm:authorizedBy a owl:ObjectProperty ;
    rdfs:domain ifccm:Change ;
    rdfs:label "authorized by"@en ;
    rdfs:range mz:Decision ;
    skos:definition "The Decision that authorizes the change, where one is needed."@en .

ifccm:baselineRevision a owl:DatatypeProperty ;
    rdfs:domain ifccm:Baseline ;
    rdfs:label "baseline revision"@en ;
    rdfs:range xsd:string ;
    skos:definition "The revision the baseline is established at."@en .

ifccm:changesItem a owl:ObjectProperty ;
    rdfs:domain ifccm:Change ;
    rdfs:label "changes item"@en ;
    rdfs:range ifccm:ConfigurationItem ;
    skos:definition "A configuration item the change alters."@en .

ifccm:checkItem a owl:DatatypeProperty ;
    rdfs:domain ifccm:ChangeRequest ;
    rdfs:label "check item"@en ;
    rdfs:range xsd:string ;
    skos:definition "A minor task: a checkbox item in the body of the change request."@en .

ifccm:doneWhen a owl:DatatypeProperty ;
    rdfs:domain ifccm:ChangeRequest ;
    rdfs:label "done when"@en ;
    rdfs:range xsd:string ;
    skos:definition "The requirements and the checks that decide the capability is done: the fourth section."@en .

ifccm:establishedBy a owl:ObjectProperty ;
    rdfs:domain ifccm:Baseline ;
    rdfs:label "established by"@en ;
    rdfs:range mz:Decision ;
    skos:definition "The Decision that establishes the baseline."@en .

ifccm:harness a owl:DatatypeProperty ;
    rdfs:domain ifccm:HarnessDeclaration ;
    rdfs:label "harness"@en ;
    rdfs:range xsd:string ;
    skos:definition "The harness the declaration is of, by its repository."@en .

ifccm:hostedOn a owl:ObjectProperty ;
    rdfs:domain ifccm:ChangeRequest ;
    rdfs:label "hosted on"@en ;
    rdfs:range ifws:GitManagerKind ;
    skos:definition "The kind of Git host that keeps the change request."@en .

ifccm:implementsRequest a owl:ObjectProperty ;
    rdfs:domain ifccm:Change ;
    rdfs:label "implements request"@en ;
    rdfs:range ifccm:ChangeRequest ;
    skos:definition "A change request the change implements: the change used it as its plan."@en .

ifccm:includesItem a owl:ObjectProperty ;
    rdfs:domain ifccm:Baseline ;
    rdfs:label "includes item"@en ;
    rdfs:range ifccm:ConfigurationItem ;
    skos:definition "A configuration item the baseline holds."@en .

ifccm:instrument a owl:DatatypeProperty ;
    rdfs:domain ifccm:AuthorityFunction ;
    rdfs:label "instrument"@en ;
    rdfs:range xsd:string ;
    skos:definition "What carries the function: a specification, a Decision, a check or an issue."@en .

ifccm:itemPath a owl:DatatypeProperty ;
    rdfs:domain ifccm:ConfigurationItem ;
    rdfs:label "item path"@en ;
    rdfs:range xsd:string ;
    skos:definition "Where the configuration item is in the repository, with `/`."@en .

ifccm:parentRequest a owl:ObjectProperty ;
    rdfs:domain ifccm:Capability ;
    rdfs:label "parent request"@en ;
    rdfs:range ifccm:ChangeRequest ;
    skos:definition "The parent change request of the capability's area."@en .

ifccm:productionDeclaredOn a owl:DatatypeProperty ;
    rdfs:domain ifccm:HarnessDeclaration ;
    rdfs:label "production declared on"@en ;
    rdfs:range xsd:string ;
    skos:definition "The day (YYYY-MM-DD) the harness declares production: findings are warnings before it and gate from it."@en .

ifccm:reference a owl:DatatypeProperty ;
    rdfs:domain ifccm:ChangeRequest ;
    rdfs:label "reference"@en ;
    rdfs:range xsd:string ;
    skos:definition "How a commit names the change request: `#N`, or `owner/repo#N` for another repository."@en .

ifccm:referenceKind a owl:ObjectProperty ;
    rdfs:domain ifccm:Change ;
    rdfs:label "reference kind"@en ;
    rdfs:range ifccm:IssueReferenceKind ;
    skos:definition "Refs or Closes: how the change's commit names its change request."@en .

ifccm:regulatedBy a owl:ObjectProperty ;
    rdfs:domain ifccm:RegulatedDomain ;
    rdfs:label "regulated by"@en ;
    rdfs:range mz:Authority ;
    skos:definition "The law a regulated domain rests on, where it rests on law."@en .

ifccm:regulatedDomain a owl:ObjectProperty ;
    rdfs:domain ifccm:HarnessDeclaration ;
    rdfs:label "regulated domain"@en ;
    rdfs:range ifccm:RegulatedDomain ;
    skos:definition "A regulated domain the harness claims."@en .

ifccm:requestKind a owl:ObjectProperty ;
    rdfs:domain ifccm:ChangeRequest ;
    rdfs:label "request kind"@en ;
    rdfs:range ifccm:ChangeRequestKind ;
    skos:definition "capability request or problem."@en .

ifccm:requestState a owl:ObjectProperty ;
    rdfs:domain ifccm:ChangeRequest ;
    rdfs:label "request state"@en ;
    rdfs:range ifccm:ChangeRequestState ;
    skos:definition "open or closed."@en .

ifccm:requestsCapability a owl:ObjectProperty ;
    rdfs:domain ifccm:ChangeRequest ;
    rdfs:label "requests capability"@en ;
    rdfs:range ifccm:Capability ;
    skos:definition "The capability the change request asks for."@en .

ifccm:requirement a owl:DatatypeProperty ;
    rdfs:domain ifccm:Capability ;
    rdfs:label "requirement"@en ;
    rdfs:range xsd:string ;
    skos:definition "A requirement the capability adds or changes, as `NNNN-slug FR-nnn`."@en .

ifccm:revision a owl:DatatypeProperty ;
    rdfs:domain ifccm:Change ;
    rdfs:label "revision"@en ;
    rdfs:range xsd:string ;
    skos:definition "A commit of the change, by its revision identifier."@en .

ifccm:satisfiesControl a owl:DatatypeProperty ;
    rdfs:domain ifccm:Capability ;
    rdfs:label "satisfies control"@en ;
    rdfs:range xsd:string ;
    skos:definition "The OSCAL identifier of a NIST SP 800-53 control the capability satisfies (cm-3)."@en .

ifccm:scope a owl:DatatypeProperty ;
    rdfs:domain ifccm:ChangeRequest ;
    rdfs:label "scope"@en ;
    rdfs:range xsd:string ;
    skos:definition "What the capability changes and what it leaves alone: the third section."@en .

ifccm:stageNumber a owl:DatatypeProperty ;
    rdfs:domain ifccm:TraceStage ;
    rdfs:label "stage number"@en ;
    rdfs:range xsd:integer ;
    skos:definition "The place of the stage in the chain, from 1."@en .

ifccm:subRequestOf a owl:ObjectProperty ;
    rdfs:domain ifccm:ChangeRequest ;
    rdfs:label "sub-request of"@en ;
    rdfs:range ifccm:ChangeRequest ;
    skos:definition "The parent change request of a child change request (a sub-issue)."@en .

ifccm:today a owl:DatatypeProperty ;
    rdfs:domain ifccm:ChangeRequest ;
    rdfs:label "today"@en ;
    rdfs:range xsd:string ;
    skos:definition "What is true today: the second section."@en .

ifccm:touchesRung a owl:ObjectProperty ;
    rdfs:domain ifccm:Capability ;
    rdfs:label "touches rung"@en ;
    rdfs:range mz:Rung ;
    skos:definition "A rung of the ladder the capability changes: the source of the generated view of capabilities by rung."@en .

ifccm:why a owl:DatatypeProperty ;
    rdfs:domain ifccm:ChangeRequest ;
    rdfs:label "why"@en ;
    rdfs:range xsd:string ;
    skos:definition "Why the capability is wanted: the first section of its issue."@en .

<https://www.intellectualfrontiers.com/ontology/ifccm> a owl:Ontology ;
    <http://purl.org/dc/terms/description> "The vocabulary of Intellectual Frontiers Capabilities Configuration Management: the capability as the unit of change, change requests, changes, configuration items, baselines, a harness's declaration and the trace chain."@en ;
    rdfs:label "IFCCM"@en ;
    owl:versionIRI ifccmv:1 ;
    owl:versionInfo "1" .
