AnnotationAssertion(rdfs:label act:SignatureMeaning "Signature meaning"@en)
AnnotationAssertion(skos:definition act:SignatureMeaning "What a signature of a regulated record means: review, approval, responsibility or authorship."@en)
SubClassOf(act:SignatureMeaning skos:Concept)
AnnotationAssertion(rdfs:label act:Tasking "Tasking"@en)
AnnotationAssertion(skos:definition act:Tasking "A person's signed authority to use an agent configuration within a scope, at a level, until an expiry; the person keeps the initiative and the accountability, and the tasking can be revoked."@en)
SubClassOf(act:Tasking prov:Entity)
AnnotationAssertion(rdfs:label act:TaskingLevel "Tasking level"@en)
AnnotationAssertion(skos:definition act:TaskingLevel "One of the four levels at which an agent may be tasked."@en)
