AnnotationAssertion(rdfs:label act:Actor "Actor"@en)
AnnotationAssertion(skos:definition act:Actor "A person, a system or an agent that takes part in an act. In PROV it is an agent; here the word agent is kept for the AI case."@en)
SubClassOf(act:Actor prov:Agent)
AnnotationAssertion(rdfs:label act:ActorKind "Kind of actor"@en)
AnnotationAssertion(skos:definition act:ActorKind "One of the three kinds of actor: a person, a system or an agent."@en)
SubClassOf(act:ActorKind skos:Concept)
AnnotationAssertion(rdfs:label act:Directive "Directive"@en)
AnnotationAssertion(skos:definition act:Directive "A controlled instruction an act is done under: a work order, a specification, a procedure or a person's request kept by its digest, with an owner who is a person and a version."@en)
SubClassOf(act:Directive prov:Entity)
AnnotationAssertion(rdfs:label act:NonconformityRule "Nonconformity rule"@en)
AnnotationAssertion(skos:definition act:NonconformityRule "One of the rules whose breach by an act is recorded as a nonconformance of the quality ontology."@en)
SubClassOf(act:NonconformityRule skos:Concept)
AnnotationAssertion(rdfs:label act:Qualification "Qualification"@en)
AnnotationAssertion(skos:definition act:Qualification "The record that an agent configuration (model and version, instruction set digest, tool permissions) was shown fit for a use, with its evidence, its validity and the changes that require it to be redone."@en)
SubClassOf(act:Qualification prov:Entity)
AnnotationAssertion(rdfs:label act:ReviewCanary "Review canary"@en)
AnnotationAssertion(skos:definition act:ReviewCanary "A defect seeded into an artifact, so that whether a review catches it measures whether the review is real."@en)
