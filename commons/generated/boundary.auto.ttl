bnd:AuthorizationBoundary a bnd:BoundaryKind ;
    rdfs:label "Authorization boundary"@en ;
    skos:definition "All the components of an information system that one authorizing official authorizes to operate; separately authorized systems it is connected to are outside it."@en .

bnd:Boundary a owl:Class ;
    rdfs:label "Boundary"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "The line a body of authority draws around the things it answers for, of a kind that a regime defines: typed, versioned and approved by a person. It is not a realm, which is where assets are found."@en .

bnd:BoundaryKind a owl:Class ;
    rdfs:label "Boundary kind"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "One of the kinds of boundary: the authority, the roles of people, the roles of assets and the agreements a regime defines."@en .

bnd:CardholderData a bnd:DataClass ;
    rdfs:label "Cardholder data"@en ;
    skos:definition "The data of a payment card that the card brands' standard requires to be protected."@en .

bnd:CardholderDataEnvironment a bnd:BoundaryKind ;
    rdfs:label "Cardholder data environment"@en ;
    skos:definition "The system components, people and processes that store, process or transmit cardholder data or sensitive authentication data, and the components that are connected to them without restriction."@en .

bnd:Categorization a owl:Class ;
    rdfs:label "Categorization"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "The impact of each of the three security objectives (confidentiality, integrity, availability) of a boundary, as the highest impact among the information types it holds."@en .

bnd:CmmcAssetCategory a owl:Class ;
    rdfs:label "CMMC asset category"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "One of the categories into which the assets of a CUI environment fall for assessment."@en .

bnd:Confidential a bnd:DataClass ;
    rdfs:label "Confidential"@en ;
    skos:definition "Information whose disclosure the organization restricts to those who need it."@en .

bnd:ContractorRiskManagedAsset a bnd:CmmcAssetCategory ;
    rdfs:label "Contractor risk managed asset"@en ;
    skos:definition "An asset that can, but is not meant to, handle controlled unclassified information because of the organization's policy, procedures and practice."@en .

bnd:Controller a bnd:PartyRole ;
    rdfs:label "Controller"@en ;
    skos:definition "The party that decides the purposes and means of processing personal data, alone or with others; a business, a Data Fiduciary or an organization in the words of other regimes."@en .

bnd:Cui a bnd:DataClass ;
    rdfs:label "Controlled unclassified information"@en ;
    skos:definition "Information the Government creates or holds, or an entity holds for it, that a law, regulation or Government-wide policy says is handled with safeguarding or dissemination controls."@en .

bnd:CuiAsset a bnd:CmmcAssetCategory ;
    rdfs:label "CUI asset"@en ;
    skos:definition "An asset that processes, stores or transmits controlled unclassified information."@en .

bnd:CuiEnvironment a bnd:BoundaryKind ;
    rdfs:label "CUI environment"@en ;
    skos:definition "The assessment scope of an organization that handles controlled unclassified information: the assets that process, store or transmit it, the ones that protect them and the ones the organization's own practice keeps from it."@en .

bnd:DataClass a owl:Class ;
    rdfs:label "Data class"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "One of the classes of data that a boundary holds and that a regime defines."@en .

bnd:Disposition a owl:Class ;
    rdfs:label "Disposition"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "One of the decisions about an asset in a boundary: in scope in a role, inherited, external, out of scope or undecided."@en .

bnd:Enclave a owl:Class ;
    rdfs:label "Enclave"@en ;
    rdfs:subClassOf prov:Entity,
        bnd:Boundary ;
    skos:definition "A set of resources that work in one security domain and share the protection of one common, continuous perimeter; a network zone with a single policy and authority."@en .

bnd:EngagementScope a bnd:BoundaryKind ;
    rdfs:label "Engagement scope"@en ;
    skos:definition "The targets, actions and window that a signed engagement allows, and the targets that are off limits."@en .

bnd:Ephi a bnd:DataClass ;
    rdfs:label "Electronic protected health information"@en ;
    skos:definition "The part of protected health information that is transmitted or maintained in electronic media."@en .

bnd:EphiEnvironment a bnd:BoundaryKind ;
    rdfs:label "ePHI environment"@en ;
    skos:definition "The systems, people and services through which a covered entity or a business associate creates, receives, maintains or transmits electronic protected health information."@en .

bnd:External a bnd:Disposition ;
    rdfs:label "External"@en ;
    skos:definition "The asset stands for a system outside the fleet that the boundary relies on or exchanges information with."@en .

bnd:ExternalSystem a owl:Class ;
    rdfs:label "External system"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "A system outside the fleet that a boundary relies on or exchanges information with, with what its party holds to show it may be relied on."@en .

bnd:Fci a bnd:DataClass ;
    rdfs:label "Federal contract information"@en ;
    skos:definition "Information provided by or generated for the Government under a contract that is not meant for public release."@en .

bnd:High a bnd:Impact ;
    rdfs:label "High"@en ;
    skos:definition "The loss of the objective would have a severe or catastrophic adverse effect on operations, assets or people."@en .

bnd:Impact a owl:Class ;
    rdfs:label "Impact"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "One of the ordered levels of potential harm from the loss of a security objective: low, moderate or high."@en .

bnd:InScope a bnd:Disposition ;
    rdfs:label "In scope"@en ;
    skos:definition "The asset is inside the boundary in a role the kind of the boundary names."@en .

bnd:Inheritance a owl:Class ;
    rdfs:label "Inheritance"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "What a provider's authorization, report or certificate supplies to a boundary: the controls it covers, who answers for each and the evidence with its dates."@en .

bnd:Inherited a bnd:Disposition ;
    rdfs:label "Inherited"@en ;
    skos:definition "The asset's requirements are met by what another party provides, under an inheritance that names the controls."@en .

bnd:Interconnection a owl:Class ;
    rdfs:label "Interconnection"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "An approved, agreed and reviewed crossing of a boundary: its two ends, the direction, the data classes, the agreement and the managed interface."@en .

bnd:Internal a bnd:DataClass ;
    rdfs:label "Internal"@en ;
    skos:definition "Information for the organization's own use that carries no further restriction."@en .

bnd:Jurisdiction a owl:Class ;
    rdfs:label "Jurisdiction"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "A country or region whose law governs the data held there; the location of data decides which laws apply to it and what a transfer out of it needs."@en .

bnd:Low a bnd:Impact ;
    rdfs:label "Low"@en ;
    skos:definition "The loss of the objective would have a limited adverse effect on operations, assets or people."@en .

bnd:Moderate a bnd:Impact ;
    rdfs:label "Moderate"@en ;
    skos:definition "The loss of the objective would have a serious adverse effect on operations, assets or people."@en .

bnd:NetworkZone a bnd:BoundaryKind ;
    rdfs:label "Network zone"@en ;
    skos:definition "A set of resources inside one common perimeter, joined to other zones only through managed interfaces: an enclave, a segment or a zone."@en .

bnd:Organizational a bnd:BoundaryKind ;
    rdfs:label "Organizational boundary"@en ;
    skos:definition "What one company, legal entity, tenant or client of a provider of managed services owns or answers for, or a part of it."@en .

bnd:OutOfScope a bnd:Disposition ;
    rdfs:label "Out of scope"@en ;
    skos:definition "The asset is outside the boundary by a person's decision, with a justification, evidence and an expiry."@en .

bnd:OutOfScopeAsset a bnd:CmmcAssetCategory ;
    rdfs:label "Out-of-scope asset"@en ;
    skos:definition "An asset that cannot handle controlled unclassified information and does not protect the assets that do; the organization is prepared to justify that."@en .

bnd:PartyRole a owl:Class ;
    rdfs:label "Party role"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "One of the two roles that privacy regimes give the parties to the processing of personal data: the one that decides and the one that processes for it."@en .

bnd:PersonalData a bnd:DataClass ;
    rdfs:label "Personal data"@en ;
    skos:definition "Information about an identified or identifiable natural person, in the words of the privacy regime that governs it."@en .

bnd:Phi a bnd:DataClass ;
    rdfs:label "Protected health information"@en ;
    skos:definition "Individually identifiable health information, in any form or medium, with the exclusions the rule lists."@en .

bnd:Privacy a bnd:BoundaryKind ;
    rdfs:label "Privacy boundary"@en ;
    skos:definition "The personal data and the processing activities that one controller or business answers for under one privacy regime."@en .

bnd:ProcessingActivity a owl:Class ;
    rdfs:label "Processing activity"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "A purpose of processing personal data with its legal basis, the people and data it concerns, the systems, the recipients, the transfers and the retention."@en .

bnd:Processor a bnd:PartyRole ;
    rdfs:label "Processor"@en ;
    skos:definition "The party that processes personal data on behalf of a controller; a service provider, a contractor, an operador, a data intermediary or a Data Processor in the words of other regimes."@en .

bnd:Public a bnd:DataClass ;
    rdfs:label "Public"@en ;
    skos:definition "Information that may be disclosed without restriction."@en .

bnd:Realm a owl:Class ;
    rdfs:label "Realm"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "Where assets are found and what a connection may read: an account, a tenant, a cluster, a site or a LAN. It says nothing about who answers for the assets."@en .

bnd:SecurityProtectionAsset a bnd:CmmcAssetCategory ;
    rdfs:label "Security protection asset"@en ;
    skos:definition "An asset that provides security functions or capabilities to the assessment scope."@en .

bnd:SecurityProtectionData a bnd:DataClass ;
    rdfs:label "Security protection data"@en ;
    skos:definition "Data about the protections of an environment: its configuration, logs and credentials."@en .

bnd:SensitiveAuthenticationData a bnd:DataClass ;
    rdfs:label "Sensitive authentication data"@en ;
    skos:definition "The data used to authenticate a cardholder or authorize a card transaction, which must not be kept after authorization."@en .

bnd:Soc2System a bnd:BoundaryKind ;
    rdfs:label "SOC 2 system"@en ;
    skos:definition "The system a service organization's report describes: its services, components, controls and the boundaries of what the description covers, with its subservice organizations."@en .

bnd:SpecialCategoryData a bnd:DataClass ;
    rdfs:label "Special category data"@en ;
    skos:definition "Personal data of the kinds a regime sets apart for stronger protection, such as health, biometric or beliefs."@en .

bnd:SpecializedAsset a bnd:CmmcAssetCategory ;
    rdfs:label "Specialized asset"@en ;
    skos:definition "An asset that can handle controlled unclassified information but cannot be fully secured: an internet-of-things or operational technology device, government furnished equipment, a restricted system or test equipment."@en .

bnd:Trust a bnd:BoundaryKind ;
    rdfs:label "Trust boundary"@en ;
    skos:definition "A line of a threat model across which data or control passes between parts that are trusted differently."@en .

bnd:Undecided a bnd:Disposition ;
    rdfs:label "Undecided"@en ;
    skos:definition "No one has decided; every asset has this disposition in a boundary until a person decides, and it is a finding."@en .

bnd:boundaryId a owl:DatatypeProperty ;
    rdfs:domain bnd:Boundary ;
    rdfs:label "boundary id"@en ;
    rdfs:range xsd:string ;
    skos:definition "The id of the boundary: lower case words joined by hyphens."@en .

bnd:boundaryKind a owl:ObjectProperty ;
    rdfs:domain bnd:Boundary ;
    rdfs:label "boundary kind"@en ;
    rdfs:range bnd:BoundaryKind ;
    skos:definition "The kind of the boundary, which decides its authority, roles and agreements."@en .

bnd:categorizedAs a owl:ObjectProperty ;
    rdfs:domain bnd:Boundary ;
    rdfs:label "categorized as"@en ;
    rdfs:range bnd:Categorization ;
    skos:definition "The categorization of the boundary: the impact of each security objective."@en .

bnd:residentIn a owl:ObjectProperty ;
    rdfs:domain bnd:Boundary ;
    rdfs:label "resident in"@en ;
    rdfs:range bnd:Jurisdiction ;
    skos:definition "The jurisdiction in which the data of the boundary is held; the data residency the boundary is constrained to."@en .

<https://www.intellectualfrontiers.com/ontology/boundary> a owl:Ontology ;
    <http://purl.org/dc/terms/description> "The vocabulary of Boundaries: a boundary as the accountability scope of a kind that a regime defines, the dispositions of assets in it, the interconnections that cross it and what it inherits."@en ;
    rdfs:label "Boundary"@en ;
    owl:versionIRI bndv:1.0.0 ;
    owl:versionInfo "1.0.0" .
