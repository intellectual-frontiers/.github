mzid:term-ifr-Manifestation a mz:OntologyTerm ;
    rdfs:label "ifr:Manifestation"@en ;
    mz:basis mz:Specializes ;
    mz:definedBy "0026-works-versioning FR-003" ;
    mz:justification "LRM's Manifestation, the rendition. schema.org's CreativeWork names no level of a work, and IFLA LRM (Work, Expression, Manifestation, Item; its namespace and IRIs are to verify) and FRBR do, so the class is a CreativeWork and the level is kept by the properties that join them" ;
    mz:mappingRelation "subClassOf" ;
    mz:standardTerm "https://schema.org/CreativeWork" ;
    mz:termIri "https://www.intellectualfrontiers.com/ontology/ifr#Manifestation" .

mzid:term-ifr-Release a mz:OntologyTerm ;
    rdfs:label "ifr:Release"@en ;
    mz:basis mz:Specializes ;
    mz:definedBy "0026-works-versioning FR-017" ;
    mz:justification "A release is the entity a tag names; its lineage is PROV-O's wasRevisionOf and wasDerivedFrom, and SPDX 3 names the version of a package software_packageVersion (its IRI is to verify)" ;
    mz:mappingRelation "subClassOf" ;
    mz:standardTerm "http://www.w3.org/ns/prov#Entity" ;
    mz:termIri "https://www.intellectualfrontiers.com/ontology/ifr#Release" .

