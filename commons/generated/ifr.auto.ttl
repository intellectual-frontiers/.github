ifr:ApprovalRecord a owl:Class ;
    rdfs:label "Approval record"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "The approval of a revision of a controlled document: a person, a role, a day and the Decision."@en .

ifr:Citation a owl:Class ;
    rdfs:label "Citation"@en ;
    skos:definition "How a work is cited: its `CITATION.cff`, generated from its release record, with a DOI only where the record carries one."@en .

ifr:CommandLineInterface a ifr:WorkKind ;
    rdfs:label "command-line interface"@en ;
    skos:definition "A command, its options and its output, which a script depends on."@en ;
    ifr:usesScheme ifr:SemVer .

ifr:CommitDateEdition a ifr:VersionScheme ;
    rdfs:label "commit-date edition"@en ;
    skos:definition "The UTC date of the commit the edition is made at, a hyphen and the first eight characters of that commit: YYYY.MM.DD-commit8; never the clock."@en ;
    ifr:precedenceRule "the date, and where the dates are equal the later commit in the history; two editions of one commit are one edition" ;
    ifr:versionPattern "^[0-9]{4}[.][0-9]{2}[.][0-9]{2}-[0-9a-f]{8}$" .

ifr:ControlledDocument a ifr:WorkKind ;
    rdfs:label "controlled document"@en ;
    skos:definition "A policy or a procedure under document control: an integer revision and an approval."@en ;
    ifr:usesScheme ifr:IntegerRevision .

ifr:Data a ifr:WorkKind ;
    rdfs:label "data"@en ;
    skos:definition "A dataset: a snapshot with its digest, and a SemVer for its schema."@en ;
    ifr:companionScheme ifr:SemVer ;
    ifr:usesScheme ifr:SnapshotDate .

ifr:Edition a owl:Class ;
    rdfs:label "Edition"@en ;
    rdfs:subClassOf ifr:Release ;
    skos:definition "A release of published prose, whose version is a commit-date edition."@en .

ifr:Expression a owl:Class ;
    rdfs:label "Expression"@en ;
    rdfs:subClassOf schema:CreativeWork ;
    skos:definition "A state of a work's content, which a version or an edition names: the text or the code as it was at one commit, in no form yet."@en .

ifr:Impact a owl:Class ;
    rdfs:label "Impact"@en ;
    skos:definition "Major, minor or patch: what a change does to those who use the work, from which the next version is made."@en .

ifr:IntegerRevision a ifr:VersionScheme ;
    rdfs:label "integer revision"@en ;
    skos:definition "A whole number from 1 that a controlled document's revision carries, raised only with an approval record."@en ;
    ifr:precedenceRule "the number, greater is later" ;
    ifr:versionPattern "^[1-9][0-9]*$" .

ifr:Library a ifr:WorkKind ;
    rdfs:label "library"@en ;
    skos:definition "Code another program imports."@en ;
    ifr:usesScheme ifr:SemVer .

ifr:Major a ifr:Impact ;
    rdfs:label "major"@en ;
    skos:definition "A change that breaks what a user of the work relied on."@en ;
    ifr:impactRank 3 .

ifr:Manifestation a owl:Class ;
    rdfs:label "Manifestation"@en ;
    rdfs:subClassOf schema:CreativeWork ;
    skos:definition "A rendition of an expression: a PDF, an EPUB, a print run, a package; it has a format and, where printed, a printing, and no version of its own."@en .

ifr:Minor a ifr:Impact ;
    rdfs:label "minor"@en ;
    skos:definition "A change that adds and breaks nothing."@en ;
    ifr:impactRank 2 .

ifr:NoVersion a ifr:VersionScheme ;
    rdfs:label "no version"@en ;
    skos:definition "The scheme of a specification: it has no version, its requirement identifiers are never renumbered and its revision is the commit."@en ;
    ifr:precedenceRule "none: the commit orders the revisions" .

ifr:Ontology a ifr:WorkKind ;
    rdfs:label "ontology"@en ;
    skos:definition "A published vocabulary: its terms are its interface."@en ;
    ifr:usesScheme ifr:SemVer .

ifr:Patch a ifr:Impact ;
    rdfs:label "patch"@en ;
    skos:definition "A change that corrects and adds nothing."@en ;
    ifr:impactRank 1 .

ifr:Prose a ifr:WorkKind ;
    rdfs:label "prose"@en ;
    skos:definition "A book, a manual or a paper: published text."@en ;
    ifr:usesScheme ifr:CommitDateEdition .

ifr:Release a owl:Class ;
    rdfs:label "Release"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "A version of a work that was published: it names its commit and its Git tree hash, is named by a signed annotated tag and is immutable."@en .

ifr:ReleaseRecord a owl:Class ;
    rdfs:label "Release record"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "The typed file `<work>/release.ts` that names a work's kind, its identity and its present version, written by a tool and never by hand."@en .

ifr:ReleaseTag a owl:Class ;
    rdfs:label "Release tag"@en ;
    skos:definition "The signed annotated Git tag `<slug>-v<version>` that makes a version a release; the ledger of releases is derived from these tags."@en .

ifr:Retention a owl:Class ;
    rdfs:label "Retention"@en ;
    skos:definition "How long the bytes of a published version are kept: digests and metadata are kept forever, bytes only for the period stated."@en .

ifr:Schema a ifr:WorkKind ;
    rdfs:label "schema"@en ;
    skos:definition "A published schema of data or of a message."@en ;
    ifr:usesScheme ifr:SemVer .

ifr:SemVer a ifr:VersionScheme ;
    rdfs:label "SemVer"@en ;
    skos:definition "Semantic Versioning 2.0.0: MAJOR.MINOR.PATCH with an optional pre-release; build metadata after a plus sign is not part of precedence."@en ;
    ifr:precedenceRule "SemVer 2.0.0 section 11: major, minor and patch as numbers, a pre-release before its release, build metadata ignored" ;
    ifr:versionPattern "^(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)([.](0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*))?([+][0-9a-zA-Z-]+([.][0-9a-zA-Z-]+)*)?$" .

ifr:SnapshotDate a ifr:VersionScheme ;
    rdfs:label "snapshot date"@en ;
    skos:definition "The day a dataset was snapshotted, YYYY-MM-DD, with the SHA-256 of the snapshot kept beside it and a SemVer for the schema of the data."@en ;
    ifr:precedenceRule "the date, later is greater; one date is one snapshot" ;
    ifr:versionPattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" .

ifr:Software a ifr:WorkKind ;
    rdfs:label "software"@en ;
    skos:definition "A program or a service."@en ;
    ifr:usesScheme ifr:SemVer .

ifr:Specification a ifr:WorkKind ;
    rdfs:label "specification"@en ;
    skos:definition "A specification: it has no version."@en ;
    ifr:usesScheme ifr:NoVersion .

ifr:Tombstone a owl:Class ;
    rdfs:label "Tombstone"@en ;
    skos:definition "What an identifier resolves to where the bytes of a version are gone: the version's metadata, its digest and the day the bytes were removed."@en .

ifr:VersionScheme a owl:Class ;
    rdfs:label "Version scheme"@en ;
    skos:definition "One way of writing a version and ordering versions: SemVer, commit-date edition, snapshot date, integer revision or none."@en .

ifr:Work a owl:Class ;
    rdfs:label "Work"@en ;
    rdfs:subClassOf schema:CreativeWork ;
    skos:definition "A work in its identity: a slug and an IRI that never change, whatever is published of it and however often; a volume's position in a series never changes either."@en .

ifr:WorkKind a owl:Class ;
    rdfs:label "Work kind"@en ;
    skos:definition "The kind of a work, which fixes the one scheme of version it uses."@en .

ifr:approvalDecision a owl:ObjectProperty ;
    rdfs:domain ifr:ApprovalRecord ;
    rdfs:label "approval decision"@en ;
    rdfs:range mz:Decision ;
    skos:definition "The Decision that records the approval."@en .

ifr:approvalOf a owl:ObjectProperty ;
    rdfs:domain ifr:ApprovalRecord ;
    rdfs:label "approval of"@en ;
    rdfs:range ifr:Release ;
    skos:definition "The revision the approval is of."@en .

ifr:approvedBy a owl:DatatypeProperty ;
    rdfs:domain ifr:ApprovalRecord ;
    rdfs:label "approved by"@en ;
    rdfs:range xsd:string ;
    skos:definition "The person who approved: data in the record, never inferred."@en .

ifr:approvedOn a owl:DatatypeProperty ;
    rdfs:domain ifr:ApprovalRecord ;
    rdfs:label "approved on"@en ;
    rdfs:range xsd:string ;
    skos:definition "The day (YYYY-MM-DD) of the approval."@en .

ifr:approverRole a owl:DatatypeProperty ;
    rdfs:domain ifr:ApprovalRecord ;
    rdfs:label "approver role"@en ;
    rdfs:range xsd:string ;
    skos:definition "The role in which the person approved."@en .

ifr:archivedOn a owl:DatatypeProperty ;
    rdfs:domain ifr:Release ;
    rdfs:label "archived on"@en ;
    rdfs:range xsd:string ;
    skos:definition "The day the release was archived."@en .

ifr:bookEditionNumber a owl:DatatypeProperty ;
    rdfs:domain ifr:Edition ;
    rdfs:label "book edition number"@en ;
    rdfs:range xsd:integer ;
    skos:definition "The edition number a publisher prints (schema.org `bookEdition`): a label of the edition, never its version."@en .

ifr:bytesRemovedOn a owl:DatatypeProperty ;
    rdfs:domain ifr:Tombstone ;
    rdfs:label "bytes removed on"@en ;
    rdfs:range xsd:string ;
    skos:definition "The day the bytes were removed."@en .

ifr:checksum a owl:DatatypeProperty ;
    rdfs:domain ifr:Release ;
    rdfs:label "checksum"@en ;
    rdfs:range xsd:string ;
    skos:definition "The SHA-256 of an artifact of the release."@en .

ifr:citationFormat a owl:DatatypeProperty ;
    rdfs:domain ifr:Citation ;
    rdfs:label "citation format"@en ;
    rdfs:range xsd:string ;
    skos:definition "The format of the citation file: `CITATION.cff` 1.2.0."@en .

ifr:citationOf a owl:ObjectProperty ;
    rdfs:domain ifr:Citation ;
    rdfs:label "citation of"@en ;
    rdfs:range ifr:Work ;
    skos:definition "The work the citation is of."@en .

ifr:companionScheme a owl:ObjectProperty ;
    rdfs:domain ifr:WorkKind ;
    rdfs:label "companion scheme"@en ;
    rdfs:range ifr:VersionScheme ;
    skos:definition "The scheme of a second version a kind carries beside its own: the schema of a dataset."@en .

ifr:declaredImpact a owl:ObjectProperty ;
    rdfs:domain ifr:Release ;
    rdfs:label "declared impact"@en ;
    rdfs:range ifr:Impact ;
    skos:definition "The impact the capability that raised the version declared."@en .

ifr:digestKept a owl:DatatypeProperty ;
    rdfs:domain ifr:Tombstone ;
    rdfs:label "digest kept"@en ;
    rdfs:range xsd:string ;
    skos:definition "The SHA-256 of the bytes that were removed."@en .

ifr:hasApproval a owl:ObjectProperty ;
    rdfs:domain ifr:Release ;
    rdfs:label "has approval"@en ;
    rdfs:range ifr:ApprovalRecord ;
    skos:definition "The approval of a revision of a controlled document."@en .

ifr:hasCitation a owl:ObjectProperty ;
    rdfs:domain ifr:Work ;
    rdfs:label "has citation"@en ;
    rdfs:range ifr:Citation ;
    skos:definition "How the work is cited."@en .

ifr:hasExpression a owl:ObjectProperty ;
    rdfs:domain ifr:Work ;
    rdfs:label "has expression"@en ;
    rdfs:range ifr:Expression ;
    skos:definition "A state of the work's content."@en .

ifr:hasRelease a owl:ObjectProperty ;
    rdfs:domain ifr:Work ;
    rdfs:label "has release"@en ;
    rdfs:range ifr:Release ;
    skos:definition "A release of the work."@en .

ifr:hasRendition a owl:ObjectProperty ;
    rdfs:domain ifr:Expression ;
    rdfs:label "has rendition"@en ;
    rdfs:range ifr:Manifestation ;
    skos:definition "A form the expression is rendered in."@en .

ifr:hasRetention a owl:ObjectProperty ;
    rdfs:domain ifr:Release ;
    rdfs:label "has retention"@en ;
    rdfs:range ifr:Retention ;
    skos:definition "How long the bytes of the release are kept."@en .

ifr:identifier a owl:DatatypeProperty ;
    rdfs:domain ifr:Work ;
    rdfs:label "identifier"@en ;
    rdfs:range xsd:string ;
    skos:definition "An external identifier of the work, such as a DOI; recorded where a work has one, never required."@en .

ifr:impactRank a owl:DatatypeProperty ;
    rdfs:domain ifr:Impact ;
    rdfs:label "impact rank"@en ;
    rdfs:range xsd:integer ;
    skos:definition "The rank of the impact: the greatest of the impacts of the changes is the impact of the release."@en .

ifr:isPartOf a owl:ObjectProperty ;
    rdfs:domain ifr:Work ;
    rdfs:label "is part of"@en ;
    rdfs:range ifr:Work ;
    skos:definition "The work this one is a part of, such as a series (schema.org `isPartOf`)."@en .

ifr:isReplacedBy a owl:ObjectProperty ;
    rdfs:domain ifr:Release ;
    rdfs:label "is replaced by"@en ;
    rdfs:range ifr:Release ;
    skos:definition "The release that replaces this one (Dublin Core `isReplacedBy`)."@en .

ifr:kind a owl:ObjectProperty ;
    rdfs:domain ifr:Work ;
    rdfs:label "kind"@en ;
    rdfs:range ifr:WorkKind ;
    skos:definition "The kind of the work, which fixes its scheme of version."@en .

ifr:position a owl:DatatypeProperty ;
    rdfs:domain ifr:Work ;
    rdfs:label "position"@en ;
    rdfs:range xsd:integer ;
    skos:definition "The work's position in the work it is part of, from 1 (schema.org `position`). It never changes."@en .

ifr:precedenceRule a owl:DatatypeProperty ;
    rdfs:domain ifr:VersionScheme ;
    rdfs:label "precedence rule"@en ;
    rdfs:range xsd:string ;
    skos:definition "How two versions of the scheme are ordered."@en .

ifr:printing a owl:DatatypeProperty ;
    rdfs:domain ifr:Manifestation ;
    rdfs:label "printing"@en ;
    rdfs:range xsd:integer ;
    skos:definition "The printing of a print rendition, from 1; it is a property of the rendition and not a version."@en .

ifr:provenance a owl:DatatypeProperty ;
    rdfs:domain ifr:Release ;
    rdfs:label "provenance"@en ;
    rdfs:range xsd:string ;
    skos:definition "The provenance attestation of the release (SLSA, in-toto), by its digest."@en .

ifr:realizes a owl:ObjectProperty ;
    rdfs:domain ifr:Release ;
    rdfs:label "realizes"@en ;
    rdfs:range ifr:Expression ;
    skos:definition "The expression the release publishes."@en .

ifr:recordOf a owl:ObjectProperty ;
    rdfs:domain ifr:ReleaseRecord ;
    rdfs:label "record of"@en ;
    rdfs:range ifr:Work ;
    skos:definition "The work the record is of."@en .

ifr:recordPath a owl:DatatypeProperty ;
    rdfs:domain ifr:ReleaseRecord ;
    rdfs:label "record path"@en ;
    rdfs:range xsd:string ;
    skos:definition "The path of the record, `<work>/release.ts`."@en .

ifr:releaseCommit a owl:DatatypeProperty ;
    rdfs:domain ifr:Release ;
    rdfs:label "release commit"@en ;
    rdfs:range xsd:string ;
    skos:definition "The commit the release names, as its full object name."@en .

ifr:releaseIdentifier a owl:DatatypeProperty ;
    rdfs:domain ifr:Release ;
    rdfs:label "release identifier"@en ;
    rdfs:range xsd:string ;
    skos:definition "An external identifier of this release, such as a version DOI; recorded where it has one."@en .

ifr:releaseOf a owl:ObjectProperty ;
    rdfs:domain ifr:Release ;
    rdfs:label "release of"@en ;
    rdfs:range ifr:Work ;
    skos:definition "The work the release is of."@en .

ifr:releaseScheme a owl:ObjectProperty ;
    rdfs:domain ifr:Release ;
    rdfs:label "release scheme"@en ;
    rdfs:range ifr:VersionScheme ;
    skos:definition "The scheme the release's version is written in."@en .

ifr:releaseTag a owl:ObjectProperty ;
    rdfs:domain ifr:Release ;
    rdfs:label "release tag"@en ;
    rdfs:range ifr:ReleaseTag ;
    skos:definition "The tag that names the release."@en .

ifr:releasedOn a owl:DatatypeProperty ;
    rdfs:domain ifr:Release ;
    rdfs:label "released on"@en ;
    rdfs:range xsd:string ;
    skos:definition "The day (YYYY-MM-DD, UTC) of the release's commit, never the clock's."@en .

ifr:releasedOnTier a owl:ObjectProperty ;
    rdfs:domain ifr:Release ;
    rdfs:label "released on tier"@en ;
    rdfs:range ifqs:QualityTier ;
    skos:definition "The evidence tier of the quality system (0021-ifqs) the release was made on."@en .

ifr:renditionFormat a owl:DatatypeProperty ;
    rdfs:domain ifr:Manifestation ;
    rdfs:label "rendition format"@en ;
    rdfs:range xsd:string ;
    skos:definition "The media type of the rendition."@en .

ifr:replaces a owl:ObjectProperty ;
    rdfs:domain ifr:Release ;
    rdfs:label "replaces"@en ;
    rdfs:range ifr:Release ;
    skos:definition "The release this one replaces (Dublin Core `replaces`)."@en .

ifr:retentionPeriod a owl:DatatypeProperty ;
    rdfs:domain ifr:Retention ;
    rdfs:label "retention period"@en ;
    rdfs:range xsd:string ;
    skos:definition "The period after which bytes may be deleted, as an ISO 8601 duration such as P10Y."@en .

ifr:retiredOn a owl:DatatypeProperty ;
    rdfs:domain ifr:Release ;
    rdfs:label "retired on"@en ;
    rdfs:range xsd:string ;
    skos:definition "The day the release was retired: still resolvable, no longer advised."@en .

ifr:revisionOf a owl:ObjectProperty ;
    rdfs:domain ifr:Release ;
    rdfs:label "revision of"@en ;
    rdfs:range ifr:Release ;
    skos:definition "The release this one revises (PROV-O `wasRevisionOf`)."@en .

ifr:sbom a owl:DatatypeProperty ;
    rdfs:domain ifr:Release ;
    rdfs:label "SBOM"@en ;
    rdfs:range xsd:string ;
    skos:definition "The software bill of materials of the release (SPDX 3), by its digest."@en .

ifr:slug a owl:DatatypeProperty ;
    rdfs:domain ifr:Work ;
    rdfs:label "slug"@en ;
    rdfs:range xsd:string ;
    skos:definition "The work's slug, lower-case letters, digits and hyphens: the prefix of its tags. It never changes."@en .

ifr:snapshotDigest a owl:DatatypeProperty ;
    rdfs:domain ifr:Release ;
    rdfs:label "snapshot digest"@en ;
    rdfs:range xsd:string ;
    skos:definition "The SHA-256 of a dataset's snapshot, in lower-case hexadecimal."@en .

ifr:tagCommit a owl:DatatypeProperty ;
    rdfs:domain ifr:ReleaseTag ;
    rdfs:label "tag commit"@en ;
    rdfs:range xsd:string ;
    skos:definition "The commit the tag names."@en .

ifr:tagName a owl:DatatypeProperty ;
    rdfs:domain ifr:ReleaseTag ;
    rdfs:label "tag name"@en ;
    rdfs:range xsd:string ;
    skos:definition "The tag's name: the slug, `-v` and the version."@en .

ifr:tagSigned a owl:DatatypeProperty ;
    rdfs:domain ifr:ReleaseTag ;
    rdfs:label "tag signed"@en ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether the tag carries a signature that verifies."@en .

ifr:tombstoneOf a owl:ObjectProperty ;
    rdfs:domain ifr:Tombstone ;
    rdfs:label "tombstone of"@en ;
    rdfs:range ifr:Release ;
    skos:definition "The release whose bytes are gone."@en .

ifr:treeHash a owl:DatatypeProperty ;
    rdfs:domain ifr:Release ;
    rdfs:label "tree hash"@en ;
    rdfs:range xsd:string ;
    skos:definition "The Git tree hash of that commit: what the release holds."@en .

ifr:usesScheme a owl:ObjectProperty ;
    rdfs:domain ifr:WorkKind ;
    rdfs:label "uses scheme"@en ;
    rdfs:range ifr:VersionScheme ;
    skos:definition "The one scheme of version the kind uses."@en .

ifr:version a owl:DatatypeProperty ;
    rdfs:domain ifr:Release ;
    rdfs:label "version"@en ;
    rdfs:range xsd:string ;
    skos:definition "The release's version, written by the scheme of its work's kind (schema.org `version`, OWL `versionInfo`)."@en .

ifr:versionPattern a owl:DatatypeProperty ;
    rdfs:domain ifr:VersionScheme ;
    rdfs:label "version pattern"@en ;
    rdfs:range xsd:string ;
    skos:definition "The regular expression a version of the scheme matches."@en .

ifr:workIri a owl:DatatypeProperty ;
    rdfs:domain ifr:Work ;
    rdfs:label "work IRI"@en ;
    rdfs:range xsd:string ;
    skos:definition "The IRI that identifies the work. It never changes."@en .

<https://www.intellectualfrontiers.com/ontology/ifr> a owl:Ontology ;
    dcterms:description "The vocabulary of Intellectual Frontiers Releases: a work and what it is published as, the kind of work and its one scheme of version, the release that is a signed Git tag, its retention, approval and citation."@en ;
    rdfs:label "Intellectual Frontiers Releases"@en ;
    owl:versionIRI ifrv:1.0.0 ;
    owl:versionInfo "1.0.0" .
