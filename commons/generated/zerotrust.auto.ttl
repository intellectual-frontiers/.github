zt:AccessDecision a owl:Class ;
    rdfs:label "Access decision"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "The signed record of one decision about one request: the subject, the posture signals of its device, the context, the resource, the policy by hash, the outcome, the reasons and the evidence."@en .

zt:AccessIsPerSession a zt:Tenet ;
    rdfs:label "Access is per session"@en ;
    skos:definition "Access to one resource is granted for one session with the least privilege the task needs, after the requester is evaluated; a grant for one resource carries to no other."@en .

zt:AccessPolicies a zt:DataSource ;
    rdfs:label "Data access policies"@en ;
    skos:definition "The attributes, rules and policies about access to resources, the starting point for authorizing it."@en .

zt:Activity a owl:Class ;
    rdfs:label "Zero trust activity"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "One thing a maturity model asks an organization to do, in one area, at one stage; the names are written from the model when it is read."@en .

zt:ActivityLogs a zt:DataSource ;
    rdfs:label "Network and system activity logs"@en ;
    skos:definition "The aggregate of asset logs, traffic and access actions that gives near real time feedback on posture."@en .

zt:ApplicationsAndWorkloads a zt:Pillar ;
    rdfs:label "Applications and workloads"@en ;
    skos:definition "What the request reaches: applications treated as reachable from the internet, tested rigorously and open to outside reports of weaknesses."@en .

zt:AutomationAndOrchestration a zt:Pillar ;
    rdfs:label "Automation and orchestration"@en ;
    skos:definition "A theme across the areas: the decisions and responses that machines carry out by policy."@en .

zt:CommunicationIsSecuredAnywhere a zt:Tenet ;
    rdfs:label "Communication is secured anywhere"@en ;
    skos:definition "Every communication is protected for confidentiality, integrity and the authentication of its source, and a network location alone grants no trust."@en .

zt:ComplianceSystem a zt:DataSource ;
    rdfs:label "Compliance system"@en ;
    skos:definition "The system that holds the rules of the regime the organization falls under, so that the policy follows them."@en .

zt:Data a zt:Pillar ;
    rdfs:label "Data"@en ;
    skos:definition "What is protected: data that is categorized, protected by what its category needs, and whose access is monitored and logged."@en .

zt:DataSource a owl:Class ;
    rdfs:label "Source of input"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "One of the sources that give the policy engine the input and the rules it decides with."@en .

zt:Devices a zt:Pillar ;
    rdfs:label "Devices"@en ;
    skos:definition "What the request comes from: the inventory of every device in use, its state, and the ability to prevent, detect and respond to incidents on it."@en .

zt:Diagnostics a zt:DataSource ;
    rdfs:label "Continuous diagnostics and mitigation"@en ;
    skos:definition "The system that gathers the current state of assets and applies updates to their configuration and software, and so tells the engine what a requesting asset runs and whether it is vulnerable."@en .

zt:EnforcementIsDynamic a zt:Tenet ;
    rdfs:label "Authentication and authorization are dynamic and enforced"@en ;
    skos:definition "Authentication and authorization are repeated on the events the policy names and strictly enforced before access, as a constant cycle of access, assessment and adaptation."@en .

zt:EventManagement a zt:DataSource ;
    rdfs:label "Security information and event management"@en ;
    skos:definition "The system that collects security information for analysis, to refine policy and warn of attacks."@en .

zt:EverythingIsAResource a zt:Tenet ;
    rdfs:label "Everything is a resource"@en ;
    skos:definition "Every data source and computing service is a resource, whatever its size, including the devices an organization lets reach its resources."@en .

zt:Governance a zt:Pillar ;
    rdfs:label "Governance"@en ;
    skos:definition "A theme across the areas: the policies, roles and accountability that decide how the areas are run."@en .

zt:Identity a zt:Pillar ;
    rdfs:label "Identity"@en ;
    skos:definition "Who or what asks for access: enterprise-managed identities, strong authentication that resists phishing, and the identity systems that hold them."@en .

zt:IdentityManagement a zt:DataSource ;
    rdfs:label "Identity management"@en ;
    skos:definition "The system that creates, stores and manages the accounts and identity records, with the role and attributes of each."@en .

zt:ImplicitTrust a owl:Class ;
    rdfs:label "Implicit trust"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "A place where access is allowed because of where the request comes from, whose it is or how long ago it was granted, and not because of a decision."@en .

zt:MaturityStage a owl:Class ;
    rdfs:label "Maturity stage"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "One of the ordered stages a maturity model gives for how far an area has gone; the members are written from the model when it is read."@en .

zt:Networks a zt:Pillar ;
    rdfs:label "Networks"@en ;
    skos:definition "How the request travels: encrypted traffic and names, and perimeters broken into isolated environments."@en .

zt:Pillar a owl:Class ;
    rdfs:label "Pillar"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "One of the areas of effort of zero trust, or one of the themes across them."@en .

zt:PolicyAdministrator a owl:Class ;
    rdfs:label "Policy administrator"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "The part of the decision point that opens or shuts the path between a subject and a resource on the engine's decision and makes any credential of the session."@en .

zt:PolicyDecisionPoint a owl:Class ;
    rdfs:label "Policy decision point"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "The part that decides whether a subject may reach a resource: a policy engine that decides and a policy administrator that carries the decision out."@en .

zt:PolicyEnforcementPoint a owl:Class ;
    rdfs:label "Policy enforcement point"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "The part that enables, watches and ends the connection between a subject and a resource on the administrator's instruction."@en .

zt:PolicyEngine a owl:Class ;
    rdfs:label "Policy engine"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "The part of the decision point that grants, denies or revokes access from the policy and the outside inputs, and logs the decision."@en .

zt:PolicyIsDynamic a zt:Tenet ;
    rdfs:label "Policy is dynamic"@en ;
    skos:definition "Access is decided by rules over the observable state of the identity, the application and the requesting asset, and over behavior and the environment, stricter as the resource is more sensitive."@en .

zt:PostureIsMonitored a zt:Tenet ;
    rdfs:label "Posture is monitored"@en ;
    skos:definition "The organization measures the integrity and security posture of every asset it owns or is associated with, and trusts no asset for what it is."@en .

zt:PostureSignal a owl:Class ;
    rdfs:label "Posture signal"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "A reading about a subject or a device that an access decision used, with its source and its age."@en .

zt:ProtectSurface a owl:Class ;
    rdfs:label "Protect surface"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "The smallest part of an estate that one access policy names and protects: an asset, a population or a store of data; it is a boundary of the kind trust, and every path into it needs an access decision."@en .

zt:PublicKeyInfrastructure a zt:DataSource ;
    rdfs:label "Public key infrastructure"@en ;
    skos:definition "The system that issues and logs the certificates of resources, subjects, services and applications."@en .

zt:StateIsCollected a zt:Tenet ;
    rdfs:label "State is collected"@en ;
    skos:definition "The organization collects as much as it can about the state of its assets, network and communications and uses it to improve the policy and its enforcement."@en .

zt:Tenet a owl:Class ;
    rdfs:label "Tenet"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "One of the basic principles the architecture standard gives for a zero trust architecture."@en .

zt:ThreatIntelligence a zt:DataSource ;
    rdfs:label "Threat intelligence"@en ;
    skos:definition "Feeds, internal or external, about newly found attacks, weaknesses and malware that the engine weighs."@en .

zt:VisibilityAndAnalytics a zt:Pillar ;
    rdfs:label "Visibility and analytics"@en ;
    skos:definition "A theme across the areas: the collection and analysis of what happens, which feeds the decisions."@en .

zt:ZeroTrustArchitecture a owl:Class ;
    rdfs:label "Zero trust architecture"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "An organization's plan for deciding every access to a resource on its own, with the least privilege the request needs, in a network seen as compromised: the components, their relations, the workflows and the access policies."@en .

zt:decidedBy a owl:ObjectProperty ;
    rdfs:domain zt:AccessDecision ;
    rdfs:label "decided by"@en ;
    rdfs:range zt:PolicyDecisionPoint ;
    skos:definition "The decision point that made the access decision."@en .

zt:enforcedAt a owl:ObjectProperty ;
    rdfs:domain zt:AccessDecision ;
    rdfs:label "enforced at"@en ;
    rdfs:range zt:PolicyEnforcementPoint ;
    skos:definition "The enforcement point that carried out the access decision."@en .

zt:onSurface a owl:ObjectProperty ;
    rdfs:domain zt:AccessDecision ;
    rdfs:label "on surface"@en ;
    rdfs:range zt:ProtectSurface ;
    skos:definition "The protect surface the access decision was about."@en .

zt:policyHash a owl:DatatypeProperty ;
    rdfs:domain zt:AccessDecision ;
    rdfs:label "policy hash"@en ;
    rdfs:range xsd:string ;
    skos:definition "The hash of the access policy the decision applied, so that the decision can be replayed against the same rules."@en .

<https://www.intellectualfrontiers.com/ontology/zerotrust> a owl:Ontology ;
    <http://purl.org/dc/terms/description> "The vocabulary of Zero trust: the architecture, the points that decide and enforce, the access decision, the protect surface, implicit trust, and the tenets, pillars and sources of input of the primary sources."@en ;
    rdfs:label "Zero trust"@en ;
    owl:versionIRI ztv:1.0.0 ;
    owl:versionInfo "1.0.0" .
