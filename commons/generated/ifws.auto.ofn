AnnotationAssertion(skos:definition ifws:actionTarget "What the action acts on: a path under the root, or a tool's name and version."@en)
DataPropertyDomain(ifws:actionTarget ifws:Action)
DataPropertyRange(ifws:actionTarget xsd:string)
