AnnotationAssertion(skos:definition ifws:supports "A capability the kind of Git manager supports; one it does not list is unsupported."@en)
ObjectPropertyDomain(ifws:supports ifws:GitManagerKind)
ObjectPropertyRange(ifws:supports ifws:GitCapability)
AnnotationAssertion(rdfs:label ifws:toolArch "tool arch"@en)
AnnotationAssertion(skos:definition ifws:toolArch "The processor architecture the artifact is for: x64 or arm64."@en)
DataPropertyDomain(ifws:toolArch ifws:Tool)
DataPropertyRange(ifws:toolArch xsd:string)
AnnotationAssertion(rdfs:label ifws:toolName "tool name"@en)
AnnotationAssertion(skos:definition ifws:toolName "The tool's name."@en)
DataPropertyDomain(ifws:toolName ifws:Tool)
DataPropertyRange(ifws:toolName xsd:string)
AnnotationAssertion(rdfs:label ifws:toolOs "tool os"@en)
AnnotationAssertion(skos:definition ifws:toolOs "The operating system the artifact is for: linux, macos or windows."@en)
DataPropertyDomain(ifws:toolOs ifws:Tool)
DataPropertyRange(ifws:toolOs xsd:string)
AnnotationAssertion(rdfs:label ifws:toolSha256 "tool sha256"@en)
AnnotationAssertion(skos:definition ifws:toolSha256 "The SHA-256 of the artifact, in lower-case hexadecimal."@en)
DataPropertyDomain(ifws:toolSha256 ifws:Tool)
DataPropertyRange(ifws:toolSha256 xsd:string)
AnnotationAssertion(rdfs:label ifws:toolUrl "tool url"@en)
AnnotationAssertion(skos:definition ifws:toolUrl "The `https` URL the artifact is fetched from."@en)
DataPropertyDomain(ifws:toolUrl ifws:Tool)
DataPropertyRange(ifws:toolUrl xsd:string)
AnnotationAssertion(rdfs:label ifws:toolVersion "tool version"@en)
AnnotationAssertion(skos:definition ifws:toolVersion "The one version pinned, never `latest` and never a range."@en)
DataPropertyDomain(ifws:toolVersion ifws:Tool)
DataPropertyRange(ifws:toolVersion xsd:string)
AnnotationAssertion(rdfs:label ifws:unapprovedGraceDays "unapproved grace days"@en)
AnnotationAssertion(skos:definition ifws:unapprovedGraceDays "The days a tool or module outside the catalog is informational, counted from the day it was first seen; 90 unless the policy lowers it."@en)
DataPropertyDomain(ifws:unapprovedGraceDays ifws:WorkspacePolicy)
DataPropertyRange(ifws:unapprovedGraceDays xsd:integer)
AnnotationAssertion(rdfs:label ifws:usesCatalog "uses catalog"@en)
AnnotationAssertion(skos:definition ifws:usesCatalog "The catalog of tools the workspace approves."@en)
ObjectPropertyDomain(ifws:usesCatalog ifws:Workspace)
ObjectPropertyRange(ifws:usesCatalog ifws:ToolCatalog)
AnnotationAssertion(rdfs:label ifws:workspaceHome "workspace home"@en)
AnnotationAssertion(skos:definition ifws:workspaceHome "The workspace's root folder, as `$IFC_WORKSPACES_HOME` or `--home` gives it."@en)
DataPropertyDomain(ifws:workspaceHome ifws:Workspace)
DataPropertyRange(ifws:workspaceHome xsd:string)
AnnotationAssertion(rdfs:label ifws:worktreeOf "worktree of"@en)
AnnotationAssertion(skos:definition ifws:worktreeOf "The repository the worktree is of."@en)
ObjectPropertyDomain(ifws:worktreeOf ifws:Worktree)
ObjectPropertyRange(ifws:worktreeOf ifws:Repository)

