AnnotationAssertion(rdfs:label ifws:Action "Action"@en)
AnnotationAssertion(skos:definition ifws:Action "One step of a plan: its kind, what it acts on and, for a skip or a refusal, why."@en)
SubClassOf(ifws:Action schema:Action)
AnnotationAssertion(rdfs:label ifws:ActionKind "Action kind"@en)
AnnotationAssertion(skos:definition ifws:ActionKind "Clone, fast-forward, create a worktree, configure a repository, write or remove a generated file, install a tool, skip or refuse."@en)
AnnotationAssertion(rdfs:label ifws:ExitStatus "Exit status"@en)
AnnotationAssertion(skos:definition ifws:ExitStatus "What a run exits with: 0 ok, 1 findings, 2 usage, 3 environment."@en)
AnnotationAssertion(rdfs:label ifws:Finding "Finding"@en)
AnnotationAssertion(skos:definition ifws:Finding "What a check reports: the rule, a severity, what it is about and the day it was first seen; it is written as a SARIF result."@en)
AnnotationAssertion(rdfs:label ifws:GeneratedFile "Generated file"@en)
AnnotationAssertion(skos:definition ifws:GeneratedFile "A file a typed template makes inside the workspace, named `.auto.`, with a header that names its generator, never edited by hand."@en)
SubClassOf(ifws:GeneratedFile prov:Entity)
AnnotationAssertion(rdfs:label ifws:GitCapability "Git capability"@en)
AnnotationAssertion(skos:definition ifws:GitCapability "One thing a Git manager may offer through the interface."@en)
AnnotationAssertion(rdfs:label ifws:GitManager "Git manager"@en)
AnnotationAssertion(skos:definition ifws:GitManager "The one interface to a Git host: its clone URL, credentials, default branch, protected branches, issues, change requests and signed commits, with `unsupported` where a host lacks one."@en)
AnnotationAssertion(rdfs:label ifws:GitManagerKind "Git manager kind"@en)
AnnotationAssertion(skos:definition ifws:GitManagerKind "GitHub, GitLab or plain Git, with the capabilities each supports."@en)
AnnotationAssertion(rdfs:label ifws:Module "Module"@en)
AnnotationAssertion(skos:definition ifws:Module "A part of the command, `ifws-<name>`: built in, registered by the workspace or an executable on the path."@en)
SubClassOf(ifws:Module schema:SoftwareApplication)
AnnotationAssertion(rdfs:label ifws:ModuleSource "Module source"@en)
AnnotationAssertion(skos:definition ifws:ModuleSource "Built-in, registered or on the path, in the order a module is looked for."@en)
AnnotationAssertion(rdfs:label ifws:Plan "Plan"@en)
AnnotationAssertion(skos:definition ifws:Plan "The actions that would bring the workspace from its observed state to the one its manifest states; making it changes nothing."@en)
SubClassOf(ifws:Plan prov:Plan)
AnnotationAssertion(rdfs:label ifws:RepoObservation "Repository observation"@en)
AnnotationAssertion(skos:definition ifws:RepoObservation "The state of one repository at a time: its state, how many commits it is ahead or behind and how many stashes it holds."@en)
AnnotationAssertion(rdfs:label ifws:RepoState "Repository state"@en)
AnnotationAssertion(skos:definition ifws:RepoState "Missing, clean, dirty, ahead, behind, diverged, locked, detached, on the wrong remote or not a repository."@en)
AnnotationAssertion(rdfs:label ifws:Repository "Repository"@en)
AnnotationAssertion(skos:definition ifws:Repository "A Git repository cloned into the workspace at the path that mirrors its remote URL."@en)
AnnotationAssertion(rdfs:label ifws:Setup "Setup"@en)
AnnotationAssertion(skos:definition ifws:Setup "The one run that may install a pinned tool or change the host: its plan, and whether it was applied or only shown."@en)
SubClassOf(ifws:Setup prov:Activity)
AnnotationAssertion(rdfs:label ifws:Severity "Severity"@en)
AnnotationAssertion(skos:definition ifws:Severity "Informational, warning or error, each with the SARIF level it is written as."@en)
AnnotationAssertion(rdfs:label ifws:StateRecord "State record"@en)
AnnotationAssertion(skos:definition ifws:StateRecord "The record of what the last run wrote: the hash of each generated file, the last plan and the day each unapproved tool or module was first seen."@en)
SubClassOf(ifws:StateRecord prov:Entity)
AnnotationAssertion(rdfs:label ifws:Tool "Tool"@en)
AnnotationAssertion(skos:definition ifws:Tool "A program the workspace may use: its name, version and, for one operating system and architecture, the artifact's URL and SHA-256."@en)
SubClassOf(ifws:Tool schema:SoftwareApplication)
AnnotationAssertion(rdfs:label ifws:ToolCatalog "Tool catalog"@en)
AnnotationAssertion(skos:definition ifws:ToolCatalog "The tools a workspace approves, each pinned to a version and a hash; a tool outside it is a finding."@en)
SubClassOf(ifws:ToolCatalog dcat:Catalog)
AnnotationAssertion(rdfs:label ifws:Workspace "Workspace"@en)
AnnotationAssertion(skos:definition ifws:Workspace "The one root folder of Intellectual Frontiers Workspaces: the repositories, worktrees, tools, policy and generated files under it, and nothing outside it."@en)
AnnotationAssertion(rdfs:label ifws:WorkspacePolicy "Workspace policy"@en)
AnnotationAssertion(skos:definition ifws:WorkspacePolicy "What the workspace requires: signed commits, the regulated domain it claims, the days an unapproved tool or module is only informational and the Git hosts it allows."@en)
AnnotationAssertion(rdfs:label ifws:WorkspaceState "Workspace state"@en)
AnnotationAssertion(skos:definition ifws:WorkspaceState "What was observed of the workspace on one day: the observation of each of its repositories."@en)
SubClassOf(ifws:WorkspaceState prov:Entity)
AnnotationAssertion(rdfs:label ifws:Worktree "Worktree"@en)
AnnotationAssertion(skos:definition ifws:Worktree "A Git worktree of a repository, made for one branch when another person or agent, or uncommitted work, is on the repository."@en)
