Annotation(rdfs:label "Planning"@en)
Annotation(dcterms:description "The vocabulary of Planning: the four kinds of planning item, the events that make their history and the states folded from them, the actors, the observations of what a source saw and where, the traces and links between items, the patches that write a change back and their previews, the sources that read and write, and the closed code lists the model branches on."@en)
Annotation(owl:versionInfo "1.0.0")
Annotation(dcterms:title "Planning")
Annotation(dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/>)
