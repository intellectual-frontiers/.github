AnnotationAssertion(rdfs:label plan:Actor "Actor"@en)
AnnotationAssertion(skos:definition plan:Actor "The one who wrote an event or an item: a person, an agent or a tool, with an id and a name."@en)
SubClassOf(plan:Actor prov:Agent)
AnnotationAssertion(rdfs:label plan:ActorKind "Actor kind"@en)
AnnotationAssertion(skos:definition plan:ActorKind "One of the kinds of actor: person, agent or tool."@en)
SubClassOf(plan:ActorKind skos:Concept)
AnnotationAssertion(rdfs:label plan:Capability "Capability"@en)
AnnotationAssertion(skos:definition plan:Capability "One of the things a source can be asked to do."@en)
SubClassOf(plan:Capability skos:Concept)
AnnotationAssertion(rdfs:label plan:CloseReason "Close reason"@en)
AnnotationAssertion(skos:definition plan:CloseReason "One of the reasons an item is closed."@en)
SubClassOf(plan:CloseReason skos:Concept)
AnnotationAssertion(rdfs:label plan:Event "Event"@en)
AnnotationAssertion(skos:definition plan:Event "One thing that happened to an item, appended to its history and never changed, with its time and its actor."@en)
SubClassOf(plan:Event prov:Activity)
AnnotationAssertion(rdfs:label plan:EventType "Event type"@en)
AnnotationAssertion(skos:definition plan:EventType "One of the cases of the union an item's history is made of."@en)
SubClassOf(plan:EventType skos:Concept)
AnnotationAssertion(rdfs:label plan:FieldAuthority "Field authority"@en)
AnnotationAssertion(skos:definition plan:FieldAuthority "One of the ways the value of a field is settled when sources disagree."@en)
SubClassOf(plan:FieldAuthority skos:Concept)
AnnotationAssertion(rdfs:label plan:Item "Item"@en)
AnnotationAssertion(skos:definition plan:Item "A piece of planning content of one of four kinds, with a stable id and a history of events from which its state is folded."@en)
SubClassOf(plan:Item prov:Entity)
AnnotationAssertion(rdfs:label plan:ItemKind "Item kind"@en)
AnnotationAssertion(skos:definition plan:ItemKind "One of the four kinds of item."@en)
SubClassOf(plan:ItemKind skos:Concept)
AnnotationAssertion(rdfs:label plan:Link "Link"@en)
AnnotationAssertion(skos:definition plan:Link "A typed relation between two items."@en)
SubClassOf(plan:Link prov:Entity)
AnnotationAssertion(rdfs:label plan:LinkKind "Link kind"@en)
AnnotationAssertion(skos:definition plan:LinkKind "One of the kinds of link between two items."@en)
SubClassOf(plan:LinkKind skos:Concept)
AnnotationAssertion(rdfs:label plan:Locator "Locator"@en)
AnnotationAssertion(skos:definition plan:Locator "A way of naming a place: a file with a line, a web address, a row or a commit."@en)
SubClassOf(plan:Locator prov:Entity)
AnnotationAssertion(rdfs:label plan:LocatorKind "Locator kind"@en)
AnnotationAssertion(skos:definition plan:LocatorKind "One of the ways a place is named."@en)
SubClassOf(plan:LocatorKind skos:Concept)
AnnotationAssertion(rdfs:label plan:Observation "Observation"@en)
AnnotationAssertion(skos:definition plan:Observation "What one source saw in one place at one time: the content, a locator, a hash of what was read and a fingerprint of its identity."@en)
SubClassOf(plan:Observation prov:Entity)
AnnotationAssertion(rdfs:label plan:Origin "Origin"@en)
AnnotationAssertion(skos:definition plan:Origin "How an item came to be: declared, derived or inferred."@en)
SubClassOf(plan:Origin skos:Concept)
AnnotationAssertion(rdfs:label plan:Patch "Patch"@en)
AnnotationAssertion(skos:definition plan:Patch "A change to write back to one source: add an item, change a state, add an event; a value, and nothing happens until it is applied."@en)
SubClassOf(plan:Patch prov:Entity)
AnnotationAssertion(rdfs:label plan:Preview "Preview"@en)
AnnotationAssertion(skos:definition plan:Preview "What applying a patch would do, with a hash of that account, so that applying is held to what was previewed."@en)
SubClassOf(plan:Preview prov:Entity)
AnnotationAssertion(rdfs:label plan:PrincipalBasis "Principal basis"@en)
AnnotationAssertion(skos:definition plan:PrincipalBasis "One of the ways the person an agent acts for was established."@en)
SubClassOf(plan:PrincipalBasis skos:Concept)
AnnotationAssertion(rdfs:label plan:Severity "Severity"@en)
AnnotationAssertion(skos:definition plan:Severity "One of the three severities of an item."@en)
SubClassOf(plan:Severity skos:Concept)
AnnotationAssertion(rdfs:label plan:Source "Source"@en)
AnnotationAssertion(skos:definition plan:Source "A program that reads observations from one kind of place and writes patches back to it, with the capabilities it declares."@en)
SubClassOf(plan:Source prov:SoftwareAgent)
AnnotationAssertion(rdfs:label plan:State "State"@en)
AnnotationAssertion(skos:definition plan:State "One of the five states an item is in, as folded from its events."@en)
SubClassOf(plan:State skos:Concept)
AnnotationAssertion(rdfs:label plan:Trace "Trace"@en)
AnnotationAssertion(skos:definition plan:Trace "The record that an item was derived from what a source observed, so that every place an item was seen can be found from it."@en)
SubClassOf(plan:Trace prov:Derivation)
AnnotationAssertion(rdfs:label plan:Verdict "Verdict"@en)
AnnotationAssertion(skos:definition plan:Verdict "One of the four verdicts a decision gives."@en)
SubClassOf(plan:Verdict skos:Concept)
AnnotationAssertion(rdfs:label plan:actorId "actor id"@en)
AnnotationAssertion(skos:definition plan:actorId "The id of the actor."@en)
DataPropertyDomain(plan:actorId plan:Actor)
DataPropertyRange(plan:actorId xsd:string)
AnnotationAssertion(rdfs:label plan:actorKind "actor kind"@en)
AnnotationAssertion(skos:definition plan:actorKind "Whether the actor is a person, an agent or a tool."@en)
ObjectPropertyDomain(plan:actorKind plan:Actor)
ObjectPropertyRange(plan:actorKind plan:ActorKind)
AnnotationAssertion(rdfs:label plan:actorName "actor name"@en)
AnnotationAssertion(skos:definition plan:actorName "The name of the actor."@en)
DataPropertyDomain(plan:actorName plan:Actor)
DataPropertyRange(plan:actorName xsd:string)
AnnotationAssertion(rdfs:label plan:contentHash "content hash"@en)
AnnotationAssertion(skos:definition plan:contentHash "The SHA-256 of the bytes the observation was read from, so that a change of the place is told from a change of the item."@en)
DataPropertyDomain(plan:contentHash plan:Observation)
DataPropertyRange(plan:contentHash xsd:string)
AnnotationAssertion(rdfs:label plan:deferredUntil "deferred until"@en)
AnnotationAssertion(skos:definition plan:deferredUntil "The day an item set aside is to come back, YYYY-MM-DD, with the state deferred."@en)
AnnotationAssertion(rdfs:label plan:eventActor "event actor"@en)
AnnotationAssertion(skos:definition plan:eventActor "Who wrote the event."@en)
ObjectPropertyDomain(plan:eventActor plan:Event)
ObjectPropertyRange(plan:eventActor plan:Actor)
AnnotationAssertion(rdfs:label plan:eventAt "event at"@en)
AnnotationAssertion(skos:definition plan:eventAt "When the event happened: ISO 8601 in UTC to the second."@en)
DataPropertyDomain(plan:eventAt plan:Event)
DataPropertyRange(plan:eventAt xsd:string)
AnnotationAssertion(rdfs:label plan:eventOf "event of"@en)
AnnotationAssertion(skos:definition plan:eventOf "The item the event happened to."@en)
ObjectPropertyDomain(plan:eventOf plan:Event)
ObjectPropertyRange(plan:eventOf plan:Item)
AnnotationAssertion(rdfs:label plan:eventType "event type"@en)
AnnotationAssertion(skos:definition plan:eventType "The case of the union the event is."@en)
ObjectPropertyDomain(plan:eventType plan:Event)
ObjectPropertyRange(plan:eventType plan:EventType)
AnnotationAssertion(rdfs:label plan:externalSource "external source"@en)
AnnotationAssertion(skos:definition plan:externalSource "The name of the source that gave an item or an event an id of another scheme (a ULID, a number of a Git host, an id of a build finding); with the external value it is the external id."@en)
AnnotationAssertion(rdfs:label plan:externalValue "external value"@en)
AnnotationAssertion(skos:definition plan:externalValue "The id of another scheme, as the source named it."@en)
AnnotationAssertion(rdfs:label plan:fieldAuthority "field authority"@en)
AnnotationAssertion(skos:definition plan:fieldAuthority "How the source's value of a field is weighed against the store's."@en)
ObjectPropertyDomain(plan:fieldAuthority plan:Source)
ObjectPropertyRange(plan:fieldAuthority plan:FieldAuthority)
AnnotationAssertion(rdfs:label plan:fingerprint "fingerprint"@en)
AnnotationAssertion(skos:definition plan:fingerprint "A hash of what identifies the item in its place apart from where in the place it is, so that the identity survives a move."@en)
DataPropertyDomain(plan:fingerprint plan:Observation)
DataPropertyRange(plan:fingerprint xsd:string)
AnnotationAssertion(rdfs:label plan:githubStateReason "GitHub state reason"@en)
AnnotationAssertion(skos:definition plan:githubStateReason "The name of the reason GitHub gives for closing an issue, as the REST interface writes it (GitHub Docs, REST API 2026-03-10, update an issue: completed, not_planned, duplicate, reopened, or null); a name and no IRI."@en)
DataPropertyDomain(plan:githubStateReason plan:CloseReason)
DataPropertyRange(plan:githubStateReason xsd:string)
AnnotationAssertion(rdfs:label plan:icalStatus "iCalendar status"@en)
AnnotationAssertion(skos:definition plan:icalStatus "The name of the iCalendar to-do STATUS the state is closest to (RFC 5545 section 3.8.1.11: NEEDS-ACTION, COMPLETED, IN-PROCESS or CANCELLED for a VTODO); a name and no IRI."@en)
DataPropertyDomain(plan:icalStatus plan:State)
DataPropertyRange(plan:icalStatus xsd:string)
AnnotationAssertion(rdfs:label plan:itemBlocker "item blocker"@en)
AnnotationAssertion(skos:definition plan:itemBlocker "Whether the item holds work up; a flag of the record, and not a severity."@en)
DataPropertyDomain(plan:itemBlocker plan:Item)
DataPropertyRange(plan:itemBlocker xsd:boolean)
AnnotationAssertion(rdfs:label plan:itemCites "item cites"@en)
AnnotationAssertion(skos:definition plan:itemCites "A requirement the item cites, as written in the source."@en)
DataPropertyDomain(plan:itemCites plan:Item)
DataPropertyRange(plan:itemCites xsd:string)
AnnotationAssertion(rdfs:label plan:itemCloseReason "item close reason"@en)
AnnotationAssertion(skos:definition plan:itemCloseReason "Why the item is closed, where it is."@en)
ObjectPropertyDomain(plan:itemCloseReason plan:Item)
ObjectPropertyRange(plan:itemCloseReason plan:CloseReason)
AnnotationAssertion(rdfs:label plan:itemEngines "item engines"@en)
AnnotationAssertion(skos:definition plan:itemEngines "The engines the work applies to, or all, as the source names them."@en)
DataPropertyDomain(plan:itemEngines plan:Item)
DataPropertyRange(plan:itemEngines xsd:string)
AnnotationAssertion(rdfs:label plan:itemEvidence "item evidence"@en)
AnnotationAssertion(skos:definition plan:itemEvidence "A piece of evidence for the item: a commit, a test, a specification, a file with a line or a review, as the source writes it."@en)
DataPropertyDomain(plan:itemEvidence plan:Item)
DataPropertyRange(plan:itemEvidence xsd:string)
AnnotationAssertion(rdfs:label plan:itemGoals "item goals"@en)
AnnotationAssertion(skos:definition plan:itemGoals "The goals the work serves, as the source names them."@en)
DataPropertyDomain(plan:itemGoals plan:Item)
DataPropertyRange(plan:itemGoals xsd:string)
AnnotationAssertion(rdfs:label plan:itemId "item id"@en)
AnnotationAssertion(skos:definition plan:itemId "The stable id of the item; it does not change when the item moves between places."@en)
DataPropertyDomain(plan:itemId plan:Item)
DataPropertyRange(plan:itemId xsd:string)
AnnotationAssertion(rdfs:label plan:itemKind "item kind"@en)
AnnotationAssertion(skos:definition plan:itemKind "The kind of the item."@en)
ObjectPropertyDomain(plan:itemKind plan:Item)
ObjectPropertyRange(plan:itemKind plan:ItemKind)
AnnotationAssertion(rdfs:label plan:itemMotivation "item motivation"@en)
AnnotationAssertion(skos:definition plan:itemMotivation "The name of the Web Annotation motivation of the record the item was read from, one of the thirteen (Web Annotation Data Model, section 3.3.5); a name and no IRI."@en)
DataPropertyDomain(plan:itemMotivation plan:Item)
DataPropertyRange(plan:itemMotivation xsd:string)
AnnotationAssertion(rdfs:label plan:itemOrigin "item origin"@en)
AnnotationAssertion(skos:definition plan:itemOrigin "How the item came to be."@en)
ObjectPropertyDomain(plan:itemOrigin plan:Item)
ObjectPropertyRange(plan:itemOrigin plan:Origin)
AnnotationAssertion(rdfs:label plan:itemPriority "item priority"@en)
AnnotationAssertion(skos:definition plan:itemPriority "How important the work is, as the source writes it (P1 to P3 in a typed issue); not a severity."@en)
DataPropertyDomain(plan:itemPriority plan:Item)
DataPropertyRange(plan:itemPriority xsd:string)
AnnotationAssertion(rdfs:label plan:itemSeverity "item severity"@en)
AnnotationAssertion(skos:definition plan:itemSeverity "The severity of the item."@en)
ObjectPropertyDomain(plan:itemSeverity plan:Item)
ObjectPropertyRange(plan:itemSeverity plan:Severity)
AnnotationAssertion(rdfs:label plan:itemSize "item size"@en)
AnnotationAssertion(skos:definition plan:itemSize "How large the work is, as the source writes it (xs to xl in a typed issue)."@en)
DataPropertyDomain(plan:itemSize plan:Item)
DataPropertyRange(plan:itemSize xsd:string)
AnnotationAssertion(rdfs:label plan:itemSource "item source"@en)
AnnotationAssertion(skos:definition plan:itemSource "Where a finding came from: the tool, the rule, the file and the line (the SARIF ruleId and physicalLocation, sections 3.27.5 and 3.29, are the standard's names for the last three)."@en)
DataPropertyDomain(plan:itemSource plan:Item)
DataPropertyRange(plan:itemSource xsd:string)
AnnotationAssertion(rdfs:label plan:itemState "item state"@en)
AnnotationAssertion(skos:definition plan:itemState "The state of the item, folded from its events."@en)
ObjectPropertyDomain(plan:itemState plan:Item)
ObjectPropertyRange(plan:itemState plan:State)
AnnotationAssertion(rdfs:label plan:itemTarget "item target"@en)
AnnotationAssertion(skos:definition plan:itemTarget "What the record is about: a file, a page and a quote (the quote is the exact text of a Web Annotation TextQuoteSelector, section 4.2.4)."@en)
DataPropertyDomain(plan:itemTarget plan:Item)
DataPropertyRange(plan:itemTarget xsd:string)
AnnotationAssertion(rdfs:label plan:linkFrom "link from"@en)
AnnotationAssertion(skos:definition plan:linkFrom "The item the link starts at."@en)
ObjectPropertyDomain(plan:linkFrom plan:Link)
ObjectPropertyRange(plan:linkFrom plan:Item)
AnnotationAssertion(rdfs:label plan:linkKind "link kind"@en)
AnnotationAssertion(skos:definition plan:linkKind "The kind of the link."@en)
ObjectPropertyDomain(plan:linkKind plan:Link)
ObjectPropertyRange(plan:linkKind plan:LinkKind)
AnnotationAssertion(rdfs:label plan:linkTo "link to"@en)
AnnotationAssertion(skos:definition plan:linkTo "The item the link ends at."@en)
ObjectPropertyDomain(plan:linkTo plan:Link)
ObjectPropertyRange(plan:linkTo plan:Item)
AnnotationAssertion(rdfs:label plan:locatorKind "locator kind"@en)
AnnotationAssertion(skos:definition plan:locatorKind "The way the place is named."@en)
ObjectPropertyDomain(plan:locatorKind plan:Locator)
ObjectPropertyRange(plan:locatorKind plan:LocatorKind)
AnnotationAssertion(rdfs:label plan:locatorValue "locator value"@en)
AnnotationAssertion(skos:definition plan:locatorValue "The name of the place, in the form of its kind."@en)
DataPropertyDomain(plan:locatorValue plan:Locator)
DataPropertyRange(plan:locatorValue xsd:string)
AnnotationAssertion(rdfs:label plan:observationLocator "observation locator"@en)
AnnotationAssertion(skos:definition plan:observationLocator "Where the source read it."@en)
ObjectPropertyDomain(plan:observationLocator plan:Observation)
ObjectPropertyRange(plan:observationLocator plan:Locator)
AnnotationAssertion(rdfs:label plan:observedAt "observed at"@en)
AnnotationAssertion(skos:definition plan:observedAt "When the source read it: ISO 8601 in UTC to the second."@en)
DataPropertyDomain(plan:observedAt plan:Observation)
DataPropertyRange(plan:observedAt xsd:string)
AnnotationAssertion(rdfs:label plan:observedBy "observed by"@en)
AnnotationAssertion(skos:definition plan:observedBy "The source that read the observation."@en)
ObjectPropertyDomain(plan:observedBy plan:Observation)
ObjectPropertyRange(plan:observedBy plan:Source)
AnnotationAssertion(rdfs:label plan:patchOp "patch operation"@en)
AnnotationAssertion(skos:definition plan:patchOp "The operation: add-item, change-state, add-event, link or confirm."@en)
DataPropertyDomain(plan:patchOp plan:Patch)
DataPropertyRange(plan:patchOp xsd:string)
AnnotationAssertion(rdfs:label plan:patchTarget "patch target"@en)
AnnotationAssertion(skos:definition plan:patchTarget "The source the patch is to be written to; a write has an explicit target."@en)
ObjectPropertyDomain(plan:patchTarget plan:Patch)
ObjectPropertyRange(plan:patchTarget plan:Source)
AnnotationAssertion(rdfs:label plan:previewHash "preview hash"@en)
AnnotationAssertion(skos:definition plan:previewHash "The SHA-256 of the preview, which a headless check mode compares with the plan it is told to apply."@en)
DataPropertyDomain(plan:previewHash plan:Preview)
DataPropertyRange(plan:previewHash xsd:string)
AnnotationAssertion(rdfs:label plan:previewOf "preview of"@en)
AnnotationAssertion(skos:definition plan:previewOf "The patch the preview is about."@en)
ObjectPropertyDomain(plan:previewOf plan:Preview)
ObjectPropertyRange(plan:previewOf plan:Patch)
AnnotationAssertion(rdfs:label plan:principalBasis "principal basis"@en)
AnnotationAssertion(skos:definition plan:principalBasis "How the principal of an agent was established; stored with the actor, which names the principal with prov:actedOnBehalfOf."@en)
ObjectPropertyDomain(plan:principalBasis plan:Actor)
ObjectPropertyRange(plan:principalBasis plan:PrincipalBasis)
AnnotationAssertion(rdfs:label plan:sarifLevel "SARIF level"@en)
AnnotationAssertion(skos:definition plan:sarifLevel "The name of the SARIF result level the severity is: error, warning or note (SARIF 2.1.0 Plus Errata 01, sections 3.27.9 and 3.27.10: the levels that apply where the result's kind is fail); a name and no IRI."@en)
DataPropertyDomain(plan:sarifLevel plan:Severity)
DataPropertyRange(plan:sarifLevel xsd:string)
AnnotationAssertion(rdfs:label plan:seenIn "seen in"@en)
AnnotationAssertion(skos:definition plan:seenIn "An observation of the item, in one place; an item has one for every place it was seen."@en)
ObjectPropertyDomain(plan:seenIn plan:Item)
ObjectPropertyRange(plan:seenIn plan:Observation)
AnnotationAssertion(rdfs:label plan:sourceCapability "source capability"@en)
AnnotationAssertion(skos:definition plan:sourceCapability "An ability the source declares."@en)
ObjectPropertyDomain(plan:sourceCapability plan:Source)
ObjectPropertyRange(plan:sourceCapability plan:Capability)
AnnotationAssertion(rdfs:label plan:sourceName "source name"@en)
AnnotationAssertion(skos:definition plan:sourceName "The name of the source, as the package that holds it is named."@en)
DataPropertyDomain(plan:sourceName plan:Source)
DataPropertyRange(plan:sourceName xsd:string)
AnnotationAssertion(rdfs:label plan:sourceSeverity "source severity"@en)
AnnotationAssertion(skos:definition plan:sourceSeverity "The severity as the source wrote it, where the source has more levels than the three of plan:Severity; the item keeps this value and the three are not an exact expression of it."@en)
DataPropertyDomain(plan:sourceSeverity plan:Item)
DataPropertyRange(plan:sourceSeverity xsd:string)
AnnotationAssertion(rdfs:label plan:traceItem "trace item"@en)
AnnotationAssertion(skos:definition plan:traceItem "The item that was derived."@en)
ObjectPropertyDomain(plan:traceItem plan:Trace)
ObjectPropertyRange(plan:traceItem plan:Item)
AnnotationAssertion(rdfs:label plan:traceObservation "trace observation"@en)
AnnotationAssertion(skos:definition plan:traceObservation "The observation it was derived from."@en)
ObjectPropertyDomain(plan:traceObservation plan:Trace)
ObjectPropertyRange(plan:traceObservation plan:Observation)
AnnotationAssertion(rdfs:label plan:webAnnotationMotivation "Web Annotation motivation"@en)
AnnotationAssertion(skos:definition plan:webAnnotationMotivation "The name of the Web Annotation motivation the kind is closest to (Web Annotation Data Model, section 3.3.5, one of the thirteen motivations; the IRI of each is in the namespace http://www.w3.org/ns/oa# of the Web Annotation Vocabulary, section 2.3)."@en)
DataPropertyDomain(plan:webAnnotationMotivation plan:ItemKind)
DataPropertyRange(plan:webAnnotationMotivation xsd:string)

