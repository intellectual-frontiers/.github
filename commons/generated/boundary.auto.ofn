AnnotationAssertion(rdfs:label bnd:Boundary "Boundary"@en)
AnnotationAssertion(skos:definition bnd:Boundary "The line a body of authority draws around the things it answers for, of a kind that a regime defines: typed, versioned and approved by a person. It is not a realm, which is where assets are found."@en)
SubClassOf(bnd:Boundary prov:Entity)
AnnotationAssertion(rdfs:label bnd:BoundaryKind "Boundary kind"@en)
AnnotationAssertion(skos:definition bnd:BoundaryKind "One of the kinds of boundary: the authority, the roles of people, the roles of assets and the agreements a regime defines."@en)
SubClassOf(bnd:BoundaryKind skos:Concept)
AnnotationAssertion(rdfs:label bnd:Categorization "Categorization"@en)
AnnotationAssertion(skos:definition bnd:Categorization "The impact of each of the three security objectives (confidentiality, integrity, availability) of a boundary, as the highest impact among the information types it holds."@en)
SubClassOf(bnd:Categorization prov:Entity)
AnnotationAssertion(rdfs:label bnd:CmmcAssetCategory "CMMC asset category"@en)
AnnotationAssertion(skos:definition bnd:CmmcAssetCategory "One of the categories into which the assets of a CUI environment fall for assessment."@en)
SubClassOf(bnd:CmmcAssetCategory skos:Concept)
AnnotationAssertion(rdfs:label bnd:DataClass "Data class"@en)
AnnotationAssertion(skos:definition bnd:DataClass "One of the classes of data that a boundary holds and that a regime defines."@en)
SubClassOf(bnd:DataClass skos:Concept)
AnnotationAssertion(rdfs:label bnd:Disposition "Disposition"@en)
AnnotationAssertion(skos:definition bnd:Disposition "One of the decisions about an asset in a boundary: in scope in a role, inherited, external, out of scope or undecided."@en)
SubClassOf(bnd:Disposition skos:Concept)
AnnotationAssertion(rdfs:label bnd:Enclave "Enclave"@en)
AnnotationAssertion(skos:definition bnd:Enclave "A set of resources that work in one security domain and share the protection of one common, continuous perimeter; a network zone with a single policy and authority."@en)
SubClassOf(bnd:Enclave prov:Entity)
SubClassOf(bnd:Enclave bnd:Boundary)
AnnotationAssertion(rdfs:label bnd:ExternalSystem "External system"@en)
AnnotationAssertion(skos:definition bnd:ExternalSystem "A system outside the fleet that a boundary relies on or exchanges information with, with what its party holds to show it may be relied on."@en)
SubClassOf(bnd:ExternalSystem prov:Entity)
AnnotationAssertion(rdfs:label bnd:Impact "Impact"@en)
AnnotationAssertion(skos:definition bnd:Impact "One of the ordered levels of potential harm from the loss of a security objective: low, moderate or high."@en)
SubClassOf(bnd:Impact skos:Concept)
AnnotationAssertion(rdfs:label bnd:Inheritance "Inheritance"@en)
AnnotationAssertion(skos:definition bnd:Inheritance "What a provider's authorization, report or certificate supplies to a boundary: the controls it covers, who answers for each and the evidence with its dates."@en)
SubClassOf(bnd:Inheritance prov:Entity)
AnnotationAssertion(rdfs:label bnd:Interconnection "Interconnection"@en)
AnnotationAssertion(skos:definition bnd:Interconnection "An approved, agreed and reviewed crossing of a boundary: its two ends, the direction, the data classes, the agreement and the managed interface."@en)
SubClassOf(bnd:Interconnection prov:Entity)
AnnotationAssertion(rdfs:label bnd:Jurisdiction "Jurisdiction"@en)
AnnotationAssertion(skos:definition bnd:Jurisdiction "A country or region whose law governs the data held there; the location of data decides which laws apply to it and what a transfer out of it needs."@en)
SubClassOf(bnd:Jurisdiction prov:Entity)
AnnotationAssertion(rdfs:label bnd:PartyRole "Party role"@en)
AnnotationAssertion(skos:definition bnd:PartyRole "One of the two roles that privacy regimes give the parties to the processing of personal data: the one that decides and the one that processes for it."@en)
SubClassOf(bnd:PartyRole skos:Concept)
AnnotationAssertion(rdfs:label bnd:ProcessingActivity "Processing activity"@en)
AnnotationAssertion(skos:definition bnd:ProcessingActivity "A purpose of processing personal data with its legal basis, the people and data it concerns, the systems, the recipients, the transfers and the retention."@en)
SubClassOf(bnd:ProcessingActivity prov:Entity)
AnnotationAssertion(rdfs:label bnd:Realm "Realm"@en)
AnnotationAssertion(skos:definition bnd:Realm "Where assets are found and what a connection may read: an account, a tenant, a cluster, a site or a LAN. It says nothing about who answers for the assets."@en)
SubClassOf(bnd:Realm prov:Entity)
AnnotationAssertion(rdfs:label bnd:boundaryId "boundary id"@en)
AnnotationAssertion(skos:definition bnd:boundaryId "The id of the boundary: lower case words joined by hyphens."@en)
DataPropertyDomain(bnd:boundaryId bnd:Boundary)
DataPropertyRange(bnd:boundaryId xsd:string)
AnnotationAssertion(rdfs:label bnd:boundaryKind "boundary kind"@en)
AnnotationAssertion(skos:definition bnd:boundaryKind "The kind of the boundary, which decides its authority, roles and agreements."@en)
ObjectPropertyDomain(bnd:boundaryKind bnd:Boundary)
ObjectPropertyRange(bnd:boundaryKind bnd:BoundaryKind)
AnnotationAssertion(rdfs:label bnd:categorizedAs "categorized as"@en)
AnnotationAssertion(skos:definition bnd:categorizedAs "The categorization of the boundary: the impact of each security objective."@en)
ObjectPropertyDomain(bnd:categorizedAs bnd:Boundary)
ObjectPropertyRange(bnd:categorizedAs bnd:Categorization)
AnnotationAssertion(rdfs:label bnd:residentIn "resident in"@en)
AnnotationAssertion(skos:definition bnd:residentIn "The jurisdiction in which the data of the boundary is held; the data residency the boundary is constrained to."@en)
