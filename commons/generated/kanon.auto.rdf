  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/id/mizan/term-kanon-TraceEdge">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#OntologyTerm"/>
    <rdfs:label xml:lang="en">kanon:TraceEdge</rdfs:label>
    <mz:basis rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Specializes"/>
    <mz:definedBy>0033-kanon FR-015</mz:definedBy>
