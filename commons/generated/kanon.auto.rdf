  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/id/mizan/term-kanon-Surface">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#OntologyTerm"/>
    <rdfs:label xml:lang="en">kanon:Surface</rdfs:label>
