    <mz:standardTerm>http://www.w3.org/ns/prov#Derivation</mz:standardTerm>
    <mz:termIri>https://www.intellectualfrontiers.com/ontology/kanon#TraceEdge</mz:termIri>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/kanon#Element">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Element</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">One thing a layer says (a concept, an action, a table, a command), with a stable identity, a kind, a name, a definition and a source.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/kanon#Family">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Family</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Collection"/>
    <skos:definition xml:lang="en">A host with its dialects and plugins, and the naming rule of their packages (&lt;host&gt;-dialect-&lt;tool&gt;, &lt;host&gt;-&lt;noun&gt;), as data of the host's table.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/kanon#Finding">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Finding</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/shacl#ValidationResult"/>
    <skos:definition xml:lang="en">A breach of the rules of Kanon, with its code, the element or file it is about and one sentence.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/kanon#Governance">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/kanon#Layer"/>
    <rdfs:label xml:lang="en">Governance</rdfs:label>
    <skos:definition xml:lang="en">What a thing is and what it may do, stated once, in the words of its domain.</skos:definition>
    <kanon:dataModelingLevel>conceptual</kanon:dataModelingLevel>
    <kanon:layerRank rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</kanon:layerRank>
    <kanon:mdaViewpoint>CIM</kanon:mdaViewpoint>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/kanon#Instance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Instance</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">One of several occurrences of a kind of unit in the Physical layer (a dialect), declared by its host with the unit it is an instance of; it imports only the layers it extends, through the host's public exports, and never another instance.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/kanon#Layer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Layer</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">One of Governance, Logical and Physical, with its rank and its alignment to the viewpoints of Model Driven Architecture.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/kanon#Logical">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/kanon#Layer"/>
    <rdfs:label xml:lang="en">Logical</rdfs:label>
    <skos:definition xml:lang="en">The model a program reasons with, made from Governance by code and never copied.</skos:definition>
    <kanon:dataModelingLevel>logical</kanon:dataModelingLevel>
    <kanon:layerRank rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</kanon:layerRank>
    <kanon:mdaViewpoint>PIM</kanon:mdaViewpoint>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/kanon#Matrix">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Matrix</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">The table of requirement by instance: for each annotation of Governance and each instance, whether it is expressed, carried or unexpressed with its reason, or dropped.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/kanon#Physical">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/kanon#Layer"/>
    <rdfs:label xml:lang="en">Physical</rdfs:label>
    <skos:definition xml:lang="en">What carries the logical model out in a place: a dialect, a table, a command, a tool, a route.</skos:definition>
    <kanon:dataModelingLevel>physical</kanon:dataModelingLevel>
    <kanon:layerRank rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</kanon:layerRank>
    <kanon:mdaViewpoint>PSM</kanon:mdaViewpoint>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/kanon#Plugin">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Plugin</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">A package that extends one host through the host's public exports and the plugin contract only; the host never imports it, and it imports another plugin only by a declared dependency.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/kanon#Projection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Projection</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <skos:definition xml:lang="en">The derivation, by code, of the elements of one layer from the elements of the layer above.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/kanon#Surface">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Surface</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">A unit of the Physical layer that faces a caller: the command line, a tool server, a REST service.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/kanon#TraceEdge">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Trace edge</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Derivation"/>
    <skos:definition xml:lang="en">The record that an element of one layer was made from an element of the layer above, and how.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/kanon#about">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/kanon#Finding"/>
    <rdfs:label xml:lang="en">about</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/kanon#Element"/>
    <skos:definition xml:lang="en">The element the finding is about, where it is about one.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/kanon#dataModelingLevel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/kanon#Layer"/>
    <rdfs:label xml:lang="en">data modeling level</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The level of data modeling the layer is close to: conceptual, logical or physical.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/kanon#dependsOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/kanon#Plugin"/>
    <rdfs:label xml:lang="en">depends on</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/kanon#Plugin"/>
    <skos:definition xml:lang="en">A plugin this one declares a dependency on, and may import.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/kanon#elementId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/kanon#Element"/>
    <rdfs:label xml:lang="en">element id</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The identity of the element, stable across builds.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/kanon#elementInstance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/kanon#Element"/>
    <rdfs:label xml:lang="en">element instance</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/kanon#Instance"/>
    <skos:definition xml:lang="en">The instance an element of a physical layer belongs to.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/kanon#elementKind">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/kanon#Element"/>
    <rdfs:label xml:lang="en">element kind</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">What kind of thing the element is: action, verb, option, operand, problem-code, outcome, cli-command, mcp-tool or rest-route.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/kanon#familyHost">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/kanon#Family"/>
    <rdfs:label xml:lang="en">family host</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The package of the host library of the family.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/kanon#how">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/kanon#TraceEdge"/>
    <rdfs:label xml:lang="en">how</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">How the one was made into the other: projects to, written as, read by.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/kanon#inLayer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/kanon#Element"/>
    <rdfs:label xml:lang="en">in layer</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/kanon#Layer"/>
    <skos:definition xml:lang="en">The layer an element is in.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/kanon#instanceFamily">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/kanon#Instance"/>
    <rdfs:label xml:lang="en">instance family</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/kanon#Family"/>
    <skos:definition xml:lang="en">The family whose host declares the instance.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/kanon#instanceName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/kanon#Instance"/>
    <rdfs:label xml:lang="en">instance name</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The name of the instance, as ansible.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/kanon#instanceOfUnit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/kanon#Instance"/>
    <rdfs:label xml:lang="en">instance of unit</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The folder of the unit of which this is an instance.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/kanon#layerRank">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/kanon#Layer"/>
    <rdfs:label xml:lang="en">layer rank</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <skos:definition xml:lang="en">How far down the layer stands, from 1 at Governance; a higher rank imports a lower.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/kanon#matrixFamily">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/kanon#Matrix"/>
    <rdfs:label xml:lang="en">matrix family</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/kanon#Family"/>
    <skos:definition xml:lang="en">The family whose instances are the columns of the matrix.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/kanon#matrixOutcome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/kanon#Matrix"/>
    <rdfs:label xml:lang="en">matrix outcome</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">How a cell of the matrix ends: expressed, carried, unexpressed or dropped.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/kanon#mdaViewpoint">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/kanon#Layer"/>
    <rdfs:label xml:lang="en">MDA viewpoint</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The viewpoint of OMG's Model Driven Architecture the layer is close to: CIM, PIM or PSM (a closeMatch, not an identity).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/kanon#pluginFamily">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/kanon#Plugin"/>
    <rdfs:label xml:lang="en">plugin family</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/kanon#Family"/>
    <skos:definition xml:lang="en">The family whose host declares the plugin.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/kanon#pluginNoun">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/kanon#Plugin"/>
    <rdfs:label xml:lang="en">plugin noun</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The noun the plugin adds to the host's command, as server.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/kanon#projectsFrom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/kanon#Projection"/>
    <rdfs:label xml:lang="en">projects from</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/kanon#Layer"/>
    <skos:definition xml:lang="en">The layer the projection reads.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/kanon#projectsTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/kanon#Projection"/>
    <rdfs:label xml:lang="en">projects to</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/kanon#Layer"/>
    <skos:definition xml:lang="en">The layer the projection makes.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/kanon#rule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/kanon#Finding"/>
    <rdfs:label xml:lang="en">rule</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The code of the finding: layers/unclassified, layers/relative, layers/private, layers/external, layers/above, layers/around, layers/cycle, instances/sibling, instances/undeclared, plugins/inverted, plugins/undeclared, plugins/contract, family/name or kanon/dropped.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/kanon#surfaceLayer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/kanon#Surface"/>
    <rdfs:label xml:lang="en">surface layer</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/kanon#Layer"/>
    <skos:definition xml:lang="en">The layer a surface is in: Physical.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/kanon#tracesFrom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/kanon#TraceEdge"/>
    <rdfs:label xml:lang="en">traces from</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/kanon#Element"/>
    <skos:definition xml:lang="en">The element of the layer above that the edge starts at.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/kanon#tracesTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/kanon#TraceEdge"/>
    <rdfs:label xml:lang="en">traces to</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/kanon#Element"/>
    <skos:definition xml:lang="en">The element of the layer below that was made from it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/kanon">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <ns1:description xml:lang="en">The vocabulary of Kanon, the pattern of a library built in three layers: the layers, the elements they say, the projections that derive one from the other, the trace edges that keep identity, the surfaces, the findings of the check, the instances of a unit kind, the plugins, the families and the matrix of requirement by instance.</ns1:description>
    <rdfs:label xml:lang="en">Kanon</rdfs:label>
    <owl:versionIRI rdf:resource="https://www.intellectualfrontiers.com/ontology/kanon/1.0.0"/>
    <owl:versionInfo>1.0.0</owl:versionInfo>
  </rdf:Description>
</rdf:RDF>
