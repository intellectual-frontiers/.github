AnnotationAssertion(rdfs:label ifqs:AssessorPack "Assessor pack"@en)
AnnotationAssertion(skos:definition ifqs:AssessorPack "The self-contained, offline-verifiable bundle of the evidence of one revision and span, for a person who has to check it."@en)
SubClassOf(ifqs:AssessorPack dcat:Dataset)
AnnotationAssertion(rdfs:label ifqs:Audience "Audience"@en)
AnnotationAssertion(skos:definition ifqs:Audience "public, assessor or internal: who a rendering of evidence is for."@en)
SubClassOf(ifqs:Audience skos:Concept)
AnnotationAssertion(rdfs:label ifqs:Capa "CAPA"@en)
AnnotationAssertion(skos:definition ifqs:Capa "A corrective and preventive action: the plan that corrects a nonconformance, names the test that verifies it and is closed by a named person."@en)
SubClassOf(ifqs:Capa prov:Plan)
AnnotationAssertion(rdfs:label ifqs:CapaState "CAPA state"@en)
AnnotationAssertion(skos:definition ifqs:CapaState "open, verified or closed, in that order."@en)
SubClassOf(ifqs:CapaState skos:Concept)
AnnotationAssertion(rdfs:label ifqs:Evidence "Evidence"@en)
AnnotationAssertion(skos:definition ifqs:Evidence "What a run, a review or a probe shows of one requirement, with the grade it carries and its freshness."@en)
SubClassOf(ifqs:Evidence prov:Entity)
AnnotationAssertion(rdfs:label ifqs:EvidenceFile "Evidence file"@en)
AnnotationAssertion(skos:definition ifqs:EvidenceFile "The immutable file of one run on the quality branch, with its digest and the digest of the file before it."@en)
SubClassOf(ifqs:EvidenceFile prov:Entity)
AnnotationAssertion(rdfs:label ifqs:EvidenceGrade "Evidence grade"@en)
AnnotationAssertion(skos:definition ifqs:EvidenceGrade "E0 to E5: how much a piece of evidence is worth."@en)
SubClassOf(ifqs:EvidenceGrade skos:Concept)
AnnotationAssertion(rdfs:label ifqs:FreshnessState "Freshness state"@en)
AnnotationAssertion(skos:definition ifqs:FreshnessState "fresh, due or stale."@en)
SubClassOf(ifqs:FreshnessState skos:Concept)
AnnotationAssertion(rdfs:label ifqs:Nonconformance "Nonconformance"@en)
AnnotationAssertion(skos:definition ifqs:Nonconformance "A failure of a requirement to be met, or a stale proof of it, opened by the system itself (ISO 9001 clause 10.2's nonconformity)."@en)
SubClassOf(ifqs:Nonconformance prov:Entity)
AnnotationAssertion(rdfs:label ifqs:NonconformanceState "Nonconformance state"@en)
AnnotationAssertion(skos:definition ifqs:NonconformanceState "open or closed."@en)
SubClassOf(ifqs:NonconformanceState skos:Concept)
AnnotationAssertion(rdfs:label ifqs:QualityObjective "Quality objective"@en)
AnnotationAssertion(skos:definition ifqs:QualityObjective "A success criterion as a metric, with a target, a unit, an error budget and the window it is spent in."@en)
AnnotationAssertion(rdfs:label ifqs:QualityTier "Quality tier"@en)
AnnotationAssertion(skos:definition ifqs:QualityTier "Tier 0 (evidence exists), Tier 1 (the system reports itself) or Tier 2 (people see and prove)."@en)
SubClassOf(ifqs:QualityTier skos:Concept)
AnnotationAssertion(rdfs:label ifqs:ReviewDebt "Review debt"@en)
AnnotationAssertion(skos:definition ifqs:ReviewDebt "The number of requirements whose best fresh evidence is E1 or E2, counted at a revision."@en)
AnnotationAssertion(rdfs:label ifqs:TestCase "Test case"@en)
AnnotationAssertion(skos:definition ifqs:TestCase "One case of a run, with its outcome, its reason where it has one and the requirements it proves."@en)
SubClassOf(ifqs:TestCase prov:Activity)
AnnotationAssertion(rdfs:label ifqs:TestOutcome "Test outcome"@en)
AnnotationAssertion(skos:definition ifqs:TestOutcome "pass, fail, skip, todo, cancelled or not run."@en)
SubClassOf(ifqs:TestOutcome skos:Concept)
AnnotationAssertion(rdfs:label ifqs:TestRun "Test run"@en)
AnnotationAssertion(skos:definition ifqs:TestRun "One run of a suite: its trace, the revision it tested and its cases; kept as one file of the record of 0008-test-evidence."@en)
SubClassOf(ifqs:TestRun prov:Activity)
