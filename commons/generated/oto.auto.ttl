oto:AcceptableRanges a oto:Dimension ;
    rdfs:label "Acceptable ranges of behavior"@en ;
    skos:definition "Whether the behavior stays within the range defined as acceptable, not only correct."@en .

oto:AcceptanceRun a owl:Class ;
    rdfs:label "Acceptance run"@en ;
    rdfs:subClassOf ifqs:TestRun ;
    skos:definition "A run of Operational Acceptance Testing: a test run that says what was expected, what was observed and which dimension it tested."@en .

oto:AiNativeContinuouslyVerified a oto:MaturityLevel ;
    rdfs:label "AI-native and continuously verified"@en ;
    skos:definition "Full operational truth with AI systems grounded in verified evidence."@en ;
    oto:levelNumber 4 .

oto:Aligned a oto:AlignmentState ;
    rdfs:label "aligned"@en ;
    skos:definition "What is declared and what is observed agree. Not on the source's site: from the estate library."@en .

oto:Alignment a owl:Class ;
    rdfs:label "Alignment"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "The measurable alignment between intent, structure, execution and evidence, of one subject: what the source calls Operational Truth."@en .

oto:AlignmentState a owl:Class ;
    rdfs:label "Alignment state"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "aligned, drifted or not observed."@en .

oto:AttestationBased a oto:MaturityLevel ;
    rdfs:label "Attestation-based"@en ;
    skos:definition "Traditional compliance relying on human attestations and periodic audits."@en ;
    oto:levelNumber 1 .

oto:ChangeAndMemory a oto:Domain ;
    rdfs:label "Change, versioning and organizational memory"@en ;
    skos:definition "How the organization evolves: every change has authorship, intent and measurable impact, and rollback is possible and explicit; organizations gain memory, not just history."@en ;
    oto:domainNumber 7 ;
    oto:entity "Approval",
        "Change Event",
        "Diff",
        "Proposal",
        "Rationale",
        "Version" ;
    oto:realizedBy "ontology",
        "spec-kit" .

oto:ComplianceAsCode a oto:Principle ;
    rdfs:label "Compliance as code"@en ;
    skos:definition "Policies are expressed in executable, testable formats."@en .

oto:ContinuousVerification a oto:Principle ;
    rdfs:label "Continuous verification"@en ;
    skos:definition "Real-time validation replaces periodic point-in-time audits."@en .

oto:DataGovernance a oto:Pillar ;
    rdfs:label "Data governance"@en ;
    skos:definition "Evidence provenance, chain of custody and machine-attested verification for every data point."@en .

oto:Dimension a owl:Class ;
    rdfs:label "Dimension"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "One of the four dimensions of system behavior that Operational Acceptance Testing tests."@en .

oto:DisciplinedTooling a oto:Pillar ;
    rdfs:label "Disciplined tooling"@en ;
    skos:definition "Unified evidence warehouses, edge agents and API-first integrations with existing systems."@en .

oto:Domain a owl:Class ;
    rdfs:label "Domain"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "One of the nine areas of the organization the ontology models, each with its entities."@en .

oto:Drifted a oto:AlignmentState ;
    rdfs:label "drifted"@en ;
    skos:definition "What is declared and what is observed differ. Not on the source's site: from the estate library."@en .

oto:EvidenceAndTelemetry a oto:Domain ;
    rdfs:label "Evidence and telemetry as truth anchors"@en ;
    skos:definition "The domain that grounds the ontology in observable reality: evidence is not documentation, it is proof, immutable, attributable, linked to what it supports and bounded in time and scope."@en ;
    oto:domainNumber 5 ;
    oto:entity "Assertion",
        "Event",
        "Evidence Artifact",
        "Log",
        "Measurement",
        "Observation",
        "Snapshot" ;
    oto:realizedBy "grc",
        "quality",
        "telemetry" .

oto:EvidenceFirst a oto:MaturityLevel ;
    rdfs:label "Evidence-first"@en ;
    skos:definition "All compliance claims are backed by machine-readable evidence."@en ;
    oto:levelNumber 3 .

oto:EvidenceSupplyChain a oto:Principle ;
    rdfs:label "Evidence supply chain"@en ;
    skos:definition "Complete provenance from source to audit report."@en .

oto:ExternalObligations a oto:Domain ;
    rdfs:label "External obligations and normative frameworks"@en ;
    skos:definition "The world the organization operates in: external requirements never stand alone, they map to internal policies, controls and evidence, and traceability is bidirectional."@en ;
    oto:domainNumber 6 ;
    oto:entity "Authority",
        "Contract",
        "Jurisdiction",
        "Obligation",
        "Regulation",
        "Requirement",
        "Standard" ;
    oto:realizedBy "grc",
        "ontology" .

oto:FailureModesAndRecovery a oto:Dimension ;
    rdfs:label "Failure modes and recovery"@en ;
    skos:definition "How the system fails and recovers: silently or with an alert, gracefully or not."@en .

oto:InfrastructureAndPlatform a oto:Domain ;
    rdfs:label "Infrastructure as code and platform truth"@en ;
    skos:definition "The technical substrate on which operations run: infrastructure is declarative and inspectable, and identity and access are graph-connected to roles and policies."@en ;
    oto:domainNumber 4 ;
    oto:entity "Access Controls",
        "Assets",
        "Configurations",
        "Dependencies",
        "Environments",
        "Identities",
        "Services",
        "Systems" ;
    oto:realizedBy "archon",
        "estate",
        "toolchain" .

oto:Invariant a owl:Class ;
    rdfs:label "Invariant"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A condition an ontology must satisfy to be trustworthy; its violation is a system error."@en .

oto:MaturityLevel a owl:Class ;
    rdfs:label "Maturity level"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "One of the four levels of the maturity model, numbered 1 to 4."@en .

oto:NoAuthorityWithoutScope a oto:Invariant ;
    rdfs:label "No authority without scope"@en ;
    skos:definition "Every authority has a scope; authority with none is a system error, not an audit finding."@en .

oto:NoComplianceWithoutTraceability a oto:Invariant ;
    rdfs:label "No compliance without traceability"@en ;
    skos:definition "Every claim of compliance is traceable to the requirement, policy, control and evidence behind it; a claim with none is a system error, not an audit finding."@en .

oto:NoEvidenceWithoutAttribution a oto:Invariant ;
    rdfs:label "No evidence without attribution"@en ;
    skos:definition "Every piece of evidence is attributable to a source; evidence with none is a system error, not an audit finding."@en .

oto:NoOrphanPolicies a oto:Invariant ;
    rdfs:label "No orphan policies"@en ;
    skos:definition "Every policy has an owner and a place in the graph; a policy with none is a system error, not an audit finding."@en .

oto:NoUnenforcedCriticalControls a oto:Invariant ;
    rdfs:label "No unenforced critical controls"@en ;
    skos:definition "Every critical control is enforced; one that is not is a system error, not an audit finding."@en .

oto:NoUnownedResponsibilities a oto:Invariant ;
    rdfs:label "No unowned responsibilities"@en ;
    skos:definition "Every responsibility has an accountable owner; one with none is a system error, not an audit finding."@en .

oto:NotObserved a oto:AlignmentState ;
    rdfs:label "not observed"@en ;
    skos:definition "Nothing was observed yet: a waiting item, never a failure and never agreement. Not on the source's site: from the estate library."@en .

oto:ObservableState a oto:Principle ;
    rdfs:label "Observable state"@en ;
    skos:definition "Live infrastructure state, not documentation assumptions."@en .

oto:OrganizationalStructure a oto:Domain ;
    rdfs:label "Organizational structure as code"@en ;
    skos:definition "The human and structural anatomy of the organization: structural truth is not inferred, it is declared."@en ;
    oto:domainNumber 1 ;
    oto:entity "Accountability",
        "Cost Center",
        "Delegation of Authority",
        "Organizational Unit",
        "Person",
        "Reporting Line",
        "Responsibility",
        "Role",
        "Team" ;
    oto:realizedBy "grc" .

oto:PartiallyAutomated a oto:MaturityLevel ;
    rdfs:label "Partially automated"@en ;
    skos:definition "Some automation in evidence collection, but still document-centric."@en ;
    oto:levelNumber 2 .

oto:Pillar a owl:Class ;
    rdfs:label "Pillar"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "One of the three foundations of the framework: policies as code, data governance, disciplined tooling."@en .

oto:PoliciesAsCode a oto:Pillar ;
    rdfs:label "Policies as code"@en ;
    skos:definition "Compliance rules as executable, version-controlled, testable code, not PDF documents."@en .

oto:PolicyAsCode a oto:Domain ;
    rdfs:label "Policy as code"@en ;
    skos:definition "Organizational intent as enforceable logic rather than prose: policy is not static text, it is executable intent."@en ;
    oto:domainNumber 2 ;
    oto:entity "Control Objective",
        "Enforcement Mode",
        "Exception",
        "Expiration",
        "Policy Group",
        "Policy Rule",
        "Policy",
        "Waiver" ;
    oto:realizedBy "grc" .

oto:Principle a owl:Class ;
    rdfs:label "Principle"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "One of the five principles of the framework."@en .

oto:ProcessAndWorkflow a oto:Domain ;
    rdfs:label "Process and workflow as code"@en ;
    skos:definition "How work actually flows: processes are graphs, tasks are bound to roles, decisions have criteria and authority, and failure paths are first-class."@en ;
    oto:domainNumber 3 ;
    oto:entity "Approval",
        "Decision Point",
        "Failure Mode",
        "Handoff",
        "Process",
        "SLA",
        "Task",
        "Workflow" .

oto:QueryableEvidence a oto:Principle ;
    rdfs:label "Queryable evidence"@en ;
    skos:definition "Every compliance claim is backed by machine-readable, SQL-queryable proof."@en .

oto:SimulationAndTesting a oto:Domain ;
    rdfs:label "Simulation, testing and counterfactuals"@en ;
    skos:definition "Safe experimentation: changes are modeled before execution, policies are tested before enforcement, and governance moves from reactive to predictive."@en ;
    oto:domainNumber 8 ;
    oto:entity "Expected Outcome",
        "Hypothesis",
        "Observed Outcome",
        "Risk Delta",
        "Scenario",
        "Test" ;
    oto:realizedBy "quality",
        "test" .

oto:StabilityOfOutcomes a oto:Dimension ;
    rdfs:label "Stability of outcomes"@en ;
    skos:definition "Whether the system produces results that stay within acceptable boundaries over time."@en .

oto:Trustworthiness a oto:Dimension ;
    rdfs:label "Trustworthiness"@en ;
    skos:definition "Whether the outputs can be relied on for decisions, with the means to trace how they were produced."@en .

oto:UnifyingGraph a oto:Domain ;
    rdfs:label "Unifying graph model"@en ;
    skos:definition "All domains resolve into a single typed graph whose nodes are declared entities and whose edges are explicit relationships with semantics, direction and constraints: the graph is the system of record."@en ;
    oto:domainNumber 9 ;
    oto:realizedBy "ontology",
        "rdf" .

