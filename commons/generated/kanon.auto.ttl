kanon:Element a owl:Class ;
    rdfs:label "Element"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "One thing a layer says (a concept, an action, a table, a command), with a stable identity, a kind, a name, a definition and a source."@en .

kanon:Family a owl:Class ;
    rdfs:label "Family"@en ;
    rdfs:subClassOf skos:Collection ;
    skos:definition "A host with its dialects and plugins, and the naming rule of their packages (<host>-dialect-<tool>, <host>-<noun>), as data of the host's table."@en .

kanon:Finding a owl:Class ;
    rdfs:label "Finding"@en ;
    rdfs:subClassOf sh:ValidationResult ;
    skos:definition "A breach of the rules of Kanon, with its code, the element or file it is about and one sentence."@en .

kanon:Governance a kanon:Layer ;
    rdfs:label "Governance"@en ;
    skos:definition "What a thing is and what it may do, stated once, in the words of its domain."@en ;
    kanon:dataModelingLevel "conceptual" ;
    kanon:layerRank 1 ;
    kanon:mdaViewpoint "CIM" .

kanon:Instance a owl:Class ;
    rdfs:label "Instance"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "One of several occurrences of a kind of unit in the Physical layer (a dialect), declared by its host with the unit it is an instance of; it imports only the layers it extends, through the host's public exports, and never another instance."@en .

kanon:Layer a owl:Class ;
    rdfs:label "Layer"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "One of Governance, Logical and Physical, with its rank and its alignment to the viewpoints of Model Driven Architecture."@en .

kanon:Logical a kanon:Layer ;
    rdfs:label "Logical"@en ;
    skos:definition "The model a program reasons with, made from Governance by code and never copied."@en ;
    kanon:dataModelingLevel "logical" ;
    kanon:layerRank 2 ;
    kanon:mdaViewpoint "PIM" .

kanon:Matrix a owl:Class ;
    rdfs:label "Matrix"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "The table of requirement by instance: for each annotation of Governance and each instance, whether it is expressed, carried or unexpressed with its reason, or dropped."@en .

kanon:Physical a kanon:Layer ;
    rdfs:label "Physical"@en ;
    skos:definition "What carries the logical model out in a place: a dialect, a table, a command, a tool, a route."@en ;
    kanon:dataModelingLevel "physical" ;
    kanon:layerRank 3 ;
    kanon:mdaViewpoint "PSM" .

kanon:Plugin a owl:Class ;
    rdfs:label "Plugin"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "A package that extends one host through the host's public exports and the plugin contract only; the host never imports it, and it imports another plugin only by a declared dependency."@en .

kanon:Projection a owl:Class ;
    rdfs:label "Projection"@en ;
    rdfs:subClassOf prov:Activity ;
    skos:definition "The derivation, by code, of the elements of one layer from the elements of the layer above."@en .

kanon:Surface a owl:Class ;
    rdfs:label "Surface"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "A unit of the Physical layer that faces a caller: the command line, a tool server, a REST service."@en .

kanon:TraceEdge a owl:Class ;
    rdfs:label "Trace edge"@en ;
    rdfs:subClassOf prov:Derivation ;
    skos:definition "The record that an element of one layer was made from an element of the layer above, and how."@en .

kanon:about a owl:ObjectProperty ;
    rdfs:domain kanon:Finding ;
    rdfs:label "about"@en ;
    rdfs:range kanon:Element ;
    skos:definition "The element the finding is about, where it is about one."@en .

kanon:dataModelingLevel a owl:DatatypeProperty ;
    rdfs:domain kanon:Layer ;
    rdfs:label "data modeling level"@en ;
    rdfs:range xsd:string ;
    skos:definition "The level of data modeling the layer is close to: conceptual, logical or physical."@en .

kanon:dependsOn a owl:ObjectProperty ;
    rdfs:domain kanon:Plugin ;
    rdfs:label "depends on"@en ;
    rdfs:range kanon:Plugin ;
    skos:definition "A plugin this one declares a dependency on, and may import."@en .

kanon:elementId a owl:DatatypeProperty ;
    rdfs:domain kanon:Element ;
    rdfs:label "element id"@en ;
    rdfs:range xsd:string ;
    skos:definition "The identity of the element, stable across builds."@en .

kanon:elementInstance a owl:ObjectProperty ;
    rdfs:domain kanon:Element ;
    rdfs:label "element instance"@en ;
    rdfs:range kanon:Instance ;
    skos:definition "The instance an element of a physical layer belongs to."@en .

kanon:elementKind a owl:DatatypeProperty ;
    rdfs:domain kanon:Element ;
    rdfs:label "element kind"@en ;
    rdfs:range xsd:string ;
    skos:definition "What kind of thing the element is: action, verb, option, operand, problem-code, outcome, cli-command, mcp-tool or rest-route."@en .

kanon:familyHost a owl:DatatypeProperty ;
    rdfs:domain kanon:Family ;
    rdfs:label "family host"@en ;
    rdfs:range xsd:string ;
    skos:definition "The package of the host library of the family."@en .

kanon:how a owl:DatatypeProperty ;
    rdfs:domain kanon:TraceEdge ;
    rdfs:label "how"@en ;
    rdfs:range xsd:string ;
    skos:definition "How the one was made into the other: projects to, written as, read by."@en .

kanon:inLayer a owl:ObjectProperty ;
    rdfs:domain kanon:Element ;
    rdfs:label "in layer"@en ;
    rdfs:range kanon:Layer ;
    skos:definition "The layer an element is in."@en .

kanon:instanceFamily a owl:ObjectProperty ;
    rdfs:domain kanon:Instance ;
    rdfs:label "instance family"@en ;
    rdfs:range kanon:Family ;
    skos:definition "The family whose host declares the instance."@en .

kanon:instanceName a owl:DatatypeProperty ;
    rdfs:domain kanon:Instance ;
    rdfs:label "instance name"@en ;
    rdfs:range xsd:string ;
    skos:definition "The name of the instance, as ansible."@en .

kanon:instanceOfUnit a owl:DatatypeProperty ;
    rdfs:domain kanon:Instance ;
    rdfs:label "instance of unit"@en ;
    rdfs:range xsd:string ;
    skos:definition "The folder of the unit of which this is an instance."@en .

kanon:layerRank a owl:DatatypeProperty ;
    rdfs:domain kanon:Layer ;
    rdfs:label "layer rank"@en ;
    rdfs:range xsd:integer ;
    skos:definition "How far down the layer stands, from 1 at Governance; a higher rank imports a lower."@en .

kanon:matrixFamily a owl:ObjectProperty ;
    rdfs:domain kanon:Matrix ;
    rdfs:label "matrix family"@en ;
    rdfs:range kanon:Family ;
    skos:definition "The family whose instances are the columns of the matrix."@en .

kanon:matrixOutcome a owl:DatatypeProperty ;
    rdfs:domain kanon:Matrix ;
    rdfs:label "matrix outcome"@en ;
    rdfs:range xsd:string ;
    skos:definition "How a cell of the matrix ends: expressed, carried, unexpressed or dropped."@en .

kanon:mdaViewpoint a owl:DatatypeProperty ;
    rdfs:domain kanon:Layer ;
    rdfs:label "MDA viewpoint"@en ;
    rdfs:range xsd:string ;
    skos:definition "The viewpoint of OMG's Model Driven Architecture the layer is close to: CIM, PIM or PSM (a closeMatch, not an identity)."@en .

kanon:pluginFamily a owl:ObjectProperty ;
    rdfs:domain kanon:Plugin ;
    rdfs:label "plugin family"@en ;
    rdfs:range kanon:Family ;
    skos:definition "The family whose host declares the plugin."@en .

kanon:pluginNoun a owl:DatatypeProperty ;
    rdfs:domain kanon:Plugin ;
    rdfs:label "plugin noun"@en ;
    rdfs:range xsd:string ;
    skos:definition "The noun the plugin adds to the host's command, as server."@en .

kanon:projectsFrom a owl:ObjectProperty ;
    rdfs:domain kanon:Projection ;
    rdfs:label "projects from"@en ;
    rdfs:range kanon:Layer ;
    skos:definition "The layer the projection reads."@en .

kanon:projectsTo a owl:ObjectProperty ;
    rdfs:domain kanon:Projection ;
    rdfs:label "projects to"@en ;
    rdfs:range kanon:Layer ;
    skos:definition "The layer the projection makes."@en .

kanon:rule a owl:DatatypeProperty ;
    rdfs:domain kanon:Finding ;
    rdfs:label "rule"@en ;
    rdfs:range xsd:string ;
    skos:definition "The code of the finding: layers/unclassified, layers/relative, layers/private, layers/external, layers/above, layers/around, layers/cycle, instances/sibling, instances/undeclared, plugins/inverted, plugins/undeclared, plugins/contract, family/name or kanon/dropped."@en .

kanon:surfaceLayer a owl:ObjectProperty ;
    rdfs:domain kanon:Surface ;
    rdfs:label "surface layer"@en ;
    rdfs:range kanon:Layer ;
    skos:definition "The layer a surface is in: Physical."@en .

kanon:tracesFrom a owl:ObjectProperty ;
    rdfs:domain kanon:TraceEdge ;
    rdfs:label "traces from"@en ;
    rdfs:range kanon:Element ;
    skos:definition "The element of the layer above that the edge starts at."@en .

kanon:tracesTo a owl:ObjectProperty ;
    rdfs:domain kanon:TraceEdge ;
    rdfs:label "traces to"@en ;
    rdfs:range kanon:Element ;
    skos:definition "The element of the layer below that was made from it."@en .

<https://www.intellectualfrontiers.com/ontology/kanon> a owl:Ontology ;
    <http://purl.org/dc/terms/description> "The vocabulary of Kanon, the pattern of a library built in three layers: the layers, the elements they say, the projections that derive one from the other, the trace edges that keep identity, the surfaces, the findings of the check, the instances of a unit kind, the plugins, the families and the matrix of requirement by instance."@en ;
    rdfs:label "Kanon"@en ;
    owl:versionIRI kanonv:1.0.0 ;
