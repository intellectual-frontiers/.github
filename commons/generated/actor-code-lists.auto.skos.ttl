@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://www.intellectualfrontiers.com/ontology/actor#RoleScheme> a skos:ConceptScheme ;
    skos:prefLabel "Role"@en .

<https://www.intellectualfrontiers.com/ontology/actor#Initiator> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/actor#RoleScheme> ;
    skos:notation "Initiator" ;
    skos:prefLabel "Initiator"@en ;
    skos:definition "The person whose request, or whose standing directive, is why the act happens; an agent is never one."@en .

<https://www.intellectualfrontiers.com/ontology/actor#Preparer> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/actor#RoleScheme> ;
    skos:notation "Preparer" ;
    skos:prefLabel "Preparer"@en ;
    skos:definition "The actor that made the artifact of the act: a document, a change, a test or a plan. Any kind of actor can prepare."@en .

<https://www.intellectualfrontiers.com/ontology/actor#Assistant> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/actor#RoleScheme> ;
    skos:notation "Assistant" ;
    skos:prefLabel "Assistant"@en ;
    skos:definition "An agent or a system that operated a tool during a step of the act, under a directive and a tasking."@en .

<https://www.intellectualfrontiers.com/ontology/actor#Executor> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/actor#RoleScheme> ;
    skos:notation "Executor" ;
    skos:prefLabel "Executor"@en ;
    skos:definition "The person, or the validated mechanism, that carried the step out."@en .

<https://www.intellectualfrontiers.com/ontology/actor#Reviewer> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/actor#RoleScheme> ;
    skos:notation "Reviewer" ;
    skos:prefLabel "Reviewer"@en ;
    skos:definition "A person who read the artifact and signed that review; for a regulated act, not the person who prepared it."@en .

<https://www.intellectualfrontiers.com/ontology/actor#Approver> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/actor#RoleScheme> ;
    skos:notation "Approver" ;
    skos:prefLabel "Approver"@en ;
    skos:definition "A person whose signature, with a key of their own, bound the plan hash of the act."@en .

<https://www.intellectualfrontiers.com/ontology/actor#ActorKindScheme> a skos:ConceptScheme ;
    skos:prefLabel "ActorKind"@en .

<https://www.intellectualfrontiers.com/ontology/actor#Person> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/actor#ActorKindScheme> ;
    skos:notation "Person" ;
    skos:prefLabel "Person"@en ;
    skos:definition "A human being, who can be accountable and can sign."@en .

<https://www.intellectualfrontiers.com/ontology/actor#System> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/actor#ActorKindScheme> ;
    skos:notation "System" ;
    skos:prefLabel "System"@en ;
    skos:definition "A deterministic mechanism that a person validated: the engine, a typed verb, a pipeline."@en .

<https://www.intellectualfrontiers.com/ontology/actor#Agent> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/actor#ActorKindScheme> ;
    skos:notation "Agent" ;
    skos:prefLabel "Agent"@en ;
    skos:definition "An AI agent: a model run under instructions with tools. It is instructed, not accountable, and what it makes is a draft until a person or a validated mechanism clears it."@en .

<https://www.intellectualfrontiers.com/ontology/actor#TaskingLevelScheme> a skos:ConceptScheme ;
    skos:prefLabel "TaskingLevel"@en .

<https://www.intellectualfrontiers.com/ontology/actor#T0Suggest> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/actor#TaskingLevelScheme> ;
    skos:notation "T0Suggest" ;
    skos:prefLabel "T0, suggest"@en ;
    skos:definition "The agent only suggests; nothing it makes enters a record."@en .

<https://www.intellectualfrontiers.com/ontology/actor#T1Prepare> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/actor#TaskingLevelScheme> ;
    skos:notation "T1Prepare" ;
    skos:prefLabel "T1, prepare"@en ;
    skos:definition "The agent prepares drafts in a branch or a sandbox; a person reviews them before they enter a record."@en .

<https://www.intellectualfrontiers.com/ontology/actor#T2AssistExecution> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/actor#TaskingLevelScheme> ;
    skos:notation "T2AssistExecution" ;
    skos:prefLabel "T2, assist execution"@en ;
    skos:definition "The agent assists a step whose plan hash a person approved for each step; the engine carries it out."@en .

<https://www.intellectualfrontiers.com/ontology/actor#T3AssistReversible> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/actor#TaskingLevelScheme> ;
    skos:notation "T3AssistReversible" ;
    skos:prefLabel "T3, assist reversible steps"@en ;
    skos:definition "The agent assists reversible, low risk steps under a standing directive and a current qualification; the owner of the directive stays the initiator and the engine stays the executor."@en .

<https://www.intellectualfrontiers.com/ontology/actor#SignatureMeaningScheme> a skos:ConceptScheme ;
    skos:prefLabel "SignatureMeaning"@en .

<https://www.intellectualfrontiers.com/ontology/actor#Review> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/actor#SignatureMeaningScheme> ;
    skos:notation "Review" ;
    skos:prefLabel "Review"@en ;
    skos:definition "The signer read the record and found it fit for its purpose."@en .

<https://www.intellectualfrontiers.com/ontology/actor#Approval> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/actor#SignatureMeaningScheme> ;
    skos:notation "Approval" ;
    skos:prefLabel "Approval"@en ;
    skos:definition "The signer approved the record or the plan it names, by its hash."@en .

<https://www.intellectualfrontiers.com/ontology/actor#Responsibility> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/actor#SignatureMeaningScheme> ;
    skos:notation "Responsibility" ;
    skos:prefLabel "Responsibility"@en ;
    skos:definition "The signer takes responsibility for what the record states."@en .

<https://www.intellectualfrontiers.com/ontology/actor#Authorship> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/actor#SignatureMeaningScheme> ;
    skos:notation "Authorship" ;
    skos:prefLabel "Authorship"@en ;
    skos:definition "The signer made the record."@en .
