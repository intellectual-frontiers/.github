ifws:Action a owl:Class ;
    rdfs:label "Action"@en ;
    rdfs:subClassOf schema:Action ;
    skos:definition "One step of a plan: its kind, what it acts on and, for a skip or a refusal, why."@en .

ifws:ActionKind a owl:Class ;
    rdfs:label "Action kind"@en ;
    skos:definition "Clone, fast-forward, create a worktree, configure a repository, write or remove a generated file, install a tool, skip or refuse."@en .

ifws:Ahead a ifws:RepoState ;
    rdfs:label "ahead"@en ;
    skos:definition "The branch has commits its remote does not."@en ;
    ifws:defaultAction ifws:Skip ;
    ifws:fastForwardable false ;
    ifws:holdsLocalWork true .

ifws:Behind a ifws:RepoState ;
    rdfs:label "behind"@en ;
    skos:definition "The remote has commits the branch does not, and the branch has none of its own."@en ;
    ifws:defaultAction ifws:FastForward ;
    ifws:fastForwardable true ;
    ifws:holdsLocalWork false .

ifws:BuiltIn a ifws:ModuleSource ;
    rdfs:label "built-in"@en ;
    skos:definition "A typed module the command holds."@en ;
    ifws:precedence 1 .

ifws:ChangeRequests a ifws:GitCapability ;
    rdfs:label "change requests"@en ;
    skos:definition "A pull request (GitHub) or a merge request (GitLab), behind the interface."@en .

ifws:Clean a ifws:RepoState ;
    rdfs:label "clean"@en ;
    skos:definition "The branch equals its remote and the working tree has no change."@en ;
    ifws:defaultAction ifws:Skip ;
    ifws:fastForwardable false ;
    ifws:holdsLocalWork false .

ifws:Clone a ifws:ActionKind ;
    rdfs:label "clone"@en ;
    skos:definition "Clone a repository that is missing."@en ;
    ifws:destructive false ;
    ifws:hostChange false .

ifws:CloneUrl a ifws:GitCapability ;
    rdfs:label "clone URL"@en ;
    skos:definition "The URL a repository is cloned from, for a path of the workspace and the reverse."@en .

ifws:ConfigureHost a ifws:ActionKind ;
    rdfs:label "configure host"@en ;
    skos:definition "Change the host outside the workspace: the Windows long-path setting, the global Git include or the shell snippet; only `ifws setup` may do it."@en ;
    ifws:destructive false ;
    ifws:hostChange true .

ifws:ConfigureRepo a ifws:ActionKind ;
    rdfs:label "configure repository"@en ;
    skos:definition "Set a repository's local Git configuration: its hooks path, signing and, on Windows, long paths."@en ;
    ifws:destructive false ;
    ifws:hostChange false .

ifws:CreateWorktree a ifws:ActionKind ;
    rdfs:label "create worktree"@en ;
    skos:definition "Add a worktree of a repository for a branch."@en ;
    ifws:destructive false ;
    ifws:hostChange false .

ifws:Credentials a ifws:GitCapability ;
    rdfs:label "credentials"@en ;
    skos:definition "Authentication through a Git credential helper, the host's command-line tool or a token from the environment, never a secret stored in a file."@en .

ifws:DefaultBranch a ifws:GitCapability ;
    rdfs:label "default branch"@en ;
    skos:definition "The name of the branch the remote presents as its default."@en .

ifws:Detached a ifws:RepoState ;
    rdfs:label "detached"@en ;
    skos:definition "HEAD is on no branch."@en ;
    ifws:defaultAction ifws:Skip ;
    ifws:fastForwardable false ;
    ifws:holdsLocalWork true .

ifws:Dirty a ifws:RepoState ;
    rdfs:label "dirty"@en ;
    skos:definition "The working tree has uncommitted or untracked changes."@en ;
    ifws:defaultAction ifws:Skip ;
    ifws:fastForwardable false ;
    ifws:holdsLocalWork true .

ifws:Diverged a ifws:RepoState ;
    rdfs:label "diverged"@en ;
    skos:definition "Both the branch and its remote have commits the other lacks."@en ;
    ifws:defaultAction ifws:Skip ;
    ifws:fastForwardable false ;
    ifws:holdsLocalWork true .

ifws:Environment a ifws:ExitStatus ;
    rdfs:label "environment"@en ;
    skos:definition "The host cannot run it: a missing tool, an unwritable or absent home, an unsupported runtime."@en ;
    ifws:exitCode 3 .

ifws:Error a ifws:Severity ;
    rdfs:label "error"@en ;
    skos:definition "Wrong now; a run that has one exits with findings and a plan does not act on what it names."@en ;
    ifws:sarifLevel "error" .

ifws:ExitStatus a owl:Class ;
    rdfs:label "Exit status"@en ;
    skos:definition "What a run exits with: 0 ok, 1 findings, 2 usage, 3 environment."@en .

ifws:FastForward a ifws:ActionKind ;
    rdfs:label "fast-forward"@en ;
    skos:definition "Move a branch that is behind its remote forward, with no merge, rebase or reset."@en ;
    ifws:destructive false ;
    ifws:hostChange false .

ifws:Finding a owl:Class ;
    rdfs:label "Finding"@en ;
    skos:definition "What a check reports: the rule, a severity, what it is about and the day it was first seen; it is written as a SARIF result."@en .

ifws:Findings a ifws:ExitStatus ;
    rdfs:label "findings"@en ;
    skos:definition "The run ended and has at least one warning or error."@en ;
    ifws:exitCode 1 .

ifws:GeneratedFile a owl:Class ;
    rdfs:label "Generated file"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "A file a typed template makes inside the workspace, named `.auto.`, with a header that names its generator, never edited by hand."@en .

ifws:Git a ifws:GitManagerKind ;
    rdfs:label "plain Git"@en ;
    skos:definition "Any other Git remote: what Git itself offers and nothing a host adds."@en ;
    ifws:supports ifws:CloneUrl,
        ifws:Credentials,
        ifws:DefaultBranch,
        ifws:SignedCommits .

ifws:GitCapability a owl:Class ;
    rdfs:label "Git capability"@en ;
    skos:definition "One thing a Git manager may offer through the interface."@en .

ifws:GitManager a owl:Class ;
    rdfs:label "Git manager"@en ;
    skos:definition "The one interface to a Git host: its clone URL, credentials, default branch, protected branches, issues, change requests and signed commits, with `unsupported` where a host lacks one."@en .

ifws:GitManagerKind a owl:Class ;
    rdfs:label "Git manager kind"@en ;
    skos:definition "GitHub, GitLab or plain Git, with the capabilities each supports."@en .

ifws:Github a ifws:GitManagerKind ;
    rdfs:label "GitHub"@en ;
    skos:definition "GitHub, public and private repositories: an owner and a repository."@en ;
    ifws:supports ifws:ChangeRequests,
        ifws:CloneUrl,
        ifws:Credentials,
        ifws:DefaultBranch,
        ifws:Issues,
        ifws:ProtectedBranches,
        ifws:SignedCommits .

ifws:Gitlab a ifws:GitManagerKind ;
    rdfs:label "GitLab"@en ;
    skos:definition "GitLab, public and private repositories, in groups to any depth."@en ;
    ifws:supports ifws:ChangeRequests,
        ifws:CloneUrl,
        ifws:Credentials,
        ifws:DefaultBranch,
        ifws:Issues,
        ifws:NestedGroups,
        ifws:ProtectedBranches,
        ifws:SignedCommits .

ifws:Informational a ifws:Severity ;
    rdfs:label "informational"@en ;
    skos:definition "To be known, never failing a run."@en ;
    ifws:sarifLevel "note" .

ifws:InstallTool a ifws:ActionKind ;
    rdfs:label "install tool"@en ;
    skos:definition "Install a pinned artifact of the tool catalog into the workspace's tool store; only `ifws setup` may do it."@en ;
    ifws:destructive false ;
    ifws:hostChange true .

ifws:Issues a ifws:GitCapability ;
    rdfs:label "issues"@en ;
    skos:definition "Issues of the repository, behind the interface."@en .

ifws:Locked a ifws:RepoState ;
    rdfs:label "locked"@en ;
    skos:definition "A Git lock file is present: another process may be working in the repository."@en ;
    ifws:defaultAction ifws:Skip ;
    ifws:fastForwardable false ;
    ifws:holdsLocalWork true .

ifws:Missing a ifws:RepoState ;
    rdfs:label "missing"@en ;
    skos:definition "Nothing is at the repository's path."@en ;
    ifws:defaultAction ifws:Clone ;
    ifws:fastForwardable false ;
    ifws:holdsLocalWork false .

ifws:Module a owl:Class ;
    rdfs:label "Module"@en ;
    rdfs:subClassOf schema:SoftwareApplication ;
    skos:definition "A part of the command, `ifws-<name>`: built in, registered by the workspace or an executable on the path."@en .

ifws:ModuleSource a owl:Class ;
    rdfs:label "Module source"@en ;
    skos:definition "Built-in, registered or on the path, in the order a module is looked for."@en .

ifws:NestedGroups a ifws:GitCapability ;
    rdfs:label "nested groups"@en ;
    skos:definition "Groups to any depth between the host and the repository (GitLab); a host without them has one owner level."@en .

ifws:NotARepo a ifws:RepoState ;
    rdfs:label "not a repository"@en ;
    skos:definition "Something other than a Git repository is at the path."@en ;
    ifws:defaultAction ifws:Refuse ;
    ifws:fastForwardable false ;
    ifws:holdsLocalWork true .

ifws:Ok a ifws:ExitStatus ;
    rdfs:label "ok"@en ;
    skos:definition "The run did what was asked and has no warning or error."@en ;
    ifws:exitCode 0 .

ifws:Path a ifws:ModuleSource ;
    rdfs:label "on the path"@en ;
    skos:definition "An executable named `ifws-*` on the `PATH`, like Git's `git-foo`."@en ;
    ifws:precedence 3 .

ifws:Plan a owl:Class ;
    rdfs:label "Plan"@en ;
    rdfs:subClassOf prov:Plan ;
    skos:definition "The actions that would bring the workspace from its observed state to the one its manifest states; making it changes nothing."@en .

ifws:ProtectedBranches a ifws:GitCapability ;
    rdfs:label "protected branches"@en ;
    skos:definition "Whether a branch can be asked about as protected: no push, no force, review required."@en .

ifws:Refuse a ifws:ActionKind ;
    rdfs:label "refuse"@en ;
    skos:definition "Do nothing because doing it would not be safe, and say why."@en ;
    ifws:destructive false ;
    ifws:hostChange false .

ifws:Registered a ifws:ModuleSource ;
    rdfs:label "registered"@en ;
    skos:definition "A module the workspace names in `modules.auto.json`."@en ;
    ifws:precedence 2 .

ifws:RemoveGenerated a ifws:ActionKind ;
    rdfs:label "remove generated file"@en ;
    skos:definition "Remove a generated file that the state record holds and nobody edited."@en ;
    ifws:destructive true ;
    ifws:hostChange false .

ifws:RepoObservation a owl:Class ;
    rdfs:label "Repository observation"@en ;
    skos:definition "The state of one repository at a time: its state, how many commits it is ahead or behind and how many stashes it holds."@en .

ifws:RepoState a owl:Class ;
    rdfs:label "Repository state"@en ;
    skos:definition "Missing, clean, dirty, ahead, behind, diverged, locked, detached, on the wrong remote or not a repository."@en .

ifws:Repository a owl:Class ;
    rdfs:label "Repository"@en ;
    skos:definition "A Git repository cloned into the workspace at the path that mirrors its remote URL."@en .

ifws:Setup a owl:Class ;
    rdfs:label "Setup"@en ;
    rdfs:subClassOf prov:Activity ;
    skos:definition "The one run that may install a pinned tool or change the host: its plan, and whether it was applied or only shown."@en .

ifws:Severity a owl:Class ;
    rdfs:label "Severity"@en ;
    skos:definition "Informational, warning or error, each with the SARIF level it is written as."@en .

ifws:SignedCommits a ifws:GitCapability ;
    rdfs:label "signed commits"@en ;
    skos:definition "Whether a commit's signature, OpenPGP or SSH, can be seen as verified."@en .

ifws:Skip a ifws:ActionKind ;
    rdfs:label "skip"@en ;
    skos:definition "Do nothing, and say why."@en ;
    ifws:destructive false ;
    ifws:hostChange false .

ifws:StateRecord a owl:Class ;
    rdfs:label "State record"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "The record of what the last run wrote: the hash of each generated file, the last plan and the day each unapproved tool or module was first seen."@en .

ifws:Tool a owl:Class ;
    rdfs:label "Tool"@en ;
    rdfs:subClassOf schema:SoftwareApplication ;
    skos:definition "A program the workspace may use: its name, version and, for one operating system and architecture, the artifact's URL and SHA-256."@en .

ifws:ToolCatalog a owl:Class ;
    rdfs:label "Tool catalog"@en ;
    rdfs:subClassOf dcat:Catalog ;
    skos:definition "The tools a workspace approves, each pinned to a version and a hash; a tool outside it is a finding."@en .

ifws:Usage a ifws:ExitStatus ;
    rdfs:label "usage"@en ;
    skos:definition "The command line is wrong: an unknown command, option or argument."@en ;
    ifws:exitCode 2 .

ifws:Warning a ifws:Severity ;
    rdfs:label "warning"@en ;
    skos:definition "To be fixed; a run that has one exits with findings."@en ;
    ifws:sarifLevel "warning" .

ifws:Workspace a owl:Class ;
    rdfs:label "Workspace"@en ;
    skos:definition "The one root folder of Intellectual Frontiers Workspaces: the repositories, worktrees, tools, policy and generated files under it, and nothing outside it."@en .

ifws:WorkspacePolicy a owl:Class ;
    rdfs:label "Workspace policy"@en ;
    skos:definition "What the workspace requires: signed commits, the regulated domain it claims, the days an unapproved tool or module is only informational and the Git hosts it allows."@en .

ifws:WorkspaceState a owl:Class ;
    rdfs:label "Workspace state"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "What was observed of the workspace on one day: the observation of each of its repositories."@en .

ifws:Worktree a owl:Class ;
    rdfs:label "Worktree"@en ;
    skos:definition "A Git worktree of a repository, made for one branch when another person or agent, or uncommitted work, is on the repository."@en .

ifws:WriteGenerated a ifws:ActionKind ;
    rdfs:label "write generated file"@en ;
    skos:definition "Write a generated file inside the workspace."@en ;
    ifws:destructive false ;
    ifws:hostChange false .

ifws:WrongRemote a ifws:RepoState ;
    rdfs:label "wrong remote"@en ;
    skos:definition "The repository at the path has a remote other than the one the manifest names."@en ;
    ifws:defaultAction ifws:Refuse ;
    ifws:fastForwardable false ;
    ifws:holdsLocalWork true .

ifws:actionKind a owl:ObjectProperty ;
    rdfs:domain ifws:Action ;
    rdfs:label "action kind"@en ;
    rdfs:range ifws:ActionKind ;
    skos:definition "The kind of action."@en .

ifws:actionReason a owl:DatatypeProperty ;
    rdfs:domain ifws:Action ;
    rdfs:label "action reason"@en ;
    rdfs:range xsd:string ;
    skos:definition "Why a step is skipped or refused."@en .

ifws:actionTarget a owl:DatatypeProperty ;
    rdfs:domain ifws:Action ;
    rdfs:label "action target"@en ;
    rdfs:range xsd:string ;
    skos:definition "What the action acts on: a path under the root, or a tool's name and version."@en .

ifws:aheadBy a owl:DatatypeProperty ;
    rdfs:domain ifws:RepoObservation ;
    rdfs:label "ahead by"@en ;
    rdfs:range xsd:integer ;
    skos:definition "The commits the branch has that its remote does not."@en .

ifws:allowedGitHost a owl:DatatypeProperty ;
    rdfs:domain ifws:WorkspacePolicy ;
    rdfs:label "allowed git host"@en ;
    rdfs:range xsd:string ;
    skos:definition "A Git host a repository may be cloned from; with none, any."@en .

ifws:applied a owl:DatatypeProperty ;
    rdfs:domain ifws:Setup ;
    rdfs:label "applied"@en ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether the setup changed anything; false for a dry run, which is the default."@en .

ifws:behindBy a owl:DatatypeProperty ;
    rdfs:domain ifws:RepoObservation ;
    rdfs:label "behind by"@en ;
    rdfs:range xsd:integer ;
    skos:definition "The commits the remote has that the branch does not."@en .

ifws:branchSlug a owl:DatatypeProperty ;
    rdfs:domain ifws:Worktree ;
    rdfs:label "branch slug"@en ;
    rdfs:range xsd:string ;
    skos:definition "The branch's name made into one portable path segment: the last segment of the worktree's path."@en .

ifws:catalogs a owl:ObjectProperty ;
    rdfs:domain ifws:ToolCatalog ;
    rdfs:label "catalogs"@en ;
    rdfs:range ifws:Tool ;
    skos:definition "A tool the catalog approves."@en .

ifws:contentSha256 a owl:DatatypeProperty ;
    rdfs:domain ifws:GeneratedFile ;
    rdfs:label "content sha256"@en ;
    rdfs:range xsd:string ;
    skos:definition "The SHA-256 of the bytes written, in lower-case hexadecimal."@en .

ifws:defaultAction a owl:ObjectProperty ;
    rdfs:domain ifws:RepoState ;
    rdfs:label "default action"@en ;
    rdfs:range ifws:ActionKind ;
    skos:definition "The kind of action a plan holds for a repository in this state, before a policy changes it."@en .

ifws:defaultBranch a owl:DatatypeProperty ;
    rdfs:domain ifws:Repository ;
    rdfs:label "default branch"@en ;
    rdfs:range xsd:string ;
    skos:definition "The branch the remote presents as its default."@en .

ifws:destructive a owl:DatatypeProperty ;
    rdfs:domain ifws:ActionKind ;
    rdfs:label "destructive"@en ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether the kind removes what exists: it runs only when asked for, and a dry run shows it first."@en .

ifws:exitCode a owl:DatatypeProperty ;
    rdfs:domain ifws:ExitStatus ;
    rdfs:label "exit code"@en ;
    rdfs:range xsd:integer ;
    skos:definition "The number the process exits with."@en .

ifws:fastForwardable a owl:DatatypeProperty ;
    rdfs:domain ifws:RepoState ;
    rdfs:label "fast forwardable"@en ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether a plan may hold a fast-forward of a repository in this state: only where the branch is behind and holds nothing of its own."@en .

ifws:fileMode a owl:DatatypeProperty ;
    rdfs:domain ifws:GeneratedFile ;
    rdfs:label "file mode"@en ;
    rdfs:range xsd:string ;
    skos:definition "The mode the file is written with: 0644 or, for a script, 0755."@en .

ifws:firstSeenOn a owl:DatatypeProperty ;
    rdfs:domain ifws:Finding ;
    rdfs:label "first seen on"@en ;
    rdfs:range xsd:string ;
    skos:definition "The day (YYYY-MM-DD) the finding was first seen, from which an informational finding turns into a warning."@en .

ifws:generatedBy a owl:DatatypeProperty ;
    rdfs:domain ifws:GeneratedFile ;
    rdfs:label "generated by"@en ;
    rdfs:range xsd:string ;
    skos:definition "The template that made it, by name."@en .

ifws:generatedPath a owl:DatatypeProperty ;
    rdfs:domain ifws:GeneratedFile ;
    rdfs:label "generated path"@en ;
    rdfs:range xsd:string ;
    skos:definition "The file's path under the root, `/`-separated, with `.auto.` in its name."@en .

ifws:gitHost a owl:DatatypeProperty ;
    rdfs:domain ifws:Repository ;
    rdfs:label "git host"@en ;
    rdfs:range xsd:string ;
    skos:definition "The name of the Git host, in lower case, the first segment of the repository's path."@en .

ifws:governedBy a owl:ObjectProperty ;
    rdfs:domain ifws:Workspace ;
    rdfs:label "governed by"@en ;
    rdfs:range ifws:WorkspacePolicy ;
    skos:definition "The policy the workspace is held to."@en .

ifws:hasAction a owl:ObjectProperty ;
    rdfs:domain ifws:Plan ;
    rdfs:label "has action"@en ;
    rdfs:range ifws:Action ;
    skos:definition "A step of the plan, in order."@en .

ifws:hasObservation a owl:ObjectProperty ;
    rdfs:domain ifws:WorkspaceState ;
    rdfs:label "has observation"@en ;
    rdfs:range ifws:RepoObservation ;
    skos:definition "The observation of one repository."@en .

ifws:hasRepository a owl:ObjectProperty ;
    rdfs:domain ifws:Workspace ;
    rdfs:label "has repository"@en ;
    rdfs:range ifws:Repository ;
    skos:definition "A repository of the workspace."@en .

ifws:holdsLocalWork a owl:DatatypeProperty ;
    rdfs:domain ifws:RepoState ;
    rdfs:label "holds local work"@en ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether the folder may hold work that exists nowhere else, so that nothing may remove it; true wherever it is not known to be clean."@en .

ifws:hostChange a owl:DatatypeProperty ;
    rdfs:domain ifws:ActionKind ;
    rdfs:label "host change"@en ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether the kind changes the host outside the workspace's own files: only `ifws setup` may carry it out."@en .

ifws:inState a owl:ObjectProperty ;
    rdfs:domain ifws:RepoObservation ;
    rdfs:label "in state"@en ;
    rdfs:range ifws:RepoState ;
    skos:definition "The state the repository was in."@en .

ifws:installs a owl:ObjectProperty ;
    rdfs:domain ifws:Setup ;
    rdfs:label "installs"@en ;
    rdfs:range ifws:Tool ;
    skos:definition "A tool the setup installed."@en .

ifws:lastPlan a owl:ObjectProperty ;
    rdfs:domain ifws:StateRecord ;
    rdfs:label "last plan"@en ;
    rdfs:range ifws:Plan ;
    skos:definition "The plan of the last run that wrote."@en .

ifws:managedBy a owl:ObjectProperty ;
    rdfs:domain ifws:Repository ;
    rdfs:label "managed by"@en ;
    rdfs:range ifws:GitManager ;
    skos:definition "The Git manager that serves the repository's host."@en .

ifws:managerHost a owl:DatatypeProperty ;
    rdfs:domain ifws:GitManager ;
    rdfs:label "manager host"@en ;
    rdfs:range xsd:string ;
    skos:definition "The host name the manager serves, `github.com` or a host a manifest names."@en .

ifws:managerKind a owl:ObjectProperty ;
    rdfs:domain ifws:GitManager ;
    rdfs:label "manager kind"@en ;
    rdfs:range ifws:GitManagerKind ;
    skos:definition "GitHub, GitLab or plain Git."@en .

ifws:message a owl:DatatypeProperty ;
    rdfs:domain ifws:Finding ;
    rdfs:label "message"@en ;
    rdfs:range xsd:string ;
    skos:definition "One sentence saying what is wrong and what to do."@en .

ifws:moduleName a owl:DatatypeProperty ;
    rdfs:domain ifws:Module ;
    rdfs:label "module name"@en ;
    rdfs:range xsd:string ;
    skos:definition "The module's name, the part after `ifws-`: lower-case letters, digits and hyphens."@en .

ifws:moduleSource a owl:ObjectProperty ;
    rdfs:domain ifws:Module ;
    rdfs:label "module source"@en ;
    rdfs:range ifws:ModuleSource ;
    skos:definition "Where the module was found."@en .

ifws:moduleSummary a owl:DatatypeProperty ;
    rdfs:domain ifws:Module ;
    rdfs:label "module summary"@en ;
    rdfs:range xsd:string ;
    skos:definition "One line saying what the module does."@en .

ifws:observationOf a owl:ObjectProperty ;
    rdfs:domain ifws:RepoObservation ;
    rdfs:label "observation of"@en ;
    rdfs:range ifws:Repository ;
    skos:definition "The repository observed."@en .

ifws:observedAt a owl:DatatypeProperty ;
    rdfs:domain ifws:WorkspaceState ;
    rdfs:label "observed at"@en ;
    rdfs:range xsd:string ;
    skos:definition "The day (YYYY-MM-DD) of the observation."@en .

ifws:plannedFor a owl:ObjectProperty ;
    rdfs:domain ifws:Plan ;
    rdfs:label "planned for"@en ;
    rdfs:range ifws:Workspace ;
    skos:definition "The workspace the plan is for."@en .

ifws:precedence a owl:DatatypeProperty ;
    rdfs:domain ifws:ModuleSource ;
    rdfs:label "precedence"@en ;
    rdfs:range xsd:integer ;
    skos:definition "The order the source is looked in: the lowest first."@en .

ifws:provides a owl:DatatypeProperty ;
    rdfs:domain ifws:Tool ;
    rdfs:label "provides"@en ;
    rdfs:range xsd:string ;
    skos:definition "A command or a capability the tool provides."@en .

ifws:recordsFile a owl:ObjectProperty ;
    rdfs:domain ifws:StateRecord ;
    rdfs:label "records file"@en ;
    rdfs:range ifws:GeneratedFile ;
    skos:definition "A generated file the record holds the hash of."@en .

ifws:regulatedDomain a owl:DatatypeProperty ;
    rdfs:domain ifws:WorkspacePolicy ;
    rdfs:label "regulated domain"@en ;
    rdfs:range xsd:string ;
    skos:definition "A regulated domain the workspace claims, such as the one of the FDA's QMSR."@en .

ifws:remoteUrl a owl:DatatypeProperty ;
    rdfs:domain ifws:Repository ;
    rdfs:label "remote url"@en ;
    rdfs:range xsd:string ;
    skos:definition "The URL the repository is cloned from."@en .

ifws:repoPath a owl:DatatypeProperty ;
    rdfs:domain ifws:Repository ;
    rdfs:label "repo path"@en ;
    rdfs:range xsd:string ;
    skos:definition "The repository's path under the root, `/`-separated: the Git host, the path of the remote and the repository."@en .

ifws:requiresSignedCommits a owl:DatatypeProperty ;
    rdfs:domain ifws:WorkspacePolicy ;
    rdfs:label "requires signed commits"@en ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether a commit that is not signed and verified is an error; true for a regulated domain."@en .

ifws:ruleId a owl:DatatypeProperty ;
    rdfs:domain ifws:Finding ;
    rdfs:label "rule id"@en ;
    rdfs:range xsd:string ;
    skos:definition "The identifier of the rule that found it, `ifws/` and a name: the SARIF `ruleId`."@en .

ifws:sarifLevel a owl:DatatypeProperty ;
    rdfs:domain ifws:Severity ;
    rdfs:label "sarif level"@en ;
    rdfs:range xsd:string ;
    skos:definition "The SARIF `level` the severity is written as: note, warning or error."@en .

ifws:setupPlan a owl:ObjectProperty ;
    rdfs:domain ifws:Setup ;
    rdfs:label "setup plan"@en ;
    rdfs:range ifws:Plan ;
    skos:definition "The plan the setup showed, and carried out where it was applied."@en .

ifws:severity a owl:ObjectProperty ;
    rdfs:domain ifws:Finding ;
    rdfs:label "severity"@en ;
    rdfs:range ifws:Severity ;
    skos:definition "How serious the finding is."@en .

ifws:stashCount a owl:DatatypeProperty ;
    rdfs:domain ifws:RepoObservation ;
    rdfs:label "stash count"@en ;
    rdfs:range xsd:integer ;
    skos:definition "The entries of the repository's stash."@en .

ifws:subject a owl:DatatypeProperty ;
    rdfs:domain ifws:Finding ;
    rdfs:label "subject"@en ;
    rdfs:range xsd:string ;
    skos:definition "What the finding is about: a path under the root, a tool or a module."@en .

ifws:supports a owl:ObjectProperty ;
    rdfs:domain ifws:GitManagerKind ;
    rdfs:label "supports"@en ;
    rdfs:range ifws:GitCapability ;
    skos:definition "A capability the kind of Git manager supports; one it does not list is unsupported."@en .

ifws:toolArch a owl:DatatypeProperty ;
    rdfs:domain ifws:Tool ;
    rdfs:label "tool arch"@en ;
    rdfs:range xsd:string ;
    skos:definition "The processor architecture the artifact is for: x64 or arm64."@en .

ifws:toolName a owl:DatatypeProperty ;
    rdfs:domain ifws:Tool ;
    rdfs:label "tool name"@en ;
    rdfs:range xsd:string ;
    skos:definition "The tool's name."@en .

ifws:toolOs a owl:DatatypeProperty ;
    rdfs:domain ifws:Tool ;
    rdfs:label "tool os"@en ;
    rdfs:range xsd:string ;
    skos:definition "The operating system the artifact is for: linux, macos or windows."@en .

ifws:toolSha256 a owl:DatatypeProperty ;
    rdfs:domain ifws:Tool ;
    rdfs:label "tool sha256"@en ;
    rdfs:range xsd:string ;
    skos:definition "The SHA-256 of the artifact, in lower-case hexadecimal."@en .

ifws:toolUrl a owl:DatatypeProperty ;
    rdfs:domain ifws:Tool ;
    rdfs:label "tool url"@en ;
    rdfs:range xsd:string ;
    skos:definition "The `https` URL the artifact is fetched from."@en .

ifws:toolVersion a owl:DatatypeProperty ;
    rdfs:domain ifws:Tool ;
    rdfs:label "tool version"@en ;
    rdfs:range xsd:string ;
    skos:definition "The one version pinned, never `latest` and never a range."@en .

ifws:unapprovedGraceDays a owl:DatatypeProperty ;
    rdfs:domain ifws:WorkspacePolicy ;
    rdfs:label "unapproved grace days"@en ;
    rdfs:range xsd:integer ;
    skos:definition "The days a tool or module outside the catalog is informational, counted from the day it was first seen; 90 unless the policy lowers it."@en .

ifws:usesCatalog a owl:ObjectProperty ;
    rdfs:domain ifws:Workspace ;
    rdfs:label "uses catalog"@en ;
    rdfs:range ifws:ToolCatalog ;
    skos:definition "The catalog of tools the workspace approves."@en .

ifws:workspaceHome a owl:DatatypeProperty ;
    rdfs:domain ifws:Workspace ;
    rdfs:label "workspace home"@en ;
    rdfs:range xsd:string ;
    skos:definition "The workspace's root folder, as `$IFC_WORKSPACES_HOME` or `--home` gives it."@en .

ifws:worktreeOf a owl:ObjectProperty ;
    rdfs:domain ifws:Worktree ;
    rdfs:label "worktree of"@en ;
    rdfs:range ifws:Repository ;
    skos:definition "The repository the worktree is of."@en .

<https://www.intellectualfrontiers.com/ontology/ifws> a owl:Ontology ;
    dcterms:description "The vocabulary of Intellectual Frontiers Workspaces: the workspace and its repositories, Git managers, tools, policy, plans, findings, generated files and modules."@en ;
    rdfs:label "Intellectual Frontiers Workspaces"@en ;
    owl:versionIRI ifwsv:1 ;
    owl:versionInfo "1" .
