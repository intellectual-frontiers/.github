    mz:definedBy "0023-if-workspaces FR-032" ;
    mz:justification "ODRL's Policy is a set of permissions, prohibitions and duties; the workspace policy also carries a severity and a grace period for each rule, so it is a close match and not a subclass" ;
    mz:mappingRelation "closeMatch" ;
    mz:standardTerm "http://www.w3.org/ns/odrl/2/Policy" ;
    mz:termIri "https://www.intellectualfrontiers.com/ontology/ifws#WorkspacePolicy" .

