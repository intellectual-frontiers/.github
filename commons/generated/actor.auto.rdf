  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/id/mizan/term-actor-TaskingLevel">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#OntologyTerm"/>
    <rdfs:label xml:lang="en">act:TaskingLevel</rdfs:label>
    <mz:basis rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Specializes"/>
    <mz:definedBy>0048-actors FR-040</mz:definedBy>
    <mz:mappingRelation>subClassOf</mz:mappingRelation>
    <mz:standardTerm>http://www.w3.org/2004/02/skos/core#Concept</mz:standardTerm>
    <mz:termIri>https://www.intellectualfrontiers.com/ontology/actor#TaskingLevel</mz:termIri>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#Act">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Act</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <skos:definition xml:lang="en">One act of a regulated flow: a step that changes a record or a system, with the actors that held a role in it and the directive it was done under.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#Actor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Actor</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Agent"/>
    <skos:definition xml:lang="en">A person, a system or an agent that takes part in an act. In PROV it is an agent; here the word agent is kept for the AI case.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#ActorKind">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Kind of actor</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">One of the three kinds of actor: a person, a system or an agent.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#Agent">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/actor#ActorKind"/>
    <rdfs:label xml:lang="en">Agent</rdfs:label>
    <skos:definition xml:lang="en">An AI agent: a model run under instructions with tools. It is instructed, not accountable, and what it makes is a draft until a person or a validated mechanism clears it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#Approval">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/actor#SignatureMeaning"/>
    <rdfs:label xml:lang="en">Approval</rdfs:label>
    <skos:definition xml:lang="en">The signer approved the record or the plan it names, by its hash.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#Approver">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/actor#Role"/>
    <rdfs:label xml:lang="en">Approver</rdfs:label>
    <skos:definition xml:lang="en">A person whose signature, with a key of their own, bound the plan hash of the act.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#Assistant">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/actor#Role"/>
    <rdfs:label xml:lang="en">Assistant</rdfs:label>
    <skos:definition xml:lang="en">An agent or a system that operated a tool during a step of the act, under a directive and a tasking.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#Authorship">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/actor#SignatureMeaning"/>
    <rdfs:label xml:lang="en">Authorship</rdfs:label>
    <skos:definition xml:lang="en">The signer made the record.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#Directive">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Directive</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">A controlled instruction an act is done under: a work order, a specification, a procedure or a person's request kept by its digest, with an owner who is a person and a version.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#Executor">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/actor#Role"/>
    <rdfs:label xml:lang="en">Executor</rdfs:label>
    <skos:definition xml:lang="en">The person, or the validated mechanism, that carried the step out.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#Initiator">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/actor#Role"/>
    <rdfs:label xml:lang="en">Initiator</rdfs:label>
    <skos:definition xml:lang="en">The person whose request, or whose standing directive, is why the act happens; an agent is never one.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#NonconformityRule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Nonconformity rule</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">One of the rules whose breach by an act is recorded as a nonconformance of the quality ontology.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#OutsideTasking">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/actor#NonconformityRule"/>
    <rdfs:label xml:lang="en">Outside tasking</rdfs:label>
    <skos:definition xml:lang="en">An agent acted beyond the scope, level or expiry of its tasking, or after it was revoked.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#Person">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/actor#ActorKind"/>
    <rdfs:label xml:lang="en">Person</rdfs:label>
    <skos:definition xml:lang="en">A human being, who can be accountable and can sign.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#Preparer">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/actor#Role"/>
    <rdfs:label xml:lang="en">Preparer</rdfs:label>
    <skos:definition xml:lang="en">The actor that made the artifact of the act: a document, a change, a test or a plan. Any kind of actor can prepare.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#Qualification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Qualification</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">The record that an agent configuration (model and version, instruction set digest, tool permissions) was shown fit for a use, with its evidence, its validity and the changes that require it to be redone.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#RegulatedVerbRefused">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/actor#NonconformityRule"/>
    <rdfs:label xml:lang="en">Regulated verb refused</rdfs:label>
    <skos:definition xml:lang="en">An agent asked for a verb that changes a regulated record or a system, and it was refused.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#Responsibility">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/actor#SignatureMeaning"/>
    <rdfs:label xml:lang="en">Responsibility</rdfs:label>
    <skos:definition xml:lang="en">The signer takes responsibility for what the record states.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#Review">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/actor#SignatureMeaning"/>
    <rdfs:label xml:lang="en">Review</rdfs:label>
    <skos:definition xml:lang="en">The signer read the record and found it fit for its purpose.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#ReviewCanary">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Review canary</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">A defect seeded into an artifact, so that whether a review catches it measures whether the review is real.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#ReviewSkipped">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/actor#NonconformityRule"/>
    <rdfs:label xml:lang="en">Review skipped</rdfs:label>
    <skos:definition xml:lang="en">Prepared content entered a record with no signed review and no deterministic reproduction.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#ReviewedByPreparer">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/actor#NonconformityRule"/>
    <rdfs:label xml:lang="en">Reviewed by the preparer</rdfs:label>
    <skos:definition xml:lang="en">A regulated act was reviewed by its preparer, or by the person who tasked the agent that prepared it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#Reviewer">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/actor#Role"/>
    <rdfs:label xml:lang="en">Reviewer</rdfs:label>
    <skos:definition xml:lang="en">A person who read the artifact and signed that review; for a regulated act, not the person who prepared it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#Role">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Role</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">One of the roles an actor holds in an act.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#SignatureMeaning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Signature meaning</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">What a signature of a regulated record means: review, approval, responsibility or authorship.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#System">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/actor#ActorKind"/>
    <rdfs:label xml:lang="en">System</rdfs:label>
    <skos:definition xml:lang="en">A deterministic mechanism that a person validated: the engine, a typed verb, a pipeline.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#T0Suggest">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/actor#TaskingLevel"/>
    <rdfs:label xml:lang="en">T0, suggest</rdfs:label>
    <skos:definition xml:lang="en">The agent only suggests; nothing it makes enters a record.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#T1Prepare">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/actor#TaskingLevel"/>
    <rdfs:label xml:lang="en">T1, prepare</rdfs:label>
    <skos:definition xml:lang="en">The agent prepares drafts in a branch or a sandbox; a person reviews them before they enter a record.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#T2AssistExecution">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/actor#TaskingLevel"/>
    <rdfs:label xml:lang="en">T2, assist execution</rdfs:label>
    <skos:definition xml:lang="en">The agent assists a step whose plan hash a person approved for each step; the engine carries it out.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#T3AssistReversible">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/actor#TaskingLevel"/>
    <rdfs:label xml:lang="en">T3, assist reversible steps</rdfs:label>
    <skos:definition xml:lang="en">The agent assists reversible, low risk steps under a standing directive and a current qualification; the owner of the directive stays the initiator and the engine stays the executor.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#Tasking">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Tasking</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">A person's signed authority to use an agent configuration within a scope, at a level, until an expiry; the person keeps the initiative and the accountability, and the tasking can be revoked.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#TaskingLevel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Tasking level</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">One of the four levels at which an agent may be tasked.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#Undirected">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/actor#NonconformityRule"/>
    <rdfs:label xml:lang="en">Undirected</rdfs:label>
    <skos:definition xml:lang="en">An agent acted with no directive on record.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#Unqualified">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/actor#NonconformityRule"/>
    <rdfs:label xml:lang="en">Unqualified</rdfs:label>
    <skos:definition xml:lang="en">An agent configuration with no current qualification was used where one is required.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#VocabularyBreach">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/actor#NonconformityRule"/>
    <rdfs:label xml:lang="en">Vocabulary breach</rdfs:label>
    <skos:definition xml:lang="en">A record named an agent as the initiator, the one who completed, approved or signed an act.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#approvedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/actor#Act"/>
    <rdfs:label xml:lang="en">approved by</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/actor#Actor"/>
    <skos:definition xml:lang="en">The person whose signature bound the plan hash of the act.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#assistedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/actor#Act"/>
    <rdfs:label xml:lang="en">assisted by</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/actor#Actor"/>
    <skos:definition xml:lang="en">The agent or system that operated a tool during a step of the act.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#brokeRule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/actor#Act"/>
    <rdfs:label xml:lang="en">broke rule</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/actor#NonconformityRule"/>
    <skos:definition xml:lang="en">The rule of the specification of actors that the act did not meet.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#directiveDigest">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/actor#Directive"/>
    <rdfs:label xml:lang="en">directive digest</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The digest of the directive's text, so that the instruction an act followed can be checked.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#executedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/actor#Act"/>
    <rdfs:label xml:lang="en">executed by</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/actor#Actor"/>
    <skos:definition xml:lang="en">The person or validated mechanism that carried the step out.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#initiatedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/actor#Act"/>
    <rdfs:label xml:lang="en">initiated by</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/actor#Actor"/>
    <skos:definition xml:lang="en">The person whose request or standing directive is why the act happens.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#preparedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/actor#Act"/>
    <rdfs:label xml:lang="en">prepared by</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/actor#Actor"/>
    <skos:definition xml:lang="en">The actor that made the artifact of the act.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#reviewedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/actor#Act"/>
    <rdfs:label xml:lang="en">reviewed by</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/actor#Actor"/>
    <skos:definition xml:lang="en">The person who read the artifact and signed a review.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor#underDirective">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/actor#Act"/>
    <rdfs:label xml:lang="en">under directive</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/actor#Directive"/>
    <skos:definition xml:lang="en">The directive the act was done under.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/actor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <ns1:description xml:lang="en">The vocabulary of Actors: the act and the actor that takes part in it, the roles, the directive, the tasking, the qualification, the nonconformity and the meanings of a signature.</ns1:description>
    <rdfs:label xml:lang="en">Actors</rdfs:label>
    <owl:versionIRI rdf:resource="https://www.intellectualfrontiers.com/ontology/actor/1.0.0"/>
    <owl:versionInfo>1.0.0</owl:versionInfo>
  </rdf:Description>
</rdf:RDF>
