  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#AcceptableRanges">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#Dimension"/>
    <rdfs:label xml:lang="en">Acceptable ranges of behavior</rdfs:label>
    <skos:definition xml:lang="en">Whether the behavior stays within the range defined as acceptable, not only correct.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#AcceptanceRun">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Acceptance run</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#TestRun"/>
    <skos:definition xml:lang="en">A run of Operational Acceptance Testing: a test run that says what was expected, what was observed and which dimension it tested.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#AiNativeContinuouslyVerified">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#MaturityLevel"/>
    <rdfs:label xml:lang="en">AI-native and continuously verified</rdfs:label>
    <skos:definition xml:lang="en">Full operational truth with AI systems grounded in verified evidence.</skos:definition>
    <oto:levelNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</oto:levelNumber>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#Aligned">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#AlignmentState"/>
    <rdfs:label xml:lang="en">aligned</rdfs:label>
    <skos:definition xml:lang="en">What is declared and what is observed agree. Not on the source's site: from the estate library.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#Alignment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Alignment</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">The measurable alignment between intent, structure, execution and evidence, of one subject: what the source calls Operational Truth.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#AlignmentState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Alignment state</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">aligned, drifted or not observed.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#AttestationBased">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#MaturityLevel"/>
    <rdfs:label xml:lang="en">Attestation-based</rdfs:label>
    <skos:definition xml:lang="en">Traditional compliance relying on human attestations and periodic audits.</skos:definition>
    <oto:levelNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</oto:levelNumber>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#ChangeAndMemory">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#Domain"/>
    <rdfs:label xml:lang="en">Change, versioning and organizational memory</rdfs:label>
    <skos:definition xml:lang="en">How the organization evolves: every change has authorship, intent and measurable impact, and rollback is possible and explicit; organizations gain memory, not just history.</skos:definition>
    <oto:domainNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</oto:domainNumber>
    <oto:entity>Approval</oto:entity>
    <oto:entity>Change Event</oto:entity>
    <oto:entity>Diff</oto:entity>
    <oto:entity>Proposal</oto:entity>
    <oto:entity>Rationale</oto:entity>
    <oto:entity>Version</oto:entity>
    <oto:realizedBy>ontology</oto:realizedBy>
    <oto:realizedBy>spec-kit</oto:realizedBy>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#ComplianceAsCode">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#Principle"/>
    <rdfs:label xml:lang="en">Compliance as code</rdfs:label>
    <skos:definition xml:lang="en">Policies are expressed in executable, testable formats.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#ContinuousVerification">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#Principle"/>
    <rdfs:label xml:lang="en">Continuous verification</rdfs:label>
    <skos:definition xml:lang="en">Real-time validation replaces periodic point-in-time audits.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#DataGovernance">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#Pillar"/>
    <rdfs:label xml:lang="en">Data governance</rdfs:label>
    <skos:definition xml:lang="en">Evidence provenance, chain of custody and machine-attested verification for every data point.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#Dimension">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Dimension</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">One of the four dimensions of system behavior that Operational Acceptance Testing tests.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#DisciplinedTooling">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#Pillar"/>
    <rdfs:label xml:lang="en">Disciplined tooling</rdfs:label>
    <skos:definition xml:lang="en">Unified evidence warehouses, edge agents and API-first integrations with existing systems.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#Domain">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Domain</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">One of the nine areas of the organization the ontology models, each with its entities.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#Drifted">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#AlignmentState"/>
    <rdfs:label xml:lang="en">drifted</rdfs:label>
    <skos:definition xml:lang="en">What is declared and what is observed differ. Not on the source's site: from the estate library.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#EvidenceAndTelemetry">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#Domain"/>
    <rdfs:label xml:lang="en">Evidence and telemetry as truth anchors</rdfs:label>
    <skos:definition xml:lang="en">The domain that grounds the ontology in observable reality: evidence is not documentation, it is proof, immutable, attributable, linked to what it supports and bounded in time and scope.</skos:definition>
    <oto:domainNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</oto:domainNumber>
    <oto:entity>Assertion</oto:entity>
    <oto:entity>Event</oto:entity>
    <oto:entity>Evidence Artifact</oto:entity>
    <oto:entity>Log</oto:entity>
    <oto:entity>Measurement</oto:entity>
    <oto:entity>Observation</oto:entity>
    <oto:entity>Snapshot</oto:entity>
    <oto:realizedBy>grc</oto:realizedBy>
    <oto:realizedBy>quality</oto:realizedBy>
    <oto:realizedBy>telemetry</oto:realizedBy>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#EvidenceFirst">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#MaturityLevel"/>
    <rdfs:label xml:lang="en">Evidence-first</rdfs:label>
    <skos:definition xml:lang="en">All compliance claims are backed by machine-readable evidence.</skos:definition>
    <oto:levelNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</oto:levelNumber>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#EvidenceSupplyChain">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#Principle"/>
    <rdfs:label xml:lang="en">Evidence supply chain</rdfs:label>
    <skos:definition xml:lang="en">Complete provenance from source to audit report.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#ExternalObligations">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#Domain"/>
    <rdfs:label xml:lang="en">External obligations and normative frameworks</rdfs:label>
    <skos:definition xml:lang="en">The world the organization operates in: external requirements never stand alone, they map to internal policies, controls and evidence, and traceability is bidirectional.</skos:definition>
    <oto:domainNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</oto:domainNumber>
    <oto:entity>Authority</oto:entity>
    <oto:entity>Contract</oto:entity>
    <oto:entity>Jurisdiction</oto:entity>
    <oto:entity>Obligation</oto:entity>
    <oto:entity>Regulation</oto:entity>
    <oto:entity>Requirement</oto:entity>
    <oto:entity>Standard</oto:entity>
    <oto:realizedBy>grc</oto:realizedBy>
    <oto:realizedBy>ontology</oto:realizedBy>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#FailureModesAndRecovery">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#Dimension"/>
    <rdfs:label xml:lang="en">Failure modes and recovery</rdfs:label>
    <skos:definition xml:lang="en">How the system fails and recovers: silently or with an alert, gracefully or not.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#InfrastructureAndPlatform">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#Domain"/>
    <rdfs:label xml:lang="en">Infrastructure as code and platform truth</rdfs:label>
    <skos:definition xml:lang="en">The technical substrate on which operations run: infrastructure is declarative and inspectable, and identity and access are graph-connected to roles and policies.</skos:definition>
    <oto:domainNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</oto:domainNumber>
    <oto:entity>Access Controls</oto:entity>
    <oto:entity>Assets</oto:entity>
    <oto:entity>Configurations</oto:entity>
    <oto:entity>Dependencies</oto:entity>
    <oto:entity>Environments</oto:entity>
    <oto:entity>Identities</oto:entity>
    <oto:entity>Services</oto:entity>
    <oto:entity>Systems</oto:entity>
    <oto:realizedBy>desired-os-state</oto:realizedBy>
    <oto:realizedBy>estate</oto:realizedBy>
    <oto:realizedBy>toolchain</oto:realizedBy>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#Invariant">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Invariant</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">A condition an ontology must satisfy to be trustworthy; its violation is a system error.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#MaturityLevel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Maturity level</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">One of the four levels of the maturity model, numbered 1 to 4.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#NoAuthorityWithoutScope">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#Invariant"/>
    <rdfs:label xml:lang="en">No authority without scope</rdfs:label>
    <skos:definition xml:lang="en">Every authority has a scope; authority with none is a system error, not an audit finding.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#NoComplianceWithoutTraceability">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#Invariant"/>
    <rdfs:label xml:lang="en">No compliance without traceability</rdfs:label>
    <skos:definition xml:lang="en">Every claim of compliance is traceable to the requirement, policy, control and evidence behind it; a claim with none is a system error, not an audit finding.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#NoEvidenceWithoutAttribution">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#Invariant"/>
    <rdfs:label xml:lang="en">No evidence without attribution</rdfs:label>
    <skos:definition xml:lang="en">Every piece of evidence is attributable to a source; evidence with none is a system error, not an audit finding.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#NoOrphanPolicies">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#Invariant"/>
    <rdfs:label xml:lang="en">No orphan policies</rdfs:label>
    <skos:definition xml:lang="en">Every policy has an owner and a place in the graph; a policy with none is a system error, not an audit finding.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#NoUnenforcedCriticalControls">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#Invariant"/>
    <rdfs:label xml:lang="en">No unenforced critical controls</rdfs:label>
    <skos:definition xml:lang="en">Every critical control is enforced; one that is not is a system error, not an audit finding.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#NoUnownedResponsibilities">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#Invariant"/>
    <rdfs:label xml:lang="en">No unowned responsibilities</rdfs:label>
    <skos:definition xml:lang="en">Every responsibility has an accountable owner; one with none is a system error, not an audit finding.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#NotObserved">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#AlignmentState"/>
    <rdfs:label xml:lang="en">not observed</rdfs:label>
    <skos:definition xml:lang="en">Nothing was observed yet: a waiting item, never a failure and never agreement. Not on the source's site: from the estate library.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#ObservableState">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#Principle"/>
    <rdfs:label xml:lang="en">Observable state</rdfs:label>
    <skos:definition xml:lang="en">Live infrastructure state, not documentation assumptions.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#OrganizationalStructure">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#Domain"/>
    <rdfs:label xml:lang="en">Organizational structure as code</rdfs:label>
    <skos:definition xml:lang="en">The human and structural anatomy of the organization: structural truth is not inferred, it is declared.</skos:definition>
    <oto:domainNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</oto:domainNumber>
    <oto:entity>Accountability</oto:entity>
    <oto:entity>Cost Center</oto:entity>
    <oto:entity>Delegation of Authority</oto:entity>
    <oto:entity>Organizational Unit</oto:entity>
    <oto:entity>Person</oto:entity>
    <oto:entity>Reporting Line</oto:entity>
    <oto:entity>Responsibility</oto:entity>
    <oto:entity>Role</oto:entity>
    <oto:entity>Team</oto:entity>
    <oto:realizedBy>grc</oto:realizedBy>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#PartiallyAutomated">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#MaturityLevel"/>
    <rdfs:label xml:lang="en">Partially automated</rdfs:label>
    <skos:definition xml:lang="en">Some automation in evidence collection, but still document-centric.</skos:definition>
    <oto:levelNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</oto:levelNumber>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#Pillar">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Pillar</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">One of the three foundations of the framework: policies as code, data governance, disciplined tooling.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#PoliciesAsCode">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#Pillar"/>
    <rdfs:label xml:lang="en">Policies as code</rdfs:label>
    <skos:definition xml:lang="en">Compliance rules as executable, version-controlled, testable code, not PDF documents.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#PolicyAsCode">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#Domain"/>
    <rdfs:label xml:lang="en">Policy as code</rdfs:label>
    <skos:definition xml:lang="en">Organizational intent as enforceable logic rather than prose: policy is not static text, it is executable intent.</skos:definition>
    <oto:domainNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</oto:domainNumber>
    <oto:entity>Control Objective</oto:entity>
    <oto:entity>Enforcement Mode</oto:entity>
    <oto:entity>Exception</oto:entity>
    <oto:entity>Expiration</oto:entity>
    <oto:entity>Policy Group</oto:entity>
    <oto:entity>Policy Rule</oto:entity>
    <oto:entity>Policy</oto:entity>
    <oto:entity>Waiver</oto:entity>
    <oto:realizedBy>grc</oto:realizedBy>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#Principle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Principle</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">One of the five principles of the framework.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#ProcessAndWorkflow">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#Domain"/>
    <rdfs:label xml:lang="en">Process and workflow as code</rdfs:label>
    <skos:definition xml:lang="en">How work actually flows: processes are graphs, tasks are bound to roles, decisions have criteria and authority, and failure paths are first-class.</skos:definition>
    <oto:domainNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</oto:domainNumber>
    <oto:entity>Approval</oto:entity>
    <oto:entity>Decision Point</oto:entity>
    <oto:entity>Failure Mode</oto:entity>
    <oto:entity>Handoff</oto:entity>
    <oto:entity>Process</oto:entity>
    <oto:entity>SLA</oto:entity>
    <oto:entity>Task</oto:entity>
    <oto:entity>Workflow</oto:entity>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#QueryableEvidence">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#Principle"/>
    <rdfs:label xml:lang="en">Queryable evidence</rdfs:label>
    <skos:definition xml:lang="en">Every compliance claim is backed by machine-readable, SQL-queryable proof.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#SimulationAndTesting">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#Domain"/>
    <rdfs:label xml:lang="en">Simulation, testing and counterfactuals</rdfs:label>
    <skos:definition xml:lang="en">Safe experimentation: changes are modeled before execution, policies are tested before enforcement, and governance moves from reactive to predictive.</skos:definition>
    <oto:domainNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</oto:domainNumber>
    <oto:entity>Expected Outcome</oto:entity>
    <oto:entity>Hypothesis</oto:entity>
    <oto:entity>Observed Outcome</oto:entity>
    <oto:entity>Risk Delta</oto:entity>
    <oto:entity>Scenario</oto:entity>
    <oto:entity>Test</oto:entity>
    <oto:realizedBy>quality</oto:realizedBy>
    <oto:realizedBy>test</oto:realizedBy>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#StabilityOfOutcomes">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#Dimension"/>
    <rdfs:label xml:lang="en">Stability of outcomes</rdfs:label>
    <skos:definition xml:lang="en">Whether the system produces results that stay within acceptable boundaries over time.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#Trustworthiness">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#Dimension"/>
    <rdfs:label xml:lang="en">Trustworthiness</rdfs:label>
    <skos:definition xml:lang="en">Whether the outputs can be relied on for decisions, with the means to trace how they were produced.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#UnifyingGraph">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#Domain"/>
    <rdfs:label xml:lang="en">Unifying graph model</rdfs:label>
    <skos:definition xml:lang="en">All domains resolve into a single typed graph whose nodes are declared entities and whose edges are explicit relationships with semantics, direction and constraints: the graph is the system of record.</skos:definition>
    <oto:domainNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</oto:domainNumber>
    <oto:realizedBy>ontology</oto:realizedBy>
    <oto:realizedBy>rdf</oto:realizedBy>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#alignmentState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#Alignment"/>
    <rdfs:label xml:lang="en">alignment state</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#AlignmentState"/>
    <skos:definition xml:lang="en">aligned, drifted or not observed.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#dimension">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#AcceptanceRun"/>
    <rdfs:label xml:lang="en">dimension</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#Dimension"/>
    <skos:definition xml:lang="en">The dimension of behavior the run tested.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#domainNumber">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#Domain"/>
    <rdfs:label xml:lang="en">domain number</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <skos:definition xml:lang="en">The number of the domain, 1 to 9, as the source gives it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#entity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#Domain"/>
    <rdfs:label xml:lang="en">entity</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">A name of an entity the source lists for the domain.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#evidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#Alignment"/>
    <rdfs:label xml:lang="en">evidence</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">What proves it: the observation.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#execution">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#Alignment"/>
    <rdfs:label xml:lang="en">execution</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">What was done: the change or the run.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#expectedOutcome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#AcceptanceRun"/>
    <rdfs:label xml:lang="en">expected outcome</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">What the run expected, stated before it ran.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#intent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#Alignment"/>
    <rdfs:label xml:lang="en">intent</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">What is declared to be intended: the policy or the declaration.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#levelNumber">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#MaturityLevel"/>
    <rdfs:label xml:lang="en">level number</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <skos:definition xml:lang="en">The number of the level, 1 to 4.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#observedOutcome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#AcceptanceRun"/>
    <rdfs:label xml:lang="en">observed outcome</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">What the run observed.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#realizedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#Domain"/>
    <rdfs:label xml:lang="en">realized by</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">A library of commons that realizes the domain today; none where none does.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto#structure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/oto#Alignment"/>
    <rdfs:label xml:lang="en">structure</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">Who or what is responsible: the roles and owners.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/oto">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <ns1:description xml:lang="en">The Operational Truth Ontology (OTO): the nine domains, six invariants, pillars, principles and maturity levels of Operational Truth(TM), a trademark of Netspective Communications LLC, as published at operationaltruth.org, and what an Operational Acceptance Testing run expects and observes. Built from the published site alone.</ns1:description>
    <rdfs:label xml:lang="en">OTO</rdfs:label>
    <owl:versionIRI rdf:resource="https://www.intellectualfrontiers.com/ontology/oto/1.0.0"/>
    <owl:versionInfo>1.0.0</owl:versionInfo>
  </rdf:Description>
</rdf:RDF>
