plan:Absent a plan:BaselineClass ;
    rdfs:label "Absent"@en ;
    skos:definition "The observation is of a thing that was there when the last one was taken and is not now (SARIF baselineState `absent`)."@en .

plan:Accept a plan:Verdict ;
    rdfs:label "Accept"@en ;
    skos:definition "The proposal is accepted as it stands."@en .

plan:Actor a owl:Class ;
    rdfs:label "Actor"@en ;
    rdfs:subClassOf prov:Agent ;
    skos:definition "The one who wrote an event or an item: a person, an agent or a tool, with an id and a name."@en .

plan:ActorKind a owl:Class ;
    rdfs:label "Actor kind"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "One of the kinds of actor: person, agent or tool."@en .

plan:AppendEvent a plan:Capability ;
    rdfs:label "Append event"@en ;
    skos:definition "The source can take a new event of an item."@en .

plan:Argument a plan:PrincipalBasis ;
    rdfs:label "Argument"@en ;
    skos:definition "The person named by an argument of the run."@en .

plan:Assign a plan:Capability ;
    rdfs:label "Assign"@en ;
    skos:definition "The source can set the assignees of an item."@en .

plan:AssignedEvent a plan:EventType ;
    rdfs:label "Assigned"@en ;
    skos:definition "Assignees were added or taken away."@en .

plan:BaselineClass a owl:Class ;
    rdfs:label "Baseline class"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "One of the four classes of an observation against the one last taken: new, unchanged, updated or absent."@en .

plan:BlockerSetEvent a plan:EventType ;
    rdfs:label "Blocker set"@en ;
    skos:definition "The item was marked as blocking, or not."@en .

plan:Blocks a plan:LinkKind ;
    rdfs:label "Blocks"@en ;
    skos:definition "The first item must be done before the second can be; the links of this kind make a graph with no cycle."@en .

plan:ByAgent a plan:ActorKind ;
    rdfs:label "Agent"@en ;
    skos:definition "An AI agent; an item or an event it wrote says so, names the person it acted for with prov:actedOnBehalfOf, and is never signed as a person."@en .

plan:ByPerson a plan:ActorKind ;
    rdfs:label "Person"@en ;
    skos:definition "A human being, named by who they are and never by a program acting for them; the person an agent acts for, and the only kind that confirms a proposed item."@en .

plan:ByTool a plan:ActorKind ;
    rdfs:label "Tool"@en ;
    skos:definition "A program with no judgement of its own: a scanner, a linter, a synchronizer."@en .

plan:Capability a owl:Class ;
    rdfs:label "Capability"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "One of the things a source can be asked to do."@en .

plan:Close a plan:Capability ;
    rdfs:label "Close"@en ;
    skos:definition "The source can close and reopen an item."@en .

plan:CloseReason a owl:Class ;
    rdfs:label "Close reason"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "One of the reasons an item is closed."@en .

plan:Closed a plan:State ;
    rdfs:label "Closed"@en ;
    skos:definition "Finished or set aside, with a reason; it may be reopened. The iCalendar status that a closed item is closest to is COMPLETED or CANCELLED, which the reason chooses and this ontology does not."@en .

plan:ClosedEvent a plan:EventType ;
    rdfs:label "Closed"@en ;
    skos:definition "The item was closed, with a reason."@en .

plan:CommentedEvent a plan:EventType ;
    rdfs:label "Commented"@en ;
    skos:definition "Someone added a remark."@en .

plan:Commit a plan:LocatorKind ;
    rdfs:label "Commit"@en ;
    skos:definition "A commit of a repository, named by its hash, as of a trailer."@en .

plan:CommitAuthor a plan:PrincipalBasis ;
    rdfs:label "Commit author"@en ;
    skos:definition "The author of a commit whose trailer names the agent, where the configuration names that rule."@en .

plan:Completed a plan:CloseReason ;
    rdfs:label "Completed"@en ;
    skos:definition "The work was done."@en ;
    plan:githubStateReason "completed" .

plan:Configuration a plan:PrincipalBasis ;
    rdfs:label "Configuration"@en ;
    skos:definition "The person the configuration of a headless run names as its principal."@en .

plan:ConfirmedEvent a plan:EventType ;
    rdfs:label "Confirmed"@en ;
    skos:definition "A person confirmed a proposed item."@en .

plan:ConflictValue a owl:Class ;
    rdfs:label "Conflict value"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "The value of a field where two sources disagree and the authority of the field does not settle it: it holds each source's value and waits for a person (0037-planning FR-017)."@en .

plan:Create a plan:Capability ;
    rdfs:label "Create"@en ;
    skos:definition "The source can take a new item."@en .

plan:DecidedEvent a plan:EventType ;
    rdfs:label "Decided"@en ;
    skos:definition "A verdict was given on the item, with a note."@en .

plan:Declared a plan:Origin ;
    rdfs:label "Declared"@en ;
    skos:definition "Written as an item by a person or by a tool whose output is a statement of it."@en .

plan:Deferred a plan:State ;
    rdfs:label "Deferred"@en ;
    skos:definition "Set aside until a day, and not closed; a reopened event opens it again."@en .

plan:DeferredEvent a plan:EventType ;
    rdfs:label "Deferred"@en ;
    skos:definition "The item was set aside until a day."@en .

plan:Delete a plan:Capability ;
    rdfs:label "Delete"@en ;
    skos:definition "The source can remove an item; the model itself never does."@en .

plan:Derived a plan:Origin ;
    rdfs:label "Derived"@en ;
    skos:definition "Read from a place by a rule that is exact, as a comment marked TODO or a task line of a list."@en .

plan:Duplicate a plan:CloseReason ;
    rdfs:label "Duplicate"@en ;
    skos:definition "Another item says the same; it is the one that is kept."@en ;
    plan:githubStateReason "duplicate" .

plan:Edit a plan:Capability ;
    rdfs:label "Edit"@en ;
    skos:definition "The source can change the title, the body or the labels of an item."@en .

plan:EditedEvent a plan:EventType ;
    rdfs:label "Edited"@en ;
    skos:definition "The title or the body changed."@en .

plan:Error a plan:Severity ;
    rdfs:label "Error"@en ;
    skos:definition "A serious problem."@en ;
    plan:sarifLevel "error" .

plan:Event a owl:Class ;
    rdfs:label "Event"@en ;
    rdfs:subClassOf prov:Activity ;
    skos:definition "One thing that happened to an item, appended to its history and never changed, with its time and its actor."@en .

plan:EventType a owl:Class ;
    rdfs:label "Event type"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "One of the cases of the union an item's history is made of."@en .

plan:FieldAuthority a owl:Class ;
    rdfs:label "Field authority"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "One of the ways the value of a field is settled when sources disagree."@en .

plan:FileSpan a plan:LocatorKind ;
    rdfs:label "File span"@en ;
    skos:definition "A file of a store, with a line or a range and the symbol that encloses it where there is one."@en .

plan:Finding a plan:ItemKind ;
    rdfs:label "Finding"@en ;
    skos:definition "What an audit, a scan or a review found, with a severity and where it was seen."@en ;
    plan:webAnnotationMotivation "assessing" .

plan:InProgress a plan:State ;
    rdfs:label "In progress"@en ;
    skos:definition "Being worked on."@en ;
    plan:icalStatus "IN-PROCESS" .

plan:Inferred a plan:Origin ;
    rdfs:label "Inferred"@en ;
    skos:definition "Guessed by a heuristic or an agent; it is proposed until a person confirms it."@en .

plan:Issue a plan:ItemKind ;
    rdfs:label "Issue"@en ;
    skos:definition "A problem or a request that someone is to look at, with a title and a body."@en .

plan:Item a owl:Class ;
    rdfs:label "Item"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "A piece of planning content of one of four kinds, with a stable id and a history of events from which its state is folded."@en .

plan:ItemKind a owl:Class ;
    rdfs:label "Item kind"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "One of the four kinds of item."@en .

plan:LabeledEvent a plan:EventType ;
    rdfs:label "Labeled"@en ;
    skos:definition "Labels were added or taken away."@en .

plan:LatestWins a plan:FieldAuthority ;
    rdfs:label "Latest"@en ;
    skos:definition "The change made last, by the time of its event, says what the field is."@en .

plan:Link a owl:Class ;
    rdfs:label "Link"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "A typed relation between two items."@en .

plan:LinkKind a owl:Class ;
    rdfs:label "Link kind"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "One of the kinds of link between two items."@en .

plan:LinkedEvent a plan:EventType ;
    rdfs:label "Linked"@en ;
    skos:definition "A link to another item was added or taken away."@en .

plan:Locator a owl:Class ;
    rdfs:label "Locator"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "A way of naming a place: a file with a line, a web address, a row or a commit."@en .

plan:LocatorKind a owl:Class ;
    rdfs:label "Locator kind"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "One of the ways a place is named."@en .

plan:MajorRevision a plan:Verdict ;
    rdfs:label "Major revision"@en ;
    skos:definition "The proposal is to be reworked and decided again."@en .

plan:MinorRevision a plan:Verdict ;
    rdfs:label "Minor revision"@en ;
    skos:definition "The proposal is accepted after small changes."@en .

plan:New a plan:BaselineClass ;
    rdfs:label "New"@en ;
    skos:definition "The observation is of a thing that was not there when the last one was taken (SARIF baselineState `new`)."@en .

plan:NotPlanned a plan:CloseReason ;
    rdfs:label "Not planned"@en ;
    skos:definition "The work will not be done."@en ;
    plan:githubStateReason "not_planned" .

plan:Note a plan:Severity ;
    rdfs:label "Note"@en ;
    skos:definition "A minor problem or a chance to improve."@en ;
    plan:sarifLevel "note" .

plan:Observation a owl:Class ;
    rdfs:label "Observation"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "What one source saw in one place at one time: the content, a locator, a hash of what was read and a fingerprint of its identity."@en .

plan:Open a plan:State ;
    rdfs:label "Open"@en ;
    skos:definition "Confirmed and not started."@en ;
    plan:icalStatus "NEEDS-ACTION" .

plan:OpenedEvent a plan:EventType ;
    rdfs:label "Opened"@en ;
    skos:definition "The item came to be, with its kind, title and body."@en .

plan:Origin a owl:Class ;
    rdfs:label "Origin"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "How an item came to be: declared, derived or inferred."@en .

plan:OutboxEntry a owl:Class ;
    rdfs:label "Outbox entry"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "A patch that a source cannot carry out yet, kept with what it waits for: a capability, a person's confirmation, or a schema that cannot say it (0037-planning FR-033)."@en .

plan:ParentOf a plan:LinkKind ;
    rdfs:label "Parent of"@en ;
    skos:definition "The first item contains the second as a sub-item."@en .

plan:Patch a owl:Class ;
    rdfs:label "Patch"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "A change to write back to one source: add an item, change a state, add an event; a value, and nothing happens until it is applied."@en .

plan:PersonOnly a plan:FieldAuthority ;
    rdfs:label "Person"@en ;
    skos:definition "Only an event by a person changes the field; a change by an agent or a tool waits as a proposal."@en .

plan:Preview a owl:Class ;
    rdfs:label "Preview"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "What applying a patch would do, with a hash of that account, so that applying is held to what was previewed."@en .

plan:PrincipalBasis a owl:Class ;
    rdfs:label "Principal basis"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "One of the ways the person an agent acts for was established."@en .

plan:Proposed a plan:State ;
    rdfs:label "Proposed"@en ;
    skos:definition "Found or inferred by a program or an agent, not yet confirmed by a person; it is counted in no plan until it is."@en .

plan:Read a plan:Capability ;
    rdfs:label "Read"@en ;
    skos:definition "The source can be read."@en .

plan:Reject a plan:Verdict ;
    rdfs:label "Reject"@en ;
    skos:definition "The proposal is refused."@en .

plan:RelatesTo a plan:LinkKind ;
    rdfs:label "Relates to"@en ;
    skos:definition "The two items are about the same matter, with no order between them."@en .

plan:ReopenedEvent a plan:EventType ;
    rdfs:label "Reopened"@en ;
    skos:definition "A closed or deferred item was opened again."@en .

plan:SameAs a plan:LinkKind ;
    rdfs:label "Same as"@en ;
    skos:definition "The two items say one thing; a person confirms the link."@en .

plan:Session a plan:PrincipalBasis ;
    rdfs:label "Session"@en ;
    skos:definition "The person whose credentials or session launched the program, as the authenticated person of a tool server's session."@en .

plan:Severity a owl:Class ;
    rdfs:label "Severity"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "One of the three severities of an item."@en .

plan:SeveritySetEvent a plan:EventType ;
    rdfs:label "Severity set"@en ;
    skos:definition "The severity changed."@en .

plan:Source a owl:Class ;
    rdfs:label "Source"@en ;
    rdfs:subClassOf prov:SoftwareAgent ;
    skos:definition "A program that reads observations from one kind of place and writes patches back to it, with the capabilities it declares."@en .

plan:SourceWins a plan:FieldAuthority ;
    rdfs:label "Source"@en ;
    skos:definition "The place the item was seen in says what the field is, and the store follows it."@en .

plan:StartedEvent a plan:EventType ;
    rdfs:label "Started"@en ;
    skos:definition "Work began on the item."@en .

plan:State a owl:Class ;
    rdfs:label "State"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "One of the five states an item is in, as folded from its events."@en .

plan:StoreWins a plan:FieldAuthority ;
    rdfs:label "Store"@en ;
    skos:definition "The store says what the field is, and the place follows it where it can be written."@en .

plan:Task a plan:ItemKind ;
    rdfs:label "Task"@en ;
    skos:definition "A unit of work to be done, possibly with sub-items."@en .

plan:Todo a plan:ItemKind ;
    rdfs:label "Todo"@en ;
    skos:definition "A note left in a place to do something there: a comment in a source file, a line of a list."@en .

plan:Trace a owl:Class ;
    rdfs:label "Trace"@en ;
    rdfs:subClassOf prov:Derivation ;
    skos:definition "The record that an item was derived from what a source observed, so that every place an item was seen can be found from it."@en .

plan:Unchanged a plan:BaselineClass ;
    rdfs:label "Unchanged"@en ;
    skos:definition "The observation is of a thing that was there and has not changed (SARIF baselineState `unchanged`)."@en .

plan:Updated a plan:BaselineClass ;
    rdfs:label "Updated"@en ;
    skos:definition "The observation is of a thing that was there and has changed (SARIF baselineState `updated`)."@en .

plan:Url a plan:LocatorKind ;
    rdfs:label "URL"@en ;
    skos:definition "A web address, as of an issue on a Git host."@en .

plan:Verdict a owl:Class ;
    rdfs:label "Verdict"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "One of the four verdicts a decision gives."@en .

plan:Warning a plan:Severity ;
    rdfs:label "Warning"@en ;
    skos:definition "A problem."@en ;
    plan:sarifLevel "warning" .

plan:actorId a owl:DatatypeProperty ;
    rdfs:domain plan:Actor ;
    rdfs:label "actor id"@en ;
    rdfs:range xsd:string ;
    skos:definition "The id of the actor."@en .

plan:actorKind a owl:ObjectProperty ;
    rdfs:domain plan:Actor ;
    rdfs:label "actor kind"@en ;
    rdfs:range plan:ActorKind ;
    skos:definition "Whether the actor is a person, an agent or a tool."@en .

plan:actorName a owl:DatatypeProperty ;
    rdfs:domain plan:Actor ;
    rdfs:label "actor name"@en ;
    rdfs:range xsd:string ;
    skos:definition "The name of the actor."@en .

plan:contentHash a owl:DatatypeProperty ;
    rdfs:domain plan:Observation ;
    rdfs:label "content hash"@en ;
    rdfs:range xsd:string ;
    skos:definition "The SHA-256 of the bytes the observation was read from, so that a change of the place is told from a change of the item."@en .

plan:deferredUntil a owl:DatatypeProperty ;
    rdfs:label "deferred until"@en ;
    skos:definition "The day an item set aside is to come back, YYYY-MM-DD, with the state deferred."@en .

plan:eventActor a owl:ObjectProperty ;
    rdfs:domain plan:Event ;
    rdfs:label "event actor"@en ;
    rdfs:range plan:Actor ;
    skos:definition "Who wrote the event."@en .

plan:eventAt a owl:DatatypeProperty ;
    rdfs:domain plan:Event ;
    rdfs:label "event at"@en ;
    rdfs:range xsd:string ;
    skos:definition "When the event happened: ISO 8601 in UTC to the second."@en .

plan:eventOf a owl:ObjectProperty ;
    rdfs:domain plan:Event ;
    rdfs:label "event of"@en ;
    rdfs:range plan:Item ;
    skos:definition "The item the event happened to."@en .

plan:eventType a owl:ObjectProperty ;
    rdfs:domain plan:Event ;
    rdfs:label "event type"@en ;
    rdfs:range plan:EventType ;
    skos:definition "The case of the union the event is."@en .

plan:externalSource a owl:DatatypeProperty ;
    rdfs:label "external source"@en ;
    skos:definition "The name of the source that gave an item or an event an id of another scheme (a ULID, a number of a Git host, an id of a build finding); with the external value it is the external id."@en .

plan:externalValue a owl:DatatypeProperty ;
    rdfs:label "external value"@en ;
    skos:definition "The id of another scheme, as the source named it."@en .

plan:fieldAuthority a owl:ObjectProperty ;
    rdfs:domain plan:Source ;
    rdfs:label "field authority"@en ;
    rdfs:range plan:FieldAuthority ;
    skos:definition "How the source's value of a field is weighed against the store's."@en .

plan:fingerprint a owl:DatatypeProperty ;
    rdfs:domain plan:Observation ;
    rdfs:label "fingerprint"@en ;
    rdfs:range xsd:string ;
    skos:definition "A hash of what identifies the item in its place apart from where in the place it is, so that the identity survives a move."@en .

plan:githubStateReason a owl:DatatypeProperty ;
    rdfs:domain plan:CloseReason ;
    rdfs:label "GitHub state reason"@en ;
    rdfs:range xsd:string ;
    skos:definition "The name of the reason GitHub gives for closing an issue, as the REST interface writes it (GitHub Docs, REST API 2026-03-10, update an issue: completed, not_planned, duplicate, reopened, or null); a name and no IRI."@en .

plan:icalStatus a owl:DatatypeProperty ;
    rdfs:domain plan:State ;
    rdfs:label "iCalendar status"@en ;
    rdfs:range xsd:string ;
    skos:definition "The name of the iCalendar to-do STATUS the state is closest to (RFC 5545 section 3.8.1.11: NEEDS-ACTION, COMPLETED, IN-PROCESS or CANCELLED for a VTODO); a name and no IRI."@en .

plan:itemBlocker a owl:DatatypeProperty ;
    rdfs:domain plan:Item ;
    rdfs:label "item blocker"@en ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether the item holds work up; a flag of the record, and not a severity."@en .

plan:itemCites a owl:DatatypeProperty ;
    rdfs:domain plan:Item ;
    rdfs:label "item cites"@en ;
    rdfs:range xsd:string ;
    skos:definition "A requirement the item cites, as written in the source."@en .

plan:itemCloseReason a owl:ObjectProperty ;
    rdfs:domain plan:Item ;
    rdfs:label "item close reason"@en ;
    rdfs:range plan:CloseReason ;
    skos:definition "Why the item is closed, where it is."@en .

plan:itemEngines a owl:DatatypeProperty ;
    rdfs:domain plan:Item ;
    rdfs:label "item engines"@en ;
    rdfs:range xsd:string ;
    skos:definition "The engines the work applies to, or all, as the source names them."@en .

plan:itemEvidence a owl:DatatypeProperty ;
    rdfs:domain plan:Item ;
    rdfs:label "item evidence"@en ;
    rdfs:range xsd:string ;
    skos:definition "A piece of evidence for the item: a commit, a test, a specification, a file with a line or a review, as the source writes it."@en .

plan:itemGoals a owl:DatatypeProperty ;
    rdfs:domain plan:Item ;
    rdfs:label "item goals"@en ;
    rdfs:range xsd:string ;
    skos:definition "The goals the work serves, as the source names them."@en .

plan:itemId a owl:DatatypeProperty ;
    rdfs:domain plan:Item ;
    rdfs:label "item id"@en ;
    rdfs:range xsd:string ;
    skos:definition "The stable id of the item; it does not change when the item moves between places."@en .

plan:itemKind a owl:ObjectProperty ;
    rdfs:domain plan:Item ;
    rdfs:label "item kind"@en ;
    rdfs:range plan:ItemKind ;
    skos:definition "The kind of the item."@en .

plan:itemMotivation a owl:DatatypeProperty ;
    rdfs:domain plan:Item ;
    rdfs:label "item motivation"@en ;
    rdfs:range xsd:string ;
    skos:definition "The name of the Web Annotation motivation of the record the item was read from, one of the thirteen (Web Annotation Data Model, section 3.3.5); a name and no IRI."@en .

plan:itemOrigin a owl:ObjectProperty ;
    rdfs:domain plan:Item ;
    rdfs:label "item origin"@en ;
    rdfs:range plan:Origin ;
    skos:definition "How the item came to be."@en .

plan:itemPriority a owl:DatatypeProperty ;
    rdfs:domain plan:Item ;
    rdfs:label "item priority"@en ;
    rdfs:range xsd:string ;
    skos:definition "How important the work is, as the source writes it (P1 to P3 in a typed issue); not a severity."@en .

plan:itemSeverity a owl:ObjectProperty ;
    rdfs:domain plan:Item ;
    rdfs:label "item severity"@en ;
    rdfs:range plan:Severity ;
    skos:definition "The severity of the item."@en .

plan:itemSize a owl:DatatypeProperty ;
    rdfs:domain plan:Item ;
    rdfs:label "item size"@en ;
    rdfs:range xsd:string ;
    skos:definition "How large the work is, as the source writes it (xs to xl in a typed issue)."@en .

plan:itemSource a owl:DatatypeProperty ;
    rdfs:domain plan:Item ;
    rdfs:label "item source"@en ;
    rdfs:range xsd:string ;
    skos:definition "Where a finding came from: the tool, the rule, the file and the line (the SARIF ruleId and physicalLocation, sections 3.27.5 and 3.29, are the standard's names for the last three)."@en .

plan:itemState a owl:ObjectProperty ;
    rdfs:domain plan:Item ;
    rdfs:label "item state"@en ;
    rdfs:range plan:State ;
    skos:definition "The state of the item, folded from its events."@en .

plan:itemTarget a owl:DatatypeProperty ;
    rdfs:domain plan:Item ;
    rdfs:label "item target"@en ;
    rdfs:range xsd:string ;
    skos:definition "What the record is about: a file, a page and a quote (the quote is the exact text of a Web Annotation TextQuoteSelector, section 4.2.4)."@en .

plan:linkFrom a owl:ObjectProperty ;
    rdfs:domain plan:Link ;
    rdfs:label "link from"@en ;
    rdfs:range plan:Item ;
    skos:definition "The item the link starts at."@en .

plan:linkKind a owl:ObjectProperty ;
    rdfs:domain plan:Link ;
    rdfs:label "link kind"@en ;
    rdfs:range plan:LinkKind ;
    skos:definition "The kind of the link."@en .

plan:linkTo a owl:ObjectProperty ;
    rdfs:domain plan:Link ;
    rdfs:label "link to"@en ;
    rdfs:range plan:Item ;
    skos:definition "The item the link ends at."@en .

plan:locatorKind a owl:ObjectProperty ;
    rdfs:domain plan:Locator ;
    rdfs:label "locator kind"@en ;
    rdfs:range plan:LocatorKind ;
    skos:definition "The way the place is named."@en .

plan:locatorValue a owl:DatatypeProperty ;
    rdfs:domain plan:Locator ;
    rdfs:label "locator value"@en ;
    rdfs:range xsd:string ;
    skos:definition "The name of the place, in the form of its kind."@en .

plan:observationLocator a owl:ObjectProperty ;
    rdfs:domain plan:Observation ;
    rdfs:label "observation locator"@en ;
    rdfs:range plan:Locator ;
    skos:definition "Where the source read it."@en .

plan:observedAt a owl:DatatypeProperty ;
    rdfs:domain plan:Observation ;
    rdfs:label "observed at"@en ;
    rdfs:range xsd:string ;
    skos:definition "When the source read it: ISO 8601 in UTC to the second."@en .

plan:observedBy a owl:ObjectProperty ;
    rdfs:domain plan:Observation ;
    rdfs:label "observed by"@en ;
    rdfs:range plan:Source ;
    skos:definition "The source that read the observation."@en .

plan:patchOp a owl:DatatypeProperty ;
    rdfs:domain plan:Patch ;
    rdfs:label "patch operation"@en ;
    rdfs:range xsd:string ;
    skos:definition "The operation: add-item, change-state, add-event, link or confirm."@en .

plan:patchTarget a owl:ObjectProperty ;
    rdfs:domain plan:Patch ;
    rdfs:label "patch target"@en ;
    rdfs:range plan:Source ;
    skos:definition "The source the patch is to be written to; a write has an explicit target."@en .

plan:previewHash a owl:DatatypeProperty ;
    rdfs:domain plan:Preview ;
    rdfs:label "preview hash"@en ;
    rdfs:range xsd:string ;
    skos:definition "The SHA-256 of the preview, which a headless check mode compares with the plan it is told to apply."@en .

plan:previewOf a owl:ObjectProperty ;
    rdfs:domain plan:Preview ;
    rdfs:label "preview of"@en ;
    rdfs:range plan:Patch ;
    skos:definition "The patch the preview is about."@en .

plan:principalBasis a owl:ObjectProperty ;
    rdfs:domain plan:Actor ;
    rdfs:label "principal basis"@en ;
    rdfs:range plan:PrincipalBasis ;
    skos:definition "How the principal of an agent was established; stored with the actor, which names the principal with prov:actedOnBehalfOf."@en .

plan:sarifLevel a owl:DatatypeProperty ;
    rdfs:domain plan:Severity ;
    rdfs:label "SARIF level"@en ;
    rdfs:range xsd:string ;
    skos:definition "The name of the SARIF result level the severity is: error, warning or note (SARIF 2.1.0 Plus Errata 01, sections 3.27.9 and 3.27.10: the levels that apply where the result's kind is fail); a name and no IRI."@en .

plan:seenIn a owl:ObjectProperty ;
    rdfs:domain plan:Item ;
    rdfs:label "seen in"@en ;
    rdfs:range plan:Observation ;
    skos:definition "An observation of the item, in one place; an item has one for every place it was seen."@en .

plan:sourceCapability a owl:ObjectProperty ;
    rdfs:domain plan:Source ;
    rdfs:label "source capability"@en ;
    rdfs:range plan:Capability ;
    skos:definition "An ability the source declares."@en .

plan:sourceName a owl:DatatypeProperty ;
    rdfs:domain plan:Source ;
    rdfs:label "source name"@en ;
    rdfs:range xsd:string ;
    skos:definition "The name of the source, as the package that holds it is named."@en .

plan:sourceSeverity a owl:DatatypeProperty ;
    rdfs:domain plan:Item ;
    rdfs:label "source severity"@en ;
    rdfs:range xsd:string ;
    skos:definition "The severity as the source wrote it, where the source has more levels than the three of plan:Severity; the item keeps this value and the three are not an exact expression of it."@en .

plan:traceItem a owl:ObjectProperty ;
    rdfs:domain plan:Trace ;
    rdfs:label "trace item"@en ;
    rdfs:range plan:Item ;
    skos:definition "The item that was derived."@en .

plan:traceObservation a owl:ObjectProperty ;
    rdfs:domain plan:Trace ;
    rdfs:label "trace observation"@en ;
    rdfs:range plan:Observation ;
    skos:definition "The observation it was derived from."@en .

plan:tracePresent a owl:DatatypeProperty ;
    rdfs:domain plan:Trace ;
    rdfs:label "trace present"@en ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether the thing a trace names is present in the place at the time the trace was made, or absent from it (0037-planning FR-009)."@en .

plan:webAnnotationMotivation a owl:DatatypeProperty ;
    rdfs:domain plan:ItemKind ;
    rdfs:label "Web Annotation motivation"@en ;
    rdfs:range xsd:string ;
    skos:definition "The name of the Web Annotation motivation the kind is closest to (Web Annotation Data Model, section 3.3.5, one of the thirteen motivations; the IRI of each is in the namespace http://www.w3.org/ns/oa# of the Web Annotation Vocabulary, section 2.3)."@en .

<https://www.intellectualfrontiers.com/ontology/planning> a owl:Ontology ;
    <http://purl.org/dc/terms/description> "The vocabulary of Planning: the four kinds of planning item, the events that make their history and the states folded from them, the actors, the observations of what a source saw and where, the traces and links between items, the patches that write a change back and their previews, the sources that read and write, and the closed code lists the model branches on."@en ;
    rdfs:label "Planning"@en ;
    owl:versionIRI planv:1.0.0 ;
    owl:versionInfo "1.0.0" .
