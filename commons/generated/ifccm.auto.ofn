AnnotationAssertion(skos:definition ifccm:changesItem "A configuration item the change alters."@en)
ObjectPropertyDomain(ifccm:changesItem ifccm:Change)
ObjectPropertyRange(ifccm:changesItem ifccm:ConfigurationItem)
