AnnotationAssertion(rdfs:label ifccm:AuthorityFunction "Authority function"@en)
AnnotationAssertion(skos:definition ifccm:AuthorityFunction "binds, authorizes, verifies or plans: the four functions of authority that are kept apart."@en)
SubClassOf(ifccm:AuthorityFunction skos:Concept)
AnnotationAssertion(rdfs:label ifccm:Baseline "Baseline"@en)
AnnotationAssertion(skos:definition ifccm:Baseline "The configuration items at one revision, established by a Decision."@en)
SubClassOf(ifccm:Baseline prov:Collection)
AnnotationAssertion(rdfs:label ifccm:Capability "Capability"@en)
AnnotationAssertion(skos:definition ifccm:Capability "The unit of change: one ability of a harness that can be named, specified, built, proved and released. Never a feature, an epic or a product."@en)
AnnotationAssertion(rdfs:label ifccm:Change "Change"@en)
AnnotationAssertion(skos:definition ifccm:Change "The work done under one or more change requests: its commits and the pull or merge request that carries them."@en)
SubClassOf(ifccm:Change prov:Activity)
AnnotationAssertion(rdfs:label ifccm:ChangeRequest "Change request"@en)
AnnotationAssertion(skos:definition ifccm:ChangeRequest "An issue on a Git host that plans a capability or reports a problem; it plans and traces and authorizes nothing."@en)
SubClassOf(ifccm:ChangeRequest oslc_cm:ChangeRequest)
AnnotationAssertion(rdfs:label ifccm:ChangeRequestKind "Change request kind"@en)
AnnotationAssertion(skos:definition ifccm:ChangeRequestKind "capability request or problem."@en)
SubClassOf(ifccm:ChangeRequestKind skos:Concept)
AnnotationAssertion(rdfs:label ifccm:ChangeRequestState "Change request state"@en)
AnnotationAssertion(skos:definition ifccm:ChangeRequestState "open or closed, as the Git host keeps it."@en)
SubClassOf(ifccm:ChangeRequestState skos:Concept)
AnnotationAssertion(rdfs:label ifccm:ConfigurationItem "Configuration item"@en)
AnnotationAssertion(skos:definition ifccm:ConfigurationItem "Anything a change may alter that is under control: a specification, an ontology file, a source file, a test, a generated file, a pin."@en)
SubClassOf(ifccm:ConfigurationItem prov:Entity)
AnnotationAssertion(rdfs:label ifccm:EnforcementPhase "Enforcement phase"@en)
AnnotationAssertion(skos:definition ifccm:EnforcementPhase "warn before a harness declares production, gate from the day it does."@en)
SubClassOf(ifccm:EnforcementPhase skos:Concept)
AnnotationAssertion(rdfs:label ifccm:GitHostKind "Git host kind"@en)
AnnotationAssertion(skos:definition ifccm:GitHostKind "GitHub, GitLab or plain Git: the kinds of host the check reads through one interface."@en)
SubClassOf(ifccm:GitHostKind skos:Concept)
AnnotationAssertion(rdfs:label ifccm:HarnessDeclaration "Harness declaration"@en)
AnnotationAssertion(skos:definition ifccm:HarnessDeclaration "A harness's statement of the regulated domains it claims and the day it declares production; the one source of the phase of enforcement."@en)
SubClassOf(ifccm:HarnessDeclaration prov:Entity)
AnnotationAssertion(rdfs:label ifccm:IssueReferenceKind "Issue reference kind"@en)
AnnotationAssertion(skos:definition ifccm:IssueReferenceKind "Refs or Closes: how a commit names a change request."@en)
SubClassOf(ifccm:IssueReferenceKind skos:Concept)
AnnotationAssertion(rdfs:label ifccm:RegulatedDomain "Regulated domain"@en)
AnnotationAssertion(skos:definition ifccm:RegulatedDomain "A domain of regulation a harness may claim: federal security, device quality, electronic records, device software, trust services."@en)
SubClassOf(ifccm:RegulatedDomain skos:Concept)
AnnotationAssertion(rdfs:label ifccm:TraceStage "Trace stage"@en)
AnnotationAssertion(skos:definition ifccm:TraceStage "One link of the chain from a change request to a quality run."@en)
SubClassOf(ifccm:TraceStage skos:Concept)
AnnotationAssertion(rdfs:label ifccm:anchor "anchor"@en)
AnnotationAssertion(skos:definition ifccm:anchor "The annotation that already links the stage, so that no new one is needed."@en)
DataPropertyDomain(ifccm:anchor ifccm:TraceStage)
DataPropertyRange(ifccm:anchor xsd:string)
AnnotationAssertion(rdfs:label ifccm:approvedBy "approved by"@en)
AnnotationAssertion(skos:definition ifccm:approvedBy "The role that approved the change; never the role that authored it where the harness is regulated."@en)
DataPropertyDomain(ifccm:approvedBy ifccm:Change)
DataPropertyRange(ifccm:approvedBy xsd:string)
AnnotationAssertion(rdfs:label ifccm:area "area"@en)
AnnotationAssertion(skos:definition ifccm:area "The area of the harness (a rung or a subject) whose parent change request the capability is a child of."@en)
DataPropertyDomain(ifccm:area ifccm:Capability)
DataPropertyRange(ifccm:area xsd:string)
