  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/id/mizan/term-workload-Workload">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#OntologyTerm"/>
    <rdfs:label xml:lang="en">wl:Workload</rdfs:label>
    <mz:basis rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Specializes"/>
    <mz:definedBy>0040-workload-pattern FR-001</mz:definedBy>
    <mz:mappingRelation>subClassOf</mz:mappingRelation>
    <mz:standardTerm>http://www.w3.org/ns/prov#Entity</mz:standardTerm>
    <mz:termIri>https://www.intellectualfrontiers.com/ontology/workload#Workload</mz:termIri>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/workload#Alert">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/workload#Trigger"/>
    <rdfs:label xml:lang="en">Alert</rdfs:label>
    <skos:definition xml:lang="en">The workload starts when a named alert fires.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/workload#Campaign">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/workload#Form"/>
    <rdfs:label xml:lang="en">Campaign</rdfs:label>
    <skos:definition xml:lang="en">The form of a collection over a period with sampling; reserved until a second concrete user needs it.</skos:definition>
    <wl:formStatus>reserved</wl:formStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/workload#Event">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/workload#Trigger"/>
    <rdfs:label xml:lang="en">Event</rdfs:label>
    <skos:definition xml:lang="en">The workload starts when a named event happens.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/workload#Form">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Form</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">One of the forms a workload may have: what kind of work it is and how it executes. A form is never a dialect.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/workload#Graph">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/workload#Form"/>
    <rdfs:label xml:lang="en">Graph</rdfs:label>
    <skos:definition xml:lang="en">The form of a graph of jobs with freshness, which an external executor runs; reserved until a second concrete user needs it.</skos:definition>
    <wl:formStatus>reserved</wl:formStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/workload#Manual">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/workload#Trigger"/>
    <rdfs:label xml:lang="en">Manual</rdfs:label>
    <skos:definition xml:lang="en">A person or an agent starts the workload by hand.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/workload#Reconcile">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/workload#Form"/>
    <rdfs:label xml:lang="en">Reconcile</rdfs:label>
    <skos:definition xml:lang="en">The form of a loop toward a desired state: observe, diff, plan, approve the plan by its hash, apply and verify, level-triggered.</skos:definition>
    <wl:formStatus>built</wl:formStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/workload#Runbook">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/workload#Form"/>
    <rdfs:label xml:lang="en">Runbook</rdfs:label>
    <skos:definition xml:lang="en">The form of a procedure: an ordered algebra of steps that a person or an agent orchestrates, each effect a verb.</skos:definition>
    <wl:formStatus>built</wl:formStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/workload#Schedule">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/workload#Trigger"/>
    <rdfs:label xml:lang="en">Schedule</rdfs:label>
    <skos:definition xml:lang="en">The workload starts on a cadence: daily, weekly, monthly, quarterly or yearly.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/workload#Trigger">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Trigger</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">One of the ways a workload is started. A trigger is a field of a workload and never a form.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/workload#Workload">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Workload</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">A unit of operated work, not running software: typed data of one form, with a trigger, whose every effect is a verb and whose autonomy is derived from its effects.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/workload#formStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/workload#Form"/>
    <rdfs:label xml:lang="en">form status</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">Whether the form has code (built) or is a named slot with no code (reserved).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/workload#workloadForm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/workload#Workload"/>
    <rdfs:label xml:lang="en">workload form</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/workload#Form"/>
    <skos:definition xml:lang="en">The form of the workload.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/workload#workloadId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/workload#Workload"/>
    <rdfs:label xml:lang="en">workload id</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The id of the workload: lower case words joined by hyphens, which is also the name of its skill.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/workload#workloadTrigger">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/workload#Workload"/>
    <rdfs:label xml:lang="en">workload trigger</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/workload#Trigger"/>
    <skos:definition xml:lang="en">What starts the workload.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/workload">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <ns1:description xml:lang="en">The vocabulary of Workload: a workload as a unit of operated work, the forms it may have and the triggers that start it.</ns1:description>
    <rdfs:label xml:lang="en">Workload</rdfs:label>
    <owl:versionIRI rdf:resource="https://www.intellectualfrontiers.com/ontology/workload/1.0.0"/>
    <owl:versionInfo>1.0.0</owl:versionInfo>
  </rdf:Description>
</rdf:RDF>
