    <mz:termIri>https://www.intellectualfrontiers.com/ontology/zerotrust#ProtectSurface</mz:termIri>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/id/mizan/term-zerotrust-Tenet">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#OntologyTerm"/>
    <rdfs:label xml:lang="en">zt:Tenet</rdfs:label>
    <mz:basis rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Specializes"/>
    <mz:definedBy>0047-zero-trust FR-003</mz:definedBy>
