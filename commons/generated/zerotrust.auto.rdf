    <mz:termIri>https://www.intellectualfrontiers.com/ontology/zerotrust#Tenet</mz:termIri>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/id/mizan/term-zerotrust-ZeroTrustArchitecture">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#OntologyTerm"/>
    <rdfs:label xml:lang="en">zt:ZeroTrustArchitecture</rdfs:label>
    <mz:basis rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Specializes"/>
    <mz:definedBy>0047-zero-trust FR-001</mz:definedBy>
    <mz:mappingRelation>subClassOf</mz:mappingRelation>
    <mz:standardTerm>http://www.w3.org/ns/prov#Entity</mz:standardTerm>
    <mz:termIri>https://www.intellectualfrontiers.com/ontology/zerotrust#ZeroTrustArchitecture</mz:termIri>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust#AccessDecision">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Access decision</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">The signed record of one decision about one request: the subject, the posture signals of its device, the context, the resource, the policy by hash, the outcome, the reasons and the evidence.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust#AccessIsPerSession">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/zerotrust#Tenet"/>
    <rdfs:label xml:lang="en">Access is per session</rdfs:label>
    <skos:definition xml:lang="en">Access to one resource is granted for one session with the least privilege the task needs, after the requester is evaluated; a grant for one resource carries to no other.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust#AccessPolicies">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/zerotrust#DataSource"/>
    <rdfs:label xml:lang="en">Data access policies</rdfs:label>
    <skos:definition xml:lang="en">The attributes, rules and policies about access to resources, the starting point for authorizing it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust#Activity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Zero trust activity</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">One thing a maturity model asks an organization to do, in one area, at one stage; the names are written from the model when it is read.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust#ActivityLogs">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/zerotrust#DataSource"/>
    <rdfs:label xml:lang="en">Network and system activity logs</rdfs:label>
    <skos:definition xml:lang="en">The aggregate of asset logs, traffic and access actions that gives near real time feedback on posture.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust#ApplicationsAndWorkloads">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/zerotrust#Pillar"/>
    <rdfs:label xml:lang="en">Applications and workloads</rdfs:label>
    <skos:definition xml:lang="en">What the request reaches: applications treated as reachable from the internet, tested rigorously and open to outside reports of weaknesses.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust#AutomationAndOrchestration">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/zerotrust#Pillar"/>
    <rdfs:label xml:lang="en">Automation and orchestration</rdfs:label>
    <skos:definition xml:lang="en">A theme across the areas: the decisions and responses that machines carry out by policy.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust#CommunicationIsSecuredAnywhere">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/zerotrust#Tenet"/>
    <rdfs:label xml:lang="en">Communication is secured anywhere</rdfs:label>
    <skos:definition xml:lang="en">Every communication is protected for confidentiality, integrity and the authentication of its source, and a network location alone grants no trust.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust#ComplianceSystem">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/zerotrust#DataSource"/>
    <rdfs:label xml:lang="en">Compliance system</rdfs:label>
    <skos:definition xml:lang="en">The system that holds the rules of the regime the organization falls under, so that the policy follows them.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust#Data">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/zerotrust#Pillar"/>
    <rdfs:label xml:lang="en">Data</rdfs:label>
    <skos:definition xml:lang="en">What is protected: data that is categorized, protected by what its category needs, and whose access is monitored and logged.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust#DataSource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Source of input</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">One of the sources that give the policy engine the input and the rules it decides with.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust#Devices">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/zerotrust#Pillar"/>
    <rdfs:label xml:lang="en">Devices</rdfs:label>
    <skos:definition xml:lang="en">What the request comes from: the inventory of every device in use, its state, and the ability to prevent, detect and respond to incidents on it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust#Diagnostics">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/zerotrust#DataSource"/>
    <rdfs:label xml:lang="en">Continuous diagnostics and mitigation</rdfs:label>
    <skos:definition xml:lang="en">The system that gathers the current state of assets and applies updates to their configuration and software, and so tells the engine what a requesting asset runs and whether it is vulnerable.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust#EnforcementIsDynamic">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/zerotrust#Tenet"/>
    <rdfs:label xml:lang="en">Authentication and authorization are dynamic and enforced</rdfs:label>
    <skos:definition xml:lang="en">Authentication and authorization are repeated on the events the policy names and strictly enforced before access, as a constant cycle of access, assessment and adaptation.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust#EventManagement">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/zerotrust#DataSource"/>
    <rdfs:label xml:lang="en">Security information and event management</rdfs:label>
    <skos:definition xml:lang="en">The system that collects security information for analysis, to refine policy and warn of attacks.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust#EverythingIsAResource">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/zerotrust#Tenet"/>
    <rdfs:label xml:lang="en">Everything is a resource</rdfs:label>
    <skos:definition xml:lang="en">Every data source and computing service is a resource, whatever its size, including the devices an organization lets reach its resources.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust#Governance">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/zerotrust#Pillar"/>
    <rdfs:label xml:lang="en">Governance</rdfs:label>
    <skos:definition xml:lang="en">A theme across the areas: the policies, roles and accountability that decide how the areas are run.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust#Identity">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/zerotrust#Pillar"/>
    <rdfs:label xml:lang="en">Identity</rdfs:label>
    <skos:definition xml:lang="en">Who or what asks for access: enterprise-managed identities, strong authentication that resists phishing, and the identity systems that hold them.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust#IdentityManagement">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/zerotrust#DataSource"/>
    <rdfs:label xml:lang="en">Identity management</rdfs:label>
    <skos:definition xml:lang="en">The system that creates, stores and manages the accounts and identity records, with the role and attributes of each.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust#ImplicitTrust">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Implicit trust</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">A place where access is allowed because of where the request comes from, whose it is or how long ago it was granted, and not because of a decision.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust#MaturityStage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Maturity stage</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">One of the ordered stages a maturity model gives for how far an area has gone; the members are written from the model when it is read.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust#Networks">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/zerotrust#Pillar"/>
    <rdfs:label xml:lang="en">Networks</rdfs:label>
    <skos:definition xml:lang="en">How the request travels: encrypted traffic and names, and perimeters broken into isolated environments.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust#Pillar">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Pillar</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">One of the areas of effort of zero trust, or one of the themes across them.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust#PolicyAdministrator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Policy administrator</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">The part of the decision point that opens or shuts the path between a subject and a resource on the engine's decision and makes any credential of the session.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust#PolicyDecisionPoint">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Policy decision point</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">The part that decides whether a subject may reach a resource: a policy engine that decides and a policy administrator that carries the decision out.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust#PolicyEnforcementPoint">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Policy enforcement point</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">The part that enables, watches and ends the connection between a subject and a resource on the administrator's instruction.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust#PolicyEngine">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Policy engine</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">The part of the decision point that grants, denies or revokes access from the policy and the outside inputs, and logs the decision.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust#PolicyIsDynamic">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/zerotrust#Tenet"/>
    <rdfs:label xml:lang="en">Policy is dynamic</rdfs:label>
    <skos:definition xml:lang="en">Access is decided by rules over the observable state of the identity, the application and the requesting asset, and over behavior and the environment, stricter as the resource is more sensitive.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust#PostureIsMonitored">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/zerotrust#Tenet"/>
    <rdfs:label xml:lang="en">Posture is monitored</rdfs:label>
    <skos:definition xml:lang="en">The organization measures the integrity and security posture of every asset it owns or is associated with, and trusts no asset for what it is.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust#PostureSignal">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Posture signal</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">A reading about a subject or a device that an access decision used, with its source and its age.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust#ProtectSurface">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Protect surface</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">The smallest part of an estate that one access policy names and protects: an asset, a population or a store of data; it is a boundary of the kind trust, and every path into it needs an access decision.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust#PublicKeyInfrastructure">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/zerotrust#DataSource"/>
    <rdfs:label xml:lang="en">Public key infrastructure</rdfs:label>
    <skos:definition xml:lang="en">The system that issues and logs the certificates of resources, subjects, services and applications.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust#StateIsCollected">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/zerotrust#Tenet"/>
    <rdfs:label xml:lang="en">State is collected</rdfs:label>
    <skos:definition xml:lang="en">The organization collects as much as it can about the state of its assets, network and communications and uses it to improve the policy and its enforcement.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust#Tenet">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Tenet</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">One of the basic principles the architecture standard gives for a zero trust architecture.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust#ThreatIntelligence">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/zerotrust#DataSource"/>
    <rdfs:label xml:lang="en">Threat intelligence</rdfs:label>
    <skos:definition xml:lang="en">Feeds, internal or external, about newly found attacks, weaknesses and malware that the engine weighs.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust#VisibilityAndAnalytics">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/zerotrust#Pillar"/>
    <rdfs:label xml:lang="en">Visibility and analytics</rdfs:label>
    <skos:definition xml:lang="en">A theme across the areas: the collection and analysis of what happens, which feeds the decisions.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust#ZeroTrustArchitecture">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Zero trust architecture</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">An organization's plan for deciding every access to a resource on its own, with the least privilege the request needs, in a network seen as compromised: the components, their relations, the workflows and the access policies.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust#decidedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/zerotrust#AccessDecision"/>
    <rdfs:label xml:lang="en">decided by</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/zerotrust#PolicyDecisionPoint"/>
    <skos:definition xml:lang="en">The decision point that made the access decision.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust#enforcedAt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/zerotrust#AccessDecision"/>
    <rdfs:label xml:lang="en">enforced at</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/zerotrust#PolicyEnforcementPoint"/>
    <skos:definition xml:lang="en">The enforcement point that carried out the access decision.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust#onSurface">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/zerotrust#AccessDecision"/>
    <rdfs:label xml:lang="en">on surface</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/zerotrust#ProtectSurface"/>
    <skos:definition xml:lang="en">The protect surface the access decision was about.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust#policyHash">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/zerotrust#AccessDecision"/>
    <rdfs:label xml:lang="en">policy hash</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The hash of the access policy the decision applied, so that the decision can be replayed against the same rules.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/zerotrust">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <ns1:description xml:lang="en">The vocabulary of Zero trust: the architecture, the points that decide and enforce, the access decision, the protect surface, implicit trust, and the tenets, pillars and sources of input of the primary sources.</ns1:description>
    <rdfs:label xml:lang="en">Zero trust</rdfs:label>
    <owl:versionIRI rdf:resource="https://www.intellectualfrontiers.com/ontology/zerotrust/1.0.0"/>
    <owl:versionInfo>1.0.0</owl:versionInfo>
  </rdf:Description>
</rdf:RDF>
