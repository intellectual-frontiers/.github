  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/id/mizan/term-ifccm-TraceStage">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#OntologyTerm"/>
    <rdfs:label xml:lang="en">ifccm:TraceStage</rdfs:label>
    <mz:basis rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Specializes"/>
    <mz:definedBy>0020-ifccm FR-014</mz:definedBy>
