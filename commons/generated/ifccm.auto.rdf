    <mz:standardTerm>http://www.w3.org/2004/02/skos/core#Concept</mz:standardTerm>
    <mz:termIri>https://www.intellectualfrontiers.com/ontology/ifccm#TraceStage</mz:termIri>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#AuthorityFunction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Authority function</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">binds, authorizes, verifies or plans: the four functions of authority that are kept apart.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#Authorizes">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#AuthorityFunction"/>
    <rdfs:label xml:lang="en">authorizes</rdfs:label>
    <skos:definition xml:lang="en">A departure, a waiver, an exception, a baseline or a release, with the role that approved it.</skos:definition>
    <ifccm:instrument>Decision</ifccm:instrument>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#Baseline">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Baseline</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Collection"/>
    <skos:definition xml:lang="en">The configuration items at one revision, established by a Decision.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#Binds">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#AuthorityFunction"/>
    <rdfs:label xml:lang="en">binds</rdfs:label>
    <skos:definition xml:lang="en">What must be.</skos:definition>
    <ifccm:instrument>specification</ifccm:instrument>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#Capability">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Capability</rdfs:label>
    <skos:definition xml:lang="en">The unit of change: one ability of a harness that can be named, specified, built, proved and released. Never a feature, an epic or a product.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#CapabilityRequest">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#ChangeRequestKind"/>
    <rdfs:label xml:lang="en">capability request</rdfs:label>
    <skos:definition xml:lang="en">A request to add or change a capability.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#Change">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Change</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <skos:definition xml:lang="en">The work done under one or more change requests: its commits and the pull or merge request that carries them.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#ChangeRequest">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Change request</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://open-services.net/ns/cm#ChangeRequest"/>
    <skos:definition xml:lang="en">An issue on a Git host that plans a capability or reports a problem; it plans and traces and authorizes nothing.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#ChangeRequestKind">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Change request kind</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">capability request or problem.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#ChangeRequestState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Change request state</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">open or closed, as the Git host keeps it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#Closed">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#ChangeRequestState"/>
    <rdfs:label xml:lang="en">closed</rdfs:label>
    <skos:definition xml:lang="en">The change request is finished: the commit that Closes it has been made.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#Closes">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#IssueReferenceKind"/>
    <rdfs:label xml:lang="en">Closes</rdfs:label>
    <skos:definition xml:lang="en">The commit finishes the change request, and is the only one that closes it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#ConfigurationItem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Configuration item</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">Anything a change may alter that is under control: a specification, an ontology file, a source file, a test, a generated file, a pin.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#DeviceQuality">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#RegulatedDomain"/>
    <rdfs:label xml:lang="en">device quality</rdfs:label>
    <skos:definition xml:lang="en">The quality management system of a medical-device manufacturer: 21 CFR Part 820, which incorporates ISO 13485:2016 by reference.</skos:definition>
    <ifccm:regulatedBy rdf:resource="https://www.intellectualfrontiers.com/id/mizan/authority-21-cfr-820"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#DeviceSoftware">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#RegulatedDomain"/>
    <rdfs:label xml:lang="en">device software</rdfs:label>
    <skos:definition xml:lang="en">The software life cycle of a medical device: IEC 62304.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#ElectronicRecords">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#RegulatedDomain"/>
    <rdfs:label xml:lang="en">electronic records</rdfs:label>
    <skos:definition xml:lang="en">Electronic records and electronic signatures: 21 CFR Part 11.</skos:definition>
    <ifccm:regulatedBy rdf:resource="https://www.intellectualfrontiers.com/id/mizan/authority-21-cfr-11"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#EnforcementPhase">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Enforcement phase</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">warn before a harness declares production, gate from the day it does.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#FederalSecurity">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#RegulatedDomain"/>
    <rdfs:label xml:lang="en">federal security</rdfs:label>
    <skos:definition xml:lang="en">The security controls of NIST SP 800-53 and the FedRAMP baselines.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#Gate">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#EnforcementPhase"/>
    <rdfs:label xml:lang="en">gate</rdfs:label>
    <skos:definition xml:lang="en">A finding fails whatever the baseline holds.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#HarnessDeclaration">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Harness declaration</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">A harness's statement of the regulated domains it claims and the day it declares production; the one source of the phase of enforcement.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#IssueReferenceKind">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Issue reference kind</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Refs or Closes: how a commit names a change request.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#Open">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#ChangeRequestState"/>
    <rdfs:label xml:lang="en">open</rdfs:label>
    <skos:definition xml:lang="en">The change request is not finished: a commit may name it with Refs.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#Plans">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#AuthorityFunction"/>
    <rdfs:label xml:lang="en">plans and traces</rdfs:label>
    <skos:definition xml:lang="en">What is to be done, and where it can be followed; it authorizes nothing.</skos:definition>
    <ifccm:instrument>issue</ifccm:instrument>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#Problem">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#ChangeRequestKind"/>
    <rdfs:label xml:lang="en">problem</rdfs:label>
    <skos:definition xml:lang="en">A report that something departs from what is specified or required, opened by a person or by the system from a nonconformance.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#Refs">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#IssueReferenceKind"/>
    <rdfs:label xml:lang="en">Refs</rdfs:label>
    <skos:definition xml:lang="en">The commit is work toward the change request, which stays open.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#RegulatedDomain">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Regulated domain</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">A domain of regulation a harness may claim: federal security, device quality, electronic records, device software, trust services.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#StageCode">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#TraceStage"/>
    <rdfs:label xml:lang="en">code</rdfs:label>
    <skos:definition xml:lang="en">A source file that cites the requirement.</skos:definition>
    <ifccm:anchor>// Spec: NNNN-slug FR-nnn</ifccm:anchor>
    <ifccm:stageNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</ifccm:stageNumber>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#StageIssue">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#TraceStage"/>
    <rdfs:label xml:lang="en">change request</rdfs:label>
    <skos:definition xml:lang="en">The issue that plans the change.</skos:definition>
    <ifccm:anchor>Refs #N, Closes #N</ifccm:anchor>
    <ifccm:stageNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ifccm:stageNumber>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#StageRequirement">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#TraceStage"/>
    <rdfs:label xml:lang="en">requirement</rdfs:label>
    <skos:definition xml:lang="en">A numbered requirement of a specification that the change adds or changes.</skos:definition>
    <ifccm:anchor>Done when: NNNN-slug FR-nnn</ifccm:anchor>
    <ifccm:stageNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</ifccm:stageNumber>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#StageRun">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#TraceStage"/>
    <rdfs:label xml:lang="en">quality run</rdfs:label>
    <skos:definition xml:lang="en">A run of the quality system whose record shows the test passed at a revision.</skos:definition>
    <ifccm:anchor>the evidence file of the run</ifccm:anchor>
    <ifccm:stageNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</ifccm:stageNumber>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#StageTerm">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#TraceStage"/>
    <rdfs:label xml:lang="en">ontology term</rdfs:label>
    <skos:definition xml:lang="en">The term of the ontology that defines what the requirement names.</skos:definition>
    <ifccm:anchor>mz:definedBy</ifccm:anchor>
    <ifccm:stageNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</ifccm:stageNumber>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#StageTest">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#TraceStage"/>
    <rdfs:label xml:lang="en">test</rdfs:label>
    <skos:definition xml:lang="en">A test that proves the requirement.</skos:definition>
    <ifccm:anchor>proves([...])</ifccm:anchor>
    <ifccm:stageNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</ifccm:stageNumber>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#TraceStage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Trace stage</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">One link of the chain from a change request to a quality run.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#TrustServices">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#RegulatedDomain"/>
    <rdfs:label xml:lang="en">trust services</rdfs:label>
    <skos:definition xml:lang="en">The security, availability and confidentiality of a service, assessed against SOC 2's Trust Services Criteria or ISO/IEC 27001.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#Verifies">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#AuthorityFunction"/>
    <rdfs:label xml:lang="en">verifies</rdfs:label>
    <skos:definition xml:lang="en">Whether what is, is what must be.</skos:definition>
    <ifccm:instrument>check</ifccm:instrument>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#Warn">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#EnforcementPhase"/>
    <rdfs:label xml:lang="en">warn</rdfs:label>
    <skos:definition xml:lang="en">A finding is a warning held by a baseline that only shrinks.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#anchor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#TraceStage"/>
    <rdfs:label xml:lang="en">anchor</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The annotation that already links the stage, so that no new one is needed.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#approvedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#Change"/>
    <rdfs:label xml:lang="en">approved by</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The role that approved the change; never the role that authored it where the harness is regulated.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#area">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#Capability"/>
    <rdfs:label xml:lang="en">area</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The area of the harness (a rung or a subject) whose parent change request the capability is a child of.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#authorizedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#Change"/>
    <rdfs:label xml:lang="en">authorized by</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Decision"/>
    <skos:definition xml:lang="en">The Decision that authorizes the change, where one is needed.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#baselineRevision">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#Baseline"/>
    <rdfs:label xml:lang="en">baseline revision</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The revision the baseline is established at.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#changesItem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#Change"/>
    <rdfs:label xml:lang="en">changes item</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#ConfigurationItem"/>
    <skos:definition xml:lang="en">A configuration item the change alters.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#checkItem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#ChangeRequest"/>
    <rdfs:label xml:lang="en">check item</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">A minor task: a checkbox item in the body of the change request.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#doneWhen">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#ChangeRequest"/>
    <rdfs:label xml:lang="en">done when</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The requirements and the checks that decide the capability is done: the fourth section.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#establishedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#Baseline"/>
    <rdfs:label xml:lang="en">established by</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Decision"/>
    <skos:definition xml:lang="en">The Decision that establishes the baseline.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#harness">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#HarnessDeclaration"/>
    <rdfs:label xml:lang="en">harness</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The harness the declaration is of, by its repository.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#hostedOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#ChangeRequest"/>
    <rdfs:label xml:lang="en">hosted on</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/ifws#GitManagerKind"/>
    <skos:definition xml:lang="en">The kind of Git host that keeps the change request.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#implementsRequest">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#Change"/>
    <rdfs:label xml:lang="en">implements request</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#ChangeRequest"/>
    <skos:definition xml:lang="en">A change request the change implements: the change used it as its plan.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#includesItem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#Baseline"/>
    <rdfs:label xml:lang="en">includes item</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#ConfigurationItem"/>
    <skos:definition xml:lang="en">A configuration item the baseline holds.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#instrument">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#AuthorityFunction"/>
    <rdfs:label xml:lang="en">instrument</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">What carries the function: a specification, a Decision, a check or an issue.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#itemPath">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#ConfigurationItem"/>
    <rdfs:label xml:lang="en">item path</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">Where the configuration item is in the repository, with `/`.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#parentRequest">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#Capability"/>
    <rdfs:label xml:lang="en">parent request</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#ChangeRequest"/>
    <skos:definition xml:lang="en">The parent change request of the capability's area.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#productionDeclaredOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#HarnessDeclaration"/>
    <rdfs:label xml:lang="en">production declared on</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The day (YYYY-MM-DD) the harness declares production: findings are warnings before it and gate from it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#reference">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#ChangeRequest"/>
    <rdfs:label xml:lang="en">reference</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">How a commit names the change request: `#N`, or `owner/repo#N` for another repository.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#referenceKind">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#Change"/>
    <rdfs:label xml:lang="en">reference kind</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#IssueReferenceKind"/>
    <skos:definition xml:lang="en">Refs or Closes: how the change's commit names its change request.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#regulatedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#RegulatedDomain"/>
    <rdfs:label xml:lang="en">regulated by</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Authority"/>
    <skos:definition xml:lang="en">The law a regulated domain rests on, where it rests on law.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#regulatedDomain">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#HarnessDeclaration"/>
    <rdfs:label xml:lang="en">regulated domain</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#RegulatedDomain"/>
    <skos:definition xml:lang="en">A regulated domain the harness claims.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#requestKind">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#ChangeRequest"/>
    <rdfs:label xml:lang="en">request kind</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#ChangeRequestKind"/>
    <skos:definition xml:lang="en">capability request or problem.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#requestState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#ChangeRequest"/>
    <rdfs:label xml:lang="en">request state</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#ChangeRequestState"/>
    <skos:definition xml:lang="en">open or closed.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#requestsCapability">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#ChangeRequest"/>
    <rdfs:label xml:lang="en">requests capability</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#Capability"/>
    <skos:definition xml:lang="en">The capability the change request asks for.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#requirement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#Capability"/>
    <rdfs:label xml:lang="en">requirement</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">A requirement the capability adds or changes, as `NNNN-slug FR-nnn`.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#revision">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#Change"/>
    <rdfs:label xml:lang="en">revision</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">A commit of the change, by its revision identifier.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#satisfiesControl">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#Capability"/>
    <rdfs:label xml:lang="en">satisfies control</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The OSCAL identifier of a NIST SP 800-53 control the capability satisfies (cm-3).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#scope">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#ChangeRequest"/>
    <rdfs:label xml:lang="en">scope</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">What the capability changes and what it leaves alone: the third section.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#stageNumber">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#TraceStage"/>
    <rdfs:label xml:lang="en">stage number</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <skos:definition xml:lang="en">The place of the stage in the chain, from 1.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#subRequestOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#ChangeRequest"/>
    <rdfs:label xml:lang="en">sub-request of</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#ChangeRequest"/>
    <skos:definition xml:lang="en">The parent change request of a child change request (a sub-issue).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#today">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#ChangeRequest"/>
    <rdfs:label xml:lang="en">today</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">What is true today: the second section.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#touchesRung">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#Capability"/>
    <rdfs:label xml:lang="en">touches rung</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Rung"/>
    <skos:definition xml:lang="en">A rung of the ladder the capability changes: the source of the generated view of capabilities by rung.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm#why">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifccm#ChangeRequest"/>
    <rdfs:label xml:lang="en">why</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">Why the capability is wanted: the first section of its issue.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifccm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
