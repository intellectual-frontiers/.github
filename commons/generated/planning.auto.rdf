  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Accept">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Verdict"/>
    <rdfs:label xml:lang="en">Accept</rdfs:label>
    <skos:definition xml:lang="en">The proposal is accepted as it stands.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Actor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Actor</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Agent"/>
    <skos:definition xml:lang="en">The one who wrote an event or an item: a person, an agent or a tool, with an id and a name.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#ActorKind">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Actor kind</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">One of the kinds of actor: person, agent or tool.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#AppendEvent">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Capability"/>
    <rdfs:label xml:lang="en">Append event</rdfs:label>
    <skos:definition xml:lang="en">The source can take a new event of an item.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Argument">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#PrincipalBasis"/>
    <rdfs:label xml:lang="en">Argument</rdfs:label>
    <skos:definition xml:lang="en">The person named by an argument of the run.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Assign">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Capability"/>
    <rdfs:label xml:lang="en">Assign</rdfs:label>
    <skos:definition xml:lang="en">The source can set the assignees of an item.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#AssignedEvent">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#EventType"/>
    <rdfs:label xml:lang="en">Assigned</rdfs:label>
    <skos:definition xml:lang="en">Assignees were added or taken away.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#BlockerSetEvent">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#EventType"/>
    <rdfs:label xml:lang="en">Blocker set</rdfs:label>
    <skos:definition xml:lang="en">The item was marked as blocking, or not.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Blocks">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#LinkKind"/>
    <rdfs:label xml:lang="en">Blocks</rdfs:label>
    <skos:definition xml:lang="en">The first item must be done before the second can be; the links of this kind make a graph with no cycle.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#ByAgent">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#ActorKind"/>
    <rdfs:label xml:lang="en">Agent</rdfs:label>
    <skos:definition xml:lang="en">An AI agent; an item or an event it wrote says so, names the person it acted for with prov:actedOnBehalfOf, and is never signed as a person.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#ByPerson">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#ActorKind"/>
    <rdfs:label xml:lang="en">Person</rdfs:label>
    <skos:definition xml:lang="en">A human being, named by who they are and never by a program acting for them; the person an agent acts for, and the only kind that confirms a proposed item.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#ByTool">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#ActorKind"/>
    <rdfs:label xml:lang="en">Tool</rdfs:label>
    <skos:definition xml:lang="en">A program with no judgement of its own: a scanner, a linter, a synchronizer.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Capability">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Capability</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">One of the things a source can be asked to do.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Close">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Capability"/>
    <rdfs:label xml:lang="en">Close</rdfs:label>
    <skos:definition xml:lang="en">The source can close and reopen an item.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#CloseReason">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Close reason</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">One of the reasons an item is closed.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Closed">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#State"/>
    <rdfs:label xml:lang="en">Closed</rdfs:label>
    <skos:definition xml:lang="en">Finished or set aside, with a reason; it may be reopened. The iCalendar status that a closed item is closest to is COMPLETED or CANCELLED, which the reason chooses and this ontology does not.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#ClosedEvent">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#EventType"/>
    <rdfs:label xml:lang="en">Closed</rdfs:label>
    <skos:definition xml:lang="en">The item was closed, with a reason.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#CommentedEvent">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#EventType"/>
    <rdfs:label xml:lang="en">Commented</rdfs:label>
    <skos:definition xml:lang="en">Someone added a remark.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Commit">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#LocatorKind"/>
    <rdfs:label xml:lang="en">Commit</rdfs:label>
    <skos:definition xml:lang="en">A commit of a repository, named by its hash, as of a trailer.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#CommitAuthor">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#PrincipalBasis"/>
    <rdfs:label xml:lang="en">Commit author</rdfs:label>
    <skos:definition xml:lang="en">The author of a commit whose trailer names the agent, where the configuration names that rule.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Completed">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#CloseReason"/>
    <rdfs:label xml:lang="en">Completed</rdfs:label>
    <skos:definition xml:lang="en">The work was done.</skos:definition>
    <plan:githubStateReason>completed</plan:githubStateReason>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Configuration">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#PrincipalBasis"/>
    <rdfs:label xml:lang="en">Configuration</rdfs:label>
    <skos:definition xml:lang="en">The person the configuration of a headless run names as its principal.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#ConfirmedEvent">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#EventType"/>
    <rdfs:label xml:lang="en">Confirmed</rdfs:label>
    <skos:definition xml:lang="en">A person confirmed a proposed item.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Create">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Capability"/>
    <rdfs:label xml:lang="en">Create</rdfs:label>
    <skos:definition xml:lang="en">The source can take a new item.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#DecidedEvent">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#EventType"/>
    <rdfs:label xml:lang="en">Decided</rdfs:label>
    <skos:definition xml:lang="en">A verdict was given on the item, with a note.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Declared">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Origin"/>
    <rdfs:label xml:lang="en">Declared</rdfs:label>
    <skos:definition xml:lang="en">Written as an item by a person or by a tool whose output is a statement of it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Deferred">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#State"/>
    <rdfs:label xml:lang="en">Deferred</rdfs:label>
    <skos:definition xml:lang="en">Set aside until a day, and not closed; a reopened event opens it again.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#DeferredEvent">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#EventType"/>
    <rdfs:label xml:lang="en">Deferred</rdfs:label>
    <skos:definition xml:lang="en">The item was set aside until a day.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Delete">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Capability"/>
    <rdfs:label xml:lang="en">Delete</rdfs:label>
    <skos:definition xml:lang="en">The source can remove an item; the model itself never does.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Derived">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Origin"/>
    <rdfs:label xml:lang="en">Derived</rdfs:label>
    <skos:definition xml:lang="en">Read from a place by a rule that is exact, as a comment marked TODO or a task line of a list.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Duplicate">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#CloseReason"/>
    <rdfs:label xml:lang="en">Duplicate</rdfs:label>
    <skos:definition xml:lang="en">Another item says the same; it is the one that is kept.</skos:definition>
    <plan:githubStateReason>duplicate</plan:githubStateReason>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Edit">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Capability"/>
    <rdfs:label xml:lang="en">Edit</rdfs:label>
    <skos:definition xml:lang="en">The source can change the title, the body or the labels of an item.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#EditedEvent">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#EventType"/>
    <rdfs:label xml:lang="en">Edited</rdfs:label>
    <skos:definition xml:lang="en">The title or the body changed.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Error">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Severity"/>
    <rdfs:label xml:lang="en">Error</rdfs:label>
    <skos:definition xml:lang="en">A serious problem.</skos:definition>
    <plan:sarifLevel>error</plan:sarifLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Event">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Event</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <skos:definition xml:lang="en">One thing that happened to an item, appended to its history and never changed, with its time and its actor.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#EventType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Event type</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">One of the cases of the union an item's history is made of.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#FieldAuthority">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Field authority</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">One of the ways the value of a field is settled when sources disagree.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#FileSpan">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#LocatorKind"/>
    <rdfs:label xml:lang="en">File span</rdfs:label>
    <skos:definition xml:lang="en">A file of a store, with a line or a range and the symbol that encloses it where there is one.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Finding">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#ItemKind"/>
    <rdfs:label xml:lang="en">Finding</rdfs:label>
    <skos:definition xml:lang="en">What an audit, a scan or a review found, with a severity and where it was seen.</skos:definition>
    <plan:webAnnotationMotivation>assessing</plan:webAnnotationMotivation>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#InProgress">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#State"/>
    <rdfs:label xml:lang="en">In progress</rdfs:label>
    <skos:definition xml:lang="en">Being worked on.</skos:definition>
    <plan:icalStatus>IN-PROCESS</plan:icalStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Inferred">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Origin"/>
    <rdfs:label xml:lang="en">Inferred</rdfs:label>
    <skos:definition xml:lang="en">Guessed by a heuristic or an agent; it is proposed until a person confirms it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Issue">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#ItemKind"/>
    <rdfs:label xml:lang="en">Issue</rdfs:label>
    <skos:definition xml:lang="en">A problem or a request that someone is to look at, with a title and a body.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Item">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Item</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">A piece of planning content of one of four kinds, with a stable id and a history of events from which its state is folded.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#ItemKind">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Item kind</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">One of the four kinds of item.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#LabeledEvent">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#EventType"/>
    <rdfs:label xml:lang="en">Labeled</rdfs:label>
    <skos:definition xml:lang="en">Labels were added or taken away.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#LatestWins">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#FieldAuthority"/>
    <rdfs:label xml:lang="en">Latest</rdfs:label>
    <skos:definition xml:lang="en">The change made last, by the time of its event, says what the field is.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Link">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Link</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">A typed relation between two items.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#LinkKind">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Link kind</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">One of the kinds of link between two items.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#LinkedEvent">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#EventType"/>
    <rdfs:label xml:lang="en">Linked</rdfs:label>
    <skos:definition xml:lang="en">A link to another item was added or taken away.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Locator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Locator</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">A way of naming a place: a file with a line, a web address, a row or a commit.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#LocatorKind">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Locator kind</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">One of the ways a place is named.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#MajorRevision">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Verdict"/>
    <rdfs:label xml:lang="en">Major revision</rdfs:label>
    <skos:definition xml:lang="en">The proposal is to be reworked and decided again.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#MinorRevision">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Verdict"/>
    <rdfs:label xml:lang="en">Minor revision</rdfs:label>
    <skos:definition xml:lang="en">The proposal is accepted after small changes.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#NotPlanned">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#CloseReason"/>
    <rdfs:label xml:lang="en">Not planned</rdfs:label>
    <skos:definition xml:lang="en">The work will not be done.</skos:definition>
    <plan:githubStateReason>not_planned</plan:githubStateReason>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Note">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Severity"/>
    <rdfs:label xml:lang="en">Note</rdfs:label>
    <skos:definition xml:lang="en">A minor problem or a chance to improve.</skos:definition>
    <plan:sarifLevel>note</plan:sarifLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Observation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Observation</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">What one source saw in one place at one time: the content, a locator, a hash of what was read and a fingerprint of its identity.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Open">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#State"/>
    <rdfs:label xml:lang="en">Open</rdfs:label>
    <skos:definition xml:lang="en">Confirmed and not started.</skos:definition>
    <plan:icalStatus>NEEDS-ACTION</plan:icalStatus>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#OpenedEvent">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#EventType"/>
    <rdfs:label xml:lang="en">Opened</rdfs:label>
    <skos:definition xml:lang="en">The item came to be, with its kind, title and body.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Origin">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Origin</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">How an item came to be: declared, derived or inferred.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#ParentOf">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#LinkKind"/>
    <rdfs:label xml:lang="en">Parent of</rdfs:label>
    <skos:definition xml:lang="en">The first item contains the second as a sub-item.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Patch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Patch</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">A change to write back to one source: add an item, change a state, add an event; a value, and nothing happens until it is applied.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#PersonOnly">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#FieldAuthority"/>
    <rdfs:label xml:lang="en">Person</rdfs:label>
    <skos:definition xml:lang="en">Only an event by a person changes the field; a change by an agent or a tool waits as a proposal.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Preview">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Preview</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">What applying a patch would do, with a hash of that account, so that applying is held to what was previewed.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#PrincipalBasis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Principal basis</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">One of the ways the person an agent acts for was established.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Proposed">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#State"/>
    <rdfs:label xml:lang="en">Proposed</rdfs:label>
    <skos:definition xml:lang="en">Found or inferred by a program or an agent, not yet confirmed by a person; it is counted in no plan until it is.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Read">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Capability"/>
    <rdfs:label xml:lang="en">Read</rdfs:label>
    <skos:definition xml:lang="en">The source can be read.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Reject">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Verdict"/>
    <rdfs:label xml:lang="en">Reject</rdfs:label>
    <skos:definition xml:lang="en">The proposal is refused.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#RelatesTo">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#LinkKind"/>
    <rdfs:label xml:lang="en">Relates to</rdfs:label>
    <skos:definition xml:lang="en">The two items are about the same matter, with no order between them.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#ReopenedEvent">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#EventType"/>
    <rdfs:label xml:lang="en">Reopened</rdfs:label>
    <skos:definition xml:lang="en">A closed or deferred item was opened again.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#SameAs">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#LinkKind"/>
    <rdfs:label xml:lang="en">Same as</rdfs:label>
    <skos:definition xml:lang="en">The two items say one thing; a person confirms the link.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Session">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#PrincipalBasis"/>
    <rdfs:label xml:lang="en">Session</rdfs:label>
    <skos:definition xml:lang="en">The person whose credentials or session launched the program, as the authenticated person of a tool server's session.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Severity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Severity</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">One of the three severities of an item.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#SeveritySetEvent">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#EventType"/>
    <rdfs:label xml:lang="en">Severity set</rdfs:label>
    <skos:definition xml:lang="en">The severity changed.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Source">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Source</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#SoftwareAgent"/>
    <skos:definition xml:lang="en">A program that reads observations from one kind of place and writes patches back to it, with the capabilities it declares.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#SourceWins">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#FieldAuthority"/>
    <rdfs:label xml:lang="en">Source</rdfs:label>
    <skos:definition xml:lang="en">The place the item was seen in says what the field is, and the store follows it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#StartedEvent">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#EventType"/>
    <rdfs:label xml:lang="en">Started</rdfs:label>
    <skos:definition xml:lang="en">Work began on the item.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#State">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">State</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">One of the five states an item is in, as folded from its events.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#StoreWins">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#FieldAuthority"/>
    <rdfs:label xml:lang="en">Store</rdfs:label>
    <skos:definition xml:lang="en">The store says what the field is, and the place follows it where it can be written.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Task">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#ItemKind"/>
    <rdfs:label xml:lang="en">Task</rdfs:label>
    <skos:definition xml:lang="en">A unit of work to be done, possibly with sub-items.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Todo">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#ItemKind"/>
    <rdfs:label xml:lang="en">Todo</rdfs:label>
    <skos:definition xml:lang="en">A note left in a place to do something there: a comment in a source file, a line of a list.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Trace">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Trace</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Derivation"/>
    <skos:definition xml:lang="en">The record that an item was derived from what a source observed, so that every place an item was seen can be found from it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Url">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#LocatorKind"/>
    <rdfs:label xml:lang="en">URL</rdfs:label>
    <skos:definition xml:lang="en">A web address, as of an issue on a Git host.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Verdict">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Verdict</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">One of the four verdicts a decision gives.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#Warning">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Severity"/>
    <rdfs:label xml:lang="en">Warning</rdfs:label>
    <skos:definition xml:lang="en">A problem.</skos:definition>
    <plan:sarifLevel>warning</plan:sarifLevel>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#actorId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Actor"/>
    <rdfs:label xml:lang="en">actor id</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The id of the actor.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#actorKind">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Actor"/>
    <rdfs:label xml:lang="en">actor kind</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#ActorKind"/>
    <skos:definition xml:lang="en">Whether the actor is a person, an agent or a tool.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#actorName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Actor"/>
    <rdfs:label xml:lang="en">actor name</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The name of the actor.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#contentHash">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Observation"/>
    <rdfs:label xml:lang="en">content hash</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The SHA-256 of the bytes the observation was read from, so that a change of the place is told from a change of the item.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#deferredUntil">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">deferred until</rdfs:label>
    <skos:definition xml:lang="en">The day an item set aside is to come back, YYYY-MM-DD, with the state deferred.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#eventActor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Event"/>
    <rdfs:label xml:lang="en">event actor</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Actor"/>
    <skos:definition xml:lang="en">Who wrote the event.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#eventAt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Event"/>
    <rdfs:label xml:lang="en">event at</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">When the event happened: ISO 8601 in UTC to the second.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#eventOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Event"/>
    <rdfs:label xml:lang="en">event of</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Item"/>
    <skos:definition xml:lang="en">The item the event happened to.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#eventType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Event"/>
    <rdfs:label xml:lang="en">event type</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#EventType"/>
    <skos:definition xml:lang="en">The case of the union the event is.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#externalSource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">external source</rdfs:label>
    <skos:definition xml:lang="en">The name of the source that gave an item or an event an id of another scheme (a ULID, a number of a Git host, an id of a build finding); with the external value it is the external id.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#externalValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">external value</rdfs:label>
    <skos:definition xml:lang="en">The id of another scheme, as the source named it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#fieldAuthority">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Source"/>
    <rdfs:label xml:lang="en">field authority</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#FieldAuthority"/>
    <skos:definition xml:lang="en">How the source's value of a field is weighed against the store's.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#fingerprint">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Observation"/>
    <rdfs:label xml:lang="en">fingerprint</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">A hash of what identifies the item in its place apart from where in the place it is, so that the identity survives a move.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#githubStateReason">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#CloseReason"/>
    <rdfs:label xml:lang="en">GitHub state reason</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The name of the reason GitHub gives for closing an issue, as the REST interface writes it (GitHub Docs, REST API 2026-03-10, update an issue: completed, not_planned, duplicate, reopened, or null); a name and no IRI.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#icalStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#State"/>
    <rdfs:label xml:lang="en">iCalendar status</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The name of the iCalendar to-do STATUS the state is closest to (RFC 5545 section 3.8.1.11: NEEDS-ACTION, COMPLETED, IN-PROCESS or CANCELLED for a VTODO); a name and no IRI.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#itemBlocker">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Item"/>
    <rdfs:label xml:lang="en">item blocker</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <skos:definition xml:lang="en">Whether the item holds work up; a flag of the record, and not a severity.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#itemCites">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Item"/>
    <rdfs:label xml:lang="en">item cites</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">A requirement the item cites, as written in the source.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#itemCloseReason">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Item"/>
    <rdfs:label xml:lang="en">item close reason</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#CloseReason"/>
    <skos:definition xml:lang="en">Why the item is closed, where it is.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#itemEngines">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Item"/>
    <rdfs:label xml:lang="en">item engines</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The engines the work applies to, or all, as the source names them.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#itemEvidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Item"/>
    <rdfs:label xml:lang="en">item evidence</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">A piece of evidence for the item: a commit, a test, a specification, a file with a line or a review, as the source writes it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#itemGoals">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Item"/>
    <rdfs:label xml:lang="en">item goals</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The goals the work serves, as the source names them.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#itemId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Item"/>
    <rdfs:label xml:lang="en">item id</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The stable id of the item; it does not change when the item moves between places.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#itemKind">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Item"/>
    <rdfs:label xml:lang="en">item kind</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#ItemKind"/>
    <skos:definition xml:lang="en">The kind of the item.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#itemMotivation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Item"/>
    <rdfs:label xml:lang="en">item motivation</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The name of the Web Annotation motivation of the record the item was read from, one of the thirteen (Web Annotation Data Model, section 3.3.5); a name and no IRI.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#itemOrigin">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Item"/>
    <rdfs:label xml:lang="en">item origin</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Origin"/>
    <skos:definition xml:lang="en">How the item came to be.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#itemPriority">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Item"/>
    <rdfs:label xml:lang="en">item priority</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">How important the work is, as the source writes it (P1 to P3 in a typed issue); not a severity.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#itemSeverity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Item"/>
    <rdfs:label xml:lang="en">item severity</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Severity"/>
    <skos:definition xml:lang="en">The severity of the item.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#itemSize">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Item"/>
    <rdfs:label xml:lang="en">item size</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">How large the work is, as the source writes it (xs to xl in a typed issue).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#itemSource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Item"/>
    <rdfs:label xml:lang="en">item source</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">Where a finding came from: the tool, the rule, the file and the line (the SARIF ruleId and physicalLocation, sections 3.27.5 and 3.29, are the standard's names for the last three).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#itemState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Item"/>
    <rdfs:label xml:lang="en">item state</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#State"/>
    <skos:definition xml:lang="en">The state of the item, folded from its events.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#itemTarget">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Item"/>
    <rdfs:label xml:lang="en">item target</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">What the record is about: a file, a page and a quote (the quote is the exact text of a Web Annotation TextQuoteSelector, section 4.2.4).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#linkFrom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Link"/>
    <rdfs:label xml:lang="en">link from</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Item"/>
    <skos:definition xml:lang="en">The item the link starts at.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#linkKind">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Link"/>
    <rdfs:label xml:lang="en">link kind</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#LinkKind"/>
    <skos:definition xml:lang="en">The kind of the link.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#linkTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Link"/>
    <rdfs:label xml:lang="en">link to</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Item"/>
    <skos:definition xml:lang="en">The item the link ends at.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#locatorKind">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Locator"/>
    <rdfs:label xml:lang="en">locator kind</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#LocatorKind"/>
    <skos:definition xml:lang="en">The way the place is named.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#locatorValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Locator"/>
    <rdfs:label xml:lang="en">locator value</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The name of the place, in the form of its kind.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#observationLocator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Observation"/>
    <rdfs:label xml:lang="en">observation locator</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Locator"/>
    <skos:definition xml:lang="en">Where the source read it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#observedAt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Observation"/>
    <rdfs:label xml:lang="en">observed at</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">When the source read it: ISO 8601 in UTC to the second.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#observedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Observation"/>
    <rdfs:label xml:lang="en">observed by</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Source"/>
    <skos:definition xml:lang="en">The source that read the observation.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#patchOp">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Patch"/>
    <rdfs:label xml:lang="en">patch operation</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The operation: add-item, change-state, add-event, link or confirm.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#patchTarget">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Patch"/>
    <rdfs:label xml:lang="en">patch target</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Source"/>
    <skos:definition xml:lang="en">The source the patch is to be written to; a write has an explicit target.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#previewHash">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Preview"/>
    <rdfs:label xml:lang="en">preview hash</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The SHA-256 of the preview, which a headless check mode compares with the plan it is told to apply.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#previewOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Preview"/>
    <rdfs:label xml:lang="en">preview of</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Patch"/>
    <skos:definition xml:lang="en">The patch the preview is about.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#principalBasis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Actor"/>
    <rdfs:label xml:lang="en">principal basis</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#PrincipalBasis"/>
    <skos:definition xml:lang="en">How the principal of an agent was established; stored with the actor, which names the principal with prov:actedOnBehalfOf.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#sarifLevel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Severity"/>
    <rdfs:label xml:lang="en">SARIF level</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The name of the SARIF result level the severity is: error, warning or note (SARIF 2.1.0 Plus Errata 01, sections 3.27.9 and 3.27.10: the levels that apply where the result's kind is fail); a name and no IRI.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#seenIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Item"/>
    <rdfs:label xml:lang="en">seen in</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Observation"/>
    <skos:definition xml:lang="en">An observation of the item, in one place; an item has one for every place it was seen.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#sourceCapability">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Source"/>
    <rdfs:label xml:lang="en">source capability</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Capability"/>
    <skos:definition xml:lang="en">An ability the source declares.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#sourceName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Source"/>
    <rdfs:label xml:lang="en">source name</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The name of the source, as the package that holds it is named.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#sourceSeverity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Item"/>
    <rdfs:label xml:lang="en">source severity</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The severity as the source wrote it, where the source has more levels than the three of plan:Severity; the item keeps this value and the three are not an exact expression of it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#traceItem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Trace"/>
    <rdfs:label xml:lang="en">trace item</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Item"/>
    <skos:definition xml:lang="en">The item that was derived.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#traceObservation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Trace"/>
    <rdfs:label xml:lang="en">trace observation</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#Observation"/>
    <skos:definition xml:lang="en">The observation it was derived from.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning#webAnnotationMotivation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/planning#ItemKind"/>
    <rdfs:label xml:lang="en">Web Annotation motivation</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The name of the Web Annotation motivation the kind is closest to (Web Annotation Data Model, section 3.3.5, one of the thirteen motivations; the IRI of each is in the namespace http://www.w3.org/ns/oa# of the Web Annotation Vocabulary, section 2.3).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/planning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <ns1:description xml:lang="en">The vocabulary of Planning: the four kinds of planning item, the events that make their history and the states folded from them, the actors, the observations of what a source saw and where, the traces and links between items, the patches that write a change back and their previews, the sources that read and write, and the closed code lists the model branches on.</ns1:description>
    <rdfs:label xml:lang="en">Planning</rdfs:label>
    <owl:versionIRI rdf:resource="https://www.intellectualfrontiers.com/ontology/planning/1.0.0"/>
    <owl:versionInfo>1.0.0</owl:versionInfo>
  </rdf:Description>
</rdf:RDF>
