mzid:term-ifqs-QualityObjective a mz:OntologyTerm ;
    rdfs:label "ifqs:QualityObjective"@en ;
    mz:addedOn "2026-11-17" ;
    mz:basis mz:Unaligned ;
    mz:decision mzid:decision-ifqs-QualityObjective ;
    mz:definedBy "0021-ifqs FR-032" ;
    mz:justification "Examined: ISO 9001 clause 6.2 (quality objectives) and OpenTelemetry's metric data model (a measure, no target); neither publishes an IRI for an objective with a target and an error budget. OpenSLO is a community specification and not a consensus standard (to verify). Kept unaligned by the owner's decision of 2026-11-17 (issue #10); reviewed again by 2027-02-15." ;
    mz:termIri "https://www.intellectualfrontiers.com/ontology/ifqs#QualityObjective" .

