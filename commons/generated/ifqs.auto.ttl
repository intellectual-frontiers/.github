ifqs:Assessor a ifqs:Audience ;
    rdfs:label "assessor"@en ;
    skos:definition "A person who verifies the evidence: the full records, with secrets and personal data redacted only."@en .

ifqs:AssessorPack a owl:Class ;
    rdfs:label "Assessor pack"@en ;
    rdfs:subClassOf dcat:Dataset ;
    skos:definition "The self-contained, offline-verifiable bundle of the evidence of one revision and span, for a person who has to check it."@en .

ifqs:Audience a owl:Class ;
    rdfs:label "Audience"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "public, assessor or internal: who a rendering of evidence is for."@en .

ifqs:Cancelled a ifqs:TestOutcome ;
    rdfs:label "cancelled"@en ;
    skos:definition "The case started and did not end before its process did."@en ;
    ifqs:outcomeWord "cancelled" .

ifqs:Capa a owl:Class ;
    rdfs:label "CAPA"@en ;
    rdfs:subClassOf prov:Plan ;
    skos:definition "A corrective and preventive action: the plan that corrects a nonconformance, names the test that verifies it and is closed by a named person."@en .

ifqs:CapaClosed a ifqs:CapaState ;
    rdfs:label "closed"@en ;
    skos:definition "A named person approved the closure of a verified CAPA, recorded as a Decision."@en .

ifqs:CapaOpen a ifqs:CapaState ;
    rdfs:label "open"@en ;
    skos:definition "The corrective action is stated and its named test has not passed after the corrective change."@en .

ifqs:CapaState a owl:Class ;
    rdfs:label "CAPA state"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "open, verified or closed, in that order."@en .

ifqs:CapaVerified a ifqs:CapaState ;
    rdfs:label "verified"@en ;
    skos:definition "The named test passed in a run after the corrective change; a person has not yet approved the closure."@en .

ifqs:Due a ifqs:FreshnessState ;
    rdfs:label "due"@en ;
    skos:definition "The proof is within a tenth of its cadence of its end."@en .

ifqs:E0 a ifqs:EvidenceGrade ;
    rdfs:label "E0 none"@en ;
    skos:definition "No evidence: a requirement with no record of any kind."@en ;
    ifqs:gradeRank 0 .

ifqs:E1 a ifqs:EvidenceGrade ;
    rdfs:label "E1 stated"@en ;
    skos:definition "A person or an agent says the requirement is met; nothing ran."@en ;
    ifqs:gradeRank 1 .

ifqs:E2 a ifqs:EvidenceGrade ;
    rdfs:label "E2 reviewed"@en ;
    skos:definition "A review is recorded against the requirement, by a person or by an agent (said to be an agent's)."@en ;
    ifqs:gradeRank 2 .

ifqs:E3 a ifqs:EvidenceGrade ;
    rdfs:label "E3 tested"@en ;
    skos:definition "An automated run proved the requirement and its record exists."@en ;
    ifqs:gradeRank 3 .

ifqs:E4 a ifqs:EvidenceGrade ;
    rdfs:label "E4 attested"@en ;
    skos:definition "The run is kept on the quality branch, chained, signed and linked to its commit, so that a third party can verify it."@en ;
    ifqs:gradeRank 4 .

ifqs:E5 a ifqs:EvidenceGrade ;
    rdfs:label "E5 observed"@en ;
    skos:definition "A probe of the system in operation reports the requirement met: operational truth."@en ;
    ifqs:gradeRank 5 .

ifqs:Evidence a owl:Class ;
    rdfs:label "Evidence"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "What a run, a review or a probe shows of one requirement, with the grade it carries and its freshness."@en .

ifqs:EvidenceFile a owl:Class ;
    rdfs:label "Evidence file"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "The immutable file of one run on the quality branch, with its digest and the digest of the file before it."@en .

ifqs:EvidenceGrade a owl:Class ;
    rdfs:label "Evidence grade"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "E0 to E5: how much a piece of evidence is worth."@en .

ifqs:Fail a ifqs:TestOutcome ;
    rdfs:label "fail"@en ;
    skos:definition "The case ran and an assertion did not hold."@en ;
    ifqs:outcomeWord "fail" .

ifqs:Fresh a ifqs:FreshnessState ;
    rdfs:label "fresh"@en ;
    skos:definition "The proof is within its cadence and nothing in its chain changed after its run."@en .

ifqs:FreshnessState a owl:Class ;
    rdfs:label "Freshness state"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "fresh, due or stale."@en .

ifqs:Internal a ifqs:Audience ;
    rdfs:label "internal"@en ;
    skos:definition "The harness's own people, through its own console."@en .

ifqs:Nonconformance a owl:Class ;
    rdfs:label "Nonconformance"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "A failure of a requirement to be met, or a stale proof of it, opened by the system itself (ISO 9001 clause 10.2's nonconformity)."@en .

ifqs:NonconformanceClosed a ifqs:NonconformanceState ;
    rdfs:label "closed"@en ;
    skos:definition "Its CAPA is closed: verified by a named test and approved by a named person."@en .

ifqs:NonconformanceOpen a ifqs:NonconformanceState ;
    rdfs:label "open"@en ;
    skos:definition "The system opened it and no CAPA of it is closed."@en .

ifqs:NonconformanceState a owl:Class ;
    rdfs:label "Nonconformance state"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "open or closed."@en .

ifqs:NotRun a ifqs:TestOutcome ;
    rdfs:label "not run"@en ;
    skos:definition "A planned case, check or requirement that never started, with the reason: it is never counted as passed."@en ;
    ifqs:outcomeWord "not_run" .

ifqs:Pass a ifqs:TestOutcome ;
    rdfs:label "pass"@en ;
    skos:definition "The case ran and its assertions held."@en ;
    ifqs:outcomeWord "pass" .

ifqs:Public a ifqs:Audience ;
    rdfs:label "public"@en ;
    skos:definition "Anyone: figures, grades and failures with their requirement and reason, and nothing that names a person, customer, host or private repository."@en .

ifqs:QualityObjective a owl:Class ;
    rdfs:label "Quality objective"@en ;
    skos:definition "A success criterion as a metric, with a target, a unit, an error budget and the window it is spent in."@en .

ifqs:QualityTier a owl:Class ;
    rdfs:label "Quality tier"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Tier 0 (evidence exists), Tier 1 (the system reports itself) or Tier 2 (people see and prove)."@en .

ifqs:ReviewDebt a owl:Class ;
    rdfs:label "Review debt"@en ;
    skos:definition "The number of requirements whose best fresh evidence is E1 or E2, counted at a revision."@en .

ifqs:Skip a ifqs:TestOutcome ;
    rdfs:label "skip"@en ;
    skos:definition "A runner skipped the case on purpose, with its reason."@en ;
    ifqs:outcomeWord "skip" .

ifqs:Stale a ifqs:FreshnessState ;
    rdfs:label "stale"@en ;
    skos:definition "The proof is past its cadence or a file of its chain changed after its run: it opens a nonconformance and does not count at its grade."@en .

ifqs:TestCase a owl:Class ;
    rdfs:label "Test case"@en ;
    rdfs:subClassOf prov:Activity ;
    skos:definition "One case of a run, with its outcome, its reason where it has one and the requirements it proves."@en .

ifqs:TestOutcome a owl:Class ;
    rdfs:label "Test outcome"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "pass, fail, skip, todo, cancelled or not run."@en .

ifqs:TestRun a owl:Class ;
    rdfs:label "Test run"@en ;
    rdfs:subClassOf prov:Activity ;
    skos:definition "One run of a suite: its trace, the revision it tested and its cases; kept as one file of the record of 0008-test-evidence."@en .

ifqs:Tier0 a ifqs:QualityTier ;
    rdfs:label "Tier 0"@en ;
    skos:definition "Evidence exists: one canonical record per run, kept immutable and chained on the quality branch."@en ;
    ifqs:tierNumber 0 .

ifqs:Tier1 a ifqs:QualityTier ;
    rdfs:label "Tier 1"@en ;
    skos:definition "The system reports itself: grades, review debt, freshness, nonconformance, CAPA and objectives."@en ;
    ifqs:tierNumber 1 .

ifqs:Tier2 a ifqs:QualityTier ;
    rdfs:label "Tier 2"@en ;
    skos:definition "People see and prove: the console, attested samples, pre-registered plans, mutation runs, the public page and the assessor pack."@en ;
    ifqs:tierNumber 2 .

ifqs:Todo a ifqs:TestOutcome ;
    rdfs:label "todo"@en ;
    skos:definition "The case is declared and not yet written, with its reason."@en ;
    ifqs:outcomeWord "todo" .

ifqs:approvedBy a owl:DatatypeProperty ;
    rdfs:domain ifqs:Capa ;
    rdfs:label "approved by"@en ;
    rdfs:range xsd:string ;
    skos:definition "The named person who approved the closure."@en .

ifqs:approvedOn a owl:DatatypeProperty ;
    rdfs:domain ifqs:Capa ;
    rdfs:label "approved on"@en ;
    rdfs:range xsd:string ;
    skos:definition "The day (YYYY-MM-DD) of the approval."@en .

ifqs:arisesFrom a owl:ObjectProperty ;
    rdfs:domain ifqs:Nonconformance ;
    rdfs:label "arises from"@en ;
    rdfs:range ifqs:Evidence ;
    skos:definition "The evidence whose failure or staleness opened the nonconformance."@en .

ifqs:belowGrade a owl:ObjectProperty ;
    rdfs:domain ifqs:ReviewDebt ;
    rdfs:label "below grade"@en ;
    rdfs:range ifqs:EvidenceGrade ;
    skos:definition "The grade a requirement's best evidence must reach to be out of debt: E3."@en .

ifqs:budgetWindow a owl:DatatypeProperty ;
    rdfs:domain ifqs:QualityObjective ;
    rdfs:label "budget window"@en ;
    rdfs:range xsd:string ;
    skos:definition "The window the error budget is spent in, as an ISO 8601 duration."@en .

ifqs:capaState a owl:ObjectProperty ;
    rdfs:domain ifqs:Capa ;
    rdfs:label "has CAPA state"@en ;
    rdfs:range ifqs:CapaState ;
    skos:definition "open, verified or closed."@en .

ifqs:correctiveAction a owl:DatatypeProperty ;
    rdfs:domain ifqs:Capa ;
    rdfs:label "corrective action"@en ;
    rdfs:range xsd:string ;
    skos:definition "What is done to correct the nonconformance and stop it recurring."@en .

ifqs:correctsNonconformance a owl:ObjectProperty ;
    rdfs:domain ifqs:Capa ;
    rdfs:label "corrects nonconformance"@en ;
    rdfs:range ifqs:Nonconformance ;
    skos:definition "The nonconformance the CAPA corrects."@en .

ifqs:debtValue a owl:DatatypeProperty ;
    rdfs:domain ifqs:ReviewDebt ;
    rdfs:label "debt value"@en ;
    rdfs:range xsd:integer ;
    skos:definition "The count of requirements whose best fresh evidence is below the grade."@en .

ifqs:errorBudget a owl:DatatypeProperty ;
    rdfs:domain ifqs:QualityObjective ;
    rdfs:label "error budget"@en ;
    rdfs:range xsd:string ;
    skos:definition "How much the measure may miss its target within the window, as a decimal number written as text."@en .

ifqs:evidencePath a owl:DatatypeProperty ;
    rdfs:domain ifqs:EvidenceFile ;
    rdfs:label "evidence path"@en ;
    rdfs:range xsd:string ;
    skos:definition "The path on the quality branch: quality/evidence/YYYY/MM/DD/<trace id>.otlp.json."@en .

ifqs:evidenceSha256 a owl:DatatypeProperty ;
    rdfs:domain ifqs:EvidenceFile ;
    rdfs:label "evidence SHA-256"@en ;
    rdfs:range xsd:string ;
    skos:definition "The SHA-256 of the file's bytes, in lower-case hexadecimal."@en .

ifqs:forRequirement a owl:DatatypeProperty ;
    rdfs:domain ifqs:Evidence ;
    rdfs:label "for requirement"@en ;
    rdfs:range xsd:string ;
    skos:definition "The requirement the evidence is of, as `NNNN-slug FR-nnn`."@en .

ifqs:freshness a owl:ObjectProperty ;
    rdfs:domain ifqs:Evidence ;
    rdfs:label "freshness"@en ;
    rdfs:range ifqs:FreshnessState ;
    skos:definition "fresh, due or stale."@en .

ifqs:grade a owl:ObjectProperty ;
    rdfs:domain ifqs:Evidence ;
    rdfs:label "grade"@en ;
    rdfs:range ifqs:EvidenceGrade ;
    skos:definition "The grade the evidence carries, E0 to E5."@en .

ifqs:gradeRank a owl:DatatypeProperty ;
    rdfs:domain ifqs:EvidenceGrade ;
    rdfs:label "grade rank"@en ;
    rdfs:range xsd:integer ;
    skos:definition "The grade's number, 0 to 5, by which grades are compared."@en .

ifqs:inRun a owl:ObjectProperty ;
    rdfs:domain ifqs:TestCase ;
    rdfs:label "in run"@en ;
    rdfs:range ifqs:TestRun ;
    skos:definition "The run the case is of."@en .

ifqs:measuredAtRevision a owl:DatatypeProperty ;
    rdfs:domain ifqs:ReviewDebt ;
    rdfs:label "measured at revision"@en ;
    rdfs:range xsd:string ;
    skos:definition "The revision at which the debt was counted."@en .

ifqs:metricName a owl:DatatypeProperty ;
    rdfs:domain ifqs:QualityObjective ;
    rdfs:label "metric name"@en ;
    rdfs:range xsd:string ;
    skos:definition "The OpenTelemetry metric the objective is measured by."@en .

ifqs:nonconformanceState a owl:ObjectProperty ;
    rdfs:domain ifqs:Nonconformance ;
    rdfs:label "nonconformance state"@en ;
    rdfs:range ifqs:NonconformanceState ;
    skos:definition "open or closed."@en .

ifqs:ofRun a owl:ObjectProperty ;
    rdfs:domain ifqs:EvidenceFile ;
    rdfs:label "of run"@en ;
    rdfs:range ifqs:TestRun ;
    skos:definition "The run the file keeps."@en .

ifqs:openedBy a owl:DatatypeProperty ;
    rdfs:domain ifqs:Nonconformance ;
    rdfs:label "opened by"@en ;
    rdfs:range xsd:string ;
    skos:definition "`system`, or the role of the person who opened it."@en .

ifqs:outcome a owl:ObjectProperty ;
    rdfs:domain ifqs:TestCase ;
    rdfs:label "outcome"@en ;
    rdfs:range ifqs:TestOutcome ;
    skos:definition "What became of the case: the value of ifc.test.outcome."@en .

ifqs:outcomeWord a owl:DatatypeProperty ;
    rdfs:domain ifqs:TestOutcome ;
    rdfs:label "outcome word"@en ;
    rdfs:range xsd:string ;
    skos:definition "The word the outcome is written with in the record: pass, fail, skip, todo, cancelled or not_run."@en .

ifqs:packAudience a owl:ObjectProperty ;
    rdfs:domain ifqs:AssessorPack ;
    rdfs:label "pack audience"@en ;
    rdfs:range ifqs:Audience ;
    skos:definition "Who the pack is for, and so what is redacted from it."@en .

ifqs:packRevision a owl:DatatypeProperty ;
    rdfs:domain ifqs:AssessorPack ;
    rdfs:label "pack revision"@en ;
    rdfs:range xsd:string ;
    skos:definition "The revision the pack was made at."@en .

ifqs:packSha256 a owl:DatatypeProperty ;
    rdfs:domain ifqs:AssessorPack ;
    rdfs:label "pack SHA-256"@en ;
    rdfs:range xsd:string ;
    skos:definition "The SHA-256 of the pack, in lower-case hexadecimal."@en .

ifqs:previousSha256 a owl:DatatypeProperty ;
    rdfs:domain ifqs:EvidenceFile ;
    rdfs:label "previous SHA-256"@en ;
    rdfs:range xsd:string ;
    skos:definition "The SHA-256 of the file before it on the branch (64 zeros for the first): the in-file chain."@en .

ifqs:producedByRun a owl:ObjectProperty ;
    rdfs:domain ifqs:Evidence ;
    rdfs:label "produced by run"@en ;
    rdfs:range ifqs:TestRun ;
    skos:definition "The run that produced the evidence, where a run did."@en .

ifqs:provedAt a owl:DatatypeProperty ;
    rdfs:domain ifqs:Evidence ;
    rdfs:label "proved at"@en ;
    rdfs:range xsd:string ;
    skos:definition "The day or time (ISO 8601) of the proof."@en .

ifqs:proves a owl:DatatypeProperty ;
    rdfs:domain ifqs:TestCase ;
    rdfs:label "proves"@en ;
    rdfs:range xsd:string ;
    skos:definition "A requirement the case proves, as `NNNN-slug FR-nnn`."@en .

ifqs:reason a owl:DatatypeProperty ;
    rdfs:domain ifqs:TestCase ;
    rdfs:label "reason"@en ;
    rdfs:range xsd:string ;
    skos:definition "Why the case was skipped, not run or left to do (ifc.test.reason)."@en .

ifqs:reviewedByRole a owl:DatatypeProperty ;
    rdfs:domain ifqs:Evidence ;
    rdfs:label "reviewed by role"@en ;
    rdfs:range xsd:string ;
    skos:definition "The role that reviewed, for evidence of grade E2; `agent` where an agent did."@en .

ifqs:statement a owl:DatatypeProperty ;
    rdfs:domain ifqs:Nonconformance ;
    rdfs:label "statement"@en ;
    rdfs:range xsd:string ;
    skos:definition "What was not met, in one sentence."@en .

ifqs:storedIn a owl:ObjectProperty ;
    rdfs:domain ifqs:Evidence ;
    rdfs:label "stored in"@en ;
    rdfs:range ifqs:EvidenceFile ;
    skos:definition "The evidence file that keeps the run."@en .

ifqs:targetUnit a owl:DatatypeProperty ;
    rdfs:domain ifqs:QualityObjective ;
    rdfs:label "target unit"@en ;
    rdfs:range xsd:string ;
    skos:definition "The unit of the target, in the Unified Code for Units of Measure where one exists."@en .

ifqs:targetValue a owl:DatatypeProperty ;
    rdfs:domain ifqs:QualityObjective ;
    rdfs:label "target value"@en ;
    rdfs:range xsd:string ;
    skos:definition "The target, as a decimal number written as text."@en .

ifqs:testedRevision a owl:DatatypeProperty ;
    rdfs:domain ifqs:TestRun ;
    rdfs:label "tested revision"@en ;
    rdfs:range xsd:string ;
    skos:definition "The commit the run tested (the resource attribute vcs.ref.head.revision)."@en .

ifqs:tierNumber a owl:DatatypeProperty ;
    rdfs:domain ifqs:QualityTier ;
    rdfs:label "tier number"@en ;
    rdfs:range xsd:integer ;
    skos:definition "0, 1 or 2."@en .

ifqs:traceId a owl:DatatypeProperty ;
    rdfs:domain ifqs:TestRun ;
    rdfs:label "trace id"@en ;
    rdfs:range xsd:string ;
    skos:definition "The OpenTelemetry trace id of the run, in 32 lower-case hexadecimal digits: the name of its file."@en .

ifqs:verifiedByTest a owl:DatatypeProperty ;
    rdfs:domain ifqs:Capa ;
    rdfs:label "verified by test"@en ;
    rdfs:range xsd:string ;
    skos:definition "The test whose passing, after the corrective change, verifies the CAPA: its file and name."@en .

<https://www.intellectualfrontiers.com/ontology/ifqs> a owl:Ontology ;
    <http://purl.org/dc/terms/description> "The vocabulary of the Intellectual Frontiers Quality System: test runs and cases, evidence and its grades, nonconformance and CAPA, quality objectives, review debt, tiers, audiences and the assessor pack."@en ;
    rdfs:label "IFQS"@en ;
    owl:versionIRI ifqsv:1.0.0 ;
    owl:versionInfo "1.0.0" .
