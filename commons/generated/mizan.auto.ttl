mz:Adopts a mz:Basis ;
    rdfs:label "adopts"@en ;
    skos:definition "The term is the standard's own, by its IRI."@en .

mz:Authority a owl:Class ;
    rdfs:label "Authority"@en ;
    skos:definition "A law or regulation a requirement or a term comes from, cited by its title, part and section."@en .

mz:Basis a owl:Class ;
    rdfs:label "Basis"@en ;
    skos:definition "How a term relates to a standard: adopts, specializes, maps or is unaligned."@en .

mz:Citations a mz:ConformanceRequirement ;
    rdfs:label "citations"@en ;
    skos:definition "A specification of another folder is cited with its repository, and a bare citation names a specification of the folder that exists."@en ;
    mz:enforcedBy "bun commons/tools/mizan-check.ts (0003-mizan FR-004)" .

mz:ConformanceLevel a owl:Class ;
    rdfs:label "Conformance level"@en ;
    skos:definition "L0 registered, L1 core, L2 standards or L3 governed: how much of Mizan a subject is held to, each level adding to the one below."@en .

mz:ConformanceRequirement a owl:Class ;
    rdfs:label "Conformance requirement"@en ;
    skos:definition "One thing a conformance level asks of a subject, and the rules or checks that prove it."@en .

mz:Core a mz:ConformanceLevel ;
    rdfs:label "L1 core"@en ;
    skos:definition "The subject keeps its own specifications and proves them: its own spec kit and verify, and Mizan's core rules."@en ;
    mz:entails mz:Citations,
        mz:EarsRequirements,
        mz:GherkinScenarios,
        mz:OwnVerify,
        mz:ProofRows,
        mz:ShrinkOnlyBaselines,
        mz:SourceTrace,
        mz:SpecKit ;
    mz:levelRank 1 .

mz:Decision a owl:Class ;
    rdfs:label "Decision"@en ;
    skos:definition "The record of why a term is unaligned, due within 90 days of the term; a harness may link it to its own record."@en .

mz:EarsRequirements a mz:ConformanceRequirement ;
    rdfs:label "EARS requirements"@en ;
    skos:definition "Every requirement is worded with an RFC 2119 keyword in one of the EARS patterns."@en ;
    mz:rule "mizan/requirement-ears",
        "mizan/requirement-keyword" .

mz:Environment a mz:RungKind ;
    rdfs:label "environment"@en ;
    skos:definition "The rung is the working environment everything is built in, required of a harness that claims a regulated domain; it relies on no rung and no rung relies on it."@en .

mz:Exception a owl:Class ;
    rdfs:label "Exception"@en ;
    skos:definition "A recorded choice of a tool that is not TypeScript, with why TypeScript is not enough, its pinned version, its isolation and its platforms."@en .

mz:Export a mz:IntegrationDirection ;
    rdfs:label "export"@en .

mz:Federal a mz:JurisdictionLevel ;
    rdfs:label "federal"@en .

mz:GherkinScenarios a mz:ConformanceRequirement ;
    rdfs:label "Gherkin scenarios"@en ;
    skos:definition "Every acceptance scenario is Given, When, Then and cites the requirements it exercises."@en ;
    mz:rule "mizan/scenario-form" .

mz:Governed a mz:ConformanceLevel ;
    rdfs:label "L3 governed"@en ;
    skos:definition "The subject is under change control and release control: every commit names an issue, every work has a release record and the quality records are kept."@en ;
    mz:entails mz:Ifccm,
        mz:Ifqs,
        mz:Ifr ;
    mz:levelRank 3 .

mz:Ifccm a mz:ConformanceRequirement ;
    rdfs:label "IFCCM"@en ;
    skos:definition "Every commit names an issue, and a change is judged against its declared phase of enforcement (0020-ifccm)."@en ;
    mz:rule "changes/*" .

mz:Ifqs a mz:ConformanceRequirement ;
    rdfs:label "IFQS"@en ;
    skos:definition "The quality records of the subject are kept and judged (0021-ifqs)."@en ;
    mz:enforcedBy "bun commons/ts/quality/quality.ts" .

mz:Ifr a mz:ConformanceRequirement ;
    rdfs:label "IFR"@en ;
    skos:definition "Every work has a release record, and a version grows by the scheme of its kind (0026-works-versioning)."@en ;
    mz:rule "versions/*" .

mz:Import a mz:IntegrationDirection ;
    rdfs:label "import"@en .

mz:ImportRecord a owl:Class ;
    rdfs:label "Import record"@en ;
    skos:definition "The provenance of one import: what, from where, when, by which generator and with which hash."@en .

mz:Integration a owl:Class ;
    rdfs:label "Integration"@en ;
    skos:definition "An import of a standard into typed TypeScript, or an export of an ontology in a well-known form."@en .

mz:IntegrationDirection a owl:Class ;
    rdfs:label "Integration direction"@en ;
    skos:definition "import or export."@en .

mz:International a mz:JurisdictionLevel ;
    rdfs:label "international"@en .

mz:Jurisdiction a owl:Class ;
    rdfs:label "Jurisdiction"@en ;
    skos:definition "The federal, state, local or international body whose law it is."@en .

mz:JurisdictionLevel a owl:Class ;
    rdfs:label "Jurisdiction level"@en ;
    skos:definition "federal, state, local or international."@en .

mz:Local a mz:JurisdictionLevel ;
    rdfs:label "local"@en .

mz:Manifest a mz:ConformanceRequirement ;
    rdfs:label "manifest"@en ;
    skos:definition "The subject declares a manifest: its name, its level, the path of its spec kit, its verify command, its version and its exports."@en ;
    mz:enforcedBy "the manifest check of 0028-conformance-levels, which reads each commons/<name>/library.ts as data (0027-commons-libraries)" .

mz:Maps a mz:Basis ;
    rdfs:label "maps"@en ;
    skos:definition "The term has a mapping, such as skos:exactMatch, to a standard's term."@en .

mz:Observer a mz:RungKind ;
    rdfs:label "observer"@en ;
    skos:definition "The rung records and proves what the other rungs do, and is required of a harness that claims a regulated domain; no rung relies on it."@en .

mz:OntologyTerm a owl:Class ;
    rdfs:label "Ontology term"@en ;
    skos:definition "A class, a property, an individual or a code list of an ontology, and the basis it rests on."@en .

mz:Optional a mz:RungKind ;
    rdfs:label "optional"@en ;
    skos:definition "A harness may have the rung: it relies on no rung and no rung relies on it."@en .

mz:OwnVerify a mz:ConformanceRequirement ;
    rdfs:label "own verify"@en ;
    skos:definition "The subject's verify command runs the compiler, the specification checker, the rules of its level on its own spec kit and its tests, and fails if any fails."@en ;
    mz:enforcedBy "the manifest check, which reads the verify script of the package (0027-commons-libraries FR-005)" .

mz:ProofRows a mz:ConformanceRequirement ;
    rdfs:label "proof rows"@en ;
    skos:definition "Every requirement has exactly one row in the register of what proves it, and none for a requirement that does not exist."@en ;
    mz:enforcedBy "bun commons/tools/mizan-check.ts (0003-mizan FR-005)" .

mz:Registered a mz:ConformanceLevel ;
    rdfs:label "L0 registered"@en ;
    skos:definition "The subject is known: it has a manifest, a verify command and a version."@en ;
    mz:entails mz:Manifest,
        mz:VerifyCommand,
        mz:Version ;
    mz:levelRank 0 .

mz:Required a mz:RungKind ;
    rdfs:label "required"@en ;
    skos:definition "Every harness has the rung and builds on the rungs it names."@en .

mz:Requirement a owl:Class ;
    rdfs:label "Requirement"@en ;
    skos:definition "One numbered requirement of a specification, with the authority it comes from where it comes from law."@en .

mz:Rung a owl:Class ;
    rdfs:label "Rung"@en ;
    skos:definition "One level of the ladder, with its number, purpose, homes, what it may rely on and what proves it."@en .

mz:RungKind a owl:Class ;
    rdfs:label "Rung kind"@en ;
    skos:definition "required, optional, observer or environment."@en .

mz:ShrinkOnlyBaselines a mz:ConformanceRequirement ;
    rdfs:label "shrink-only baselines"@en ;
    skos:definition "A finding is held by a baseline that only shrinks: a new finding fails, and so does a line that no longer occurs."@en ;
    mz:enforcedBy "the judgement of every check against its baseline (0003-mizan FR-015)" .

mz:SourceTrace a mz:ConformanceRequirement ;
    rdfs:label "source trace"@en ;
    skos:definition "Sources and tests cite the specifications they come from (`Spec:` and `Proves:` lines, `proves(...)` calls), and every citation names a requirement that exists."@en ;
    mz:enforcedBy "the trace of the subject's sources and tests (0015-trace)" .

mz:Spec a owl:Class ;
    rdfs:label "Specification"@en ;
    skos:definition "A specification of a spec-kit folder, with its identifier and status."@en .

mz:SpecKit a mz:ConformanceRequirement ;
    rdfs:label "spec kit"@en ;
    skos:definition "The subject keeps a spec kit of its own, in the form of 0003-mizan, numbered from 0001 in its own registry."@en ;
    mz:enforcedBy "bun commons/tools/mizan-check.ts --root <spec kit>" .

mz:Specializes a mz:Basis ;
    rdfs:label "specializes"@en ;
    skos:definition "The term is a subclass or a subproperty of a standard's term."@en .

mz:Standard a owl:Class ;
    rdfs:label "Standard"@en ;
    rdfs:subClassOf dcterms:Standard ;
    skos:definition "A pinned, licensed standard: its issuer, name, version, location, license and the hash of what was imported."@en .

mz:Standards a mz:ConformanceLevel ;
    rdfs:label "L2 standards"@en ;
    skos:definition "The subject's terms rest on standards first: an audit of every term, with a decision for each that stays unaligned."@en ;
    mz:entails mz:TermAudit ;
    mz:levelRank 2 .

mz:State a mz:JurisdictionLevel ;
    rdfs:label "state"@en .

mz:TermAudit a mz:ConformanceRequirement ;
    rdfs:label "term audit"@en ;
    skos:definition "Every term of the subject's ontology has a record of the standard it rests on, or of why none does and the decision to keep it unaligned, and a specification names only defined terms."@en ;
    mz:rule "mizan/decision-missing",
        "mizan/decision-overdue",
        "mizan/deprecated-no-replacement",
        "mizan/spec-term-deprecated",
        "mizan/spec-term-unknown",
        "mizan/standard-newer",
        "mizan/standards-considered",
        "mizan/term-basis-missing",
        "mizan/term-not-defined-by",
        "mizan/term-standard",
        "mizan/unaligned-justification" .

mz:Unaligned a mz:Basis ;
    rdfs:label "unaligned"@en ;
    skos:definition "No standard names the term: it carries a justification and a decision, is counted, and is drift to be reduced."@en .

mz:VerifyCommand a mz:ConformanceRequirement ;
    rdfs:label "verify command"@en ;
    skos:definition "The subject names the one command that proves it, and it runs from the subject's folder with no argument."@en ;
    mz:enforcedBy "the manifest check, which finds a verify command that the subject's package does not have" .

mz:Version a mz:ConformanceRequirement ;
    rdfs:label "version"@en ;
    skos:definition "The subject declares a version, and it is the version of its package."@en ;
    mz:enforcedBy "the manifest check, which finds a version that is not the package's" .

mz:addedOn a owl:DatatypeProperty ;
    rdfs:domain mz:OntologyTerm ;
    rdfs:label "addedOn"@en ;
    rdfs:range xsd:string ;
    skos:definition "The day (YYYY-MM-DD) the term was added; the decision is due 90 days after it."@en .

mz:authority a owl:ObjectProperty ;
    rdfs:domain mz:Requirement ;
    rdfs:label "authority"@en ;
    rdfs:range mz:Authority ;
    skos:definition "The law or regulation the requirement comes from."@en .

mz:basis a owl:ObjectProperty ;
    rdfs:domain mz:OntologyTerm ;
    rdfs:label "basis"@en ;
    rdfs:range mz:Basis ;
    skos:definition "How the term relates to a standard."@en .

mz:citation a owl:DatatypeProperty ;
    rdfs:domain mz:Authority ;
    rdfs:label "citation"@en ;
    rdfs:range xsd:string ;
    skos:definition "The law's citation, as its jurisdiction writes it (21 CFR Part 11)."@en .

mz:decidedOn a owl:DatatypeProperty ;
    rdfs:domain mz:Decision ;
    rdfs:label "decidedOn"@en ;
    rdfs:range xsd:string ;
    skos:definition "The day (YYYY-MM-DD) the decision was made."@en .

mz:decision a owl:ObjectProperty ;
    rdfs:domain mz:OntologyTerm ;
    rdfs:label "decision"@en ;
    rdfs:range mz:Decision ;
    skos:definition "The decision that records why the term is unaligned."@en .

mz:decisionOf a owl:ObjectProperty ;
    rdfs:domain mz:Decision ;
    rdfs:label "decisionOf"@en ;
    rdfs:range mz:OntologyTerm ;
    skos:definition "The term the decision is about."@en .

mz:definedBy a owl:DatatypeProperty ;
    rdfs:domain mz:OntologyTerm ;
    rdfs:label "definedBy"@en ;
    rdfs:range xsd:string ;
    skos:definition "A specification (and its requirement) that defines the term."@en .

mz:deprecatedOn a owl:DatatypeProperty ;
    rdfs:domain mz:OntologyTerm ;
    rdfs:label "deprecatedOn"@en ;
    rdfs:range xsd:string ;
    skos:definition "The day (YYYY-MM-DD) the term was deprecated: a specification must not name it, and it names its replacement."@en .

mz:direction a owl:ObjectProperty ;
    rdfs:domain mz:Integration ;
    rdfs:label "direction"@en ;
    rdfs:range mz:IntegrationDirection ;
    skos:definition "import or export."@en .

mz:effective a owl:DatatypeProperty ;
    rdfs:domain mz:Authority ;
    rdfs:label "effective"@en ;
    rdfs:range xsd:string ;
    skos:definition "The day (YYYY-MM-DD) the law took effect, where it is known."@en .

mz:enforcedBy a owl:DatatypeProperty ;
    rdfs:domain mz:ConformanceRequirement ;
    rdfs:label "enforcedBy"@en ;
    rdfs:range xsd:string ;
    skos:definition "What else proves the requirement, in words, where no rule of Mizan's check does."@en .

mz:entails a owl:ObjectProperty ;
    rdfs:domain mz:ConformanceLevel ;
    rdfs:label "entails"@en ;
    rdfs:range mz:ConformanceRequirement ;
    skos:definition "A requirement the level adds to those of the levels below it."@en .

mz:fromFormat a owl:DatatypeProperty ;
    rdfs:domain mz:Integration ;
    rdfs:label "fromFormat"@en ;
    rdfs:range xsd:string ;
    skos:definition "The format the integration reads."@en .

mz:generator a owl:DatatypeProperty ;
    rdfs:domain mz:ImportRecord ;
    rdfs:label "generator"@en ;
    rdfs:range xsd:string ;
    skos:definition "The generator that wrote the imported module."@en .

mz:handles a owl:ObjectProperty ;
    rdfs:domain mz:Integration ;
    rdfs:label "handles"@en ;
    rdfs:range mz:Standard ;
    skos:definition "The standard the integration handles."@en .

mz:home a owl:DatatypeProperty ;
    rdfs:domain mz:Rung ;
    rdfs:label "home"@en ;
    rdfs:range xsd:string ;
    skos:definition "A path or a glob of a harness's files that is on the rung."@en .

mz:importOf a owl:ObjectProperty ;
    rdfs:domain mz:ImportRecord ;
    rdfs:label "importOf"@en ;
    rdfs:range mz:Standard ;
    skos:definition "The standard that was imported."@en .

mz:importedOn a owl:DatatypeProperty ;
    rdfs:domain mz:ImportRecord ;
    rdfs:label "importedOn"@en ;
    rdfs:range xsd:string ;
    skos:definition "The day (YYYY-MM-DD) of the import."@en .

mz:incorporates a owl:DatatypeProperty ;
    rdfs:domain mz:Authority ;
    rdfs:label "incorporates"@en ;
    rdfs:range xsd:string ;
    skos:definition "A standard the law incorporates by reference, by its identifier."@en .

mz:isolation a owl:DatatypeProperty ;
    rdfs:domain mz:Exception ;
    rdfs:label "isolation"@en ;
    rdfs:range xsd:string ;
    skos:definition "How nothing else depends on the tool: a typed TypeScript wrapper, files in and files out."@en .

mz:issuer a owl:DatatypeProperty ;
    rdfs:domain mz:Standard ;
    rdfs:label "issuer"@en ;
    rdfs:range xsd:string ;
    skos:definition "Who publishes the standard."@en .

mz:jurisdiction a owl:ObjectProperty ;
    rdfs:domain mz:Authority ;
    rdfs:label "jurisdiction"@en ;
    rdfs:range mz:Jurisdiction ;
    skos:definition "The jurisdiction whose law it is."@en .

mz:justification a owl:DatatypeProperty ;
    rdfs:domain mz:OntologyTerm ;
    rdfs:label "justification"@en ;
    rdfs:range xsd:string ;
    skos:definition "For an unaligned term: the standards looked at and why none fits."@en .

mz:kind a owl:ObjectProperty ;
    rdfs:domain mz:Rung ;
    rdfs:label "kind"@en ;
    rdfs:range mz:RungKind ;
    skos:definition "required, optional, observer or environment."@en .

mz:level a owl:ObjectProperty ;
    rdfs:domain mz:Jurisdiction ;
    rdfs:label "level"@en ;
    rdfs:range mz:JurisdictionLevel ;
    skos:definition "federal, state, local or international."@en .

mz:levelRank a owl:DatatypeProperty ;
    rdfs:domain mz:ConformanceLevel ;
    rdfs:label "levelRank"@en ;
    rdfs:range xsd:integer ;
    skos:definition "The level's rank, 0 to 3: a level entails the requirements of every level of a lower rank."@en .

mz:license a owl:DatatypeProperty ;
    rdfs:domain mz:Standard ;
    rdfs:label "license"@en ;
    rdfs:range xsd:string ;
    skos:definition "The license, as an SPDX identifier."@en .

mz:location a owl:DatatypeProperty ;
    rdfs:domain mz:Standard ;
    rdfs:label "location"@en ;
    rdfs:range xsd:string ;
    skos:definition "Where the standard is published."@en .

mz:mappingRelation a owl:DatatypeProperty ;
    rdfs:domain mz:OntologyTerm ;
    rdfs:label "mappingRelation"@en ;
    rdfs:range xsd:string ;
    skos:definition "How the term relates to the standard's term, in the words a mapping is published with: exactMatch, closeMatch, narrowMatch, broadMatch, subClassOf or subPropertyOf."@en .

mz:mayRelyOn a owl:ObjectProperty ;
    rdfs:domain mz:Rung ;
    rdfs:label "mayRelyOn"@en ;
    rdfs:range mz:Rung ;
    skos:definition "A rung this rung may rely on, and never reach around."@en .

mz:ofSpec a owl:ObjectProperty ;
    rdfs:domain mz:Requirement ;
    rdfs:label "ofSpec"@en ;
    rdfs:range mz:Spec ;
    skos:definition "The specification the requirement is in."@en .

mz:pinnedVersion a owl:DatatypeProperty ;
    rdfs:domain mz:Exception ;
    rdfs:label "pinnedVersion"@en ;
    rdfs:range xsd:string ;
    skos:definition "The version of the tool that is pinned (commons 0002-packaging)."@en .

mz:platform a owl:DatatypeProperty ;
    rdfs:domain mz:Exception ;
    rdfs:label "platform"@en ;
    rdfs:range xsd:string ;
    skos:definition "A platform the tool supports: linux, macos or windows."@en .

mz:provedBy a owl:DatatypeProperty ;
    rdfs:domain mz:Rung ;
    rdfs:label "provedBy"@en ;
    rdfs:range xsd:string ;
    skos:definition "A command of a harness that proves the rung."@en .

mz:record a owl:DatatypeProperty ;
    rdfs:domain mz:Decision ;
    rdfs:label "record"@en ;
    rdfs:range xsd:string ;
    skos:definition "Where the decision is recorded in the harness's own system, where it has one."@en .

mz:redistributable a owl:DatatypeProperty ;
    rdfs:domain mz:Standard ;
    rdfs:label "redistributable"@en ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether its text may be copied; false for a standard that is only cited."@en .

mz:replacedBy a owl:DatatypeProperty ;
    rdfs:domain mz:OntologyTerm ;
    rdfs:label "replacedBy"@en ;
    rdfs:range xsd:string ;
    skos:definition "The IRI of the term that replaces a deprecated term."@en .

mz:requirementId a owl:DatatypeProperty ;
    rdfs:domain mz:Requirement ;
    rdfs:label "requirementId"@en ;
    rdfs:range xsd:string ;
    skos:definition "The requirement's number in its specification (FR-001)."@en .

mz:rule a owl:DatatypeProperty ;
    rdfs:domain mz:ConformanceRequirement ;
    rdfs:label "rule"@en ;
    rdfs:range xsd:string ;
    skos:definition "The id of a rule of Mizan's check that proves the requirement, or a family of ids ending in `/*`."@en .

mz:rungNumber a owl:DatatypeProperty ;
    rdfs:domain mz:Rung ;
    rdfs:label "rungNumber"@en ;
    rdfs:range xsd:integer ;
    skos:definition "The rung's number, 0 to 10."@en .

mz:sourceSha256 a owl:DatatypeProperty ;
    rdfs:domain mz:Standard ;
    rdfs:label "sourceSha256"@en ;
    rdfs:range xsd:string ;
    skos:definition "The SHA-256 of what was imported, in lower-case hexadecimal."@en .

mz:spec a owl:DatatypeProperty ;
    rdfs:domain mz:Rung ;
    rdfs:label "spec"@en ;
    rdfs:range xsd:string ;
    skos:definition "A specification (and its requirement) the rung comes from, as a harness cites it: `NNN-slug FR-nnn`."@en .

mz:specId a owl:DatatypeProperty ;
    rdfs:domain mz:Spec ;
    rdfs:label "specId"@en ;
    rdfs:range xsd:string ;
    skos:definition "The specification's identifier, its folder's name."@en .

mz:specStatus a owl:DatatypeProperty ;
    rdfs:domain mz:Spec ;
    rdfs:label "specStatus"@en ;
    rdfs:range xsd:string ;
    skos:definition "Draft, Active, Deferred or Superseded."@en .

mz:standardTerm a owl:DatatypeProperty ;
    rdfs:domain mz:OntologyTerm ;
    rdfs:label "standardTerm"@en ;
    rdfs:range xsd:string ;
    skos:definition "The IRI of the standard's term, where there is one."@en .

mz:standardVersion a owl:DatatypeProperty ;
    rdfs:domain mz:Standard ;
    rdfs:label "standardVersion"@en ;
    rdfs:range xsd:string ;
    skos:definition "The version that is pinned."@en .

mz:termIri a owl:DatatypeProperty ;
    rdfs:domain mz:OntologyTerm ;
    rdfs:label "termIri"@en ;
    rdfs:range xsd:string ;
    skos:definition "The IRI of the term the individual describes."@en .

mz:toFormat a owl:DatatypeProperty ;
    rdfs:domain mz:Integration ;
    rdfs:label "toFormat"@en ;
    rdfs:range xsd:string ;
    skos:definition "The format the integration writes."@en .

mz:tool a owl:DatatypeProperty ;
    rdfs:domain mz:Exception ;
    rdfs:label "tool"@en ;
    rdfs:range xsd:string ;
    skos:definition "The tool, its language or its format."@en .

mz:whyNotTypeScript a owl:DatatypeProperty ;
    rdfs:domain mz:Exception ;
    rdfs:label "whyNotTypeScript"@en ;
    rdfs:range xsd:string ;
    skos:definition "Why TypeScript or a hand-written parser is not enough."@en .

<https://www.intellectualfrontiers.com/ontology/mizan> a owl:Ontology ;
    dcterms:description "The shared vocabulary of Mizan, the IF Spec Profile: the ladder, specifications and requirements, standards, laws and the basis of every term."@en ;
    rdfs:label "Mizan"@en ;
    owl:versionIRI mzv:1.0.0 ;
    owl:versionInfo "1.0.0" .
