    mz:definedBy "0028-conformance-levels FR-002" ;
    mz:justification "A requirement of a level is a concept of a code list; the standards the requirements point at (RFC 2119, EARS, Gherkin, OSCAL) are named in their definitions and in their specifications." ;
    mz:mappingRelation "subClassOf" ;
    mz:standardTerm "http://www.w3.org/2004/02/skos/core#Concept" ;
