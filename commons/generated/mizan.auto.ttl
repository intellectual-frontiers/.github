@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix mz: <https://www.intellectualfrontiers.com/ontology/mizan#> .
@prefix mzid: <https://www.intellectualfrontiers.com/id/mizan/> .
@prefix mzv: <https://www.intellectualfrontiers.com/ontology/mizan/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mzid:authority-21-cfr-11 a mz:Authority ;
    rdfs:label "21 CFR Part 11, electronic records and electronic signatures"@en ;
    mz:citation "21 CFR Part 11" ;
    mz:jurisdiction mzid:jurisdiction-us .

mzid:authority-21-cfr-820 a mz:Authority ;
    rdfs:label "21 CFR Part 820, Quality Management System Regulation"@en ;
    skos:definition "The FDA's regulation of the quality management systems of medical-device manufacturers, amended to incorporate ISO 13485:2016 by reference (verified against the FDA and the Federal Register, 2026-11)."@en ;
    mz:citation "21 CFR Part 820" ;
    mz:effective "2026-02-02" ;
    mz:incorporates "ISO 13485:2016" ;
    mz:jurisdiction mzid:jurisdiction-us .

mzid:decision-mz-RungKind a mz:Decision ;
    rdfs:label "Keep mz:RungKind unaligned"@en ;
    mz:decidedOn "2026-11-17" ;
    mz:decisionOf mzid:term-RungKind ;
    mz:record "owner decision of 2026-11-17 in issue #10: keep the term unaligned; reviewed again by 2027-02-15" .

mzid:jurisdiction-us a mz:Jurisdiction ;
    rdfs:label "United States"@en ;
    mz:level mz:Federal .

mzid:rung-0 a mz:Rung ;
    rdfs:label "Ontology"@en ;
    skos:definition "Facts, terms and code lists, stated once as typed TypeScript on commons' RDF kernel."@en ;
    mz:kind mz:Required ;
    mz:rungNumber 0 .

mzid:rung-10 a mz:Rung ;
    rdfs:label "Workspace: where the work is done"@en ;
    skos:definition "The controlled working environment everything else is built in: the layout of the repositories on a machine, the approved tools, the policy and the hooks that hold the work to its rules. It relies on no rung and no rung relies on it; the evidence rung records what it does."@en ;
    mz:kind mz:Environment ;
    mz:rungNumber 10 .

mzid:rung-1 a mz:Rung ;
    rdfs:label "Specifications"@en ;
    skos:definition "What each part must do, using only terms the ontology defines."@en ;
    mz:kind mz:Required ;
    mz:mayRelyOn mzid:rung-0 ;
    mz:rungNumber 1 .

mzid:rung-2 a mz:Rung ;
    rdfs:label "Governed data"@en ;
    skos:definition "Schema, policies, data models and code lists of every subject."@en ;
    mz:kind mz:Required ;
    mz:mayRelyOn mzid:rung-0,
        mzid:rung-1 ;
    mz:rungNumber 2 .

mzid:rung-3 a mz:Rung ;
    rdfs:label "Data operations"@en ;
    skos:definition "Work as close to the data as possible."@en ;
    mz:kind mz:Required ;
    mz:mayRelyOn mzid:rung-0,
        mzid:rung-1,
        mzid:rung-2 ;
    mz:rungNumber 3 .

mzid:rung-4 a mz:Rung ;
    rdfs:label "Infrastructure rules"@en ;
    skos:definition "Logic reused across services, neutral to any one service."@en ;
    mz:kind mz:Required ;
    mz:mayRelyOn mzid:rung-0,
        mzid:rung-1,
        mzid:rung-3 ;
    mz:rungNumber 4 .

mzid:rung-5 a mz:Rung ;
    rdfs:label "Business rules"@en ;
    skos:definition "A service's own logic: its operations and rules."@en ;
    mz:kind mz:Required ;
    mz:mayRelyOn mzid:rung-0,
        mzid:rung-1,
        mzid:rung-3,
        mzid:rung-4 ;
    mz:rungNumber 5 .

mzid:rung-6 a mz:Rung ;
    rdfs:label "Application"@en ;
    skos:definition "The headless hosts (command line, MCP server, HTTP server, container service, daemon), then the windowed hosts."@en ;
    mz:kind mz:Required ;
    mz:mayRelyOn mzid:rung-0,
        mzid:rung-1,
        mzid:rung-4,
        mzid:rung-5 ;
    mz:rungNumber 6 .

mzid:rung-7 a mz:Rung ;
    rdfs:label "Documentation"@en ;
    skos:definition "How to operate everything below."@en ;
    mz:kind mz:Required ;
    mz:mayRelyOn mzid:rung-0,
        mzid:rung-1,
        mzid:rung-2,
        mzid:rung-3,
        mzid:rung-4,
        mzid:rung-5,
        mzid:rung-6 ;
    mz:rungNumber 7 .

mzid:rung-8 a mz:Rung ;
    rdfs:label "Lifecycle: retired, then archived"@en ;
    skos:definition "What is retired (alive, not to be used), then what is archived (dead, safe to delete). It relies on nothing and nothing relies on it."@en ;
    mz:kind mz:Optional ;
    mz:rungNumber 8 .

mzid:rung-9 a mz:Rung ;
    rdfs:label "Evidence: what the system records about itself"@en ;
    skos:definition "The records produced by operating the system, never written by hand: test and check runs, findings, nonconformances, corrective actions, change records and attestations. They are append-only and prove every other rung; no rung relies on them, so that evidence cannot authorize itself."@en ;
    mz:kind mz:Observer ;
    mz:mayRelyOn mzid:rung-0,
        mzid:rung-1,
        mzid:rung-2,
        mzid:rung-3,
        mzid:rung-4,
        mzid:rung-5,
        mzid:rung-6,
        mzid:rung-7 ;
    mz:rungNumber 9 .

