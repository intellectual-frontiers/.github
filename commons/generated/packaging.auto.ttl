pm:Checksum a owl:Class ;
    rdfs:label "Checksum"@en ;
    skos:definition "A pin on one platform: the SHA-256 of one pinned download there and, where the publisher's address is known, what a download needs (its address, the format of what it gives and the folder of its programs); where it is not known, why the platform is unpinned."@en .

pm:Comfort a pm:Tier ;
    rdfs:label "comfort"@en .

pm:Command a owl:Class ;
    rdfs:label "Command"@en ;
    rdfs:subClassOf schema:Action ;
    skos:definition "One operation of one package manager as a command template: its words, with {packages} or {package} where the names go, and the form a script runs without asking a person."@en .

pm:HelperKind a pm:ManagerKind ;
    rdfs:label "helper"@en .

pm:Info a pm:Operation ;
    rdfs:label "info"@en .

pm:Install a pm:Operation ;
    rdfs:label "install"@en .

pm:InstallExact a pm:Operation ;
    rdfs:label "install exact"@en ;
    skos:definition "Install one package at one version, written with {package} and {version}, as the manager's own documentation writes an exact version."@en .

pm:ListInstalled a pm:Operation ;
    rdfs:label "list installed"@en .

pm:ManagerKind a owl:Class ;
    rdfs:label "Manager kind"@en ;
    skos:definition "system (the computer's own), helper (a front end to another manager or to a user repository), universal (works on many systems) or tool (manages the tools a project or an account uses, in the account's own folder, and is no family's manager)."@en .

pm:NoAssurance a pm:Assurance ;
    rdfs:label "none"@en .

pm:Operation a owl:Class ;
    rdfs:label "Operation"@en ;
    skos:definition "A thing a package manager does, named the same for every manager."@en .

pm:PackageManager a owl:Class ;
    rdfs:label "Package manager"@en ;
    rdfs:subClassOf schema:SoftwareApplication ;
    skos:definition "A program that installs, upgrades and removes the software of a computer or of a user: apt, pacman, dnf, brew and the rest."@en .

pm:PackageName a owl:Class ;
    rdfs:label "Package name"@en ;
    skos:definition "What one family calls the package that gives a program: xz-utils on the Debian family and xz on the Arch family, or alternatives (a|b) for releases that renamed it."@en .

pm:PinnedDownload a owl:Class ;
    rdfs:label "Pinned download"@en ;
    rdfs:subClassOf schema:SoftwareApplication ;
    skos:definition "A program a script fetches before any harness exists, at one version, whose download is accepted only with the SHA-256 pinned for the platform."@en .

pm:Platform a owl:Class ;
    rdfs:label "Platform"@en ;
    skos:definition "An operating system on a processor, named the way a harness names its downloads (linux-x64, macos-arm64)."@en .

pm:Program a owl:Class ;
    rdfs:label "Program"@en ;
    rdfs:subClassOf schema:SoftwareApplication ;
    skos:definition "A program a computer needs, named once, whatever each family calls its package."@en .

pm:Prohibition a owl:Class ;
    rdfs:label "Prohibition"@en ;
    skos:definition "A command a harness must never run, with the reason: the rule is data, not a comment in a script."@en .

pm:QueryCandidate a pm:Operation ;
    rdfs:label "query candidate"@en ;
    skos:definition "Whether the repositories offer one package, and which version."@en .

pm:QueryInstalled a pm:Operation ;
    rdfs:label "query installed"@en ;
    skos:definition "Whether one package is installed: the exit status answers."@en .

pm:QueryVersion a pm:Operation ;
    rdfs:label "query version"@en ;
    skos:definition "The version of one installed package, for an SBOM: the command prints it."@en .

pm:RecordField a owl:Class ;
    rdfs:label "Record field"@en ;
    skos:definition "One field of the record a setup keeps of how an account was set up: its name, its type and, where only some values are allowed, which."@en .

pm:Refresh a pm:Operation ;
    rdfs:label "refresh index"@en .

pm:Remove a pm:Operation ;
    rdfs:label "remove"@en .

pm:Required a pm:Tier ;
    rdfs:label "required"@en .

pm:Rule a owl:Class ;
    rdfs:label "Rule"@en ;
    skos:definition "A pattern a harness looks for in its scripts, CI or code, in a named set, with a short name and the reason it is not allowed."@en .

pm:Search a pm:Operation ;
    rdfs:label "search"@en .

pm:StandIn a pm:Assurance ;
    rdfs:label "stand-in"@en .

pm:SupportStatus a owl:Class ;
    rdfs:label "Support status"@en ;
    skos:definition "Whether a harness acts on a family (supported), or only knows of it (catalogued)."@en .

pm:Supported a pm:SupportStatus ;
    rdfs:label "supported"@en .

pm:SystemFamily a owl:Class ;
    rdfs:label "System family"@en ;
    rdfs:subClassOf schema:Thing ;
    skos:definition "Operating systems that share a package manager and the names of their packages, named in the way a harness detects them: by the ID or ID_LIKE of /etc/os-release, or by the platform where there is none."@en .

pm:SystemKind a pm:ManagerKind ;
    rdfs:label "system"@en .

pm:Tier a owl:Class ;
    rdfs:label "Tier"@en ;
    skos:definition "required (what a setup needs from the computer) or comfort (the everyday programs a bootstrap adds)."@en .

pm:ToolKind a pm:ManagerKind ;
    rdfs:label "tool"@en .

pm:UniversalKind a pm:ManagerKind ;
    rdfs:label "universal"@en .

pm:Untested a pm:Assurance ;
    rdfs:label "untested"@en .

pm:Upgrade a pm:Operation ;
    rdfs:label "upgrade"@en .

pm:UpgradeAll a pm:Operation ;
    rdfs:label "upgrade all"@en .

pm:Verified a pm:Assurance ;
    rdfs:label "verified"@en .

pm:adminInstall a owl:DatatypeProperty ;
    rdfs:domain pm:SystemFamily ;
    rdfs:range xsd:string ;
    skos:definition "The command a person with administrator rights runs to install packages (a pm:template with {packages})."@en .

pm:allowedValue a owl:DatatypeProperty ;
    rdfs:domain pm:RecordField ;
    rdfs:range xsd:string ;
    skos:definition "A value the field may hold, where it may hold only some."@en .

pm:archiveFormat a owl:DatatypeProperty ;
    rdfs:domain pm:Checksum ;
    rdfs:range xsd:string ;
    skos:definition "What the address gives: zip (a zip archive), tar (a tar archive, plain or compressed) or file (the one file itself)."@en .

pm:assurance a owl:ObjectProperty ;
    rdfs:domain pm:SystemFamily ;
    rdfs:range pm:Assurance ;
    skos:definition "How far the family has been tried."@en .

pm:binPath a owl:DatatypeProperty ;
    rdfs:domain pm:Checksum ;
    rdfs:range xsd:string ;
    skos:definition "The folder of the programs inside the unpacked artifact, relative to its root, never absolute and never with a .. word; empty for the root."@en .

pm:commandOf a owl:ObjectProperty ;
    rdfs:domain pm:Command ;
    rdfs:range pm:PackageManager ;
    skos:definition "The manager the command belongs to."@en .

pm:detectSource a owl:DatatypeProperty ;
    rdfs:domain pm:SystemFamily ;
    rdfs:range xsd:string ;
    skos:definition "os-release (the IDs are those of /etc/os-release), platform (they are names of a platform), or any (the fallback, the managers found on the PATH)."@en .

pm:detectedBy a owl:DatatypeProperty ;
    rdfs:domain pm:SystemFamily ;
    rdfs:range xsd:string ;
    skos:definition "An ID that puts a computer in the family: a word of the ID or ID_LIKE of /etc/os-release, or a platform name where there is no such file."@en .

pm:downloadUrl a owl:DatatypeProperty ;
    rdfs:domain pm:Checksum ;
    rdfs:range xsd:string ;
    skos:definition "The https address of the publisher's artifact for the pin on the platform, with {version} where the pin's version stands; no user name, no password."@en .

pm:environment a owl:DatatypeProperty ;
    rdfs:domain pm:PackageManager ;
    rdfs:range xsd:string ;
    skos:definition "NAME=value that its non-interactive commands run with, such as DEBIAN_FRONTEND=noninteractive."@en .

pm:executable a owl:DatatypeProperty ;
    rdfs:domain pm:PackageManager ;
    rdfs:range xsd:string ;
    skos:definition "The program that is run (argv[0] of its commands)."@en .

pm:fieldName a owl:DatatypeProperty ;
    rdfs:domain pm:RecordField ;
    rdfs:range xsd:string ;
    skos:definition "The name of the field in the record."@en .

pm:fieldType a owl:DatatypeProperty ;
    rdfs:domain pm:RecordField ;
    rdfs:range xsd:string ;
    skos:definition "text (a quoted string), boolean (true or false) or date (a quoted YYYY-MM-DD)."@en .

pm:forFamily a owl:ObjectProperty ;
    rdfs:domain pm:PackageName ;
    rdfs:range pm:SystemFamily ;
    skos:definition "The family that calls the package this."@en .

pm:forPin a owl:ObjectProperty ;
    rdfs:domain pm:Checksum ;
    rdfs:range pm:PinnedDownload ;
    skos:definition "The pinned download the checksum is of."@en .

pm:forPlatform a owl:ObjectProperty ;
    rdfs:domain pm:Checksum ;
    rdfs:range pm:Platform ;
    skos:definition "The platform the checksum is for."@en .

pm:forProgram a owl:ObjectProperty ;
    rdfs:domain pm:PackageName ;
    rdfs:range pm:Program ;
    skos:definition "The program the package gives."@en .

pm:forbiddenTemplate a owl:DatatypeProperty ;
    rdfs:domain pm:Prohibition ;
    rdfs:range xsd:string ;
    skos:definition "The command (a template, as pm:template) that must never be run."@en .

pm:harnessInstallsPackages a owl:DatatypeProperty ;
    rdfs:domain pm:SystemFamily ;
    rdfs:range xsd:boolean ;
    skos:definition "False where a supported family installs no package (a Mac: the setup fetches what it needs itself)."@en .

pm:harnessUse a owl:DatatypeProperty ;
    rdfs:domain pm:PackageManager ;
    rdfs:range xsd:string ;
    skos:definition "never where a harness must not drive it (an AUR helper runs build scripts of unreviewed packages)."@en .

pm:kind a owl:ObjectProperty ;
    rdfs:domain pm:PackageManager ;
    rdfs:range pm:ManagerKind ;
    skos:definition "system, helper or universal."@en .

pm:missingExitStatus a owl:DatatypeProperty ;
    rdfs:domain pm:Command ;
    rdfs:range xsd:integer ;
    skos:definition "Of a query-installed command, the exit status that says the package is not installed (as opposed to a failure of the manager)."@en .

pm:name a owl:DatatypeProperty ;
    rdfs:domain pm:PackageName ;
    rdfs:range xsd:string ;
    skos:definition "The package, or alternatives separated by | where a release renamed it."@en .

pm:needsAdministrator a owl:DatatypeProperty ;
    rdfs:domain pm:PackageManager ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether installing with it needs administrator rights. Not from upt; unverified unless the manager is verified."@en .

pm:nonInteractive a owl:DatatypeProperty ;
    rdfs:domain pm:Command ;
    rdfs:range xsd:string ;
    skos:definition "The same command in the form a script runs without asking anyone."@en .

pm:note a owl:DatatypeProperty ;
    skos:definition "A sentence a person needs, such as what is not covered by an assurance."@en .

pm:operatingSystem a owl:DatatypeProperty ;
    rdfs:domain pm:Platform ;
    rdfs:range xsd:string ;
    skos:definition "linux or macos."@en .

pm:operation a owl:ObjectProperty ;
    rdfs:domain pm:Command ;
    rdfs:range pm:Operation ;
    skos:definition "What the command does."@en .

pm:order a owl:DatatypeProperty ;
    rdfs:domain pm:Program ;
    rdfs:range xsd:integer ;
    skos:definition "Where the program stands in the lists a harness shows or installs from; lower comes first."@en .

pm:origin a owl:DatatypeProperty ;
    rdfs:domain pm:Command ;
    rdfs:range xsd:string ;
    skos:definition "Where the command comes from: upt, archon (what the retired Stolos engine ran, before commons/archon replaced it), memory (written from knowledge, unverified) or upt+memory."@en .

pm:pattern a owl:DatatypeProperty ;
    rdfs:domain pm:Rule ;
    rdfs:range xsd:string ;
    skos:definition "A regular expression (ECMAScript syntax) the rule looks for."@en .

pm:pinKey a owl:DatatypeProperty ;
    rdfs:domain pm:PinnedDownload ;
    rdfs:range xsd:string ;
    skos:definition "The start of a pin's variable names (MISE gives MISE_VERSION)."@en .

pm:pinSuffix a owl:DatatypeProperty ;
    rdfs:domain pm:Platform ;
    rdfs:range xsd:string ;
    skos:definition "The ending of a pin's variable name for the platform (X86_64 gives MISE_SHA256_X86_64)."@en .

pm:platformName a owl:DatatypeProperty ;
    rdfs:domain pm:Platform ;
    rdfs:range xsd:string ;
    skos:definition "The platform's name in a harness's declarations and downloads (linux-x64)."@en .

pm:preferredManager a owl:ObjectProperty ;
    rdfs:domain pm:SystemFamily ;
    rdfs:range pm:PackageManager ;
    skos:definition "The manager a harness drives on the family."@en .

pm:processor a owl:DatatypeProperty ;
    rdfs:domain pm:Platform ;
    rdfs:range xsd:string ;
    skos:definition "What `uname -m` says on the platform (x86_64, aarch64)."@en .

pm:programName a owl:DatatypeProperty ;
    rdfs:domain pm:Program ;
    rdfs:range xsd:string ;
    skos:definition "What the program is called when it is run."@en .

pm:prohibitionOf a owl:ObjectProperty ;
    rdfs:domain pm:Prohibition ;
    rdfs:range pm:PackageManager ;
    skos:definition "The manager the prohibition is about."@en .

pm:purlType a owl:DatatypeProperty ;
    rdfs:domain pm:PackageManager ;
    rdfs:range xsd:string ;
    skos:definition "The package URL type of the packages it installs (deb, rpm, apk, alpm, brew); absent where the package URL specification has none."@en .

pm:removalHint a owl:DatatypeProperty ;
    rdfs:domain pm:SystemFamily ;
    rdfs:range xsd:string ;
    skos:definition "How a user made for a harness is removed with its home folder, with NAME for the user."@en .

pm:ruleSet a owl:DatatypeProperty ;
    rdfs:domain pm:Rule ;
    rdfs:range xsd:string ;
    skos:definition "The set the rule belongs to: shell-portability, ci-forbidden-program, ci-forbidden-action, host-program or installer."@en .

pm:sha256 a owl:DatatypeProperty ;
    rdfs:domain pm:Checksum ;
    rdfs:range xsd:string ;
    skos:definition "The SHA-256 of the download, in lower-case hexadecimal."@en .

pm:supportStatus a owl:ObjectProperty ;
    rdfs:domain pm:SystemFamily ;
    rdfs:range pm:SupportStatus ;
    skos:definition "Whether a harness acts on the family."@en .

pm:template a owl:DatatypeProperty ;
    rdfs:domain pm:Command ;
    rdfs:range xsd:string ;
    skos:definition "Its words, separated by spaces, with {packages} (one or more names) or {package} (one) where the names go. No shell syntax: it is run as a list of words."@en .

pm:tier a owl:ObjectProperty ;
    rdfs:domain pm:Program ;
    rdfs:range pm:Tier ;
    skos:definition "required or comfort."@en .

pm:unameName a owl:DatatypeProperty ;
    rdfs:domain pm:SystemFamily ;
    rdfs:range xsd:string ;
    skos:definition "What `uname -s` says on a platform family (Darwin for macOS), where /etc/os-release has none."@en .

pm:unpinnedReason a owl:DatatypeProperty ;
    rdfs:domain pm:Checksum ;
    rdfs:range xsd:string ;
    skos:definition "Why the platform has no address: the sentence a platform with a checksum and no known address carries instead of one."@en .

pm:usesManager a owl:ObjectProperty ;
    rdfs:domain pm:SystemFamily ;
    rdfs:range pm:PackageManager ;
    skos:definition "A manager the family has, in upt's order of preference when pm:preferredManager is not set."@en .

pm:verifiedOn a owl:DatatypeProperty ;
    skos:definition "Where and when it was run for real, in words. Without it, a command, a family or a flag is not verified."@en .

pm:version a owl:DatatypeProperty ;
    rdfs:domain pm:PinnedDownload ;
    rdfs:range xsd:string ;
    skos:definition "The one version that is pinned."@en .

<https://www.intellectualfrontiers.com/ontology/packaging> a owl:Ontology ;
    dcterms:description "The package managers and system families a harness installs software with, the commands that drive them, and the package each program is called."@en ;
    rdfs:label "Packaging"@en ;
    owl:versionIRI pmv:1.0.0 ;
    owl:versionInfo "1.0.0" .
