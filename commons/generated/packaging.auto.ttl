pmid:prohibition-pacman-1 a pm:Prohibition ;
    skos:definition "Refreshing the package list alone leaves a rolling release partly upgraded; upgrade with -Syu, or install with -S --needed and let a missing package say the list is old."@en ;
    pm:forbiddenTemplate "pacman -Sy" ;
    pm:prohibitionOf pmid:manager-pacman .

pmid:prohibition-pacman-2 a pm:Prohibition ;
    skos:definition "Installing from a freshly refreshed list without upgrading the rest of the system is a partial upgrade."@en ;
    pm:forbiddenTemplate "pacman -Sy {packages}" ;
    pm:prohibitionOf pmid:manager-pacman .

pmid:prohibition-yay-1 a pm:Prohibition ;
    skos:definition "An AUR helper builds and runs scripts of packages nobody reviewed with the person's rights; a harness never drives one."@en ;
    pm:forbiddenTemplate "yay -S {packages}" ;
    pm:prohibitionOf pmid:manager-yay .

pmid:prohibition-yay-2 a pm:Prohibition ;
    skos:definition "A refresh alone is a partial upgrade, and a harness never drives an AUR helper."@en ;
    pm:forbiddenTemplate "yay -Sy" ;
    pm:prohibitionOf pmid:manager-yay .

pmid:record-arch a pm:RecordField ;
    skos:definition "The processor, as uname -m says it (x86_64, aarch64)."@en ;
    pm:fieldName "arch" ;
    pm:fieldType "text" ;
    pm:order 5 .

pmid:record-distro a pm:RecordField ;
    skos:definition "The name the operating system gives itself (PRETTY_NAME of os-release, or the macOS version)."@en ;
    pm:fieldName "distro" ;
    pm:fieldType "text" ;
    pm:order 4 .

pmid:record-family a pm:RecordField ;
    skos:definition "The system family, as the packaging table names it (debian, arch, macos)."@en ;
    pm:fieldName "family" ;
    pm:fieldType "text" ;
    pm:order 2 .

pmid:record-host a pm:RecordField ;
    skos:definition "What the computer is: wsl, vm, container or machine."@en ;
    pm:allowedValue "container",
        "machine",
        "vm",
        "wsl" ;
    pm:fieldName "host" ;
    pm:fieldType "text" ;
    pm:order 3 .

pmid:record-installed a pm:RecordField ;
    skos:definition "The day (YYYY-MM-DD) the account was first set up; a rerun keeps it."@en ;
    pm:fieldName "installed" ;
    pm:fieldType "date" ;
    pm:order 6 .

pmid:record-method a pm:RecordField ;
    skos:definition "How the account was set up: bootstrap (a computer set up whole) or setup (an account on a computer in use)."@en ;
    pm:allowedValue "bootstrap",
        "setup" ;
    pm:fieldName "method" ;
    pm:fieldType "text" ;
    pm:order 1 .

pmid:record-refreshed a pm:RecordField ;
    skos:definition "The day (YYYY-MM-DD) the setup last ran."@en ;
    pm:fieldName "refreshed" ;
    pm:fieldType "date" ;
    pm:order 7 .

