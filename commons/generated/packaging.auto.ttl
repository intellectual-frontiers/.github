pmid:pin-bun a pm:PinnedDownload ;
    rdfs:label "Bun, the one tool binary of IFC TypeScript: it installs, formats, lints, tests and packs"@en ;
    pm:note "Checksums from the release's SHASUMS256.txt. IFC TypeScript's CI takes its version and its address from here (commons 0005-typescript-runtime FR-026)."@en ;
    pm:pinKey "BUN" ;
    pm:programName "bun" ;
    pm:version "1.4.4" .

pmid:pin-gh a pm:PinnedDownload ;
    rdfs:label "gh, GitHub's command line, from the publisher's release on every platform"@en ;
    pm:note "The publisher's own release, put in the account's own folder; no package manager installs it (erga 009-machine-bootstrap FR-091). The checksum is the one the publisher states."@en ;
    pm:pinKey "GH" ;
    pm:programName "gh" ;
    pm:version "2.102.0" .

pmid:pin-jq a pm:PinnedDownload ;
    rdfs:label "jq, from the publisher's release on every platform"@en ;
    pm:note "The publisher's own release, put in the account's own folder; no package manager installs it (erga 009-machine-bootstrap FR-091). The checksum is the one the publisher states."@en ;
    pm:pinKey "JQ" ;
    pm:programName "jq" ;
    pm:version "1.8.2" .

pmid:pin-mise a pm:PinnedDownload ;
    rdfs:label "mise, the tool manager that installs the other programs of a computer"@en ;
    pm:note "Read before any Python exists."@en ;
    pm:pinKey "MISE" ;
    pm:programName "mise" ;
    pm:version "2026.10.3" .

pmid:pin-otelcol-contrib a pm:PinnedDownload ;
    rdfs:label "The OpenTelemetry Collector (contrib distribution), which IFC TypeScript's CI sends its OTLP to and reads back from its file exporter"@en ;
    pm:note "Used only by the conformance job on Linux x64 (commons 0006-signals FR-020); the checksum was taken from the release asset when it was pinned."@en ;
    pm:pinKey "OTELCOL_CONTRIB" ;
    pm:programName "otelcol-contrib" ;
    pm:version "0.165.0" .

pmid:pin-python a pm:PinnedDownload ;
    rdfs:label "the Python a harness runs on"@en ;
    pm:pinKey "PYTHON" ;
    pm:programName "python" ;
    pm:version "3.14.8" .

pmid:pin-rustup-init a pm:PinnedDownload ;
    rdfs:label "rustup-init, the installer of rustup, through which erga gets the Rust toolchain its rust-toolchain.toml names"@en ;
