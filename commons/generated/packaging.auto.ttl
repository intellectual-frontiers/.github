    pm:version "1.29.2" .

pmid:pin-uv a pm:PinnedDownload ;
    rdfs:label "uv, the launcher a harness starts Python with"@en ;
    pm:pinKey "UV" ;
    pm:programName "uv" ;
    pm:version "0.12.23" .

