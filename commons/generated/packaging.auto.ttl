pmid:family-alpine a pm:SystemFamily ;
    dcterms:identifier "alpine" ;
    rdfs:label "Alpine family"@en ;
    pm:assurance pm:NoAssurance ;
    pm:detectSource "os-release" ;
    pm:detectedBy "alpine",
        "postmarket" ;
    pm:note "the engine that archon replaced could use apk to install the libraries a program links against, untested; no script acts on this family." ;
    pm:preferredManager pmid:manager-apk ;
