    <mz:termIri>https://www.intellectualfrontiers.com/ontology/boundary#PartyRole</mz:termIri>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/id/mizan/term-boundary-ProcessingActivity">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#OntologyTerm"/>
    <rdfs:label xml:lang="en">bnd:ProcessingActivity</rdfs:label>
    <mz:basis rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Specializes"/>
    <mz:definedBy>0045-boundaries FR-032</mz:definedBy>
