    <mz:termIri>https://www.intellectualfrontiers.com/ontology/boundary#ProcessingActivity</mz:termIri>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/id/mizan/term-boundary-Realm">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#OntologyTerm"/>
    <rdfs:label xml:lang="en">bnd:Realm</rdfs:label>
    <mz:basis rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Specializes"/>
    <mz:definedBy>0044-asset-connections FR-003</mz:definedBy>
    <mz:mappingRelation>subClassOf</mz:mappingRelation>
    <mz:standardTerm>http://www.w3.org/ns/prov#Entity</mz:standardTerm>
    <mz:termIri>https://www.intellectualfrontiers.com/ontology/boundary#Realm</mz:termIri>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#AuthorizationBoundary">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#BoundaryKind"/>
    <rdfs:label xml:lang="en">Authorization boundary</rdfs:label>
    <skos:definition xml:lang="en">All the components of an information system that one authorizing official authorizes to operate; separately authorized systems it is connected to are outside it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#Boundary">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Boundary</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">The line a body of authority draws around the things it answers for, of a kind that a regime defines: typed, versioned and approved by a person. It is not a realm, which is where assets are found.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#BoundaryKind">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Boundary kind</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">One of the kinds of boundary: the authority, the roles of people, the roles of assets and the agreements a regime defines.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#CardholderData">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#DataClass"/>
    <rdfs:label xml:lang="en">Cardholder data</rdfs:label>
    <skos:definition xml:lang="en">The data of a payment card that the card brands' standard requires to be protected.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#CardholderDataEnvironment">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#BoundaryKind"/>
    <rdfs:label xml:lang="en">Cardholder data environment</rdfs:label>
    <skos:definition xml:lang="en">The system components, people and processes that store, process or transmit cardholder data or sensitive authentication data, and the components that are connected to them without restriction.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#Categorization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Categorization</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">The impact of each of the three security objectives (confidentiality, integrity, availability) of a boundary, as the highest impact among the information types it holds.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#CmmcAssetCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">CMMC asset category</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">One of the categories into which the assets of a CUI environment fall for assessment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#Confidential">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#DataClass"/>
    <rdfs:label xml:lang="en">Confidential</rdfs:label>
    <skos:definition xml:lang="en">Information whose disclosure the organization restricts to those who need it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#ContractorRiskManagedAsset">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#CmmcAssetCategory"/>
    <rdfs:label xml:lang="en">Contractor risk managed asset</rdfs:label>
    <skos:definition xml:lang="en">An asset that can, but is not meant to, handle controlled unclassified information because of the organization's policy, procedures and practice.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#Controller">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#PartyRole"/>
    <rdfs:label xml:lang="en">Controller</rdfs:label>
    <skos:definition xml:lang="en">The party that decides the purposes and means of processing personal data, alone or with others; a business, a Data Fiduciary or an organization in the words of other regimes.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#Cui">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#DataClass"/>
    <rdfs:label xml:lang="en">Controlled unclassified information</rdfs:label>
    <skos:definition xml:lang="en">Information the Government creates or holds, or an entity holds for it, that a law, regulation or Government-wide policy says is handled with safeguarding or dissemination controls.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#CuiAsset">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#CmmcAssetCategory"/>
    <rdfs:label xml:lang="en">CUI asset</rdfs:label>
    <skos:definition xml:lang="en">An asset that processes, stores or transmits controlled unclassified information.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#CuiEnvironment">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#BoundaryKind"/>
    <rdfs:label xml:lang="en">CUI environment</rdfs:label>
    <skos:definition xml:lang="en">The assessment scope of an organization that handles controlled unclassified information: the assets that process, store or transmit it, the ones that protect them and the ones the organization's own practice keeps from it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#DataClass">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Data class</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">One of the classes of data that a boundary holds and that a regime defines.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#Disposition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Disposition</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">One of the decisions about an asset in a boundary: in scope in a role, inherited, external, out of scope or undecided.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#Enclave">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Enclave</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:subClassOf rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#Boundary"/>
    <skos:definition xml:lang="en">A set of resources that work in one security domain and share the protection of one common, continuous perimeter; a network zone with a single policy and authority.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#EngagementScope">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#BoundaryKind"/>
    <rdfs:label xml:lang="en">Engagement scope</rdfs:label>
    <skos:definition xml:lang="en">The targets, actions and window that a signed engagement allows, and the targets that are off limits.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#Ephi">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#DataClass"/>
    <rdfs:label xml:lang="en">Electronic protected health information</rdfs:label>
    <skos:definition xml:lang="en">The part of protected health information that is transmitted or maintained in electronic media.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#EphiEnvironment">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#BoundaryKind"/>
    <rdfs:label xml:lang="en">ePHI environment</rdfs:label>
    <skos:definition xml:lang="en">The systems, people and services through which a covered entity or a business associate creates, receives, maintains or transmits electronic protected health information.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#External">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#Disposition"/>
    <rdfs:label xml:lang="en">External</rdfs:label>
    <skos:definition xml:lang="en">The asset stands for a system outside the fleet that the boundary relies on or exchanges information with.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#ExternalSystem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">External system</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">A system outside the fleet that a boundary relies on or exchanges information with, with what its party holds to show it may be relied on.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#Fci">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#DataClass"/>
    <rdfs:label xml:lang="en">Federal contract information</rdfs:label>
    <skos:definition xml:lang="en">Information provided by or generated for the Government under a contract that is not meant for public release.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#High">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#Impact"/>
    <rdfs:label xml:lang="en">High</rdfs:label>
    <skos:definition xml:lang="en">The loss of the objective would have a severe or catastrophic adverse effect on operations, assets or people.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#Impact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Impact</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">One of the ordered levels of potential harm from the loss of a security objective: low, moderate or high.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#InScope">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#Disposition"/>
    <rdfs:label xml:lang="en">In scope</rdfs:label>
    <skos:definition xml:lang="en">The asset is inside the boundary in a role the kind of the boundary names.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#Inheritance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Inheritance</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">What a provider's authorization, report or certificate supplies to a boundary: the controls it covers, who answers for each and the evidence with its dates.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#Inherited">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#Disposition"/>
    <rdfs:label xml:lang="en">Inherited</rdfs:label>
    <skos:definition xml:lang="en">The asset's requirements are met by what another party provides, under an inheritance that names the controls.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#Interconnection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Interconnection</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">An approved, agreed and reviewed crossing of a boundary: its two ends, the direction, the data classes, the agreement and the managed interface.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#Internal">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#DataClass"/>
    <rdfs:label xml:lang="en">Internal</rdfs:label>
    <skos:definition xml:lang="en">Information for the organization's own use that carries no further restriction.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#Jurisdiction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Jurisdiction</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">A country or region whose law governs the data held there; the location of data decides which laws apply to it and what a transfer out of it needs.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#Low">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#Impact"/>
    <rdfs:label xml:lang="en">Low</rdfs:label>
    <skos:definition xml:lang="en">The loss of the objective would have a limited adverse effect on operations, assets or people.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#Moderate">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#Impact"/>
    <rdfs:label xml:lang="en">Moderate</rdfs:label>
    <skos:definition xml:lang="en">The loss of the objective would have a serious adverse effect on operations, assets or people.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#NetworkZone">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#BoundaryKind"/>
    <rdfs:label xml:lang="en">Network zone</rdfs:label>
    <skos:definition xml:lang="en">A set of resources inside one common perimeter, joined to other zones only through managed interfaces: an enclave, a segment or a zone.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#Organizational">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#BoundaryKind"/>
    <rdfs:label xml:lang="en">Organizational boundary</rdfs:label>
    <skos:definition xml:lang="en">What one company, legal entity, tenant or client of a provider of managed services owns or answers for, or a part of it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#OutOfScope">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#Disposition"/>
    <rdfs:label xml:lang="en">Out of scope</rdfs:label>
    <skos:definition xml:lang="en">The asset is outside the boundary by a person's decision, with a justification, evidence and an expiry.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#OutOfScopeAsset">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#CmmcAssetCategory"/>
    <rdfs:label xml:lang="en">Out-of-scope asset</rdfs:label>
    <skos:definition xml:lang="en">An asset that cannot handle controlled unclassified information and does not protect the assets that do; the organization is prepared to justify that.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#PartyRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Party role</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">One of the two roles that privacy regimes give the parties to the processing of personal data: the one that decides and the one that processes for it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#PersonalData">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#DataClass"/>
    <rdfs:label xml:lang="en">Personal data</rdfs:label>
    <skos:definition xml:lang="en">Information about an identified or identifiable natural person, in the words of the privacy regime that governs it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#Phi">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#DataClass"/>
    <rdfs:label xml:lang="en">Protected health information</rdfs:label>
    <skos:definition xml:lang="en">Individually identifiable health information, in any form or medium, with the exclusions the rule lists.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#Privacy">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#BoundaryKind"/>
    <rdfs:label xml:lang="en">Privacy boundary</rdfs:label>
    <skos:definition xml:lang="en">The personal data and the processing activities that one controller or business answers for under one privacy regime.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#ProcessingActivity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Processing activity</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">A purpose of processing personal data with its legal basis, the people and data it concerns, the systems, the recipients, the transfers and the retention.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#Processor">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#PartyRole"/>
    <rdfs:label xml:lang="en">Processor</rdfs:label>
    <skos:definition xml:lang="en">The party that processes personal data on behalf of a controller; a service provider, a contractor, an operador, a data intermediary or a Data Processor in the words of other regimes.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#Public">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#DataClass"/>
    <rdfs:label xml:lang="en">Public</rdfs:label>
    <skos:definition xml:lang="en">Information that may be disclosed without restriction.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#Realm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Realm</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">Where assets are found and what a connection may read: an account, a tenant, a cluster, a site or a LAN. It says nothing about who answers for the assets.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#SecurityProtectionAsset">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#CmmcAssetCategory"/>
    <rdfs:label xml:lang="en">Security protection asset</rdfs:label>
    <skos:definition xml:lang="en">An asset that provides security functions or capabilities to the assessment scope.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#SecurityProtectionData">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#DataClass"/>
    <rdfs:label xml:lang="en">Security protection data</rdfs:label>
    <skos:definition xml:lang="en">Data about the protections of an environment: its configuration, logs and credentials.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#SensitiveAuthenticationData">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#DataClass"/>
    <rdfs:label xml:lang="en">Sensitive authentication data</rdfs:label>
    <skos:definition xml:lang="en">The data used to authenticate a cardholder or authorize a card transaction, which must not be kept after authorization.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#Soc2System">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#BoundaryKind"/>
    <rdfs:label xml:lang="en">SOC 2 system</rdfs:label>
    <skos:definition xml:lang="en">The system a service organization's report describes: its services, components, controls and the boundaries of what the description covers, with its subservice organizations.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#SpecialCategoryData">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#DataClass"/>
    <rdfs:label xml:lang="en">Special category data</rdfs:label>
    <skos:definition xml:lang="en">Personal data of the kinds a regime sets apart for stronger protection, such as health, biometric or beliefs.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#SpecializedAsset">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#CmmcAssetCategory"/>
    <rdfs:label xml:lang="en">Specialized asset</rdfs:label>
    <skos:definition xml:lang="en">An asset that can handle controlled unclassified information but cannot be fully secured: an internet-of-things or operational technology device, government furnished equipment, a restricted system or test equipment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#Trust">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#BoundaryKind"/>
    <rdfs:label xml:lang="en">Trust boundary</rdfs:label>
    <skos:definition xml:lang="en">A line of a threat model across which data or control passes between parts that are trusted differently.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#Undecided">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#Disposition"/>
    <rdfs:label xml:lang="en">Undecided</rdfs:label>
    <skos:definition xml:lang="en">No one has decided; every asset has this disposition in a boundary until a person decides, and it is a finding.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#boundaryId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#Boundary"/>
    <rdfs:label xml:lang="en">boundary id</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The id of the boundary: lower case words joined by hyphens.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#boundaryKind">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#Boundary"/>
    <rdfs:label xml:lang="en">boundary kind</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#BoundaryKind"/>
    <skos:definition xml:lang="en">The kind of the boundary, which decides its authority, roles and agreements.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#categorizedAs">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#Boundary"/>
    <rdfs:label xml:lang="en">categorized as</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#Categorization"/>
    <skos:definition xml:lang="en">The categorization of the boundary: the impact of each security objective.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary#residentIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#Boundary"/>
    <rdfs:label xml:lang="en">resident in</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary#Jurisdiction"/>
    <skos:definition xml:lang="en">The jurisdiction in which the data of the boundary is held; the data residency the boundary is constrained to.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/boundary">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <ns1:description xml:lang="en">The vocabulary of Boundaries: a boundary as the accountability scope of a kind that a regime defines, the dispositions of assets in it, the interconnections that cross it and what it inherits.</ns1:description>
    <rdfs:label xml:lang="en">Boundary</rdfs:label>
    <owl:versionIRI rdf:resource="https://www.intellectualfrontiers.com/ontology/boundary/1.0.0"/>
    <owl:versionInfo>1.0.0</owl:versionInfo>
  </rdf:Description>
</rdf:RDF>
