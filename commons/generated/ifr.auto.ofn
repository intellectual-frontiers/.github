AnnotationAssertion(rdfs:label ifr:ApprovalRecord "Approval record"@en)
AnnotationAssertion(skos:definition ifr:ApprovalRecord "The approval of a revision of a controlled document: a person, a role, a day and the Decision."@en)
SubClassOf(ifr:ApprovalRecord prov:Entity)
AnnotationAssertion(rdfs:label ifr:Citation "Citation"@en)
AnnotationAssertion(skos:definition ifr:Citation "How a work is cited: its `CITATION.cff`, generated from its release record, with a DOI only where the record carries one."@en)
AnnotationAssertion(rdfs:label ifr:Edition "Edition"@en)
AnnotationAssertion(skos:definition ifr:Edition "A release of published prose, whose version is a commit-date edition."@en)
SubClassOf(ifr:Edition ifr:Release)
AnnotationAssertion(rdfs:label ifr:Expression "Expression"@en)
AnnotationAssertion(skos:definition ifr:Expression "A state of a work's content, which a version or an edition names: the text or the code as it was at one commit, in no form yet."@en)
SubClassOf(ifr:Expression schema:CreativeWork)
AnnotationAssertion(rdfs:label ifr:Impact "Impact"@en)
AnnotationAssertion(skos:definition ifr:Impact "Major, minor or patch: what a change does to those who use the work, from which the next version is made."@en)
AnnotationAssertion(rdfs:label ifr:Manifestation "Manifestation"@en)
AnnotationAssertion(skos:definition ifr:Manifestation "A rendition of an expression: a PDF, an EPUB, a print run, a package; it has a format and, where printed, a printing, and no version of its own."@en)
SubClassOf(ifr:Manifestation schema:CreativeWork)
AnnotationAssertion(rdfs:label ifr:Release "Release"@en)
AnnotationAssertion(skos:definition ifr:Release "A version of a work that was published: it names its commit and its Git tree hash, is named by a signed annotated tag and is immutable."@en)
SubClassOf(ifr:Release prov:Entity)
AnnotationAssertion(rdfs:label ifr:ReleaseRecord "Release record"@en)
AnnotationAssertion(skos:definition ifr:ReleaseRecord "The typed file `<work>/release.ts` that names a work's kind, its identity and its present version, written by a tool and never by hand."@en)
SubClassOf(ifr:ReleaseRecord prov:Entity)
AnnotationAssertion(rdfs:label ifr:ReleaseTag "Release tag"@en)
AnnotationAssertion(skos:definition ifr:ReleaseTag "The signed annotated Git tag `<slug>-v<version>` that makes a version a release; the ledger of releases is derived from these tags."@en)
AnnotationAssertion(rdfs:label ifr:Retention "Retention"@en)
AnnotationAssertion(skos:definition ifr:Retention "How long the bytes of a published version are kept: digests and metadata are kept forever, bytes only for the period stated."@en)
AnnotationAssertion(rdfs:label ifr:Tombstone "Tombstone"@en)
AnnotationAssertion(skos:definition ifr:Tombstone "What an identifier resolves to where the bytes of a version are gone: the version's metadata, its digest and the day the bytes were removed."@en)
AnnotationAssertion(rdfs:label ifr:VersionScheme "Version scheme"@en)
AnnotationAssertion(skos:definition ifr:VersionScheme "One way of writing a version and ordering versions: SemVer, commit-date edition, snapshot date, integer revision or none."@en)
AnnotationAssertion(rdfs:label ifr:Work "Work"@en)
AnnotationAssertion(skos:definition ifr:Work "A work in its identity: a slug and an IRI that never change, whatever is published of it and however often; a volume's position in a series never changes either."@en)
SubClassOf(ifr:Work schema:CreativeWork)
