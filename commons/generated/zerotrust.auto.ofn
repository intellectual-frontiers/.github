AnnotationAssertion(rdfs:label zt:AccessDecision "Access decision"@en)
AnnotationAssertion(skos:definition zt:AccessDecision "The signed record of one decision about one request: the subject, the posture signals of its device, the context, the resource, the policy by hash, the outcome, the reasons and the evidence."@en)
SubClassOf(zt:AccessDecision prov:Entity)
AnnotationAssertion(rdfs:label zt:Activity "Zero trust activity"@en)
AnnotationAssertion(skos:definition zt:Activity "One thing a maturity model asks an organization to do, in one area, at one stage; the names are written from the model when it is read."@en)
SubClassOf(zt:Activity prov:Entity)
AnnotationAssertion(rdfs:label zt:DataSource "Source of input"@en)
AnnotationAssertion(skos:definition zt:DataSource "One of the sources that give the policy engine the input and the rules it decides with."@en)
SubClassOf(zt:DataSource skos:Concept)
AnnotationAssertion(rdfs:label zt:ImplicitTrust "Implicit trust"@en)
AnnotationAssertion(skos:definition zt:ImplicitTrust "A place where access is allowed because of where the request comes from, whose it is or how long ago it was granted, and not because of a decision."@en)
SubClassOf(zt:ImplicitTrust prov:Entity)
AnnotationAssertion(rdfs:label zt:MaturityStage "Maturity stage"@en)
AnnotationAssertion(skos:definition zt:MaturityStage "One of the ordered stages a maturity model gives for how far an area has gone; the members are written from the model when it is read."@en)
SubClassOf(zt:MaturityStage skos:Concept)
AnnotationAssertion(rdfs:label zt:Pillar "Pillar"@en)
AnnotationAssertion(skos:definition zt:Pillar "One of the areas of effort of zero trust, or one of the themes across them."@en)
SubClassOf(zt:Pillar skos:Concept)
AnnotationAssertion(rdfs:label zt:PolicyAdministrator "Policy administrator"@en)
AnnotationAssertion(skos:definition zt:PolicyAdministrator "The part of the decision point that opens or shuts the path between a subject and a resource on the engine's decision and makes any credential of the session."@en)
SubClassOf(zt:PolicyAdministrator prov:Entity)
AnnotationAssertion(rdfs:label zt:PolicyDecisionPoint "Policy decision point"@en)
AnnotationAssertion(skos:definition zt:PolicyDecisionPoint "The part that decides whether a subject may reach a resource: a policy engine that decides and a policy administrator that carries the decision out."@en)
SubClassOf(zt:PolicyDecisionPoint prov:Entity)
AnnotationAssertion(rdfs:label zt:PolicyEnforcementPoint "Policy enforcement point"@en)
AnnotationAssertion(skos:definition zt:PolicyEnforcementPoint "The part that enables, watches and ends the connection between a subject and a resource on the administrator's instruction."@en)
SubClassOf(zt:PolicyEnforcementPoint prov:Entity)
AnnotationAssertion(rdfs:label zt:PolicyEngine "Policy engine"@en)
AnnotationAssertion(skos:definition zt:PolicyEngine "The part of the decision point that grants, denies or revokes access from the policy and the outside inputs, and logs the decision."@en)
SubClassOf(zt:PolicyEngine prov:Entity)
AnnotationAssertion(rdfs:label zt:PostureSignal "Posture signal"@en)
AnnotationAssertion(skos:definition zt:PostureSignal "A reading about a subject or a device that an access decision used, with its source and its age."@en)
SubClassOf(zt:PostureSignal prov:Entity)
AnnotationAssertion(rdfs:label zt:ProtectSurface "Protect surface"@en)
AnnotationAssertion(skos:definition zt:ProtectSurface "The smallest part of an estate that one access policy names and protects: an asset, a population or a store of data; it is a boundary of the kind trust, and every path into it needs an access decision."@en)
SubClassOf(zt:ProtectSurface prov:Entity)
AnnotationAssertion(rdfs:label zt:Tenet "Tenet"@en)
AnnotationAssertion(skos:definition zt:Tenet "One of the basic principles the architecture standard gives for a zero trust architecture."@en)
SubClassOf(zt:Tenet skos:Concept)
AnnotationAssertion(rdfs:label zt:ZeroTrustArchitecture "Zero trust architecture"@en)
AnnotationAssertion(skos:definition zt:ZeroTrustArchitecture "An organization's plan for deciding every access to a resource on its own, with the least privilege the request needs, in a network seen as compromised: the components, their relations, the workflows and the access policies."@en)
SubClassOf(zt:ZeroTrustArchitecture prov:Entity)
AnnotationAssertion(rdfs:label zt:decidedBy "decided by"@en)
AnnotationAssertion(skos:definition zt:decidedBy "The decision point that made the access decision."@en)
ObjectPropertyDomain(zt:decidedBy zt:AccessDecision)
ObjectPropertyRange(zt:decidedBy zt:PolicyDecisionPoint)
AnnotationAssertion(rdfs:label zt:enforcedAt "enforced at"@en)
AnnotationAssertion(skos:definition zt:enforcedAt "The enforcement point that carried out the access decision."@en)
ObjectPropertyDomain(zt:enforcedAt zt:AccessDecision)
ObjectPropertyRange(zt:enforcedAt zt:PolicyEnforcementPoint)
AnnotationAssertion(rdfs:label zt:onSurface "on surface"@en)
AnnotationAssertion(skos:definition zt:onSurface "The protect surface the access decision was about."@en)
ObjectPropertyDomain(zt:onSurface zt:AccessDecision)
ObjectPropertyRange(zt:onSurface zt:ProtectSurface)
