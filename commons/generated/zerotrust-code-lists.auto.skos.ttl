@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://www.intellectualfrontiers.com/ontology/zerotrust#TenetScheme> a skos:ConceptScheme ;
    skos:prefLabel "Tenet"@en .

<https://www.intellectualfrontiers.com/ontology/zerotrust#EverythingIsAResource> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/zerotrust#TenetScheme> ;
    skos:notation "EverythingIsAResource" ;
    skos:prefLabel "Everything is a resource"@en ;
    skos:definition "Every data source and computing service is a resource, whatever its size, including the devices an organization lets reach its resources."@en .

<https://www.intellectualfrontiers.com/ontology/zerotrust#CommunicationIsSecuredAnywhere> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/zerotrust#TenetScheme> ;
    skos:notation "CommunicationIsSecuredAnywhere" ;
    skos:prefLabel "Communication is secured anywhere"@en ;
    skos:definition "Every communication is protected for confidentiality, integrity and the authentication of its source, and a network location alone grants no trust."@en .

<https://www.intellectualfrontiers.com/ontology/zerotrust#AccessIsPerSession> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/zerotrust#TenetScheme> ;
    skos:notation "AccessIsPerSession" ;
    skos:prefLabel "Access is per session"@en ;
    skos:definition "Access to one resource is granted for one session with the least privilege the task needs, after the requester is evaluated; a grant for one resource carries to no other."@en .

<https://www.intellectualfrontiers.com/ontology/zerotrust#PolicyIsDynamic> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/zerotrust#TenetScheme> ;
    skos:notation "PolicyIsDynamic" ;
    skos:prefLabel "Policy is dynamic"@en ;
    skos:definition "Access is decided by rules over the observable state of the identity, the application and the requesting asset, and over behavior and the environment, stricter as the resource is more sensitive."@en .

<https://www.intellectualfrontiers.com/ontology/zerotrust#PostureIsMonitored> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/zerotrust#TenetScheme> ;
    skos:notation "PostureIsMonitored" ;
    skos:prefLabel "Posture is monitored"@en ;
    skos:definition "The organization measures the integrity and security posture of every asset it owns or is associated with, and trusts no asset for what it is."@en .

<https://www.intellectualfrontiers.com/ontology/zerotrust#EnforcementIsDynamic> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/zerotrust#TenetScheme> ;
    skos:notation "EnforcementIsDynamic" ;
    skos:prefLabel "Authentication and authorization are dynamic and enforced"@en ;
    skos:definition "Authentication and authorization are repeated on the events the policy names and strictly enforced before access, as a constant cycle of access, assessment and adaptation."@en .

<https://www.intellectualfrontiers.com/ontology/zerotrust#StateIsCollected> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/zerotrust#TenetScheme> ;
    skos:notation "StateIsCollected" ;
    skos:prefLabel "State is collected"@en ;
    skos:definition "The organization collects as much as it can about the state of its assets, network and communications and uses it to improve the policy and its enforcement."@en .

<https://www.intellectualfrontiers.com/ontology/zerotrust#PillarScheme> a skos:ConceptScheme ;
    skos:prefLabel "Pillar"@en .

<https://www.intellectualfrontiers.com/ontology/zerotrust#Identity> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/zerotrust#PillarScheme> ;
    skos:notation "Identity" ;
    skos:prefLabel "Identity"@en ;
    skos:definition "Who or what asks for access: enterprise-managed identities, strong authentication that resists phishing, and the identity systems that hold them."@en .

<https://www.intellectualfrontiers.com/ontology/zerotrust#Devices> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/zerotrust#PillarScheme> ;
    skos:notation "Devices" ;
    skos:prefLabel "Devices"@en ;
    skos:definition "What the request comes from: the inventory of every device in use, its state, and the ability to prevent, detect and respond to incidents on it."@en .

<https://www.intellectualfrontiers.com/ontology/zerotrust#Networks> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/zerotrust#PillarScheme> ;
    skos:notation "Networks" ;
    skos:prefLabel "Networks"@en ;
    skos:definition "How the request travels: encrypted traffic and names, and perimeters broken into isolated environments."@en .

<https://www.intellectualfrontiers.com/ontology/zerotrust#ApplicationsAndWorkloads> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/zerotrust#PillarScheme> ;
    skos:notation "ApplicationsAndWorkloads" ;
    skos:prefLabel "Applications and workloads"@en ;
    skos:definition "What the request reaches: applications treated as reachable from the internet, tested rigorously and open to outside reports of weaknesses."@en .

<https://www.intellectualfrontiers.com/ontology/zerotrust#Data> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/zerotrust#PillarScheme> ;
    skos:notation "Data" ;
    skos:prefLabel "Data"@en ;
    skos:definition "What is protected: data that is categorized, protected by what its category needs, and whose access is monitored and logged."@en .

<https://www.intellectualfrontiers.com/ontology/zerotrust#VisibilityAndAnalytics> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/zerotrust#PillarScheme> ;
    skos:notation "VisibilityAndAnalytics" ;
    skos:prefLabel "Visibility and analytics"@en ;
    skos:definition "A theme across the areas: the collection and analysis of what happens, which feeds the decisions."@en .

<https://www.intellectualfrontiers.com/ontology/zerotrust#AutomationAndOrchestration> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/zerotrust#PillarScheme> ;
    skos:notation "AutomationAndOrchestration" ;
    skos:prefLabel "Automation and orchestration"@en ;
    skos:definition "A theme across the areas: the decisions and responses that machines carry out by policy."@en .

<https://www.intellectualfrontiers.com/ontology/zerotrust#Governance> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/zerotrust#PillarScheme> ;
    skos:notation "Governance" ;
    skos:prefLabel "Governance"@en ;
    skos:definition "A theme across the areas: the policies, roles and accountability that decide how the areas are run."@en .

<https://www.intellectualfrontiers.com/ontology/zerotrust#DataSourceScheme> a skos:ConceptScheme ;
    skos:prefLabel "DataSource"@en .

<https://www.intellectualfrontiers.com/ontology/zerotrust#Diagnostics> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/zerotrust#DataSourceScheme> ;
    skos:notation "Diagnostics" ;
    skos:prefLabel "Continuous diagnostics and mitigation"@en ;
    skos:definition "The system that gathers the current state of assets and applies updates to their configuration and software, and so tells the engine what a requesting asset runs and whether it is vulnerable."@en .

<https://www.intellectualfrontiers.com/ontology/zerotrust#ComplianceSystem> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/zerotrust#DataSourceScheme> ;
    skos:notation "ComplianceSystem" ;
    skos:prefLabel "Compliance system"@en ;
    skos:definition "The system that holds the rules of the regime the organization falls under, so that the policy follows them."@en .

<https://www.intellectualfrontiers.com/ontology/zerotrust#ThreatIntelligence> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/zerotrust#DataSourceScheme> ;
    skos:notation "ThreatIntelligence" ;
    skos:prefLabel "Threat intelligence"@en ;
    skos:definition "Feeds, internal or external, about newly found attacks, weaknesses and malware that the engine weighs."@en .

<https://www.intellectualfrontiers.com/ontology/zerotrust#ActivityLogs> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/zerotrust#DataSourceScheme> ;
    skos:notation "ActivityLogs" ;
    skos:prefLabel "Network and system activity logs"@en ;
    skos:definition "The aggregate of asset logs, traffic and access actions that gives near real time feedback on posture."@en .

<https://www.intellectualfrontiers.com/ontology/zerotrust#AccessPolicies> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/zerotrust#DataSourceScheme> ;
    skos:notation "AccessPolicies" ;
    skos:prefLabel "Data access policies"@en ;
    skos:definition "The attributes, rules and policies about access to resources, the starting point for authorizing it."@en .

<https://www.intellectualfrontiers.com/ontology/zerotrust#PublicKeyInfrastructure> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/zerotrust#DataSourceScheme> ;
    skos:notation "PublicKeyInfrastructure" ;
    skos:prefLabel "Public key infrastructure"@en ;
    skos:definition "The system that issues and logs the certificates of resources, subjects, services and applications."@en .

<https://www.intellectualfrontiers.com/ontology/zerotrust#IdentityManagement> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/zerotrust#DataSourceScheme> ;
    skos:notation "IdentityManagement" ;
    skos:prefLabel "Identity management"@en ;
    skos:definition "The system that creates, stores and manages the accounts and identity records, with the role and attributes of each."@en .

<https://www.intellectualfrontiers.com/ontology/zerotrust#EventManagement> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/zerotrust#DataSourceScheme> ;
    skos:notation "EventManagement" ;
    skos:prefLabel "Security information and event management"@en ;
    skos:definition "The system that collects security information for analysis, to refine policy and warn of attacks."@en .
