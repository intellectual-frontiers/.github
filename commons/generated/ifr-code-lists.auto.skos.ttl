    skos:notation "IntegerRevision" ;
    skos:prefLabel "integer revision"@en ;
    skos:definition "A whole number from 1 that a controlled document's revision carries, raised only with an approval record."@en .

<https://www.intellectualfrontiers.com/ontology/ifr#NoVersion> a skos:Concept ;
