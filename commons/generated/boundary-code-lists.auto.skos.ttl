@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://www.intellectualfrontiers.com/ontology/boundary#BoundaryKindScheme> a skos:ConceptScheme ;
    skos:prefLabel "BoundaryKind"@en .

<https://www.intellectualfrontiers.com/ontology/boundary#AuthorizationBoundary> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/boundary#BoundaryKindScheme> ;
    skos:notation "AuthorizationBoundary" ;
    skos:prefLabel "Authorization boundary"@en ;
    skos:definition "All the components of an information system that one authorizing official authorizes to operate; separately authorized systems it is connected to are outside it."@en .

<https://www.intellectualfrontiers.com/ontology/boundary#CuiEnvironment> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/boundary#BoundaryKindScheme> ;
    skos:notation "CuiEnvironment" ;
    skos:prefLabel "CUI environment"@en ;
    skos:definition "The assessment scope of an organization that handles controlled unclassified information: the assets that process, store or transmit it, the ones that protect them and the ones the organization's own practice keeps from it."@en .

<https://www.intellectualfrontiers.com/ontology/boundary#EphiEnvironment> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/boundary#BoundaryKindScheme> ;
    skos:notation "EphiEnvironment" ;
    skos:prefLabel "ePHI environment"@en ;
    skos:definition "The systems, people and services through which a covered entity or a business associate creates, receives, maintains or transmits electronic protected health information."@en .

<https://www.intellectualfrontiers.com/ontology/boundary#CardholderDataEnvironment> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/boundary#BoundaryKindScheme> ;
    skos:notation "CardholderDataEnvironment" ;
    skos:prefLabel "Cardholder data environment"@en ;
    skos:definition "The system components, people and processes that store, process or transmit cardholder data or sensitive authentication data, and the components that are connected to them without restriction."@en .

<https://www.intellectualfrontiers.com/ontology/boundary#Soc2System> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/boundary#BoundaryKindScheme> ;
    skos:notation "Soc2System" ;
    skos:prefLabel "SOC 2 system"@en ;
    skos:definition "The system a service organization's report describes: its services, components, controls and the boundaries of what the description covers, with its subservice organizations."@en .

<https://www.intellectualfrontiers.com/ontology/boundary#Privacy> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/boundary#BoundaryKindScheme> ;
    skos:notation "Privacy" ;
    skos:prefLabel "Privacy boundary"@en ;
    skos:definition "The personal data and the processing activities that one controller or business answers for under one privacy regime."@en .

<https://www.intellectualfrontiers.com/ontology/boundary#Organizational> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/boundary#BoundaryKindScheme> ;
    skos:notation "Organizational" ;
    skos:prefLabel "Organizational boundary"@en ;
    skos:definition "What one company, legal entity, tenant or client of a provider of managed services owns or answers for, or a part of it."@en .

<https://www.intellectualfrontiers.com/ontology/boundary#NetworkZone> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/boundary#BoundaryKindScheme> ;
    skos:notation "NetworkZone" ;
    skos:prefLabel "Network zone"@en ;
    skos:definition "A set of resources inside one common perimeter, joined to other zones only through managed interfaces: an enclave, a segment or a zone."@en .

<https://www.intellectualfrontiers.com/ontology/boundary#Trust> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/boundary#BoundaryKindScheme> ;
    skos:notation "Trust" ;
    skos:prefLabel "Trust boundary"@en ;
    skos:definition "A line of a threat model across which data or control passes between parts that are trusted differently."@en .

<https://www.intellectualfrontiers.com/ontology/boundary#EngagementScope> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/boundary#BoundaryKindScheme> ;
    skos:notation "EngagementScope" ;
    skos:prefLabel "Engagement scope"@en ;
    skos:definition "The targets, actions and window that a signed engagement allows, and the targets that are off limits."@en .

<https://www.intellectualfrontiers.com/ontology/boundary#DispositionScheme> a skos:ConceptScheme ;
    skos:prefLabel "Disposition"@en .

<https://www.intellectualfrontiers.com/ontology/boundary#InScope> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/boundary#DispositionScheme> ;
    skos:notation "InScope" ;
    skos:prefLabel "In scope"@en ;
    skos:definition "The asset is inside the boundary in a role the kind of the boundary names."@en .

<https://www.intellectualfrontiers.com/ontology/boundary#Inherited> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/boundary#DispositionScheme> ;
    skos:notation "Inherited" ;
    skos:prefLabel "Inherited"@en ;
    skos:definition "The asset's requirements are met by what another party provides, under an inheritance that names the controls."@en .

<https://www.intellectualfrontiers.com/ontology/boundary#External> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/boundary#DispositionScheme> ;
    skos:notation "External" ;
    skos:prefLabel "External"@en ;
    skos:definition "The asset stands for a system outside the fleet that the boundary relies on or exchanges information with."@en .

<https://www.intellectualfrontiers.com/ontology/boundary#OutOfScope> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/boundary#DispositionScheme> ;
    skos:notation "OutOfScope" ;
    skos:prefLabel "Out of scope"@en ;
    skos:definition "The asset is outside the boundary by a person's decision, with a justification, evidence and an expiry."@en .

<https://www.intellectualfrontiers.com/ontology/boundary#Undecided> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/boundary#DispositionScheme> ;
    skos:notation "Undecided" ;
    skos:prefLabel "Undecided"@en ;
    skos:definition "No one has decided; every asset has this disposition in a boundary until a person decides, and it is a finding."@en .

<https://www.intellectualfrontiers.com/ontology/boundary#ImpactScheme> a skos:ConceptScheme ;
    skos:prefLabel "Impact"@en .

<https://www.intellectualfrontiers.com/ontology/boundary#Low> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/boundary#ImpactScheme> ;
    skos:notation "Low" ;
    skos:prefLabel "Low"@en ;
    skos:definition "The loss of the objective would have a limited adverse effect on operations, assets or people."@en .

<https://www.intellectualfrontiers.com/ontology/boundary#Moderate> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/boundary#ImpactScheme> ;
    skos:notation "Moderate" ;
    skos:prefLabel "Moderate"@en ;
    skos:definition "The loss of the objective would have a serious adverse effect on operations, assets or people."@en .

<https://www.intellectualfrontiers.com/ontology/boundary#High> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/boundary#ImpactScheme> ;
    skos:notation "High" ;
    skos:prefLabel "High"@en ;
    skos:definition "The loss of the objective would have a severe or catastrophic adverse effect on operations, assets or people."@en .

<https://www.intellectualfrontiers.com/ontology/boundary#CmmcAssetCategoryScheme> a skos:ConceptScheme ;
    skos:prefLabel "CmmcAssetCategory"@en .

<https://www.intellectualfrontiers.com/ontology/boundary#CuiAsset> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/boundary#CmmcAssetCategoryScheme> ;
    skos:notation "CuiAsset" ;
    skos:prefLabel "CUI asset"@en ;
    skos:definition "An asset that processes, stores or transmits controlled unclassified information."@en .

<https://www.intellectualfrontiers.com/ontology/boundary#SecurityProtectionAsset> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/boundary#CmmcAssetCategoryScheme> ;
    skos:notation "SecurityProtectionAsset" ;
    skos:prefLabel "Security protection asset"@en ;
    skos:definition "An asset that provides security functions or capabilities to the assessment scope."@en .

<https://www.intellectualfrontiers.com/ontology/boundary#ContractorRiskManagedAsset> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/boundary#CmmcAssetCategoryScheme> ;
    skos:notation "ContractorRiskManagedAsset" ;
    skos:prefLabel "Contractor risk managed asset"@en ;
    skos:definition "An asset that can, but is not meant to, handle controlled unclassified information because of the organization's policy, procedures and practice."@en .

<https://www.intellectualfrontiers.com/ontology/boundary#SpecializedAsset> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/boundary#CmmcAssetCategoryScheme> ;
    skos:notation "SpecializedAsset" ;
    skos:prefLabel "Specialized asset"@en ;
    skos:definition "An asset that can handle controlled unclassified information but cannot be fully secured: an internet-of-things or operational technology device, government furnished equipment, a restricted system or test equipment."@en .

<https://www.intellectualfrontiers.com/ontology/boundary#OutOfScopeAsset> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/boundary#CmmcAssetCategoryScheme> ;
    skos:notation "OutOfScopeAsset" ;
    skos:prefLabel "Out-of-scope asset"@en ;
    skos:definition "An asset that cannot handle controlled unclassified information and does not protect the assets that do; the organization is prepared to justify that."@en .

<https://www.intellectualfrontiers.com/ontology/boundary#PartyRoleScheme> a skos:ConceptScheme ;
    skos:prefLabel "PartyRole"@en .

<https://www.intellectualfrontiers.com/ontology/boundary#Controller> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/boundary#PartyRoleScheme> ;
    skos:notation "Controller" ;
    skos:prefLabel "Controller"@en ;
    skos:definition "The party that decides the purposes and means of processing personal data, alone or with others; a business, a Data Fiduciary or an organization in the words of other regimes."@en .

<https://www.intellectualfrontiers.com/ontology/boundary#Processor> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/boundary#PartyRoleScheme> ;
    skos:notation "Processor" ;
    skos:prefLabel "Processor"@en ;
    skos:definition "The party that processes personal data on behalf of a controller; a service provider, a contractor, an operador, a data intermediary or a Data Processor in the words of other regimes."@en .

<https://www.intellectualfrontiers.com/ontology/boundary#DataClassScheme> a skos:ConceptScheme ;
    skos:prefLabel "DataClass"@en .

<https://www.intellectualfrontiers.com/ontology/boundary#Fci> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/boundary#DataClassScheme> ;
    skos:notation "Fci" ;
    skos:prefLabel "Federal contract information"@en ;
    skos:definition "Information provided by or generated for the Government under a contract that is not meant for public release."@en .

<https://www.intellectualfrontiers.com/ontology/boundary#Cui> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/boundary#DataClassScheme> ;
    skos:notation "Cui" ;
    skos:prefLabel "Controlled unclassified information"@en ;
    skos:definition "Information the Government creates or holds, or an entity holds for it, that a law, regulation or Government-wide policy says is handled with safeguarding or dissemination controls."@en .

<https://www.intellectualfrontiers.com/ontology/boundary#Phi> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/boundary#DataClassScheme> ;
    skos:notation "Phi" ;
    skos:prefLabel "Protected health information"@en ;
    skos:definition "Individually identifiable health information, in any form or medium, with the exclusions the rule lists."@en .

<https://www.intellectualfrontiers.com/ontology/boundary#Ephi> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/boundary#DataClassScheme> ;
    skos:notation "Ephi" ;
    skos:prefLabel "Electronic protected health information"@en ;
    skos:definition "The part of protected health information that is transmitted or maintained in electronic media."@en .

<https://www.intellectualfrontiers.com/ontology/boundary#PersonalData> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/boundary#DataClassScheme> ;
    skos:notation "PersonalData" ;
    skos:prefLabel "Personal data"@en ;
    skos:definition "Information about an identified or identifiable natural person, in the words of the privacy regime that governs it."@en .

<https://www.intellectualfrontiers.com/ontology/boundary#SpecialCategoryData> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/boundary#DataClassScheme> ;
    skos:notation "SpecialCategoryData" ;
    skos:prefLabel "Special category data"@en ;
    skos:definition "Personal data of the kinds a regime sets apart for stronger protection, such as health, biometric or beliefs."@en .

<https://www.intellectualfrontiers.com/ontology/boundary#CardholderData> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/boundary#DataClassScheme> ;
    skos:notation "CardholderData" ;
    skos:prefLabel "Cardholder data"@en ;
    skos:definition "The data of a payment card that the card brands' standard requires to be protected."@en .

<https://www.intellectualfrontiers.com/ontology/boundary#SensitiveAuthenticationData> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/boundary#DataClassScheme> ;
    skos:notation "SensitiveAuthenticationData" ;
    skos:prefLabel "Sensitive authentication data"@en ;
    skos:definition "The data used to authenticate a cardholder or authorize a card transaction, which must not be kept after authorization."@en .

<https://www.intellectualfrontiers.com/ontology/boundary#SecurityProtectionData> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/boundary#DataClassScheme> ;
    skos:notation "SecurityProtectionData" ;
    skos:prefLabel "Security protection data"@en ;
    skos:definition "Data about the protections of an environment: its configuration, logs and credentials."@en .

<https://www.intellectualfrontiers.com/ontology/boundary#Confidential> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/boundary#DataClassScheme> ;
    skos:notation "Confidential" ;
    skos:prefLabel "Confidential"@en ;
    skos:definition "Information whose disclosure the organization restricts to those who need it."@en .

<https://www.intellectualfrontiers.com/ontology/boundary#Internal> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/boundary#DataClassScheme> ;
    skos:notation "Internal" ;
    skos:prefLabel "Internal"@en ;
    skos:definition "Information for the organization's own use that carries no further restriction."@en .

<https://www.intellectualfrontiers.com/ontology/boundary#Public> a skos:Concept ;
    skos:inScheme <https://www.intellectualfrontiers.com/ontology/boundary#DataClassScheme> ;
    skos:notation "Public" ;
    skos:prefLabel "Public"@en ;
    skos:definition "Information that may be disclosed without restriction."@en .
