act:Act a owl:Class ;
    rdfs:label "Act"@en ;
    rdfs:subClassOf prov:Activity ;
    skos:definition "One act of a regulated flow: a step that changes a record or a system, with the actors that held a role in it and the directive it was done under."@en .

act:Actor a owl:Class ;
    rdfs:label "Actor"@en ;
    rdfs:subClassOf prov:Agent ;
    skos:definition "A person, a system or an agent that takes part in an act. In PROV it is an agent; here the word agent is kept for the AI case."@en .

act:ActorKind a owl:Class ;
    rdfs:label "Kind of actor"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "One of the three kinds of actor: a person, a system or an agent."@en .

act:Agent a act:ActorKind ;
    rdfs:label "Agent"@en ;
    skos:definition "An AI agent: a model run under instructions with tools. It is instructed, not accountable, and what it makes is a draft until a person or a validated mechanism clears it."@en .

act:Approval a act:SignatureMeaning ;
    rdfs:label "Approval"@en ;
    skos:definition "The signer approved the record or the plan it names, by its hash."@en .

act:Approver a act:Role ;
    rdfs:label "Approver"@en ;
    skos:definition "A person whose signature, with a key of their own, bound the plan hash of the act."@en .

act:Assistant a act:Role ;
    rdfs:label "Assistant"@en ;
    skos:definition "An agent or a system that operated a tool during a step of the act, under a directive and a tasking."@en .

act:Authorship a act:SignatureMeaning ;
    rdfs:label "Authorship"@en ;
    skos:definition "The signer made the record."@en .

act:Directive a owl:Class ;
    rdfs:label "Directive"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "A controlled instruction an act is done under: a work order, a specification, a procedure or a person's request kept by its digest, with an owner who is a person and a version."@en .

act:Executor a act:Role ;
    rdfs:label "Executor"@en ;
    skos:definition "The person, or the validated mechanism, that carried the step out."@en .

act:Initiator a act:Role ;
    rdfs:label "Initiator"@en ;
    skos:definition "The person whose request, or whose standing directive, is why the act happens; an agent is never one."@en .

act:NonconformityRule a owl:Class ;
    rdfs:label "Nonconformity rule"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "One of the rules whose breach by an act is recorded as a nonconformance of the quality ontology."@en .

act:OutsideTasking a act:NonconformityRule ;
    rdfs:label "Outside tasking"@en ;
    skos:definition "An agent acted beyond the scope, level or expiry of its tasking, or after it was revoked."@en .

act:Person a act:ActorKind ;
    rdfs:label "Person"@en ;
    skos:definition "A human being, who can be accountable and can sign."@en .

act:Preparer a act:Role ;
    rdfs:label "Preparer"@en ;
    skos:definition "The actor that made the artifact of the act: a document, a change, a test or a plan. Any kind of actor can prepare."@en .

act:Qualification a owl:Class ;
    rdfs:label "Qualification"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "The record that an agent configuration (model and version, instruction set digest, tool permissions) was shown fit for a use, with its evidence, its validity and the changes that require it to be redone."@en .

act:RegulatedVerbRefused a act:NonconformityRule ;
    rdfs:label "Regulated verb refused"@en ;
    skos:definition "An agent asked for a verb that changes a regulated record or a system, and it was refused."@en .

act:Responsibility a act:SignatureMeaning ;
    rdfs:label "Responsibility"@en ;
    skos:definition "The signer takes responsibility for what the record states."@en .

act:Review a act:SignatureMeaning ;
    rdfs:label "Review"@en ;
    skos:definition "The signer read the record and found it fit for its purpose."@en .

act:ReviewCanary a owl:Class ;
    rdfs:label "Review canary"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "A defect seeded into an artifact, so that whether a review catches it measures whether the review is real."@en .

act:ReviewSkipped a act:NonconformityRule ;
    rdfs:label "Review skipped"@en ;
    skos:definition "Prepared content entered a record with no signed review and no deterministic reproduction."@en .

act:ReviewedByPreparer a act:NonconformityRule ;
    rdfs:label "Reviewed by the preparer"@en ;
    skos:definition "A regulated act was reviewed by its preparer, or by the person who tasked the agent that prepared it."@en .

act:Reviewer a act:Role ;
    rdfs:label "Reviewer"@en ;
    skos:definition "A person who read the artifact and signed that review; for a regulated act, not the person who prepared it."@en .

act:Role a owl:Class ;
    rdfs:label "Role"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "One of the roles an actor holds in an act."@en .

act:SignatureMeaning a owl:Class ;
    rdfs:label "Signature meaning"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "What a signature of a regulated record means: review, approval, responsibility or authorship."@en .

act:System a act:ActorKind ;
    rdfs:label "System"@en ;
    skos:definition "A deterministic mechanism that a person validated: the engine, a typed verb, a pipeline."@en .

act:T0Suggest a act:TaskingLevel ;
    rdfs:label "T0, suggest"@en ;
    skos:definition "The agent only suggests; nothing it makes enters a record."@en .

act:T1Prepare a act:TaskingLevel ;
    rdfs:label "T1, prepare"@en ;
    skos:definition "The agent prepares drafts in a branch or a sandbox; a person reviews them before they enter a record."@en .

act:T2AssistExecution a act:TaskingLevel ;
    rdfs:label "T2, assist execution"@en ;
    skos:definition "The agent assists a step whose plan hash a person approved for each step; the engine carries it out."@en .

act:T3AssistReversible a act:TaskingLevel ;
    rdfs:label "T3, assist reversible steps"@en ;
    skos:definition "The agent assists reversible, low risk steps under a standing directive and a current qualification; the owner of the directive stays the initiator and the engine stays the executor."@en .

act:Tasking a owl:Class ;
    rdfs:label "Tasking"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "A person's signed authority to use an agent configuration within a scope, at a level, until an expiry; the person keeps the initiative and the accountability, and the tasking can be revoked."@en .

act:TaskingLevel a owl:Class ;
    rdfs:label "Tasking level"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "One of the four levels at which an agent may be tasked."@en .

act:Undirected a act:NonconformityRule ;
    rdfs:label "Undirected"@en ;
    skos:definition "An agent acted with no directive on record."@en .

act:Unqualified a act:NonconformityRule ;
    rdfs:label "Unqualified"@en ;
    skos:definition "An agent configuration with no current qualification was used where one is required."@en .

act:VocabularyBreach a act:NonconformityRule ;
    rdfs:label "Vocabulary breach"@en ;
    skos:definition "A record named an agent as the initiator, the one who completed, approved or signed an act."@en .

act:approvedBy a owl:ObjectProperty ;
    rdfs:domain act:Act ;
    rdfs:label "approved by"@en ;
    rdfs:range act:Actor ;
    skos:definition "The person whose signature bound the plan hash of the act."@en .

act:assistedBy a owl:ObjectProperty ;
    rdfs:domain act:Act ;
    rdfs:label "assisted by"@en ;
    rdfs:range act:Actor ;
    skos:definition "The agent or system that operated a tool during a step of the act."@en .

act:brokeRule a owl:ObjectProperty ;
    rdfs:domain act:Act ;
    rdfs:label "broke rule"@en ;
    rdfs:range act:NonconformityRule ;
    skos:definition "The rule of the specification of actors that the act did not meet."@en .

act:directiveDigest a owl:DatatypeProperty ;
    rdfs:domain act:Directive ;
    rdfs:label "directive digest"@en ;
    rdfs:range xsd:string ;
    skos:definition "The digest of the directive's text, so that the instruction an act followed can be checked."@en .

act:executedBy a owl:ObjectProperty ;
    rdfs:domain act:Act ;
    rdfs:label "executed by"@en ;
    rdfs:range act:Actor ;
    skos:definition "The person or validated mechanism that carried the step out."@en .

act:initiatedBy a owl:ObjectProperty ;
    rdfs:domain act:Act ;
    rdfs:label "initiated by"@en ;
    rdfs:range act:Actor ;
    skos:definition "The person whose request or standing directive is why the act happens."@en .

act:preparedBy a owl:ObjectProperty ;
    rdfs:domain act:Act ;
    rdfs:label "prepared by"@en ;
    rdfs:range act:Actor ;
    skos:definition "The actor that made the artifact of the act."@en .

act:reviewedBy a owl:ObjectProperty ;
    rdfs:domain act:Act ;
    rdfs:label "reviewed by"@en ;
    rdfs:range act:Actor ;
    skos:definition "The person who read the artifact and signed a review."@en .

act:underDirective a owl:ObjectProperty ;
    rdfs:domain act:Act ;
    rdfs:label "under directive"@en ;
    rdfs:range act:Directive ;
    skos:definition "The directive the act was done under."@en .

<https://www.intellectualfrontiers.com/ontology/actor> a owl:Ontology ;
    <http://purl.org/dc/terms/description> "The vocabulary of Actors: the act and the actor that takes part in it, the roles, the directive, the tasking, the qualification, the nonconformity and the meanings of a signature."@en ;
    rdfs:label "Actors"@en ;
    owl:versionIRI actv:1.0.0 ;
    owl:versionInfo "1.0.0" .
