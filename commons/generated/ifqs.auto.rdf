    <mz:termIri>https://www.intellectualfrontiers.com/ontology/ifqs#TestOutcome</mz:termIri>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/id/mizan/term-ifqs-TestRun">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#OntologyTerm"/>
    <rdfs:label xml:lang="en">ifqs:TestRun</rdfs:label>
    <mz:basis rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Specializes"/>
    <mz:definedBy>0021-ifqs FR-013</mz:definedBy>
    <mz:mappingRelation>subClassOf</mz:mappingRelation>
    <mz:standardTerm>http://www.w3.org/ns/prov#Activity</mz:standardTerm>
    <mz:termIri>https://www.intellectualfrontiers.com/ontology/ifqs#TestRun</mz:termIri>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#Assessor">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#Audience"/>
    <rdfs:label xml:lang="en">assessor</rdfs:label>
    <skos:definition xml:lang="en">A person who verifies the evidence: the full records, with secrets and personal data redacted only.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#AssessorPack">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Assessor pack</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
    <skos:definition xml:lang="en">The self-contained, offline-verifiable bundle of the evidence of one revision and span, for a person who has to check it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#Audience">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Audience</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">public, assessor or internal: who a rendering of evidence is for.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#Cancelled">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#TestOutcome"/>
    <rdfs:label xml:lang="en">cancelled</rdfs:label>
    <skos:definition xml:lang="en">The case started and did not end before its process did.</skos:definition>
    <ifqs:outcomeWord>cancelled</ifqs:outcomeWord>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#Capa">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">CAPA</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Plan"/>
    <skos:definition xml:lang="en">A corrective and preventive action: the plan that corrects a nonconformance, names the test that verifies it and is closed by a named person.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#CapaClosed">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#CapaState"/>
    <rdfs:label xml:lang="en">closed</rdfs:label>
    <skos:definition xml:lang="en">A named person approved the closure of a verified CAPA, recorded as a Decision.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#CapaOpen">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#CapaState"/>
    <rdfs:label xml:lang="en">open</rdfs:label>
    <skos:definition xml:lang="en">The corrective action is stated and its named test has not passed after the corrective change.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#CapaState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">CAPA state</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">open, verified or closed, in that order.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#CapaVerified">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#CapaState"/>
    <rdfs:label xml:lang="en">verified</rdfs:label>
    <skos:definition xml:lang="en">The named test passed in a run after the corrective change; a person has not yet approved the closure.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#Due">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#FreshnessState"/>
    <rdfs:label xml:lang="en">due</rdfs:label>
    <skos:definition xml:lang="en">The proof is within a tenth of its cadence of its end.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#E0">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#EvidenceGrade"/>
    <rdfs:label xml:lang="en">E0 none</rdfs:label>
    <skos:definition xml:lang="en">No evidence: a requirement with no record of any kind.</skos:definition>
    <ifqs:gradeRank rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</ifqs:gradeRank>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#E1">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#EvidenceGrade"/>
    <rdfs:label xml:lang="en">E1 stated</rdfs:label>
    <skos:definition xml:lang="en">A person or an agent says the requirement is met; nothing ran.</skos:definition>
    <ifqs:gradeRank rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ifqs:gradeRank>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#E2">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#EvidenceGrade"/>
    <rdfs:label xml:lang="en">E2 reviewed</rdfs:label>
    <skos:definition xml:lang="en">A review is recorded against the requirement, by a person or by an agent (said to be an agent's).</skos:definition>
    <ifqs:gradeRank rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</ifqs:gradeRank>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#E3">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#EvidenceGrade"/>
    <rdfs:label xml:lang="en">E3 tested</rdfs:label>
    <skos:definition xml:lang="en">An automated run proved the requirement and its record exists.</skos:definition>
    <ifqs:gradeRank rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</ifqs:gradeRank>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#E4">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#EvidenceGrade"/>
    <rdfs:label xml:lang="en">E4 attested</rdfs:label>
    <skos:definition xml:lang="en">The run is kept on the quality branch, chained, signed and linked to its commit, so that a third party can verify it.</skos:definition>
    <ifqs:gradeRank rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</ifqs:gradeRank>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#E5">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#EvidenceGrade"/>
    <rdfs:label xml:lang="en">E5 observed</rdfs:label>
    <skos:definition xml:lang="en">A probe of the system in operation reports the requirement met: operational truth.</skos:definition>
    <ifqs:gradeRank rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</ifqs:gradeRank>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#Evidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Evidence</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">What a run, a review or a probe shows of one requirement, with the grade it carries and its freshness.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#EvidenceFile">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Evidence file</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">The immutable file of one run on the quality branch, with its digest and the digest of the file before it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#EvidenceGrade">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Evidence grade</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">E0 to E5: how much a piece of evidence is worth.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#Fail">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#TestOutcome"/>
    <rdfs:label xml:lang="en">fail</rdfs:label>
    <skos:definition xml:lang="en">The case ran and an assertion did not hold.</skos:definition>
    <ifqs:outcomeWord>fail</ifqs:outcomeWord>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#Fresh">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#FreshnessState"/>
    <rdfs:label xml:lang="en">fresh</rdfs:label>
    <skos:definition xml:lang="en">The proof is within its cadence and nothing in its chain changed after its run.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#FreshnessState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Freshness state</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">fresh, due or stale.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#Internal">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#Audience"/>
    <rdfs:label xml:lang="en">internal</rdfs:label>
    <skos:definition xml:lang="en">The harness's own people, through its own console.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#Nonconformance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Nonconformance</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">A failure of a requirement to be met, or a stale proof of it, opened by the system itself (ISO 9001 clause 10.2's nonconformity).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#NonconformanceClosed">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#NonconformanceState"/>
    <rdfs:label xml:lang="en">closed</rdfs:label>
    <skos:definition xml:lang="en">Its CAPA is closed: verified by a named test and approved by a named person.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#NonconformanceOpen">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#NonconformanceState"/>
    <rdfs:label xml:lang="en">open</rdfs:label>
    <skos:definition xml:lang="en">The system opened it and no CAPA of it is closed.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#NonconformanceState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Nonconformance state</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">open or closed.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#NotRun">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#TestOutcome"/>
    <rdfs:label xml:lang="en">not run</rdfs:label>
    <skos:definition xml:lang="en">A planned case, check or requirement that never started, with the reason: it is never counted as passed.</skos:definition>
    <ifqs:outcomeWord>not_run</ifqs:outcomeWord>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#Pass">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#TestOutcome"/>
    <rdfs:label xml:lang="en">pass</rdfs:label>
    <skos:definition xml:lang="en">The case ran and its assertions held.</skos:definition>
    <ifqs:outcomeWord>pass</ifqs:outcomeWord>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#Public">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#Audience"/>
    <rdfs:label xml:lang="en">public</rdfs:label>
    <skos:definition xml:lang="en">Anyone: figures, grades and failures with their requirement and reason, and nothing that names a person, customer, host or private repository.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#QualityObjective">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Quality objective</rdfs:label>
    <skos:definition xml:lang="en">A success criterion as a metric, with a target, a unit, an error budget and the window it is spent in.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#QualityTier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Quality tier</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">Tier 0 (evidence exists), Tier 1 (the system reports itself) or Tier 2 (people see and prove).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#ReviewDebt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Review debt</rdfs:label>
    <skos:definition xml:lang="en">The number of requirements whose best fresh evidence is E1 or E2, counted at a revision.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#Skip">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#TestOutcome"/>
    <rdfs:label xml:lang="en">skip</rdfs:label>
    <skos:definition xml:lang="en">A runner skipped the case on purpose, with its reason.</skos:definition>
    <ifqs:outcomeWord>skip</ifqs:outcomeWord>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#Stale">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#FreshnessState"/>
    <rdfs:label xml:lang="en">stale</rdfs:label>
    <skos:definition xml:lang="en">The proof is past its cadence or a file of its chain changed after its run: it opens a nonconformance and does not count at its grade.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#TestCase">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Test case</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <skos:definition xml:lang="en">One case of a run, with its outcome, its reason where it has one and the requirements it proves.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#TestOutcome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Test outcome</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:definition xml:lang="en">pass, fail, skip, todo, cancelled or not run.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#TestRun">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Test run</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <skos:definition xml:lang="en">One run of a suite: its trace, the revision it tested and its cases; kept as one file of the record of 0008-test-evidence.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#Tier0">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#QualityTier"/>
    <rdfs:label xml:lang="en">Tier 0</rdfs:label>
    <skos:definition xml:lang="en">Evidence exists: one canonical record per run, kept immutable and chained on the quality branch.</skos:definition>
    <ifqs:tierNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</ifqs:tierNumber>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#Tier1">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#QualityTier"/>
    <rdfs:label xml:lang="en">Tier 1</rdfs:label>
    <skos:definition xml:lang="en">The system reports itself: grades, review debt, freshness, nonconformance, CAPA and objectives.</skos:definition>
    <ifqs:tierNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ifqs:tierNumber>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#Tier2">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#QualityTier"/>
    <rdfs:label xml:lang="en">Tier 2</rdfs:label>
    <skos:definition xml:lang="en">People see and prove: the console, attested samples, pre-registered plans, mutation runs, the public page and the assessor pack.</skos:definition>
    <ifqs:tierNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</ifqs:tierNumber>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#Todo">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#TestOutcome"/>
    <rdfs:label xml:lang="en">todo</rdfs:label>
    <skos:definition xml:lang="en">The case is declared and not yet written, with its reason.</skos:definition>
    <ifqs:outcomeWord>todo</ifqs:outcomeWord>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#approvedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#Capa"/>
    <rdfs:label xml:lang="en">approved by</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The named person who approved the closure.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#approvedOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#Capa"/>
    <rdfs:label xml:lang="en">approved on</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The day (YYYY-MM-DD) of the approval.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#arisesFrom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#Nonconformance"/>
    <rdfs:label xml:lang="en">arises from</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#Evidence"/>
    <skos:definition xml:lang="en">The evidence whose failure or staleness opened the nonconformance.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#belowGrade">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#ReviewDebt"/>
    <rdfs:label xml:lang="en">below grade</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#EvidenceGrade"/>
    <skos:definition xml:lang="en">The grade a requirement's best evidence must reach to be out of debt: E3.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#budgetWindow">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#QualityObjective"/>
    <rdfs:label xml:lang="en">budget window</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The window the error budget is spent in, as an ISO 8601 duration.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#capaState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#Capa"/>
    <rdfs:label xml:lang="en">has CAPA state</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#CapaState"/>
    <skos:definition xml:lang="en">open, verified or closed.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#correctiveAction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#Capa"/>
    <rdfs:label xml:lang="en">corrective action</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">What is done to correct the nonconformance and stop it recurring.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#correctsNonconformance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#Capa"/>
    <rdfs:label xml:lang="en">corrects nonconformance</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#Nonconformance"/>
    <skos:definition xml:lang="en">The nonconformance the CAPA corrects.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#debtValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#ReviewDebt"/>
    <rdfs:label xml:lang="en">debt value</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <skos:definition xml:lang="en">The count of requirements whose best fresh evidence is below the grade.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#errorBudget">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#QualityObjective"/>
    <rdfs:label xml:lang="en">error budget</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">How much the measure may miss its target within the window, as a decimal number written as text.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#evidencePath">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#EvidenceFile"/>
    <rdfs:label xml:lang="en">evidence path</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The path on the quality branch: quality/evidence/YYYY/MM/DD/&lt;trace id&gt;.otlp.json.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#evidenceSha256">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#EvidenceFile"/>
    <rdfs:label xml:lang="en">evidence SHA-256</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The SHA-256 of the file's bytes, in lower-case hexadecimal.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#forRequirement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#Evidence"/>
    <rdfs:label xml:lang="en">for requirement</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The requirement the evidence is of, as `NNNN-slug FR-nnn`.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#freshness">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#Evidence"/>
    <rdfs:label xml:lang="en">freshness</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#FreshnessState"/>
    <skos:definition xml:lang="en">fresh, due or stale.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#grade">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#Evidence"/>
    <rdfs:label xml:lang="en">grade</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#EvidenceGrade"/>
    <skos:definition xml:lang="en">The grade the evidence carries, E0 to E5.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#gradeRank">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#EvidenceGrade"/>
    <rdfs:label xml:lang="en">grade rank</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <skos:definition xml:lang="en">The grade's number, 0 to 5, by which grades are compared.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#inRun">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#TestCase"/>
    <rdfs:label xml:lang="en">in run</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#TestRun"/>
    <skos:definition xml:lang="en">The run the case is of.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#measuredAtRevision">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#ReviewDebt"/>
    <rdfs:label xml:lang="en">measured at revision</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The revision at which the debt was counted.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#metricName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#QualityObjective"/>
    <rdfs:label xml:lang="en">metric name</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The OpenTelemetry metric the objective is measured by.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#nonconformanceState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#Nonconformance"/>
    <rdfs:label xml:lang="en">nonconformance state</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#NonconformanceState"/>
    <skos:definition xml:lang="en">open or closed.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#ofRun">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#EvidenceFile"/>
    <rdfs:label xml:lang="en">of run</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#TestRun"/>
    <skos:definition xml:lang="en">The run the file keeps.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#openedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#Nonconformance"/>
    <rdfs:label xml:lang="en">opened by</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">`system`, or the role of the person who opened it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#outcome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#TestCase"/>
    <rdfs:label xml:lang="en">outcome</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#TestOutcome"/>
    <skos:definition xml:lang="en">What became of the case: the value of ifc.test.outcome.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#outcomeWord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#TestOutcome"/>
    <rdfs:label xml:lang="en">outcome word</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The word the outcome is written with in the record: pass, fail, skip, todo, cancelled or not_run.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#packAudience">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#AssessorPack"/>
    <rdfs:label xml:lang="en">pack audience</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#Audience"/>
    <skos:definition xml:lang="en">Who the pack is for, and so what is redacted from it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#packRevision">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#AssessorPack"/>
    <rdfs:label xml:lang="en">pack revision</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The revision the pack was made at.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#packSha256">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#AssessorPack"/>
    <rdfs:label xml:lang="en">pack SHA-256</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The SHA-256 of the pack, in lower-case hexadecimal.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#previousSha256">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#EvidenceFile"/>
    <rdfs:label xml:lang="en">previous SHA-256</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The SHA-256 of the file before it on the branch (64 zeros for the first): the in-file chain.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#producedByRun">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#Evidence"/>
    <rdfs:label xml:lang="en">produced by run</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#TestRun"/>
    <skos:definition xml:lang="en">The run that produced the evidence, where a run did.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#provedAt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#Evidence"/>
    <rdfs:label xml:lang="en">proved at</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The day or time (ISO 8601) of the proof.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#proves">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#TestCase"/>
    <rdfs:label xml:lang="en">proves</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">A requirement the case proves, as `NNNN-slug FR-nnn`.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#reason">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#TestCase"/>
    <rdfs:label xml:lang="en">reason</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">Why the case was skipped, not run or left to do (ifc.test.reason).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#reviewedByRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#Evidence"/>
    <rdfs:label xml:lang="en">reviewed by role</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The role that reviewed, for evidence of grade E2; `agent` where an agent did.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#statement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#Nonconformance"/>
    <rdfs:label xml:lang="en">statement</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">What was not met, in one sentence.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#storedIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#Evidence"/>
    <rdfs:label xml:lang="en">stored in</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#EvidenceFile"/>
    <skos:definition xml:lang="en">The evidence file that keeps the run.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#targetUnit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#QualityObjective"/>
    <rdfs:label xml:lang="en">target unit</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The unit of the target, in the Unified Code for Units of Measure where one exists.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#targetValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#QualityObjective"/>
    <rdfs:label xml:lang="en">target value</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The target, as a decimal number written as text.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#testedRevision">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#TestRun"/>
    <rdfs:label xml:lang="en">tested revision</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The commit the run tested (the resource attribute vcs.ref.head.revision).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#tierNumber">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#QualityTier"/>
    <rdfs:label xml:lang="en">tier number</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <skos:definition xml:lang="en">0, 1 or 2.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#traceId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#TestRun"/>
    <rdfs:label xml:lang="en">trace id</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The OpenTelemetry trace id of the run, in 32 lower-case hexadecimal digits: the name of its file.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs#verifiedByTest">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs#Capa"/>
    <rdfs:label xml:lang="en">verified by test</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The test whose passing, after the corrective change, verifies the CAPA: its file and name.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/ifqs">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <ns1:description xml:lang="en">The vocabulary of the Intellectual Frontiers Quality System: test runs and cases, evidence and its grades, nonconformance and CAPA, quality objectives, review debt, tiers, audiences and the assessor pack.</ns1:description>
    <rdfs:label xml:lang="en">IFQS</rdfs:label>
    <owl:versionIRI rdf:resource="https://www.intellectualfrontiers.com/ontology/ifqs/1"/>
    <owl:versionInfo>1</owl:versionInfo>
  </rdf:Description>
</rdf:RDF>
