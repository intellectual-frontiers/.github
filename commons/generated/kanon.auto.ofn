AnnotationAssertion(rdfs:label kanon:Bundle "Bundle"@en)
AnnotationAssertion(skos:definition kanon:Bundle "The Logical model published as files with a manifest of every file and its SHA-256, which a loader refuses whole where any file differs (0033-kanon FR-026)."@en)
SubClassOf(kanon:Bundle prov:Entity)
AnnotationAssertion(rdfs:label kanon:Element "Element"@en)
AnnotationAssertion(skos:definition kanon:Element "One thing a layer says (a concept, an action, a table, a command), with a stable identity, a kind, a name, a definition and a source."@en)
SubClassOf(kanon:Element prov:Entity)
AnnotationAssertion(rdfs:label kanon:Family "Family"@en)
AnnotationAssertion(skos:definition kanon:Family "A host with its dialects and plugins, and the naming rule of their packages (<host>-dialect-<tool>, <host>-<noun>), as data of the host's table."@en)
SubClassOf(kanon:Family skos:Collection)
AnnotationAssertion(rdfs:label kanon:Finding "Finding"@en)
AnnotationAssertion(skos:definition kanon:Finding "A breach of the rules of Kanon, with its code, the element or file it is about and one sentence."@en)
SubClassOf(kanon:Finding sh:ValidationResult)
AnnotationAssertion(rdfs:label kanon:Instance "Instance"@en)
AnnotationAssertion(skos:definition kanon:Instance "One of several occurrences of a kind of unit in the Physical layer (a dialect), declared by its host with the unit it is an instance of; it imports only the layers it extends, through the host's public exports, and never another instance."@en)
SubClassOf(kanon:Instance prov:Entity)
AnnotationAssertion(rdfs:label kanon:Layer "Layer"@en)
AnnotationAssertion(skos:definition kanon:Layer "One of Governance, Logical and Physical, with its rank and its alignment to the viewpoints of Model Driven Architecture."@en)
SubClassOf(kanon:Layer skos:Concept)
AnnotationAssertion(rdfs:label kanon:Matrix "Matrix"@en)
AnnotationAssertion(skos:definition kanon:Matrix "The table of requirement by instance: for each annotation of Governance and each instance, whether it is expressed, carried or unexpressed with its reason, or dropped."@en)
SubClassOf(kanon:Matrix prov:Entity)
AnnotationAssertion(rdfs:label kanon:Plugin "Plugin"@en)
AnnotationAssertion(skos:definition kanon:Plugin "A package that extends one host through the host's public exports and the plugin contract only; the host never imports it, and it imports another plugin only by a declared dependency."@en)
SubClassOf(kanon:Plugin prov:Entity)
AnnotationAssertion(rdfs:label kanon:Projection "Projection"@en)
AnnotationAssertion(skos:definition kanon:Projection "The derivation, by code, of the elements of one layer from the elements of the layer above."@en)
SubClassOf(kanon:Projection prov:Activity)
AnnotationAssertion(rdfs:label kanon:Relation "Relation"@en)
AnnotationAssertion(skos:definition kanon:Relation "A link between two elements of one layer, with a kind the model's vocabulary declares: it may be cyclic and is never a trace edge (0033-kanon FR-029)."@en)
SubClassOf(kanon:Relation prov:Entity)
AnnotationAssertion(rdfs:label kanon:Surface "Surface"@en)
AnnotationAssertion(skos:definition kanon:Surface "A unit of the Physical layer that faces a caller: the command line, a tool server, a REST service."@en)
SubClassOf(kanon:Surface prov:Entity)
AnnotationAssertion(rdfs:label kanon:TraceEdge "Trace edge"@en)
AnnotationAssertion(skos:definition kanon:TraceEdge "The record that an element of one layer was made from an element of the layer above, and how."@en)
SubClassOf(kanon:TraceEdge prov:Derivation)
AnnotationAssertion(rdfs:label kanon:about "about"@en)
AnnotationAssertion(skos:definition kanon:about "The element the finding is about, where it is about one."@en)
ObjectPropertyDomain(kanon:about kanon:Finding)
ObjectPropertyRange(kanon:about kanon:Element)
