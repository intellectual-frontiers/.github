  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/id/mizan/rung-0">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Rung"/>
    <rdfs:label xml:lang="en">Ontology</rdfs:label>
    <skos:definition xml:lang="en">Facts, terms and code lists, stated once as typed TypeScript on commons' RDF kernel.</skos:definition>
    <mz:kind rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Required"/>
    <mz:rungNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</mz:rungNumber>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/id/mizan/rung-10">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Rung"/>
    <rdfs:label xml:lang="en">Workspace: where the work is done</rdfs:label>
    <skos:definition xml:lang="en">The controlled working environment everything else is built in: the layout of the repositories on a machine, the approved tools, the policy and the hooks that hold the work to its rules. It relies on no rung and no rung relies on it; the evidence rung records what it does.</skos:definition>
    <mz:kind rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Environment"/>
    <mz:rungNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</mz:rungNumber>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/id/mizan/rung-1">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Rung"/>
    <rdfs:label xml:lang="en">Specifications</rdfs:label>
    <skos:definition xml:lang="en">What each part must do, using only terms the ontology defines.</skos:definition>
    <mz:kind rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Required"/>
    <mz:mayRelyOn rdf:resource="https://www.intellectualfrontiers.com/id/mizan/rung-0"/>
    <mz:rungNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</mz:rungNumber>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/id/mizan/rung-2">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Rung"/>
    <rdfs:label xml:lang="en">Governed data</rdfs:label>
    <skos:definition xml:lang="en">Schema, policies, data models and code lists of every subject.</skos:definition>
    <mz:kind rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Required"/>
    <mz:mayRelyOn rdf:resource="https://www.intellectualfrontiers.com/id/mizan/rung-0"/>
