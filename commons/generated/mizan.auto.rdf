    <mz:basis rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Unaligned"/>
    <mz:definedBy>0018-standards-first FR-003</mz:definedBy>
    <mz:justification>No standard adopted yet. Candidates to examine: none found. Decision pending (0018-standards-first FR-005).</mz:justification>
    <mz:termIri>https://www.intellectualfrontiers.com/ontology/mizan#OntologyTerm</mz:termIri>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/id/mizan/term-Requirement">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#OntologyTerm"/>
    <rdfs:label xml:lang="en">mz:Requirement</rdfs:label>
    <mz:addedOn>2026-11-17</mz:addedOn>
    <mz:basis rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Unaligned"/>
    <mz:definedBy>0003-mizan FR-003</mz:definedBy>
    <mz:justification>No standard adopted yet. Candidates to examine: none found for a numbered requirement; OSCAL implemented-requirement for controls. Decision pending (0018-standards-first FR-005).</mz:justification>
    <mz:termIri>https://www.intellectualfrontiers.com/ontology/mizan#Requirement</mz:termIri>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/id/mizan/term-Rung">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#OntologyTerm"/>
    <rdfs:label xml:lang="en">mz:Rung</rdfs:label>
    <mz:addedOn>2026-11-17</mz:addedOn>
    <mz:basis rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Unaligned"/>
    <mz:definedBy>0016-ladder FR-001</mz:definedBy>
    <mz:justification>No standard names these rungs. ISO/IEC/IEEE 42010 describes architecture descriptions and layered architecture is common practice, but neither defines rungs, their rely-on edges or their checks. Decision pending (0018-standards-first FR-005).</mz:justification>
    <mz:termIri>https://www.intellectualfrontiers.com/ontology/mizan#Rung</mz:termIri>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/id/mizan/term-RungKind">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#OntologyTerm"/>
    <rdfs:label xml:lang="en">mz:RungKind</rdfs:label>
    <mz:addedOn>2026-11-17</mz:addedOn>
    <mz:basis rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Unaligned"/>
    <mz:decision rdf:resource="https://www.intellectualfrontiers.com/id/mizan/decision-mz-RungKind"/>
    <mz:definedBy>0016-ladder FR-008</mz:definedBy>
    <mz:justification>No standard adopted yet. Candidates to examine: none found. Kept unaligned by the owner's decision of 2026-11-17 (issue #10); reviewed again by 2027-02-15.</mz:justification>
    <mz:termIri>https://www.intellectualfrontiers.com/ontology/mizan#RungKind</mz:termIri>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/id/mizan/term-Spec">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#OntologyTerm"/>
    <rdfs:label xml:lang="en">mz:Spec</rdfs:label>
    <mz:addedOn>2026-11-17</mz:addedOn>
    <mz:basis rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Unaligned"/>
    <mz:definedBy>0003-mizan FR-001</mz:definedBy>
    <mz:justification>No standard adopted yet. Candidates to examine: schema:CreativeWork, dcterms:BibliographicResource. Decision pending (0018-standards-first FR-005).</mz:justification>
    <mz:termIri>https://www.intellectualfrontiers.com/ontology/mizan#Spec</mz:termIri>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/id/mizan/term-Standard">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#OntologyTerm"/>
    <rdfs:label xml:lang="en">mz:Standard</rdfs:label>
    <mz:basis rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Specializes"/>
    <mz:definedBy>0018-standards-first FR-006</mz:definedBy>
    <mz:mappingRelation>subClassOf</mz:mappingRelation>
    <mz:standardTerm>http://purl.org/dc/terms/Standard</mz:standardTerm>
    <mz:termIri>https://www.intellectualfrontiers.com/ontology/mizan#Standard</mz:termIri>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#Adopts">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Basis"/>
    <rdfs:label xml:lang="en">adopts</rdfs:label>
    <skos:definition xml:lang="en">The term is the standard's own, by its IRI.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#Authority">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Authority</rdfs:label>
    <skos:definition xml:lang="en">A law or regulation a requirement or a term comes from, cited by its title, part and section.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#Basis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Basis</rdfs:label>
    <skos:definition xml:lang="en">How a term relates to a standard: adopts, specializes, maps or is unaligned.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#Citations">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#ConformanceRequirement"/>
    <rdfs:label xml:lang="en">citations</rdfs:label>
    <skos:definition xml:lang="en">A specification of another folder is cited with its repository, and a bare citation names a specification of the folder that exists.</skos:definition>
    <mz:enforcedBy>bun commons/tools/mizan-check.ts (0003-mizan FR-004)</mz:enforcedBy>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#ConformanceLevel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Conformance level</rdfs:label>
    <skos:definition xml:lang="en">L0 registered, L1 core, L2 standards or L3 governed: how much of Mizan a subject is held to, each level adding to the one below.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#ConformanceRequirement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Conformance requirement</rdfs:label>
    <skos:definition xml:lang="en">One thing a conformance level asks of a subject, and the rules or checks that prove it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#Core">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#ConformanceLevel"/>
    <rdfs:label xml:lang="en">L1 core</rdfs:label>
    <skos:definition xml:lang="en">The subject keeps its own specifications and proves them: its own spec kit and verify, and Mizan's core rules.</skos:definition>
    <mz:entails rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Citations"/>
    <mz:entails rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#EarsRequirements"/>
    <mz:entails rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#GherkinScenarios"/>
    <mz:entails rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#OwnVerify"/>
    <mz:entails rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#ProofRows"/>
    <mz:entails rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#ShrinkOnlyBaselines"/>
    <mz:entails rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#SourceTrace"/>
    <mz:entails rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#SpecKit"/>
    <mz:levelRank rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</mz:levelRank>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#Decision">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Decision</rdfs:label>
    <skos:definition xml:lang="en">The record of why a term is unaligned, due within 90 days of the term; a harness may link it to its own record.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#EarsRequirements">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#ConformanceRequirement"/>
    <rdfs:label xml:lang="en">EARS requirements</rdfs:label>
    <skos:definition xml:lang="en">Every requirement is worded with an RFC 2119 keyword in one of the EARS patterns.</skos:definition>
    <mz:rule>mizan/requirement-ears</mz:rule>
    <mz:rule>mizan/requirement-keyword</mz:rule>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#Environment">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#RungKind"/>
    <rdfs:label xml:lang="en">environment</rdfs:label>
    <skos:definition xml:lang="en">The rung is the working environment everything is built in, required of a harness that claims a regulated domain; it relies on no rung and no rung relies on it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#Exception">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Exception</rdfs:label>
    <skos:definition xml:lang="en">A recorded choice of a tool that is not TypeScript, with why TypeScript is not enough, its pinned version, its isolation and its platforms.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#Export">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#IntegrationDirection"/>
    <rdfs:label xml:lang="en">export</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#Federal">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#JurisdictionLevel"/>
    <rdfs:label xml:lang="en">federal</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#GherkinScenarios">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#ConformanceRequirement"/>
    <rdfs:label xml:lang="en">Gherkin scenarios</rdfs:label>
    <skos:definition xml:lang="en">Every acceptance scenario is Given, When, Then and cites the requirements it exercises.</skos:definition>
    <mz:rule>mizan/scenario-form</mz:rule>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#Governed">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#ConformanceLevel"/>
    <rdfs:label xml:lang="en">L3 governed</rdfs:label>
    <skos:definition xml:lang="en">The subject is under change control and release control: every commit names an issue, every work has a release record and the quality records are kept.</skos:definition>
    <mz:entails rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Ifccm"/>
    <mz:entails rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Ifqs"/>
    <mz:entails rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Ifr"/>
    <mz:levelRank rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</mz:levelRank>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#Ifccm">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#ConformanceRequirement"/>
    <rdfs:label xml:lang="en">IFCCM</rdfs:label>
    <skos:definition xml:lang="en">Every commit names an issue, and a change is judged against its declared phase of enforcement (0020-ifccm).</skos:definition>
    <mz:rule>changes/*</mz:rule>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#Ifqs">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#ConformanceRequirement"/>
    <rdfs:label xml:lang="en">IFQS</rdfs:label>
    <skos:definition xml:lang="en">The quality records of the subject are kept and judged (0021-ifqs).</skos:definition>
    <mz:enforcedBy>bun commons/ts/quality/quality.ts</mz:enforcedBy>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#Ifr">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#ConformanceRequirement"/>
    <rdfs:label xml:lang="en">IFR</rdfs:label>
    <skos:definition xml:lang="en">Every work has a release record, and a version grows by the scheme of its kind (0026-works-versioning).</skos:definition>
    <mz:rule>versions/*</mz:rule>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#Import">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#IntegrationDirection"/>
    <rdfs:label xml:lang="en">import</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#ImportRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Import record</rdfs:label>
    <skos:definition xml:lang="en">The provenance of one import: what, from where, when, by which generator and with which hash.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#Integration">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Integration</rdfs:label>
    <skos:definition xml:lang="en">An import of a standard into typed TypeScript, or an export of an ontology in a well-known form.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#IntegrationDirection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Integration direction</rdfs:label>
    <skos:definition xml:lang="en">import or export.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#International">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#JurisdictionLevel"/>
    <rdfs:label xml:lang="en">international</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#Jurisdiction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Jurisdiction</rdfs:label>
    <skos:definition xml:lang="en">The federal, state, local or international body whose law it is.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#JurisdictionLevel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Jurisdiction level</rdfs:label>
    <skos:definition xml:lang="en">federal, state, local or international.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#Local">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#JurisdictionLevel"/>
    <rdfs:label xml:lang="en">local</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#Manifest">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#ConformanceRequirement"/>
    <rdfs:label xml:lang="en">manifest</rdfs:label>
    <skos:definition xml:lang="en">The subject declares a manifest: its name, its level, the path of its spec kit, its verify command, its version and its exports.</skos:definition>
    <mz:enforcedBy>the manifest check of 0028-conformance-levels, which reads each commons/&lt;name&gt;/library.ts as data (0027-commons-libraries)</mz:enforcedBy>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#Maps">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Basis"/>
    <rdfs:label xml:lang="en">maps</rdfs:label>
    <skos:definition xml:lang="en">The term has a mapping, such as skos:exactMatch, to a standard's term.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#Observer">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#RungKind"/>
    <rdfs:label xml:lang="en">observer</rdfs:label>
    <skos:definition xml:lang="en">The rung records and proves what the other rungs do, and is required of a harness that claims a regulated domain; no rung relies on it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#OntologyTerm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ontology term</rdfs:label>
    <skos:definition xml:lang="en">A class, a property, an individual or a code list of an ontology, and the basis it rests on.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#Optional">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#RungKind"/>
    <rdfs:label xml:lang="en">optional</rdfs:label>
    <skos:definition xml:lang="en">A harness may have the rung: it relies on no rung and no rung relies on it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#OwnVerify">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#ConformanceRequirement"/>
    <rdfs:label xml:lang="en">own verify</rdfs:label>
    <skos:definition xml:lang="en">The subject's verify command runs the compiler, the specification checker, the rules of its level on its own spec kit and its tests, and fails if any fails.</skos:definition>
    <mz:enforcedBy>the manifest check, which reads the verify script of the package (0027-commons-libraries FR-005)</mz:enforcedBy>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#ProofRows">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#ConformanceRequirement"/>
    <rdfs:label xml:lang="en">proof rows</rdfs:label>
    <skos:definition xml:lang="en">Every requirement has exactly one row in the register of what proves it, and none for a requirement that does not exist.</skos:definition>
    <mz:enforcedBy>bun commons/tools/mizan-check.ts (0003-mizan FR-005)</mz:enforcedBy>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#Registered">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#ConformanceLevel"/>
    <rdfs:label xml:lang="en">L0 registered</rdfs:label>
    <skos:definition xml:lang="en">The subject is known: it has a manifest, a verify command and a version.</skos:definition>
    <mz:entails rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Manifest"/>
    <mz:entails rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#VerifyCommand"/>
    <mz:entails rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Version"/>
    <mz:levelRank rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</mz:levelRank>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#Required">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#RungKind"/>
    <rdfs:label xml:lang="en">required</rdfs:label>
    <skos:definition xml:lang="en">Every harness has the rung and builds on the rungs it names.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#Requirement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Requirement</rdfs:label>
    <skos:definition xml:lang="en">One numbered requirement of a specification, with the authority it comes from where it comes from law.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#Rung">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Rung</rdfs:label>
    <skos:definition xml:lang="en">One level of the ladder, with its number, purpose, homes, what it may rely on and what proves it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#RungKind">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Rung kind</rdfs:label>
    <skos:definition xml:lang="en">required, optional, observer or environment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#ShrinkOnlyBaselines">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#ConformanceRequirement"/>
    <rdfs:label xml:lang="en">shrink-only baselines</rdfs:label>
    <skos:definition xml:lang="en">A finding is held by a baseline that only shrinks: a new finding fails, and so does a line that no longer occurs.</skos:definition>
    <mz:enforcedBy>the judgement of every check against its baseline (0003-mizan FR-015)</mz:enforcedBy>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#SourceTrace">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#ConformanceRequirement"/>
    <rdfs:label xml:lang="en">source trace</rdfs:label>
    <skos:definition xml:lang="en">Sources and tests cite the specifications they come from (`Spec:` and `Proves:` lines, `proves(...)` calls), and every citation names a requirement that exists.</skos:definition>
    <mz:enforcedBy>the trace of the subject's sources and tests (0015-trace)</mz:enforcedBy>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#Spec">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Specification</rdfs:label>
    <skos:definition xml:lang="en">A specification of a spec-kit folder, with its identifier and status.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#SpecKit">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#ConformanceRequirement"/>
    <rdfs:label xml:lang="en">spec kit</rdfs:label>
    <skos:definition xml:lang="en">The subject keeps a spec kit of its own, in the form of 0003-mizan, numbered from 0001 in its own registry.</skos:definition>
    <mz:enforcedBy>bun commons/tools/mizan-check.ts --root &lt;spec kit&gt;</mz:enforcedBy>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#Specializes">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Basis"/>
    <rdfs:label xml:lang="en">specializes</rdfs:label>
    <skos:definition xml:lang="en">The term is a subclass or a subproperty of a standard's term.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#Standard">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Standard</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.org/dc/terms/Standard"/>
    <skos:definition xml:lang="en">A pinned, licensed standard: its issuer, name, version, location, license and the hash of what was imported.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#Standards">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#ConformanceLevel"/>
    <rdfs:label xml:lang="en">L2 standards</rdfs:label>
    <skos:definition xml:lang="en">The subject's terms rest on standards first: an audit of every term, with a decision for each that stays unaligned.</skos:definition>
    <mz:entails rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#TermAudit"/>
    <mz:levelRank rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</mz:levelRank>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#State">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#JurisdictionLevel"/>
    <rdfs:label xml:lang="en">state</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#TermAudit">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#ConformanceRequirement"/>
    <rdfs:label xml:lang="en">term audit</rdfs:label>
    <skos:definition xml:lang="en">Every term of the subject's ontology has a record of the standard it rests on, or of why none does and the decision to keep it unaligned, and a specification names only defined terms.</skos:definition>
    <mz:rule>mizan/decision-missing</mz:rule>
    <mz:rule>mizan/decision-overdue</mz:rule>
    <mz:rule>mizan/deprecated-no-replacement</mz:rule>
    <mz:rule>mizan/spec-term-deprecated</mz:rule>
    <mz:rule>mizan/spec-term-unknown</mz:rule>
    <mz:rule>mizan/standard-newer</mz:rule>
    <mz:rule>mizan/standards-considered</mz:rule>
    <mz:rule>mizan/term-basis-missing</mz:rule>
    <mz:rule>mizan/term-not-defined-by</mz:rule>
    <mz:rule>mizan/term-standard</mz:rule>
    <mz:rule>mizan/unaligned-justification</mz:rule>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#Unaligned">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Basis"/>
    <rdfs:label xml:lang="en">unaligned</rdfs:label>
    <skos:definition xml:lang="en">No standard names the term: it carries a justification and a decision, is counted, and is drift to be reduced.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#VerifyCommand">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#ConformanceRequirement"/>
    <rdfs:label xml:lang="en">verify command</rdfs:label>
    <skos:definition xml:lang="en">The subject names the one command that proves it, and it runs from the subject's folder with no argument.</skos:definition>
    <mz:enforcedBy>the manifest check, which finds a verify command that the subject's package does not have</mz:enforcedBy>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#Version">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#ConformanceRequirement"/>
    <rdfs:label xml:lang="en">version</rdfs:label>
    <skos:definition xml:lang="en">The subject declares a version, and it is the version of its package.</skos:definition>
    <mz:enforcedBy>the manifest check, which finds a version that is not the package's</mz:enforcedBy>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#addedOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#OntologyTerm"/>
    <rdfs:label xml:lang="en">addedOn</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The day (YYYY-MM-DD) the term was added; the decision is due 90 days after it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#authority">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Requirement"/>
    <rdfs:label xml:lang="en">authority</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Authority"/>
    <skos:definition xml:lang="en">The law or regulation the requirement comes from.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#basis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#OntologyTerm"/>
    <rdfs:label xml:lang="en">basis</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Basis"/>
    <skos:definition xml:lang="en">How the term relates to a standard.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#citation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Authority"/>
    <rdfs:label xml:lang="en">citation</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The law's citation, as its jurisdiction writes it (21 CFR Part 11).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#decidedOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Decision"/>
    <rdfs:label xml:lang="en">decidedOn</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The day (YYYY-MM-DD) the decision was made.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#decision">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#OntologyTerm"/>
    <rdfs:label xml:lang="en">decision</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Decision"/>
    <skos:definition xml:lang="en">The decision that records why the term is unaligned.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#decisionOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Decision"/>
    <rdfs:label xml:lang="en">decisionOf</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#OntologyTerm"/>
    <skos:definition xml:lang="en">The term the decision is about.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#definedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#OntologyTerm"/>
    <rdfs:label xml:lang="en">definedBy</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">A specification (and its requirement) that defines the term.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#deprecatedOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#OntologyTerm"/>
    <rdfs:label xml:lang="en">deprecatedOn</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The day (YYYY-MM-DD) the term was deprecated: a specification must not name it, and it names its replacement.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#direction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Integration"/>
    <rdfs:label xml:lang="en">direction</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#IntegrationDirection"/>
    <skos:definition xml:lang="en">import or export.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#effective">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Authority"/>
    <rdfs:label xml:lang="en">effective</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The day (YYYY-MM-DD) the law took effect, where it is known.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#enforcedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#ConformanceRequirement"/>
    <rdfs:label xml:lang="en">enforcedBy</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">What else proves the requirement, in words, where no rule of Mizan's check does.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#entails">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#ConformanceLevel"/>
    <rdfs:label xml:lang="en">entails</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#ConformanceRequirement"/>
    <skos:definition xml:lang="en">A requirement the level adds to those of the levels below it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#fromFormat">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Integration"/>
    <rdfs:label xml:lang="en">fromFormat</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The format the integration reads.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#generator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#ImportRecord"/>
    <rdfs:label xml:lang="en">generator</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The generator that wrote the imported module.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#handles">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Integration"/>
    <rdfs:label xml:lang="en">handles</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Standard"/>
    <skos:definition xml:lang="en">The standard the integration handles.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#home">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Rung"/>
    <rdfs:label xml:lang="en">home</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">A path or a glob of a harness's files that is on the rung.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#importOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#ImportRecord"/>
    <rdfs:label xml:lang="en">importOf</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Standard"/>
    <skos:definition xml:lang="en">The standard that was imported.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#importedOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#ImportRecord"/>
    <rdfs:label xml:lang="en">importedOn</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The day (YYYY-MM-DD) of the import.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#incorporates">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Authority"/>
    <rdfs:label xml:lang="en">incorporates</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">A standard the law incorporates by reference, by its identifier.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#isolation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Exception"/>
    <rdfs:label xml:lang="en">isolation</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">How nothing else depends on the tool: a typed TypeScript wrapper, files in and files out.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#issuer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Standard"/>
    <rdfs:label xml:lang="en">issuer</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">Who publishes the standard.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#jurisdiction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Authority"/>
    <rdfs:label xml:lang="en">jurisdiction</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Jurisdiction"/>
    <skos:definition xml:lang="en">The jurisdiction whose law it is.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#justification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#OntologyTerm"/>
    <rdfs:label xml:lang="en">justification</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">For an unaligned term: the standards looked at and why none fits.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#kind">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Rung"/>
    <rdfs:label xml:lang="en">kind</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#RungKind"/>
    <skos:definition xml:lang="en">required, optional, observer or environment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#level">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Jurisdiction"/>
    <rdfs:label xml:lang="en">level</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#JurisdictionLevel"/>
    <skos:definition xml:lang="en">federal, state, local or international.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#levelRank">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#ConformanceLevel"/>
    <rdfs:label xml:lang="en">levelRank</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <skos:definition xml:lang="en">The level's rank, 0 to 3: a level entails the requirements of every level of a lower rank.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#license">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Standard"/>
    <rdfs:label xml:lang="en">license</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The license, as an SPDX identifier.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#location">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Standard"/>
    <rdfs:label xml:lang="en">location</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">Where the standard is published.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#mappingRelation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#OntologyTerm"/>
    <rdfs:label xml:lang="en">mappingRelation</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">How the term relates to the standard's term, in the words a mapping is published with: exactMatch, closeMatch, narrowMatch, broadMatch, subClassOf or subPropertyOf.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#mayRelyOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Rung"/>
    <rdfs:label xml:lang="en">mayRelyOn</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Rung"/>
    <skos:definition xml:lang="en">A rung this rung may rely on, and never reach around.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#ofSpec">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Requirement"/>
    <rdfs:label xml:lang="en">ofSpec</rdfs:label>
    <rdfs:range rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Spec"/>
    <skos:definition xml:lang="en">The specification the requirement is in.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#pinnedVersion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Exception"/>
    <rdfs:label xml:lang="en">pinnedVersion</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The version of the tool that is pinned (commons 0002-packaging).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#platform">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Exception"/>
    <rdfs:label xml:lang="en">platform</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">A platform the tool supports: linux, macos or windows.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#provedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Rung"/>
    <rdfs:label xml:lang="en">provedBy</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">A command of a harness that proves the rung.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#record">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Decision"/>
    <rdfs:label xml:lang="en">record</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">Where the decision is recorded in the harness's own system, where it has one.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#redistributable">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Standard"/>
    <rdfs:label xml:lang="en">redistributable</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <skos:definition xml:lang="en">Whether its text may be copied; false for a standard that is only cited.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#replacedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#OntologyTerm"/>
    <rdfs:label xml:lang="en">replacedBy</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The IRI of the term that replaces a deprecated term.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#requirementId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Requirement"/>
    <rdfs:label xml:lang="en">requirementId</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The requirement's number in its specification (FR-001).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#rule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#ConformanceRequirement"/>
    <rdfs:label xml:lang="en">rule</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The id of a rule of Mizan's check that proves the requirement, or a family of ids ending in `/*`.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#rungNumber">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Rung"/>
    <rdfs:label xml:lang="en">rungNumber</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <skos:definition xml:lang="en">The rung's number, 0 to 10.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#sourceSha256">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Standard"/>
    <rdfs:label xml:lang="en">sourceSha256</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The SHA-256 of what was imported, in lower-case hexadecimal.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#spec">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Rung"/>
    <rdfs:label xml:lang="en">spec</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">A specification (and its requirement) the rung comes from, as a harness cites it: `NNN-slug FR-nnn`.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#specId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Spec"/>
    <rdfs:label xml:lang="en">specId</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The specification's identifier, its folder's name.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#specStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Spec"/>
    <rdfs:label xml:lang="en">specStatus</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">Draft, Active, Deferred or Superseded.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#standardTerm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#OntologyTerm"/>
    <rdfs:label xml:lang="en">standardTerm</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The IRI of the standard's term, where there is one.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#standardVersion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Standard"/>
    <rdfs:label xml:lang="en">standardVersion</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The version that is pinned.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#termIri">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#OntologyTerm"/>
    <rdfs:label xml:lang="en">termIri</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The IRI of the term the individual describes.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#toFormat">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Integration"/>
    <rdfs:label xml:lang="en">toFormat</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The format the integration writes.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#tool">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Exception"/>
    <rdfs:label xml:lang="en">tool</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">The tool, its language or its format.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan#whyNotTypeScript">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Exception"/>
    <rdfs:label xml:lang="en">whyNotTypeScript</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">Why TypeScript or a hand-written parser is not enough.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/ontology/mizan">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:description xml:lang="en">The shared vocabulary of Mizan, the IF Spec Profile: the ladder, specifications and requirements, standards, laws and the basis of every term.</dcterms:description>
    <rdfs:label xml:lang="en">Mizan</rdfs:label>
    <owl:versionIRI rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan/1.0.0"/>
    <owl:versionInfo>1.0.0</owl:versionInfo>
  </rdf:Description>
</rdf:RDF>
