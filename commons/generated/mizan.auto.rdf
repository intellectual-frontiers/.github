    <mz:rungNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</mz:rungNumber>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/id/mizan/rung-3">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Rung"/>
    <rdfs:label xml:lang="en">Data operations</rdfs:label>
    <skos:definition xml:lang="en">Work as close to the data as possible.</skos:definition>
    <mz:kind rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Required"/>
    <mz:mayRelyOn rdf:resource="https://www.intellectualfrontiers.com/id/mizan/rung-0"/>
    <mz:mayRelyOn rdf:resource="https://www.intellectualfrontiers.com/id/mizan/rung-1"/>
