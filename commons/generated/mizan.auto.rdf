  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/id/mizan/authority-21-cfr-820">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Authority"/>
    <rdfs:label xml:lang="en">21 CFR Part 820, Quality Management System Regulation</rdfs:label>
    <skos:definition xml:lang="en">The FDA's regulation of the quality management systems of medical-device manufacturers, amended to incorporate ISO 13485:2016 by reference (verified against the FDA and the Federal Register, 2026-11).</skos:definition>
    <mz:citation>21 CFR Part 820</mz:citation>
    <mz:effective>2026-02-02</mz:effective>
    <mz:incorporates>ISO 13485:2016</mz:incorporates>
    <mz:jurisdiction rdf:resource="https://www.intellectualfrontiers.com/id/mizan/jurisdiction-us"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/id/mizan/decision-mz-RungKind">
