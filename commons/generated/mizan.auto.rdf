    <mz:mayRelyOn rdf:resource="https://www.intellectualfrontiers.com/id/mizan/rung-4"/>
    <mz:mayRelyOn rdf:resource="https://www.intellectualfrontiers.com/id/mizan/rung-5"/>
    <mz:rungNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</mz:rungNumber>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/id/mizan/rung-7">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Rung"/>
    <rdfs:label xml:lang="en">Documentation</rdfs:label>
    <skos:definition xml:lang="en">How to operate everything below.</skos:definition>
    <mz:kind rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Required"/>
    <mz:mayRelyOn rdf:resource="https://www.intellectualfrontiers.com/id/mizan/rung-0"/>
