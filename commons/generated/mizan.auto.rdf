  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/id/mizan/rung-4">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Rung"/>
    <rdfs:label xml:lang="en">Infrastructure rules</rdfs:label>
    <skos:definition xml:lang="en">Logic reused across services, neutral to any one service.</skos:definition>
    <mz:kind rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Required"/>
    <mz:mayRelyOn rdf:resource="https://www.intellectualfrontiers.com/id/mizan/rung-0"/>
    <mz:mayRelyOn rdf:resource="https://www.intellectualfrontiers.com/id/mizan/rung-1"/>
    <mz:mayRelyOn rdf:resource="https://www.intellectualfrontiers.com/id/mizan/rung-3"/>
    <mz:rungNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</mz:rungNumber>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/id/mizan/rung-5">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Rung"/>
    <rdfs:label xml:lang="en">Business rules</rdfs:label>
    <skos:definition xml:lang="en">A service's own logic: its operations and rules.</skos:definition>
    <mz:kind rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Required"/>
    <mz:mayRelyOn rdf:resource="https://www.intellectualfrontiers.com/id/mizan/rung-0"/>
    <mz:mayRelyOn rdf:resource="https://www.intellectualfrontiers.com/id/mizan/rung-1"/>
    <mz:mayRelyOn rdf:resource="https://www.intellectualfrontiers.com/id/mizan/rung-3"/>
    <mz:mayRelyOn rdf:resource="https://www.intellectualfrontiers.com/id/mizan/rung-4"/>
    <mz:rungNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</mz:rungNumber>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/id/mizan/rung-6">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Rung"/>
    <rdfs:label xml:lang="en">Application</rdfs:label>
    <skos:definition xml:lang="en">The headless hosts (command line, MCP server, HTTP server, container service, daemon), then the windowed hosts.</skos:definition>
    <mz:kind rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Required"/>
    <mz:mayRelyOn rdf:resource="https://www.intellectualfrontiers.com/id/mizan/rung-0"/>
