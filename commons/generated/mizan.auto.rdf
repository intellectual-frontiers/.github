    <rdfs:label xml:lang="en">Keep mz:RungKind unaligned</rdfs:label>
    <mz:decidedOn>2026-11-17</mz:decidedOn>
    <mz:decisionOf rdf:resource="https://www.intellectualfrontiers.com/id/mizan/term-RungKind"/>
