    <mz:mayRelyOn rdf:resource="https://www.intellectualfrontiers.com/id/mizan/rung-5"/>
    <mz:mayRelyOn rdf:resource="https://www.intellectualfrontiers.com/id/mizan/rung-6"/>
    <mz:rungNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</mz:rungNumber>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/id/mizan/rung-8">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Rung"/>
    <rdfs:label xml:lang="en">Lifecycle: retired, then archived</rdfs:label>
    <skos:definition xml:lang="en">What is retired (alive, not to be used), then what is archived (dead, safe to delete). It relies on nothing and nothing relies on it.</skos:definition>
    <mz:kind rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Optional"/>
    <mz:rungNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</mz:rungNumber>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.intellectualfrontiers.com/id/mizan/rung-9">
    <rdf:type rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Rung"/>
    <rdfs:label xml:lang="en">Evidence: what the system records about itself</rdfs:label>
    <skos:definition xml:lang="en">The records produced by operating the system, never written by hand: test and check runs, findings, nonconformances, corrective actions, change records and attestations. They are append-only and prove every other rung; no rung relies on them, so that evidence cannot authorize itself.</skos:definition>
    <mz:kind rdf:resource="https://www.intellectualfrontiers.com/ontology/mizan#Observer"/>
    <mz:mayRelyOn rdf:resource="https://www.intellectualfrontiers.com/id/mizan/rung-0"/>
    <mz:mayRelyOn rdf:resource="https://www.intellectualfrontiers.com/id/mizan/rung-1"/>
    <mz:mayRelyOn rdf:resource="https://www.intellectualfrontiers.com/id/mizan/rung-2"/>
    <mz:mayRelyOn rdf:resource="https://www.intellectualfrontiers.com/id/mizan/rung-3"/>
    <mz:mayRelyOn rdf:resource="https://www.intellectualfrontiers.com/id/mizan/rung-4"/>
    <mz:mayRelyOn rdf:resource="https://www.intellectualfrontiers.com/id/mizan/rung-5"/>
    <mz:mayRelyOn rdf:resource="https://www.intellectualfrontiers.com/id/mizan/rung-6"/>
    <mz:mayRelyOn rdf:resource="https://www.intellectualfrontiers.com/id/mizan/rung-7"/>
    <mz:rungNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</mz:rungNumber>
  </rdf:Description>
