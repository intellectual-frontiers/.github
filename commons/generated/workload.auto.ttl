wl:Alert a wl:Trigger ;
    rdfs:label "Alert"@en ;
    skos:definition "The workload starts when a named alert fires."@en .

wl:Campaign a wl:Form ;
    rdfs:label "Campaign"@en ;
    skos:definition "The form of a collection over a period with sampling; reserved until a second concrete user needs it."@en ;
    wl:formStatus "reserved" .

wl:Event a wl:Trigger ;
    rdfs:label "Event"@en ;
    skos:definition "The workload starts when a named event happens."@en .

wl:Form a owl:Class ;
    rdfs:label "Form"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "One of the forms a workload may have: what kind of work it is and how it executes. A form is never a dialect."@en .

wl:Graph a wl:Form ;
    rdfs:label "Graph"@en ;
    skos:definition "The form of a graph of jobs with freshness, which an external executor runs; reserved until a second concrete user needs it."@en ;
    wl:formStatus "reserved" .

wl:Manual a wl:Trigger ;
    rdfs:label "Manual"@en ;
    skos:definition "A person or an agent starts the workload by hand."@en .

wl:Reconcile a wl:Form ;
    rdfs:label "Reconcile"@en ;
    skos:definition "The form of a loop toward a desired state: observe, diff, plan, approve the plan by its hash, apply and verify, level-triggered."@en ;
    wl:formStatus "built" .

wl:Runbook a wl:Form ;
    rdfs:label "Runbook"@en ;
    skos:definition "The form of a procedure: an ordered algebra of steps that a person or an agent orchestrates, each effect a verb."@en ;
    wl:formStatus "built" .

wl:Schedule a wl:Trigger ;
    rdfs:label "Schedule"@en ;
    skos:definition "The workload starts on a cadence: daily, weekly, monthly, quarterly or yearly."@en .

wl:Trigger a owl:Class ;
    rdfs:label "Trigger"@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "One of the ways a workload is started. A trigger is a field of a workload and never a form."@en .

wl:Workload a owl:Class ;
    rdfs:label "Workload"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "A unit of operated work, not running software: typed data of one form, with a trigger, whose every effect is a verb and whose autonomy is derived from its effects."@en .

wl:formStatus a owl:DatatypeProperty ;
    rdfs:domain wl:Form ;
    rdfs:label "form status"@en ;
    rdfs:range xsd:string ;
    skos:definition "Whether the form has code (built) or is a named slot with no code (reserved)."@en .

wl:workloadForm a owl:ObjectProperty ;
    rdfs:domain wl:Workload ;
    rdfs:label "workload form"@en ;
    rdfs:range wl:Form ;
    skos:definition "The form of the workload."@en .

wl:workloadId a owl:DatatypeProperty ;
    rdfs:domain wl:Workload ;
    rdfs:label "workload id"@en ;
    rdfs:range xsd:string ;
    skos:definition "The id of the workload: lower case words joined by hyphens, which is also the name of its skill."@en .

wl:workloadTrigger a owl:ObjectProperty ;
    rdfs:domain wl:Workload ;
    rdfs:label "workload trigger"@en ;
    rdfs:range wl:Trigger ;
    skos:definition "What starts the workload."@en .

