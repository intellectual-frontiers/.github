{
  "name": "@intellectual-frontiers/formats",
  "private": true,
  "version": "0.2.3",
  "description": "Formats: JSON5, YAML, TOML, XML, CSV, base64, hexadecimal, ASN.1 DER, CBOR, archives, PNG, TypeScript literals, globs, semantic versions, media types and HTTP headers, read and written in pure code with one dependency, core.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": "./src/mod.ts",
    "./archive": "./src/archive.ts",
    "./asciidoc": "./src/asciidoc.ts",
    "./base64": "./src/base64.ts",
    "./cbor": "./src/cbor.ts",
    "./csv": "./src/csv.ts",
    "./der": "./src/der.ts",
    "./glob": "./src/glob.ts",
    "./hex": "./src/hex.ts",
    "./http": "./src/http.ts",
    "./json5": "./src/json5.ts",
    "./media-types": "./src/media-types.ts",
    "./png": "./src/png.ts",
    "./semver": "./src/semver.ts",
    "./toml": "./src/toml.ts",
    "./ts-literal": "./src/ts-literal.ts",
    "./xml": "./src/xml.ts",
    "./xz": "./src/xz.ts",
    "./yaml": "./src/yaml.ts"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "test": "bun test suite/",
    "test:node": "node --test \"suite/**/*.test.ts\"",
    "verify": "tsc -p tsconfig.json && bun ../tools/mizan-check.ts --root spec-kit && bun ../libraries/src/check.ts --root spec-kit --level L1 && bun tools/check.ts && bun test suite/ && bun tools/pack.ts --check",
    "pack": "bun tools/pack.ts"
  },
  "devDependencies": {
    "@intellectual-frontiers/core": "link:../core",
    "@intellectual-frontiers/libraries": "link:../libraries",
    "@intellectual-frontiers/mizan": "link:../mizan",
    "@intellectual-frontiers/system": "link:../system",
    "@intellectual-frontiers/test": "link:../test",
    "@types/node": "26.6.6",
    "fast-check": "4.10.2",
    "typescript": "7.0.2"
  }
}
