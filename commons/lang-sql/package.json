{
  "name": "@intellectual-frontiers/lang-sql",
  "private": true,
  "version": "0.1.0",
  "description": "A small, fast, portable multi-dialect SQL language library: a lexer, a closed syntax tree and a parser for thirty dialects, comments as first-class nodes, and extensions for queries, unist, documentation and PL/pgSQL.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": "./src/mod.ts",
    "./aide/catalog": "./src/aide/catalog/mod.ts",
    "./aide/exec": "./src/aide/exec/mod.ts",
    "./aide/normalize": "./src/aide/normalize/mod.ts",
    "./aide/plan": "./src/aide/plan/mod.ts",
    "./aide/profile": "./src/aide/profile/mod.ts",
    "./aide/text": "./src/aide/text/mod.ts",
    "./dialects/athena": "./src/dialects/athena/mod.ts",
    "./dialects/bigquery": "./src/dialects/bigquery/mod.ts",
    "./dialects/clickhouse": "./src/dialects/clickhouse/mod.ts",
    "./dialects/databricks": "./src/dialects/databricks/mod.ts",
    "./dialects/doris": "./src/dialects/doris/mod.ts",
    "./dialects/dremio": "./src/dialects/dremio/mod.ts",
    "./dialects/drill": "./src/dialects/drill/mod.ts",
    "./dialects/druid": "./src/dialects/druid/mod.ts",
    "./dialects/duckdb": "./src/dialects/duckdb/mod.ts",
    "./dialects/dune": "./src/dialects/dune/mod.ts",
    "./dialects/exasol": "./src/dialects/exasol/mod.ts",
    "./dialects/fabric": "./src/dialects/fabric/mod.ts",
    "./dialects/hive": "./src/dialects/hive/mod.ts",
    "./dialects/materialize": "./src/dialects/materialize/mod.ts",
    "./dialects/mysql": "./src/dialects/mysql/mod.ts",
    "./dialects/oracle": "./src/dialects/oracle/mod.ts",
    "./dialects/postgres": "./src/dialects/postgres/mod.ts",
    "./dialects/presto": "./src/dialects/presto/mod.ts",
    "./dialects/redshift": "./src/dialects/redshift/mod.ts",
    "./dialects/risingwave": "./src/dialects/risingwave/mod.ts",
    "./dialects/singlestore": "./src/dialects/singlestore/mod.ts",
    "./dialects/snowflake": "./src/dialects/snowflake/mod.ts",
    "./dialects/solr": "./src/dialects/solr/mod.ts",
    "./dialects/spark": "./src/dialects/spark/mod.ts",
    "./dialects/spark2": "./src/dialects/spark2/mod.ts",
    "./dialects/sqlite": "./src/dialects/sqlite/mod.ts",
    "./dialects/starrocks": "./src/dialects/starrocks/mod.ts",
    "./dialects/teradata": "./src/dialects/teradata/mod.ts",
    "./dialects/trino": "./src/dialects/trino/mod.ts",
    "./dialects/tsql": "./src/dialects/tsql/mod.ts",
    "./extensions/docs": "./src/extensions/docs/mod.ts",
    "./extensions/introspect": "./src/extensions/introspect/mod.ts",
    "./extensions/plpgsql": "./src/extensions/plpgsql/mod.ts",
    "./extensions/query": "./src/extensions/query/mod.ts",
    "./extensions/unist": "./src/extensions/unist/mod.ts"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "test": "bun test suite/",
    "test:node": "node --test \"suite/**/*.test.ts\"",
    "verify": "tsc -p tsconfig.json && bun ../tools/mizan-check.ts --root spec-kit && bun ../libraries/src/check.ts --root spec-kit --level L1 && bun tools/check.ts && bun test suite/ && bun tools/pack.ts --check",
    "pack": "bun tools/pack.ts"
  },
  "devDependencies": {
    "@intellectual-frontiers/core": "link:../core",
    "@intellectual-frontiers/libraries": "link:../libraries",
    "@intellectual-frontiers/mizan": "link:../mizan",
    "@intellectual-frontiers/system": "link:../system",
    "@intellectual-frontiers/test": "link:../test",
    "@types/node": "26.6.6",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "unist-util-select": "5.1.0",
    "unist-util-visit": "5.2.0"
  }
}
