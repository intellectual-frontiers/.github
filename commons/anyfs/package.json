{
  "name": "@intellectual-frontiers/anyfs",
  "private": true,
  "version": "0.1.0",
  "description": "One typed interface to every place bytes live: paths and places as types, a revision on every read and a stated expectation on every write, the capabilities of a store in its type, attenuation, mounts, composable layers and one conformance suite that every backend passes.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": "./src/mod.ts",
    "./governance": "./src/governance/mod.ts",
    "./logical": "./src/logical/mod.ts",
    "./physical": "./src/physical/mod.ts",
    "./layers": "./src/logical/layers/mod.ts",
    "./conformance": "./src/logical/conformance/mod.ts",
    "./memory": "./src/physical/memory/mod.ts",
    "./local": "./src/physical/local/mod.ts",
    "./merge": "./src/merge/mod.ts",
    "./memory-merge": "./src/physical/memory-merge/mod.ts",
    "./docs": "./src/docs/mod.ts",
    "./docs/formats": "./src/docs/formats/mod.ts"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "test": "bun test ./suite/",
    "test:node": "node --test \"suite/**/*.test.ts\"",
    "verify": "tsc -p tsconfig.json && tsc -p tsconfig.consumer.json && bun ../tools/mizan-check.ts --root spec-kit && bun ../libraries/src/check.ts --root spec-kit --level L1 && bun ../kanon/src/check.ts && bun tools/check.ts && bun test ./suite/ && bun tools/pack.ts --check",
    "pack": "bun tools/pack.ts"
  },
  "devDependencies": {
    "@intellectual-frontiers/core": "link:../core",
    "@intellectual-frontiers/crypto": "link:../crypto",
    "@intellectual-frontiers/formats": "link:../formats",
    "@intellectual-frontiers/kanon": "link:../kanon",
    "@intellectual-frontiers/libraries": "link:../libraries",
    "@intellectual-frontiers/mizan": "link:../mizan",
    "@intellectual-frontiers/ontology": "link:../ontology",
    "@intellectual-frontiers/system": "link:../system",
    "@intellectual-frontiers/telemetry": "link:../telemetry",
    "@intellectual-frontiers/test": "link:../test",
    "@types/node": "26.6.6",
    "fast-check": "4.10.2",
    "typescript": "7.0.2"
  }
}
