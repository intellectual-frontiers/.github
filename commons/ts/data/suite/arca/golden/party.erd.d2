party_kind: {
  shape: sql_table
  code: text {constraint: primary_key}
  label: text
  description: text
}
party_role_kind: {
  shape: sql_table
  code: text {constraint: primary_key}
  label: text
  description: text
}
party_relation_kind: {
  shape: sql_table
  code: text {constraint: primary_key}
  label: text
  description: text
}
party_identifier_kind: {
  shape: sql_table
  code: text {constraint: primary_key}
  label: text
  description: text
}
party: {
  shape: sql_table
  party_id: text {constraint: primary_key}
  party_kind_code: text {constraint: foreign_key}
  display_name: text
  created_at: timestamp
  created_by: text
  updated_at: timestamp
  updated_by: text
  deleted_at: timestamp
  deleted_by: text
}
person: {
  shape: sql_table
  party_id: text {constraint: [primary_key; foreign_key]}
  given_name: text
  family_name: text
  birth_date: date
  created_at: timestamp
  created_by: text
  updated_at: timestamp
  updated_by: text
  deleted_at: timestamp
  deleted_by: text
}
organization: {
  shape: sql_table
  party_id: text {constraint: [primary_key; foreign_key]}
  legal_name: text
  founded_on: date
  created_at: timestamp
  created_by: text
  updated_at: timestamp
  updated_by: text
  deleted_at: timestamp
  deleted_by: text
}
party_role: {
  shape: sql_table
  party_role_id: text {constraint: primary_key}
  party_id: text {constraint: foreign_key}
  party_role_kind_code: text {constraint: foreign_key}
  valid_from: date
  valid_to: date
  created_at: timestamp
  created_by: text
  updated_at: timestamp
  updated_by: text
  deleted_at: timestamp
  deleted_by: text
}
party_relation: {
  shape: sql_table
  party_relation_id: text {constraint: primary_key}
  from_party_id: text {constraint: foreign_key}
  to_party_id: text {constraint: foreign_key}
  party_relation_kind_code: text {constraint: foreign_key}
  valid_from: date
  valid_to: date
  created_at: timestamp
  created_by: text
  updated_at: timestamp
  updated_by: text
  deleted_at: timestamp
  deleted_by: text
}
party_identifier: {
  shape: sql_table
  party_identifier_id: text {constraint: primary_key}
  party_id: text {constraint: foreign_key}
  party_identifier_kind_code: text {constraint: foreign_key}
  identifier: text
  issued_by: text
  created_at: timestamp
  created_by: text
  updated_at: timestamp
  updated_by: text
  deleted_at: timestamp
  deleted_by: text
}
electronic_contact: {
  shape: sql_table
  electronic_contact_id: text {constraint: primary_key}
  party_id: text {constraint: foreign_key}
  medium: enum
  address: text
  is_primary: boolean
  created_at: timestamp
  created_by: text
  updated_at: timestamp
  updated_by: text
  deleted_at: timestamp
  deleted_by: text
}
postal_address: {
  shape: sql_table
  postal_address_id: text {constraint: primary_key}
  party_id: text {constraint: foreign_key}
  purpose: enum
  line_1: text
  line_2: text
  locality: text
  region: text
  postal_code: text
  country_code: text
  created_at: timestamp
  created_by: text
  updated_at: timestamp
  updated_by: text
  deleted_at: timestamp
  deleted_by: text
}
party.party_kind_code -> party_kind.code
person.party_id -> party.party_id
organization.party_id -> party.party_id
party_role.party_id -> party.party_id
party_role.party_role_kind_code -> party_role_kind.code
party_relation.from_party_id -> party.party_id
party_relation.to_party_id -> party.party_id
party_relation.party_relation_kind_code -> party_relation_kind.code
party_identifier.party_id -> party.party_id
party_identifier.party_identifier_kind_code -> party_identifier_kind.code
electronic_contact.party_id -> party.party_id
postal_address.party_id -> party.party_id
