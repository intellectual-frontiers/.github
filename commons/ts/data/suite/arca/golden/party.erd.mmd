erDiagram
    party_kind {
        text code PK
        text label
        text description
    }
    party_role_kind {
        text code PK
        text label
        text description
    }
    party_relation_kind {
        text code PK
        text label
        text description
    }
    party_identifier_kind {
        text code PK
        text label
        text description
    }
    party {
        text party_id PK
        text party_kind_code FK
        text display_name
        timestamp created_at
        text created_by
        timestamp updated_at
        text updated_by
        timestamp deleted_at
        text deleted_by
    }
    person {
        text party_id PK, FK
        text given_name
        text family_name
        date birth_date
        timestamp created_at
        text created_by
        timestamp updated_at
        text updated_by
        timestamp deleted_at
        text deleted_by
    }
    organization {
        text party_id PK, FK
        text legal_name
        date founded_on
        timestamp created_at
        text created_by
        timestamp updated_at
        text updated_by
        timestamp deleted_at
        text deleted_by
    }
    party_role {
        text party_role_id PK
        text party_id FK
        text party_role_kind_code FK
        date valid_from
        date valid_to
        timestamp created_at
        text created_by
        timestamp updated_at
        text updated_by
        timestamp deleted_at
        text deleted_by
    }
    party_relation {
        text party_relation_id PK
        text from_party_id FK
        text to_party_id FK
        text party_relation_kind_code FK
        date valid_from
        date valid_to
        timestamp created_at
        text created_by
        timestamp updated_at
        text updated_by
        timestamp deleted_at
        text deleted_by
    }
    party_identifier {
        text party_identifier_id PK
        text party_id FK
        text party_identifier_kind_code FK
        text identifier
        text issued_by
        timestamp created_at
        text created_by
        timestamp updated_at
        text updated_by
        timestamp deleted_at
        text deleted_by
    }
    electronic_contact {
        text electronic_contact_id PK
        text party_id FK
        enum medium
        text address
        boolean is_primary
        timestamp created_at
        text created_by
        timestamp updated_at
        text updated_by
        timestamp deleted_at
        text deleted_by
    }
    postal_address {
        text postal_address_id PK
        text party_id FK
        enum purpose
        text line_1
        text line_2
        text locality
        text region
        text postal_code
        text country_code
        timestamp created_at
        text created_by
        timestamp updated_at
        text updated_by
        timestamp deleted_at
        text deleted_by
    }
    party_kind ||--o{ party : "party_kind_code"
    party ||--o| person : "party_id"
    party ||--o| organization : "party_id"
