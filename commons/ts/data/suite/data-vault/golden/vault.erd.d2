hub_customer: {
  shape: sql_table
  hub_customer_id: text {constraint: primary_key}
  customer_number: text
  load_at: timestamp
  record_source: text
}
hub_order: {
  shape: sql_table
  hub_order_id: text {constraint: primary_key}
  order_number: text
  load_at: timestamp
  record_source: text
}
sat_customer_contact: {
  shape: sql_table
  sat_customer_contact_id: text {constraint: primary_key}
  hub_customer_id: text {constraint: foreign_key}
  email: text
  load_at: timestamp
  record_source: text
}
sat_order_state: {
  shape: sql_table
  sat_order_state_id: text {constraint: primary_key}
  hub_order_id: text {constraint: foreign_key}
  status: text
  due: date
  load_at: timestamp
  record_source: text
}
link_customer_order: {
  shape: sql_table
  link_customer_order_id: text {constraint: primary_key}
  hub_customer_id: text {constraint: foreign_key}
  hub_order_id: text {constraint: foreign_key}
  load_at: timestamp
  record_source: text
}
sat_customer_contact.hub_customer_id -> hub_customer.hub_customer_id
sat_order_state.hub_order_id -> hub_order.hub_order_id
link_customer_order.hub_customer_id -> hub_customer.hub_customer_id
link_customer_order.hub_order_id -> hub_order.hub_order_id
