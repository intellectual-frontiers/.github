{
  "name": "@intellectual-frontiers/commons",
  "private": true,
  "version": "0.29.5",
  "description": "IFC TypeScript, for the development of commons/ts: the pure kernel and the host runtime of Intellectual Frontiers Commons, on web standards and node: builtins (commons 0005-typescript-runtime). A consumer depends on the repository's root package by Git, under the same name and entry points.",
  "type": "module",
  "exports": {
    "./ts/kernel": "./kernel/mod.ts",
    "./ts/runtime": "./runtime/mod.ts",
    "./ts/node": "./node/register.mjs"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.kernel.json && tsc -p tsconfig.root-tests.json",
    "test": "bun test tests/",
    "test:node": "node --test \"tests/**/*.test.ts\"",
    "smoke": "bun tools/smoke.ts",
    "test:evidence": "bun ../quality/src/test-cli.ts run --runtime bun,node --out test-results --report tap,junit,ctrf,sarif,md,html,oscal --requirements ../spec-kit/enforcement.tsv --spec 0005-typescript-runtime --ledger test-results/ledger.jsonl tests",
    "test:verify": "bun ../quality/src/test-cli.ts verify --record"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "typescript-7-1": "npm:typescript@7.1.0-beta"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intellectual-frontiers/.github.git",
    "directory": "commons/ts"
  },
  "dependencies": {
    "@intellectual-frontiers/core": "link:../core",
    "@intellectual-frontiers/crypto": "link:../crypto",
    "@intellectual-frontiers/formats": "link:../formats",
    "@intellectual-frontiers/githost": "link:../githost",
    "@intellectual-frontiers/grc": "link:../grc",
    "@intellectual-frontiers/headless": "link:../headless",
    "@intellectual-frontiers/kanon": "link:../kanon",
    "@intellectual-frontiers/libraries": "link:../libraries",
    "@intellectual-frontiers/mizan": "link:../mizan",
    "@intellectual-frontiers/net": "link:../net",
    "@intellectual-frontiers/ontology": "link:../ontology",
    "@intellectual-frontiers/quality": "link:../quality",
    "@intellectual-frontiers/rdf": "link:../rdf",
    "@intellectual-frontiers/system": "link:../system",
    "@intellectual-frontiers/telemetry": "link:../telemetry",
    "@intellectual-frontiers/terminal": "link:../terminal",
    "@intellectual-frontiers/test": "link:../test"
  }
}
