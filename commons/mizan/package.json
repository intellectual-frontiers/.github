{
  "name": "@intellectual-frontiers/mizan",
  "private": true,
  "version": "0.2.3",
  "description": "Mizan as code: the rules a specification is held to as plugins of one harness, the levels of conformance, the integrations of standards, the change-control and release rules, and the trace of requirements to code and tests; the same code on Bun and Node 26.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": "./src/mod.ts",
    "./changes": "./src/changes/mod.ts",
    "./changes/capability-trace": "./src/changes/capability-trace.ts",
    "./changes/capability-view": "./src/changes/capability-view.ts",
    "./changes/commit-message": "./src/changes/commit-message.ts",
    "./changes/declaration": "./src/changes/declaration.ts",
    "./changes/git-log": "./src/changes/git-log.ts",
    "./changes/issue-body": "./src/changes/issue-body.ts",
    "./changes/plugin": "./src/changes/plugin.ts",
    "./changes/rules": "./src/changes/rules.ts",
    "./changes/strict": "./src/changes/strict.ts",
    "./changes/terms-file": "./src/changes/terms-file.ts",
    "./changes/trace": "./src/changes/trace.ts",
    "./harness": "./src/harness.ts",
    "./host/trace": "./src/host/trace.ts",
    "./integrations": "./src/integrations/mod.ts",
    "./integrations/host/import": "./src/integrations/host/import.ts",
    "./integrations/pure/export": "./src/integrations/pure/export.ts",
    "./integrations/pure/export-dcat": "./src/integrations/pure/export-dcat.ts",
    "./integrations/pure/export-html": "./src/integrations/pure/export-html.ts",
    "./integrations/pure/export-owl": "./src/integrations/pure/export-owl.ts",
    "./integrations/pure/export-rdfxml": "./src/integrations/pure/export-rdfxml.ts",
    "./integrations/pure/import-json-schema": "./src/integrations/pure/import-json-schema.ts",
    "./integrations/pure/import-oscal-catalog": "./src/integrations/pure/import-oscal-catalog.ts",
    "./integrations/pure/import-vocabulary": "./src/integrations/pure/import-vocabulary.ts",
    "./integrations/pure/provenance": "./src/integrations/pure/provenance.ts",
    "./integrations/pure/read-json-ld": "./src/integrations/pure/read-json-ld.ts",
    "./integrations/pure/read-rdf": "./src/integrations/pure/read-rdf.ts",
    "./integrations/pure/read-rdf-xml": "./src/integrations/pure/read-rdf-xml.ts",
    "./integrations/pure/registry": "./src/integrations/pure/registry.ts",
    "./integrations/pure/types": "./src/integrations/pure/types.ts",
    "./layers": "./src/layers.ts",
    "./levels": "./src/levels.ts",
    "./rules": "./src/rules.ts",
    "./spec-files": "./src/spec-files.ts",
    "./spec-terms": "./src/spec-terms.ts",
    "./standards": "./src/standards.ts",
    "./trace": "./src/trace.ts",
    "./versions": "./src/versions/mod.ts",
    "./versions/cite": "./src/versions/cite.ts",
    "./versions/gate": "./src/versions/gate.ts",
    "./versions/git": "./src/versions/git.ts",
    "./versions/judge": "./src/versions/judge.ts",
    "./versions/ledger": "./src/versions/ledger.ts",
    "./versions/notes": "./src/versions/notes.ts",
    "./versions/plugin": "./src/versions/plugin.ts",
    "./versions/record": "./src/versions/record.ts",
    "./versions/rules": "./src/versions/rules.ts",
    "./versions/scan": "./src/versions/scan.ts",
    "./versions/scheme": "./src/versions/scheme.ts",
    "./versions/works": "./src/versions/works.ts"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "test": "bun test suite/",
    "test:node": "node --test \"suite/**/*.test.ts\"",
    "verify": "tsc -p tsconfig.json && bun ../tools/mizan-check.ts --root spec-kit && bun ../libraries/src/check.ts --root spec-kit --level L1 && bun tools/check.ts && bun test suite/ && bun tools/pack.ts --check",
    "pack": "bun tools/pack.ts"
  },
  "devDependencies": {
    "@intellectual-frontiers/core": "link:../core",
    "@intellectual-frontiers/crypto": "link:../crypto",
    "@intellectual-frontiers/formats": "link:../formats",
    "@intellectual-frontiers/githost": "link:../githost",
    "@intellectual-frontiers/grc": "link:../grc",
    "@intellectual-frontiers/libraries": "link:../libraries",
    "@intellectual-frontiers/net": "link:../net",
    "@intellectual-frontiers/ontology": "link:../ontology",
    "@intellectual-frontiers/quality": "link:../quality",
    "@intellectual-frontiers/rdf": "link:../rdf",
    "@intellectual-frontiers/system": "link:../system",
    "@intellectual-frontiers/telemetry": "link:../telemetry",
    "@intellectual-frontiers/terminal": "link:../terminal",
    "@intellectual-frontiers/test": "link:../test",
    "@types/node": "26.6.6",
    "fast-check": "4.10.2",
    "typescript": "7.0.2"
  }
}
