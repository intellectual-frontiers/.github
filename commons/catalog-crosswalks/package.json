{
  "name": "@intellectual-frontiers/catalog-crosswalks",
  "private": true,
  "version": "0.1.0",
  "description": "Crosswalks between frameworks as grc catalog packages, as proposals for a person to decide, and the pure view of the coverage of a framework through them.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": "./src/mod.ts",
    "./governance": "./src/governance/mod.ts",
    "./logical": "./src/logical/mod.ts",
    "./physical": "./src/physical/mod.ts"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "test": "bun test suite/",
    "test:node": "node --test \"suite/**/*.test.ts\"",
    "verify": "tsc -p tsconfig.json && bun ../tools/mizan-check.ts --root spec-kit && bun ../libraries/src/check.ts --root spec-kit --level L1 && bun ../kanon/src/check.ts && bun tools/check.ts && bun test suite/"
  },
  "devDependencies": {
    "@intellectual-frontiers/assessment": "link:../assessment",
    "@intellectual-frontiers/core": "link:../core",
    "@intellectual-frontiers/crypto": "link:../crypto",
    "@intellectual-frontiers/grc": "link:../grc",
    "@intellectual-frontiers/kanon": "link:../kanon",
    "@intellectual-frontiers/libraries": "link:../libraries",
    "@intellectual-frontiers/mizan": "link:../mizan",
    "@intellectual-frontiers/system": "link:../system",
    "@intellectual-frontiers/test": "link:../test",
    "@types/node": "26.6.6",
    "fast-check": "4.10.2",
    "typescript": "7.0.2"
  }
}
