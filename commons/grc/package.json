{
  "name": "@intellectual-frontiers/grc",
  "private": true,
  "version": "0.3.1",
  "description": "Governance, risk and compliance as a library of three layers: governance (frameworks, crosswalks, policies, checks, requirements, evidence policy and exceptions as data), the logical model (results, findings, evidence, attestations, assessments and the pure computations over them, as self-describing versioned documents) and the physical layer (registries of typed ports, with conformance suites, for runners, evidence stores, signers and serializers), with the headless verbs grc check, assess, explain and evidence; the same code on Bun and Node 26.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": "./src/mod.ts",
    "./governance": "./src/governance/mod.ts",
    "./logical": "./src/logical/mod.ts",
    "./physical": "./src/physical/mod.ts",
    "./conformance": "./src/conformance/mod.ts",
    "./standard": "./src/standard.ts",
    "./serializers/oscal": "./src/serializers/oscal/mod.ts",
    "./serializers/ocsf": "./src/serializers/ocsf/mod.ts",
    "./serializers/sarif": "./src/serializers/sarif/mod.ts",
    "./serializers/cyclonedx": "./src/serializers/cyclonedx/mod.ts",
    "./serializers/intoto": "./src/serializers/intoto/mod.ts",
    "./runners/sql": "./src/runners/sql/mod.ts",
    "./runners/file": "./src/runners/file/mod.ts",
    "./runners/api": "./src/runners/api/mod.ts",
    "./runners/remote": "./src/runners/remote/mod.ts",
    "./runners/manual": "./src/runners/manual/mod.ts",
    "./runners/external": "./src/runners/external/mod.ts",
    "./stores/memory": "./src/stores/memory/mod.ts",
    "./stores/files": "./src/stores/files/mod.ts",
    "./stores/git": "./src/stores/git/mod.ts",
    "./stores/gitref": "./src/stores/gitref/mod.ts",
    "./stores/object": "./src/stores/object/mod.ts",
    "./signers/dsse": "./src/signers/dsse/mod.ts",
    "./signers/sshsig": "./src/signers/sshsig/mod.ts",
    "./surfaces/headless": "./src/surfaces/headless/mod.ts"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "test": "bun test suite/",
    "test:node": "node --test \"suite/**/*.test.ts\"",
    "verify": "tsc -p tsconfig.json && bun ../tools/mizan-check.ts --root spec-kit && bun ../libraries/src/check.ts --root spec-kit --level L1 && bun tools/check.ts && bun test suite/ && bun tools/pack.ts --check",
    "pack": "bun tools/pack.ts"
  },
  "devDependencies": {
    "@intellectual-frontiers/core": "link:../core",
    "@intellectual-frontiers/crypto": "link:../crypto",
    "@intellectual-frontiers/formats": "link:../formats",
    "@intellectual-frontiers/headless": "link:../headless",
    "@intellectual-frontiers/libraries": "link:../libraries",
    "@intellectual-frontiers/mizan": "link:../mizan",
    "@intellectual-frontiers/system": "link:../system",
    "@intellectual-frontiers/terminal": "link:../terminal",
    "@intellectual-frontiers/test": "link:../test",
    "@types/node": "26.6.6",
    "fast-check": "4.10.2",
    "typescript": "7.0.2"
  }
}
