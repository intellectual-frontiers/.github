    skos:definition "An AUR helper builds and runs scripts of packages nobody reviewed with the person's rights; a harness never drives one."@en .

pmid:prohibition-yay-2 a pm:Prohibition ;
    pm:prohibitionOf pmid:manager-yay ;
    pm:forbiddenTemplate "yay -Sy" ;
    skos:definition "A refresh alone is a partial upgrade, and a harness never drives an AUR helper."@en .

pmid:cmd-yum-install a pm:Command ;
    pm:commandOf pmid:manager-yum ;
    pm:operation pm:Install ;
    pm:template "yum install {packages}" ;
    pm:nonInteractive "yum install -y {packages}" ;
    pm:origin "upt+memory" .

pmid:cmd-yum-remove a pm:Command ;
    pm:commandOf pmid:manager-yum ;
    pm:operation pm:Remove ;
    pm:template "yum remove {packages}" ;
    pm:origin "upt" .

pmid:cmd-yum-upgrade a pm:Command ;
    pm:commandOf pmid:manager-yum ;
    pm:operation pm:Upgrade ;
    pm:template "yum upgrade {packages}" ;
    pm:origin "upt" .

pmid:cmd-yum-search a pm:Command ;
