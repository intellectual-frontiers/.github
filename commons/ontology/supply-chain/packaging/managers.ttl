pmid:manager-apk a pm:PackageManager ;
    rdfs:label "apk"@en ;
    dcterms:identifier "apk" ;
    pm:executable "apk" ;
    pm:kind pm:SystemKind ;
    pm:needsAdministrator true ;
    pm:purlType "apk" .

pmid:manager-apt a pm:PackageManager ;
