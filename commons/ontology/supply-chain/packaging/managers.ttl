pmid:prohibition-pacman-1 a pm:Prohibition ;
    pm:prohibitionOf pmid:manager-pacman ;
    pm:forbiddenTemplate "pacman -Sy" ;
    skos:definition "Refreshing the package list alone leaves a rolling release partly upgraded; upgrade with -Syu, or install with -S --needed and let a missing package say the list is old."@en .

pmid:prohibition-pacman-2 a pm:Prohibition ;
    pm:prohibitionOf pmid:manager-pacman ;
    pm:forbiddenTemplate "pacman -Sy {packages}" ;
    skos:definition "Installing from a freshly refreshed list without upgrading the rest of the system is a partial upgrade."@en .

