# Rules a harness applies to its scripts, its CI and its code (commons 0004-rules): each is a pattern, a short name and the reason, in a set. A harness reads them from
# generated/rules.auto.toml and decides where to apply them; the rules do not name any harness's paths.

@prefix pm: <https://www.intellectualfrontiers.com/ontology/packaging#> .
@prefix pmid: <https://www.intellectualfrontiers.com/id/packaging/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

pmid:rule-sh-find-printf a pm:Rule ;
    pm:ruleSet "shell-portability" ;
    pm:pattern "\\bfind\\b[^|;]*-printf" ;
    rdfs:label "find -printf"@en ;
    skos:definition "BSD find has no -printf; use find with -exec stat or a shell loop"@en .

pmid:rule-sh-mv-t a pm:Rule ;
    pm:ruleSet "shell-portability" ;
    pm:pattern "\\bmv\\s+-[a-zA-Z]*T" ;
    rdfs:label "mv -T"@en ;
    skos:definition "BSD mv has no -T"@en .

pmid:rule-sh-sed-x1b a pm:Rule ;
    pm:ruleSet "shell-portability" ;
    pm:pattern "\\\\x1b" ;
    rdfs:label "sed \\x1b"@en ;
    skos:definition "BSD sed does not read \\x1b; use printf to make the byte"@en .

pmid:rule-sh-readlink-f a pm:Rule ;
    pm:ruleSet "shell-portability" ;
    pm:pattern "\\breadlink\\s+-f" ;
    rdfs:label "readlink -f"@en ;
    skos:definition "macOS readlink has no -f"@en .

pmid:rule-sh-sed-i a pm:Rule ;
    pm:ruleSet "shell-portability" ;
    pm:pattern "\\bsed\\s+-i\\b" ;
    rdfs:label "sed -i"@en ;
    skos:definition "sed -i differs between GNU and BSD"@en .

pmid:rule-sh-date-d a pm:Rule ;
    pm:ruleSet "shell-portability" ;
    pm:pattern "\\bdate\\s+-d\\b" ;
    rdfs:label "date -d"@en ;
    skos:definition "BSD date has no -d"@en .

pmid:rule-sh-grep-p a pm:Rule ;
    pm:ruleSet "shell-portability" ;
    pm:pattern "\\bgrep\\s+-[a-zA-Z]*P" ;
    rdfs:label "grep -P"@en ;
    skos:definition "BSD grep has no -P"@en .

pmid:rule-sh-stat-c a pm:Rule ;
    pm:ruleSet "shell-portability" ;
    pm:pattern "\\bstat\\s+-c" ;
    rdfs:label "stat -c"@en ;
    skos:definition "BSD stat uses -f"@en .

pmid:rule-sh-xargs-r a pm:Rule ;
    pm:ruleSet "shell-portability" ;
    pm:pattern "\\bxargs\\s+-r" ;
    rdfs:label "xargs -r"@en ;
    skos:definition "BSD xargs has no -r"@en .

pmid:rule-sh-tar-xj a pm:Rule ;
    pm:ruleSet "shell-portability" ;
    pm:pattern "\\btar\\s+-x[a-zA-Z]*J" ;
    rdfs:label "tar -xJ"@en ;
    skos:definition "name the compressor, as bsdtar and GNU tar differ"@en .

pmid:rule-sh-sed-s-i a pm:Rule ;
    pm:ruleSet "shell-portability" ;
    pm:pattern "/[gI]*I[gI]*[\\\"']" ;
    rdfs:label "sed s///I"@en ;
    skos:definition "the I flag of s is GNU only"@en .

pmid:rule-sh-ls a pm:Rule ;
    pm:ruleSet "shell-portability" ;
    pm:pattern "\\bls\\s+--" ;
    rdfs:label "ls --"@en ;
    skos:definition "long options of ls are GNU only"@en .

pmid:rule-sh-bre-alternation a pm:Rule ;
    pm:ruleSet "shell-portability" ;
    pm:pattern "\\\\\\|" ;
    rdfs:label "BRE alternation"@en ;
    skos:definition "a backslash-pipe in a basic regular expression is GNU only; use sed -E or grep -E"@en .

pmid:rule-sh-sha-sum a pm:Rule ;
    pm:ruleSet "shell-portability" ;
    pm:pattern "\\bsha(256|512)sum\\b" ;
    rdfs:label "sha*sum"@en ;
    skos:definition "macOS has shasum; use the helper that picks one"@en .

pmid:rule-sh-base64-d a pm:Rule ;
    pm:ruleSet "shell-portability" ;
    pm:pattern "\\bbase64\\s+-d" ;
    rdfs:label "base64 -d"@en ;
    skos:definition "macOS base64 uses -D in older releases"@en .

pmid:rule-sh-sort-v a pm:Rule ;
    pm:ruleSet "shell-portability" ;
    pm:pattern "\\bsort\\s+-[a-zA-Z]*V" ;
    rdfs:label "sort -V"@en ;
    skos:definition "BSD sort has no -V"@en .

pmid:rule-sh-cp-u-t a pm:Rule ;
    pm:ruleSet "shell-portability" ;
    pm:pattern "\\bcp\\s+-[a-zA-Z]*[uT]" ;
    rdfs:label "cp -u/-T"@en ;
    skos:definition "BSD cp has no -u or -T"@en .

pmid:rule-sh-ln-t a pm:Rule ;
    pm:ruleSet "shell-portability" ;
    pm:pattern "\\bln\\s+-[a-zA-Z]*T" ;
    rdfs:label "ln -T"@en ;
    skos:definition "BSD ln has no -T"@en .

pmid:rule-ci-apt-get a pm:Rule ;
    pm:ruleSet "ci-forbidden-program" ;
    pm:pattern "apt-get" ;
    rdfs:label "apt-get"@en ;
    skos:definition "a CI step does not install or fetch software, or take administrator rights, outside the launcher: the launcher fetches what it needs, pinned and checked"@en .

pmid:rule-ci-apt a pm:Rule ;
