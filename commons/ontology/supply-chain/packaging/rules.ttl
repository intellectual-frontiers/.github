pmid:rule-ci-setup-action a pm:Rule ;
    pm:ruleSet "ci-forbidden-action" ;
    pm:pattern "uses:\\s*actions/setup-(?:node|java|ruby|go|dotnet)" ;
    rdfs:label "setup-action"@en ;
    skos:definition "a CI step that installs a language with a setup action instead of the launcher"@en .

pmid:rule-ci-docker-uses a pm:Rule ;
    pm:ruleSet "ci-forbidden-action" ;
    pm:pattern "uses:\\s*docker://" ;
    rdfs:label "docker-uses"@en ;
    skos:definition "a CI step that runs in a container image"@en .

pmid:rule-ci-image-key a pm:Rule ;
    pm:ruleSet "ci-forbidden-action" ;
    pm:pattern "^\\s*(?:-\\s*)?(?:container|services|image):" ;
    rdfs:label "image-key"@en ;
    skos:definition "a CI job that runs in or beside a container image"@en .

pmid:rule-host-convert a pm:Rule ;
    pm:ruleSet "host-program" ;
    pm:pattern "convert" ;
    rdfs:label "convert"@en ;
    skos:definition "a program a harness's command must get from its own toolchain, never from whatever the host has"@en .

