@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# The programs a computer needs for a harness's setup (required) and for the everyday comfort tools (comfort), and what each family calls their packages.
# From archon-bootstrap.sh's package lists. A name left out for a family means that family needs no package for it.

pmid:prog-git a pm:Program ;
    rdfs:label "git"@en ;
    pm:programName "git" ;
    pm:tier pm:Required  ;
    pm:order 1 .

pmid:pkg-debian-git a pm:PackageName ;
    pm:forProgram pmid:prog-git ;
    pm:forFamily pmid:family-debian ;
    pm:name "git" .

pmid:pkg-arch-git a pm:PackageName ;
    pm:forProgram pmid:prog-git ;
    pm:forFamily pmid:family-arch ;
    pm:name "git" .

