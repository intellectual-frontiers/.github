@prefix pm: <https://www.intellectualfrontiers.com/ontology/packaging#> .
@prefix pmid: <https://www.intellectualfrontiers.com/id/packaging/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Seeded from the tables of sigoden/upt (https://github.com/sigoden/upt), dual-licensed MIT or Apache-2.0, copyright its authors; see tests/fixtures/upt/README.md.
# What archon (a harness) runs, and what it knows about privileges and package names, is added to it. A command with pm:origin "memory", and every needsAdministrator value,
# is written from knowledge and unverified: nothing acts on it until its family is supported and the command carries pm:verifiedOn.
# `oubes`, which upt lists with the Red Hat family, is not an os-release ID this repository recognises and is left out.

pmid:family-windows a pm:SystemFamily ;
    rdfs:label "Windows"@en ;
    dcterms:identifier "windows" ;
    pm:detectSource "platform" ;
    pm:detectedBy "windows" ;
    pm:usesManager pmid:manager-scoop ;
    pm:usesManager pmid:manager-choco ;
    pm:usesManager pmid:manager-winget ;
    pm:preferredManager pmid:manager-scoop ;
    pm:supportStatus pm:Catalogued ;
    pm:assurance pm:NoAssurance .

pmid:family-macos a pm:SystemFamily ;
    pm:unameName "Darwin" ;
    rdfs:label "macOS"@en ;
    dcterms:identifier "macos" ;
    pm:detectSource "platform" ;
    pm:detectedBy "macos" ;
    pm:usesManager pmid:manager-brew ;
    pm:usesManager pmid:manager-port ;
    pm:supportStatus pm:Supported ;
    pm:assurance pm:Untested ;
    pm:note "Written against stand-ins on Linux; no run on a Mac yet (0136-machine-bootstrap OQ-7)." ;
    pm:removalHint "delete the user in System Settings, Users & Groups, with its home folder" ;
    pm:harnessInstallsPackages false .

pmid:family-debian a pm:SystemFamily ;
    rdfs:label "Debian family"@en ;
    dcterms:identifier "debian" ;
    pm:detectSource "os-release" ;
    pm:detectedBy "ubuntu" ;
    pm:detectedBy "debian" ;
    pm:detectedBy "linuxmint" ;
    pm:detectedBy "pop" ;
    pm:detectedBy "deepin" ;
    pm:detectedBy "elementary" ;
    pm:detectedBy "kali" ;
    pm:detectedBy "raspbian" ;
    pm:detectedBy "aosc" ;
    pm:detectedBy "zorin" ;
    pm:detectedBy "antix" ;
    pm:detectedBy "devuan" ;
    pm:detectedBy "bodhi" ;
    pm:detectedBy "lxle" ;
    pm:detectedBy "sparky" ;
    pm:usesManager pmid:manager-apt ;
    pm:preferredManager pmid:manager-apt ;
    pm:supportStatus pm:Supported ;
    pm:assurance pm:Verified ;
    pm:note "Debian is verified on Debian 13 under WSL 2. Ubuntu and Debian 12 are exercised by the container tests only." ;
    pm:removalHint "sudo deluser --remove-home NAME" ;
    pm:verifiedOn "Debian 13 under WSL 2, by archon-bootstrap.sh and archon update, 2026-10-16" ;
    pm:adminInstall "apt-get install -y {packages}" ;
    pm:harnessInstallsPackages true .

pmid:family-redhat a pm:SystemFamily ;
    rdfs:label "Red Hat family"@en ;
    dcterms:identifier "redhat" ;
    pm:detectSource "os-release" ;
    pm:detectedBy "fedora" ;
    pm:detectedBy "redhat" ;
    pm:detectedBy "rhel" ;
    pm:detectedBy "amzn" ;
    pm:detectedBy "ol" ;
    pm:detectedBy "almalinux" ;
    pm:detectedBy "rocky" ;
    pm:detectedBy "centos" ;
    pm:detectedBy "qubes" ;
    pm:detectedBy "eurolinux" ;
    pm:usesManager pmid:manager-dnf ;
    pm:usesManager pmid:manager-yum ;
    pm:preferredManager pmid:manager-dnf ;
    pm:supportStatus pm:Catalogued ;
    pm:assurance pm:NoAssurance .

pmid:family-arch a pm:SystemFamily ;
    rdfs:label "Arch family"@en ;
    dcterms:identifier "arch" ;
    pm:detectSource "os-release" ;
    pm:detectedBy "arch" ;
    pm:detectedBy "manjaro" ;
    pm:detectedBy "endeavouros" ;
    pm:detectedBy "arcolinux" ;
    pm:detectedBy "garuda" ;
    pm:detectedBy "antergos" ;
    pm:detectedBy "kaos" ;
    pm:usesManager pmid:manager-pacman ;
    pm:preferredManager pmid:manager-pacman ;
    pm:supportStatus pm:Supported ;
    pm:assurance pm:StandIn ;
    pm:note "Arch Linux is exercised in a container with stand-ins for pacman; Omarchy (ID_LIKE=arch) is untested (0136-machine-bootstrap OQ-6)." ;
    pm:removalHint "sudo userdel -r NAME" ;
    pm:adminInstall "pacman -S --needed {packages}" ;
    pm:harnessInstallsPackages true .

