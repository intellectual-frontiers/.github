{
  "name": "@intellectual-frontiers/commons",
  "private": true,
  "version": "0.4.0",
  "description": "Every library of commons as one package (single distribution), or the metapackage of the set (per-library distribution): the folder that packs it.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": "./index.js"
  },
  "scripts": {
    "verify": "bun ../libraries/src/pack-metapackage.ts --check && bun ../libraries/src/pack-commons.ts --repo ../.. --tools --check && bun tools/pack.ts --check",
    "pack": "bun tools/pack.ts"
  },
  "devDependencies": {
    "@duckdb/node-api": "2.0.0-r.1",
    "@electric-sql/pglite": "0.5.16",
    "@intellectual-frontiers/libraries": "link:../libraries",
    "@intellectual-frontiers/system": "link:../system",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "beautiful-mermaid": "1.1.3",
    "pg": "8.23.1",
    "shiki": "4.5.0",
    "typescript": "7.1.0-beta"
  }
}
