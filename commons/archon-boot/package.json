{
  "name": "@intellectual-frontiers/archon-boot",
  "private": true,
  "version": "0.1.0",
  "description": "The plugin of archon for the network install of a blank machine: prepare, arm, disarm, status and serve.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": "./src/mod.ts"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "test": "bun test suite/",
    "test:node": "node --test \"suite/**/*.test.ts\"",
    "verify": "tsc -p tsconfig.json && bun ../tools/mizan-check.ts --root spec-kit && bun ../libraries/src/check.ts --root spec-kit --level L1 && bun ../kanon/src/check.ts && bun tools/check.ts && bun test suite/ && bun tools/pack.ts --check",
    "pack": "bun tools/pack.ts"
  },
  "devDependencies": {
    "@intellectual-frontiers/archon": "link:../archon",
    "@intellectual-frontiers/core": "link:../core",
    "@intellectual-frontiers/crypto": "link:../crypto",
    "@intellectual-frontiers/headless": "link:../headless",
    "@intellectual-frontiers/kanon": "link:../kanon",
    "@intellectual-frontiers/libraries": "link:../libraries",
    "@intellectual-frontiers/mizan": "link:../mizan",
    "@intellectual-frontiers/archon-dialect-ansible": "link:../archon-dialect-ansible",
    "@intellectual-frontiers/lab": "link:../lab",
    "@intellectual-frontiers/archon-dialect-cloud-init": "link:../archon-dialect-cloud-init",
    "@intellectual-frontiers/netboot": "link:../netboot",
    "@intellectual-frontiers/system": "link:../system",
    "@intellectual-frontiers/terminal": "link:../terminal",
    "@intellectual-frontiers/test": "link:../test",
    "@types/node": "26.6.6",
    "fast-check": "4.10.2",
    "typescript": "7.0.2"
  }
}
