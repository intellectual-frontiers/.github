{
  "name": "@intellectual-frontiers/ergonex",
  "private": true,
  "version": "0.4.1",
  "description": "Ergonex, the workspaces management of Intellectual Frontiers: one command that sets up, configures and operates a team's software repositories, package registries and builds, on Windows, macOS and Linux, with Bun by default and Node 26 as the backup.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "ergonex": "./bin/ergonex.mjs"
  },
  "exports": {
    ".": "./src/mod.ts"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "test": "bun test suite/",
    "test:node": "node --test \"suite/**/*.test.ts\"",
    "verify": "tsc -p tsconfig.json && bun ../tools/mizan-check.ts --root spec-kit && bun ../libraries/src/check.ts --root spec-kit --level L1 && bun tools/check.ts && bun tools/generate-installers.ts --check && bun test suite/",
    "pack": "bun tools/pack.ts"
  },
  "devDependencies": {
    "@intellectual-frontiers/commons": "link:../ts",
    "@intellectual-frontiers/core": "link:../core",
    "@intellectual-frontiers/crypto": "link:../crypto",
    "@intellectual-frontiers/formats": "link:../formats",
    "@intellectual-frontiers/githost": "link:../githost",
    "@intellectual-frontiers/headless": "link:../headless",
    "@intellectual-frontiers/libraries": "link:../libraries",
    "@intellectual-frontiers/mizan": "link:../mizan",
    "@intellectual-frontiers/net": "link:../net",
    "@intellectual-frontiers/quality": "link:../quality",
    "@intellectual-frontiers/system": "link:../system",
    "@intellectual-frontiers/telemetry": "link:../telemetry",
    "@intellectual-frontiers/terminal": "link:../terminal",
    "@intellectual-frontiers/test": "link:../test",
    "@types/node": "26.6.6",
    "fast-check": "4.10.2",
    "typescript": "7.0.2"
  }
}
