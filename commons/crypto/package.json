{
  "name": "@intellectual-frontiers/crypto",
  "private": true,
  "version": "0.2.2",
  "description": "Crypto: SHA-256, MD5, SHA-512 crypt, UUIDs, AWS Signature Version 4, CMS, DSSE, COSE and WebAuthn, in pure code on Web Crypto, with core and formats as its dependencies.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": "./src/mod.ts",
    "./cms": "./src/cms.ts",
    "./cose": "./src/cose.ts",
    "./crypt": "./src/crypt.ts",
    "./dsse": "./src/dsse.ts",
    "./md5": "./src/md5.ts",
    "./sha256": "./src/sha256.ts",
    "./sigv4": "./src/sigv4.ts",
    "./uuid": "./src/uuid.ts",
    "./webauthn": "./src/webauthn.ts"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "test": "bun test suite/",
    "test:node": "node --test \"suite/**/*.test.ts\"",
    "verify": "tsc -p tsconfig.json && bun ../tools/mizan-check.ts --root spec-kit && bun ../libraries/src/check.ts --root spec-kit --level L1 && bun tools/check.ts && bun test suite/ && bun tools/pack.ts --check",
    "pack": "bun tools/pack.ts"
  },
  "devDependencies": {
    "@intellectual-frontiers/core": "link:../core",
    "@intellectual-frontiers/formats": "link:../formats",
    "@intellectual-frontiers/libraries": "link:../libraries",
    "@intellectual-frontiers/mizan": "link:../mizan",
    "@intellectual-frontiers/system": "link:../system",
    "@intellectual-frontiers/test": "link:../test",
    "@types/node": "26.6.6",
    "fast-check": "4.10.2",
    "typescript": "7.0.2"
  }
}
