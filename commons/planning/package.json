{
  "name": "@intellectual-frontiers/planning",
  "private": true,
  "version": "0.1.0",
  "description": "Planning content from many places as one item each with one stable id, its history as append-only events and its state a fold of them, with every act of an agent made on behalf of a person; sources are lenses over the places, and a write goes back in the place's own form.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": "./src/mod.ts",
    "./governance": "./src/governance/mod.ts",
    "./logical": "./src/logical/mod.ts",
    "./records": "./src/logical/records/mod.ts",
    "./physical": "./src/physical/mod.ts"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "test": "bun test suite/",
    "test:node": "node --test \"suite/**/*.test.ts\"",
    "verify": "tsc -p tsconfig.json && bun ../tools/mizan-check.ts --root spec-kit && bun ../libraries/src/check.ts --root spec-kit --level L1 && bun ../kanon/src/check.ts && bun tools/check.ts && bun test suite/ && bun tools/pack.ts --check",
    "pack": "bun tools/pack.ts"
  },
  "devDependencies": {
    "@intellectual-frontiers/anyfs": "link:../anyfs",
    "@intellectual-frontiers/anyfs-sql": "link:../anyfs-sql",
    "@intellectual-frontiers/core": "link:../core",
    "@intellectual-frontiers/crypto": "link:../crypto",
    "@intellectual-frontiers/evidence-capture": "link:../evidence-capture",
    "@intellectual-frontiers/formats": "link:../formats",
    "@intellectual-frontiers/githost": "link:../githost",
    "@intellectual-frontiers/kanon": "link:../kanon",
    "@intellectual-frontiers/libraries": "link:../libraries",
    "@intellectual-frontiers/mizan": "link:../mizan",
    "@intellectual-frontiers/ontology": "link:../ontology",
    "@intellectual-frontiers/system": "link:../system",
    "@intellectual-frontiers/test": "link:../test",
    "@types/node": "26.6.6",
    "fast-check": "4.10.2",
    "typescript": "7.0.2"
  }
}
