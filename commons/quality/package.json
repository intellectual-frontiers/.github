{
  "name": "@intellectual-frontiers/quality",
  "private": true,
  "version": "0.1.1",
  "description": "The quality system of Intellectual Frontiers: the run of a suite of tests as evidence (the record, its reports and its ledger entry), the canonical record of a run and its renderings (JUnit, CTRF, SARIF, TAP, the documents of ISO/IEC/IEEE 29119-3), the append-only quality branch with its notes, the evidence ladder, freshness, nonconformances and CAPA, objectives, the tiers, and the Trust page and the signed assessor pack made from the evidence; the same code on Bun and Node 26.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": "./src/mod.ts",
    "./assessor/host": "./src/assessor/host.ts",
    "./assessor/pack": "./src/assessor/pack.ts",
    "./assessor/verify": "./src/assessor/verify.ts",
    "./assessor/verify-pack": "./src/assessor/verify-pack.ts",
    "./attestation/agents": "./src/attestation/agents.ts",
    "./attestation/host": "./src/attestation/host.ts",
    "./attestation/mutation": "./src/attestation/mutation.ts",
    "./attestation/plan": "./src/attestation/plan.ts",
    "./attestation/rules": "./src/attestation/rules.ts",
    "./attestation/sample": "./src/attestation/sample.ts",
    "./commands": "./src/commands.ts",
    "./host/archive": "./src/host/archive.ts",
    "./host/branch": "./src/host/branch.ts",
    "./host/declaration": "./src/host/declaration.ts",
    "./host/gather": "./src/host/gather.ts",
    "./host/git": "./src/host/git.ts",
    "./host/ledger-branch": "./src/host/ledger-branch.ts",
    "./host/report": "./src/host/report.ts",
    "./host/test-run": "./src/host/test-run.ts",
    "./pure/chain": "./src/pure/chain.ts",
    "./pure/chain-files": "./src/pure/chain-files.ts",
    "./pure/freshness": "./src/pure/freshness.ts",
    "./pure/index-file": "./src/pure/index-file.ts",
    "./pure/ladder": "./src/pure/ladder.ts",
    "./pure/ledger": "./src/pure/ledger.ts",
    "./pure/names": "./src/pure/names.ts",
    "./pure/objectives": "./src/pure/objectives.ts",
    "./pure/record": "./src/pure/record.ts",
    "./pure/render": "./src/pure/render.ts",
    "./pure/retention": "./src/pure/retention.ts",
    "./pure/tier": "./src/pure/tier.ts",
    "./pure/tier2-events": "./src/pure/tier2-events.ts",
    "./pure/time": "./src/pure/time.ts",
    "./quality": "./src/quality.ts",
    "./test-cli": "./src/test-cli.ts",
    "./test-report": "./src/test-report.ts",
    "./tier2-commands": "./src/tier2-commands.ts",
    "./trust/audience": "./src/trust/audience.ts",
    "./trust/host": "./src/trust/host.ts",
    "./trust/html": "./src/trust/html.ts",
    "./trust/requirement-text": "./src/trust/requirement-text.ts",
    "./trust/view": "./src/trust/view.ts"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "test": "bun test suite/",
    "test:node": "node --test \"suite/**/*.test.ts\"",
    "verify": "tsc -p tsconfig.json && bun ../tools/mizan-check.ts --root spec-kit && bun ../ts/mizan/check.ts --root spec-kit --level L1 && bun tools/check.ts && bun test suite/ && bun tools/pack.ts --check",
    "pack": "bun tools/pack.ts"
  },
  "devDependencies": {
    "@intellectual-frontiers/commons": "link:../ts",
    "@intellectual-frontiers/core": "link:../core",
    "@intellectual-frontiers/crypto": "link:../crypto",
    "@intellectual-frontiers/formats": "link:../formats",
    "@intellectual-frontiers/grc": "link:../grc",
    "@intellectual-frontiers/mizan": "link:../mizan",
    "@intellectual-frontiers/ontology": "link:../ontology",
    "@intellectual-frontiers/system": "link:../system",
    "@intellectual-frontiers/telemetry": "link:../telemetry",
    "@intellectual-frontiers/terminal": "link:../terminal",
    "@intellectual-frontiers/test": "link:../test",
    "@types/node": "26.6.6",
    "fast-check": "4.10.2",
    "typescript": "7.0.2"
  }
}
