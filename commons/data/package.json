{
  "name": "@intellectual-frontiers/data",
  "private": true,
  "version": "0.0.0",
  "description": "Intellectual Frontiers data: governance, a logical and a physical schema, and extensions, built on IFC TypeScript's kernel. Phase 0 spike.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "exports": {
    "./engine": "./engine/api.ts",
    "./governance": "./governance/api.ts",
    "./sql/logical": "./sql/logical/api.ts",
    "./sql/physical": "./sql/physical/api.ts",
    "./issues": "./issues/mod.ts",
    "./models/issues": "./models/issues/mod.ts",
    "./sql/extensions/issues": "./sql/extensions/issues/mod.ts",
    "./models/arca-tenancy": "./models/arca-tenancy/mod.ts",
    "./models/arca": "./models/arca/mod.ts",
    "./models/identity": "./models/identity/mod.ts",
    "./models/identity-access": "./models/identity-access/mod.ts",
    "./models/identity-abac": "./models/identity-abac/mod.ts",
    "./models/identity-rebac": "./models/identity-rebac/mod.ts",
    "./models/identity-pki": "./models/identity-pki/mod.ts",
    "./models/identity-machine": "./models/identity-machine/mod.ts",
    "./models/identity-device": "./models/identity-device/mod.ts",
    "./models/identity-delegation": "./models/identity-delegation/mod.ts",
    "./models/identity-agent": "./models/identity-agent/mod.ts",
    "./sql/dialects/postgres": "./sql/dialects/postgres/mod.ts",
    "./sql/dialects/sqlite": "./sql/dialects/sqlite/mod.ts",
    "./sql/dialects/duckdb": "./sql/dialects/duckdb/mod.ts",
    "./sql/lifecycle": "./sql/lifecycle/api.ts",
    "./sql/extensions/documentation": "./sql/extensions/documentation/mod.ts",
    "./sql/extensions/views": "./sql/extensions/views/mod.ts",
    "./sql/extensions/access": "./sql/extensions/access/mod.ts",
    "./sql/extensions/routines": "./sql/extensions/routines/mod.ts",
    "./sql/extensions/partitions": "./sql/extensions/partitions/mod.ts",
    "./sql/extensions/generators": "./sql/extensions/generators/mod.ts",
    "./sql/extensions/idempotency": "./sql/extensions/idempotency/mod.ts",
    "./sql/extensions/protected-access": "./sql/extensions/protected-access/mod.ts",
    "./sql/extensions/safety": "./sql/extensions/safety/mod.ts",
    "./sql/extensions/plan-report": "./sql/extensions/plan-report/mod.ts",
    "./sql/extensions/rewrite": "./sql/extensions/rewrite/mod.ts",
    "./sql/extensions/history": "./sql/extensions/history/mod.ts",
    "./sql/extensions/convergence": "./sql/extensions/convergence/mod.ts",
    "./sql/extensions/rollout": "./sql/extensions/rollout/mod.ts",
    "./sql/extensions/integrations": "./sql/extensions/integrations/mod.ts",
    "./sql/extensions/transforms": "./sql/extensions/transforms/mod.ts",
    "./sql/extensions/queries": "./sql/extensions/queries/mod.ts",
    "./sql/extensions/target": "./sql/extensions/target/mod.ts",
    "./sql/extensions/kinds": "./sql/extensions/kinds/mod.ts",
    "./sql/extensions/osquery-atc": "./sql/extensions/osquery-atc/mod.ts",
    "./sql/extensions/operations": "./sql/extensions/operations/mod.ts",
    "./sql/extensions/invariants": "./sql/extensions/invariants/mod.ts",
    "./sql/presets": "./sql/presets/mod.ts"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "test": "bun test suite/",
    "test:node": "node --test \"suite/**/*.test.ts\"",
    "verify": "tsc -p tsconfig.json && bun ../tools/mizan-check.ts --root spec-kit && bun ../ts/mizan/check.ts --root spec-kit --level L1 && bun tools/check.ts && bun test suite/",
    "check:layers": "bun tools/check.ts"
  },
  "devDependencies": {
    "@duckdb/node-api": "2.0.0-r.1",
    "@electric-sql/pglite": "0.5.16",
    "@intellectual-frontiers/commons": "link:../ts",
    "@types/node": "26.6.6",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "zod": "4.1.12"
  }
}
