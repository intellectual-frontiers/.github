# Source this file; do not run it:   . acceptance/arcactl-pg/bin/env     (from commons/data)
#
# It gives your shell what the UAT needs, and nothing else:
#   - UAT_DIR       where the kit is
#   - arcactl       a shell function that runs arcactl from this checkout (no install needed)
#   - UAT_PASSWORD, ARCA_SEAL_KEY, ARCA_UNLOCK_SECRET
#                   three secrets, made once into acceptance/arcactl-pg/.env.uat (not committed; UAT_ENV_FILE names another file) and read from there afterwards
# It never touches your database. Which database you use is yours to say with libpq's variables (PGHOST, PGPORT, PGUSER,
# PGDATABASE, PGSERVICE) or a connection URL in ARCA_DATABASE_URL; see the README, step 2.

UAT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-${(%):-%x}}")/.." && pwd)"
export UAT_DIR
UAT_DATA="$(cd "$UAT_DIR/../.." && pwd)"
export UAT_DATA

arcactl() { bun "$UAT_DATA/sql/cli/arcactl.ts" "$@"; }

UAT_ENV_FILE="${UAT_ENV_FILE:-$UAT_DIR/.env.uat}"
if [ ! -f "$UAT_ENV_FILE" ]; then
  secret() { od -An -N16 -tx1 /dev/urandom | tr -d ' \n'; }
  umask 077
  {
    echo "UAT_PASSWORD=uat-$(secret)"
    echo "ARCA_SEAL_KEY=seal-$(secret)"
    echo "ARCA_UNLOCK_SECRET=unlock-$(secret)"
  } > "$UAT_ENV_FILE"
  echo "uat: made $UAT_ENV_FILE with three new secrets (it is not committed; delete it to make new ones)" >&2
fi
set -a
# shellcheck disable=SC1091
. "$UAT_ENV_FILE"
set +a
