#!/usr/bin/env bash
# Opens psql as one of the UAT's people, with a scope already set:
#
#   bin/psql-as uat_reader  --tenant acme
#   bin/psql-as uat_writer  --subtree northwind       (a reseller and the tenants beneath it)
#   bin/psql-as uat_operator --all                    (the platform operator)
#   bin/psql-as uat_reader                            (no scope: you will see no rows)
#
# (-U, not PGUSER: a service in pg_service.conf, which arcactl init writes, wins over the variables.)
# The scope is made by arcactl scope, from the seal's key, and set for the session by a psqlrc file that is deleted when psql ends.
set -euo pipefail
. "$(dirname "$0")/env"
cd "$UAT_DATA"
role="${1:?which role? uat_reader, uat_writer, uat_support or uat_operator}"
shift
rc="$(mktemp)"
trap 'rm -f "$rc"' EXIT
{
  echo '\set QUIET on'
  # the statement's own result (the scope and its mark) is not shown
  if [ "$#" -gt 0 ]; then echo '\o /dev/null'; arcactl scope "$@" 2>/dev/null; echo '\o'; fi
  echo '\pset null (null)'
  echo '\set QUIET off'
  echo "\\echo 'You are $role.${*:+ Scope: $*.} Try: SELECT * FROM api.customer_account;'"
} > "$rc"
PGPASSWORD="$UAT_PASSWORD" PSQLRC="$rc" exec psql -U "$role"
