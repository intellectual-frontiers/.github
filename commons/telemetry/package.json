{
  "name": "@intellectual-frontiers/telemetry",
  "private": true,
  "version": "0.2.7",
  "description": "OpenTelemetry-native signals for TypeScript, written from the specification itself with no OpenTelemetry package: the data model, W3C Trace Context, OTLP/HTTP JSON, typed signals, a pure renderer of the console, and a host that exports, journals and shows them; the same code on Bun and Node 26.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": "./src/mod.ts",
    "./otel": "./src/logical/otel.ts",
    "./otlp": "./src/logical/otlp.ts",
    "./signals": "./src/logical/signals.ts",
    "./semconv": "./src/governance/semconv.ts",
    "./queue": "./src/logical/queue.ts",
    "./envelope": "./src/logical/envelope.ts",
    "./limits": "./src/logical/limits.ts",
    "./retention": "./src/logical/retention.ts",
    "./syslog": "./src/logical/syslog.ts",
    "./exporter": "./src/logical/exporter.ts",
    "./query": "./src/logical/query.ts",
    "./host/query": "./src/physical/query.ts",
    "./render": "./src/logical/render.ts",
    "./host": "./src/physical/mod.ts",
    "./host/otel": "./src/physical/otel.ts",
    "./host/console": "./src/physical/console.ts",
    "./host/relay": "./src/physical/relay.ts"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "test": "bun test suite/",
    "test:node": "node --test \"suite/**/*.test.ts\"",
    "verify": "tsc -p tsconfig.json && bun ../tools/mizan-check.ts --root spec-kit && bun ../libraries/src/check.ts --root spec-kit --level L1 && bun ../kanon/src/check.ts && bun tools/check.ts && bun test suite/ && bun tools/pack.ts --check",
    "pack": "bun tools/pack.ts"
  },
  "devDependencies": {
    "@intellectual-frontiers/core": "link:../core",
    "@intellectual-frontiers/crypto": "link:../crypto",
    "@intellectual-frontiers/formats": "link:../formats",
    "@intellectual-frontiers/kanon": "link:../kanon",
    "@intellectual-frontiers/lang-sql": "link:../lang-sql",
    "@intellectual-frontiers/libraries": "link:../libraries",
    "@intellectual-frontiers/mizan": "link:../mizan",
    "@intellectual-frontiers/system": "link:../system",
    "@intellectual-frontiers/terminal": "link:../terminal",
    "@intellectual-frontiers/test": "link:../test",
    "@types/node": "26.6.6",
    "fast-check": "4.10.2",
    "typescript": "7.0.2"
  }
}
