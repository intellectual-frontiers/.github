{
  "$description": "frontiers-brand's design tokens in the Design Tokens Community Group format (0014-design-systems FR-036): the palette (primitive tokens), the theme roles every brand supplies (FR-037) plus the roles frontiers-nature-web requires, and, under $extensions, the logo files. brand.css declares the roles as --brand-* custom properties.",
  "color": {
    "$type": "color",
    "deep-ink": {
      "$value": "#121820"
    },
    "frontier-blue": {
      "$value": "#214ea2"
    },
    "signal-teal": {
      "$value": "#1f7775"
    },
    "editorial-oxblood": {
      "$value": "#8a3147"
    },
    "warm-paper": {
      "$value": "#f3f0e8"
    },
    "white": {
      "$value": "#ffffff"
    },
    "amber": {
      "$value": "#8a5a24"
    },
    "violet": {
      "$value": "#4a4a8c"
    }
  },
  "unit": {
    "$type": "color",
    "capital": {
      "$value": "{color.frontier-blue}"
    },
    "ip": {
      "$value": "{color.deep-ink}"
    },
    "press": {
      "$value": "{color.editorial-oxblood}"
    },
    "studios": {
      "$value": "{color.signal-teal}"
    },
    "network": {
      "$value": "{color.violet}"
    }
  },
  "typeface": {
    "$type": "fontFamily",
    "sans": {
      "$value": "Inter"
    },
    "serif": {
      "$value": "Source Serif 4"
    },
    "wordmark-weight": {
      "$type": "fontWeight",
      "$value": 700
    }
  },
  "role": {
    "text": {
      "$type": "color",
      "$value": "{color.deep-ink}"
    },
    "surface": {
      "$type": "color",
      "$value": "{color.white}"
    },
    "primary": {
      "$type": "color",
      "$value": "{color.frontier-blue}"
    },
    "secondary": {
      "$type": "color",
      "$value": "{color.signal-teal}"
    },
    "tertiary": {
      "$type": "color",
      "$value": "{color.editorial-oxblood}"
    },
    "success": {
      "$type": "color",
      "$value": "{color.signal-teal}"
    },
    "warning": {
      "$type": "color",
      "$value": "{color.amber}"
    },
    "danger": {
      "$type": "color",
      "$value": "{color.editorial-oxblood}"
    },
    "info": {
      "$type": "color",
      "$value": "{color.violet}"
    },
    "accent": {
      "$type": "color",
      "$value": "{color.editorial-oxblood}"
    },
    "link": {
      "$type": "color",
      "$value": "{color.frontier-blue}"
    },
    "font-sans": {
      "$type": "fontFamily",
      "$value": "{typeface.sans}"
    },
    "font-serif": {
      "$type": "fontFamily",
      "$value": "{typeface.serif}"
    },
    "paper": {
      "$type": "color",
      "$value": "{color.warm-paper}"
    },
    "unit-capital": {
      "$type": "color",
      "$value": "{unit.capital}"
    },
    "unit-ip": {
      "$type": "color",
      "$value": "{unit.ip}"
    },
    "unit-press": {
      "$type": "color",
      "$value": "{unit.press}"
    },
    "unit-studios": {
      "$type": "color",
      "$value": "{unit.studios}"
    },
    "unit-network": {
      "$type": "color",
      "$value": "{unit.network}"
    }
  },
