{
  "$description": "frontiers-nature-web's semantic tokens in the Design Tokens Community Group format, one per custom property on :root in css/tokens.css (the source), in the same order. {role.*} aliases resolve against the theme's tokens.json (0014-design-systems FR-036, FR-038).",
  "tokens": {
    "--ink": {
      "$type": "color",
      "$value": "{role.text}"
    },
    "--paper": {
      "$type": "color",
      "$value": "{role.paper}"
    },
    "--stone": {
      "$type": "color",
      "$value": "color-mix(in srgb, {role.text} 2%, {role.paper})"
    },
    "--shell": {
      "$type": "color",
      "$value": "color-mix(in srgb, {role.text} 5%, {role.surface})"
    },
    "--rule": {
      "$type": "color",
      "$value": "color-mix(in srgb, {role.text} 8%, {role.paper})"
    },
    "--background": {
      "$type": "color",
      "$value": "{role.surface}"
    },
    "--foreground": {
      "$value": "var(--ink)"
    },
    "--muted-foreground": {
      "$type": "color",
      "$value": "color-mix(in srgb, {role.text} 72%, {role.surface})"
    },
    "--capital": {
      "$type": "color",
      "$value": "{role.unit-capital}"
    },
    "--ip": {
      "$type": "color",
      "$value": "{role.unit-ip}"
    },
    "--press": {
      "$type": "color",
      "$value": "{role.unit-press}"
    },
    "--studios": {
      "$type": "color",
      "$value": "{role.unit-studios}"
    },
    "--network": {
      "$type": "color",
      "$value": "{role.unit-network}"
    },
    "--diagram-ink": {
      "$type": "color",
      "$value": "{role.text}"
    },
    "--diagram-path": {
      "$type": "color",
      "$value": "{role.primary}"
    },
    "--diagram-warning": {
      "$type": "color",
      "$value": "{role.danger}"
    },
    "--diagram-positive": {
      "$type": "color",
      "$value": "{role.success}"
    },
    "--diagram-caution": {
      "$type": "color",
      "$value": "{role.warning}"
    },
    "--diagram-secondary": {
      "$type": "color",
      "$value": "{role.info}"
    },
    "--font-sans": {
      "$type": "fontFamily",
      "$value": "{role.font-sans}, \"Helvetica Neue\", Arial, sans-serif"
    },
    "--font-serif": {
      "$type": "fontFamily",
      "$value": "{role.font-serif}, \"Charter\", \"Bitstream Charter\", Georgia, serif"
    },
    "--font-mono": {
      "$type": "fontFamily",
      "$value": "\"IBM Plex Mono\", \"SFMono-Regular\", Consolas, monospace"
    },
    "--measure-page": {
      "$type": "dimension",
      "$value": "72rem"
    },
    "--gutter": {
      "$type": "dimension",
      "$value": "1.5rem"
    },
    "--radius": {
      "$type": "dimension",
      "$value": "0"
    },
    "--chrome-clearance": {
      "$type": "dimension",
      "$value": "8.5rem"
    },
    "--ease": {
      "$value": "cubic-bezier(0.4, 0, 0.2, 1)"
    },
    "--fast": {
      "$type": "duration",
      "$value": "150ms"
    }
  }
}
