    "discussion": {"max_minutes": 20}
  },
  "item_types": ["multiple-choice", "multiple-response", "numeric", "text-match"],
  "outcomes": [3, 8],
  "lessons_per_unit": [1, 8],
  "choices": [3, 5],
  "minutes_tolerance": 0.3,
  "minutes_slack": 2,
  "week_effort": [0.5, 1.15],
  "verbs": [
    "analyze", "apply", "argue", "assess", "calculate", "choose", "classify", "compare", "compute", "construct",
    "contrast", "convert", "create", "critique", "define", "demonstrate", "derive", "describe", "design", "diagram",
    "differentiate", "distinguish", "draft", "estimate", "evaluate", "explain", "formulate", "identify", "implement",
    "interpret", "judge", "justify", "list", "map", "measure", "model", "name", "organize", "plan", "predict",
    "prioritize", "produce", "rank", "recall", "recommend", "select", "sketch", "solve", "state", "summarize", "test",
    "trace", "translate", "use", "write"
  ],
