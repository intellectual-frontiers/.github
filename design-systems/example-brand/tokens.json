{
  "$description": "example-brand's design tokens in the Design Tokens Community Group format: a deliberately different identity that proves a web design system can be themed by a brand other than frontiers-brand (0014-design-systems FR-039). It supplies every theme role (FR-037) and the roles frontiers-nature-web requires.",
  "color": {
    "$type": "color",
    "ink": {
      "$value": "#1f1a24"
    },
    "violet": {
      "$value": "#6b2fa3"
    },
    "pine": {
      "$value": "#0b6e4f"
    },
    "rust": {
      "$value": "#a23b12"
    },
    "ochre": {
      "$value": "#8a5300"
    },
    "crimson": {
      "$value": "#b3261e"
    },
    "cobalt": {
      "$value": "#1f5fa8"
    },
    "lavender": {
      "$value": "#f6f3fb"
    },
    "white": {
      "$value": "#ffffff"
    }
  },
  "typeface": {
    "$type": "fontFamily",
    "sans": {
      "$value": "Inter"
    },
    "serif": {
      "$value": "Source Serif 4"
    }
  },
  "role": {
    "text": {
      "$type": "color",
      "$value": "{color.ink}"
    },
    "surface": {
      "$type": "color",
      "$value": "{color.white}"
    },
    "primary": {
      "$type": "color",
      "$value": "{color.violet}"
    },
    "secondary": {
      "$type": "color",
      "$value": "{color.pine}"
    },
    "tertiary": {
      "$type": "color",
      "$value": "{color.rust}"
    },
    "success": {
      "$type": "color",
      "$value": "{color.pine}"
    },
    "warning": {
      "$type": "color",
      "$value": "{color.ochre}"
    },
    "danger": {
      "$type": "color",
      "$value": "{color.crimson}"
    },
    "info": {
      "$type": "color",
      "$value": "{color.cobalt}"
    },
    "font-sans": {
      "$type": "fontFamily",
      "$value": "{typeface.sans}"
    },
    "font-serif": {
      "$type": "fontFamily",
      "$value": "{typeface.serif}"
    },
    "paper": {
      "$type": "color",
      "$value": "{color.lavender}"
    },
    "unit-capital": {
      "$type": "color",
      "$value": "{color.cobalt}"
    },
    "unit-ip": {
      "$type": "color",
      "$value": "{color.ink}"
    },
    "unit-press": {
      "$type": "color",
      "$value": "{color.rust}"
    },
    "unit-studios": {
      "$type": "color",
      "$value": "{color.pine}"
    },
    "unit-network": {
      "$type": "color",
      "$value": "{color.violet}"
    }
  },
  "$extensions": {
    "com.intellectualfrontiers.logo": {
      "lockup": {
        "min-width-px": 100,
        "files": [
          {
            "file": "logos/example-160x40.png",
            "width": 160,
            "height": 40,
            "background": "light"
          },
          {
            "file": "logos/web/example-160x40.webp",
            "width": 160,
            "height": 40,
            "background": "light"
          },
          {
            "file": "logos/example-dark-160x40.png",
            "width": 160,
            "height": 40,
            "background": "dark"
          },
          {
            "file": "logos/web/example-dark-160x40.webp",
            "width": 160,
            "height": 40,
            "background": "dark"
          },
          {
            "file": "logos/example-320x80.png",
            "width": 320,
            "height": 80,
            "background": "light"
          },
          {
            "file": "logos/web/example-320x80.webp",
            "width": 320,
            "height": 80,
            "background": "light"
          },
          {
            "file": "logos/example-dark-320x80.png",
            "width": 320,
            "height": 80,
            "background": "dark"
          },
          {
            "file": "logos/web/example-dark-320x80.webp",
            "width": 320,
            "height": 80,
            "background": "dark"
          }
        ]
      },
      "icon": {
        "min-width-px": 50,
        "files": [
          {
            "file": "logos/example-icon-128x128.png",
            "width": 128,
            "height": 128
          }
        ]
      },
      "favicon": {
        "file": "images/favicon.png",
        "width": 64,
        "height": 64
      }
    }
  }
}
