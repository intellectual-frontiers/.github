{
  "$description": "frontiers-console-web's semantic tokens in the Design Tokens Community Group format, one per custom property on :root in css/tokens.css (the source), in the same order. {role.*} aliases resolve against the theme's tokens.json (0014-design-systems FR-036, FR-038).",
  "tokens": {
    "--fc-background": {
      "$type": "color",
      "$value": "{role.surface}"
    },
    "--fc-foreground": {
      "$type": "color",
      "$value": "{role.text}"
    },
    "--fc-muted": {
      "$type": "color",
      "$value": "#f4f4f2"
    },
    "--fc-muted-foreground": {
      "$type": "color",
      "$value": "#5b6270"
    },
    "--fc-card": {
      "$type": "color",
      "$value": "#f8f7f4"
    },
    "--fc-popover": {
      "$type": "color",
      "$value": "{role.surface}"
    },
    "--fc-border": {
      "$type": "color",
      "$value": "#e2e0da"
    },
    "--fc-border-strong": {
      "$type": "color",
      "$value": "#c9c6bd"
    },
    "--fc-input-border": {
      "$type": "color",
      "$value": "#8a8f99"
    },
    "--fc-accent": {
      "$type": "color",
      "$value": "#eeece5"
    },
    "--fc-accent-foreground": {
      "$type": "color",
      "$value": "{role.text}"
    },
    "--fc-primary": {
      "$type": "color",
      "$value": "{role.primary}"
    },
    "--fc-primary-foreground": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "--fc-primary-tint": {
      "$value": "color-mix(in srgb, {role.primary} 10%, {role.surface})"
    },
    "--fc-ring": {
      "$type": "color",
      "$value": "{role.primary}"
    },
    "--fc-success": {
      "$type": "color",
      "$value": "{role.success}"
    },
    "--fc-success-tint": {
      "$value": "color-mix(in srgb, {role.success} 12%, {role.surface})"
    },
    "--fc-warning": {
      "$type": "color",
      "$value": "{role.warning}"
    },
    "--fc-warning-tint": {
      "$value": "color-mix(in srgb, {role.warning} 14%, {role.surface})"
    },
    "--fc-danger": {
      "$type": "color",
      "$value": "{role.danger}"
    },
    "--fc-danger-tint": {
      "$value": "color-mix(in srgb, {role.danger} 12%, {role.surface})"
    },
    "--fc-info": {
      "$type": "color",
      "$value": "{role.info}"
    },
    "--fc-info-tint": {
      "$value": "color-mix(in srgb, {role.info} 11%, {role.surface})"
    },
    "--fc-terminal-bg": {
      "$type": "color",
      "$value": "{role.text}"
    },
    "--fc-terminal-fg": {
      "$type": "color",
      "$value": "#e6e8ec"
    },
    "--fc-terminal-muted": {
      "$type": "color",
      "$value": "#a7adb8"
    },
    "--fc-font-sans": {
      "$type": "fontFamily",
      "$value": "{role.font-sans}, \"Helvetica Neue\", Arial, sans-serif"
    },
    "--fc-font-mono": {
      "$type": "fontFamily",
      "$value": "\"IBM Plex Mono\", \"SFMono-Regular\", Consolas, monospace"
    },
    "--fc-radius": {
      "$type": "dimension",
      "$value": "0.5rem"
    },
    "--fc-radius-sm": {
      "$type": "dimension",
      "$value": "0.375rem"
    },
    "--fc-radius-lg": {
      "$type": "dimension",
      "$value": "0.75rem"
    },
    "--fc-nav-height": {
      "$type": "dimension",
      "$value": "3.5rem"
    },
    "--fc-sidebar-width": {
      "$type": "dimension",
      "$value": "17rem"
    },
    "--fc-toc-width": {
      "$type": "dimension",
      "$value": "14.5rem"
    },
    "--fc-layout-width": {
      "$type": "dimension",
      "$value": "90rem"
    },
    "--fc-article-width": {
      "$type": "dimension",
      "$value": "50rem"
    },
    "--fc-gutter": {
      "$type": "dimension",
      "$value": "1.25rem"
    },
    "--fc-ease": {
      "$value": "cubic-bezier(0.4, 0, 0.2, 1)"
    },
    "--fc-fast": {
      "$type": "duration",
      "$value": "150ms"
    },
    "--fc-shadow": {
      "$value": "0 1px 2px rgb(18 24 32 / 6%), 0 4px 16px rgb(18 24 32 / 8%)"
    },
    "--fc-shadow-lg": {
      "$value": "0 8px 32px rgb(18 24 32 / 16%)"
    }
  }
}
