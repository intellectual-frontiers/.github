# Python bytecode caches. Running agora rewrites them, so a tracked one leaves the checkout dirty.
__pycache__/
*.pyc
node_modules/

# agora's action logs: what is not worth a commit (0041-command-line FR-042, 0042-agora FR-021).
.agora/logs/

# The state of a running web UI: its process id, port and address (0042-agora FR-023).
.agora/ui/
