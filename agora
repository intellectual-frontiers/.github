#!/bin/sh
# agora, the public root's command line (0041-command-line FR-001, 0042-agora FR-001).
# POSIX sh. Needs only uv (https://docs.astral.sh/uv/). uv fetches archon, the command runner of workspaces-host
# (https://github.com/intellectual-frontiers/workspaces-host), at the revision pyproject.toml pins under [tool.archon]; archon runs agora under the
# newest Python that requires-python allows, with the locked packages of the command's group, and makes any program outside Python that the
# command names available first: one already on the host, the host's package manager's, or the entry's verified download (0025-tooling-environment
# FR-014, FR-017). Everything else is tools/agora/: this file only finds the clone and hands over.
#
#   AGORA_OFFLINE=1 or --offline   never download anything; a command needing something not cached fails saying what
#   ARCHON_ATTENDANCE=attended|unattended   say whether a person is at the invocation (0041 FR-078); otherwise it is worked out
#   ARCHON_FROM=PATH               run archon from a clone of workspaces-host instead of the pinned revision (development and tests)
#   --complete WORD...             completion candidates for the words typed so far
#   --completion-script bash|zsh   a shell completion script
set -eu

here=$(cd "$(dirname "$0")" && pwd -P)

if ! command -v uv >/dev/null 2>&1; then
  echo "agora: uv is needed and is not on PATH; install it (https://docs.astral.sh/uv/getting-started/installation/), then run this again" >&2
  exit 3
fi

offline=
for arg in "$@"; do
  [ "$arg" = "--offline" ] && offline=--offline
done
[ "${AGORA_OFFLINE:-}" = 1 ] && offline=--offline

# The Python floor and the revision of archon are written once each, in pyproject.toml (0025-tooling-environment FR-014).
python=$(sed -n 's/^requires-python[[:space:]]*=[[:space:]]*"\(.*\)"[[:space:]]*$/\1/p' "$here/pyproject.toml" 2>/dev/null | head -n 1)
python=${python:->=3.14}
revision=$(sed -n '/^\[tool\.archon\]/,/^\[/s/^revision[[:space:]]*=[[:space:]]*"\(.*\)"[[:space:]]*$/\1/p' "$here/pyproject.toml" 2>/dev/null | head -n 1)
source=${ARCHON_FROM:-git+https://github.com/intellectual-frontiers/workspaces-host@$revision}

PYTHONDONTWRITEBYTECODE=1
export PYTHONDONTWRITEBYTECODE
# A clone of workspaces-host named in ARCHON_FROM (development and tests) is run in place; anything else is fetched by uv at the pinned revision.
if [ -d "$source" ]; then
  PYTHONPATH="$source${PYTHONPATH:+:$PYTHONPATH}"
  export PYTHONPATH
  exec uv run --no-project --quiet --python "$python" ${offline:+"$offline"} -- python -W ignore -m archon run --repo "$here" --path tools ${offline:+"$offline"} -- agora "$@"
fi
exec uvx --quiet ${offline:+"$offline"} --from "$source" archon run --repo "$here" --path tools ${offline:+"$offline"} -- agora "$@"
