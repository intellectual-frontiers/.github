#!/bin/sh
# agora, the public root's command line (0041-command-line FR-001, 0042-agora FR-001).
# POSIX sh. Needs uv and Python 3.11 or later from the host; runs from a fresh clone with no other step, from any
# working directory inside it. Everything else is tools/agora/: this file only finds the clone, finds the prerequisites,
# and hands over. A command that needs packages is re-run by agora under its group's hashed lock (core/plan.py).
#
#   AGORA_OFFLINE=1 or --offline   never download anything; a command needing something not cached fails saying what
#   --complete WORD...             completion candidates for the words typed so far
#   --completion-script bash|zsh   a shell completion script
set -eu

here=$(cd "$(dirname "$0")" && pwd -P)

if ! command -v uv >/dev/null 2>&1; then
  echo "agora: uv is needed and is not on PATH; install uv (https://docs.astral.sh/uv/) from the host" >&2
  exit 3
fi

offline=
for arg in "$@"; do
  [ "$arg" = "--offline" ] && offline=--offline
done
[ "${AGORA_OFFLINE:-}" = 1 ] && offline=--offline

PYTHONPATH="$here/tools${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH PYTHONDONTWRITEBYTECODE=1

# No packages: the plain standard-library interpreter, through uv so that no host site-packages is involved.
exec uv run --no-project --no-python-downloads --python ">=3.11" ${offline:+"$offline"} \
  python -m agora "$@"
