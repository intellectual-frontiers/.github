#!/bin/sh
# agora, the public root's command line (0041-command-line FR-001, 0042-agora FR-001).
# POSIX sh. Needs ws-host (https://github.com/intellectual-frontiers/workspaces-host), which supplies Python, uv and every program agora
# pins in .workspaces-host/; ws-host runs agora in agora's own environment, so no program of the host takes part (0025-tooling-environment FR-014).
# Enable this clone once with `ws-host provider add .`; a repository cannot enable itself. Everything else is tools/agora/: this file
# only finds the clone, finds ws-host, and hands over. A command that needs packages is re-run by agora under its group's hashed lock
# (core/plan.py), and one that needs a program outside Python has ws-host install it from the lock on first use.
#
#   AGORA_OFFLINE=1 or --offline   never download anything; a command needing something not cached fails saying what
#   --complete WORD...             completion candidates for the words typed so far
#   --completion-script bash|zsh   a shell completion script
set -eu

here=$(cd "$(dirname "$0")" && pwd -P)

if ! command -v ws-host >/dev/null 2>&1; then
  echo "agora: ws-host is needed and is not on PATH; install it (https://github.com/intellectual-frontiers/workspaces-host), then run: ws-host provider add $here" >&2
  exit 3
fi

offline=
for arg in "$@"; do
  [ "$arg" = "--offline" ] && offline=--offline
done
[ "${AGORA_OFFLINE:-}" = 1 ] && offline=--offline

PYTHONPATH="$here/tools${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH PYTHONDONTWRITEBYTECODE=1

# No packages: the plain standard-library interpreter, through uv so that no host site-packages is involved.
exec ws-host provider run agora --ensure uv --ensure python ${offline:+"$offline"} -- \
  uv run --no-project --no-python-downloads --python ">=3.14" ${offline:+"$offline"} python -m agora "$@"
