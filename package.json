{
  "name": "@intellectual-frontiers/commons",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "Intellectual Frontiers Commons: the workspace of the development loop, a private package that is never installed elsewhere (commons 0036-distribution). Its libraries are published one by one.",
  "type": "module",
  "scripts": {
    "dev:check": "bun commons/libraries/src/link.ts && bun commons/libraries/src/dev.ts",
    "release": "bun commons/libraries/src/link.ts && bun commons/libraries/src/release-run.ts",
    "repoctl": "bun commons/libraries/src/link.ts && bun commons/repoctl/src/repoctl.ts",
    "workbench": "bun commons/workbench/src/physical/main.ts",
    "workload": "bun commons/workload/src/physical/main.ts"
  },
  "bin": {
    "repoctl": "./commons/repoctl/bin/repoctl.mjs"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "beautiful-mermaid": "1.1.3",
    "shiki": "4.5.0",
    "typescript": "7.1.0-beta"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intellectual-frontiers/.github.git"
  },
  "devDependencies": {
    "@babel/parser": "8.1.3",
    "@babel/types": "8.1.3",
    "@intellectual-frontiers/docs": "link:./commons/docs",
    "@types/node": "26.6.6",
    "fast-check": "4.10.2"
  },
  "workbench": {
    "contract": "commons/workbench/tools/commons.contract.ts"
  }
}
