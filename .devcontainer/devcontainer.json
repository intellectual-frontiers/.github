{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "Intellectual Frontiers .github",
  // The reference environment's press image (0025-tooling-environment FR-005, 0026-workspaces FR-004): the design
  // systems' print harnesses need TeX. Its tag must match tools/reference-environment (0025 FR-008).
  "image": "ghcr.io/intellectual-frontiers/workspaces-host-v3-press:sha-8efca19",
  "remoteUser": "root",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "remoteEnv": {
    "WS_REPOS_CONFIG": "${containerWorkspaceFolder}/.devcontainer/ws-repos.json"
  },
  // Nothing is installed here (0026 FR-006). On attach, ws-start asks for a GitHub login if there is none, adopts this
  // checkout into the ~/workspaces layout with its siblings linked beside it, then clones the rest of ws-repos.json
  // there with ws-repos ensure (0026 FR-007, FR-008, FR-015).
  "postCreateCommand": "bash -lc 'git config --global --add safe.directory \"*\" && (doctor || true)'",
  "postAttachCommand": "bash -lc 'ws-start'"
}
