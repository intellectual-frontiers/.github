{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "Intellectual Frontiers .github",
  // The reference environment's press image (0025-tooling-environment FR-005, 0026-workspaces FR-004): the design
  // systems' print harnesses need TeX. Its tag must match tools/reference-environment (0025 FR-008).
  "image": "ghcr.io/intellectual-frontiers/workspaces-host-v3-press:sha-49a8e13",
  "remoteUser": "root",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "remoteEnv": {
    "WS_REPOS_CONFIG": "${containerWorkspaceFolder}/.devcontainer/ws-repos.json"
  },
  // Nothing is installed here (0026 FR-006). Login and cloning wait for the first attach, when a person is there to
  // log in to GitHub (0026 FR-007, FR-008).
  "postCreateCommand": "bash -lc 'doctor || true'",
  "postAttachCommand": "bash -lc 'ws-start'"
}
