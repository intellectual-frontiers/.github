        },
        {
          "command": "if-console.openRow",
          "when": "view =~ /^if-console\\.view\\.\\d+$/ && viewItem =~ /\\bopenable\\b/",
          "group": "inline@1"
        },
        {
          "command": "if-console.runRowAction",
          "when": "view =~ /^if-console\\.view\\.\\d+$/ && viewItem =~ /\\bopenable\\b/",
          "group": "inline@2"
        },
        {
