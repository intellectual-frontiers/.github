{
  "name": "if-console",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "intellectual-frontiers",
  "license": "UNLICENSED",
  "private": true,
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#121820",
    "theme": "dark"
  },
  "categories": [
    "Other",
    "Testing",
    "Education"
  ],
  "keywords": [
    "if-console",
    "intellectual frontiers",
    "command line",
    "orchestrator",
    "checks",
    "specs",
    "dry run",
    "decisions",
    "learn",
    "mcp"
  ],
  "homepage": "https://github.com/intellectual-frontiers/.github/tree/main/tools/if-console#readme",
  "bugs": {
    "url": "https://github.com/intellectual-frontiers/.github/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/intellectual-frontiers/.github.git",
    "directory": "tools/if-console"
  },
  "engines": {
    "vscode": "^1.101.0",
    "node": ">=22"
  },
  "l10n": "./l10n",
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.if-console.env",
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capabilities.untrustedWorkspaces.description%"
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capabilities.virtualWorkspaces.description%"
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "if-console",
          "title": "%container.if-console.title%",
          "icon": "media/if-console.svg"
        }
      ]
    },
    "views": {
      "if-console": [
        {
          "id": "if-console.home",
          "name": "%view.home.name%",
          "contextualTitle": "%view.contextualTitle%"
        },
        {
          "id": "if-console.view.0",
          "name": "%view.view.0.name%",
          "contextualTitle": "%view.contextualTitle%",
          "when": "if-console.slot.0",
          "visibility": "collapsed"
        },
        {
          "id": "if-console.view.1",
          "name": "%view.view.1.name%",
          "contextualTitle": "%view.contextualTitle%",
          "when": "if-console.slot.1",
          "visibility": "collapsed"
        },
        {
          "id": "if-console.view.2",
          "name": "%view.view.2.name%",
          "contextualTitle": "%view.contextualTitle%",
          "when": "if-console.slot.2",
          "visibility": "collapsed"
        },
        {
          "id": "if-console.view.3",
          "name": "%view.view.3.name%",
          "contextualTitle": "%view.contextualTitle%",
          "when": "if-console.slot.3",
          "visibility": "collapsed"
        },
        {
          "id": "if-console.view.4",
          "name": "%view.view.4.name%",
          "contextualTitle": "%view.contextualTitle%",
          "when": "if-console.slot.4",
          "visibility": "collapsed"
        },
        {
          "id": "if-console.view.5",
          "name": "%view.view.5.name%",
          "contextualTitle": "%view.contextualTitle%",
          "when": "if-console.slot.5",
          "visibility": "collapsed"
        },
        {
          "id": "if-console.view.6",
          "name": "%view.view.6.name%",
          "contextualTitle": "%view.contextualTitle%",
          "when": "if-console.slot.6",
          "visibility": "collapsed"
        },
        {
          "id": "if-console.view.7",
          "name": "%view.view.7.name%",
          "contextualTitle": "%view.contextualTitle%",
          "when": "if-console.slot.7",
          "visibility": "collapsed"
        },
        {
          "id": "if-console.view.8",
          "name": "%view.view.8.name%",
          "contextualTitle": "%view.contextualTitle%",
          "when": "if-console.slot.8",
          "visibility": "collapsed"
        },
        {
          "id": "if-console.view.9",
          "name": "%view.view.9.name%",
          "contextualTitle": "%view.contextualTitle%",
          "when": "if-console.slot.9",
          "visibility": "collapsed"
        },
        {
          "id": "if-console.view.10",
          "name": "%view.view.10.name%",
          "contextualTitle": "%view.contextualTitle%",
          "when": "if-console.slot.10",
          "visibility": "collapsed"
        },
        {
          "id": "if-console.view.11",
          "name": "%view.view.11.name%",
          "contextualTitle": "%view.contextualTitle%",
          "when": "if-console.slot.11",
          "visibility": "collapsed"
        },
        {
          "id": "if-console.view.12",
          "name": "%view.view.12.name%",
          "contextualTitle": "%view.contextualTitle%",
          "when": "if-console.slot.12",
          "visibility": "collapsed"
        },
        {
          "id": "if-console.view.13",
          "name": "%view.view.13.name%",
          "contextualTitle": "%view.contextualTitle%",
          "when": "if-console.slot.13",
          "visibility": "collapsed"
        },
        {
          "id": "if-console.view.14",
          "name": "%view.view.14.name%",
          "contextualTitle": "%view.contextualTitle%",
          "when": "if-console.slot.14",
          "visibility": "collapsed"
        },
        {
          "id": "if-console.view.15",
          "name": "%view.view.15.name%",
          "contextualTitle": "%view.contextualTitle%",
          "when": "if-console.slot.15",
          "visibility": "collapsed"
        },
        {
          "id": "if-console.checks",
          "name": "%view.checks.name%",
          "contextualTitle": "%view.contextualTitle%",
          "when": "if-console.hasRepository",
          "visibility": "collapsed"
        },
        {
          "id": "if-console.commands",
          "name": "%view.commands.name%",
          "contextualTitle": "%view.contextualTitle%",
          "when": "if-console.allCommands",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "if-console.home",
        "contents": "%welcome.home.0%",
        "when": "!if-console.hasRepository && !if-console.untrusted && !if-console.unavailable"
      },
      {
        "view": "if-console.home",
        "contents": "%welcome.home.1%",
        "when": "if-console.untrusted"
      },
      {
        "view": "if-console.home",
        "contents": "%welcome.home.2%",
        "when": "!if-console.hasRepository && !if-console.untrusted && if-console.unavailable && !if-console.toolchainMissing"
      },
      {
        "view": "if-console.home",
        "contents": "%welcome.home.3%",
        "when": "!if-console.hasRepository && !if-console.untrusted && if-console.toolchainMissing"
      },
      {
        "view": "if-console.commands",
        "contents": "%welcome.commands.4%",
        "when": "!if-console.hasRepository && !if-console.untrusted"
      },
      {
        "view": "if-console.commands",
        "contents": "%welcome.commands.5%",
        "when": "if-console.untrusted"
      }
    ],
    "commands": [
      {
        "command": "if-console.showHome",
        "title": "%command.showHome.title%",
        "category": "%category%",
        "icon": "$(home)"
      },
      {
        "command": "if-console.showView",
        "title": "%command.showView.title%",
        "category": "%category%",
        "icon": "$(list-tree)"
      },
      {
        "command": "if-console.runCommand",
        "title": "%command.runCommand.title%",
        "category": "%category%",
        "icon": "$(play)",
        "enablement": "if-console.hasRepository"
      },
      {
        "command": "if-console.check",
        "title": "%command.check.title%",
        "category": "%category%",
        "icon": "$(checklist)",
        "enablement": "if-console.hasRepository"
      },
      {
        "command": "if-console.checkChanged",
        "title": "%command.checkChanged.title%",
        "category": "%category%",
        "icon": "$(diff)",
        "enablement": "if-console.hasRepository"
      },
      {
        "command": "if-console.fresh",
        "title": "%command.fresh.title%",
        "category": "%category%",
        "icon": "$(sync)",
        "enablement": "if-console.hasRepository"
      },
      {
        "command": "if-console.test",
        "title": "%command.test.title%",
        "category": "%category%",
        "icon": "$(beaker)",
        "enablement": "if-console.hasRepository"
      },
      {
        "command": "if-console.doctor",
        "title": "%command.doctor.title%",
        "category": "%category%",
        "icon": "$(pulse)",
        "enablement": "if-console.hasRepository"
      },
      {
        "command": "if-console.showCommandLine",
        "title": "%command.showCommandLine.title%",
        "category": "%category%",
        "icon": "$(terminal)",
        "enablement": "if-console.hasRepository"
      },
      {
        "command": "if-console.getHelp",
        "title": "%command.getHelp.title%",
        "category": "%category%",
        "icon": "$(question)",
        "enablement": "if-console.hasRepository"
      },
      {
        "command": "if-console.learn",
        "title": "%command.learn.title%",
        "category": "%category%",
        "icon": "$(book)",
        "enablement": "if-console.hasRepository"
      },
      {
        "command": "if-console.copyContext",
        "title": "%command.copyContext.title%",
        "category": "%category%",
        "icon": "$(sparkle)",
        "enablement": "if-console.hasRepository"
      },
      {
        "command": "if-console.openView",
        "title": "%command.openView.title%",
        "category": "%category%",
        "icon": "$(browser)",
        "enablement": "if-console.hasRepository"
      },
      {
        "command": "if-console.findResource",
        "title": "%command.findResource.title%",
        "category": "%category%",
        "icon": "$(search)",
        "enablement": "if-console.hasRepository"
      },
      {
        "command": "if-console.searchView",
        "title": "%command.searchView.title%",
        "category": "%category%",
        "icon": "$(search-view)",
        "enablement": "if-console.hasRepository"
      },
      {
        "command": "if-console.refresh",
        "title": "%command.refresh.title%",
        "category": "%category%",
        "icon": "$(refresh)"
      },
      {
        "command": "if-console.showOutput",
        "title": "%command.showOutput.title%",
        "category": "%category%",
        "icon": "$(output)"
      },
      {
        "command": "if-console.trust",
        "title": "%command.trust.title%",
        "category": "%category%",
        "icon": "$(shield)",
        "enablement": "if-console.untrusted"
      },
      {
        "command": "if-console.cancelRun",
        "title": "%command.cancelRun.title%",
        "category": "%category%",
        "icon": "$(debug-stop)",
        "enablement": "if-console.running"
      },
      {
        "command": "if-console.toggleAllCommands",
        "title": "%command.toggleAllCommands.title%",
        "category": "%category%",
        "icon": "$(list-tree)",
        "enablement": "if-console.hasRepository"
      },
      {
        "command": "if-console.activateNode",
        "title": "%command.activateNode.title%",
        "category": "%category%",
        "icon": "$(play)"
      },
      {
        "command": "if-console.runSection",
        "title": "%command.runSection.title%",
        "category": "%category%",
        "icon": "$(play)"
      },
      {
        "command": "if-console.runSuggestion",
        "title": "%command.runSuggestion.title%",
        "category": "%category%",
        "icon": "$(play)"
      },
      {
        "command": "if-console.openRow",
        "title": "%command.openRow.title%",
        "category": "%category%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "if-console.runRowAction",
        "title": "%command.runRowAction.title%",
        "category": "%category%",
        "icon": "$(play)"
      },
      {
        "command": "if-console.runNounCommand",
        "title": "%command.runNounCommand.title%",
        "category": "%category%",
        "icon": "$(play)"
      },
      {
        "command": "if-console.copyCommandLine",
        "title": "%command.copyCommandLine.title%",
        "category": "%category%",
        "icon": "$(copy)"
      },
      {
        "command": "if-console.copyId",
        "title": "%command.copyId.title%",
        "category": "%category%",
        "icon": "$(key)"
      },
      {
        "command": "if-console.followLink",
        "title": "%command.followLink.title%",
        "category": "%category%",
        "icon": "$(link)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "if-console.showHome",
          "when": "if-console.hasRepository || if-console.untrusted || if-console.unavailable"
        },
        {
          "command": "if-console.showView",
          "when": "if-console.hasRepository"
        },
        {
          "command": "if-console.runCommand",
          "when": "if-console.hasRepository"
        },
        {
          "command": "if-console.check",
          "when": "if-console.hasRepository"
        },
        {
          "command": "if-console.checkChanged",
          "when": "if-console.hasRepository"
        },
        {
          "command": "if-console.fresh",
          "when": "if-console.hasRepository"
        },
        {
          "command": "if-console.test",
          "when": "if-console.hasRepository"
        },
        {
          "command": "if-console.doctor",
          "when": "if-console.hasRepository"
        },
        {
          "command": "if-console.showCommandLine",
          "when": "if-console.hasRepository"
        },
        {
          "command": "if-console.getHelp",
          "when": "if-console.hasRepository"
        },
        {
          "command": "if-console.learn",
          "when": "if-console.hasRepository"
        },
        {
          "command": "if-console.copyContext",
          "when": "if-console.hasRepository"
        },
        {
          "command": "if-console.openView",
          "when": "if-console.hasRepository"
        },
        {
          "command": "if-console.findResource",
          "when": "if-console.hasRepository"
        },
        {
          "command": "if-console.refresh",
          "when": "if-console.hasRepository || if-console.untrusted || if-console.unavailable"
        },
        {
          "command": "if-console.showOutput",
          "when": "if-console.hasRepository || if-console.untrusted || if-console.unavailable"
        },
        {
          "command": "if-console.trust",
          "when": "if-console.untrusted"
        },
        {
          "command": "if-console.cancelRun",
          "when": "if-console.running"
        },
        {
          "command": "if-console.toggleAllCommands",
          "when": "if-console.hasRepository"
        },
        {
          "command": "if-console.activateNode",
          "when": "false"
        },
        {
          "command": "if-console.runSection",
          "when": "false"
        },
        {
          "command": "if-console.runSuggestion",
          "when": "false"
        },
        {
          "command": "if-console.openRow",
          "when": "false"
        },
        {
          "command": "if-console.runRowAction",
          "when": "false"
        },
        {
          "command": "if-console.runNounCommand",
          "when": "false"
        },
        {
          "command": "if-console.copyCommandLine",
          "when": "false"
        },
        {
          "command": "if-console.copyId",
          "when": "false"
        },
        {
          "command": "if-console.followLink",
          "when": "false"
        },
        {
          "command": "if-console.searchView",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "if-console.cancelRun",
          "when": "view =~ /^if-console\\.(home|view\\.\\d+|checks|commands)$/ && if-console.running",
          "group": "navigation@0"
        },
        {
          "command": "if-console.refresh",
          "when": "view == if-console.home",
          "group": "navigation@1"
        },
        {
          "command": "if-console.learn",
          "when": "view == if-console.home && if-console.hasRepository",
          "group": "navigation@2"
        },
        {
          "command": "if-console.toggleAllCommands",
          "when": "view == if-console.home && if-console.hasRepository",
          "group": "9_more@1"
        },
        {
          "command": "if-console.showOutput",
          "when": "view == if-console.home",
          "group": "9_more@2"
        },
        {
          "command": "if-console.check",
          "when": "view == if-console.checks",
          "group": "navigation@1"
        },
        {
          "command": "if-console.checkChanged",
          "when": "view == if-console.checks",
          "group": "navigation@2"
        },
        {
          "command": "if-console.refresh",
          "when": "view == if-console.checks",
          "group": "navigation@3"
        },
        {
          "command": "if-console.findResource",
          "when": "view =~ /^if-console\\.view\\.\\d+$/",
          "group": "navigation@1"
        },
        {
          "command": "if-console.searchView",
          "when": "view == if-console.view.0 && if-console.search.0",
          "group": "navigation@0"
        },
        {
          "command": "if-console.searchView",
          "when": "view == if-console.view.1 && if-console.search.1",
          "group": "navigation@0"
        },
        {
          "command": "if-console.searchView",
          "when": "view == if-console.view.2 && if-console.search.2",
          "group": "navigation@0"
        },
        {
          "command": "if-console.searchView",
          "when": "view == if-console.view.3 && if-console.search.3",
          "group": "navigation@0"
        },
        {
          "command": "if-console.searchView",
          "when": "view == if-console.view.4 && if-console.search.4",
          "group": "navigation@0"
        },
        {
          "command": "if-console.searchView",
          "when": "view == if-console.view.5 && if-console.search.5",
          "group": "navigation@0"
        },
        {
          "command": "if-console.searchView",
          "when": "view == if-console.view.6 && if-console.search.6",
          "group": "navigation@0"
        },
        {
          "command": "if-console.searchView",
          "when": "view == if-console.view.7 && if-console.search.7",
          "group": "navigation@0"
        },
        {
          "command": "if-console.searchView",
          "when": "view == if-console.view.8 && if-console.search.8",
          "group": "navigation@0"
        },
        {
          "command": "if-console.searchView",
          "when": "view == if-console.view.9 && if-console.search.9",
          "group": "navigation@0"
        },
        {
          "command": "if-console.searchView",
          "when": "view == if-console.view.10 && if-console.search.10",
          "group": "navigation@0"
        },
        {
          "command": "if-console.searchView",
          "when": "view == if-console.view.11 && if-console.search.11",
          "group": "navigation@0"
        },
        {
          "command": "if-console.searchView",
          "when": "view == if-console.view.12 && if-console.search.12",
          "group": "navigation@0"
        },
        {
          "command": "if-console.searchView",
          "when": "view == if-console.view.13 && if-console.search.13",
          "group": "navigation@0"
        },
        {
          "command": "if-console.searchView",
          "when": "view == if-console.view.14 && if-console.search.14",
          "group": "navigation@0"
        },
        {
          "command": "if-console.searchView",
          "when": "view == if-console.view.15 && if-console.search.15",
          "group": "navigation@0"
        },
        {
          "command": "if-console.refresh",
          "when": "view =~ /^if-console\\.view\\.\\d+$/",
          "group": "navigation@2"
        },
        {
          "command": "if-console.runCommand",
          "when": "view == if-console.commands",
          "group": "navigation@1"
        },
        {
          "command": "if-console.refresh",
          "when": "view == if-console.commands",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "if-console.runSuggestion",
          "when": "view == if-console.home && viewItem =~ /^suggestion/ && viewItem =~ /\\brunnable\\b/",
          "group": "inline@1"
        },
        {
          "command": "if-console.copyCommandLine",
          "when": "view == if-console.home && viewItem =~ /^suggestion/ && viewItem =~ /\\bcopyable\\b/",
          "group": "inline@2"
        },
        {
          "command": "if-console.runSuggestion",
          "when": "view == if-console.home && viewItem =~ /^suggestion/ && viewItem =~ /\\brunnable\\b/",
          "group": "1_run@1"
        },
        {
          "command": "if-console.copyCommandLine",
          "when": "view == if-console.home && viewItem =~ /^suggestion/ && viewItem =~ /\\bcopyable\\b/",
          "group": "2_copy@1"
        },
        {
          "command": "if-console.runSection",
          "when": "view == if-console.checks && viewItem =~ /^section/",
          "group": "inline@1"
        },
        {
          "command": "if-console.copyCommandLine",
          "when": "view == if-console.checks && viewItem =~ /^section/",
          "group": "inline@2"
        },
        {
          "command": "if-console.runSection",
          "when": "view == if-console.checks && viewItem =~ /^section/",
          "group": "1_run@1"
        },
        {
          "command": "if-console.copyCommandLine",
          "when": "view == if-console.checks && viewItem =~ /^section/",
          "group": "2_copy@1"
        },
        {
          "command": "if-console.copyId",
          "when": "view == if-console.checks && viewItem =~ /^section/",
