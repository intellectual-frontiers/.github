        {
          "command": "if-console.copyId",
          "when": "view =~ /^if-console\\.view\\.\\d+$/ && viewItem =~ /\\bopenable\\b/",
          "group": "9_cutcopypaste@1"
        },
        {
          "command": "if-console.runNounCommand",
          "when": "view =~ /^if-console\\.view\\.\\d+$/ && viewItem =~ /^noun/",
          "group": "inline@1"
        },
        {
          "command": "if-console.runNounCommand",
          "when": "view =~ /^if-console\\.view\\.\\d+$/ && viewItem =~ /^noun/",
          "group": "1_run@1"
        },
        {
          "command": "if-console.activateNode",
          "when": "view =~ /^if-console\\.view\\.\\d+$/ && viewItem =~ /^command/",
          "group": "1_run@1"
        },
        {
          "command": "if-console.copyContext",
          "when": "view == if-console.commands && viewItem =~ /\\bcontextual\\b/",
          "group": "inline"
        },
        {
          "command": "if-console.copyContext",
          "when": "view == if-console.commands && viewItem =~ /\\bcontextual\\b/",
          "group": "2_copy@1"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "if-console",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "check",
              "test",
              "fresh",
              "doctor"
            ],
            "description": "%task.command.description%"
          },
          "section": {
            "type": "string",
            "description": "%task.section.description%"
          },
          "suite": {
            "type": "string",
            "description": "%task.suite.description%"
          },
          "changed": {
            "type": "boolean",
            "description": "%task.changed.description%"
          },
          "folder": {
            "type": "string",
            "description": "%task.folder.description%"
          }
        }
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "if-console.launchers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "application",
          "order": 1,
          "markdownDescription": "%setting.launchers.description%"
        },
        "if-console.checkOnSave": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "order": 2,
          "markdownDescription": "%setting.checkOnSave.description%"
        },
        "if-console.showAllCommands": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "order": 3,
          "markdownDescription": "%setting.showAllCommands.description%"
        },
        "if-console.rowLimit": {
          "type": "number",
          "default": 200,
          "minimum": 10,
          "maximum": 5000,
          "scope": "application",
          "order": 4,
          "markdownDescription": "%setting.rowLimit.description%"
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "if-console.servers",
        "label": "%mcp.label%"
      }
    ],
    "keybindings": [
      {
        "command": "if-console.showHome",
        "key": "ctrl+alt+i h",
        "when": "if-console.hasRepository"
      },
      {
        "command": "if-console.check",
        "key": "ctrl+alt+i c",
        "when": "if-console.hasRepository"
      },
      {
        "command": "if-console.learn",
        "key": "ctrl+alt+i l",
        "when": "if-console.hasRepository"
      },
      {
        "command": "if-console.copyContext",
        "key": "ctrl+alt+i x",
        "when": "if-console.hasRepository"
      }
    ]
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/vscode": "1.101.0",
    "@vscode-elements/elements": "2.5.1",
    "@vscode/codicons": "0.0.45",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
